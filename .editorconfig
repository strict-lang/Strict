[*]
indent_style = tab
indent_size = 2
tab_width = 2
end_of_line = crlf
max_line_length = 100
trim_trailing_whitespace = true
charset = utf-8

# Strict source forbids a trailing newline (it is an empty last line).
[*.strict]
insert_final_newline = false
end_of_line = crlf

# Shell scripts run in WSL and on Linux
[*.sh]
end_of_line = lf
