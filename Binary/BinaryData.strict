has bytes Numbers
constant Sample = BinaryData((4, 0, 0, 0, 255, 255, 2, 128, 0, 0, 192, 63, 5, 72, 101, 108, 108, 111, 0, 0, 128, 191))
Read(path Text) BinaryData
	BinaryData.Read("Content/Missing.bin") is Error
	if File(path).Exists is false
		return Error("FileNotFound")
	mutable numbers = List(Mutable(Number))
	for File(path).ReadBytes
		numbers.Add(value.number)
	BinaryData(numbers)
UInt32(at Number) Number
	Sample.UInt32(4) is 2147680255
	bytes(at) + bytes(at + 1) * 256 + bytes(at + 2) * 65536 + bytes(at + 3) * 16777216
Int32(at Number) Number
	Sample.Int32(0) is 4
	Sample.Int32(4) is -2147287041
	let unsigned = UInt32(at)
	unsigned >= 2147483648 then unsigned - 4294967296 else unsigned
Int16(at Number) Number
	Sample.Int16(4) is -1
	Sample.Int16(6) is -32766
	let unsigned = UInt16(at)
	unsigned >= 32768 then unsigned - 65536 else unsigned
UInt16(at Number) Number
	Sample.UInt16(4) is 65535
	bytes(at) + bytes(at + 1) * 256
Int8(at Number) Number
	Sample.Int8(4) is -1
	Sample.Int8(0) is 4
	bytes(at) >= 128 then bytes(at) - 256 else bytes(at)
Float32(at Number) Number
	Sample.Float32(8) is 1.5
	Sample.Float32(18) is -1
	Sample.Float32(0) is 4 * 2 ^ -149
	let high = bytes(at + 3)
	let exponent = (high % 128) * 2 + (bytes(at + 2) / 128).Floor
	let mantissa = (bytes(at + 2) % 128) * 65536 + bytes(at + 1) * 256 + bytes(at)
	let magnitude = exponent is 0 then mantissa * 2 ^ -149 else (1 + mantissa / 8388608) * 2 ^ (exponent - 127)
	high >= 128 then 0 - magnitude else magnitude
Text(at Number) Text
	Sample.Text(12) is "Hello"
	mutable text = ""
	for Range(TextEnd(at) - TextLength(at), TextEnd(at))
		text = text + (Character(bytes(value)) to Text)
	text
TextLength(at Number) Number
	Sample.TextLength(12) is 5
	bytes(at) >= 128 then bytes(at) % 128 + bytes(at + 1) * 128 else bytes(at)
TextEnd(at Number) Number
	Sample.TextEnd(12) is 18
	at + (bytes(at) >= 128 then 2 else 1) + TextLength(at)
