has bytes Numbers
constant Sample = BinaryData((4, 0, 0, 0, 255, 255, 2, 128, 0, 0, 192, 63, 5, 72, 101, 108, 108, 111, 0, 0, 128, 191))
constant UInt16Range = 65536
constant UInt24Range = 16777216
constant Int16SignBit = 32768
constant Int32SignBit = 2147483648
constant HighBit = 128
constant InfinityExponent = 255
constant SubnormalShift = 149
constant MantissaRange = 8388608
constant ExponentBias = 127
Read(path Text) BinaryData slow
	BinaryData.Read("Content/Missing.bin") is Error
	File(path).Exists is false then Error("FileNotFound") else BinaryData(File(path).ReadBytes)
UInt32(at Number) Number
	Sample.UInt32(4) is 2147680255
	bytes(at) + bytes(at + 1) * Byte.Values + bytes(at + 2) * UInt16Range + bytes(at + 3) * UInt24Range
Int32(at Number) Number
	Sample.Int32(0) is 4
	Sample.Int32(4) is -2147287041
	let unsigned = UInt32(at)
	unsigned >= Int32SignBit then unsigned - HashCode.UnsignedRange else unsigned
Int16(at Number) Number
	Sample.Int16(4) is -1
	Sample.Int16(6) is -32766
	Sample.Int16(0) is 4
	let unsigned = UInt16(at)
	unsigned >= Int16SignBit then unsigned - UInt16Range else unsigned
UInt16(at Number) Number
	Sample.UInt16(4) is 65535
	bytes(at) + bytes(at + 1) * Byte.Values
Int8(at Number) Number
	Sample.Int8(4) is -1
	Sample.Int8(0) is 4
	bytes(at) >= HighBit then bytes(at) - Byte.Values else bytes(at)
Float32(at Number) Number
	(Sample.Float32(8) is 1.5) and (BinaryData((1, 2, 3, 64)).Float32(0) is 2 + 197121 / 4194304)
	Sample.Float32(18) is -1
	(Sample.Float32(0) is 4 * 2 ^ -149) and (BinaryData((0, 0, 128, 255)).Float32(0) is -1 / 0)
	(BinaryData((0, 0, 128, 127)).Float32(0) is 1 / 0) and (BinaryData((1, 0, 128, 127)).Float32(0) is not 1 / 0)
	BinaryData((1, 0, 128, 127)).Float32(0).IsFinite is false
	let exponent = (bytes(at + 3) % HighBit) * 2 + (bytes(at + 2) / HighBit).Floor
	let mantissa = (bytes(at + 2) % HighBit) * UInt16Range + bytes(at + 1) * Byte.Values + bytes(at)
	if exponent is InfinityExponent
		return mantissa is 0 then (bytes(at + 3) >= HighBit then -1 / 0 else 1 / 0) else 0 / 0
	let fraction = mantissa / MantissaRange
	let magnitude = exponent is 0 then mantissa * 2 ^ -SubnormalShift else (1 + fraction) * 2 ^ (exponent - ExponentBias)
	bytes(at + 3) >= HighBit then -magnitude else magnitude
Text(at Number) Text
	Sample.Text(12) is "Hello"
	mutable text = ""
	for Range(TextEnd(at) - TextLength(at), TextEnd(at))
		text = text + (Character(bytes(value)) to Text)
	text
TextLength(at Number) Number
	Sample.TextLength(12) is 5
	BinaryData((0, 200, 3)).TextLength(1) is 456
	bytes(at) >= HighBit then bytes(at) % HighBit + bytes(at + 1) * HighBit else bytes(at)
TextEnd(at Number) Number
	Sample.TextEnd(12) is 18
	BinaryData((0, 200, 3)).TextEnd(1) is 459
	at + (bytes(at) >= HighBit then 2 else 1) + TextLength(at)