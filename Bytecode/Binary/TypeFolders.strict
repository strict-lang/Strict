has locals Dictionary(Text, Text)
has folders Dictionary(Text, Text)
constant None = TypeFolders(Dictionary(Text, Text), Dictionary(Text, Text))
constant Single = Dictionary(("A", "."))
constant Mathematics = TypeFolders(Dictionary(("Vector2", "./Math")), Dictionary(("Vector2", "./Math"), ("Size", "../Other")))
Of(root Text) TypeFolders slow
	"Vector2" is in TypeFolders.Of(".").locals and TypeFolders.Of(".").folders.Length >= TypeFolders.Of(".").locals.Length
	None.IndexFolders(List(Text) + ".", Single).Length > Single.Length
	local = IndexFolders(List(Text) + root, Dictionary(Text, Text))
	mutable parents = List(Text)
	for Directory.Directories("..")
		project = Path(value.Replace("\\", "/")).FileName.text
		if project(0) is project(0).Upper and project(0) is not project(0).Lower
			parents = parents + ("../" + project)
	TypeFolders(local, parents.Length is 0 then local else IndexFolders(parents, local))
IndexFolders(parents Texts, known Dictionary(Text, Text)) Dictionary(Text, Text) slow
	"Vector2" is in None.IndexFolders(List(Text) + ".", Dictionary(Text, Text))
	None.IndexFolders(List(Text) + "./Missing", Single).Length is 1
	mutable map = known
	for parents
		map = IndexParent(value, map)
	map
IndexParent(parent Text, known Dictionary(Text, Text)) Dictionary(Text, Text) slow
	"Vector2" is in None.IndexParent(".", Dictionary(Text, Text))
	mutable map = known
	for Folders(parent)
		map = IndexFolder(value, map)
	map
IndexFolder(folder Text, known Dictionary(Text, Text)) Dictionary(Text, Text) slow
	"Vector2" is in None.IndexFolder("./Math", Dictionary(Text, Text))
	mutable map = known
	for Directory.Files(folder, "*.strict")
		name = Path(value.Replace("\\", "/")).FileName.RemoveExtension.text
		if name is not in map
			map(name) = folder
	map
Folders(parent Text) Texts slow
	"./Math" is in None.Folders(".")
	mutable result = List(Mutable(Text))
	for Directory.Directories(parent)
		name = Path(value.Replace("\\", "/")).FileName.text
		if name is not in ("Release", "Tools") and name(0) is name(0).Upper and name(0) is not name(0).Lower
			result.Add(parent + "/" + name)
			result = result + Folders(parent + "/" + name)
	result
Files(types Texts) Texts slow
	TypeFolders.Of(".").Files(List(Text) + "Vector2").Length is Directory.Files("./Math", "*.strict").Length
	None.Files(List(Text) + "Vector2").Length is 0
	local = Match(locals, types)
	mutable files = List(Mutable(Text))
	for local.Length < types.Length then Match(folders, types) else local
		files = files + Directory.Files(value, "*.strict")
	files
Match(indexed Dictionary(Text, Text), types Texts) Texts
	Mathematics.Match(Mathematics.locals, List(Text) + "Vector2s") is ("./Math")
	Mathematics.Match(Mathematics.folders, ("Sizes", "Vector2", "Size")) is ("../Other", "./Math")
	mutable matched = List(Mutable(Text))
	for types
		mutable name = value
		for as long as name.EndsWith("s") and name is not in indexed
			name = name.Substring(0, name.Length - 1)
		if name is in indexed and indexed(name) is not in matched
			matched.Add(indexed(name))
	matched

