has entry TypeEntry
constant Sizing = TypeSource(TypeEntry("Strict/Math/Size", List(MemberEntry), List(MethodEntry)))
constant Projected = "Compiler/output/Projected"
constant InternalPackages = ("Compiler", "Runtime", "Bytecode", "Expressions")
Root Text slow
	TypeSource.Root is "."
	if File("Any.strict").Exists
		return "."
	folder = Path(Process.Current.executable.Replace("\\", "/")).PathOnly.text
	File(folder + "/Any.strict").Exists then folder else Path(folder).PathOnly.text
Locate(folder Text) Text slow
	Sizing.Locate("./Fonts") is "Math/Size.strict"
	TypeSource(TypeEntry("Strict/List(Number)", List(MemberEntry), List(MethodEntry))).Locate("") is "List.strict"
	TypeSource(TypeEntry.HelloLogger).Locate("./Examples") is "Examples/HelloLogger.strict"
	TypeSource(TypeEntry("Strict/Examples/Sum", List(MemberEntry), List(MethodEntry))).Locate("") is "Examples/Sum.strict"
	open = entry.Source.IndexOf("(")
	file = open < 0 then entry.Source else entry.Source.Substring(0, open) + ".strict"
	relative = folder.StartsWith("./") then folder.Substring(2) else folder
	local = folder is "" then file else relative + "/" + file
	if File(local).Exists
		return local
	root = Root
	root is "." or File(root + "/" + file).Exists is false then file else root + "/" + file
Resolve(owner Text, folder Text) Text slow
	TypeSource.Resolve("Strict/Math/Size", "./Fonts") is "Math/Size.strict"
	TypeSource(TypeEntry(owner, List(MemberEntry), List(MethodEntry))).Locate(folder)
Location(methodName Text, file Text) Text
	TypeSource(TypeEntry.CharacterEntry).Location("Lower", "Character.strict") is "Character.Lower in Character.strict"
	TypeEntry.ShortName(entry.Name) + "." + methodName + " in " + file
Relative(path Text) Text
	Sizing.Relative(Directory.Current + "\\Math/Size.strict") is "./Math/Size.strict"
	Sizing.Relative("Q:/elsewhere/A.strict") is "Q:/elsewhere/A.strict"
	current = Directory.Current.Replace("\\", "/") + "/"
	slashed = path.Replace("\\", "/")
	isInside = slashed.Lower.StartsWith(current.Lower)
	isInside then "./" + slashed.Substring(current.Length, slashed.Length - current.Length) else path
Absolute(path Text) Text
	Sizing.Absolute("C:/a/b.strict") is "C:/a/b.strict"
	Sizing.Absolute("./a.strict") is Directory.Current.Replace("\\", "/") + "/a.strict"
	Sizing.Absolute(".") is Directory.Current.Replace("\\", "/")
	slashed = path.Replace("\\", "/")
	if slashed.IndexOf(":") is 1 or slashed.StartsWith("/")
		return slashed
	inside = slashed.StartsWith("./") then slashed.Substring(2) else slashed
	current = Directory.Current.Replace("\\", "/")
	inside is "." then current else current + "/" + inside
Case(path Text) Text slow
	Sizing.Case("number") is "Number.strict" and Sizing.Case("Examples/sum.STRICT") is "Examples/Sum.strict"
	Sizing.Case("Missing") is "Missing" and Sizing.Case("Examples") is "Examples"
	slashed = path.Replace("\\", "/")
	named = slashed.Lower.EndsWith(".strict") then Path(slashed).RemoveExtension.text else slashed
	folder = named.IndexOf("/") < 0 then "." else Path(named).PathOnly.text
	wanted = Path(named).FileName.text.Lower
	for Directory.Files(folder, "*.strict")
		file = Path(value.Replace("\\", "/")).FileName.text
		if file.Lower is wanted + ".strict"
			return folder is "." then file else folder + "/" + file
	path
Project(path Text) Text slow
	Sizing.Project("Examples/Sum.strict") is ""
	Directory.Create(Projected) is not Error and Directory.Exists(Projected)
	Directory.Create(Projected + "/.git") is not Error and Directory.Exists(Projected + "/.git")
	Sizing.Project("Compiler/output/Projected/A/B.strict") is Sizing.Absolute("Compiler/output/Projected")
	Sizing.Project("Compiler/output/Projected") is Sizing.Absolute("Compiler/output/Projected")
	Sizing.Project("Examples") is ""
	full = Absolute(path)
	mutable folder = Directory.Exists(full) then full else Path(full).PathOnly.text
	for as long as folder.Length > 3 and IsProject(folder) is false
		folder = Path(folder).PathOnly.text
	IsProject(folder) and folder.Lower is not Directory.Current.Replace("\\", "/").Lower then folder else ""
IsProject(folder Text) Boolean slow
	Sizing.IsProject(".")
	Sizing.IsProject("Examples") is false
	Directory.Exists(folder + "/.git") or File(folder + "/.git").Exists
NativeFolder(path Text, root Text) Text slow
	TypeSource(TypeEntry("Gpu", List(MemberEntry), List(MethodEntry))).NativeFolder("Gpu.strict", ".") is "./native"
	TypeSource(TypeEntry("Strict/P/T", List(MemberEntry), List(MethodEntry))).NativeFolder("A", "C:") is "C:/P/native"
	source = File(entry.Source).Exists then entry.Source else root + "/" + entry.Source
	parent = Path(entry.Name.IndexOf("/") < 0 then path else source).PathOnly.text
	(parent is "" then "." else parent) + "/native"
IsSlow(fullName Text, header HeaderTokens) Boolean
	TypeSource.IsSlow("Strict/Compiler/Even", HeaderTokens("Run", "Number"))
	TypeSource.IsSlow("Strict/Even", HeaderTokens("Run", "Number", "slow"))
	TypeSource.IsSlow("Strict/Even", HeaderTokens("Run", "Number")) is false
	TypeSource.IsSlow("Game/Compiler/Even", HeaderTokens("Run", "Number")) is false
	TypeSource.IsSlow("Strict/Compiler", HeaderTokens("Run", "Number")) is false
	TypeSource.IsSlow("Strict/Math/Size", HeaderTokens("Run", "Number")) is false
	header.ReturnsSlow or IsInternal(fullName)
IsInternal(fullName Text) Boolean
	TypeSource.IsInternal("Strict/Runtime/Frame") and TypeSource.IsInternal("Game/Runtime/Frame") is false
	TypeSource.IsInternal("Strict/Runtime") is false
	parts = fullName.Split("/")
	parts.Length > 2 and parts(0) is "Strict" and parts(1) is in InternalPackages

