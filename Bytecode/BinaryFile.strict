has source Text
constant Probe = BinaryFile("./Bytecode/Probe.strict")
constant Greeting = Probe.Packed(BinarySources(List(Text)).Header, List(TypeEntry) + TypeEntry.HelloLogger, List(Text))
constant Packing = Probe.Unpacked(Greeting)
constant Outdated = Probe.Unpacked(Probe.Packed(BinaryNames(List(Text) + "./Any.strict").Integers + TypeEntry.FormatVersion + 5, List(TypeEntry) + TypeEntry.HelloLogger, List(Text)))
Path Text
	Probe.Path is "./Bytecode/obj/Probe.strictbinary"
	let intermediate = BuildOutput.Intermediate(source)
	intermediate.Substring(0, intermediate.Length - 7) + ".strictbinary"
Saved(bytes Bytes) Boolean
	Probe.Saved(Probe.Packed((1, 2), List(TypeEntry), List(Text)))
	let temporary = Path + "." + 1000000000.Random.Floor + ".tmp"
	File(temporary).Write(bytes)
	File(temporary).Rename(Path)
	File(Path).Exists
Packed(header Numbers, types List(TypeEntry), links Texts) Bytes
	Probe.Packed((1, 2), List(TypeEntry), List(Text)).Length > 50
	Probe.Unpacked(Probe.Packed((1, 2), List(TypeEntry), List(Text) + "a")).Last.Name is "links"
	mutable entries = List(Mutable(ZipEntry)) + ZipEntry("sources", ByteEncoder.Empty.SevenBits(header).bytes)
	for types
		entries.Add(ZipEntry(value.Name + ".bytecode", value.Bytes))
	if links.Length > 0
		entries.Add(ZipEntry("links", ByteEncoder.Empty.UnicodeBytes(Text.Combine(links, "\n"))))
	for ZipWriter(entries).Bytes
		Byte(value)
Unpacked(bytes Bytes) List(ZipEntry)
	Packing.Length is 2
	Packing.First.content is (1, 0, 7)
	ZipReader(ZipReader.Copied(bytes, 0, bytes.Length)).Entries
Head(bytes Bytes) List(ZipEntry)
	Probe.Head(Greeting) is Packing
	Probe.Head(Probe.Packed((1), (TypeEntry.HelloLogger, TypeEntry.HelloLogger), List(Text))).Length is 2
	let first = Ended(bytes, 0)
	let second = first < 0 then -1 else Ended(bytes, first)
	(second < 0) or (second > bytes.Length) then Unpacked(bytes) else (Entry(bytes, 0), Entry(bytes, first))
Rewritten(header Numbers, own TypeEntry, rest List(ZipEntry)) Bytes
	Probe.Unpacked(Probe.Rewritten((1, 0, 7), TypeEntry.HelloLogger, Packing + ZipEntry("x", (97)))).Last.Name is "x"
	Probe.Unpacked(Probe.Rewritten((1, 0, 7), TypeEntry.HelloLogger, List(ZipEntry))).Length is 2
	mutable entries = List(Mutable(ZipEntry)) + ZipEntry("sources", ByteEncoder.Empty.SevenBits(header).bytes)
	entries.Add(ZipEntry(own.Name + ".bytecode", own.Bytes))
	for rest
		if index > 1
			entries.Add(value)
	for ZipWriter(entries).Bytes
		Byte(value)
Ended(bytes Bytes, position Number) Number
	Probe.Ended(List(Byte), 0) is -1
	Probe.Head(Greeting.Slice(0, 50)).Length is 0
	Probe.Head(List(Byte)).Length is 0
	let reader = Header(bytes, position)
	let isLocal = reader.bytes.Length >= ZipReader.LocalHeaderSize and (reader.Read(0, 4) is ZipReader.LocalHeader)
	isLocal then position + reader.End(0) else -1
Entry(bytes Bytes, position Number) ZipEntry
	Probe.Entry(Greeting, 0) is Packing.First
	let reader = Header(bytes, position)
	let size = reader.Read(ZipReader.SizeOffset, 4)
	let start = position + reader.End(0) - size
	let named = reader.bytes.Length - ZipReader.LocalHeaderSize
	ZipEntry(ByteEncoder(reader.bytes).Spelled(ZipReader.LocalHeaderSize, named), ZipReader.Copied(bytes, start, size))
Header(bytes Bytes, position Number) ZipReader
	Probe.Header(List(Byte), 0).bytes.Length is 0
	if position + ZipReader.LocalHeaderSize > bytes.Length
		return ZipReader(List(Number))
	let header = ZipReader(ZipReader.Copied(bytes, position, ZipReader.LocalHeaderSize))
	let start = position + ZipReader.LocalHeaderSize
	let named = (header.Read(ZipReader.NameLengthOffset, 2), bytes.Length - start).Minimum
	ZipReader(header.bytes + ZipReader.Copied(bytes, start, named))
IsFresh(entries List(ZipEntry)) Boolean
	Probe.IsFresh(Packing)
	Probe.IsFresh(Packing + ZipEntry("links", ByteEncoder.Empty.UnicodeBytes("Missing\tStrict/Missing\t"))) is false
	Current(entries).Length > 0
Current(entries List(ZipEntry)) List(TypeEntry)
	Probe.Current(Packing) is List(TypeEntry) + TypeEntry.HelloLogger
	Probe.Current(Outdated).Length is 0
	let types = IsCurrent(entries) then Types(entries) else List(TypeEntry)
	for types
		if value.Name is ""
			return List(TypeEntry)
	types
Relative(target Text) Text
	Probe.Relative("./Examples/obj/A.strictbinary") is "../../Examples/obj/A.strictbinary"
	Probe.Relative("./Bytecode/obj/A.strictbinary") is "A.strictbinary"
	let here = value.Path.Substring(0, value.Path.LastIndexOf("/")).Split("/")
	let there = target.Split("/")
	mutable shared = 0
	for as long as (shared < here.Length) and (shared < there.Length - 1) and (here(shared) is there(shared))
		shared = shared + 1
	mutable relative = ""
	for here.Length - shared
		relative = relative + "../"
	relative + Text.Combine(there.Slice(shared, there.Length - shared), "/")
IsCurrent(entries List(ZipEntry), known = Dictionary(Text, Number)) Boolean
	Probe.IsCurrent(Packing)
	Probe.IsCurrent(Outdated) is false
	Probe.IsCurrent(List(ZipEntry)) is false
	Probe.IsCurrent(Probe.Unpacked(Probe.Packed((1, 2), List(TypeEntry), List(Text)))) is false
	if (entries.Length is 0) or (entries.First.Name is not "sources")
		return false
	let header = EntryDecoder.Of(entries.First.content)
	let start = 1 + header.stream(0)
	let complete = header.stream.Length is start + 1 + header.names.Length
	let stamped = BinarySources(header.names).Stamped(known)
	complete and (header.stream(start) is TypeEntry.FormatVersion) and stamped.Matches(header.stream, start + 1)
Types(entries List(ZipEntry)) List(TypeEntry)
	Probe.Types(Packing) is List(TypeEntry) + TypeEntry.HelloLogger
	Probe.Types(List(ZipEntry)).Length is 0
	mutable types = List(Mutable(TypeEntry))
	for entries
		if value.Name.EndsWith(".bytecode")
			types.Add(EntryDecoder.Of(value.content).Type)
		else if value.Name is "links"
			return BinaryLinks(BinaryFile(source)).Resolved(types, value)
	types
Data(path Text, ignored Texts = List(Text)) Slow(Texts)
	Probe.Data("Compiler/NativeBuild.strict") is ("Compiler/NativeRuntime.mlir")
	Probe.Data("NeuralNetworks/Dataset.strict").Length is 2
	mutable files = List(Mutable(Text))
	for reference, found in DataFiles.References(path).Unique, Found(reference, ignored)
		if (found is not in files) and (found.EndsWith(".strict") is false)
			files.Add(found)
	files
Found(name Text, ignored Texts = List(Text)) Texts
	Probe.Found("Compiler/NativeRuntime.mlir") is List(Text) + "Compiler/NativeRuntime.mlir"
	Probe.Found("Bytecode").Length is 0
	Probe.Found(".git").Length is 0
	Probe.Found("NeuralNetworks/images").Length is 2
	(Probe.Found("..") + Probe.Found("/") + Probe.Found(".") + Probe.Found("./")).Length is 0
	DataFiles(ignored).Found(name)
IsInput(name Text) Boolean
	Probe.IsInput("Compiler/NativeRuntime.mlir")
	Probe.IsInput("./Character.test") is false
	Probe.IsInput("strict") is false
	let isOutput = name.EndsWith(".exe") or name.EndsWith(".test") or name.EndsWith(".strictbinary")
	(name.LastIndexOf(".") > name.LastIndexOf("/") + 1) and (isOutput is false)
Contained(folder Text, ignored Texts = List(Text)) Texts
	Probe.Contained("NeuralNetworks/images").Length is Probe.Found("NeuralNetworks/images").Length
	if DataFiles(ignored).Excluded(folder)
		return List(Text)
	mutable files = Directory.Files(folder)
	for Directory.Directories(folder)
		files = files + Contained(value, ignored)
	files
