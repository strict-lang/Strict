has source Text
constant Probe = BinaryFile("./Bytecode/Probe.strict")
constant Packing = Probe.Unpacked(Probe.Packed(Probe.Header(List(Text)), List(TypeEntry) + TypeEntry.HelloLogger, List(TypeEntry)))
constant Outdated = Probe.Unpacked(Probe.Packed(BinaryNames(List(Text) + "./Any.strict").Integers + TypeEntry.FormatVersion + 5, List(TypeEntry), List(TypeEntry)))
Path Text
	Probe.Path is "./Bytecode/Probe.strictbinary"
	source.Substring(0, source.Length - 7) + ".strictbinary"
Header(sources Texts) Numbers
	Probe.Header(List(Text)) is (1, 0, 4)
	mutable integers = BinaryNames(sources).Integers + TypeEntry.FormatVersion
	for sources
		integers = integers + Stamp(value)
	integers
Stamp(path Text) Number
	Probe.Stamp("./Any.strict") > 1.7e12 is true
	Probe.Stamp("./Missing.strict") is 0
	(File(path).Modified * 1000).Floor
Packed(header Numbers, types List(TypeEntry), owners List(TypeEntry)) Bytes
	Probe.Packed((1, 2), List(TypeEntry), List(TypeEntry)).Length > 50 is true
	mutable entries = List(Mutable(ZipEntry)) + ZipEntry("sources", ByteEncoder.Empty.SevenBits(header).bytes)
	for types
		entries.Add(index is 0 then ZipEntry(value.Name + ".bytecode", value.Bytes) else Entry(value, owners))
	for ZipWriter(entries).Bytes
		Byte(value)
Unpacked(bytes Bytes) List(ZipEntry)
	Packing.Length is 2
	Packing.First.content is (1, 0, 4)
	mutable numbers = List(Mutable(Number))
	for bytes
		numbers.Add(value.number)
	ZipReader(numbers).Entries
IsFresh(entries List(ZipEntry)) Boolean
	Probe.IsFresh(Packing) is true
	Probe.IsFresh(Packing + ZipEntry("Missing.reference", List(Number))) is false
	if IsCurrent(entries) is false
		return false
	for entries
		if value.Name.EndsWith(".reference") and (Owned(value.Name.Substring(0, value.Name.Length - 10)).Name is "")
			return false
	true
IsCurrent(entries List(ZipEntry)) Boolean
	Probe.IsCurrent(Packing) is true
	Probe.IsCurrent(Outdated) is false
	Probe.IsCurrent(List(ZipEntry)) is false
	if (entries.Length is 0) or (entries.First.Name is not "sources")
		return false
	let header = EntryDecoder.Of(entries.First.content)
	let start = 1 + header.stream(0)
	let complete = header.stream.Length is start + 1 + header.names.Length
	mutable fresh = complete and (header.stream(start) is TypeEntry.FormatVersion)
	for header.names
		fresh = fresh and (Stamp(value) is header.stream(start + 1 + index))
	fresh
Types(entries List(ZipEntry)) List(TypeEntry)
	Probe.Types(Packing) is List(TypeEntry) + TypeEntry.HelloLogger
	Probe.Types(List(ZipEntry)).Length is 0
	if entries.Length < 2
		return List(TypeEntry)
	for Range(1, entries.Length)
		let entry = entries(value)
		entry.Name.EndsWith(".reference") then Referenced(entry) else EntryDecoder.Of(entry.content).Type
Referenced(entry ZipEntry) TypeEntry
	Probe.Referenced(ZipEntry("Missing.reference", List(Number))).methods.Length is 0
	let owner = Owned(entry.Name.Substring(0, entry.Name.Length - 10))
	TypeReference(owner).Selected(ByteEncoder(entry.content).Integers)
Data(path Text) Texts
	Probe.Data("Compiler/NativeBuild.strict") is ("Compiler/NativeRuntime.mlir")
	Probe.Data("NeuralNetworks/Dataset.strict").Length is 2
	mutable files = List(Mutable(Text))
	for File(path).ReadLines
		for Tokenizer(value).Tokens
			let literal = value.StartsWith("\"") then value.Substring(1, value.Length - 2) else ""
			let name = literal.StartsWith("/") then literal.Substring(1, literal.Length - 1) else literal
			for Found(name)
				if (value is not in files) and (value.EndsWith(".strict") is false)
					files.Add(value)
	files
Found(name Text) Texts
	Probe.Found("Compiler/NativeRuntime.mlir") is List(Text) + "Compiler/NativeRuntime.mlir"
	Probe.Found("Bytecode").Length is 0
	Probe.Found("NeuralNetworks/images").Length is 2
	Probe.Found("..").Length is 0
	if File(name).Exists
		return IsInput(name) then List(Text) + name else List(Text)
	if (Directory.Exists(name) is false) or (name.IndexOf(":") >= 0) or name.StartsWith("..")
		return List(Text)
	Directory.Files(name, "*.strict").Length is 0 then Contained(name) else List(Text)
IsInput(name Text) Boolean
	Probe.IsInput("Compiler/NativeRuntime.mlir") is true
	Probe.IsInput("./Character.test") is false
	Probe.IsInput("strict") is false
	let isOutput = name.EndsWith(".exe") or name.EndsWith(".test") or name.EndsWith(".strictbinary")
	(name.LastIndexOf(".") > name.LastIndexOf("/") + 1) and (isOutput is false)
Contained(folder Text) Texts
	Probe.Contained("NeuralNetworks/images").Length is Probe.Found("NeuralNetworks/images").Length
	mutable files = Directory.Files(folder)
	for Directory.Directories(folder)
		files = files + Contained(value)
	files
Owned(name Text) TypeEntry
	Probe.Owned("Missing").Name is ""
	let owner = BinaryFile(source.Substring(0, source.LastIndexOf("/") + 1) + name + ".strict")
	let isOwnable = (name.IndexOf("/") < 0) and (name.IndexOf("(") < 0) and File(owner.Path).Exists
	let entries = isOwnable then owner.Unpacked(File(owner.Path).ReadBytes) else List(ZipEntry)
	let first = entries.Length > 1 then entries(1).Name else ""
	let unknown = TypeEntry("", List(MemberEntry), List(MethodEntry))
	first is name + ".bytecode" then EntryDecoder.Of(entries(1).content).Type else unknown
Entry(type TypeEntry, owners List(TypeEntry)) ZipEntry
	Probe.Entry(TypeEntry.HelloLogger, List(TypeEntry)).Name is "HelloLogger.bytecode"
	Probe.Entry(TypeEntry.HelloLogger, List(TypeEntry) + TypeEntry.HelloLogger).Name is "HelloLogger.reference"
	for owners
		if TypeReference(value).Covers(type)
			return ZipEntry(type.Name + ".reference", ByteEncoder.Empty.SevenBits(TypeReference(value).Selection(type)).bytes)
	ZipEntry(type.Name + ".bytecode", type.Bytes)