has source Text
constant Probe = BinaryFile("./Bytecode/Probe.strict")
constant Packing = Probe.Unpacked(Probe.Packed(Probe.Header(List(Text)), List(TypeEntry) + TypeEntry.HelloLogger))
constant Outdated = Probe.Unpacked(Probe.Packed(BinaryNames(List(Text) + "./Any.strict").Integers + TypeEntry.FormatVersion + 5, List(TypeEntry)))
Path Text
	Probe.Path is "./Bytecode/Probe.strictbinary"
	source.Substring(0, source.Length - 7) + ".strictbinary"
Header(sources Texts) Numbers
	Probe.Header(List(Text)) is (1, 0, 2)
	mutable integers = BinaryNames(sources).Integers + TypeEntry.FormatVersion
	for sources
		integers = integers + Stamp(value)
	integers
Stamp(path Text) Number
	Probe.Stamp("./Any.strict") > 1.7e12 is true
	Probe.Stamp("./Missing.strict") is 0
	(File(path).Modified * 1000).Floor
Packed(header Numbers, types List(TypeEntry)) Bytes
	Probe.Packed((1, 2), List(TypeEntry)).Length > 50 is true
	mutable entries = List(Mutable(ZipEntry)) + ZipEntry("sources", ByteEncoder.Empty.SevenBits(header).bytes)
	for types
		entries.Add(ZipEntry(value.Name + ".bytecode", value.Bytes))
	for ZipWriter(entries).Bytes
		Byte(value)
Unpacked(bytes Bytes) List(ZipEntry)
	Packing.Length is 2
	Packing.First.content is (1, 0, 2)
	mutable numbers = List(Mutable(Number))
	for bytes
		numbers.Add(value.number)
	ZipReader(numbers).Entries
IsFresh(entries List(ZipEntry)) Boolean
	Probe.IsFresh(Packing) is true
	Probe.IsFresh(Outdated) is false
	Probe.IsFresh(List(ZipEntry)) is false
	if (entries.Length is 0) or (entries.First.Name is not "sources")
		return false
	let header = EntryDecoder.Of(entries.First.content)
	let start = 1 + header.stream(0)
	let complete = header.stream.Length is start + 1 + header.names.Length
	mutable fresh = complete and (header.stream(start) is TypeEntry.FormatVersion)
	for header.names
		fresh = fresh and (Stamp(value) is header.stream(start + 1 + index))
	fresh
Types(entries List(ZipEntry)) List(TypeEntry)
	Probe.Types(Packing) is List(TypeEntry) + TypeEntry.HelloLogger
	for Range(1, entries.Length)
		EntryDecoder.Of(entries(value).content).Type