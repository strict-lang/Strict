has names Texts
constant Empty = BinaryNames(List(Text))
With(name Text) BinaryNames
	BinaryNames("a", "b").With("b").names.Length is 2
	name is in names then BinaryNames(names) else BinaryNames(names + name)
Index(name Text) Number
	BinaryNames("a", "b").Index("b") is 1
	names.Index(name)
Integers Numbers
	BinaryNames("a", "bc").Integers is (6, 2, 1, 97, 2, 98, 99)
	mutable integers = List(Number) + names.Length
	for names
		let bytes = ByteEncoder.Empty.UnicodeBytes(value)
		integers = integers + bytes.Length + bytes
	List(Number) + integers.Length + integers