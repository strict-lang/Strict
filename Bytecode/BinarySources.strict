has sources Texts
has stamps Numbers = List(Number)
constant Listing = TypeEntry("Strict/List(Number)", List(MemberEntry), List(MethodEntry))
constant Mixed = BinarySources(("./Examples/A.strict", "./Examples/data.csv", "./Examples/List.strict"), (1, 2, 3))
constant CompilerStamp = BinarySources(List(Text) + Process.Current.executable).Stamped.stamps.First
Stamped(known = Dictionary(Text, Number)) BinarySources
	BinarySources(List(Text) + "./Missing.strict").Stamped.stamps is (0)
	BinarySources(List(Text) + "./Any.strict").Stamped.stamps.First > 1.7e12
	BinarySources(List(Text) + "./Any.strict").Stamped(Dictionary(("./Any.strict", 5))).stamps is (5)
	mutable found = List(Number)
	for sources
		found = found + (value is in known then known(value) else (File(value).Modified * 1000).Floor)
	BinarySources(sources, found)
Indexed Dictionary(Text, Number)
	Mixed.Indexed("./Examples/List.strict") is 3
	mutable indexed = Dictionary(Text, Number)
	for sources
		indexed(value) = stamps(index)
	indexed
Kept(types List(TypeEntry)) BinarySources
	Mixed.Kept(List(TypeEntry) + Listing).sources is ("./Examples/data.csv", "./Examples/List.strict")
	Mixed.Kept(List(TypeEntry) + Listing).stamps is (2, 3)
	Named(Names(types))
Named(names Texts) BinarySources
	Mixed.Named(List(Text) + "Lists").sources is ("./Examples/data.csv", "./Examples/List.strict")
	mutable kept = List(Text)
	mutable marks = List(Number)
	for sources
		let name = Path(value).FileName.RemoveExtension.text
		if (value.EndsWith(".strict") is false) or (name is in names) or ((name + "s") is in names)
			kept = kept + value
			marks = marks + stamps(index)
	BinarySources(kept, marks)
Typed(types List(TypeEntry), folder Text) BinarySources
	Mixed.Typed(List(TypeEntry) + TypeSource.Sizing.entry, ".").sources.Last is "./Math/Size.strict"
	Mixed.Typed(List(TypeEntry) + Listing, ".").sources.Length is 4
	mutable added = List(Text)
	for types
		let file = FileCompiler.Normalized(TypeSource(value).Located(folder))
		if File(file).Exists and (file is not in sources) and (file is not in added)
			added = added + file
	let found = BinarySources(added).Stamped
	BinarySources(sources + found.sources, stamps + found.stamps)
Names(types List(TypeEntry)) Texts
	Mixed.Names(List(TypeEntry) + Listing) is ("List")
	for types
		let short = TypeEntry.ShortName(value.Name)
		short.IndexOf("(") < 0 then short else short.Substring(0, short.IndexOf("("))
Header Numbers
	Mixed.Header.Last is 3
	BinarySources(List(Text)).Header is (1, 0, 7, CompilerStamp)
	BinaryNames(sources).Integers + TypeEntry.FormatVersion + CompilerStamp + stamps
Matches(stream Numbers, start Number) Boolean
	Mixed.Matches((0, 1, 2, 3), 1)
	Mixed.Matches((0, 1, 2, 4), 1) is false
	for stamps
		if value is not stream(start + index)
			return false
	true
