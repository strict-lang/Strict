has typeFullName Text
has members BinaryMembers
has methods BinaryMethods
constant BytecodeEntryExtension = ".bytecode"
constant Version = 1
constant MagicByte = 83
JustTypeName Text
	let slash = typeFullName.LastIndexOf("/")
	if slash is -1
		return typeFullName
	typeFullName.Substring(slash + 1, 200)
to Text
	JustTypeName + " members=" + members.Length to Text + " methods=" + methods.Length to Text
MethodCount Number
	methods.Length
MemberCount Number
	members.Length
FindMethod(name Text) BinaryMethod
	for methods
		if value.methodName is name
			return value
	BinaryMethod.Create(name, "None")
HasMethod(name Text) Boolean
	for methods
		if value.methodName is name
			return true
	false
AddMethod(method BinaryMethod) BinaryTypeData
	BinaryTypeData.Create("A").AddMethod(BinaryMethod.Create("Run", "None")).MethodCount is 1
	BinaryTypeData(typeFullName, members, methods + method)
AddMember(member BinaryMember) BinaryTypeData
	BinaryTypeData.Create("A").AddMember(BinaryMember("x", "Number", false, 0)).MemberCount is 1
	BinaryTypeData(typeFullName, members + member, methods)
Create(fullName Text) BinaryTypeData
	Create("Strict/Number").JustTypeName is "Number"
	BinaryTypeData(fullName, BinaryMethod.EmptyParams, EmptyMethods)
EmptyMethods BinaryMethods
	List(BinaryMethod)
CreateWithMethod(fullName Text, method BinaryMethod) BinaryTypeData
	BinaryTypeData.CreateWithMethod("A", BinaryMethod.Create("Run", "None")).HasMethod("Run") is true
	Create(fullName).AddMethod(method)