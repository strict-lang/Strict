has mode Text
constant Returning = BranchValues("Number")
constant Value = SyntaxNode("Number", "1")
constant Chained = BodyParser("Pick Number", "\tif 1 > 2", "\t\t3", "\telse", "\t\t4").Block(1, 1)
constant ReturnTrue = SyntaxNode("Body", "", SyntaxNode("Return", "", SyntaxNode("Boolean", "true")))
constant Nested = BodyParser("Picked Numbers", "\tif 1 > 0", "\t\tif 2 > 0", "\t\t\t3").Block(1, 1)
constant Mixed = BodyParser("Run", "\tif 1 > 2", "\t\t3", "\t5").Block(1, 1)
constant Looping = BodyParser("Run", "\tfor 3", "\t\tindex").Block(1, 1).children(0)
constant Result = SyntaxNode("Identifier", "forResult")
constant Selecting = BodyParser("Named Text", "\tif 2 is", "\t\t1 then \"a\"").Block(1, 1)
constant Selector = Selecting.children(0)
constant Unmatched = SyntaxParser(Tokenizer("Error(\"NoCaseMatched\")").Tokens).Parse
Rewritten(body SyntaxNode) SyntaxNode
	BranchValues("Text").Rewritten(Selecting).children(0).children.Last.children.Last.Kind is "ElseValue"
	Returning.Rewritten(Mixed).children is Mixed.children and Returning.Rewritten(Mixed).Kind is "Body"
	Returning.Rewritten(Chained).children.Last.children.Last.children(0).Kind is "Return"
	BranchValues("None").Rewritten(Chained).children(0).children.Last.children(0).Kind is "Number"
	if mode is "None"
		return body
	start = ChainStart(body)
	mutable statements = List(Mutable(SyntaxNode))
	for body.children
		statements.Add(index >= start then Branch(Default(value)) else value)
	SyntaxNode("Body", body.text, statements)
Default(node SyntaxNode) SyntaxNode
	BranchValues("Boolean").Default(Selector).children.Last.children.Last.children(0) is Unmatched
	BranchValues("Texts").Default(Selector).children.Last.children.Last.Kind is "ElseValue"
	BranchValues("None").Default(Selector) is Selector and Returning.Default(Value) is Value
	Returning.Default(Returning.Default(Selector)).children.Last.children.Length is 2
	BranchValues("Text").Default(Selector).children.Last.children(0) is Selector.children.Last.children(0)
	if mode is in ("", "None") or MethodBodies.IsSelector(node) is false
		return node
	cases = node.children.Last
	unmatched = SyntaxNode("ElseValue", "", Unmatched)
	all = cases.children.Last.Kind is "ElseValue" then cases.children else cases.children + unmatched
	SyntaxNode(node.Kind, node.text, (node.children(0), SyntaxNode(cases.Kind, cases.text, all, cases.line)), node.line)
ChainStart(body SyntaxNode) Number
	Returning.ChainStart(Chained) is 0
	Returning.ChainStart(Mixed) is 2
	mutable start = body.children.Length
	for body.children
		if value.Kind is "If"
			start = index
		else if value.Kind is not in ("ElseIf", "Else")
			start = body.children.Length
	start
Branch(node SyntaxNode) SyntaxNode
	Returning.Branch(SyntaxNode("Binary", "+", (Value, Value))).children(1) is Value
	Returning.Branch(Chained.children(0)).children(0) is Chained.children(0).children(0)
	Returning.Branch(Chained.children(0)).children.Last.children(0).Kind is "Return"
	Returning.Branch(Chained.children(0)).line is 2
	if node.HasBody is false
		return node
	mutable parts = List(Mutable(SyntaxNode))
	for node.children
		parts.Add(index is node.children.Length - 1 then LastWrap(value) else value)
	SyntaxNode(node.Kind, node.text, parts, node.line)
LastWrap(block SyntaxNode) SyntaxNode
	Returning.LastWrap(SyntaxNode("Body", "", (Value, Value))).children(0) is Value
	Returning.LastWrap(SyntaxNode("Body", "", (Value, Value))).Kind is "Body"
	Returning.LastWrap(SyntaxNode("Body", "", Value)).children(0).Kind is "Return"
	BranchValues("list").LastWrap(Nested).children(0).children.Last.children(0).children.Last.children(0).text is "Add"
	if block.children.Last.Kind is in ("If", "ElseIf", "Else")
		return Rewritten(block)
	mutable lines = List(Mutable(SyntaxNode))
	for block.children
		lines.Add(index is block.children.Length - 1 then Wrap(value) else value)
	SyntaxNode("Body", block.text, lines)
Wrap(line SyntaxNode) SyntaxNode
	Returning.Wrap(Value).Kind is "Return"
	BranchValues("list").Wrap(Value).text is "Add"
	BranchValues("product").Wrap(Value).children.Last.text is "*"
	BranchValues("any").Wrap(Value).Kind is "If"
	BranchValues("add").Wrap(Value).Kind is "Reassignment"
	Returning.Wrap(SyntaxNode("Number", "1", List(SyntaxNode), 6)).line is 6
	if IsValue(line) is false
		return line.Kind is "For" then Loop(line) else line
	if mode is "any"
		return SyntaxNode("If", "", (line, ReturnTrue), line.line)
	mode is in ("sum", "product", "list", "add") then Accumulate(line) else SyntaxNode("Return", "", line, line.line)
Loop(line SyntaxNode) SyntaxNode
	BranchValues("list").Loop(Looping).Kind is "For"
	BranchValues("list").Wrap(Looping) is BranchValues("list").Loop(Looping)
	BranchValues("list").Wrap(ReturnTrue.children(0)) is ReturnTrue.children(0)
	BranchValues("any").Wrap(Value) is SyntaxNode("If", "", (Value, ReturnTrue))
	Returning.Wrap(Value).children(0) is Value
	BranchValues("list").Loop(Looping).children.Last.children.Last.text is "Add"
	Returning.Loop(Looping).children.Last.children.Last.Kind is "Identifier"
	if mode is not in ("sum", "product", "list", "add")
		return line
	heads = line.children.Slice(0, line.children.Length - 1)
	SyntaxNode("For", line.text, heads + LastWrap(line.children.Last), line.line)
LastLoop(body SyntaxNode) SyntaxNode
	Returning.LastLoop(SyntaxNode("Body", "")) is SyntaxNode("Body", "")
	Returning.LastLoop(SyntaxNode("Body", "", SyntaxNode("If", ""))).Kind is "If"
	Returning.LastLoop(LoopCodegen.BranchLoops).Kind is "For"
	Returning.LastLoop(LoopCodegen.DoubledBody).Kind is "For"
	Returning.LastLoop(MethodCodegen.IfBody).Kind is "Number"
	if body.children.Length is 0
		return body
	last = body.children.Last
	last.Kind is in ("If", "ElseIf", "Else") and last.HasBody then LastLoop(last.children.Last) else last
Reduction(line SyntaxNode) Text
	Returning.Reduction(SyntaxNode("Binary", "+", (Value, Value))) is ""
	Returning.Reduction(SyntaxNode("Identifier", "value")) is ""
	Returning.Reduction(LoopCodegen.ProductBody.children(0).children.Last.children(0)) is "*"
	line.Kind is "Binary" and line.children(0).Kind is "Missing" then line.text else ""
Accumulate(line SyntaxNode) SyntaxNode
	BranchValues("list").Accumulate(Value) is SyntaxNode("MethodCall", "Add", (Result, Value))
	BranchValues("sum").Accumulate(Value).children is (Result, SyntaxNode("Binary", "+", (Result, Value)))
	BranchValues("sum").Accumulate(Value).Kind is "Reassignment"
	BranchValues("sum").Accumulate(SyntaxNode("Number", "1", List(SyntaxNode), 6)).line is 6
	constant result = SyntaxNode("Identifier", "forResult")
	if mode is "list"
		return SyntaxNode("MethodCall", "Add", (result, line), line.line)
	combined = SyntaxNode("Binary", mode is "product" then "*" else "+", (result, line))
	SyntaxNode("Reassignment", "", (result, combined), line.line)
IsValue(line SyntaxNode) Boolean
	Returning.IsValue(SyntaxNode("Binary", "+", (Value, Value))) and Returning.IsValue(SyntaxNode("Identifier", "then"))
	Returning.IsValue(SyntaxNode("MethodCall", "Length", (Value, Value)))
	Returning.IsValue(SyntaxNode("Identifier", "Log"))
	Returning.IsValue(Value)
	Returning.IsValue(SyntaxNode("Return", "", Value)) is false
	Returning.IsValue(SyntaxNode("MethodCall", "Log", (Value, Value))) is false
	Returning.IsValue(SyntaxNode("Binary", "then", (Value, Value))) is false
	if line.Kind is in ("Declaration", "Reassignment", "Return", "If", "ElseIf", "Else", "For", "ElseValue")
		return false
	if line.Kind is "Binary" and line.text is "then"
		return false
	line.Kind is not "MethodCall" or line.text is not in ("Log", "Add", "Remove")