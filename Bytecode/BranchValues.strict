has mode Text
constant Returning = BranchValues("Number")
constant Value = SyntaxNode("Number", "1")
constant Chained = BodyParser("Pick Number", "\tif 1 > 2", "\t\t3", "\telse", "\t\t4").Block(1, 1)
constant ReturnTrue = SyntaxNode("Body", "", SyntaxNode("Return", "", SyntaxNode("Boolean", "true")))
constant Nested = BodyParser("Picked Numbers", "\tif 1 > 0", "\t\tif 2 > 0", "\t\t\t3").Block(1, 1)
constant Mixed = BodyParser("Run", "\tif 1 > 2", "\t\t3", "\t5").Block(1, 1)
constant Looping = BodyParser("Run", "\tfor 3", "\t\tindex").Block(1, 1).children(0)
Rewritten(body SyntaxNode) SyntaxNode
	Returning.Rewritten(Chained).children.Last.children.Last.children(0).Kind is "Return"
	BranchValues("None").Rewritten(Chained).children(0).children.Last.children(0).Kind is "Number"
	if mode is "None"
		return body
	let start = ChainStart(body)
	mutable statements = List(Mutable(SyntaxNode))
	for body.children
		let rewritten = index >= start then Branch(value) else value
		statements.Add(rewritten)
	SyntaxNode("Body", body.text, statements)
ChainStart(body SyntaxNode) Number
	Returning.ChainStart(Chained) is 0
	Returning.ChainStart(Mixed) is 2
	mutable start = body.children.Length
	for body.children
		if value.Kind is "If"
			start = index
		else if value.Kind is not in ("ElseIf", "Else")
			start = body.children.Length
	start
Branch(node SyntaxNode) SyntaxNode
	Returning.Branch(Chained.children(0)).children.Last.children(0).Kind is "Return"
	Returning.Branch(Chained.children(0)).line is 2
	if node.HasBody is false
		return node
	mutable parts = List(Mutable(SyntaxNode))
	for node.children
		let part = index is node.children.Length - 1 then LastWrapped(value) else value
		parts.Add(part)
	SyntaxNode(node.Kind, node.text, parts, node.line)
LastWrapped(block SyntaxNode) SyntaxNode
	Returning.LastWrapped(SyntaxNode("Body", "", Value)).children(0).Kind is "Return"
	BranchValues("list").LastWrapped(Nested).children(0).children.Last.children(0).children.Last.children(0).text is "Add"
	if block.children.Last.Kind is in ("If", "ElseIf", "Else")
		return Rewritten(block)
	mutable lines = List(Mutable(SyntaxNode))
	for block.children
		let line = index is block.children.Length - 1 then Wrapped(value) else value
		lines.Add(line)
	SyntaxNode("Body", block.text, lines)
Wrapped(line SyntaxNode) SyntaxNode
	Returning.Wrapped(Value).Kind is "Return"
	BranchValues("list").Wrapped(Value).text is "Add"
	BranchValues("product").Wrapped(Value).children.Last.text is "*"
	BranchValues("any").Wrapped(Value).Kind is "If"
	BranchValues("add").Wrapped(Value).Kind is "Reassignment"
	Returning.Wrapped(SyntaxNode("Number", "1", List(SyntaxNode), 6)).line is 6
	if (line.Kind is "For") or (IsValue(line) is false)
		return line.Kind is "For" then Looped(line) else line
	if mode is "any"
		return SyntaxNode("If", "", (line, ReturnTrue), line.line)
	mode is in ("sum", "product", "list", "add") then Accumulated(line) else SyntaxNode("Return", "", line, line.line)
Looped(line SyntaxNode) SyntaxNode
	BranchValues("list").Looped(Looping).children.Last.children.Last.text is "Add"
	Returning.Looped(Looping).children.Last.children.Last.Kind is "Identifier"
	if mode is not in ("sum", "product", "list", "add")
		return line
	let heads = line.children.Slice(0, line.children.Length - 1)
	SyntaxNode("For", line.text, heads + LastWrapped(line.children.Last), line.line)
LastLoop(body SyntaxNode) SyntaxNode
	Returning.LastLoop(LoopCodegen.BranchLoops).Kind is "For"
	Returning.LastLoop(LoopCodegen.DoubledBody).Kind is "For"
	Returning.LastLoop(MethodCodegen.IfBody).Kind is "Number"
	if body.children.Length is 0
		return body
	let last = body.children.Last
	let isBranch = (last.Kind is in ("If", "ElseIf", "Else")) and last.HasBody
	isBranch then LastLoop(last.children.Last) else last
Reduction(line SyntaxNode) Text
	Returning.Reduction(SyntaxNode("Identifier", "value")) is ""
	Returning.Reduction(LoopCodegen.ProductBody.children(0).children.Last.children(0)) is "*"
	(line.Kind is "Binary") and (line.children(0).Kind is "Missing") then line.text else ""
Accumulated(line SyntaxNode) SyntaxNode
	BranchValues("sum").Accumulated(Value).Kind is "Reassignment"
	BranchValues("sum").Accumulated(SyntaxNode("Number", "1", List(SyntaxNode), 6)).line is 6
	constant result = SyntaxNode("Identifier", "forResult")
	if mode is "list"
		return SyntaxNode("MethodCall", "Add", (result, line), line.line)
	let combined = SyntaxNode("Binary", (mode is "product" then "*" else "+"), (result, line))
	SyntaxNode("Reassignment", "", (result, combined), line.line)
IsValue(line SyntaxNode) Boolean
	Returning.IsValue(Value)
	Returning.IsValue(SyntaxNode("Return", "", Value)) is false
	Returning.IsValue(SyntaxNode("MethodCall", "Log", (Value, Value))) is false
	Returning.IsValue(SyntaxNode("Binary", "then", (Value, Value))) is false
	if line.Kind is in ("Declaration", "Reassignment", "Return", "If", "ElseIf", "Else", "For", "ElseValue")
		return false
	if (line.Kind is "Binary") and (line.text is "then")
		return false
	(line.Kind is not "MethodCall") or (line.text is not in ("Log", "Add", "Remove"))