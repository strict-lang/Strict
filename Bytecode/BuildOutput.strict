Intermediate(path Text) Text
	BuildOutput.Intermediate("Examples\Sum.strict") is "./Examples/obj/Sum.strict"
	BuildOutput.Intermediate("C:/s/A") is "C:/s/obj/A"
	let normalized = FileCompiler.Normalized(path)
	let slash = normalized.LastIndexOf("/")
	normalized.Substring(0, slash) + "/obj" + normalized.Substring(slash, normalized.Length - slash)
Delivered(base Text) Text
	BuildOutput.Delivered("./Examples/obj/Sum") is "./Examples/Sum"
	BuildOutput.Delivered("./obj/Strict") is "./Strict"
	BuildOutput.Delivered("./Math/obj/Tests.test") is "./Math/obj/Tests.test"
	BuildOutput.Delivered("Compiler/output/Sum") is "Compiler/output/Sum"
	let slash = base.LastIndexOf("/")
	let isObj = ((base.EndsWith(".test") is false) and (slash >= 4)) and (base.Substring(slash - 4, 4) is "/obj")
	isObj then base.Substring(0, slash - 4) + base.Substring(slash, base.Length - slash) else base
Released(base Text, platformName Text) Text
	BuildOutput.Released("./Examples/obj/Sum", "Linux") is "./Examples/Release/Linux/Sum"
	BuildOutput.Released("./Math/obj/Tests.test", "Linux") is "./Math/obj/Tests.test"
	if base.EndsWith(".test")
		return base
	let program = Delivered(base)
	let slash = program.LastIndexOf("/")
	program.Substring(0, slash) + "/Release/" + platformName + program.Substring(slash, program.Length - slash)
Shipped(release Text, sidecar Text) Text
	BuildOutput.Shipped("Compiler/output/Unshipped", "A/obj/B.ptx") is "Compiler/output/Unshipped/B.ptx"
	BuildOutput.Shipped("Compiler/output/Unshipped", "A/obj/B.runtime.ptx").EndsWith("/Unshipped/shared.runtime.ptx")
	let name = Path(sidecar).FileName.text
	let at = name.IndexOf(".runtime.")
	if at < 0
		return release + "/" + name
	let shared = release + "/shared" + name.Substring(at, name.Length - at)
	let isShared = (File(shared).Exists is false) or (File(shared).ReadBytes is File(sidecar).ReadBytes)
	if isShared
		File(release + "/" + name).Delete
	isShared then shared else release + "/" + name
Newer(path Text, sources Texts) Text
	BuildOutput.Newer("Compiler/output/missing.exe", List(Text) + "BuildOutput.strict") is ""
	if File(path).Exists is false
		return ""
	let built = File(path).Modified
	for sources
		if File(value).Exists
			if File(value).Modified > built
				return ""
	path
Fresh(base Text, extension Text, sources Texts) Text
	BuildOutput.Fresh("Compiler/output/missing", ".exe", List(Text) + "BuildOutput.strict") is ""
	let delivered = Newer(Delivered(base) + extension, sources)
	let released = Newer(Released(base, Platform.NameOf(Platform.Current)) + extension, sources)
	if (released is "") or (delivered is "")
		return released is "" then delivered else released
	File(released).Modified >= File(delivered).Modified then released else delivered
