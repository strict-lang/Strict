Intermediate(path Text) Text
	BuildOutput.Intermediate("Examples\Sum.strict") is "./Examples/obj/Sum.strict"
	BuildOutput.Intermediate("C:/s/A") is "C:/s/obj/A"
	normalized = FileCompiler.Normalize(path)
	slash = normalized.LastIndexOf("/")
	normalized.Substring(0, slash) + "/obj" + normalized.Substring(slash)
Deliver(base Text) Text
	BuildOutput.Deliver("./Examples/obj/Sum") is "./Examples/Sum"
	BuildOutput.Deliver("./obj/Strict") is "./Strict"
	BuildOutput.Deliver("./Math/obj/Tests.test") is "./Math/obj/Tests.test"
	BuildOutput.Deliver("Compiler/output/Sum") is "Compiler/output/Sum"
	slash = base.LastIndexOf("/")
	isObj = base.EndsWith(".test") is false and slash >= 4 and base.Substring(slash - 4, 4) is "/obj"
	isObj then base.Substring(0, slash - 4) + base.Substring(slash) else base
ReleasePath(base Text, platformName Text) Text
	BuildOutput.ReleasePath("./Examples/obj/Sum", "Linux") is "./Examples/Release/Linux/Sum"
	BuildOutput.ReleasePath("./Math/obj/Tests.test", "Linux") is "./Math/obj/Tests.test"
	if base.EndsWith(".test")
		return base
	program = Deliver(base)
	slash = program.LastIndexOf("/")
	program.Substring(0, slash) + "/Release/" + platformName + program.Substring(slash)
Ship(release Text, sidecar Text) Text
	BuildOutput.Ship("Compiler/output/Unshipped", "A/obj/B.ptx") is "Compiler/output/Unshipped/B.ptx"
	BuildOutput.Ship("Compiler/output/Unshipped", "A/obj/B.runtime.ptx").EndsWith("/Unshipped/shared.runtime.ptx")
	name = Path(sidecar).FileName.text
	at = name.IndexOf(".runtime.")
	if at < 0
		return release + "/" + name
	ending = name.Substring(at)
	shared = release + "/shared" + ending
	if IsKept(release, sidecar, name.Substring(0, at), ending)
		return release + "/" + name
	Swept(release, sidecar, ending)
	shared
IsKept(release Text, sidecar Text, program Text, ending Text) Boolean slow
	BuildOutput.IsKept("Compiler/output/Unshipped", "A/obj/B.runtime.ptx", "B", ".runtime.ptx") is false
	shared = File(release + "/shared" + ending)
	shared.Exists and shared.ReadBytes is not File(sidecar).ReadBytes and Dependents(release, program, ending).Length > 0
Swept(release Text, sidecar Text, ending Text) slow
	BuildOutput.Swept("Compiler/output/Unshipped", "A/obj/B.runtime.ptx", ".runtime.ptx") is not Error
	File(release + "/" + Path(sidecar).FileName.text).Delete
	for Directory.Files(release, "*" + ending)
		if Path(value).FileName.text is not "shared" + ending and File(value).ReadBytes is File(sidecar).ReadBytes
			File(value).Delete
Dependents(release Text, program Text, ending Text) Texts slow
	BuildOutput.Dependents("Compiler/output/Unshipped", "B", ".runtime.ptx").Length is 0
	for Directory.Files(release, "*.ptx")
		stem = Path(value).FileName.text.Replace(".ptx", "")
		if stem.IndexOf(".") < 0 and stem is not program and File(release + "/" + stem + ending).Exists is false
			stem
Newer(path Text, sources Texts) Text
	BuildOutput.Newer("Compiler/output/missing.exe", List(Text) + "BuildOutput.strict") is ""
	if File(path).Exists is false
		return ""
	built = File(path).Modified
	for sources
		if File(value).Exists
			if File(value).Modified > built
				return ""
	path
Fresh(base Text, extension Text, sources Texts) Text
	BuildOutput.Fresh("Compiler/output/missing", ".exe", List(Text) + "BuildOutput.strict") is ""
	delivered = Newer(Deliver(base) + extension, sources)
	released = Newer(ReleasePath(base, Platform.NameOf(Platform.Current)) + extension, sources)
	if released is "" or delivered is ""
		return released is "" then delivered else released
	File(released).Modified >= File(delivered).Modified then released else delivered
Packages(folder Text) Texts
	BuildOutput.Packages("Math").Length is 0 and BuildOutput.Packages("Examples").Length > 0
	for Directory.Directories(folder).Sorted
		if ResolveCheck.IsCode(Path(value).FileName.text, value)
			value
