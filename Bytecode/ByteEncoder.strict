has bytes Numbers
constant Empty = ByteEncoder(List(Number))
constant SevenBitBase = 128
constant SignBit = 128
constant ExponentLowBits = 16
constant ExponentBias = 1023
constant MantissaBits = Number.IntegerBits - 1
constant LowMantissaBits = 48
UInt(number Number, size Number) ByteEncoder
	ByteEncoder(1, 2).UInt(258, 2).bytes is (1, 2, 2, 1)
	mutable result = bytes
	mutable rest = number
	for size
		result = result + rest % Byte.Values
		rest = (rest / Byte.Values).Floor
	ByteEncoder(result)
SevenBit(number Number) ByteEncoder
	ByteEncoder(1, 2).SevenBit(300).bytes is (1, 2, 172, 2)
	mutable result = bytes
	mutable rest = number
	for (rest / SevenBitBase).Floor > 0 then SevenBitLength(rest) else 1
		result = result + ((rest < SevenBitBase) then rest else rest % SevenBitBase + SevenBitBase)
		rest = (rest / SevenBitBase).Floor
	ByteEncoder(result)
SevenBits(numbers Numbers) ByteEncoder
	ByteEncoder(List(Number)).SevenBits((1, 300)).bytes is (1, 172, 2)
	mutable encoder = ByteEncoder(bytes)
	for numbers
		encoder = encoder.SevenBit(value)
	encoder
Integers Numbers
	ByteEncoder(1, 172, 2).Integers is (1, 300)
	mutable integers = List(Mutable(Number))
	mutable number = 0
	mutable scale = 1
	for bytes
		number = number + (value < SevenBitBase then value else value - SevenBitBase) * scale
		scale = scale * SevenBitBase
		if value < SevenBitBase
			integers.Add(number)
			number = 0
			scale = 1
	integers
Spelled(start Number, length Number) Text
	ByteEncoder(104, 105, 195, 164).Spelled(2, 2) is "ä"
	for Range(start, start + length)
		Character(bytes(value))
SevenBitLength(number Number) Number
	ByteEncoder(1, 2).SevenBitLength(300) is 2
	number < SevenBitBase then 1 else 1 + SevenBitLength((number / SevenBitBase).Floor)
Text(text Text) ByteEncoder
	ByteEncoder(1, 2).Text("ä").bytes is (1, 2, 2, 195, 164)
	let unicode = UnicodeBytes(text)
	ByteEncoder(SevenBit(unicode.Length).bytes + unicode)
UnicodeBytes(text Text) Numbers
	ByteEncoder(1, 2).UnicodeBytes("aä€") is (97, 195, 164, 226, 130, 172)
	for text
		Character(value).number
Double(number Number) ByteEncoder
	ByteEncoder(1, 2).Double(1.5).bytes is (1, 2, 0, 0, 0, 0, 0, 0, 248, 63)
	ByteEncoder(1, 2).Double(-2).bytes is (1, 2, 0, 0, 0, 0, 0, 0, 0, 192)
	ByteEncoder(1, 2).Double(0.1).bytes is (1, 2, 154, 153, 153, 153, 153, 153, 185, 63)
	ByteEncoder.Empty.Double(-3 * 2 ^ -1074).bytes is (3, 0, 0, 0, 0, 0, 0, 128)
	let isSubnormal = number.Absolute < 2 ^ (1 - ExponentBias)
	let exponent = isSubnormal then -ExponentBias else Exponent(number.Absolute)
	let normal = (number.Absolute / 2 ^ exponent - 1) * 2 ^ MantissaBits
	let mantissa = isSubnormal then number.Absolute / 2 ^ (1 - ExponentBias - MantissaBits) else normal
	let low = UInt(mantissa % 2 ^ LowMantissaBits, 6)
	let high = (mantissa / 2 ^ LowMantissaBits).Floor + ((exponent + ExponentBias) % ExponentLowBits) * ExponentLowBits
	let top = ((exponent + ExponentBias) / ExponentLowBits).Floor + (number < 0 then SignBit else 0)
	low.UInt(high, 1).UInt(top, 1)
Exponent(positive Number) Number
	ByteEncoder(1, 2).Exponent(10) is 3
	ByteEncoder(1, 2).Exponent(0.25) is -2
	positive >= 2 then 1 + Exponent(positive / 2) else positive < 1 then Exponent(positive * 2) - 1 else 0