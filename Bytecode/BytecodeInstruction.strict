has typeName Text
has register Number
has amount Number
has label Text
to Text
	BytecodeInstruction.ReturnOp(2) to Text is "Return R2"
	InstructionText(typeName, register, amount, label).Format
ResultRegister Number
	BytecodeInstruction.BinaryOp(InstructionType.Add, 0, 1, 2).ResultRegister is 2
	if label is ""
		return 0
	label to Number
IsBinary Boolean
	BytecodeInstruction.BinaryOp(InstructionType.Modulo, 0, 1, 2).IsBinary is true
	if typeName is in ("Add", "Subtract", "Multiply", "Divide", "Modulo")
		return true
	IsCompare
IsCompare Boolean
	BytecodeInstruction("LessThan", 0, 1, "2").IsCompare is true
	typeName is in ("Equal", "NotEqual", "LessThan", "GreaterThan")
IsLoad Boolean
	BytecodeInstruction.SetNumber(0, 1).IsLoad is true
	typeName is in ("LoadConstantToRegister", "LoadVariableToRegister", "Set")
IsReturn Boolean
	typeName is "Return"
SetNumber(reg Number, number Number) BytecodeInstruction
	BytecodeInstruction.SetNumber(0, 5).typeName is "Set"
	BytecodeInstruction("Set", reg, number, "")
LoadConstant(reg Number, number Number) BytecodeInstruction
	BytecodeInstruction.LoadConstant(1, 10).typeName is "LoadConstantToRegister"
	BytecodeInstruction("LoadConstantToRegister", reg, number, "")
LoadVariable(reg Number, name Text) BytecodeInstruction
	BytecodeInstruction.LoadVariable(0, "x").label is "x"
	BytecodeInstruction("LoadVariableToRegister", reg, 0, name)
StoreConstant(name Text, number Number) BytecodeInstruction
	BytecodeInstruction.StoreConstant("n", 5).label is "n"
	BytecodeInstruction("StoreConstantToVariable", 0, number, name)
StoreRegister(reg Number, name Text) BytecodeInstruction
	BytecodeInstruction.StoreRegister(2, "result").label is "result"
	BytecodeInstruction("StoreRegisterToVariable", reg, 0, name)
BinaryOp(code Number, left Number, right Number, result Number) BytecodeInstruction
	BytecodeInstruction.BinaryOp(InstructionType.Add, 0, 1, 2).typeName is "Add"
	BytecodeInstruction(InstructionNames(code).Name, left, right, result to Text)
JumpOp(code Number, steps Number) BytecodeInstruction
	BytecodeInstruction.JumpOp(InstructionType.JumpIfFalse, 2).amount is 2
	BytecodeInstruction(InstructionNames(code).Name, 0, steps, "")
ReturnOp(reg Number) BytecodeInstruction
	BytecodeInstruction.ReturnOp(3).IsReturn is true
	BytecodeInstruction("Return", reg, 0, "")