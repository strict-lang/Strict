has types Expressions/KnownTypes
has shape Expressions/TypeShape
has fullName Text
has typeNames Texts
constant NoScope = Scope(("x", "z"), ("y", "w"))
constant Greeter = TypeShape("has text", "Greet Text", "\t\"Hi \" + text", "Run", "\tGreeter(\"a\").Greet")
constant NoScopes = (NoScope, NoScope)
constant NoTypes = KnownTypes(("A", "B"), NoScopes, NoScopes, NoScopes)
constant Adder = CallTarget(NoTypes, TypeShape("Add(numbers) Number", "\t1"), "Strict/C", List(Text))
constant Ranges = CallTarget(KnownTypes(List(Text) + "Range", NoScopes, NoScopes, (Scope(List(Text) + "from", List(Text) + "Start,ExclusiveEnd"), NoScope)), Greeter, "Strict/Range", List(Text))
constant Overloaded = CallTarget(NoTypes, TypeShape("Members Number", "\tMembers(1)", "Members(lines Number) Number", "\tlines"), "Strict/C", List(Text))
constant Plain = CallTarget(NoTypes, Greeter, "Strict/Examples/Greeter", ("Strict/Logger", "Strict/Examples/Helper"))
Signature(name Text, type Text, returnType Text, arguments Number) Texts
	Plain.Signature("Greeter", "Greeter", "Greeter", 1) is ("Strict/Examples/Greeter", "from", "Greeter", "text")
	Plain.Signature("Greet", "Greeter", "Text", 0) is ("Strict/Examples/Greeter", "Greet", "Strict/Text")
	Plain.Signature("Length", "Text", "Number", 0) is ("Strict/Text", "Length", "Strict/Number")
	if type is not TypeName
		return OtherSignature(name, type, returnType, arguments)
	if name is TypeName
		return (fullName, "from", name) + FromNames(name)
	(fullName, name, FullName(returnType)) + Overload(name, arguments).ParameterNames
OtherSignature(name Text, type Text, returnType Text, arguments Number) Texts
	Plain.OtherSignature("C", "C", "C", 0) is ("Strict/C", "from", "C")
	Plain.OtherSignature("Length", "Text", "Number", 0) is ("Strict/Text", "Length", "Strict/Number")
	if name is type
		return (FullName(type), "from", type) + FromNames(type)
	(FullName(type), name, FullName(returnType)) + types.ParametersOf(type, name, arguments)
ParameterTypes(name Text, type Text, arguments Number) Texts
	Plain.ParameterTypes("Greeter", "Greeter", 1) is ("Text")
	Adder.ParameterTypes("Add", "C", 1) is ("Numbers")
	Plain.ParameterTypes("Length", "Text", 0).Length is 0
	if name is not type
		return type is TypeName then Overload(name, arguments).ParameterTypes else List(Text)
	let members = type is TypeName then shape.MemberScope else types.MembersOf(type)
	for FromNames(type)
		members.TypeOf(value)
FromNames(type Text) Texts
	Plain.FromNames("Greeter") is ("text")
	Ranges.FromNames("Range") is ("Start", "ExclusiveEnd")
	if types.IsKnown(type)
		return types.ParametersOf(type, "from", -1)
	type is TypeName then shape.MemberScope.names else List(Text)
Overload(name Text, arguments Number) HeaderTokens
	Overloaded.Overload("Members", 1).ParameterNames is ("lines")
	Overloaded.Overload("Members", 0).ParameterNames.Length is 0
	for shape.lines
		let isNamed = shape.IsMethodHeader(value) and (Tokenizer(value).Tokens.First is name)
		if isNamed and ((arguments is -1) or (HeaderTokens(Tokenizer(value).Tokens).ParameterNames.Length is arguments))
			return HeaderTokens(Tokenizer(value).Tokens)
	arguments is -1 then HeaderTokens(List(Text)) else Header(name)
Header(name Text) HeaderTokens
	Plain.Header("Greet").ReturnType is "Text"
	Plain.Header("Missing").tokens.Length is 0
	Overload(name, -1)
ImplicitOwner(name Text, scope Scope) Text
	Plain.ImplicitOwner("x", Scope(("value", "outer"), ("A", "A"))) is "value"
	Plain.ImplicitOwner("x", Scope(List(Text) + "value", List(Text) + "A")) is ""
	if scope.TypeOf("outer") is not "" and types.MemberType(scope.TypeOf("value"), name) is not "Unknown"
		return "value"
	Header(name).tokens.Length > 0 then "" else InheritingMember(name)
IsMember(type Text, name Text) Boolean
	Plain.IsMember("Greeter", "text") is true
	Plain.IsMember("Greeter", "Greet") is false
	type is TypeName then shape.MemberScope.TypeOf(name) is not "" else types.MembersOf(type).TypeOf(name) is not ""
InheritingMember(name Text) Text
	CallTarget(NoTypes, TypeShape("has a A"), "Strict/C", List(Text)).InheritingMember("x") is "a"
	Plain.InheritingMember("x") is ""
	for shape.MemberScope.names
		if types.MethodsOf(shape.MemberScope.TypeOf(value)).TypeOf(name) is not ""
			return value
	""
FullName(type Text) Text
	Plain.FullName("Logger") is "Strict/Logger"
	Plain.FullName("Numbers") is "Strict/List(Number)"
	Plain.FullName("Greeter") is "Strict/Examples/Greeter"
	Plain.FullName("Helper") is "Strict/Examples/Helper"
	Plain.FullName("None") is "None"
	if type is in ("None", TypeName)
		return type is "None" then type else fullName
	if types.IsPlural(type)
		return "Strict/List(" + types.ElementType(type) + ")"
	PackageType(type) is "" then "Strict/" + type else PackageType(type)
PackageType(type Text) Text
	Plain.PackageType("Helper") is "Strict/Examples/Helper"
	Plain.PackageType("Number") is ""
	let local = fullName.Substring(0, fullName.LastIndexOf("/") + 1) + type
	if local is in typeNames
		return local
	for typeNames
		if Path(value).FileName.text is type
			return value
	""
TypeName Text
	Plain.TypeName is "Greeter"
	fullName.Substring(fullName.LastIndexOf("/") + 1, fullName.Length - fullName.LastIndexOf("/") - 1)