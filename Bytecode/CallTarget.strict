has types Expressions/KnownTypes
has shape Expressions/TypeShape
has fullName Text
has typeNames Texts
constant NoScope = Scope(("x", "z"), ("y", "w"))
constant Greeter = TypeShape("has text", "Greet Text", "\t\"Hi \" + text", "Run", "\tGreeter(\"a\").Greet")
constant NoScopes = (NoScope, NoScope)
constant NoTypes = KnownTypes(("A", "B"), NoScopes, NoScopes, NoScopes)
constant Adder = CallTarget(NoTypes, TypeShape("Add(numbers) Number", "\t1"), "Strict/C", List(Text))
constant Ranges = CallTarget(KnownTypes(List(Text) + "Range", NoScopes, NoScopes, (Scope(List(Text) + "from", List(Text) + "Start,ExclusiveEnd"), NoScope)), Greeter, "Strict/Range", List(Text))
constant Overloaded = CallTarget(NoTypes, TypeShape("Members Number", "\tMembers(1)", "Members(lines Number) Number", "\tlines"), "Strict/C", List(Text))
constant BareError = SyntaxNode("Identifier", "Error")
constant Plain = CallTarget(NoTypes, Greeter, "Strict/Examples/Greeter", ("Strict/Logger", "Strict/Examples/Helper"))
constant Counting = CallTarget(KnownTypes.Sample, Greeter, "Strict/C", List(Text))
constant Colored = CallTarget(ConversionCodegen.ColorTypes, Greeter, "Strict/C", List(Text))
Signature(name Text, type Text, returnType Text, argumentTypes Texts) Texts
	Plain.Signature("Greeter", "Greeter", "Greeter", List(Text)) is ("Strict/Examples/Greeter", "from", "Greeter", "text")
	Plain.Signature("Greet", "Greeter", "Text", List(Text)) is ("Strict/Examples/Greeter", "Greet", "Strict/Text")
	Plain.Signature("Length", "Text", "Number", List(Text)) is ("Strict/Text", "Length", "Strict/Number")
	CallTarget(NoTypes, Greeter, "Strict/H(T)", List(Text)).Signature("H", "H(T)", "", List(Text)).Index("from") is 1
	if type is not TypeName
		return OtherSignature(name, type, returnType, argumentTypes)
	if (name is TypeName) or TypeName.StartsWith(name + "(")
		return (fullName, "from", TypeName) + FromNames(TypeName)
	(fullName, name, FullName(returnType)) + Chosen(name, argumentTypes).ParameterNames
OtherSignature(name Text, type Text, returnType Text, argumentTypes Texts) Texts
	Plain.OtherSignature("C", "C", "C", List(Text)) is ("Strict/C", "from", "C")
	Plain.OtherSignature("C", "C(Number)", "C(Number)", List(Text) + "Number") is ("Strict/C(Number)", "from", "C(Number)")
	Plain.OtherSignature("Length", "Text", "Number", List(Text)) is ("Strict/Text", "Length", "Strict/Number")
	if (name is type) or type.StartsWith(name + "(")
		return (FullName(type), "from", type) + FromNames(type)
	(FullName(type), name, FullName(returnType)) + Declared(type, name, argumentTypes, "")
ParameterTypes(name Text, type Text, argumentTypes Texts) Texts
	Plain.ParameterTypes("Greeter", "Greeter", List(Text)) is ("Text")
	Adder.ParameterTypes("Add", "C", List(Text)) is ("Numbers")
	Colored.ParameterTypes("Color", "Color", ("Number", "Number", "Number")) is ("ColorValue")
	Plain.ParameterTypes("Length", "Text", List(Text)).Length is 0
	Counting.ParameterTypes("Twice", "Count", List(Text) + "Number") is ("Number")
	if (type is TypeName) and name is not type
		return Chosen(name, argumentTypes).ParameterTypes
	let declared = Declared(type, (name is type then "from" else name), argumentTypes, " types")
	if name is not type or declared.Length > 0
		return declared
	for FromNames(type)
		(type is TypeName then shape.MemberScope else types.MembersOf(type)).TypeOf(value)
FromNames(type Text) Texts
	Plain.FromNames("Greeter") is ("text")
	Ranges.FromNames("Range") is ("Start", "ExclusiveEnd")
	if types.IsKnown(types.BaseName(type))
		return types.ParametersOf(type, "from", -1)
	type is TypeName then shape.MemberScope.names else List(Text)
Chosen(name Text, argumentTypes Texts) HeaderTokens
	Overloaded.Chosen("Members", List(Text) + "Number").ParameterNames is ("lines")
	Overloaded.Chosen("Members", List(Text)).ParameterNames.Length is 0
	let ordinal = Overloads(types).Chosen(TypeName, name, argumentTypes)
	mutable seen = -1
	for shape.lines
		if shape.IsMethodHeader(value) and (Tokenizer(value).Tokens.First is name)
			seen = seen + 1
			let header = HeaderTokens(Tokenizer(value).Tokens)
			if (seen is ordinal) or ((ordinal < 0) and (header.ParameterNames.Length is argumentTypes.Length))
				return header
	Header(name)
IsOverloaded(name Text, type Text) Boolean
	Counting.IsOverloaded("Twice", "Count") is true
	Counting.IsOverloaded("Increment", "Count") is false
	types.ParameterScope(type).Count(name) > 1
Declared(type Text, name Text, argumentTypes Texts, suffix Text) Texts
	Counting.Declared("Count", "Twice", List(Text) + "Number", " types") is ("Number")
	let scope = types.ParameterScope(type)
	let ordinal = Overloads(types).Chosen(type, name, argumentTypes)
	if ordinal < 0
		return types.ParametersOf(type, name + suffix, argumentTypes.Length)
	types.ParameterNames(scope.TypeAt(name + suffix, ordinal))
Header(name Text) HeaderTokens
	Plain.Header("Greet").ReturnType is "Text"
	Plain.Header("Missing").tokens.Length is 0
	for shape.lines
		if shape.IsMethodHeader(value) and (Tokenizer(value).Tokens.First is name)
			return HeaderTokens(Tokenizer(value).Tokens)
	HeaderTokens(List(Text))
WithErrorArguments(node SyntaxNode, scope Scope) SyntaxNode
	Plain.WithErrorArguments(BareError, MethodCodegen.InRun.scope) to Text is "Error(\"Run\", List(Stacktrace))"
	Plain.WithErrorArguments(SyntaxNode("Identifier", "x"), MethodCodegen.InRun.scope) to Text is "x"
	if node.text is not "Error" or node.children.Length > 0
		return node
	constant stacktraces = SyntaxNode("Call", "List", SyntaxNode("Identifier", "Stacktrace"))
	let name = SyntaxNode("Text", "\"" + scope.TypeOf(CodeBlock.ErrorMarker) + "\"")
	SyntaxNode("Call", "Error", (name, stacktraces))
ImplicitOwner(name Text, scope Scope) Text
	Plain.ImplicitOwner("x", Scope(("value", "outer"), ("A", "A"))) is "value"
	Plain.ImplicitOwner("x", Scope(List(Text) + "value", List(Text) + "A")) is ""
	if scope.TypeOf("outer") is not "" and types.MemberType(scope.TypeOf("value"), name) is not "Unknown"
		return "value"
	Header(name).tokens.Length > 0 then "" else InheritingMember(name)
IsMember(type Text, name Text) Boolean
	Plain.IsMember("Greeter", "text") is true
	Plain.IsMember("Greeter", "Greet") is false
	type is TypeName then shape.MemberScope.TypeOf(name) is not "" else types.MembersOf(type).TypeOf(name) is not ""
InheritingMember(name Text) Text
	CallTarget(NoTypes, TypeShape("has a A"), "Strict/C", List(Text)).InheritingMember("x") is "a"
	Plain.InheritingMember("x") is ""
	for shape.MemberScope.names
		if types.MethodsOf(shape.MemberScope.TypeOf(value)).TypeOf(name) is not ""
			return value
	""
FullName(type Text) Text
	Plain.FullName("Logger") is "Strict/Logger"
	Plain.FullName("Numbers") is "Strict/List(Number)"
	Plain.FullName("Greeter") is "Strict/Examples/Greeter"
	Plain.FullName("Helper") is "Strict/Examples/Helper"
	Plain.FullName("None") is "None"
	Plain.FullName("Other") is Plain.FullName(Plain.TypeName)
	if type is in ("None", "Other", TypeName)
		return type is "None" then type else fullName
	if types.IsPlural(type)
		return "Strict/List(" + types.ElementType(type) + ")"
	PackageType(type) is "" then "Strict/" + type else PackageType(type)
PackageType(type Text) Text
	Plain.PackageType("Helper") is "Strict/Examples/Helper"
	Plain.PackageType("Number") is ""
	let local = fullName.Substring(0, fullName.LastIndexOf("/") + 1) + type
	if local is in typeNames
		return local
	for typeNames
		if Path(value).FileName.text is type
			return value
	""
TypeName Text
	Plain.TypeName is "Greeter"
	fullName.Substring(fullName.LastIndexOf("/") + 1, fullName.Length - fullName.LastIndexOf("/") - 1)