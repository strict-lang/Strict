has values ValueCodegen
has method Text
constant Name = "changed_instance"
constant Ticking = TypeCodegen("Strict/Ticker", ("mutable count Number", "has step Number = 1", "Next Number", "\tcount = count + step", "\tcount", "Size Number", "\tstep"), ValueCodegen.NoTypes, List(Text))
constant Tickers = KnownTypes(List(Text) + "Ticker", List(Scope) + Scope(List(Text) + "count", List(Text) + "Number"), List(Scope) + Scope(List(Text) + "Next", List(Text) + "Number"), List(Scope) + Scope(("Next", "Next types", "Next changes"), ("", "", "changes")))
constant Ticked = ChangedInstance(ValueCodegen(TypeInference(Tickers, List(Scope) + KnownTypes.NoMembers), KnownTypes.NoMembers, CallTarget.Plain), "Next")
constant Calling = SyntaxNode("Member", "Next", SyntaxNode("Identifier", "ticker"))
constant Holding = CodeBlock.Empty.Declare("ticker", "Ticker")
constant Mutables = Holding.Declare("ticker mutable", "mutable")
constant OwnNext = SyntaxNode("Call", "Next")
constant Returning = CodeBlock(List(InstructionEntry) + InstructionEntry.Return(5), 1, 0, CodeBlock.Empty.scope)
constant Nexting = ChangedInstance(Ticking.Generator, "Next")
constant Lowered = CodeBlock(Returning.instructions, 7, 0, CodeBlock.Empty.scope)
constant Storing = CodeBlock.Empty.At(9).Stored(Name)
constant Literal = SyntaxNode("Member", "Next", SyntaxNode("Text", "ticker"))
Kept(code CodeBlock) CodeBlock
	Ticking.Method(2).instructions.Last.kind is InstructionType.Return
	Ticking.Method(2).instructions(Ticking.Method(2).instructions.Length - 2).texts is (Name)
	Ticking.Method(5).instructions.Length is 2
	let built = Built(code)
	if built.instructions.Length is 0
		return code
	mutable instructions = List(Mutable(InstructionEntry))
	for code.instructions
		if value.kind is InstructionType.Return
			instructions = instructions + built.instructions
		instructions.Add(value)
	CodeBlock(instructions, built.register, built.nextId, code.scope)
Called(node SyntaxNode, call SyntaxNode, block CodeBlock) CodeBlock
	Ticked.Called(Calling, Calling, Holding).instructions.First.kind is InstructionType.Invoke
	ChangedInstance(Ticking.Generator, "Next").Called(OwnNext, OwnNext, CodeBlock.Empty).instructions(4).texts is ("#this")
	let isOwn = (call.Kind is in ("Identifier", "Call")) and (method is in Changes(values.target.shape.lines).Methods)
	let current = isOwn then values.Expression(Instance, block).Stored("#this") else block
	Back(call, values.Invoke(call, current, -1, values.TypeOf(node, block)), current)
Back(call SyntaxNode, invoked CodeBlock, block CodeBlock) CodeBlock
	Ticked.Back(Calling, Holding.At(1), Mutables).instructions.Length is 1
	Nexting.Unpacked(CodeBlock.Empty.At(1)).instructions.Length is 5
	Nexting.Unpacked(CodeBlock.Empty.At(1)).instructions(0).texts is ("count", "Ticker")
	Nexting.Unpacked(CodeBlock.Empty.At(1)).instructions(0).payload is (2, 1, -1, -2)
	Nexting.Unpacked(CodeBlock.Empty.At(1)).instructions(3).payload is (2, -1)
	Nexting.Unpacked(CodeBlock.Empty.At(1)).instructions(3).texts is ("step")
	Nexting.Unpacked(CodeBlock.Empty.At(1)).instructions(4).payload is (1, -1)
	ChangedInstance(Ticked.values, "Size").StoredBack(Calling, Holding.At(1), Mutables).instructions.Length is 0
	Ticked.StoredBack(Literal, Holding.At(1), Mutables).instructions.Length is 0
	ChangedArguments(values, method).StoredBack(call, StoredBack(call, invoked, block), block)
Unpacked(invoked CodeBlock) CodeBlock
	ChangedInstance(Ticking.Generator, "Next").Unpacked(CodeBlock.Empty.At(1)).instructions.Last.texts is ("#this")
	ChangedInstance(Ticking.Generator, "Size").Unpacked(CodeBlock.Empty.At(1)).instructions.Length is 0
	if method is not in Changes(values.target.shape.lines).Methods
		return invoked
	let changed = invoked.register
	let owner = values.target.TypeName
	mutable unpacked = invoked
	for values.target.shape.MemberScope.names
		let read = InstructionEntry(InstructionType.FieldLoad, (value, owner), (changed + 1, changed, -1, -2))
		unpacked = unpacked.Add(read).Add(InstructionEntry.Named(InstructionType.StoreRegisterToVariable, changed + 1, value))
	unpacked.Add(InstructionEntry.Named(InstructionType.StoreRegisterToVariable, changed, "#this"))
Built(code CodeBlock) CodeBlock
	ChangedInstance(Ticking.Generator, "Next").Built(CodeBlock.Empty).instructions.Last.texts is (Name)
	ChangedInstance(Ticking.Generator, "Size").Built(CodeBlock.Empty).instructions.Length is 0
	ChangedInstance(Ticking.Generator, "Next").Built(Returning).instructions.First.payload(0) is 6
	let start = CodeBlock(List(InstructionEntry), Free(code), code.nextId, code.scope)
	let isChanging = (method is not "from") and (method is in Changes(values.target.shape.lines).Methods)
	let instanced = isChanging then values.Expression(Instance, start).Stored(Name) else start
	ChangedArguments(values, method).Stored(instanced)
Free(code CodeBlock) Number
	ChangedInstance.Free(Returning) is 6
	ChangedInstance.Free(CodeBlock.Empty) is 0
	ChangedInstance.Free(Lowered) is 7
	ChangedInstance.Free(Storing) is Storing.register
	mutable free = code.register
	for code.instructions
		if (value.kind is InstructionType.Return) and (value.payload(0) >= free)
			free = value.payload(0) + 1
	free
Instance SyntaxNode
	ChangedInstance(Ticking.Generator, "Next").Instance.children.Length is 2
	ChangedInstance(Ticking.Generator, "Size").Kept(Returning) is Returning
	Nexting.Kept(Storing).instructions.Length is Storing.instructions.Length
	Nexting.Called(Calling, Calling, Holding).instructions.First.kind is InstructionType.Invoke
	mutable members = List(Mutable(SyntaxNode))
	for values.target.shape.MemberScope.names
		members.Add(SyntaxNode("Identifier", value))
	SyntaxNode("Call", TypeEntry.ShortName(values.target.TypeName), members)
StoredBack(call SyntaxNode, invoked CodeBlock, block CodeBlock) CodeBlock
	Ticked.StoredBack(Calling, Holding.At(1), Mutables).instructions.First.payload is (1, -1)
	Ticked.StoredBack(Calling, Holding.At(1), Holding).instructions.Length is 0
	if call.Kind is in ("Identifier", "Call")
		return Unpacked(invoked)
	let target = call.children(0)
	if (target.Kind is not "Identifier") or (block.scope.TypeOf(target.text + " mutable") is "")
		return invoked
	let type = values.TypeOf(target, block)
	if values.inference.types.ParameterScope(type).TypeOf(method + " changes") is ""
		return invoked
	invoked.Add(InstructionEntry.Named(InstructionType.StoreRegisterToVariable, invoked.register, target.text))
