has instructions List(InstructionEntry)
has register Number
has nextId Number
has scope Expressions/Scope
constant Empty = CodeBlock(List(InstructionEntry), 0, 0, Scope(List(Text), List(Text)))
constant SharedMarker = " shares"
Add(entry InstructionEntry) CodeBlock
	CodeBlock.Empty.Add(InstructionEntry.Return(0)).instructions.Length is 1
	CodeBlock(instructions + entry, register, nextId, scope)
Load(entry InstructionEntry) CodeBlock
	CodeBlock.Empty.Load(InstructionEntry.LoadNumber(0, 5)).register is 1
	CodeBlock(instructions + entry, register + 1, nextId, scope)
Result Number
	CodeBlock.Empty.Load(InstructionEntry.LoadNumber(0, 5)).Result is 0
	register - 1
At(start Number) CodeBlock
	CodeBlock.Empty.Load(InstructionEntry.LoadNumber(0, 5)).At(0).register is 0
	CodeBlock(instructions, start, nextId, scope)
Declare(name Text, type Text) CodeBlock
	CodeBlock.Empty.Declare("a", "Number").scope.TypeOf("a") is "Number"
	CodeBlock(instructions, register, nextId, scope.With(name, type))
Sharing(name Text, shares Boolean) CodeBlock
	CodeBlock.Empty.Sharing("a", true).Owns("a") is false
	CodeBlock(instructions, register, nextId, scope.With(name + SharedMarker, (shares then "shared" else "owned")))
Owns(name Text) Boolean
	CodeBlock.Empty.Sharing("a", false).Owns("a") is true
	scope.TypeOf(name + SharedMarker) is not "shared"
Disowned(name Text) CodeBlock
	CodeBlock.Empty.Sharing("a", false).Disowned("a").Owns("a") is false
	CodeBlock.Empty.Disowned("a").scope.names.Length is 0
	if scope.TypeOf(name + SharedMarker) is "owned"
		return Sharing(name, true)
	CodeBlock(instructions, register, nextId, scope)
Stored(name Text) CodeBlock
	CodeBlock.Empty.Load(InstructionEntry.LoadNumber(0, 1)).Stored("a").instructions(1).payload is (0, -1)
	Add(InstructionEntry.Named(InstructionType.StoreRegisterToVariable, Result, name))
Skipping(name Text, jump Number) CodeBlock
	CodeBlock.Empty.Load(InstructionEntry.LoadBoolean(0, true)).Skipping("a", InstructionType.JumpToIdIfFalse).nextId is 1
	let stored = Stored(name)
	let truth = stored.Load(InstructionEntry.LoadBoolean(stored.register, true))
	let compared = truth.Add(InstructionEntry.Binary(InstructionType.Equal, (Result, truth.Result)))
	compared.Add(InstructionEntry.Jump(jump, nextId)).WithNextId
Joined(name Text, id Number) CodeBlock
	CodeBlock.Empty.Load(InstructionEntry.LoadBoolean(0, true)).Joined("a", 0).instructions.Length is 4
	let stored = Stored(name)
	let ended = stored.Add(InstructionEntry.Jump(InstructionType.JumpEnd, id))
	ended.Load(InstructionEntry.Named(InstructionType.LoadVariableToRegister, ended.register, name))
Chosen(name Text, id Number) CodeBlock
	CodeBlock.Empty.Load(InstructionEntry.LoadNumber(0, 1)).Chosen("a", 0).instructions.Length is 6
	let stored = Stored(name)
	let truth = stored.Load(InstructionEntry.LoadBoolean(stored.register, true))
	let flagged = truth.Add(InstructionEntry.Binary(InstructionType.Equal, (truth.Result, truth.Result)))
	let ended = flagged.Add(InstructionEntry.Jump(InstructionType.JumpEnd, id))
	ended.Add(InstructionEntry.Jump(InstructionType.JumpToIdIfTrue, ended.nextId)).WithNextId
Negated CodeBlock
	CodeBlock.Empty.Load(InstructionEntry.LoadBoolean(0, true)).Negated.Result is 2
	let falsity = Load(InstructionEntry.LoadBoolean(register, false))
	falsity.Load(InstructionEntry.Binary(InstructionType.Equal, (Result, falsity.Result, falsity.register)))
WithNextId CodeBlock
	CodeBlock.Empty.WithNextId.nextId is 1
	CodeBlock(instructions, register, nextId + 1, scope)