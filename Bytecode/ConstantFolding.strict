has typeName Text
has inference Expressions/TypeInference
has isOptimizing Boolean = true
constant Counts = TypeInference(KnownTypes.Sample, TypeInference.Limits)
constant Limits = ConstantFolding("Count", Counts)
constant Calls = ConstantFolding("Count", TypeInference(KnownTypes.Sample, (Scope(List(Text) + "Empty", List(Text) + "Count(1)"), TypeInference.NoShape)))
constant Outered = ConstantFolding("Count", TypeInference(KnownTypes.Sample, (Scope(List(Text) + "Made", List(Text) + "outer.Count(1)"), TypeInference.NoShape)))
constant PainterMethods = (KnownTypes.CountMethods, Scope(List(Text) + "Count", List(Text) + "Count"))
constant Painters = KnownTypes(("Count", "Painter"), (KnownTypes.CountMembers, KnownTypes.NoMembers), PainterMethods, KnownTypes.SampleParameters)
constant Painting = ConstantFolding("Painter", TypeInference(Painters, TypeInference.Limits))
constant Limit = SyntaxNode("Identifier", "Limit")
constant Two = SyntaxNode("Number", "2")
constant Count = SyntaxNode("Identifier", "Count")
constant Plus = SyntaxNode("Binary", "+", (Limit, Two))
constant Local = BodyParser("Run", "\tconstant a = 2", "\tconstant b = a * 3", "\tb + a").Block(1, 1)
constant Owned = ConstantFolding("Text", TypeInference(KnownTypes.Sample, (Scope(("Limit", "Twice", "Alias", "Loop", "Missing"), ("3", "Limit * 2", "Limit", "Loop", "Error")), TypeInference.NoShape)))
constant VectorAngleMembers = (Scope(List(Text) + "numbers", List(Text) + "Numbers"), Scope(List(Text) + "degrees", List(Text) + "Number"))
constant VectorAngleMethods = (KnownTypes.NoMembers, Scope(List(Text) + "from", List(Text) + "Angle"))
constant VectorAngleTypes = KnownTypes(("Vector2", "Angle"), VectorAngleMembers, VectorAngleMethods, KnownTypes.NoMemberPair)
constant Wrapping = ConstantFolding("C", TypeInference(VectorAngleTypes, KnownTypes.NoMemberPair))
constant Cached = ConstantFolding("Count", TypeInference(KnownTypes.Sample, (Scope(("Started", "Bad"), ("Count(1).Twice", "Error(1)")), TypeInference.NoShape)))
Fold(node SyntaxNode) SyntaxNode
	Limits.Fold(Limit).text is "3"
	Limits.Fold(SyntaxNode("Binary", "*", (Limit, Two))).text is "6"
	Limits.Fold(SyntaxNode("Binary", "/", (Limit, SyntaxNode("Number", "0")))).Kind is "Binary"
	Limits.Fold(SyntaxNode("Binary", "+", (SyntaxNode("Identifier", "x"), Two))).Kind is "Binary"
	negated = Negate(Constant(node))
	if negated.Kind is not "Binary" or negated.text is not in ("+", "-", "*", "/", "%")
		return negated
	left = Fold(negated.children(0))
	right = Fold(negated.children(1))
	if left.Kind is not "Number" or right.Kind is not "Number" or right.text is in ("0", "-0")
		return Append(negated, left, right)
	SyntaxNode("Number", Calculate(negated.text, left.text to Number, right.text to Number) to Text)
Append(binary SyntaxNode, list SyntaxNode, element SyntaxNode) SyntaxNode
	Limits.Fold(SyntaxParser(Tokenizer("List(Number) + 0 + 2").Tokens).Parse) to Text is "(0, 2)"
	Limits.Append(Plus, SyntaxParser(Tokenizer("List(Text)").Tokens).Parse, Two).Kind is "Binary"
	Limits.Append(Plus, SyntaxParser(Tokenizer("(1, \"a\")").Tokens).Parse, Two).Kind is "Binary"
	isEmpty = list.Kind is "Call" and list.text is "List" and list.children.Length is 1
	isTyped = isEmpty and list.children(0).text is element.Kind or list.Kind is "List"
	if binary.text is not "+" or element.IsLiteral is false or isTyped is false
		return binary
	elements = isEmpty then List(SyntaxNode) else list.children
	for elements
		if value.Kind is not element.Kind
			return binary
	SyntaxNode("List", "", elements + element)
Inline(body SyntaxNode) SyntaxNode
	Limits.Inline(Local).Kind is "Body"
	Limits.Constant(SyntaxNode("Identifier", "Error")).Kind is "Identifier"
	Limits.Inline(Local).Lines("") is ("6 + 2")
	mutable constants = List(Mutable(SyntaxNode))
	mutable code = List(Mutable(SyntaxNode))
	for body.children
		line = Literal(Substitute(value, constants))
		if line.Kind is "Constant"
			constants.Add(line)
		else
			code.Add(line)
	SyntaxNode("Body", "", code)
Literal(line SyntaxNode) SyntaxNode
	Limits.Literal(SyntaxNode("Call", "constant a", List(SyntaxNode) + Two)).Kind is "Call"
	Limits.Literal(SyntaxNode("Declaration", "let a", List(SyntaxNode) + Two)).Kind is "Declaration"
	Limits.Aliase(SyntaxNode("Call", "Limit"), List(Text)).Kind is "Call"
	Limits.Aliase(SyntaxNode("Member", "Limit", SyntaxNode("Call", "Count")), List(Text)).Kind is "Member"
	Limits.Qualify(SyntaxNode("Call", "Limit")).Kind is "Call"
	Limits.Literal(Local.children(0)) to Text is "a"
	Limits.Literal(Local.children(1)).Kind is "Declaration"
	if line.Kind is not "Declaration" or line.text.StartsWith("constant ") is false
		return line
	folded = Fold(line.children(0))
	isLiteral = folded.Kind is in ("Number", "Text", "Boolean")
	isLiteral then SyntaxNode("Constant", Tokenizer(line.text).Tokens.Last, List(SyntaxNode) + folded) else line
Substitute(node SyntaxNode, constants SyntaxNodes) SyntaxNode
	Limits.Substitute(SyntaxNode("Call", "a"), List(SyntaxNode) + Limits.Literal(Local.children(0))).Kind is "Call"
	Limits.Substitute(SyntaxNode("Identifier", "b"), List(SyntaxNode) + Limits.Literal(Local.children(0))).text is "b"
	Limits.Constant(SyntaxNode("Identifier", "x")).text is "x"
	Limits.Substitute(SyntaxNode("Identifier", "a"), List(SyntaxNode) + Limits.Literal(Local.children(0))).text is "2"
	Limits.Substitute(SyntaxNode("Call", "f", List(SyntaxNode), 4), List(SyntaxNode)).line is 4
	for constants
		if node.Kind is "Identifier" and value.text is node.text
			return value.children(0)
	mutable children = List(Mutable(SyntaxNode))
	for node.children
		children.Add(Substitute(value, constants))
	SyntaxNode(node.Kind, node.text, children, node.line)
Constant(node SyntaxNode) SyntaxNode
	Owned.Constant(SyntaxNode("Member", "Missing", Count)).children(0).Kind is "Text"
	Limits.Constant(SyntaxNode("Member", "Limit", SyntaxNode("Identifier", "Count"))).text is "3"
	Limits.Constant(Two).text is "2"
	Calls.Constant(SyntaxNode("Identifier", "Empty")).Kind is "Call"
	Outered.Constant(SyntaxNode("Identifier", "Made")).children(0).Kind is "Type"
	Owned.Constant(SyntaxNode("Member", "Twice", Count)) to Text is "Count.Limit * 2"
	Owned.Constant(SyntaxNode("Member", "Alias", Count)).text is "3"
	Owned.Constant(SyntaxNode("Member", "Loop", Count)).Kind is "Member"
	Owned.Constant(SyntaxNode("Member", "Missing", Count)) to Text is "Error(\"Missing\")"
	aliased = Aliase(node, List(Text))
	isError = aliased.Kind is "Identifier" and aliased.text is "Error" and node.text is not "Error"
	isError then SyntaxNode("Call", "Error", SyntaxNode("Text", "\"" + node.text + "\"")) else aliased
Aliase(node SyntaxNode, aliases Texts) SyntaxNode
	Limits.Aliase(Limit, List(Text) + "Count.Limit").Kind is "Identifier"
	isOther = node.Kind is "Member" and node.children(0).Kind is in ("Identifier", "Type")
	if node.Kind is not "Identifier" and isOther is false
		return node
	owner = isOther then node.children(0).text else typeName
	if inference.ConstantOf(owner, node.text) is "" or owner + "." + node.text is in aliases
		return node
	parsed = ConstantMethods(inference).Definition(owner, node.text)
	if ConstantMethods(inference, isOptimizing or owner is not typeName).IsCached(owner, node.text)
		return SyntaxNode("MethodCall", node.text, List(SyntaxNode) + SyntaxNode("Type", owner), node.line)
	parsed.Kind is "Member" then Aliase(parsed, aliases + (owner + "." + node.text)) else parsed
Qualify(node SyntaxNode) SyntaxNode
	Limits.Qualify(SyntaxNode("Call", "Twice", (Two, Two))).children(0).Kind is "Type"
	Limits.Qualify(SyntaxNode("Binary", "*", (Limit, Two))) to Text is "Count.Limit * 2"
	Limits.Qualify(SyntaxNode("Call", "Twice", (Two, Two))) to Text is "Count.Twice(2, 2)"
	Limits.Qualify(Limit).children(0).Kind is "Type"
	if node.Kind is "Identifier" and inference.ConstantOf(typeName, node.text) is not ""
		return SyntaxNode("Member", node.text, SyntaxNode("Type", typeName))
	mutable qualified = List(Mutable(SyntaxNode))
	for node.children
		qualified.Add(Qualify(value))
	if node.Kind is "Call" and inference.types.MethodsOf(typeName).TypeOf(node.text) is not ""
		return SyntaxNode("MethodCall", node.text, List(SyntaxNode) + SyntaxNode("Type", typeName) + qualified)
	SyntaxNode(node.Kind, node.text, qualified)
Unhidden(node SyntaxNode) SyntaxNode
	Painting.Unhidden(SyntaxNode("Call", "Count", Two)) to Text is "Count.Count(2)"
	Painting.Unhidden(SyntaxNode("Identifier", "Count")).Kind is "Identifier"
	Painting.Unhidden(SyntaxNode("Call", "Painter", Two)).Kind is "Call"
	Painting.Unhidden(SyntaxNode("Call", "Count", Two)).children(0).Kind is "Type"
	Limits.Unhidden(SyntaxNode("Call", "Count", Two)).Kind is "Call"
	mutable children = List(Mutable(SyntaxNode))
	for node.children
		children.Add(Unhidden(value))
	isHidden = node.Kind is "Call" and inference.types.MethodsOf(typeName).TypeOf(node.text) is not ""
	if isHidden and inference.types.IsKnown(node.text)
		return SyntaxNode("MethodCall", node.text, List(SyntaxNode) + SyntaxNode("Type", node.text) + children, node.line)
	SyntaxNode(node.Kind, node.text, children, node.line)
Outer(node SyntaxNode) SyntaxNode
	Limits.Outer(SyntaxParser(Tokenizer("outer.Count.Twice").Tokens).Parse).children(0).Kind is "Type"
	Limits.Outer(SyntaxParser(Tokenizer("outer.index").Tokens).Parse).children(0).Kind is "Identifier"
	Limits.Outer(SyntaxParser(Tokenizer("outer.Count(1)").Tokens).Parse).children(0).Kind is "Type"
	if node.Kind is in ("Member", "MethodCall")
		isOuter = node.children.Length > 0 then node.children(0) to Text is "outer" else false
		if isOuter then inference.types.IsKnown(node.text) else false
			return OuterNode(node)
	mutable children = List(Mutable(SyntaxNode))
	for node.children
		children.Add(Outer(value))
	SyntaxNode(node.Kind, node.text, children, node.line)
OuterNode(node SyntaxNode) SyntaxNode
	Limits.OuterNode(SyntaxParser(Tokenizer("outer.Count").Tokens).Parse).Kind is "Type"
	Limits.OuterNode(SyntaxParser(Tokenizer("outer.Count(1)").Tokens).Parse).Kind is "MethodCall"
	if node.Kind is "Member"
		return SyntaxNode("Type", node.text, List(SyntaxNode), node.line)
	SyntaxNode("MethodCall", node.text, OuterType(node), node.line)
OuterType(call SyntaxNode) List(SyntaxNode)
	Limits.OuterType(SyntaxParser(Tokenizer("outer.Count(1)").Tokens).Parse).Last.text is "1"
	Limits.Outer(SyntaxParser(Tokenizer("other.Count").Tokens).Parse).Kind is "Member"
	Limits.Outer(SyntaxNode("MethodCall", "Count", List(SyntaxNode))).Kind is "MethodCall"
	Limits.Outer(SyntaxNode("Call", "Count", List(SyntaxNode) + SyntaxNode("Identifier", "outer"))).Kind is "Call"
	Limits.Outer(SyntaxParser(Tokenizer("other.Count(1)").Tokens).Parse).children(0).Kind is "Identifier"
	Limits.Outer(SyntaxParser(Tokenizer("outer.Count(1)").Tokens).Parse).Kind is "MethodCall"
	Limits.Outer(SyntaxParser(Tokenizer("outer.Foo(1)").Tokens).Parse).children(0).Kind is "Identifier"
	Cached.Aliase(SyntaxNode("Identifier", "Started"), List(Text)) to Text is "Count.Started()"
	Limits.Aliase(SyntaxNode("Member", "Limit", SyntaxNode("Type", "Count")), List(Text)).text is "3"
	Limits.OuterType(SyntaxParser(Tokenizer("outer.Count(1)").Tokens).Parse).First.Kind is "Type"
	for call.children
		index is 0 then SyntaxNode("Type", call.text) else Outer(value)
Construct(node SyntaxNode) SyntaxNode
	ConstantFolding("Other", Counts, false).Aliase(SyntaxNode("Member", "Limit", Count), List(Text)).Kind is "Number"
	Limits.Construct(SyntaxNode("MethodCall", "Count", (SyntaxNode("Type", "Count"), Two))) to Text is "Count(2)"
	Limits.Construct(SyntaxNode("MethodCall", "Count", (SyntaxNode("Type", "Other"), Two))).Kind is "MethodCall"
	Limits.Construct(SyntaxNode("MethodCall", "Count", (SyntaxNode("Identifier", "Count"), Two))).Kind is "MethodCall"
	Limits.Construct(SyntaxNode("MethodCall", "Count", List(SyntaxNode))).Kind is "MethodCall"
	Limits.Construct(SyntaxNode("Call", "Count", (SyntaxNode("Type", "Count"), Two))).children.Length is 2
	Limits.Construct(Limits.Qualify(SyntaxNode("Call", "Count", Two))) to Text is "Count(2)"
	Limits.Construct(Two) is Two
	isTyped = node.Kind is "MethodCall" and node.children.Length > 0 and node.children(0).Kind is "Type"
	if isTyped is false or node.children(0).text is not node.text
		return node
	SyntaxNode("Call", node.text, Rest(node.children), node.line)
Rest(nodes SyntaxNodes) SyntaxNodes
	ConstantFolding("Count", Counts, false).Aliase(Limit, List(Text)).Kind is "MethodCall"
	Limits.Append(Plus, SyntaxParser(Tokenizer("(1, 2)").Tokens).Parse, Two) to Text is "(1, 2, 2)"
	Limits.Append(SyntaxNode("Binary", "-", (Limit, Two)), SyntaxNode("List", "", (Two, Two)), Two).Kind is "Binary"
	Limits.Append(Plus, SyntaxNode("List", "", (Limit, Limit)), Limit).Kind is "Binary"
	Limits.Append(Plus, SyntaxNode("Member", "List", SyntaxNode("Type", "Number")), Two).Kind is "Binary"
	Limits.Append(Plus, SyntaxNode("Call", "Set", SyntaxNode("Type", "Number")), Two).Kind is "Binary"
	Limits.Append(Plus, SyntaxNode("Call", "List", (SyntaxNode("Type", "Number"), Two)), Two).Kind is "Binary"
	Cached.Constant(SyntaxNode("Identifier", "Bad")) to Text is "Error(1)"
	Cached.Aliase(SyntaxNode("Identifier", "Started"), List(Text)).children(0).Kind is "Type"
	Limits.Rest((Two, Limit)) is (Limit) and Limits.Qualify(SyntaxNode("Identifier", "Twice")).Kind is "Identifier"
	for Range(1, nodes.Length)
		nodes(value)
Negate(node SyntaxNode) SyntaxNode
	Limits.Fold(SyntaxNode("Call", "+", (Two, Two))).Kind is "Call"
	Limits.Fold(SyntaxNode("Binary", "<", (Two, Two))).Kind is "Binary"
	Limits.Fold(Plus).text is "5"
	Limits.Fold(SyntaxNode("Binary", "+", (Two, SyntaxNode("Identifier", "x")))).Kind is "Binary"
	Limits.Negate(SyntaxNode("Negate", "", List(SyntaxNode) + Count)).Kind is "Negate"
	Limits.Negate(SyntaxNode("Negate", "", List(SyntaxNode) + Two)).Kind is "Number"
	Limits.Negate(SyntaxNode("Negate", "", List(SyntaxNode) + Two)).text is "-2"
	Limits.Negate(Two).text is "2"
	if node.Kind is not "Negate"
		return node
	inner = Fold(node.children(0))
	inner.Kind is "Number" then SyntaxNode("Number", -(inner.text to Number) to Text) else node
Calculate(operator Text, left Number, right Number) Number
	Limits.Calculate("+", 7, 2) is 9
	Limits.Calculate("/", 8, 2) is 4
	Limits.Unhidden(SyntaxNode("Call", "Twice", Two)).Kind is "Call"
	Limits.Calculate("-", 7, 2) is 5
	Limits.Calculate("%", 7, 2) is 1
	if operator is "+"
		return left + right
	if operator is "-"
		return left - right
	operator is "*" then left * right else operator is "/" then left / right else left % right
Unwrap(node SyntaxNode) SyntaxNode
	Wrapping.Unwrap(SyntaxNode("Identifier", "Vector2")) to Text is "Vector2"
	Wrapping.Unwrap(SyntaxParser(Tokenizer("f(1)").Tokens).Parse) to Text is "f(1)"
	Wrapping.Unwrap(SyntaxParser(Tokenizer("Vector2(1, 2)").Tokens).Parse) to Text is "(1, 2)"
	Wrapping.Unwrap(SyntaxParser(Tokenizer("Vector2(Limit)").Tokens).Parse) to Text is "Limit"
	Wrapping.Unwrap(SyntaxParser(Tokenizer("Angle(90)").Tokens).Parse) to Text is "Angle(90)"
	Limits.Unwrap(Limit).text is "3"
	folded = Construct(Fold(node))
	members = inference.types.MembersOf(folded.text).types
	isWrapper = folded.Kind is "Call" and members.Length is 1 and TypeEntry.IsBaseName(folded.text) is false
	if isWrapper is false or inference.types.MethodsOf(folded.text).TypeOf("from") is not ""
		return folded
	folded.children.Length is 1 then Fold(folded.children(0)) else SyntaxNode("List", "", folded.children)