has typeName Text
has inference Expressions/TypeInference
constant Counts = TypeInference(KnownTypes.Sample, TypeInference.Limits)
constant Limits = ConstantFolding("Count", Counts)
constant Calls = ConstantFolding("Count", TypeInference(KnownTypes.Sample, (Scope(List(Text) + "Empty", List(Text) + "Count(1)"), TypeInference.NoShape)))
constant Outered = ConstantFolding("Count", TypeInference(KnownTypes.Sample, (Scope(List(Text) + "Made", List(Text) + "outer.Count(1)"), TypeInference.NoShape)))
constant Painting = ConstantFolding("Painter", TypeInference(KnownTypes(("Count", "Painter"), (KnownTypes.CountMembers, KnownTypes.NoMembers), (KnownTypes.CountMethods, Scope(List(Text) + "Count", List(Text) + "Count")), KnownTypes.SampleParameters), TypeInference.Limits))
constant Limit = SyntaxNode("Identifier", "Limit")
constant Two = SyntaxNode("Number", "2")
constant Count = SyntaxNode("Identifier", "Count")
constant Plus = SyntaxNode("Binary", "+", (Limit, Two))
constant Local = BodyParser("Run", "\tconstant a = 2", "\tconstant b = a * 3", "\tb + a").Block(1, 1)
constant Owned = ConstantFolding("Text", TypeInference(KnownTypes.Sample, (Scope(("Limit", "Twice", "Alias", "Loop", "Missing"), ("3", "Limit * 2", "Limit", "Loop", "Error")), TypeInference.NoShape)))
constant Wrapping = ConstantFolding("C", TypeInference(KnownTypes(("Vector2", "Angle"), (Scope(List(Text) + "numbers", List(Text) + "Numbers"), Scope(List(Text) + "degrees", List(Text) + "Number")), (KnownTypes.NoMembers, Scope(List(Text) + "from", List(Text) + "Angle")), (KnownTypes.NoMembers, KnownTypes.NoMembers)), (KnownTypes.NoMembers, KnownTypes.NoMembers)))
Folded(node SyntaxNode) SyntaxNode
	Limits.Folded(Limit).text is "3"
	Limits.Folded(SyntaxNode("Binary", "*", (Limit, Two))).text is "6"
	Limits.Folded(SyntaxNode("Binary", "/", (Limit, SyntaxNode("Number", "0")))).Kind is "Binary"
	Limits.Folded(SyntaxNode("Binary", "+", (SyntaxNode("Identifier", "x"), Two))).Kind is "Binary"
	let negated = Negated(Constant(node))
	if negated.Kind is not "Binary" or negated.text is not in ("+", "-", "*", "/", "%")
		return negated
	let left = Folded(negated.children(0))
	let right = Folded(negated.children(1))
	if left.Kind is not "Number" or right.Kind is not "Number" or (right.text is "0")
		return Appended(negated, left, right)
	SyntaxNode("Number", Calculated(negated.text, left.text to Number, right.text to Number) to Text)
Appended(binary SyntaxNode, list SyntaxNode, element SyntaxNode) SyntaxNode
	Limits.Folded(SyntaxParser(Tokenizer("List(Number) + 0 + 2").Tokens).Parse) to Text is "(0, 2)"
	Limits.Appended(Plus, SyntaxParser(Tokenizer("List(Text)").Tokens).Parse, Two).Kind is "Binary"
	Limits.Appended(Plus, SyntaxParser(Tokenizer("(1, \"a\")").Tokens).Parse, Two).Kind is "Binary"
	let isEmpty = (list.Kind is "Call") and (list.text is "List") and (list.children.Length is 1)
	let isTyped = isEmpty and (list.children(0).text is element.Kind) or (list.Kind is "List")
	if (binary.text is not "+") or (element.IsLiteral is false) or (isTyped is false)
		return binary
	let elements = isEmpty then List(SyntaxNode) else list.children
	for elements
		if value.Kind is not element.Kind
			return binary
	SyntaxNode("List", "", elements + element)
Inlined(body SyntaxNode) SyntaxNode
	Limits.Inlined(Local).Lines("") is ("6 + 2")
	mutable constants = List(Mutable(SyntaxNode))
	mutable code = List(Mutable(SyntaxNode))
	for body.children
		let line = Literal(Substituted(value, constants))
		if line.Kind is "Constant"
			constants.Add(line)
		else
			code.Add(line)
	SyntaxNode("Body", "", code)
Literal(line SyntaxNode) SyntaxNode
	Limits.Literal(Local.children(0)) to Text is "a"
	Limits.Literal(Local.children(1)).Kind is "Declaration"
	if (line.Kind is not "Declaration") or (line.text.StartsWith("constant ") is false)
		return line
	let folded = Folded(line.children(0))
	let isLiteral = folded.Kind is in ("Number", "Text", "Boolean")
	isLiteral then SyntaxNode("Constant", Tokenizer(line.text).Tokens.Last, List(SyntaxNode) + folded) else line
Substituted(node SyntaxNode, constants SyntaxNodes) SyntaxNode
	Limits.Substituted(SyntaxNode("Identifier", "a"), List(SyntaxNode) + Limits.Literal(Local.children(0))).text is "2"
	Limits.Substituted(SyntaxNode("Call", "f", List(SyntaxNode), 4), List(SyntaxNode)).line is 4
	for constants
		if (node.Kind is "Identifier") and (value.text is node.text)
			return value.children(0)
	mutable children = List(Mutable(SyntaxNode))
	for node.children
		children.Add(Substituted(value, constants))
	SyntaxNode(node.Kind, node.text, children, node.line)
Constant(node SyntaxNode) SyntaxNode
	Limits.Constant(SyntaxNode("Member", "Limit", SyntaxNode("Identifier", "Count"))).text is "3"
	Limits.Constant(Two).text is "2"
	Calls.Constant(SyntaxNode("Identifier", "Empty")).Kind is "Call"
	Outered.Constant(SyntaxNode("Identifier", "Made")).children(0).Kind is "Type"
	Owned.Constant(SyntaxNode("Member", "Twice", Count)) to Text is "Count.Limit * 2"
	Owned.Constant(SyntaxNode("Member", "Alias", Count)).text is "3"
	Owned.Constant(SyntaxNode("Member", "Loop", Count)).Kind is "Member"
	Owned.Constant(SyntaxNode("Member", "Missing", Count)) to Text is "Error(\"Missing\")"
	let aliased = Aliased(node, List(Text))
	let isError = (aliased.Kind is "Identifier") and (aliased.text is "Error") and (node.text is not "Error")
	isError then SyntaxNode("Call", "Error", SyntaxNode("Text", "\"" + node.text + "\"")) else aliased
Aliased(node SyntaxNode, aliases Texts) SyntaxNode
	Limits.Aliased(Limit, List(Text) + "Count.Limit").Kind is "Identifier"
	let isOther = (node.Kind is "Member") and (node.children(0).Kind is in ("Identifier", "Type"))
	if node.Kind is not "Identifier" and (isOther is false)
		return node
	let owner = isOther then node.children(0).text else typeName
	let definition = inference.ConstantOf(owner, node.text)
	if (definition is "") or (owner + "." + node.text is in aliases)
		return node
	let parsed = ConstantMethods(inference).Definition(owner, node.text)
	if ConstantMethods(inference).IsCached(owner, node.text)
		return SyntaxNode("MethodCall", node.text, List(SyntaxNode) + SyntaxNode("Type", owner), node.line)
	parsed.Kind is "Member" then Aliased(parsed, aliases + (owner + "." + node.text)) else parsed
Qualified(node SyntaxNode) SyntaxNode
	Limits.Qualified(SyntaxNode("Binary", "*", (Limit, Two))) to Text is "Count.Limit * 2"
	Limits.Qualified(SyntaxNode("Call", "Twice", (Two, Two))) to Text is "Count.Twice(2, 2)"
	Limits.Qualified(Limit).children(0).Kind is "Type"
	if (node.Kind is "Identifier") and inference.ConstantOf(typeName, node.text) is not ""
		return SyntaxNode("Member", node.text, SyntaxNode("Type", typeName))
	mutable qualified = List(Mutable(SyntaxNode))
	for node.children
		qualified.Add(Qualified(value))
	if (node.Kind is "Call") and (inference.types.MethodsOf(typeName).TypeOf(node.text) is not "")
		return SyntaxNode("MethodCall", node.text, List(SyntaxNode) + SyntaxNode("Type", typeName) + qualified)
	SyntaxNode(node.Kind, node.text, qualified)
Unhidden(node SyntaxNode) SyntaxNode
	Painting.Unhidden(SyntaxNode("Call", "Count", Two)).children(0).Kind is "Type"
	Limits.Unhidden(SyntaxNode("Call", "Count", Two)).Kind is "Call"
	mutable children = List(Mutable(SyntaxNode))
	for node.children
		children.Add(Unhidden(value))
	let isHidden = (node.Kind is "Call") and (inference.types.MethodsOf(typeName).TypeOf(node.text) is not "")
	if isHidden and inference.types.IsKnown(node.text)
		return SyntaxNode("MethodCall", node.text, List(SyntaxNode) + SyntaxNode("Type", node.text) + children, node.line)
	SyntaxNode(node.Kind, node.text, children, node.line)
Outer(node SyntaxNode) SyntaxNode
	Limits.Outer(SyntaxParser(Tokenizer("outer.Count.Twice").Tokens).Parse).children(0).Kind is "Type"
	Limits.Outer(SyntaxParser(Tokenizer("outer.index").Tokens).Parse).children(0).Kind is "Identifier"
	Limits.Outer(SyntaxParser(Tokenizer("outer.Count(1)").Tokens).Parse).children(0).Kind is "Type"
	if (node.Kind is "Member") and (node.children(0) to Text is "outer") and inference.types.IsKnown(node.text)
		return SyntaxNode("Type", node.text, List(SyntaxNode), node.line)
	let isOuterCall = (node.Kind is "MethodCall") and (node.children.Length > 0) and (node.children(0) to Text is "outer")
	if isOuterCall and inference.types.IsKnown(node.text)
		return SyntaxNode("MethodCall", node.text, OuterTyped(node), node.line)
	mutable children = List(Mutable(SyntaxNode))
	for node.children
		children.Add(Outer(value))
	SyntaxNode(node.Kind, node.text, children, node.line)
OuterTyped(call SyntaxNode) List(SyntaxNode)
	Limits.OuterTyped(SyntaxParser(Tokenizer("outer.Count(1)").Tokens).Parse).First.Kind is "Type"
	for call.children
		index is 0 then SyntaxNode("Type", call.text) else Outer(value)
Constructed(node SyntaxNode) SyntaxNode
	Limits.Constructed(Limits.Qualified(SyntaxNode("Call", "Count", Two))) to Text is "Count(2)"
	Limits.Constructed(Two) is Two
	let isTyped = (node.Kind is "MethodCall") and (node.children.Length > 0) and (node.children(0).Kind is "Type")
	if (isTyped is false) or (node.children(0).text is not node.text)
		return node
	SyntaxNode("Call", node.text, Rest(node.children), node.line)
Rest(nodes SyntaxNodes) SyntaxNodes
	Limits.Rest((Two, Limit)) is (Limit)
	for Range(1, nodes.Length)
		nodes(value)
Negated(node SyntaxNode) SyntaxNode
	Limits.Negated(SyntaxNode("Negate", "", List(SyntaxNode) + Two)).text is "-2"
	Limits.Negated(Two).text is "2"
	if node.Kind is not "Negate"
		return node
	let inner = Folded(node.children(0))
	inner.Kind is "Number" then SyntaxNode("Number", -(inner.text to Number) to Text) else node
Calculated(operator Text, left Number, right Number) Number
	Limits.Calculated("-", 7, 2) is 5
	Limits.Calculated("%", 7, 2) is 1
	if operator is "+"
		return left + right
	if operator is "-"
		return left - right
	if operator is "*"
		return left * right
	operator is "/" then left / right else left % right
Unwrapped(node SyntaxNode) SyntaxNode
	Wrapping.Unwrapped(SyntaxParser(Tokenizer("Vector2(1, 2)").Tokens).Parse) to Text is "(1, 2)"
	Wrapping.Unwrapped(SyntaxParser(Tokenizer("Vector2(Limit)").Tokens).Parse) to Text is "Limit"
	Wrapping.Unwrapped(SyntaxParser(Tokenizer("Angle(90)").Tokens).Parse) to Text is "Angle(90)"
	Limits.Unwrapped(Limit).text is "3"
	let folded = Constructed(Folded(node))
	let members = inference.types.MembersOf(folded.text).types
	let isWrapper = (folded.Kind is "Call") and (members.Length is 1) and (TypeEntry.IsBaseName(folded.text) is false)
	if (isWrapper is false) or (inference.types.MethodsOf(folded.text).TypeOf("from") is not "")
		return folded
	folded.children.Length is 1 then Folded(folded.children(0)) else SyntaxNode("List", "", folded.children)