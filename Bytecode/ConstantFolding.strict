has typeName Text
has inference Expressions/TypeInference
constant Counts = TypeInference(KnownTypes.Sample, TypeInference.Limits)
constant Limits = ConstantFolding("Count", Counts)
constant Limit = SyntaxNode("Identifier", "Limit")
constant Two = SyntaxNode("Number", "2")
Folded(node SyntaxNode) SyntaxNode
	Limits.Folded(Limit).text is "3"
	Limits.Folded(SyntaxNode("Binary", "*", (Limit, Two))).text is "6"
	Limits.Folded(SyntaxNode("Binary", "/", (Limit, SyntaxNode("Number", "0")))).Kind is "Binary"
	Limits.Folded(SyntaxNode("Binary", "+", (SyntaxNode("Identifier", "x"), Two))).Kind is "Binary"
	let value = Negated(Constant(node))
	if value.Kind is not "Binary" or value.text is not in ("+", "-", "*", "/", "%")
		return value
	let left = Folded(value.children(0))
	let right = Folded(value.children(1))
	if left.Kind is not "Number" or right.Kind is not "Number" or (right.text is "0")
		return value
	SyntaxNode("Number", Calculated(value.text, left.text to Number, right.text to Number) to Text)
Constant(node SyntaxNode) SyntaxNode
	Limits.Constant(SyntaxNode("Member", "Limit", SyntaxNode("Identifier", "Count"))).text is "3"
	Limits.Constant(Limit).text is "3"
	Limits.Constant(Two).text is "2"
	let isOther = (node.Kind is "Member") and (node.children(0).Kind is "Identifier")
	if node.Kind is not "Identifier" and (isOther is false)
		return node
	let owner = isOther then node.children(0).text else typeName
	let literal = inference.ConstantOf(owner, node.text)
	literal is "" then node else SyntaxParser(List(Text) + literal).Leaf(literal)
Negated(node SyntaxNode) SyntaxNode
	Limits.Negated(SyntaxNode("Negate", "", List(SyntaxNode) + Two)).text is "-2"
	Limits.Negated(Two).text is "2"
	if node.Kind is not "Negate"
		return node
	let inner = Folded(node.children(0))
	inner.Kind is "Number" then SyntaxNode("Number", (0 - inner.text to Number) to Text) else node
Calculated(operator Text, left Number, right Number) Number
	Limits.Calculated("-", 7, 2) is 5
	Limits.Calculated("%", 7, 2) is 1
	if operator is "+"
		return left + right
	if operator is "-"
		return left - right
	if operator is "*"
		return left * right
	operator is "/" then left / right else left % right