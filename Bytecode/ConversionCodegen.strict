has values ValueCodegen
constant Plain = ConversionCodegen(ValueCodegen.Plain)
constant ColorTypes = TypeInference.Colors.types
constant Colored = ConversionCodegen(ValueCodegen(TypeInference(ColorTypes, CallTarget.NoScopes), KnownTypes.NoMembers, CallTarget.Plain))
constant NewColorValue = SyntaxNode("Call", "ColorValue", ValueCodegen.One)
constant NewColor = SyntaxNode("Call", "Color", ValueCodegen.One)
constant ColorReassignment = SyntaxNode("Reassignment", "", (SyntaxNode("Identifier", "c"), NewColorValue))
constant Pixels = SyntaxNode("Identifier", "pixels")
constant Kinded = ConversionCodegen(ValueCodegen(TypeInference(KnownTypes(List(Text) + "Kind", List(Scope) + KnownTypes.NoMembers, List(Scope) + Scope(List(Text) + "to", List(Text) + "Text"), List(Scope) + KnownTypes.NoMembers), CallTarget.NoScopes), KnownTypes.NoMembers, CallTarget.Plain))
constant HelperType = SyntaxParser(Tokenizer("\"Helper\" to Type").Tokens).Parse
constant Pixelated = CodeBlock.Empty.Declare("pixels", "ColorValues")
ArgumentTypes(node SyntaxNode, owner Text, block CodeBlock) Texts
	Plain.ArgumentTypes(SyntaxNode("Call", "Greet", ValueCodegen.One), "Greeter", CodeBlock.Empty) is ("Unknown")
	let isOverloaded = values.target.IsOverloaded(node.text, owner)
	for Range(values.ArgumentStart(node), node.children.Length)
		isOverloaded then values.TypeOf(node.children(value), block) else "Unknown"
Assigned(node SyntaxNode, block CodeBlock) SyntaxNode
	Plain.Assigned(SyntaxNode("Declaration", "let a", ValueCodegen.One), CodeBlock.Empty).Kind is "Number"
	Colored.Assigned(ColorReassignment, CodeBlock.Empty.Declare("c", "Color")).text is "Color"
	let value = node.children.Last
	node.Kind is "Declaration" then value else Converted(value, values.TypeOf(node.children(0), block), block)
Converted(node SyntaxNode, type Text, block CodeBlock) SyntaxNode
	Colored.Converted(NewColorValue, "Color", CodeBlock.Empty).text is "Color"
	Colored.Converted(NewColor, "ColorValue", CodeBlock.Empty).text is "to"
	Colored.Converted(Pixels, "Colors", Pixelated).Kind is "Converted"
	Colored.Converted(ValueCodegen.Ones, "ColorValue", CodeBlock.Empty).text is "ColorValue"
	if values.inference.types.IsPlural(type)
		return Elements(node, type, block)
	if (node.Kind is "List") and values.inference.types.IsKnown(type) and type is not in TypeInference.Primitives
		return SyntaxNode("Call", type, node.children)
	let converter = values.inference.Converter(values.TypeOf(node, block), type)
	if converter is "to"
		return SyntaxNode("Binary", "to", (node, SyntaxNode("Identifier", type)))
	converter is "from" then SyntaxNode("Call", type, node) else node
Typed(node SyntaxNode) SyntaxNode
	Plain.Typed(SyntaxParser(Tokenizer("\"Number\" to Type").Tokens).Parse) to Text is "Type(\"Number\", \"Strict\")"
	Plain.Typed(HelperType) to Text is "Type(\"Helper\", \"Strict/Examples\")"
	Plain.Typed(ValueCodegen.ToText) is ValueCodegen.ToText
	let isNamed = (node.Kind is "Binary") and (node.text is "to") and (node.children(0).Kind is "Text")
	if (isNamed is false) or (node.children(1).text is not "Type")
		return node
	let full = values.target.FullName(node.children(0).Unquoted)
	let split = full.LastIndexOf("/")
	let name = SyntaxNode("Text", "\"" + full.Substring(split + 1, full.Length - split - 1) + "\"")
	SyntaxNode("Call", "Type", (name, SyntaxNode("Text", "\"" + full.Substring(0, split) + "\"")))
ConvertedElements(node SyntaxNode, type Text, block CodeBlock) List(SyntaxNode)
	Colored.ConvertedElements(SyntaxNode("List", "", NewColorValue), "Color", CodeBlock.Empty).Length is 1
	for node.children
		Converted(value, type, block)
Elements(node SyntaxNode, type Text, block CodeBlock) SyntaxNode
	Colored.Elements(SyntaxNode("List", "", NewColorValue), "Colors", CodeBlock.Empty).children(0).text is "Color"
	Colored.Elements(Pixels, "Colors", Pixelated).children(1).text is "Color"
	Colored.Elements(Pixels, "ColorValues", Pixelated).Kind is "Identifier"
	let types = values.inference.types
	if node.Kind is "List"
		return SyntaxNode("List", "", ConvertedElements(node, types.ElementType(type), block))
	let source = values.TypeOf(node, block)
	let scoped = block.Declare("value", types.ElementType(source))
	constant element = SyntaxNode("Identifier", "value")
	let converted = types.IsPlural(source) then Converted(element, types.ElementType(type), scoped) else element
	converted.text is "value" then node else SyntaxNode("Converted", type, (node, converted))
Operand(node SyntaxNode, block CodeBlock) SyntaxNode
	Colored.Operand(SyntaxNode("Binary", "+", (Pixels, NewColor)), Pixelated).text is "to"
	Plain.Operand(SyntaxNode("Binary", "+", (ValueCodegen.One, ValueCodegen.One)), CodeBlock.Empty).text is "1"
	let types = values.inference.types
	let listType = values.TypeOf(node.children(0), block)
	let operand = node.children(1)
	if types.IsPlural(listType) is false
		return node.text is "+" then Textual(node, block) else operand
	let isList = (operand.Kind is "List") or types.IsPlural(values.TypeOf(operand, block))
	Converted(operand, (isList then listType else types.ElementType(listType)), block)
Textual(node SyntaxNode, block CodeBlock) SyntaxNode
	Kinded.Textual(SyntaxNode("Binary", "+", (ValueCodegen.Hi, SyntaxNode("Call", "Kind"))), CodeBlock.Empty).text is "to"
	Kinded.Textual(SyntaxNode("Binary", "+", (ValueCodegen.Hi, ValueCodegen.One)), CodeBlock.Empty).text is "1"
	let operand = node.children(1)
	let type = values.TypeOf(operand, block)
	let types = values.inference.types
	if (types.MethodsOf(type).Has("to", "Text") is false) or TypeEntry.IsBaseName(type)
		return operand
	let left = values.TypeOf(node.children(0), block)
	let converted = SyntaxNode("Binary", "to", (operand, SyntaxNode("Identifier", "Text")))
	"Text" is in (left, types.ValueOf(left)) then converted else operand
Looped(node SyntaxNode, block CodeBlock) CodeBlock
	Colored.Looped(Colored.Elements(Pixels, "Colors", Pixelated), Pixelated).instructions(4).kind is InstructionType.Invoke
	let name = "converted" + block.nextId
	let type = values.target.FullName(node.text)
	let empty = InstructionEntry(InstructionType.LoadConstantToRegister, type, (0, 6, -1, 0))
	let started = block.Add(MethodCodegen.StoreConstant(empty, name)).WithNextId
	let begun = LoopCodegen(MethodCodegen(values)).Declared(SyntaxNode("For", "", node.children), started)
	let element = values.Expression(node.children(1), begun)
	let written = element.Add(InstructionEntry.Named(InstructionType.InvokeWriteToList, element.Result, name))
	let end = InstructionEntry.Jump(InstructionType.LoopEnd, written.instructions.Length - started.instructions.Length)
	let ended = CodeBlock(written.instructions + end, block.register, written.nextId, block.scope)
	ended.Load(InstructionEntry.Named(InstructionType.LoadVariableToRegister, block.register, name))