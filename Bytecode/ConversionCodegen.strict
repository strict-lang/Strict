has values ValueCodegen
constant Plain = ConversionCodegen(ValueCodegen.Plain)
constant ColorTypes = TypeInference.Colors.types
constant Colored = ConversionCodegen(ValueCodegen(TypeInference(ColorTypes, CallTarget.NoScopes), KnownTypes.NoMembers, CallTarget.Plain))
constant NewColorValue = SyntaxNode("Call", "ColorValue", ValueCodegen.One)
constant NewColor = SyntaxNode("Call", "Color", ValueCodegen.One)
constant Pixels = SyntaxNode("Identifier", "pixels")
constant Repainted = SyntaxNode("Call", "Greeter", (Pixels, SyntaxNode("Reassignment", "", (SyntaxNode("Identifier", "c"), NewColorValue))))
constant KindTypes = KnownTypes(List(Text) + "Kind", List(Scope) + KnownTypes.NoMembers, List(Scope) + Scope(List(Text) + "to", List(Text) + "Text"), List(Scope) + KnownTypes.NoMembers)
constant Kinded = ConversionCodegen(ValueCodegen(TypeInference(KindTypes, CallTarget.NoScopes), KnownTypes.NoMembers, CallTarget.Plain))
constant StepTypes = KnownTypes(List(Text) + "Step", List(Scope) + Scope(List(Text) + "step", List(Text) + "Number"), List(Scope) + KnownTypes.NoMembers, List(Scope) + KnownTypes.NoMembers)
constant Stepped = ConversionCodegen(ValueCodegen(TypeInference(StepTypes, CallTarget.NoScopes), KnownTypes.NoMembers, CallTarget.Plain))
constant DictionaryMembers = List(Scope) + Scope(List(Text) + "keysAndValues", List(Text) + "List(key Generic, mappedValue Generic)")
constant DictionaryTypes = KnownTypes(List(Text) + "Dictionary", DictionaryMembers, List(Scope) + KnownTypes.NoMembers, List(Scope) + KnownTypes.NoMembers)
constant Mapped = ConversionCodegen(ValueCodegen(TypeInference(DictionaryTypes, CallTarget.NoScopes), KnownTypes.NoMembers, CallTarget.Plain))
constant Typing = SyntaxParser(Tokenizer("5 to Type").Tokens).Parse
constant HelperType = SyntaxParser(Tokenizer("\"Helper\" to Type").Tokens).Parse
constant Nesting = SyntaxNode("Binary", "+", (SyntaxNode("Identifier", "x"), SyntaxNode("List", "", (ValueCodegen.One, ValueCodegen.One))))
constant Pixelated = CodeBlock.Empty.Declare("pixels", "ColorValues")
constant Letter = SyntaxNode("Index", "", (Pixels, ValueCodegen.One))
constant Lettered = CodeBlock.Empty.Declare("pixels", "Text").Declare(CodeBlock.ReturnMarker, "Text")
constant Ranged = SyntaxNode("Call", "Range", (ValueCodegen.One, ValueCodegen.One))
constant Ranging = Plain.Elements(Ranged, "Numbers", CodeBlock.Empty)
ArgumentTypes(node SyntaxNode, owner Text, block CodeBlock) Texts
	Plain.ArgumentTypes(SyntaxNode("Call", "Greet", ValueCodegen.One), "Greeter", CodeBlock.Empty) is ("Unknown")
	Plain.Typed(SyntaxNode("Binary", "+", Typing.children), CodeBlock.Empty).text is "+"
	Plain.Typed(SyntaxNode("Call", "to", Typing.children), CodeBlock.Empty).Kind is "Call"
	Plain.Typed(ValueCodegen.ToText, CodeBlock.Empty.Declare("x", "Number")) is ValueCodegen.ToText
	Plain.Replaced(SyntaxNode("Call", "Greeter", (Pixels, Pixels))) to Text is "Greeter(pixels, pixels)"
	Plain.Replaced(SyntaxNode("Call", "Unknown", Repainted.children)).Kind is "Call"
	Colored.Looped(Colored.Elements(Pixels, "Colors", Pixelated), Pixelated).instructions.Length is 9
	Colored.Looped(Colored.Elements(Pixels, "Colors", Pixelated), Pixelated).instructions(0).texts(1) is "converted0"
	Kinded.Textual(SyntaxNode("", "", (ValueCodegen.Hi, SyntaxNode("Call", "Kind"))), Pixelated).Kind is "Binary"
	isOverloaded = values.target.IsOverloaded(node.text, owner)
	for Range(values.ArgumentStart(node), node.children.Length)
		isOverloaded then values.TypeOf(node.children(value), block) else "Unknown"
Assigned(node SyntaxNode, block CodeBlock) SyntaxNode
	Plain.Assigned(SyntaxNode("Declaration", "let a", ValueCodegen.One), CodeBlock.Empty).Kind is "Number"
	Colored.Assigned(Repainted.children(1), CodeBlock.Empty.Declare("c", "Color")).text is "Color"
	Kinded.Textual(SyntaxNode("Binary", "+", (ValueCodegen.One, SyntaxNode("Call", "Kind"))), Pixelated).text is "Kind"
	Kinded.Operand(SyntaxNode("Binary", "-", (ValueCodegen.Hi, SyntaxNode("Call", "Kind"))), Pixelated).text is "Kind"
	Plain.Operand(Nesting, CodeBlock.Empty.Declare("x", "List(Numbers)")).Kind is "List"
	Colored.Elements(SyntaxNode("List", "", NewColorValue), "Colors", CodeBlock.Empty).Kind is "List"
	Kinded.Operand(SyntaxNode("Binary", "+", (ValueCodegen.Hi, SyntaxNode("Call", "Kind"))), Pixelated).text is "to"
	Colored.Operand(SyntaxNode("Binary", "-", (NewColor, NewColorValue)), CodeBlock.Empty) is NewColorValue
	Colored.Operand(SyntaxNode("Binary", "-", (Pixels, Pixels)), Pixelated) is Pixels
	Plain.Operand(SyntaxNode("", "-", Nesting.children), CodeBlock.Empty.Declare("x", "Numberss")) to Text is "(1, 1)"
	right = node.children.Last
	node.Kind is "Declaration" then right else Converted(right, values.TypeOf(node.children(0), block), block)
Converted(node SyntaxNode, type Text, block CodeBlock) SyntaxNode
	Colored.Converted(NewColorValue, "Color", CodeBlock.Empty).text is "Color"
	Colored.Converted(NewColor, "ColorValue", CodeBlock.Empty).text is "to"
	Colored.Converted(Pixels, "Colors", Pixelated).Kind is "Converted"
	Colored.Converted(ValueCodegen.Ones, "ColorValue", CodeBlock.Empty).text is "ColorValue"
	Kinded.Converted(SyntaxNode("Call", "Kind"), "Text", CodeBlock.Empty).text is "to"
	if values.inference.types.IsPlural(type)
		return Elements(Held(node, type, block), type, block)
	isConstructed = values.inference.types.IsKnown(type) and type is not in TypeInference.Primitives
	if node.Kind is "List" and isConstructed and type is not "List"
		return SyntaxNode("Call", type, node.children)
	converter = values.inference.Converter(values.TypeOf(node, block), type)
	type is "Text" and converter is "" then Bracketed(node, block) else Changed(node, converter, type, block)
Held(node SyntaxNode, type Text, block CodeBlock) SyntaxNode
	Colored.Held(NewColor, "Byte", CodeBlock.Empty).text is "Red"
	Colored.Held(NewColor, "ColorValue", CodeBlock.Empty) is NewColor
	Colored.Held(NewColor, "Number", CodeBlock.Empty) is NewColor
	types = values.inference.types
	source = values.TypeOf(node, block)
	index = types.MembersOf(source).types.Index(type)
	isConverted = values.inference.Converter(source, type) is not ""
	if index < 0 or isConverted or type is in ("Text", "Generic", "Generics", "Any") or types.IsPlural(source)
		return node
	traitMethods = types.MethodsOf(type).names
	isImplemented = traitMethods.Length > 0 and (traitMethods - types.MethodsOf(source).names).Length is 0
	isImplemented then node else SyntaxNode("Member", types.MembersOf(source).names(index), List(SyntaxNode) + node)
Bracketed(node SyntaxNode, block CodeBlock) SyntaxNode
	Stepped.Bracketed(SyntaxNode("Call", "Step"), CodeBlock.Empty).text is "+"
	Plain.Bracketed(ValueCodegen.One, CodeBlock.Empty) is ValueCodegen.One
	Mapped.Bracketed(SyntaxNode("Call", "Dictionary", ValueCodegen.Ones), CodeBlock.Empty).Kind is "Call"
	type = values.TypeOf(node, block)
	members = values.inference.types.MembersOf(type)
	if members.names.Length is not 1 or type.StartsWith("Dictionary(")
		return node
	if members.names(0).Lower is members.types(0).Lower
		return node
	member = SyntaxNode("Member", members.names(0), List(SyntaxNode) + node)
	closed = SyntaxNode("Binary", "+", (member, SyntaxNode("Text", "\")\"")))
	SyntaxNode("Binary", "+", (SyntaxNode("Text", "\"(\""), closed))
Changed(node SyntaxNode, converter Text, type Text, block CodeBlock) SyntaxNode
	Plain.Changed(ValueCodegen.One, "to", "Text", CodeBlock.Empty).text is "to"
	Plain.Changed(ValueCodegen.One, "", "Text", CodeBlock.Empty) is ValueCodegen.One
	Stepped.Changed(SyntaxNode("Call", "Step"), "", "Number", CodeBlock.Empty).Kind is "Call"
	Plain.Changed(ValueCodegen.One, "to", "Text", CodeBlock.Empty).children(1).Kind is "Identifier"
	if converter is "to"
		return SyntaxNode("Binary", "to", (node, SyntaxNode("Identifier", type)))
	if converter is "from"
		return SyntaxNode("Call", type, node)
	values.inference.types.ValueOf(values.TypeOf(node, block)) is type then node else Held(node, type, block)
Typed(node SyntaxNode, block CodeBlock) SyntaxNode
	Plain.Typed(HelperType, CodeBlock.Empty) to Text is "Type(\"Helper\", \"Strict/Examples\")"
	Plain.Typed(ValueCodegen.ToText, CodeBlock.Empty) is ValueCodegen.ToText
	Plain.Typed(Typing, CodeBlock.Empty) to Text is "Type(\"Number\", \"Strict\")"
	Plain.Typed(SyntaxNode("Call", "to", Typing.children), CodeBlock.Empty).text is "to"
	if (node.Kind is "Binary" and node.text is "to" and node.children(1).text is "Type") is false
		return node
	source = node.children(0)
	if source.Kind is "Text"
		return TypeValue(values.target.FullName(source.Unquoted))
	known = values.TypeOf(source, block)
	known is "Text" then node else TypeValue(values.target.FullName(known))
TypeValue(full Text) SyntaxNode
	Plain.TypeValue("Strict/Number") to Text is "Type(\"Number\", \"Strict\")"
	Plain.TypeValue("Strict/Number").children(0).Kind is "Text" and Plain.TypeValue("A/B").children(1).Kind is "Text"
	Stepped.Bracketed(SyntaxNode("Call", "Step"), CodeBlock.Empty) to Text is "\"(\" + (Step().step + \")\")"
	Plain.Changed(ValueCodegen.One, "to", "Text", CodeBlock.Empty) to Text is "1 to Text"
	Colored.Held(NewColor, "Byte", CodeBlock.Empty) to Text is "Color(1).Red"
	Stepped.Converted(SyntaxNode("Call", "Step"), "Text", CodeBlock.Empty).text is "+"
	Stepped.Converted(SyntaxNode("Call", "Step"), "Number", CodeBlock.Empty).text is "Step"
	Colored.Converted(ValueCodegen.Ones, "Color", CodeBlock.Empty) to Text is "Color(1, 1)"
	Plain.Typed(SyntaxNode("Binary", "to", (ValueCodegen.ToText, Typing.children(1))), CodeBlock.Empty).text is "to"
	split = full.LastIndexOf("/")
	name = SyntaxNode("Text", "\"" + full.Substring(split + 1, full.Length - split - 1) + "\"")
	SyntaxNode("Call", "Type", (name, SyntaxNode("Text", "\"" + full.Substring(0, split) + "\"")))
ConvertedElements(node SyntaxNode, type Text, block CodeBlock) List(SyntaxNode)
	Colored.ConvertedElements(SyntaxNode("List", "", NewColorValue), "Color", CodeBlock.Empty).Length is 1
	Plain.Operand(SyntaxNode("", "-", Nesting.children), CodeBlock.Empty.Declare("x", "Numbers")) to Text is "(1, 1)"
	Colored.Converted(ValueCodegen.Ones, "Color", CodeBlock.Empty).Kind is "Call"
	Stepped.Bracketed(SyntaxNode("Call", "Step"), CodeBlock.Empty).children(0).Kind is "Text"
	Stepped.Bracketed(SyntaxNode("Call", "Step"), CodeBlock.Empty).children(1).children(1).Kind is "Text"
	Colored.Converted(ValueCodegen.Ones, "List", CodeBlock.Empty) is ValueCodegen.Ones
	for node.children
		Converted(value, type, block)
Elements(node SyntaxNode, type Text, block CodeBlock) SyntaxNode
	Colored.Elements(SyntaxNode("List", "", NewColorValue), "Colors", CodeBlock.Empty).children(0).text is "Color"
	Colored.Elements(Pixels, "Colors", Pixelated).children(1).text is "Color" and Ranging.Kind is "Converted"
	Colored.Elements(Pixels, "ColorValues", Pixelated).Kind is "Identifier"
	Colored.Held(Pixels, "Color", Pixelated) is Pixels
	types = values.inference.types
	if node.Kind is "List"
		return SyntaxNode("List", "", ConvertedElements(node, types.ElementType(type), block))
	source = values.TypeOf(node, block)
	scoped = block.Declare("value", types.ElementType(source))
	constant element = SyntaxNode("Identifier", "value")
	converted = types.IsPlural(source) then Converted(element, types.ElementType(type), scoped) else element
	converted.text is "value" and source is not "Range" then node else SyntaxNode("Converted", type, (node, converted))
Wanted(node SyntaxNode, type Text, block CodeBlock) SyntaxNode
	Plain.Wanted(Letter, "Text", Lettered).children(1).text is "Text"
	Plain.Wanted(Letter, "", Lettered) is Letter
	Plain.Wanted(ValueCodegen.One, "Text", Lettered) is ValueCodegen.One
	Plain.Wanted(SyntaxNode("Return", "", Letter), "Text", Lettered).Kind is "Return"
	if type is not "Text" or BranchValues.Returning.IsValue(node) is false
		return node
	values.TypeOf(node, block) is "Character" then Changed(node, "to", "Text", block) else node
Returned(node SyntaxNode, block CodeBlock) SyntaxNode
	Plain.Returned(SyntaxNode("Return", "", Letter), Lettered).children(0).text is "to"
	Plain.Returned(SyntaxNode("Return", "", Letter), Pixelated) is SyntaxNode("Return", "", Letter)
	Plain.Returned(SyntaxNode("Return", ""), Lettered) is SyntaxNode("Return", "")
	Plain.Returned(Letter, Lettered) is Letter
	if node.Kind is not "Return" or node.HasValue is false
		return node
	wanted = Wanted(node.children(0), block.scope.TypeOf(CodeBlock.ReturnMarker), block)
	SyntaxNode("Return", node.text, wanted, node.line)
Operand(node SyntaxNode, block CodeBlock) SyntaxNode
	Colored.Operand(SyntaxNode("Binary", "+", (Pixels, NewColor)), Pixelated).text is "to"
	Plain.Operand(SyntaxNode("Binary", "+", (ValueCodegen.One, ValueCodegen.One)), CodeBlock.Empty).text is "1"
	Plain.Operand(Nesting, CodeBlock.Empty.Declare("x", "List(Numbers)")).children.Length is 1
	types = values.inference.types
	listType = values.TypeOf(node.children(0), block)
	operand = node.children(1)
	if node.text is "+" and IsElement(listType, operand, block)
		return SyntaxNode("List", "", List(SyntaxNode) + operand)
	if types.IsPlural(listType) is false
		return node.text is "+" then Textual(node, block) else operand
	isList = operand.Kind is "List" or types.IsPlural(values.TypeOf(operand, block))
	Converted(operand, isList then listType else types.ElementType(listType), block)
IsElement(collection Text, operand SyntaxNode, block CodeBlock) Boolean
	Plain.IsElement("List(Numbers)", Nesting.children.Last, CodeBlock.Empty)
	Plain.IsElement("Numberss", Nesting.children.Last, CodeBlock.Empty)
	Plain.IsElement("Numbers", Nesting.children.Last, CodeBlock.Empty) is false
	Plain.IsElement("List(List(Number))", Pixels, CodeBlock.Empty.Declare("pixels", "List(Number)"))
	Plain.IsElement("List(Numbers)", ValueCodegen.One, CodeBlock.Empty) is false
	Plain.IsElement("List(Numbers)", Pixels, CodeBlock.Empty.Declare("pixels", "List(Number)"))
	types = values.inference.types
	isSpelled = collection.StartsWith("List(") and collection.IndexOf(",") < 0
	element = isSpelled then collection.Substring(5, collection.Length - 6) else types.ElementType(collection)
	isListElement = ListFits(types).IsList(element) or types.IsPlural(types.ValueOf(element))
	type = values.TypeOf(operand, block)
	isListElement and (type is element or ListFits(types).IsList(type) and ListFits(types).IsWidened(type, element))
Textual(node SyntaxNode, block CodeBlock) SyntaxNode
	Kinded.Textual(SyntaxNode("Binary", "+", (ValueCodegen.Hi, SyntaxNode("Call", "Kind"))), CodeBlock.Empty).text is "to"
	Kinded.Textual(SyntaxNode("Binary", "+", (ValueCodegen.Hi, ValueCodegen.One)), CodeBlock.Empty).text is "1"
	Stepped.Textual(SyntaxNode("Binary", "+", (ValueCodegen.Hi, SyntaxNode("Call", "Step"))), Pixelated).text is "+"
	Stepped.Textual(SyntaxNode("Binary", "+", (ValueCodegen.One, SyntaxNode("Call", "Step"))), Pixelated).text is "Step"
	operand = node.children(1)
	type = values.TypeOf(operand, block)
	types = values.inference.types
	left = values.TypeOf(node.children(0), block)
	isText = "Text" is in (left, types.ValueOf(left))
	if types.MethodsOf(type).Has("to", "Text") is false or TypeEntry.IsBaseName(type)
		return isText then Bracketed(operand, block) else operand
	isText then SyntaxNode("Binary", "to", (operand, SyntaxNode("Identifier", "Text"))) else operand
Looped(node SyntaxNode, block CodeBlock) CodeBlock
	Colored.Looped(Colored.Elements(Pixels, "Colors", Pixelated), Pixelated).instructions(4).kind is InstructionType.Invoke
	Colored.Looped(Colored.Elements(Pixels, "Colors", Pixelated), Pixelated).instructions(7).payload is (6)
	name = "converted" + block.nextId
	empty = InstructionEntry(InstructionType.LoadConstantToRegister, values.target.FullName(node.text), (0, 6, -1, 0))
	started = block.Add(MethodCodegen.StoreConstant(empty, name)).WithNextId
	begun = LoopCodegen(MethodCodegen(values)).Declared(SyntaxNode("For", "", node.children), started)
	element = values.Expression(node.children(1), begun)
	written = element.Add(InstructionEntry.Named(InstructionType.InvokeWriteToList, element.Result, name))
	end = InstructionEntry.Jump(InstructionType.LoopEnd, written.instructions.Length - started.instructions.Length)
	ended = CodeBlock(written.instructions + end, block.register, written.nextId, block.scope)
	ended.Load(InstructionEntry.Named(InstructionType.LoadVariableToRegister, block.register, name))
Replaced(call SyntaxNode) SyntaxNode
	Plain.Replaced(Repainted) to Text is "Greeter(pixels.text)"
	Plain.Replaced(NewColor) is NewColor
	names = values.target.FromNames(call.text, List(Text) + call.text)
	if call.children.Length < 2 or call.children(1).Kind is not "Reassignment" or names.Length is 0
		return call
	mutable arguments = List(Mutable(SyntaxNode))
	for names
		arguments.Add(Replacement(call, value))
	SyntaxNode("Call", call.text, arguments, call.line)
Replacement(call SyntaxNode, name Text) SyntaxNode
	Plain.Replacement(Repainted, "c") is NewColorValue
	Plain.Replacement(Repainted, "size") to Text is "pixels.size"
	for call.children
		if value.Kind is "Reassignment" and value.children(0).text is name
			return value.children(1)
	SyntaxNode("Member", name, call.children(0))