has bytes Numbers
constant Polynomial = 3.988292384e9
constant AllBits = 4.294967295e9
Value Number
	Crc(49, 50, 51, 52, 53, 54, 55, 56, 57).Value is 3.421780262e9
	Crc(104, 105).Value is 3.633523372e9
	let table = Table
	mutable crc = AllBits
	for bytes
		crc = table((crc xor value) and 255) xor (crc / 256).Floor
	crc xor AllBits
Table Numbers
	Crc(1).Table.Last is 7.55167117e8
	for 256
		Entry(index)
Entry(index Number) Number
	Crc(1).Entry(1) is 1.996959894e9
	Crc(1).Entry(255) is 7.55167117e8
	mutable entry = index
	for 8
		entry = entry % 2 is 1 then (Polynomial xor (entry / 2).Floor) else (entry / 2).Floor
	entry