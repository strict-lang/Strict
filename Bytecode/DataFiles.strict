has ignored Texts = List(Text)
Canonical(path Text) Text
	DataFiles.Canonical("Tools/../x").Length > 0
	normalized = FileCompiler.Normalize(path)
	Process.OperatingSystem is "Windows" then normalized.Lower else normalized
IsExcluded(path Text) Boolean
	DataFiles(("./Tools/", "./generated/")).IsExcluded("Tools")
	DataFiles("./Tools/").IsExcluded("Toolset") is false
	DataFiles.IsExcluded("folder/.git/objects")
	normalized = Canonical(path) + "/"
	if normalized.IndexOf("/.git/") >= 0
		return true
	for ignored
		if value.EndsWith("/") and normalized.StartsWith(Canonical(value))
			return true
	false
