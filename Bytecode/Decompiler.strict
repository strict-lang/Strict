has instruction BytecodeInstruction
Reconstruct Text
	Decompiler(BytecodeInstruction.SetNumber(0, 5)).Reconstruct is "R0 = 5"
	Decompiler(BytecodeInstruction.LoadVariable(1, "x")).Reconstruct is "R1 = x"
	if instruction.typeName is in ("Set", "LoadConstantToRegister")
		return Register.NameOf(instruction.register) + " = " + instruction.amount to Text
	if instruction.typeName is "LoadVariableToRegister"
		return Register.NameOf(instruction.register) + " = " + instruction.label
	if instruction.typeName is "StoreConstantToVariable"
		return "constant " + instruction.label + " = " + instruction.amount to Text
	if instruction.typeName is "StoreRegisterToVariable"
		return "constant " + instruction.label + " = " + Register.NameOf(instruction.register)
	ReconstructControl
ReconstructControl Text
	Decompiler(BytecodeInstruction.ReturnOp(2)).ReconstructControl is "return R2"
	if instruction.typeName is "Return"
		return "return " + Register.NameOf(instruction.register)
	if instruction.typeName is "Print"
		return "logger.Log(" + instruction.label + ")"
	if instruction.typeName is "JumpIfFalse"
		return "jumpIfFalse " + instruction.amount to Text
	if instruction.typeName is "JumpIfTrue"
		return "jumpIfTrue " + instruction.amount to Text
	if instruction.typeName is "Invoke"
		return "call " + instruction.label
	ReconstructBinary
ReconstructBinary Text
	Decompiler(BytecodeInstruction.BinaryOp(InstructionType.Add, 0, 1, 2)).ReconstructBinary is "R2 = R0 + R1"
	if instruction.typeName is "Add"
		return BinaryLine("+")
	if instruction.typeName is "Subtract"
		return BinaryLine("-")
	if instruction.typeName is "Multiply"
		return BinaryLine("*")
	if instruction.typeName is "Divide"
		return BinaryLine("/")
	if instruction.typeName is "Modulo"
		return BinaryLine("%")
	ReconstructCompare
ReconstructCompare Text
	Decompiler("Equal", 0, 1, "2").ReconstructCompare is "R2 = R0 is R1"
	if instruction.typeName is "Equal"
		return BinaryLine("is")
	if instruction.typeName is "NotEqual"
		return BinaryLine("is not")
	if instruction.typeName is "GreaterThan"
		return BinaryLine(">")
	if instruction.typeName is "LessThan"
		return BinaryLine("<")
	instruction to Text
BinaryLine(operatorName Text) Text
	Decompiler(BytecodeInstruction.BinaryOp(InstructionType.Add, 0, 1, 2)).BinaryLine("+") is "R2 = R0 + R1"
	let left = Register.NameOf(instruction.register)
	let right = Register.NameOf(instruction.amount)
	Register.NameOf(instruction.ResultRegister) + " = " + left + " " + operatorName + " " + right
ReconstructMethod(method BinaryMethod) Texts
	mutable lines = List(Mutable(Text))
	for method.instructions
		lines.Add("\t" + Decompiler(value).Reconstruct)
	lines
to Text
	"decompiler"