has values ValueCodegen
constant BagParameters = (Scope(("items default", "Count reads"), ("(\"a\")", "reads")), KnownTypes.NoMembers)
constant Bags = KnownTypes(("Bag", "Plain"), (Scope(List(Text) + "items", List(Text) + "Texts"), KnownTypes.NoMembers), (Scope(List(Text) + "Count", List(Text) + "Number"), KnownTypes.NoMembers), BagParameters)
constant Bagged = DefaultInstance(ValueCodegen(TypeInference(Bags, (KnownTypes.NoMembers, KnownTypes.NoMembers)), KnownTypes.NoMembers, CallTarget.Plain))
constant Counting = SyntaxNode("Member", "Count", SyntaxNode("Identifier", "Bag"))
constant Plainly = SyntaxNode("Member", "Count", SyntaxNode("Identifier", "Plain"))
constant Owned = DefaultInstance(ValueCodegen(Bagged.values, target = CallTarget(Bags, CallTarget.Greeter, "Strict/Bag", List(Text))))
constant Flats = (Scope(("items default", "Count reads"), ("Plain.Flat", "reads")), KnownTypes.NoMembers)
constant Computing = TypeInference(KnownTypes(Bags, parameters = Flats), Bagged.values.inference.constants)
constant Computed = DefaultInstance(ValueCodegen(Owned.values, inference = Computing))
Called(node SyntaxNode, block CodeBlock) CodeBlock
	Bagged.Called(Counting, CodeBlock.Empty).instructions.First.texts(1) is "from"
	Owned.Called(Counting, CodeBlock.Empty).instructions.First.texts(1) is "Count"
	let instanced = Instanced(node, block)
	let arranged = NamedArguments(values).Arranged(node, block)
	instanced is node then values.Replacing(arranged, block) else values.InstanceCall(instanced, block)
Instanced(node SyntaxNode, block CodeBlock) SyntaxNode
	Bagged.Instanced(Counting, CodeBlock.Empty).children(0).Kind is "Call"
	Bagged.Instanced(Plainly, CodeBlock.Empty).children(0).Kind is "Identifier"
	Bagged.Instanced(Counting, CodeBlock.Empty.Declare("Bag", "Number")) is Counting
	Computed.Instanced(Counting, CodeBlock.Empty).children(0).Kind is "Call"
	if (node.Kind is not in ("Member", "MethodCall")) or (node.children.Length is 0)
		return node
	let type = node.children(0).text
	if IsSelf(type) or (values.IsTypeName(node.children(0), block) is false) or (IsReading(type, node.text) is false)
		return node
	mutable children = node.children
	children(0) = SyntaxNode("Call", type, List(SyntaxNode), node.line)
	SyntaxNode(node.Kind, node.text, children, node.line)
IsSelf(type Text) Boolean
	Bagged.IsSelf("Bag") is false
	Owned.IsSelf("Bag")
	Computed.IsSelf("Bag") is false
	if type is not TypeEntry.ShortName(values.target.TypeName)
		return false
	for values.inference.types.MembersOf(type).names
		if NamedArguments(values).IsComputed(type, value)
			return false
	true
IsReading(type Text, method Text) Boolean
	Bagged.IsReading("Bag", "Count")
	Bagged.IsReading("Plain", "Count") is false
	values.inference.types.ParameterScope(type).TypeOf(method + " reads") is not ""
