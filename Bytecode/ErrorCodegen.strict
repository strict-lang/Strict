has values ValueCodegen
constant FailureMarker = " failure"
constant Tested = "tested"
constant ErrorTypes = ("Error", "ErrorWithValue")
constant Plain = ErrorCodegen(ValueCodegen.Plain)
constant Greeting = SyntaxNode("Call", "Greet")
constant Ignoring = SyntaxNode("Ignore", "ignore", Greeting)
constant BareError = SyntaxNode("Identifier", "Error")
constant Failing = SyntaxNode("Call", "Error", SyntaxNode("Text", "\"Failed\""))
constant GreetingPlusOne = SyntaxNode("Binary", "+", (Greeting, ValueCodegen.One))
constant InTest = CodeBlock.Empty.Declare(FailureMarker, "7")
constant Counted = CodeBlock.Empty.Declare("a", "Count")
constant A = SyntaxNode("Identifier", "a")
constant Logging = CodeBlock.Empty.Declare("a", "Logger")
constant LogHi = SyntaxNode("MethodCall", "Log", (A, ValueCodegen.Hi))
constant IsError = SyntaxNode("Binary", "is", (A, BareError))
constant AnyCall = SyntaxNode("Call", "Error", SyntaxNode("Text", "\"\""))
constant FailingSum = SyntaxNode("Binary", "is", (GreetingPlusOne, BareError))
constant LeftSum = Plain.Compare(FailingSum, GreetingPlusOne, CodeBlock.Empty)
constant RightSum = Plain.Compare(IsError, GreetingPlusOne, CodeBlock.Empty)
constant IsOne = SyntaxNode("Binary", "is", (A, ValueCodegen.One))
constant TextA = CodeBlock.Empty.Declare("a", "Text")
constant FallibleA = ErrorScope.Plain.Fallible("a", CodeBlock.Empty.Declare("a", "Number"))
constant NewSize = SyntaxNode("Call", "Size", ValueCodegen.One)
constant SizeParameters = List(Scope) + Scope(List(Text) + TypeShape.Constrained, List(Text) + "2")
constant SizeTypes = KnownTypes(List(Text) + "Size", List(Scope) + Scope(List(Text) + "Width", List(Text) + "Number"), List(Scope) + KnownTypes.NoMembers, SizeParameters)
constant Sizing = ErrorCodegen(ValueCodegen(TypeInference(SizeTypes, CallTarget.NoScopes), KnownTypes.NoMembers, CallTarget.Plain))
Fold(node SyntaxNode, block CodeBlock) SyntaxNode
	Plain.Fold(ValueCodegen.One, CodeBlock.Empty).text is "1"
	Plain.Fold(SyntaxParser(Tokenizer("outer.B.Greet").Tokens).Parse, CodeBlock.Empty).children(0).Kind is "Type"
	folding = ConstantFolding(values.target.TypeName, values.inference, values.isOptimizing)
	typed = block.scope.TypeOf("outer") is "" then folding.Outer(node) else node
	ConversionCodegen(values).Retype(folding.Fold(typed), block)
Handle(node SyntaxNode, block CodeBlock) CodeBlock
	Plain.Handle(Greeting, CodeBlock.Empty).instructions.Last.kind is InstructionType.Invoke
	Plain.CanFail(SyntaxNode("Call", "Error", ValueCodegen.Hi), CodeBlock.Empty) is false
	Plain.CanFail(ValueCodegen.ToText, CodeBlock.Empty)
	Plain.CanFail(SyntaxNode("Call", "List", Greeting), CodeBlock.Empty) is false
	Plain.CanFail(SyntaxNode("Call", "Dictionary", Greeting), CodeBlock.Empty) is false
	Plain.CanFail(SyntaxNode("Call", "Mutable", Greeting), CodeBlock.Empty)
	Plain.CanFail(SyntaxNode("Call", "Mutable", ValueCodegen.One), CodeBlock.Empty) is false
	Plain.CanFail(SyntaxNode("MethodCall", "Add", (A, ValueCodegen.One)), ErrorScope.Numbered)
	Plain.CanFail(SyntaxNode("Index", "", (A, ValueCodegen.One)), ErrorScope.Numbered)
	Plain.CanFail(ValueCodegen.GreeterText, CodeBlock.Empty) is false
	Dispatch(Fold(node, block), block)
Dispatch(node SyntaxNode, block CodeBlock) CodeBlock
	Plain.Dispatch(ValueCodegen.One, CodeBlock.Empty).register is 1
	Plain.Dispatch(ValueCodegen.ToText, CodeBlock.Empty) is Plain.values.Call(ValueCodegen.ToText, CodeBlock.Empty)
	Plain.Dispatch(ValueCodegen.GreeterText, Counted) is Plain.values.Call(ValueCodegen.GreeterText, Counted)
	Plain.Dispatch(Greeting, CodeBlock.Empty) is Plain.values.Call(Greeting, CodeBlock.Empty)
	Plain.Dispatch(IsOne, CodeBlock.Empty) is OperatorCodegen(Plain.values).Operation(IsOne, CodeBlock.Empty)
	if IsLog(node, block)
		return MethodCodegen(values).Log(node.children(1), block)
	if node.Kind is in ("Number", "Text", "Boolean", "List", "Identifier")
		return values.Leaf(node, block)
	if node.Kind is in ("Call", "Member", "MethodCall", "Not", "Index") or node.text is "to"
		return values.Call(node, block)
	OperatorCodegen(values).Operation(node, block)
Guard(node SyntaxNode, block CodeBlock, isRemainder = false) CodeBlock
	Plain.Guard(Greeting, CodeBlock.Empty).instructions.Last.kind is InstructionType.CheckError
	Plain.Guard(ValueCodegen.One, CodeBlock.Empty).instructions.Length is 1
	Plain.Guard(ErrorScope.Remaining, ErrorScope.Scalar, true).instructions.Last.kind is InstructionType.CheckError
	Plain.Guard(ErrorScope.Remaining, ErrorScope.Scalar).instructions.Last.kind is not InstructionType.CheckError
	folded = Fold(node, block)
	generated = Dispatch(folded, block)
	isRemainder or CanFail(folded, block) then generated.Add(Check(generated.Result, block)) else generated
Check(register Number, block CodeBlock) InstructionEntry
	Plain.Check(2, CodeBlock.Empty).payload is List(Number) + 2
	Plain.Check(2, InTest).payload is (2, 7)
	Plain.Check(2, InTest).texts is List(Text) + Tested
	failure = block.scope.TypeOf(FailureMarker)
	if failure is ""
		return InstructionEntry(InstructionType.CheckError, List(Text), List(Number) + register)
	jump = ByteEncoder.Empty.SevenBit(failure to Number).bytes
	InstructionEntry(InstructionType.CheckError, List(Text) + Tested, List(Number) + register + jump)
IsLog(node SyntaxNode, block CodeBlock) Boolean
	Plain.IsLog(LogHi, Logging)
	Plain.IsLog(SyntaxNode("Identifier", "Log"), Logging) is false
	Plain.IsLog(SyntaxNode("MethodCall", "Reset", (A, A)), Logging) is false
	Plain.CanFail(LogHi, Logging) is false
	Plain.Dispatch(LogHi, Logging).instructions.Last.kind is InstructionType.Print
	Plain.Dispatch(LogHi, CodeBlock.Empty).instructions.Last.kind is InstructionType.Invoke
	if node.Kind is not "MethodCall" or node.text is not "Log"
		return false
	TypeEntry.ShortName(values.TypeOf(node.children(0), block)) is "Logger"
CanFail(node SyntaxNode, block CodeBlock) Boolean
	Plain.CanFail(Greeting, CodeBlock.Empty)
	Plain.CanFail(BareError, CodeBlock.Empty) is false
	Plain.CanFail(A, FallibleA)
	if IsLog(node, block) or values.TypeOf(node, block) is in ErrorTypes
		return false
	if node.Kind is "Identifier"
		return ErrorScope(values).IsFallible(node.text, block) or values.IsMethodCall(node, block)
	if node.Kind is "Binary"
		return IsFailing(node, block)
	if node.Kind is "Call" and node.text is in ("List", "Dictionary", "Mutable")
		return node.text is "Mutable" and CanFail(node.children(0), block)
	node.Kind is in ("Call", "MethodCall", "Index") or node.Kind is "Member" and values.IsMethodCall(node, block)
IsFailing(node SyntaxNode, block CodeBlock) Boolean
	Plain.IsFailing(SyntaxNode("Binary", "+", (ValueCodegen.One, ValueCodegen.One)), CodeBlock.Empty) is false
	Plain.IsFailing(ValueCodegen.ToText, CodeBlock.Empty)
	Plain.IsFailing(SyntaxNode("Binary", "else", (SyntaxNode("Binary", "then", (A, Greeting)), BareError)), Counted)
	Plain.IsFailing(SyntaxNode("Binary", "else", (SyntaxNode("Binary", "then", (A, BareError)), Greeting)), Counted)
	Plain.IsFailing(SyntaxNode("Binary", "-", (A, A)), ErrorScope.Numbered)
	if node.text is "else"
		return CanFail(node.children(0).children(1), block) or CanFail(node.children(1), block)
	if node.text is in ("to", "then") or IsOverloaded(node, block)
		return true
	isList = ListFits(values.inference.types).IsList(values.TypeOf(node, block))
	node.text is in ("+", "-", "*", "/", "%", "^") and isList
IsOverloaded(node SyntaxNode, block CodeBlock) Boolean
	ErrorCodegen(OperatorCodegen.Texts.values).IsOverloaded(SyntaxNode("Binary", "<", (A, A)), TextA)
	Plain.IsOverloaded(SyntaxNode("Binary", "xor", (ValueCodegen.One, ValueCodegen.One)), CodeBlock.Empty) is false
	operators = OperatorCodegen(values)
	operators.IsCustom(node, block) and operators.IsBits(node, block) is false
Narrow(condition SyntaxNode, block CodeBlock) CodeBlock
	Plain.Narrow(IsError, Counted).scope.TypeOf("a") is "Error"
	Plain.Narrow(IsOne, Counted).scope.TypeOf("a") is "Count"
	Plain.Narrow(SyntaxNode("Binary", "is not", IsError.children), Counted) is Counted
	Plain.Narrow(SyntaxNode("Binary", "is", (Greeting, BareError)), Counted) is Counted
	if IsErrorComparison(condition, block) is false
		return block
	target = condition.children(0)
	condition.text is "is" and target.Kind is "Identifier" then block.Declare(target.text, "Error") else block
AnyError(node SyntaxNode, block CodeBlock) SyntaxNode
	Plain.AnyError(IsError, CodeBlock.Empty) to Text is "a is Error(\"\")"
	Plain.AnyError(IsOne, CodeBlock.Empty) to Text is "a is 1"
	Plain.AnyError(SyntaxNode("Binary", "is not", IsError.children), CodeBlock.Empty) to Text is "a is not Error(\"\")"
	Plain.AnyError(SyntaxNode("Binary", "+", IsError.children), CodeBlock.Empty) to Text is "a + Error"
	Plain.AnyError(IsError, CodeBlock.Empty.Declare("Error", "Number")) to Text is "a is Error"
	Plain.AnyError(SyntaxNode("Binary", "is", (A, SyntaxNode("Text", "Error"))), CodeBlock.Empty) to Text is "a is Error"
	wanted = node.children.Last
	isBare = wanted.Kind is "Identifier" and wanted.text is "Error" and block.scope.TypeOf("Error") is ""
	if node.text is not in ("is", "is not") or isBare is false
		return node
	SyntaxNode(node.Kind, node.text, (node.children(0), AnyCall), node.line)
IsErrorComparison(node SyntaxNode, block CodeBlock) Boolean
	Plain.IsErrorComparison(IsError, CodeBlock.Empty)
	Plain.IsErrorComparison(IsOne, CodeBlock.Empty) is false
	Plain.IsErrorComparison(SyntaxNode("Binary", "is not", IsError.children), CodeBlock.Empty)
	Plain.IsErrorComparison(SyntaxNode("Call", "is", IsError.children), CodeBlock.Empty) is false
	Plain.IsErrorComparison(SyntaxNode("Binary", "+", IsError.children), CodeBlock.Empty) is false
	Plain.IsErrorComparison(SyntaxNode("Binary", "is", (BareError, A)), CodeBlock.Empty)
	if node.Kind is not "Binary" or node.text is not in ("is", "is not")
		return false
	values.TypeOf(node.children(0), block) is in ErrorTypes or values.TypeOf(node.children(1), block) is in ErrorTypes
Statement(node SyntaxNode, block CodeBlock) CodeBlock
	Plain.Statement(SyntaxNode("Return", "", Greeting), CodeBlock.Empty).instructions.Last.kind is InstructionType.Invoke
	Plain.Statement(Greeting, CodeBlock.Empty).instructions.Last.kind is InstructionType.CheckError
	Plain.Statement(Ignoring, CodeBlock.Empty).instructions.Last.kind is InstructionType.Invoke
	Plain.Statement(SyntaxNode("Return", ""), CodeBlock.Empty).instructions.Last.kind is InstructionType.Return
	Plain.AnyError(SyntaxNode("Binary", "is", (A, A)), CodeBlock.Empty) to Text is "a is a"
	Plain.Statement(SyntaxNode("Return", ""), CodeBlock.Empty.At(2)) is CodeBlock.Empty.At(2).Nothing
	Plain.Statement(Failing, CodeBlock.Empty).instructions.Last.kind is InstructionType.CheckError
	if node.Kind is in ("Return", "Ignore")
		return node.HasValue then Handle(node.children(0), block) else block.Nothing
	Guard(node, block, values.TypeOf(node, block) is in ErrorTypes)
Right(node SyntaxNode, block CodeBlock, isConverted Boolean) CodeBlock
	Plain.Right(IsError, CodeBlock.Empty, false).instructions is (InstructionEntry.LoadAnyError(0))
	Plain.Right(IsError, Counted, true) is Plain.Compare(IsError, AnyCall, Counted)
	Plain.Right(IsError, Counted, false) is Plain.Compare(IsError, AnyCall, Counted)
	Plain.IsFailing(SyntaxNode("Binary", "then", (A, A)), CodeBlock.Empty)
	Plain.IsFailing(SyntaxNode("Binary", "+", (A, A)), CodeBlock.Empty.Declare("a", "List(Number)"))
	Plain.IsFailing(SyntaxNode("Binary", "is", (A, A)), ErrorScope.Numbered) is false
	any = AnyError(node, block)
	convert = isConverted and IsErrorComparison(node, block) is false
	Compare(node, convert then ConversionCodegen(values).Operand(any, block) else any.children(1), block)
Keep(node SyntaxNode, name Text, block CodeBlock) CodeBlock
	Plain.Keep(Greeting, "kept", CodeBlock.Empty).instructions.Last.kind is InstructionType.StoreRegisterToVariable
	Plain.CanFail(A, CodeBlock.Empty.Declare("a", "Number")) is false
	Plain.CanFail(SyntaxNode("Member", "Greet", ValueCodegen.NewGreeter), CodeBlock.Empty)
	FallibleA.scope.TypeOf("a") is "Number"
	ErrorScope.Plain.IsFallible("a", FallibleA)
	Handle(node, block).Stored(name).At(block.register).WithNextId.Declare(name, values.TypeOf(node, block))
Compare(comparison SyntaxNode, operand SyntaxNode, block CodeBlock) CodeBlock
	Plain.Compare(IsError, Greeting, CodeBlock.Empty).instructions.Length is 1
	Plain.Compare(IsOne, Greeting, CodeBlock.Empty).instructions.Length is 2
	LeftSum.instructions(1).texts is List(Text) + Tested
	LeftSum.instructions.Last.texts is List(Text) + Tested
	LeftSum.scope.TypeOf(Tested) is not ""
	RightSum.instructions(1).texts.Length is 0 and Plain.Compare(IsError, A, CodeBlock.Empty).instructions.Length is 1
	if IsErrorComparison(comparison, block) is false
		return Guard(operand, block, ErrorScope(values).IsRemainder(Fold(operand, block)))
	if operand is not comparison.children(0) or operand.children.Length is 0
		return operand is AnyCall then block.Load(InstructionEntry.LoadAnyError(block.register)) else Handle(operand, block)
	caught = Caught(comparison, operand, block).Declare(Tested, values.TypeOf(operand, block))
	caught.Load(InstructionEntry.Named(InstructionType.LoadVariableToRegister, caught.register, Tested))
Caught(comparison SyntaxNode, node SyntaxNode, block CodeBlock) CodeBlock
	Plain.Caught(IsError, Greeting, InTest).instructions.Last is InstructionEntry.Jump(InstructionType.JumpEnd, 0)
	Plain.Caught(IsError, GreetingPlusOne, InTest).instructions(1).payload is (0, 0)
	Plain.Caught(IsOne, GreetingPlusOne, InTest).instructions(1).payload is (0, 7)
	Plain.Caught(IsError, Greeting, InTest).scope.TypeOf(FailureMarker) is "7"
	Plain.Caught(IsOne, Greeting, InTest).instructions.Last.texts is List(Text) + Tested
	isError = IsErrorComparison(comparison, block)
	caught = isError then block.WithNextId.Declare(FailureMarker, block.nextId to Text) else block
	stored = Handle(node, caught).Stored(Tested).At(block.register)
	if isError is false
		return stored
	joined = stored.Add(InstructionEntry.Jump(InstructionType.JumpEnd, block.nextId))
	joined.Declare(FailureMarker, block.scope.TypeOf(FailureMarker))
Validate(node SyntaxNode, block CodeBlock, constructed CodeBlock) CodeBlock
	Sizing.Validate(NewSize, CodeBlock.Empty, CodeBlock.Empty).instructions.Last.texts(1) is "Validated"
	Plain.Validate(Greeting, CodeBlock.Empty, CodeBlock.Empty).instructions.Length is 0
	Sizing.Validate(SyntaxNode("Call", "Size", IsOne.children), CodeBlock.Empty, CodeBlock.Empty) is CodeBlock.Empty
	type = values.TypeOf(node, block)
	types = values.inference.types
	isConstructor = node.Kind is "Call" and types.BaseName(type) is node.text
	constrained = types.ParameterScope(type).TypeOf(TypeShape.Constrained)
	isMet = constrained is node.children.Length to Text and node.children.Length > 1
	if isConstructor is false or constrained is "" or isMet
		return constructed
	values.Invoke(SyntaxNode("Member", "Validated", List(SyntaxNode) + node), constructed, constructed.Result, type)