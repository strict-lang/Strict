has values ValueCodegen
constant FallibleMarker = " fallible"
constant MutableMarker = " mutable"
constant Plain = ErrorScope(ValueCodegen.Plain)
constant Unused = ", use the value (condition, comparison, assignment, argument or result) or call a method without one"
constant Mutated = CodeBlock.Empty.Declare("a", "Count").Declare("a" + MutableMarker, "mutable")
constant Counting = ErrorScope(ValueCodegen(TypeInference(KnownTypes.Sample, TypeInference.Limits), KnownTypes.NoMembers, CallTarget.Plain))
constant Reassigning = BodyParser("Run", "\tmutable a = 1", "\ta = Greet").Block(1, 1)
constant Adding = BodyParser("Run", "\tmutable a = 1", "\ta = a + 1").Block(1, 1)
constant Increment = SyntaxNode("Member", "Increment", SyntaxNode("Identifier", "a"))
constant Numbered = CodeBlock.Empty.Declare("a", "Numbers")
constant Lists = KnownTypes(("List"), (KnownTypes.NoMembers), (KnownTypes.NoMembers), (Scope(("Add mutable", "Remove mutable", "Increment mutable"), ("Mutable", "Mutable", "Mutable"))))
constant Listing = ErrorScope(ValueCodegen(TypeInference(Lists, TypeInference.Limits), KnownTypes.NoMembers, CallTarget.Plain))
constant Growing = SyntaxNode("Member", "Add", Increment.children)
constant ListMutated = CodeBlock.Empty.Declare("a", "List").Declare("a" + MutableMarker, "mutable")
constant Listed = CodeBlock.Empty.Declare("a", "Counts").Declare("a" + MutableMarker, "mutable").Declare("Counts" + MutableMarker, "mutable")
Prepared(body SyntaxNode, block CodeBlock) CodeBlock
	Plain.Prepared(Reassigning, CodeBlock.Empty).scope.TypeOf("a fallible") is "fallible"
	Plain.Prepared(Adding, CodeBlock.Empty).scope.names.Length is 0
	Plain.Prepared(BodyParser("Run", "\ttext = Greet").Block(1, 1), CodeBlock.Empty).scope.names.Length is 0
	Plain.Reassigned(SyntaxNode("Binary", "+", (Increment.children(0), Increment))).Length is 0
	Plain.Reassigned(SyntaxNode("Reassignment", "", (Increment, Increment))).Length is 0
	Plain.Reassigned(SyntaxNode("Reassignment", "", (Increment.children(0), ValueCodegen.One))).Length is 0
	mutable prepared = block
	for Reassigned(body)
		if values.target.IsMember(values.target.TypeName, value) is false
			prepared = Fallible(value, prepared)
	prepared
Reassigned(node SyntaxNode) Texts
	Plain.Reassigned(BodyParser("Run", "\tmutable a = 1", "\tfor 2", "\t\ta = Greet").Block(1, 1)) is ("a")
	constant safe = ("Number", "Text", "Boolean", "Not", "Negate")
	if (node.Kind is "Reassignment") and (node.children(0).Kind is "Identifier")
		let assigned = node.children(1)
		let isOperator = (assigned.Kind is "Binary") and (assigned.text is not in ("to", "then", "else"))
		let isSafe = (assigned.Kind is in safe) or isOperator
		return isSafe then List(Text) else List(Text) + node.children(0).text
	mutable names = List(Mutable(Text))
	for node.children
		names = names + Reassigned(value)
	names
Dropped(node SyntaxNode, block CodeBlock) SyntaxNode
	Counting.Dropped(Increment, CodeBlock.Empty.Declare("a", "Count")) to Text is "a.Increment"
	Counting.Dropped(Increment, Mutated) to Text is "a = a.Increment"
	Listing.Dropped(SyntaxNode("Member", "Add", Increment.children), ListMutated) to Text is "a = a.Add"
	if IsMutating(node, block) is false
		return node
	let target = node.children(0)
	let isInPlace = (node.text is in ("Add", "Remove")) and values.inference.types.IsPlural(values.TypeOf(target, block))
	let isMutable = block.scope.TypeOf(target.text + MutableMarker) is not ""
	isMutable and (isInPlace is false) then SyntaxNode("Reassignment", "", (target, node), node.line) else node
IsMutating(node SyntaxNode, block CodeBlock) Boolean
	Counting.IsMutating(Increment, Mutated)
	Counting.IsMutating(SyntaxNode("Member", "Twice", Increment.children), Mutated) is false
	if (node.Kind is not in ("MethodCall", "Member")) or (node.children(0).Kind is not "Identifier")
		return false
	let type = values.TypeOf(node.children(0), block)
	values.inference.types.ParameterScope(type).TypeOf(node.text + MutableMarker) is not ""
Used(node SyntaxNode, block CodeBlock) SyntaxNode
	Plain.Used(SyntaxParser(Tokenizer("1 is 2").Tokens).Parse, CodeBlock.Empty) is Error
	Plain.Used(SyntaxParser(Tokenizer("1 + 2").Tokens).Parse, CodeBlock.Empty) is Error
	(Counting.Used(Increment, Mutated) is Increment) and (Plain.Used(Growing, Mutated).Kind is "Member")
	Plain.Used(BodyParser("Run", "\tif 1 is 2", "\t\t3").Block(1, 1).children(0), CodeBlock.Empty).Kind is "If"
	Plain.Used(SyntaxNode("Member", "Greet", ValueCodegen.NewGreeter), CodeBlock.Empty) is Error
	Plain.Used(SyntaxNode("Identifier", "a"), CodeBlock.Empty.Declare("a", "None")).Kind is "Identifier"
	if node.Kind is in ("If", "ElseIf", "Else", "For", "Declaration", "Reassignment", "Return")
		return node
	if (values.TypeOf(node, block) is in ("None", "")) or IsMutating(node, block) or IsGrowing(node, block)
		return node
	Error("ResultMustBeUsed: " + (node to Text) + " in " + values.target.fullName + ".strict:line " + node.line + Unused)
IsGrowing(node SyntaxNode, block CodeBlock) Boolean
	Plain.IsGrowing(Growing, Mutated)
	Plain.IsGrowing(Growing, CodeBlock.Empty.Declare("a", "Count")) is false
	Plain.IsGrowing(Increment, Mutated) is false
	Plain.IsGrowing(SyntaxNode("Identifier", "Add"), Mutated) is false
	if (node.Kind is not in ("MethodCall", "Member")) or (node.text is not in ("Add", "Remove"))
		return false
	block.scope.TypeOf(node.children(0).text + MutableMarker) is not ""
Declared(name Text, assigned SyntaxNode, isMutable Boolean, block CodeBlock) CodeBlock
	Plain.Declared("a", ErrorCodegen.Greeting, false, CodeBlock.Empty).scope.TypeOf("a" + FallibleMarker) is "fallible"
	Plain.Declared("a", ValueCodegen.One, true, CodeBlock.Empty).scope.TypeOf("a" + MutableMarker) is "mutable"
	Plain.Declared("a", ValueCodegen.One, false, CodeBlock.Empty).scope.names.Length is 0
	let marked = isMutable then block.Declare(name + MutableMarker, "mutable") else block
	let errors = ErrorCodegen(values)
	errors.MayFail(errors.Folded(assigned, block), block) then Fallible(name, marked) else marked
Fallible(name Text, block CodeBlock) CodeBlock
	Plain.Fallible("a", CodeBlock.Empty).scope.TypeOf("a" + FallibleMarker) is "fallible"
	Plain.Reassigned(SyntaxNode("Reassignment", "", (Increment.children(0), ValueCodegen.ToText))) is ("a")
	Plain.Reassigned(SyntaxNode("Reassignment", "", (Increment.children(0), Increment))) is ("a")
	Counting.Dropped(Increment.children(0), Mutated) is Increment.children(0)
	Counting.Dropped(SyntaxNode("MethodCall", "Increment", Increment.children), Mutated).Kind is "Reassignment"
	Counting.Dropped(SyntaxNode("Member", "Twice", Increment.children), Mutated).Kind is "Member"
	block.Declare(name + FallibleMarker, "fallible")
IsFallible(name Text, block CodeBlock) Boolean
	Plain.IsFallible("a", Plain.Fallible("a", CodeBlock.Empty))
	Plain.IsFallible("a", CodeBlock.Empty) is false
	Listing.Dropped(Increment, Listed).Kind is "Reassignment"
	Listing.Dropped(SyntaxNode("Member", "Add", Increment.children), Listed).Kind is "Member"
	Listing.Dropped(SyntaxNode("Member", "Remove", Increment.children), Listed).Kind is "Member"
	Listing.Dropped(SyntaxNode("Member", "Increment", SyntaxNode("Call", "Counts")), Listed).Kind is "Member"
	block.scope.TypeOf(name + FallibleMarker) is not ""
Guarded(name Text, block CodeBlock) CodeBlock
	Plain.Guarded("a", Plain.Fallible("a", Numbered)).instructions.Last.kind is InstructionType.CheckError
	Plain.Guarded("a", Numbered).instructions.Length is 0
	IsFallible(name, block) then values.Expression(SyntaxNode("Identifier", name), block).At(block.register) else block