has logger
has isQuiet Boolean = false
constant Logged = (Linker.Go, TypeEntry.HelloLogger)
constant Tips = " is not in this folder, next to strict, in a GitHub repository linked in README.md or in github.com/strict-lang. Fix the typo, add its package to this folder or link its repository in README.md"
Compiled(path Text, root Text, withTests Boolean) List(TypeEntry)
	let files = SourceFiles(root).Of(Normalized(path))
	Built(path, root, withTests, files, ResolveCheck.Inference(files))
Built(path Text, root Text, withTests Boolean, files Texts, inference TypeInference) List(TypeEntry)
	let source = Normalized(path)
	let missing = SourceFiles(root).Missing(File(source).ReadLines, files)
	if missing.Length > 0
		return Located(source, root, withTests, missing.First)
	if (Parsed(List(Text) + source) is false) or (Resolved(source, inference) is false)
		return List(TypeEntry)
	let main = TypeCodegen(FullName(source, root), Fusion(File(source).ReadLines).Fused, inference, FullNames(files, root))
	let entry = main.Entry
	let methods = withTests then entry.methods + TestCodegen(main, isQuiet).Tests else entry.methods
	let linker = Linker(root, main)
	Checked(linker, linker.Linked(TypeEntry(entry.Name, entry.members, methods), List(Text), 20), source, inference)
Checked(linker Linker, linked List(TypeEntry), source Text, inference TypeInference) List(TypeEntry)
	FileCompiler.Checked(Linker.Sample, List(TypeEntry) + Linker.Go, "./A.strict", ResolveCheck.Counting).Length is 1
	let sources = Sources(linker, linked, source)
	if Parsed(sources) is false
		return List(TypeEntry)
	mutable unresolved = List(Mutable(Text))
	for sources
		unresolved = unresolved + ResolveCheck(logger).Unresolved(value, inference)
	for unresolved
		logger.Log(value)
	unresolved.Length is 0 then linked else List(TypeEntry)
Sources(linker Linker, linked List(TypeEntry), source Text) Texts
	FileCompiler.Sources(Linker.Sample, Logged, "./Examples/A.strict") is List(Text) + "./Examples/HelloLogger.strict"
	mutable paths = List(Mutable(Text))
	for linked
		let local = Path(source).PathOnly.text + "/" + value.Name + ".strict"
		let path = value.Name.IndexOf("/") < 0 then local else linker.SourcePath(value.Name)
		if (path is not source) and (path is not in paths) and File(path).Exists
			paths.Add(path)
	paths
Located(path Text, root Text, withTests Boolean, type Text) List(TypeEntry)
	let normalized = Normalized(path)
	let above = SourceFiles(".").SubfolderWith("..", type) + SourceFiles(".").SubfolderWith("../..", type)
	if above is not ""
		logger.Log("TypeNotFound: " + type + " used in " + path + " is in " + above + ", run strict in the project folder")
		return List(TypeEntry)
	if normalized.StartsWith("./") and (normalized.IndexOf("/../") < 0)
		if Repositories(logger, ".").Downloaded(type) is not ""
			return Compiled(path, root, withTests)
	logger.Log("TypeNotFound: " + type + " used in " + path + ":" + LineOf(File(path).ReadLines, type) + Tips)
	List(TypeEntry)
Parsed(files Texts) Boolean
	FileCompiler.Parsed(("./Number.strict", "./Text.strict"))
	for files
		let lines = File(value).ReadLines
		let broken = Unparsable(lines)
		if broken >= 0
			logger.Log(FileCheck.Problem(lines, broken) + " in " + Normalized(value) + ":" + (broken + 1))
			return false
	true
Unparsable(lines Texts) Number
	FileCompiler.Unparsable(("Add(other Number) Number", "	number + + other")) is 1
	FileCompiler.Unparsable(("Run", "	logger.Log(1 + 2)")) is -1
	FileCompiler.Unparsable(("Run", "\t", "\t1")) is 1
	FileCompiler.Unparsable(("Run", "\t1 is 1", "", "\t1")) is 2
	for lines
		if value.StartsWith("	") and (IsParsed(value.Trim) is false)
			return index
		let next = index + 1 < lines.Length then lines(index + 1) else ""
		if (value.Trim is "") and (value.StartsWith("\t") or next.StartsWith("\t"))
			return index
	-1
IsParsed(line Text) Boolean
	FileCompiler.IsParsed("let a = b + c")
	FileCompiler.IsParsed("(number + other") is false
	FileCompiler.IsParsed("if generic is")
	FileCompiler.IsParsed("* value")
	FileCompiler.IsParsed("number + other other") is false
	let tokens = Tokenizer(line).Tokens
	let statement = StatementParser(tokens).ParseStatement
	if (statement is Error) or (Tokenizer(line).IsGrouped is false)
		return false
	let isReduce = (statement.Kind is "Binary") and (statement.children.First.Kind is "Missing")
	let regenerated = Tokenizer(statement to Text).Tokens - "(" - ")"
	IsComplete(isReduce then statement.children.Last else statement) and (regenerated is (tokens - "(" - ")"))
IsComplete(node SyntaxNode) Boolean
	FileCompiler.IsComplete(SyntaxParser(Tokenizer("a + b * c").Tokens).Parse)
	FileCompiler.IsComplete(SyntaxParser(Tokenizer("a + + b").Tokens).Parse) is false
	for node.children
		if (value.Kind is "Missing") and IsOperand(node, index)
			return false
		if IsComplete(value) is false
			return false
	true
IsOperand(node SyntaxNode, position Number) Boolean
	FileCompiler.IsOperand(SyntaxNode("Binary", "+", (SyntaxNode("Missing", ""), SyntaxNode("Missing", ""))), 1)
	FileCompiler.IsOperand(SyntaxNode("Binary", "is", (SyntaxNode("Missing", ""), SyntaxNode("Missing", ""))), 1) is false
	(node.Kind is in ("Not", "Negate")) or ((node.Kind is "Binary") and ((position is 0) or (node.text is not "is")))
Resolved(source Text, inference TypeInference) Boolean
	FileCompiler.Resolved("./Logger.strict", ResolveCheck.Inference(("./Logger.strict", "./TextWriter.strict")))
	let unresolved = ResolveCheck(logger).Unresolved(source, inference)
	for unresolved
		logger.Log(value)
	unresolved.Length is 0
LineOf(lines Texts, name Text) Number
	FileCompiler.LineOf(("has logger", "has numbr"), "Numbr") is 2
	for lines
		if value.Lower.IndexOf(name.Lower) >= 0
			return index + 1
	1
Normalized(path Text) Text
	Normalized("Bytecode\\A.strict") is "./Bytecode/A.strict"
	Normalized("./A.strict") is "./A.strict"
	Normalized("C:/s/A.strict") is "C:/s/A.strict"
	Normalized("C:/s/./A.strict") is "C:/s/A.strict"
	Normalized("C:\\s\\A.strict") is "C:/s/A.strict"
	Normalized("A.strict") is "./A.strict"
	Normalized("../DeltaEngine/A.strict") is "./../DeltaEngine/A.strict"
	Normalized(Directory.Current + "/Sub/A.strict") is "./Sub/A.strict"
	let slashed = TypeSource.Relative(path).Replace("\\", "/").Replace("/./", "/")
	let isRelative = (slashed.StartsWith("/") is false) and (slashed.IndexOf(":") < 0)
	isRelative and (slashed.StartsWith("./") is false) then "./" + slashed else slashed
FullName(path Text, root Text) Text
	FullName("C:/s/Bytecode\\A.strict", "C:/s") is "Strict/Bytecode/A"
	FullName("./Sub/Game.strict", "C:/s") is "Strict/Sub/Game"
	FullName("D:/project/Helper.strict", "C:/s") is "Strict/Helper"
	let slashed = path.Replace("\\", "/")
	if (slashed.StartsWith(root + "/") is false) and ((slashed.IndexOf(":") is 1) or slashed.StartsWith("/"))
		return "Strict/" + Path(slashed).FileName.RemoveExtension.text
	let start = slashed.StartsWith(root + "/") then root.Length + 1 else (slashed.StartsWith("./") then 2 else 0)
	"Strict/" + slashed.Substring(start, slashed.Length - start - 7)
FullNames(files Texts, root Text) Texts
	FullNames(("C:/s/A.strict", "C:/s/B/C.strict"), "C:/s") is ("Strict/A", "Strict/B/C")
	for files
		FullName(value, root)