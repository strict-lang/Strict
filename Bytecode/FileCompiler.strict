has isQuiet Boolean = false
has selection Text = ""
has isOptimizing Boolean = true
constant Unlinked = LinkRound(Linker.Hello, List(TypeEntry), List(Text))
constant Unoptimized = LoopCodegen(MethodCodegen(ValueCodegen(ValueCodegen.Plain, isOptimizing = false)))
constant Counted = LoopPeeling.Counted
constant Logged = (Linker.Go, TypeEntry.HelloLogger)
constant ByteOrderMark = (239, 187, 191)
constant Helped = ("has width = 1", "constant Help = (\"first", "- second\")")
constant Unspaced = List(Text) + "has width Number =5"
constant Opened = List(Text) + "has name Text = \"open"
constant Trailing = ("constant One = 1", "constant Pair = (\"a\",) + \"b\"")
constant Spaced = ("has a", "Run", "	1", "", "Next", "	2")
constant Ending = ("Run", "	1", "", "")
constant Tabbed = ("Run", "	1", "	")
constant Marked = "ByteOrderMarkIsNotAllowed: save the file as UTF-8 without BOM"
constant Project = ", run strict in the project folder"
constant Tips = " is not in this folder (or in a GitHub repository linked in README.md). Fix the typo or link its package."
Compile(path Text, root Text, withTests Boolean, known Texts = List(Text)) List(TypeEntry)
	started = Process.Elapsed
	files = known.Length > 0 then known else SourceFiles(root).Of(Normalize(path))
	if known.Length is 0
		Phases.Report("Frontend / source discovery (" + files.Length + " files)", started)
	before = Process.Elapsed
	inference = ResolveCheck.Inference(files)
	Phases.Report("Frontend / type inference", before)
	Build(path, root, withTests, files, inference).entries
Build(path Text, root Text, withTests Boolean, files Texts, inference TypeInference, known = Dictionary(Text, TypeEntry)) LinkRound
	source = Normalize(path)
	isParsed = FrontProfile.IsParsed(value, List(Text) + source)
	missing = isParsed then Mentions(File(source).ReadLines).Missing(files) else List(Text)
	if missing.Length > 0
		return Unlinked.With(Locate(source, root, withTests, missing.First))
	if isParsed is false or IsResolved(source, inference, files) is false
		return Unlinked
	fused = Fusion(File(source).ReadLines, Path(source).PathOnly.text).Fused
	main = TypeCodegen(FullName(source, root), fused, inference, FullNames(files, root), isOptimizing)
	entry = FrontProfile.Entry(main, withTests, isQuiet, selection)
	linked = FrontProfile.Link(Linker(root, main, known, BinarySources(files).Stamped), entry)
	checked = linked.With(Check(linked.linker, linked.entries, source, inference))
	before = Process.Elapsed
	saved = LinkHomes(checked).Saved
	Phases.Report("Frontend / saving homes", before)
	saved
Check(linker Linker, linked List(TypeEntry), source Text, inference TypeInference) List(TypeEntry)
	FileCompiler.Check(Linker.Sample, List(TypeEntry) + Linker.Go, "./A.strict", ResolveCheck.Counting).Length is 1
	sources = BinaryFile.Uncheck(Sources(linker, linked, source))
	if sources.Length > 0 and FrontProfile.IsParsed(value, sources) is false
		return List(TypeEntry)
	mutable failures = 0
	for sources.Length > 0 then FrontProfile.Issues(value, sources, inference) else List(Texts)
		failures = failures + value.Length
		for value
			logger.Log(value)
	failures is 0 then linked else List(TypeEntry)
Issues(sources Texts, inference TypeInference) List(Texts)
	FileCompiler.Issues(List(Text), ResolveCheck.Counting).Length is 0
	for sources
		ResolveCheck.Resolve(value, inference)
Sources(linker Linker, linked List(TypeEntry), source Text) Texts
	FileCompiler.Sources(Linker.Sample, Logged, "./Examples/A.strict") is List(Text) + "./Examples/HelloLogger.strict"
	FileCompiler.Sources(Linker.Knowing, Logged, "./Examples/A.strict").Length is 0
	checked = linker.KnownNames
	mutable paths = List(Mutable(Text))
	for linked
		if value.Name is not in checked
			local = Path(source).PathOnly.text + "/" + value.Name + ".strict"
			path = value.Name.IndexOf("/") < 0 then local else linker.SourcePath(value.Name)
			if path is not source and path is not in paths and File(path).Exists
				paths.Add(path)
	paths
Locate(path Text, root Text, withTests Boolean, type Text) List(TypeEntry)
	normalized = Normalize(path)
	hidden = Mentions(File(normalized).ReadLines).Hidden(path, type)
	above = SourceFiles(".").SubfolderWith("..", type) + SourceFiles(".").SubfolderWith("../..", type)
	if hidden is not "" or above is not ""
		logger.Log(hidden is "" then "TypeNotFound: " + type + " used in " + path + " is in " + above + Project else hidden)
		return List(TypeEntry)
	if normalized.StartsWith("./") and normalized.IndexOf("/../") < 0
		if Repositories(".").Download(type) is not ""
			return Compile(path, root, withTests)
	logger.Log(ResolveCheck.Locate(path, LineOf(File(path).ReadLines, type), "TypeNotFound: " + type + Tips))
	List(TypeEntry)
Problems(files Texts) Texts slow
	FileCompiler.Problems(("./Any.strict", "./Boolean.strict")) is ("", "")
	for files
		lines = File(value).ReadLines
		broken = Unparsable(lines)
		issue = broken < 0 then "" else ResolveCheck.Locate(value, broken + 1, FileCheck.Problem(lines, broken))
		IsMarked(File(value).ReadBytes) then ResolveCheck.Locate(value, 1, Marked) else issue
IsMarked(bytes Bytes) Boolean
	FileCompiler.IsMarked((239, 187, 191, 104))
	FileCompiler.IsMarked((239, 187)) is false and FileCompiler.IsMarked((239, 187, 104)) is false
	bytes.Length > 2 and bytes.Slice(0, 3) is ByteOrderMark
Unparsable(lines Texts) Number
	FileCompiler.Unparsable(("Add(other Number) Number", "	number + + other")) is 1 and Unparsable(Spaced) is 3
	Unparsable(("Run", "	logger.Log(1 + 2)")) is -1 and Unparsable(Ending) is -1 and Unparsable(Tabbed) is 2
	FileCompiler.Unparsable(("Run", "\t", "\t1")) is 1 and FileCompiler.Unparsable(("Run", "", "\t1")) is 1
	FileCompiler.Unparsable(("Run", "\t1 is 1", "", "\t1")) is 2 and FileCompiler.Unparsable(("\t1", "")) is -1
	Unparsable(Helped) is 1 and Unparsable(Trailing) is 1 and Unparsable(Unspaced) is 0 and Unparsable(Opened) is 0
	for lines
		next = index + 1 < lines.Length then lines(index + 1) else ""
		isEmpty = value.Trim is "" and next.Trim is not ""
		isBroken = value.StartsWith("	") then IsParsed(value.Trim) is false else Declaration.IsUnspaced(value)
		if isEmpty or isBroken or IsBrokenConstant(value) or Tokenizer(value).HasOpenText
			return index
	Number.NotFound
IsBrokenConstant(line Text) Boolean
	FileCompiler.IsBrokenConstant(Trailing.Last)
	FileCompiler.IsBrokenConstant("constant LoadConstantToRegister") is false
	FileCompiler.IsBrokenConstant(Trailing.First) is false
	FileCompiler.IsBrokenConstant("constant None = Style()") is false and IsBrokenConstant("has pair = (1,)") is false
	if line.StartsWith("constant ") is false
		return false
	IsComplete(StatementParser(Tokenizer(line).Tokens).ParseStatement) is false
IsParsed(line Text) Boolean
	FileCompiler.IsParsed("let a = b + c") and FileCompiler.IsParsed("a = b + c")
	FileCompiler.IsParsed("(number + other") is false and FileCompiler.IsParsed("a + b)") is false
	FileCompiler.IsParsed("if generic is") and FileCompiler.IsParsed("not") is false
	FileCompiler.IsParsed("* value") and FileCompiler.IsParsed("a + + b + c") is false
	FileCompiler.IsParsed("number + other other") is false and FileCompiler.IsParsed("(, a)") is false
	tokens = Tokenizer(line).Tokens
	statement = StatementParser(tokens).ParseStatement
	if statement is Error or Tokenizer.IsGrouped(tokens) is false
		return false
	isReduce = statement.Kind is "Binary" and statement.children.First.Kind is "Missing"
	printed = Tokenizer(statement to Text).Tokens - "(" - ")"
	expected = tokens - "(" - ")"
	isLet = statement.text.StartsWith("let ") and expected.Length > 0 and expected(0) is not "let"
	regenerated = statement.Kind is "Declaration" and isLet then printed.Slice(1, printed.Length - 1) else printed
	IsComplete(isReduce then statement.children.Last else statement) and regenerated is expected
IsComplete(node SyntaxNode) Boolean
	FileCompiler.IsComplete(SyntaxParser(Tokenizer("a + b * c").Tokens).Parse)
	FileCompiler.IsComplete(SyntaxParser(Tokenizer("a + + b").Tokens).Parse) is false
	FileCompiler.IsComplete(SyntaxParser(Tokenizer("Joined(number, (Two,))").Tokens).Parse) is false
	for node.children
		if value.Kind is "Missing" and IsOperand(node, index)
			return false
		if IsComplete(value) is false
			return false
	true
IsOperand(node SyntaxNode, position Number) Boolean
	FileCompiler.IsOperand(SyntaxNode("Binary", "+", (SyntaxNode("Missing", ""), SyntaxNode("Missing", ""))), 1)
	FileCompiler.IsOperand(SyntaxNode("Binary", "is", (SyntaxNode("Missing", ""), SyntaxNode("Missing", ""))), 1) is false
	FileCompiler.IsOperand(SyntaxParser(Tokenizer("(a,)").Tokens).Parse, 1)
	FileCompiler.IsOperand(SyntaxNode("Binary", "is", (SyntaxNode("Missing", ""), SyntaxNode("Missing", ""))), 0)
	FileCompiler.IsOperand(SyntaxNode("Member", "a", SyntaxNode("Missing", "")), 0) is false
	FileCompiler.IsOperand(SyntaxNode("Not", "not", SyntaxNode("Missing", "")), 0)
	isBinary = node.Kind is "Binary" and (position is 0 or node.text is not "is")
	node.Kind is in ("Not", "Negate", "List") or isBinary
IsResolved(source Text, inference TypeInference, files Texts = List(Text)) Boolean slow
	FileCompiler.IsResolved("./Logger.strict", ResolveCheck.Inference(("./Logger.strict", "./TextWriter.strict")))
	mutable unresolved = ResolveCheck.Resolve(source, inference)
	for files
		if value is not source and DefaultCheck(inference).HasCheckedMembers(ResolveCheck.TypeName(value))
			unresolved = unresolved + DefaultCheck(inference).Members(value, File(value).ReadLines)
	for unresolved
		logger.Log(value)
	unresolved.Length is 0
LineOf(lines Texts, name Text) Number
	FileCompiler.LineOf(("has logger", "has numbr"), "Numbr") is 2
	for lines
		if value.Lower.IndexOf(name.Lower) >= 0
			return index + 1
	1
Normalize(path Text) Text
	Normalize("Bytecode\\A.strict") is "./Bytecode/A.strict"
	Normalize("./A.strict") is "./A.strict"
	Normalize("C:/s/A.strict") is "C:/s/A.strict"
	Normalize("C:/s/./A.strict") is "C:/s/A.strict"
	Normalize("C:\\s\\A.strict") is "C:/s/A.strict"
	Normalize("A.strict") is "./A.strict"
	Normalize("../DeltaEngine/A.strict") is "./../DeltaEngine/A.strict"
	Normalize(Directory.Current + "/Sub/A.strict") is "./Sub/A.strict"
	slashed = TypeSource.Relative(path).Replace("\\", "/").Replace("/./", "/")
	isRelative = slashed.StartsWith("/") is false and slashed.IndexOf(":") < 0
	isRelative and slashed.StartsWith("./") is false then "./" + slashed else slashed
FullName(path Text, root Text) Text
	FullName("C:/s/Bytecode\\A.strict", "C:/s") is "Strict/Bytecode/A"
	FullName("./Sub/Game.strict", "C:/s") is "Strict/Sub/Game"
	FullName("D:/project/Helper.strict", "C:/s") is "Strict/Helper"
	FullName("/x/Helper.strict", "C:/s") is "Strict/Helper"
	FullName("C:/sx/A.strict", "C:/s") is "Strict/A"
	FullName("sx/A.strict", "s") is "Strict/sx/A"
	slashed = path.Replace("\\", "/")
	if slashed.StartsWith(root + "/") is false and (slashed.IndexOf(":") is 1 or slashed.StartsWith("/"))
		return "Strict/" + Path(slashed).FileName.RemoveExtension.text
	start = slashed.StartsWith(root + "/") then root.Length + 1 else (slashed.StartsWith("./") then 2 else 0)
	"Strict/" + slashed.Substring(start, slashed.Length - start - 7)
FullNames(files Texts, root Text) Texts
	Unoptimized.Loop(LoopPeeling.Summing, Counted, "") is LoopCodegen.Plain.Unpeel(LoopPeeling.Summing, Counted, "")
	FullNames(("C:/s/A.strict", "C:/s/B/C.strict"), "C:/s") is ("Strict/A", "Strict/B/C")
	for files
		FullName(value, root)