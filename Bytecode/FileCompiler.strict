has logger
has isQuiet Boolean = false
has selection Text = ""
has isOptimizing Boolean = true
constant Unlinked = LinkRound(Linker.Hello, List(TypeEntry), List(Text))
constant Unoptimized = LoopCodegen(MethodCodegen(ValueCodegen(ValueCodegen.Plain, isOptimizing = false)))
constant Counted = LoopPeeling.Counted
constant Logged = (Linker.Go, TypeEntry.HelloLogger)
constant ByteOrderMark = (239, 187, 191)
constant Helped = ("has width = 1", "constant Help = (\"first", "- second\")")
constant Unspaced = List(Text) + "has width Number =5"
constant Opened = List(Text) + "has name Text = \"open"
constant Trailing = ("constant One = 1", "constant Pair = (\"a\",) + \"b\"")
constant Marked = "ByteOrderMarkIsNotAllowed: save the file as UTF-8 without BOM"
constant Tips = " is not in this folder, next to strict, in a GitHub repository linked in README.md or in github.com/strict-lang. Fix the typo, add its package to this folder or link its repository in README.md"
Compiled(path Text, root Text, withTests Boolean, known Texts = List(Text)) List(TypeEntry)
	let started = Process.Elapsed
	let files = known.Length > 0 then known else SourceFiles(root).Of(Normalized(path))
	if known.Length is 0
		BuildProfile(logger).Reported("Frontend / source discovery (" + files.Length + " files)", started)
	let before = Process.Elapsed
	let inference = ResolveCheck.Inference(files)
	BuildProfile(logger).Reported("Frontend / type inference", before)
	Built(path, root, withTests, files, inference).entries
Built(path Text, root Text, withTests Boolean, files Texts, inference TypeInference, known = Dictionary(Text, TypeEntry)) LinkRound
	let source = Normalized(path)
	let isParsed = BuildProfile(logger).Parsed(value, List(Text) + source)
	let missing = isParsed then Mentions(File(source).ReadLines).Missing(files) else List(Text)
	if missing.Length > 0
		return Unlinked.With(Located(source, root, withTests, missing.First))
	if (isParsed is false) or (Resolved(source, inference, files) is false)
		return Unlinked
	let fused = Fusion(File(source).ReadLines, Path(source).PathOnly.text).Fused
	let main = TypeCodegen(FullName(source, root), fused, inference, FullNames(files, root), isOptimizing)
	let entry = BuildProfile(logger).Entry(main, withTests, isQuiet, selection)
	let linked = BuildProfile(logger).Linked(Linker(root, main, known, BinarySources(files).Stamped), entry)
	LinkHomes(linked.With(Checked(linked.linker, linked.entries, source, inference))).Saved
Checked(linker Linker, linked List(TypeEntry), source Text, inference TypeInference) List(TypeEntry)
	FileCompiler.Checked(Linker.Sample, List(TypeEntry) + Linker.Go, "./A.strict", ResolveCheck.Counting).Length is 1
	let sources = Sources(linker, linked, source)
	if BuildProfile(logger).Parsed(value, sources) is false
		return List(TypeEntry)
	mutable failures = 0
	for BuildProfile(logger).Issues(value, sources, inference)
		failures = failures + value.Length
		for value
			logger.Log(value)
	failures is 0 then linked else List(TypeEntry)
Issues(sources Texts, inference TypeInference) List(Texts)
	FileCompiler.Issues(List(Text), ResolveCheck.Counting).Length is 0
	for sources
		ResolveCheck(logger).Unresolved(value, inference)
Sources(linker Linker, linked List(TypeEntry), source Text) Texts
	FileCompiler.Sources(Linker.Sample, Logged, "./Examples/A.strict") is List(Text) + "./Examples/HelloLogger.strict"
	mutable paths = List(Mutable(Text))
	for linked
		let local = Path(source).PathOnly.text + "/" + value.Name + ".strict"
		let path = value.Name.IndexOf("/") < 0 then local else linker.SourcePath(value.Name)
		if (path is not source) and (path is not in paths) and File(path).Exists
			paths.Add(path)
	paths
Located(path Text, root Text, withTests Boolean, type Text) List(TypeEntry)
	let normalized = Normalized(path)
	let above = SourceFiles(".").SubfolderWith("..", type) + SourceFiles(".").SubfolderWith("../..", type)
	if above is not ""
		logger.Log("TypeNotFound: " + type + " used in " + path + " is in " + above + ", run strict in the project folder")
		return List(TypeEntry)
	if normalized.StartsWith("./") and (normalized.IndexOf("/../") < 0)
		if Repositories(logger, ".").Downloaded(type) is not ""
			return Compiled(path, root, withTests)
	logger.Log(ResolveCheck.Located(path, LineOf(File(path).ReadLines, type), "TypeNotFound: " + type + Tips))
	List(TypeEntry)
Problems(files Texts) Texts slow
	FileCompiler.Problems(("./Number.strict", "./Text.strict")) is ("", "")
	for files
		let lines = File(value).ReadLines
		let broken = Unparsable(lines)
		let issue = broken < 0 then "" else ResolveCheck.Located(value, broken + 1, FileCheck.Problem(lines, broken))
		IsMarked(File(value).ReadBytes) then ResolveCheck.Located(value, 1, Marked) else issue
IsMarked(bytes Bytes) Boolean
	FileCompiler.IsMarked((239, 187, 191, 104))
	FileCompiler.IsMarked((239, 187)) is false and (FileCompiler.IsMarked((239, 187, 104)) is false)
	(bytes.Length > 2) and (bytes.Slice(0, 3) is ByteOrderMark)
Unparsable(lines Texts) Number
	FileCompiler.Unparsable(("Add(other Number) Number", "	number + + other")) is 1
	FileCompiler.Unparsable(("Run", "	logger.Log(1 + 2)")) is -1 and (FileCompiler.Unparsable(("Run", "")) is -1)
	FileCompiler.Unparsable(("Run", "\t", "\t1")) is 1 and (FileCompiler.Unparsable(("Run", "", "\t1")) is 1)
	FileCompiler.Unparsable(("Run", "\t1 is 1", "", "\t1")) is 2 and (FileCompiler.Unparsable(("\t1", "")) is -1)
	(Unparsable(Helped) is 1) and (Unparsable(Trailing) is 1) and (Unparsable(Unspaced) is 0) and (Unparsable(Opened) is 0)
	for lines
		let next = index + 1 < lines.Length then lines(index + 1) else ""
		let isEmpty = (value.Trim is "") and (value.StartsWith("\t") or next.StartsWith("\t"))
		let isBroken = value.StartsWith("	") then IsParsed(value.Trim) is false else Declaration.IsUnspaced(value)
		if isEmpty or isBroken or IsBrokenConstant(value) or Tokenizer(value).HasOpenText
			return index
	-1
IsBrokenConstant(line Text) Boolean
	FileCompiler.IsBrokenConstant(Trailing.Last)
	FileCompiler.IsBrokenConstant("constant LoadConstantToRegister") is false
	FileCompiler.IsBrokenConstant(Trailing.First) is false
	FileCompiler.IsBrokenConstant("constant None = Style()") is false and (IsBrokenConstant("has pair = (1,)") is false)
	line.StartsWith("constant ") and (IsComplete(StatementParser(Tokenizer(line).Tokens).ParseStatement) is false)
IsParsed(line Text) Boolean
	FileCompiler.IsParsed("let a = b + c")
	FileCompiler.IsParsed("(number + other") is false and (FileCompiler.IsParsed("a + b)") is false)
	FileCompiler.IsParsed("if generic is") and (FileCompiler.IsParsed("not") is false)
	FileCompiler.IsParsed("* value") and (FileCompiler.IsParsed("a + + b + c") is false)
	FileCompiler.IsParsed("number + other other") is false and (FileCompiler.IsParsed("(, a)") is false)
	let tokens = Tokenizer(line).Tokens
	let statement = StatementParser(tokens).ParseStatement
	if (statement is Error) or (Tokenizer.IsGrouped(tokens) is false)
		return false
	let isReduce = (statement.Kind is "Binary") and (statement.children.First.Kind is "Missing")
	let regenerated = Tokenizer(statement to Text).Tokens - "(" - ")"
	IsComplete(isReduce then statement.children.Last else statement) and (regenerated is (tokens - "(" - ")"))
IsComplete(node SyntaxNode) Boolean
	FileCompiler.IsComplete(SyntaxParser(Tokenizer("a + b * c").Tokens).Parse)
	FileCompiler.IsComplete(SyntaxParser(Tokenizer("a + + b").Tokens).Parse) is false
	FileCompiler.IsComplete(SyntaxParser(Tokenizer("Joined(number, (Two,))").Tokens).Parse) is false
	for node.children
		if (value.Kind is "Missing") and IsOperand(node, index)
			return false
		if IsComplete(value) is false
			return false
	true
IsOperand(node SyntaxNode, position Number) Boolean
	FileCompiler.IsOperand(SyntaxNode("Binary", "+", (SyntaxNode("Missing", ""), SyntaxNode("Missing", ""))), 1)
	FileCompiler.IsOperand(SyntaxNode("Binary", "is", (SyntaxNode("Missing", ""), SyntaxNode("Missing", ""))), 1) is false
	FileCompiler.IsOperand(SyntaxParser(Tokenizer("(a,)").Tokens).Parse, 1)
	FileCompiler.IsOperand(SyntaxNode("Binary", "is", (SyntaxNode("Missing", ""), SyntaxNode("Missing", ""))), 0)
	FileCompiler.IsOperand(SyntaxNode("Member", "a", SyntaxNode("Missing", "")), 0) is false
	FileCompiler.IsOperand(SyntaxNode("Not", "not", SyntaxNode("Missing", "")), 0)
	let isBinary = (node.Kind is "Binary") and ((position is 0) or (node.text is not "is"))
	(node.Kind is in ("Not", "Negate", "List")) or isBinary
Resolved(source Text, inference TypeInference, files Texts = List(Text)) Boolean slow
	FileCompiler.Resolved("./Logger.strict", ResolveCheck.Inference(("./Logger.strict", "./TextWriter.strict")))
	mutable unresolved = ResolveCheck(logger).Unresolved(source, inference)
	for files
		if (value is not source) and DefaultCheck(inference).HasCheckedMembers(ResolveCheck.TypeName(value))
			unresolved = unresolved + DefaultCheck(inference).Members(value, File(value).ReadLines)
	for unresolved
		logger.Log(value)
	unresolved.Length is 0
LineOf(lines Texts, name Text) Number
	FileCompiler.LineOf(("has logger", "has numbr"), "Numbr") is 2
	for lines
		if value.Lower.IndexOf(name.Lower) >= 0
			return index + 1
	1
Normalized(path Text) Text
	Normalized("Bytecode\\A.strict") is "./Bytecode/A.strict"
	Normalized("./A.strict") is "./A.strict"
	Normalized("C:/s/A.strict") is "C:/s/A.strict"
	Normalized("C:/s/./A.strict") is "C:/s/A.strict"
	Normalized("C:\\s\\A.strict") is "C:/s/A.strict"
	Normalized("A.strict") is "./A.strict"
	Normalized("../DeltaEngine/A.strict") is "./../DeltaEngine/A.strict"
	Normalized(Directory.Current + "/Sub/A.strict") is "./Sub/A.strict"
	let slashed = TypeSource.Relative(path).Replace("\\", "/").Replace("/./", "/")
	let isRelative = (slashed.StartsWith("/") is false) and (slashed.IndexOf(":") < 0)
	isRelative and (slashed.StartsWith("./") is false) then "./" + slashed else slashed
FullName(path Text, root Text) Text
	FullName("C:/s/Bytecode\\A.strict", "C:/s") is "Strict/Bytecode/A"
	FullName("./Sub/Game.strict", "C:/s") is "Strict/Sub/Game"
	FullName("D:/project/Helper.strict", "C:/s") is "Strict/Helper"
	FullName("/x/Helper.strict", "C:/s") is "Strict/Helper"
	FullName("C:/sx/A.strict", "C:/s") is "Strict/A"
	FullName("sx/A.strict", "s") is "Strict/sx/A"
	let slashed = path.Replace("\\", "/")
	if (slashed.StartsWith(root + "/") is false) and ((slashed.IndexOf(":") is 1) or slashed.StartsWith("/"))
		return "Strict/" + Path(slashed).FileName.RemoveExtension.text
	let start = slashed.StartsWith(root + "/") then root.Length + 1 else (slashed.StartsWith("./") then 2 else 0)
	"Strict/" + slashed.Substring(start, slashed.Length - start - 7)
FullNames(files Texts, root Text) Texts
	Unoptimized.Loop(LoopPeeling.Summing, Counted, "") is LoopCodegen.Plain.Unpeeled(LoopPeeling.Summing, Counted, "")
	FullNames(("C:/s/A.strict", "C:/s/B/C.strict"), "C:/s") is ("Strict/A", "Strict/B/C")
	for files
		FullName(value, root)