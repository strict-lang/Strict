constant Sample = BodyParser("Run", "\tfor Range(1, rounds + 1)", "\t\tpi = pi + (1 - 2 * (value % 2)) / (2 * value + 1)").Block(1, 1).children(0)
constant PlainSum = BodyParser("Run", "\tfor Range(0, rounds)", "\t\tsum = sum + value").Block(1, 1).children(0)
Merged(loop SyntaxNode) SyntaxNode
	FractionLoop.Merged(PlainSum).Kind is "For"
	Text.Combine(FractionLoop.Merged(Sample).Lines(""), " ").IndexOf("2500") > 0
	Text.Combine(FractionLoop.Merged(Sample).Lines(""), " ").IndexOf("sum = sum + -2") > 0
	let term = Term(loop)
	if (term.Kind is not "Binary") or (term.text is not "/")
		return loop
	let numerator = term.children(0) to Text
	let parts = numerator is "1 - 2 * (value % 2)" then Linear(term.children(1), "value") else ""
	if (parts is "") or (Bound(loop).Kind is not "Number")
		return loop
	Built(loop, parts)
Term(loop SyntaxNode) SyntaxNode
	let body = loop.Kind is "For" then loop.children.Last else loop
	let statement = body.Kind is "Body" then (body.children.Length is 1 then body.children(0) else loop) else body
	if statement.Kind is not "Reassignment"
		return statement
	let sum = statement.children(1)
	if (sum.Kind is not "Binary") or (sum.text is not "+") or (sum.children(0).text is not statement.children(0).text)
		return statement
	sum.children(1)
Bound(loop SyntaxNode) SyntaxNode
	let count = loop.Kind is "For" then loop.children(0) else loop
	(count.Kind is "Call") and (count.text is "Range") and (count.children.Length is 2) then count.children(0) else loop
Linear(node SyntaxNode, name Text) Text
	if (node.Kind is "Binary") and (node.text is "*")
		let product = Product(node, name)
		return product is "" then "" else product + "*0"
	if (node.Kind is not "Binary") or (node.text is not "+")
		return ""
	let left = node.children(0)
	let right = node.children(1)
	let product = left.Kind is "Binary" then Product(left, name) else Product(right, name)
	let offset = left.Kind is "Number" then left.text else (right.Kind is "Number" then right.text else "")
	(product is "") or (offset is "") then "" else product + "*" + offset
Product(node SyntaxNode, name Text) Text
	let left = node.children(0)
	let right = node.children(1)
	if (left.Kind is "Number") and (right.Kind is "Identifier") and (right.text is name)
		return left.text
	if (right.Kind is "Number") and (left.Kind is "Identifier") and (left.text is name)
		return right.text
	""
Built(loop SyntaxNode, parts Text) SyntaxNode
	let coefficient = parts.Split("*")(0)
	let offset = parts.Split("*")(1)
	let start = loop.children(0).children(0)
	let tail = start.text.EndsWith("0") or start.text.EndsWith("2") or start.text.EndsWith("4")
	let even = tail or start.text.EndsWith("6") or start.text.EndsWith("8")
	let factor = even then coefficient else "-" + coefficient
	let acc = loop.children.Last.children(0).children(0).text
	let name = SyntaxNode("Identifier", acc)
	let add = SyntaxNode("Reassignment", "", (name, Bin("+", name, SyntaxNode("Identifier", "value"))))
	let total = SyntaxNode("For", loop.text, (SyntaxNode("Identifier", "forResult"), SyntaxNode("Body", "", add)))
	let setup = Blocks(loop).children + (List(SyntaxNode) + Group(loop, start, coefficient, offset, factor))
	SyntaxNode("Body", "", setup + (List(SyntaxNode) + Rest(loop, start)) + (List(SyntaxNode) + total))
Blocks(loop SyntaxNode) SyntaxNode
	let start = loop.children(0).children(0)
	let end = loop.children(0).children(1)
	let span = start.text is "0" then end else Bin("-", end, start)
	let quarter = Bin("/", span, SyntaxNode("Number", "4"))
	let blocks = SyntaxNode("MethodCall", "Floor", List(SyntaxNode) + quarter)
	let divided = Bin("/", SyntaxNode("Identifier", "blocks"), SyntaxNode("Number", "2500"))
	let width = SyntaxNode("MethodCall", "Floor", List(SyntaxNode) + divided)
	let times = Bin("*", SyntaxNode("Identifier", "width"), SyntaxNode("Number", "2500"))
	let extra = Bin("-", SyntaxNode("Identifier", "blocks"), times)
	let one = SyntaxNode("Declaration", "let blocks", List(SyntaxNode) + blocks)
	let two = SyntaxNode("Declaration", "let width", List(SyntaxNode) + width)
	SyntaxNode("Body", "", (one, two, SyntaxNode("Declaration", "let extra", List(SyntaxNode) + extra)))
Group(loop SyntaxNode, start SyntaxNode, coefficient Text, offset Text, factor Text) SyntaxNode
	let parsed = BodyParser("Run", "\tvalue is 0 then extra else 0").Block(1, 1).children(0)
	let added = Bin("+", SyntaxNode("Identifier", "width"), parsed)
	let count = SyntaxNode("MethodCall", "Floor", List(SyntaxNode) + added)
	let chosen = BodyParser("Run", "\tvalue is 0 then blocks - count else (2499 - value) * width").Block(1, 1)
	let high = BodyParser("Run", "\tlow + count - 1").Block(1, 1).children(0)
	let range = SyntaxNode("Call", "Range", (high, Bin("-", SyntaxNode("Identifier", "low"), SyntaxNode("Number", "1"))))
	let inner = SyntaxNode("For", loop.text, (range, Inner(start, coefficient, offset, factor)), loop.line)
	let opening = SyntaxNode("Declaration", "let count", List(SyntaxNode) + count)
	let placed = SyntaxNode("Declaration", "let low", List(SyntaxNode) + chosen.children(0))
	let zero = SyntaxNode("Declaration", "mutable sum", List(SyntaxNode) + SyntaxNode("Number", "0"))
	let body = SyntaxNode("Body", "", (opening, placed, zero, inner, SyntaxNode("Identifier", "sum")))
	SyntaxNode("For", "slices", (SyntaxNode("Number", "2500"), body))
Rest(loop SyntaxNode, start SyntaxNode) SyntaxNode
	let end = loop.children(0).children(1)
	let range = SyntaxNode("Call", "Range", (Shift(start, "blocks"), end))
	SyntaxNode("For", loop.text, (range, loop.children.Last), loop.line)
Inner(start SyntaxNode, coefficient Text, offset Text, factor Text) SyntaxNode
	let origin = SyntaxNode("Declaration", "let origin", List(SyntaxNode) + Shift(start, "value"))
	let first = SyntaxNode("Declaration", "let first", List(SyntaxNode) + Widen(coefficient, offset))
	let step = Bin("+", SyntaxNode("Identifier", "first"), SyntaxNode("Number", coefficient))
	let left = SyntaxNode("Declaration", "let left", List(SyntaxNode) + Bin("*", SyntaxNode("Identifier", "first"), step))
	let right = SyntaxNode("Declaration", "let right", List(SyntaxNode) + Sides(coefficient))
	let added = Bin("+", SyntaxNode("Identifier", "sum"), Ratio(factor))
	let update = SyntaxNode("Reassignment", "", (SyntaxNode("Identifier", "sum"), added))
	SyntaxNode("Body", "", (origin, first, left, right, update))
Widen(coefficient Text, offset Text) SyntaxNode
	let scaled = Bin("*", SyntaxNode("Number", coefficient), SyntaxNode("Identifier", "origin"))
	Bin("+", scaled, SyntaxNode("Number", offset))
Sides(coefficient Text) SyntaxNode
	let near = Bin("+", SyntaxNode("Identifier", "first"), Scale("2", coefficient))
	let far = Bin("+", SyntaxNode("Identifier", "first"), Scale("3", coefficient))
	Bin("*", near, far)
Ratio(factor Text) SyntaxNode
	let sum = Bin("+", SyntaxNode("Identifier", "left"), SyntaxNode("Identifier", "right"))
	let prod = Bin("*", SyntaxNode("Identifier", "left"), SyntaxNode("Identifier", "right"))
	Bin("/", Bin("*", SyntaxNode("Number", factor), sum), prod)
Shift(start SyntaxNode, name Text) SyntaxNode
	let span = Bin("*", SyntaxNode("Number", "4"), SyntaxNode("Identifier", name))
	start.text is "0" then span else Bin("+", start, span)
Scale(times Text, coefficient Text) SyntaxNode
	if (coefficient is "2") and (times is "2")
		return SyntaxNode("Number", "4")
	if (coefficient is "2") and (times is "3")
		return SyntaxNode("Number", "6")
	Bin("*", SyntaxNode("Number", times), SyntaxNode("Number", coefficient))
Bin(op Text, left SyntaxNode, right SyntaxNode) SyntaxNode
	SyntaxNode("Binary", op, (left, right))
