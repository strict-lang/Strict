has values ValueCodegen
constant Plain = IndexCodegen(ValueCodegen.Plain)
constant OwnA = IndexCodegen(ValueCodegen.OwnA)
constant One = ValueCodegen.One
constant NoNode = ValueCodegen.NoNode
constant Hi = ValueCodegen.Hi
constant Failed = CodeBlock.Empty.Declare("failed", "Error")
constant Named = CodeBlock.Empty.Declare("named", "Dictionary(Text, Number)")
IsIndexing(node SyntaxNode, block CodeBlock) Boolean
	Plain.IsIndexing(SyntaxNode("Call", "text", One), CodeBlock.Empty) is true
	Plain.IsIndexing(SyntaxNode("Call", "Greet"), CodeBlock.Empty) is false
	OwnA.IsIndexing(SyntaxNode("Call", "limits", One), CodeBlock.Empty) is true
	Plain.IsIndexing(SyntaxNode("Call", "text", (One, One)), CodeBlock.Empty) is true
	Plain.IsIndexing(SyntaxNode("MethodCall", "text", (ValueCodegen.NewGreeter, One, One)), CodeBlock.Empty) is true
	if node.Kind is "Call"
		return IsIndexedCall(node, block)
	let isMember = (node.Kind is "MethodCall") and (node.children.Length is in (2, 3))
	isMember and ((node.text is "value") or values.target.IsMember(values.TypeOf(node.children(0), block), node.text))
IsIndexedCall(node SyntaxNode, block CodeBlock) Boolean
	OwnA.IsIndexedCall(SyntaxNode("Call", "limits", One), CodeBlock.Empty) is true
	OwnA.IsIndexedCall(SyntaxNode("Call", "A", One), CodeBlock.Empty) is false
	let isOwnMember = values.target.IsMember(values.target.TypeName, node.text)
	let isConstant = values.methods.TypeOf(node.text) is not "" and (values.target.Header(node.text).tokens.Length is 0)
	let isNamed = block.scope.TypeOf(node.text) is not "" or isOwnMember or isConstant
	let isIndexed = (node.children.Length is 1) and isNamed or (node.children.Length is 2) and isOwnMember
	isIndexed and (values.inference.types.IsKnown(node.text) is false)
Indexed(node SyntaxNode, block CodeBlock) CodeBlock
	Plain.Indexed(SyntaxNode("Call", "text", One), CodeBlock.Empty).instructions.Last.kind is InstructionType.IndexCall
	Plain.Indexed(SyntaxNode("Call", "failed", One), Failed).instructions.Last.kind is InstructionType.Invoke
	Plain.Indexed(SyntaxNode("Call", "named", One), Named).instructions.Last.kind is InstructionType.Invoke
	let isCall = node.Kind is "Call"
	let named = isCall then SyntaxNode("Identifier", node.text) else SyntaxNode("Member", node.text, node.children(0))
	if values.TypeOf(named, block).StartsWith("Dictionary(")
		return values.Expression(SyntaxNode("MethodCall", "get", (named, node.children.Last)), block)
	let isError = isCall and (block.scope.TypeOf(node.text) is "Error")
	isError then WithValue(node, block) else Element(node, block)
WithValue(node SyntaxNode, block CodeBlock) CodeBlock
	Plain.WithValue(SyntaxNode("Call", "failed", One), Failed).instructions(0).texts is ("failed")
	Plain.WithValue(SyntaxNode("Call", "failed", One), Failed).instructions.Last.texts.Last is "Value"
	let error = values.Expression(SyntaxNode("Identifier", node.text), block)
	let wrapped = values.Expression(node.children(0), error)
	constant signature = ("Strict/ErrorWithValue", "from", "Strict/ErrorWithValue", "Error", "Value")
	wrapped.Load(InstructionEntry.Invoke(wrapped.register, signature, (error.Result, wrapped.Result), -1))
Element(node SyntaxNode, block CodeBlock) CodeBlock
	Plain.Element(SyntaxNode("MethodCall", "text", (ValueCodegen.NewGreeter, One)), CodeBlock.Empty).nextId is 1
	let named = ConstantFolding(values.target.TypeName, values.inference).Folded(SyntaxNode("Identifier", node.text))
	let isComputed = (named.Kind is not "Identifier") and (named.IsLiteral is false)
	let isNamed = (node.Kind is "Call") and (isComputed is false)
	let name = isNamed then node.text else "list" + block.nextId
	let source = node.Kind is "Call" then named else SyntaxNode("Member", node.text, node.children(0))
	let list = isNamed then block else values.Expression(source, block)
	let stored = isNamed then list else list.Stored(name).WithNextId
	let index = values.Expression(GridIndex(node), stored)
	index.Load(InstructionEntry(InstructionType.IndexCall, List(Text) + name, (index.register, index.Result, -1)))
GridIndex(node SyntaxNode) SyntaxNode
	Plain.GridIndex(SyntaxNode("MethodCall", "a", (NoNode, One))).text is "1"
	Plain.GridIndex(SyntaxNode("MethodCall", "a", (NoNode, One, Hi))) to Text is "1 + x.Size.Width * \"Hi\""
	Plain.GridIndex(SyntaxNode("Call", "a", (One, NoNode))) to Text is "1 + Size.Width * x"
	let first = node.Kind is "Call" then 0 else 1
	if node.children.Length - first < 2
		return node.children.Last
	let size = first is 0 then SyntaxNode("Identifier", "Size") else SyntaxNode("Member", "Size", node.children(0))
	let width = SyntaxNode("Member", "Width", size)
	SyntaxNode("Binary", "+", (node.children(first), SyntaxNode("Binary", "*", (width, node.children(first + 1)))))