has values ValueCodegen
constant Plain = IndexCodegen(ValueCodegen.Plain)
constant OwnA = IndexCodegen(ValueCodegen.OwnA)
constant Positioning = IndexCodegen(ValueCodegen(Indexing.Inferring, MethodCodegen.NoScope, CallTarget.Plain))
constant MemberA = IndexCodegen(ValueCodegen(ValueCodegen.NoTypes, MethodCodegen.NoScope, CallTarget(CallTarget.NoTypes, TypeShape("has A Text"), "Strict/C", List(Text))))
constant One = ValueCodegen.One
constant NoNode = ValueCodegen.NoNode
constant Hi = ValueCodegen.Hi
constant Failed = CodeBlock.Empty.Declare("failed", "Error")
constant Primed = IndexCodegen(ValueCodegen(TypeInference(KnownTypes.Sample, (Scope(List(Text) + "Primes", List(Text) + "(2, 3, 5)"), TypeInference.NoShape)), Scope(("Greet", "Run"), ("Text", "None")), CallTarget.Plain))
constant PrimeCall = SyntaxNode("MethodCall", "Primes", (SyntaxNode("Identifier", "Count"), ValueCodegen.One))
constant Looped = BodyParser("Run", "\tfor 3", "\t\tvalues(index + 1) = 5").Block(1, 1)
constant Computed = BodyParser("Run", "\tvalues(index + 1) = 5").Block(1, 1)
constant Named = CodeBlock.Empty.Declare("named", "Dictionary(Text, Number)")
constant KeyedWrite = BodyParser("Run", "\tnamed(\"a\") = 1").Block(1, 1).children(0)
IsIndexing(node SyntaxNode, block CodeBlock) Boolean
	Plain.IsIndexing(SyntaxNode("Call", "text", One), CodeBlock.Empty) is true
	Plain.IsIndexing(SyntaxNode("Call", "Greet"), CodeBlock.Empty) is false
	OwnA.IsIndexing(SyntaxNode("Call", "limits", One), CodeBlock.Empty) is true
	Plain.IsIndexing(SyntaxNode("Call", "text", (One, One)), CodeBlock.Empty) is true
	Plain.IsIndexing(SyntaxNode("MethodCall", "text", (ValueCodegen.NewGreeter, One, One)), CodeBlock.Empty) is true
	Primed.IsIndexing(PrimeCall, CodeBlock.Empty) is true
	if node.Kind is "Call"
		return IsIndexedCall(node, block)
	let isMember = (node.Kind is "MethodCall") and (node.children.Length is in (2, 3))
	let isConstant = isMember and IsConstantList(node)
	let isOwned = isMember and IsOwnedList(node, block)
	isMember and (node.text is "value") or isConstant or isOwned or (node.Kind is "Index")
IsOwnedList(node SyntaxNode, block CodeBlock) Boolean
	Positioning.IsOwnedList(Indexing.Positioned, CodeBlock.Empty.Declare("t", "Trigger")) is true
	let type = values.TypeOf(node.children(0), block)
	let isMethod = Indexing(values.inference.types).IsIndexed(type, node.text, node.children.Length - 1)
	values.target.IsMember(type, node.text) or isMethod
IsConstantList(node SyntaxNode) Boolean
	Primed.IsConstantList(PrimeCall) is true
	let member = SyntaxNode("Member", node.text, node.children(0))
	ConstantFolding(values.target.TypeName, values.inference).Folded(member).Kind is "List"
IsIndexedCall(node SyntaxNode, block CodeBlock) Boolean
	OwnA.IsIndexedCall(SyntaxNode("Call", "limits", One), CodeBlock.Empty) is true
	OwnA.IsIndexedCall(SyntaxNode("Call", "A", One), CodeBlock.Empty) is true
	MemberA.IsIndexedCall(SyntaxNode("Call", "A", One), CodeBlock.Empty) is false
	let isOwnMember = values.target.IsMember(values.target.TypeName, node.text)
	let isConstant = values.methods.TypeOf(node.text) is not "" and (values.target.Header(node.text).tokens.Length is 0)
	let isNamed = block.scope.TypeOf(node.text) is not "" or isOwnMember or isConstant
	let isIndexed = (node.children.Length is 1) and isNamed or (node.children.Length is 2) and isOwnMember
	isIndexed and (isConstant or values.inference.types.IsKnown(node.text) is false)
Indexed(node SyntaxNode, block CodeBlock) CodeBlock
	Plain.Indexed(SyntaxNode("Call", "text", One), CodeBlock.Empty).instructions.Last.kind is InstructionType.IndexCall
	Plain.Indexed(SyntaxNode("Call", "failed", One), Failed).instructions.Last.kind is InstructionType.Invoke
	Plain.Indexed(SyntaxNode("Call", "named", One), Named).instructions.Last.kind is InstructionType.Invoke
	let isCall = node.Kind is "Call"
	let named = Source(node)
	if values.TypeOf(named, block).StartsWith("Dictionary(")
		return ErrorCodegen(values).Handled(SyntaxNode("MethodCall", "get", (named, node.children.Last)), block)
	let isError = isCall and (block.scope.TypeOf(node.text) is "Error")
	isError then WithValue(node, block) else Element(node, block)
Keyed(statement SyntaxNode, block CodeBlock) SyntaxNode
	Plain.Keyed(KeyedWrite, Named) to Text is "named = named.set(\"a\", 1)"
	Plain.Keyed(Computed.children(0), Named) is Computed.children(0)
	let target = statement.Kind is "Reassignment" then statement.children(0) else One
	let named = SyntaxNode("Identifier", target.text)
	if (target.Kind is not "Call") or (values.TypeOf(named, block).StartsWith("Dictionary(") is false)
		return statement
	let set = SyntaxNode("MethodCall", "set", (named, target.children.Last, statement.children(1)))
	SyntaxNode("Reassignment", statement.text, (named, set), statement.line)
WithValue(node SyntaxNode, block CodeBlock) CodeBlock
	Plain.WithValue(SyntaxNode("Call", "failed", One), Failed).instructions(0).texts is ("failed")
	Plain.WithValue(SyntaxNode("Call", "failed", One), Failed).instructions.Last.texts.Last is "Value"
	let error = values.Expression(SyntaxNode("Identifier", node.text), block)
	let wrapped = values.Expression(node.children(0), error)
	constant signature = ("Strict/ErrorWithValue", "from", "Strict/ErrorWithValue", "Error", "Value")
	wrapped.Load(InstructionEntry.Invoke(wrapped.register, signature, (error.Result, wrapped.Result), -1))
Element(node SyntaxNode, block CodeBlock) CodeBlock
	Plain.Element(SyntaxNode("MethodCall", "text", (ValueCodegen.NewGreeter, One)), CodeBlock.Empty).nextId is 1
	let named = ConstantFolding(values.target.TypeName, values.inference).Folded(SyntaxNode("Identifier", node.text))
	let isComputed = (named.Kind is not "Identifier") and (named.IsLiteral is false)
	let isNamed = (node.Kind is "Call") and (isComputed is false)
	let name = isNamed then node.text else "list" + block.nextId
	let source = node.Kind is "Call" then named else Source(node)
	let list = isNamed then ErrorScope(values).Guarded(node.text, block) else values.Expression(source, block)
	let stored = isNamed then list else list.Stored(name).WithNextId
	let index = values.Expression(GridIndex(node), stored)
	index.Load(InstructionEntry(InstructionType.IndexCall, List(Text) + name, (index.register, index.Result, -1)))
Source(node SyntaxNode) SyntaxNode
	Plain.Source(SyntaxNode("Index", "", (ValueCodegen.Ones, One))) is ValueCodegen.Ones
	Plain.Source(SyntaxNode("Call", "text", One)).Kind is "Identifier"
	if node.Kind is "Index"
		return node.children(0)
	node.Kind is "Call" then SyntaxNode("Identifier", node.text) else SyntaxNode("Member", node.text, node.children(0))
GridIndex(node SyntaxNode) SyntaxNode
	Plain.GridIndex(SyntaxNode("MethodCall", "a", (NoNode, One))).text is "1"
	Plain.GridIndex(SyntaxNode("MethodCall", "a", (NoNode, One, Hi))) to Text is "1 + x.Size.Width * \"Hi\""
	Plain.GridIndex(SyntaxNode("Call", "a", (One, NoNode))) to Text is "1 + Size.Width * x"
	let first = node.Kind is "Call" then 0 else 1
	if node.children.Length - first < 2
		return node.children.Last
	let size = first is 0 then SyntaxNode("Identifier", "Size") else SyntaxNode("Member", "Size", node.children(0))
	let width = SyntaxNode("Member", "Width", size)
	SyntaxNode("Binary", "+", (node.children(first), SyntaxNode("Binary", "*", (width, node.children(first + 1)))))
Unnested(body SyntaxNode) SyntaxNode
	Plain.Unnested(Computed).children.Length is 2
	Plain.Unnested(Computed).children.Last to Text is "values(elementIndex2) = 5"
	mutable statements = List(Mutable(SyntaxNode))
	for body.children
		statements = statements + Split(value.HasBody then Nested(value) else value)
	SyntaxNode("Body", body.text, statements, body.line)
Nested(statement SyntaxNode) SyntaxNode
	Plain.Nested(Looped.children(0)).children.Last.children.Length is 2
	mutable children = List(Mutable(SyntaxNode))
	for statement.children
		children.Add(index is statement.children.Length - 1 then Unnested(value) else value)
	SyntaxNode(statement.Kind, statement.text, children, statement.line)
Split(statement SyntaxNode) SyntaxNodes
	Plain.Split(Computed.children(0)).First to Text is "let elementIndex2 = index + 1"
	Plain.Split(SyntaxNode("Number", "1")).Length is 1
	let target = statement.Kind is "Reassignment" then statement.children(0) else One
	let isCall = (target.Kind is in ("Call", "MethodCall")) and (target.children.Length > 0)
	if (isCall is false) or (GridIndex(target).Kind is in ("Identifier", "Number"))
		return List(SyntaxNode) + statement
	let name = "elementIndex" + statement.line
	let declaration = SyntaxNode("Declaration", "let " + name, GridIndex(target), statement.line)
	let instance = target.Kind is "MethodCall" then List(SyntaxNode) + target.children(0) else List(SyntaxNode)
	let element = SyntaxNode(target.Kind, target.text, instance + SyntaxNode("Identifier", name))
	(declaration, SyntaxNode("Reassignment", statement.text, (element, statement.children(1)), statement.line))
