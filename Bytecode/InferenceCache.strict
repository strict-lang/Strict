has entries List(KeptInference)
has Result KeptInference = KeptInference.Empty
constant Limit = 8
constant None = InferenceCache(List(KeptInference))
constant Logged = None.Of(KeptInference.Pair, "Logger.strict")
constant Texted = KeptInference.Writer + "Text.strict"
constant Written = Logged.Of(Texted, "Text.strict")
Of(files Texts, path Text) InferenceCache
	Logged.entries.Length is 1 and Logged.Result.joined is ResolveCheck.Inference(KeptInference.Pair)
	Written.entries.Length is 1 and Written.Of(KeptInference.Pair, "Logger.strict").entries.Length is 2
	None.Of(KeptInference.Pair, "TextWriter.strict").entries.Length is 1
	let joined = Fitting(files, path).Of(files, path)
	if joined.folder is ""
		return InferenceCache(entries, joined)
	let others = Others(files, path)
	let kept = others.Slice(0, others.Length < Limit then others.Length else Limit - 1)
	InferenceCache(List(KeptInference) + joined + kept, joined)
Fitting(files Texts, path Text) KeptInference
	Logged.Fitting(KeptInference.Pair, "Logger.strict").base.files is KeptInference.Writer
	Logged.Fitting(KeptInference.Pair, "Text.strict").folder is ""
	for entries
		if value.Matches(files, path)
			return value
	KeptInference.Empty
Others(files Texts, path Text) List(KeptInference)
	Logged.Others(KeptInference.Pair, "Logger.strict").Length is 0
	Logged.Others(KeptInference.Pair, "Text.strict").Length is 1
	for entries
		if value.Matches(files, path) is false
			value
