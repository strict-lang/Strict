has callee MethodEntry
has call InstructionEntry
has base Number
has member Text
has kept Texts
has fields Texts = List(Text)
has scratch Number = -1
constant Sample = InlineSplice(Inliner.First, Inliner.Calling.instructions(1), 2, "elements", List(Text))
constant Jumps = (InstructionType.JumpToIdIfFalse, InstructionType.JumpToIdIfTrue, InstructionType.JumpEnd)
constant Squaring = InlineSplice(StructLanes.Squared, StructLanes.Calling(4), 5, "", List(Text), ("real", "imaginary"), 18)
Spliced List(InstructionEntry)
	Sample.Spliced.Length is 3
	Sample.Spliced(2).texts.First is "inline2_elements"
	let returned = callee.instructions.Last.payload(0) + base
	mutable result = Prologue
	for callee.instructions
		if index < callee.instructions.Length - (IsChecked then 2 else 1)
			result = result + Moved(value, returned)
	result
Prefix Text
	Sample.Prefix is "inline2_"
	"inline" + base + "_"
Prologue List(InstructionEntry)
	Sample.Prologue.Length is 1
	Sample.Prologue.First.texts.First is "inline2_elements"
	let reads = LoadReuse(List(InstructionEntry)).InvokeReads(call)
	mutable lines = List(Mutable(InstructionEntry))
	for callee.parameters
		lines.Add(Stored(call.payload(reads(index)), value.Name))
	if member is ""
		return lines + Fielded(reads)
	let instance = call.payload(reads.Last)
	IsValued then lines + (Stored(instance, member), Stored(instance, "value")) else lines + Stored(instance, member)
Moved(entry InstructionEntry, returned Number) InstructionEntry
	Sample.Moved(Inliner.First.instructions(1), 3).payload is (1, 2, -1)
	Sample.Moved(Inliner.First.instructions(1), 3).line is Inliner.Calling.instructions(1).line
	Sample.Moved(InstructionEntry.Jump(InstructionType.JumpEnd, 2), 3).payload is (186, 23)
	let rebased = LoadReuse(List(InstructionEntry)).Rebased(entry, base)
	let isNamed = (entry.kind is in Inliner.Renamed) and (entry.texts.First is not in kept)
	let texts = isNamed then List(Text) + (Prefix + entry.texts.First) else entry.texts
	let payload = entry.kind is in Jumps then Jumped(entry) else Registered(rebased, returned, call.payload(0))
	InstructionEntry(entry.kind, texts, payload, call.line)
Registered(entry InstructionEntry, source Number, target Number) Numbers
	Sample.Registered(InstructionEntry.Return(5), 5, 9) is (9)
	let reuse = LoadReuse(List(InstructionEntry))
	let positions = reuse.ReadPositions(entry) + reuse.WritePosition(entry)
	for entry.payload
		(index is in positions) and (value is source) then target else value
IsChecked Boolean
	Sample.IsChecked
	let instructions = callee.instructions
	let last = instructions.Length > 1 then instructions(instructions.Length - 2) else instructions.Last
	(last.kind is InstructionType.CheckError) and (last.payload(0) is instructions.Last.payload(0))
Stored(register Number, name Text) InstructionEntry
	Sample.Stored(4, "a").line is Inliner.Calling.instructions(1).line
	InstructionEntry(Inliner.Store, List(Text) + (Prefix + name), (register, -1), call.line)
IsValued Boolean
	Sample.IsValued is false
	for callee.instructions
		if (value.kind is InstructionType.LoadVariableToRegister) and (value.texts.First is "value")
			return true
	false
Fielded(reads Numbers) List(InstructionEntry)
	Squaring.Fielded((7)).Length is 4
	Squaring.Fielded((7))(3).texts is ("inline5_imaginary")
	Squaring.Spliced(4).texts is ("inline5_real")
	Squaring.Spliced(5).payload is (3, 5, 5, 7)
	Sample.Fielded((7)).Length is 0
	if fields.Length is 0
		return List(InstructionEntry)
	mutable lines = List(Mutable(InstructionEntry))
	for fields
		lines = lines + (Field(value, call.payload(reads.Last)), Stored(scratch, value))
	lines
Field(name Text, instance Number) InstructionEntry
	Squaring.Field("imaginary", 2).texts is ("imaginary", "Pair")
	Squaring.Field("imaginary", 2).payload is (18, 2, -1, -2)
	let owner = TypeEntry.ShortName(call.texts(0))
	InstructionEntry(InstructionType.FieldLoad, (name, owner), (scratch, instance, -1, -2), call.line)
Jumped(entry InstructionEntry) Numbers
	Sample.Jumped(InstructionEntry.Jump(InstructionType.JumpEnd, 300)) is (228, 25)
	mutable id = 0
	mutable scale = 1
	for entry.payload
		id = id + (value % 128) * scale
		scale = scale * 128
	InstructionEntry.Jump(entry.kind, id + (base + 1) * 1000).payload
