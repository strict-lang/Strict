has types List(TypeEntry)
has isSplitting Boolean = false
constant MadeError = InstructionEntry.Invoke(0, ("Strict/Error", "from", "Strict/Error"), List(Number), -1)
constant ReadTested = InstructionEntry.Named(InstructionType.LoadVariableToRegister, 0, ErrorCodegen.Tested)
constant Renamed = (InstructionType.LoadVariableToRegister, InstructionType.StoreRegisterToVariable, InstructionType.IndexCall)
constant Arithmetic = (InstructionType.Add, InstructionType.Subtract, InstructionType.Multiply, InstructionType.Divide, InstructionType.Modulo, InstructionType.Power)
constant Comparisons = (InstructionType.Equal, InstructionType.NotEqual, InstructionType.LessThan, InstructionType.GreaterThan)
constant Kinds = (InstructionType.LoadConstantToRegister) + Renamed + Arithmetic + Comparisons + (InstructionType.Invoke, InstructionType.CheckError, InstructionType.Return)
constant Elements = MemberEntry("elements", "Strict/List(Number)", List(InstructionEntry), false)
constant CheckedReturn = (InstructionEntry(InstructionType.CheckError, List(Text), List(Number) + 1), InstructionEntry.Return(1))
constant First = MethodEntry("X", List(MemberEntry), "Strict/Number", (InstructionEntry.LoadNumber(0, 0), InstructionEntry(InstructionType.IndexCall, "elements", (1, 0, -1))) + CheckedReturn)
constant Listed = TypeEntry("Strict/List(Number)", List(MemberEntry) + Elements, List(MethodEntry) + First)
constant NumbersMember = MemberEntry("numbers", "Strict/List(Number)", List(InstructionEntry), false)
constant CallingX = (InstructionEntry.Named(InstructionType.LoadVariableToRegister, 0, "numbers"), InstructionEntry.Invoke(1, ("Strict/List(Number)", "X", "Strict/Number"), List(Number), 0)) + CheckedReturn
constant Calling = MethodEntry("Run", List(MemberEntry) + NumbersMember, "Strict/Number", CallingX)
constant Caller = TypeEntry("Strict/Caller", List(MemberEntry), List(MethodEntry) + Calling)
constant Sample = Inliner((Caller, Listed))
constant Mutated = "Strict/List(Mutable(Text))"
constant Unprefixed = Inliner((TypeEntry("Caller", List(MemberEntry), List(MethodEntry)), TypeEntry(Mutated, List(MemberEntry), List(MethodEntry))))
constant Again = MethodEntry("Again", List(MemberEntry), "None", List(InstructionEntry) + InstructionEntry.Invoke(0, ("Strict/Caller", "Run", "Strict/Number"), List(Number), -1))
constant Store = InstructionType.StoreRegisterToVariable
constant Splitting = Inliner((StructLanes.Caller, StructLanes.Pair), true)
constant Scaled = InstructionEntry.Invoke(0, ("", "*", "", "scale"), (0), 0)
constant Shifted = MemberEntry("shift", "Strict/Number", List(InstructionEntry) + InstructionEntry(InstructionType.Set, List(Text), (1, 3, 0)), false)
constant Shifting = MethodEntry("Shift", List(MemberEntry) + Shifted, "Strict/Number", First.instructions)
constant Unfilled = InstructionEntry.Invoke(1, ("Strict/Shifter", "Shift", "Strict/Number"), List(Number), -1)
constant NoMethod = MethodEntry("", List(MemberEntry), "None", List(InstructionEntry))
constant Failing = MethodEntry(StructLanes.Squared, instructions = (StructLanes.Made, StructLanes.Squared.instructions(9)) + StructLanes.Squared.instructions)
constant Failed = Inliner((StructLanes.Caller, TypeEntry(StructLanes.Pair.Name, StructLanes.Pair.members, List(MethodEntry) + Failing)), true)
Inlined List(TypeEntry)
	Calling.Name is "Run" and (Caller.Name is "Strict/Caller")
	Calling.parameters is (MemberEntry("numbers", "Strict/List(Number)", List(InstructionEntry), false))
	Calling.declaredType is "Strict/Number" and (Calling.instructions(0).texts is ("numbers"))
	Calling.instructions(1).texts is ("Strict/List(Number)", "X", "Strict/Number")
	Calling.instructions(2).payload is (1) and (First.instructions(2).payload is (1))
	First.declaredType is "Strict/Number" and (Listed.members is (Elements))
	Listed.Name is "Strict/List(Number)" and (First.instructions.Length is 4)
	Again.Name is "Again" and (Again.declaredType is "None")
	Sample.Inlined.First.methods.First.instructions.Length is 6
	for types
		TypeEntry(value.Name, value.members, Methods(value))
Methods(type TypeEntry) List(MethodEntry)
	Sample.Inlinable(Caller, Calling.instructions(1), InstructionEntry(Kinds(15), ("x"), (1))).Name is ""
	Sample.Inlinable(Caller, Calling.instructions(1), StructLanes.Calling(5)).Name is ""
	Inliner((Caller, StructLanes.Pair)).Inlinable(Caller, StructLanes.Calling(4), StructLanes.Calling(5)).Name is ""
	Splitting.Inlinable(StructLanes.Caller, StructLanes.Constructed, StructLanes.Calling(3)).Name is ""
	Sample.Expanded(Caller, Calling.instructions + Calling.instructions, 1)(9).texts.First is "inline5_elements"
	Sample.Methods(Caller).First.instructions(3).kind is InstructionType.IndexCall
	Failed.Inlinable(StructLanes.Caller, StructLanes.Calling(4), StructLanes.Calling(6)).Name is ""
	Sample.Inlinable(StructLanes.Caller, StructLanes.Calling(4), StructLanes.Calling(5)).Name is ""
	for type.methods
		MethodEntry(value.Name, value.parameters, value.declaredType, Expanded(type, value.instructions, 3), value.Slots)
Expanded(owner TypeEntry, instructions List(InstructionEntry), depth Number) List(InstructionEntry)
	Sample.Expanded(Caller, Calling.instructions, 0) is Calling.instructions
	Sample.Expanded(Caller, Calling.instructions, 1).Length is 6
	mutable result = List(Mutable(InstructionEntry))
	mutable base = LoadReuse(instructions).RegisterCount
	let isWatching = IsWatching(instructions)
	for instructions
		let next = index + 1 < instructions.Length then instructions(index + 1) else value
		let callee = depth > 0 then Inlinable(owner, value, next, isWatching) else NoMethod
		let spliced = callee.Name is "" then List(InstructionEntry) + value else Splice(owner, callee, value, base).Spliced
		base = base + Reserved(callee, value)
		result = result + spliced
	result.Length is instructions.Length then instructions else Expanded(owner, Looped(result), depth - 1)
Reserved(callee MethodEntry, call InstructionEntry) Number
	Splitting.Reserved(NoMethod, StructLanes.Calling(4)) is 0
	Inliner((Caller, StructLanes.Pair)).Reserved(First, StructLanes.Calling(4)) is 2
	Splitting.Reserved(First, Calling.instructions(1)) is 2
	Splitting.Reserved(StructLanes.Squared, StructLanes.Calling(4)) is 17
	Sample.Reserved(First, Calling.instructions(1)) is 2
	Sample.Reserved(NoMethod, Calling.instructions(1)) is 0
	if callee.Name is ""
		return 0
	let isLaned = isSplitting and (StructLanes.Members(TypeOf(call.texts(0))).Length > 0)
	LoadReuse(callee.instructions).RegisterCount + (isLaned then 1 else 0)
IsWatching(instructions List(InstructionEntry)) Boolean
	Sample.IsWatching(Calling.instructions) is false
	Sample.IsWatching(List(InstructionEntry) + MadeError)
	Sample.IsWatching(List(InstructionEntry) + ReadTested)
	Failed.Inlinable(StructLanes.Caller, StructLanes.Calling(4), StructLanes.Calling(6), false).Name is "Squared"
	for instructions
		if (value.kind is InstructionType.Invoke) and (TypeEntry.ShortName(value.texts(0)) is "Error")
			return true
		if (value.kind is InstructionType.LoadVariableToRegister) and (value.texts(0) is ErrorCodegen.Tested)
			return true
	false
Inlinable(owner TypeEntry, call InstructionEntry, next InstructionEntry, isWatching = true) MethodEntry
	Sample.Inlinable(Caller, Calling.instructions(1), Calling.instructions(2)).Name is "X"
	Sample.Inlinable(Caller, Calling.instructions(1), Calling.instructions(3)).Name is ""
	Splitting.Inlinable(StructLanes.Caller, StructLanes.Calling(4), StructLanes.Calling(6)).Name is "Squared"
	if call.kind is not InstructionType.Invoke
		return NoMethod
	let type = TypeOf(call.texts(0))
	let callee = type.Name is "" then NoMethod else Callee(type, call)
	let rules = InlineRules(callee)
	let isMatched = IsMatched(call, next)
	let isLanable = rules.IsLaned(type, call, IsReturning(callee))
	let isLaned = isSplitting and (isMatched or rules.IsUnchecked or (isWatching is false)) and isLanable
	(isMatched and rules.Fits(owner, type, call)) or isLaned then callee else NoMethod
IsMatched(call InstructionEntry, next InstructionEntry) Boolean
	Sample.IsMatched(StructLanes.Calling(4), StructLanes.Calling(5))
	Sample.IsMatched(StructLanes.Calling(4), StructLanes.Calling(6)) is false
	Failed.Inlinable(StructLanes.Caller, StructLanes.Calling(4), StructLanes.Calling(5)).Name is "Squared"
	Sample.IsMatched(ReadTested, InstructionEntry(InstructionType.CheckError, List(Text), List(Number) + 1)) is false
	Sample.IsMatched(ReadTested, InstructionEntry(InstructionType.CheckError, ("a"), List(Number) + 0)) is false
	((next.kind is InstructionType.CheckError) and (next.texts.Length is 0)) and (next.payload(0) is call.payload(0))
TypeOf(name Text) TypeEntry
	Sample.TypeOf("List(Number)").Name is "Strict/List(Number)" and (Sample.TypeOf("Caller").Name is "Strict/Caller")
	Sample.TypeOf("Strict/List(Number)").methods.Length is 1
	Sample.TypeOf("Strict/Missing").Name is "" and (Sample.TypeOf("aller").Name is "")
	(Unprefixed.TypeOf("Strict/Caller").Name is "Caller") and (Unprefixed.TypeOf(Mutated).Name is Mutated)
	let short = TypeEntry.ShortName(name)
	let qualified = "/" + short
	for types
		if (value.Name is name) or (value.Name is short) or value.Name.EndsWith(qualified)
			return value
	TypeEntry("", List(MemberEntry), List(MethodEntry))
Callee(type TypeEntry, call InstructionEntry) MethodEntry
	Sample.Callee(TypeEntry.Scaling, Scaled).parameters(0).Name is "scale"
	Sample.Callee(Listed, Calling.instructions(1)).Name is "X"
	Sample.Callee(TypeEntry("Strict/Shifter", List(MemberEntry), List(MethodEntry) + Shifting), Unfilled).Name is ""
	mutable names = List(Text)
	for call.texts
		if index > 2
			names = names + value
	let given = call.payload(5 + call.payload(3))
	let callee = type.Callee(call.texts(1), given, call.texts(2), names)
	callee.parameters.Length > given then NoMethod else callee
Splice(owner TypeEntry, callee MethodEntry, call InstructionEntry, base Number) InlineSplice
	Sample.Splice(Listed, First, InstructionEntry.Invoke(1, ("List(Number)", "", ""), List(Number), -1), 2).member is ""
	Sample.Splice(Caller, Calling, Again.instructions.First, 2).kept is ("value")
	Inliner(StructLanes.Sample.types).Splice(Caller, StructLanes.Squared, StructLanes.Calling(4), 5).fields.Length is 0
	Sample.Splice(Caller, First, Calling.instructions(1), 2).member is "elements"
	Splitting.Splice(StructLanes.Caller, StructLanes.Squared, StructLanes.Calling(4), 5).scratch is 21
	let rules = InlineRules(callee)
	let member = rules.IsOwn(call) then "" else rules.Wrapped(TypeOf(call.texts(0)))
	let kept = rules.IsOwn(call) then rules.MemberNames(owner) + "value" else List(Text)
	let type = TypeOf(call.texts(0))
	let isLaned = isSplitting and rules.IsLaned(type, call, IsReturning(callee))
	let fields = isLaned then StructLanes.Members(type) else List(Text)
	InlineSplice(callee, call, base, member, kept, fields, base + LoadReuse(callee.instructions).RegisterCount)
IsReturning(callee MethodEntry) Boolean
	Splitting.Splice(StructLanes.Caller, StructLanes.Squared, StructLanes.Calling(4), 5).fields is ("real", "imaginary")
	Splitting.Splice(Caller, First, StructLanes.Calling(4), 5).fields.Length is 0
	Sample.Splice(Caller, First, Calling.instructions(1), 2).kept.Length is 0
	Splitting.IsReturning(StructLanes.Squared)
	Splitting.IsReturning(First) is false
	StructLanes.Members(TypeOf(callee.declaredType)).Length > 0
Looped(instructions List(InstructionEntry)) List(InstructionEntry)
	Sample.Looped(Calling.instructions + MethodEntry.CountingLoop.instructions).Last.payload is (1)
	Sample.Looped(Calling.instructions) is Calling.instructions
	Sample.Looped(MethodEntry.CountingLoop.instructions) is MethodEntry.CountingLoop.instructions
	let method = MethodEntry("", List(MemberEntry), "None", instructions)
	for instructions
		value.kind is InstructionType.LoopEnd then Ended(value, index - method.LoopBeginOf(index)) else value
Ended(entry InstructionEntry, steps Number) InstructionEntry
	Sample.Ended(InstructionEntry(InstructionType.LoopEnd, List(Text), (172, 2, 200, 7)), 5).payload is (5, 200, 7)
	Sample.Ended(InstructionEntry.Jump(InstructionType.LoopEnd, 2), 5).payload is (5)
	Sample.Ended(InstructionEntry(InstructionType.LoopEnd, List(Text), (1, -1)), 5).payload is (5, -1)
	mutable rest = List(Number)
	mutable isSteps = true
	for entry.payload
		if isSteps is false
			rest = rest + value
		isSteps = isSteps and (value >= ByteEncoder.SevenBitBase)
	InstructionEntry(entry.kind, entry.texts, InstructionEntry.Jump(entry.kind, steps).payload + rest, entry.line)
