has kind Number
has texts
has payload Numbers
Names(names BinaryNames) BinaryNames
	InstructionEntry(InstructionType.Print, "Hi", (-1, 0)).Names(BinaryNames("a", "b")).names.Length is 3
	mutable result = names
	for texts
		result = result.With(value)
	result
Integers(names BinaryNames) Numbers
	InstructionEntry.Print("b").Integers(BinaryNames("a", "b")) is (45, 1, 1, 2, 1, 0)
	mutable integers = List(Number) + kind + texts.Length
	for texts
		integers = integers + names.Index(value)
	integers = integers + payload.Length
	for payload
		integers = integers + (value < 0 then -2 * value - 1 else 2 * value)
	integers
Print(text Text) InstructionEntry
	InstructionEntry.Print("b").payload is (-1, 0)
	InstructionEntry(InstructionType.Print, text, (-1, 0))
Return(register Number) InstructionEntry
	InstructionEntry.Return(3).payload is List(Number) + 3
	InstructionEntry(InstructionType.Return, List(Text), register)
PrintValue(prefix Text, register Number, isText Boolean) InstructionEntry
	InstructionEntry.PrintValue("a", 2, true).payload is (-1, 1, 2, 1)
	InstructionEntry(InstructionType.Print, prefix, (-1, 1, register, (isText then 1 else 0)))
LoadNumber(register Number, number Number) InstructionEntry
	InstructionEntry.LoadNumber(2, 7).payload is (2, 1, 7)
	InstructionEntry.LoadNumber(0, 1.5).payload is (0, 3, 0, 0, 0, 0, 0, 0, 248, 63)
	InstructionEntry(InstructionType.LoadConstantToRegister, List(Text), List(Number) + register + NumberValue(number))
NumberValue(number Number) Numbers
	InstructionEntry.NumberValue(7) is (1, 7)
	InstructionEntry.NumberValue(-1).Length is 9
	if (number is number.Floor) and number >= 0 and number < 256
		return (1, number)
	List(Number) + 3 + ByteEncoder.Empty.Double(number).bytes
Set(names Texts, content Numbers) InstructionEntry
	InstructionEntry.Set(List(Text), (1, 7)).payload is (1, 7, 0)
	InstructionEntry(InstructionType.Set, names, content + 0)
LoadText(register Number, text Text) InstructionEntry
	InstructionEntry.LoadText(1, "a").payload is (1, 4, -1)
	InstructionEntry(InstructionType.LoadConstantToRegister, text, (register, 4, -1))
LoadBoolean(register Number, condition Boolean) InstructionEntry
	InstructionEntry.LoadBoolean(1, true).payload is (1, 5, 1)
	InstructionEntry(InstructionType.LoadConstantToRegister, List(Text), (register, 5, (condition then 1 else 0)))
Named(type Number, register Number, name Text) InstructionEntry
	InstructionEntry.Named(InstructionType.StoreRegisterToVariable, 1, "a").payload is (1, -1)
	InstructionEntry(type, name, (register, -1))
Binary(type Number, registers Numbers) InstructionEntry
	InstructionEntry.Binary(InstructionType.Add, (0, 1, 2)).payload is (3, 0, 1, 2)
	InstructionEntry(type, List(Text), List(Number) + registers.Length + registers)
Jump(type Number, number Number) InstructionEntry
	InstructionEntry.Jump(InstructionType.LoopEnd, 300).payload is (172, 2)
	InstructionEntry(type, List(Text), ByteEncoder.Empty.SevenBit(number).bytes)
LoopBegin(start Number, end Number) InstructionEntry
	InstructionEntry.LoopBegin(1, -1).payload is (1, 0, 0)
	InstructionEntry.LoopBegin(0, 1).payload is (0, 1, 1, 0)
	let range = end < 0 then (0) else (1, end)
	InstructionEntry(InstructionType.LoopBegin, List(Text), List(Number) + start + range + 0)
Invoke(register Number, names Texts, arguments Numbers, instance Number) InstructionEntry
	InstructionEntry.Invoke(1, ("T", "Run", "N"), List(Number), -1).payload is (1, -1, -2, 0, -3, 0, 0)
	InstructionEntry.Invoke(2, ("T", "Add", "N", "x"), 0, 1).payload is (2, -1, -2, 1, -4, -3, 1, 0, 1, 1)
	mutable content = List(Number) + register + -1 + -2 + (names.Length - 3)
	for Range(3, names.Length)
		content = content + (-1 - value)
	content = content + -3 + arguments.Length + arguments
	InstructionEntry(InstructionType.Invoke, names, (instance < 0 then content + 0 else content + 1 + instance))