has instructions BytecodeInstructions
Count Number
	instructions.Length
IsEmpty Boolean
	InstructionList.Empty.IsEmpty is true
	instructions.Length is 0
At(index Number) BytecodeInstruction
	InstructionList.Empty.At(3).IsReturn is true
	if index < 0 or index >= instructions.Length
		return BytecodeInstruction.ReturnOp(0)
	instructions(index)
Append(instruction BytecodeInstruction) InstructionList
	InstructionList.Empty.Append(BytecodeInstruction.ReturnOp(1)).Count is 1
	InstructionList(instructions + instruction)
Prepend(instruction BytecodeInstruction) InstructionList
	InstructionList.Sample("Add", 3).Prepend(BytecodeInstruction.ReturnOp(2)).At(0).register is 2
	mutable next = List(Mutable(BytecodeInstruction))
	next.Add(instruction)
	InstructionList(next + instructions)
Skip(count Number) InstructionList
	InstructionList.Sample("Add", 3).Skip(1).At(0).amount is 3
	mutable next = List(Mutable(BytecodeInstruction))
	for instructions
		if index >= count
			next.Add(value)
	InstructionList(next)
KeepPrefix(length Number) InstructionList
	InstructionList.Sample("Add", 3).KeepPrefix(1).Count is 1
	mutable next = List(Mutable(BytecodeInstruction))
	for instructions
		if index < length
			next.Add(value)
	InstructionList(next)
Empty InstructionList
	InstructionList.Empty.Count is 0
	constant noInstructions = List(BytecodeInstruction)
	InstructionList(noInstructions)
With(typeName Text, label Text) InstructionList
	InstructionList.Empty.With("JumpEnd", "").At(0).typeName is "JumpEnd"
	Append(BytecodeInstruction(typeName, 0, 0, label))
Sample(binaryName Text, right Number) InstructionList
	InstructionList.Sample("Add", 3).Count is 3
	constant first = InstructionList.Empty.Append(BytecodeInstruction.LoadConstant(0, 5))
	first.Append(BytecodeInstruction.LoadConstant(1, right)).Append(BytecodeInstruction(binaryName, 0, 1, "2"))
to Text
	"ops=" + Count to Text