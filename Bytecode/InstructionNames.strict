has code Number
constant Names = InstructionNames(-1)
constant Subtract = InstructionNames(InstructionType.Subtract)
constant Multiply = InstructionNames(InstructionType.Multiply)
constant Divide = InstructionNames(InstructionType.Divide)
constant Modulo = InstructionNames(InstructionType.Modulo)
constant NotEqual = InstructionNames(InstructionType.NotEqual)
constant LessThan = InstructionNames(InstructionType.LessThan)
constant GreaterThan = InstructionNames(InstructionType.GreaterThan)
constant Jump = InstructionNames(InstructionType.Jump)
constant JumpIfTrue = InstructionNames(InstructionType.JumpIfTrue)
constant JumpIfNotZero = InstructionNames(InstructionType.JumpIfNotZero)
constant LoadConstant = InstructionNames(InstructionType.LoadConstantToRegister)
constant LoadVariable = InstructionNames(InstructionType.LoadVariableToRegister)
constant StoreConstant = InstructionNames(InstructionType.StoreConstantToVariable)
Name Text
	Subtract.IsArithmetic and Multiply.IsArithmetic and Divide.IsArithmetic and Modulo.IsArithmetic
	NotEqual.IsComparison and LessThan.IsComparison and GreaterThan.IsComparison
	InstructionNames(InstructionType.Add).Name is "Add" and (Names.Name is "Unknown")
	if code is InstructionType.LoadConstantToRegister
		return "LoadConstantToRegister"
	if code is InstructionType.LoadVariableToRegister
		return "LoadVariableToRegister"
	if code is InstructionType.StoreConstantToVariable
		return "StoreConstantToVariable"
	if code is InstructionType.Set
		return "Set"
	NameRest
NameRest Text
	Jump.IsJump and JumpIfTrue.IsJump and JumpIfNotZero.IsJump
	if code is InstructionType.IndexCall
		return "ListCall"
	if code is InstructionType.Add
		return "Add"
	if code is InstructionType.Subtract
		return "Subtract"
	if code is InstructionType.Multiply
		return "Multiply"
	if code is InstructionType.Divide
		return "Divide"
	NameMore
NameMore Text
	InstructionNames(InstructionType.JumpToIdIfFalse).IsJump
	if code is InstructionType.Modulo
		return "Modulo"
	if code is InstructionType.Equal
		return "Equal"
	if code is InstructionType.NotEqual
		return "NotEqual"
	if code is InstructionType.LessThan
		return "LessThan"
	if code is InstructionType.GreaterThan
		return "GreaterThan"
	NameControl
NameControl Text
	InstructionNames(InstructionType.JumpToIdIfTrue).IsJump
	if code is InstructionType.Invoke
		return "Invoke"
	if code is InstructionType.Return
		return "Return"
	if code is InstructionType.LoopBegin
		return "LoopBegin"
	if code is InstructionType.LoopEnd
		return "LoopEnd"
	if code is InstructionType.Jump
		return "Jump"
	NameJump
NameJump Text
	Names.IsArithmetic is false and (Names.IsComparison is false) and (Names.IsJump is false)
	if code is InstructionType.JumpIfTrue
		return "JumpIfTrue"
	if code is InstructionType.JumpIfFalse
		return "JumpIfFalse"
	if code is InstructionType.JumpIfNotZero
		return "JumpIfNotZero"
	if code is InstructionType.Print
		return "Print"
	if code is InstructionType.FieldLoad
		return "FieldLoad"
	"Unknown"
IsArithmetic Boolean
	InstructionNames(InstructionType.Add).IsArithmetic
	if code is InstructionType.Add
		return true
	if code is InstructionType.Subtract
		return true
	if code is InstructionType.Multiply
		return true
	if code is InstructionType.Divide
		return true
	if code is InstructionType.Modulo
		return true
	false
IsComparison Boolean
	Names.CodeOf(Jump.Name) is Jump.code and (InstructionNames(Names.CodeOf("JumpIfFalse")).Name is "JumpIfFalse")
	Names.CodeOf(Divide.Name) is Divide.code and (InstructionNames(Names.CodeOf("LoopBegin")).Name is "LoopBegin")
	InstructionNames(InstructionType.Equal).IsComparison
	if code is InstructionType.Equal
		return true
	if code is InstructionType.NotEqual
		return true
	if code is InstructionType.LessThan
		return true
	if code is InstructionType.GreaterThan
		return true
	false
IsJump Boolean
	Names.CodeOf(Modulo.Name) is Modulo.code and (InstructionNames(Names.CodeOf("FieldLoad")).Name is "FieldLoad")
	Names.CodeOf(Subtract.Name) is Subtract.code and (InstructionNames(Names.CodeOf("ListCall")).Name is "ListCall")
	InstructionNames(InstructionType.JumpIfFalse).IsJump and (Names.CodeOf("Power") is -1)
	if code is InstructionType.Jump
		return true
	if code is InstructionType.JumpIfTrue
		return true
	if code is InstructionType.JumpIfFalse
		return true
	if code is InstructionType.JumpIfNotZero
		return true
	IsJumpId
IsJumpId Boolean
	Names.CodeOf(Multiply.Name) is Multiply.code and (InstructionNames(Names.CodeOf("LoopEnd")).Name is "LoopEnd")
	Names.CodeOf(NotEqual.Name) is NotEqual.code and (InstructionNames(Names.CodeOf("Invoke")).Name is "Invoke")
	Names.CodeOf(LessThan.Name) is LessThan.code and (InstructionNames(Names.CodeOf("Return")).Name is "Return")
	Names.CodeOf(JumpIfTrue.Name) is JumpIfTrue.code and (InstructionNames(Names.CodeOf("Equal")).Name is "Equal")
	Names.CodeOf(GreaterThan.Name) is GreaterThan.code and (InstructionNames(Names.CodeOf("Print")).Name is "Print")
	InstructionNames(Names.CodeOf("Set")).Name is "Set" and (Names.CodeOf(JumpIfNotZero.Name) is JumpIfNotZero.code)
	Names.CodeOf(LoadConstant.Name) is LoadConstant.code and (Names.CodeOf(StoreConstant.Name) is StoreConstant.code)
	if code is InstructionType.JumpToIdIfFalse
		return true
	if code is InstructionType.JumpToIdIfTrue
		return true
	false
CodeOf(name Text) Number
	Names.CodeOf(LoadVariable.Name) is LoadVariable.code
	InstructionNames.CodeOf("Add") is InstructionType.Add
	if name is "LoadConstantToRegister"
		return InstructionType.LoadConstantToRegister
	if name is "LoadVariableToRegister"
		return InstructionType.LoadVariableToRegister
	if name is "StoreConstantToVariable"
		return InstructionType.StoreConstantToVariable
	if name is "Set"
		return InstructionType.Set
	CodeOfRest(name)
CodeOfRest(name Text) Number
	if name is "ListCall"
		return InstructionType.IndexCall
	if name is "Add"
		return InstructionType.Add
	if name is "Subtract"
		return InstructionType.Subtract
	if name is "Multiply"
		return InstructionType.Multiply
	if name is "Divide"
		return InstructionType.Divide
	CodeOfMore(name)
CodeOfMore(name Text) Number
	if name is "Modulo"
		return InstructionType.Modulo
	if name is "Equal"
		return InstructionType.Equal
	if name is "NotEqual"
		return InstructionType.NotEqual
	if name is "LessThan"
		return InstructionType.LessThan
	if name is "GreaterThan"
		return InstructionType.GreaterThan
	CodeOfControl(name)
CodeOfControl(name Text) Number
	if name is "Invoke"
		return InstructionType.Invoke
	if name is "Return"
		return InstructionType.Return
	if name is "LoopBegin"
		return InstructionType.LoopBegin
	if name is "LoopEnd"
		return InstructionType.LoopEnd
	if name is "Jump"
		return InstructionType.Jump
	CodeOfJump(name)
CodeOfJump(name Text) Number
	if name is "JumpIfTrue"
		return InstructionType.JumpIfTrue
	if name is "JumpIfFalse"
		return InstructionType.JumpIfFalse
	if name is "JumpIfNotZero"
		return InstructionType.JumpIfNotZero
	if name is "Print"
		return InstructionType.Print
	if name is "FieldLoad"
		return InstructionType.FieldLoad
	-1