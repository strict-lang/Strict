has typeName Text
has register Number
has amount Number
has label Text
Format Text
	if typeName is "Set"
		return FormatSet
	if typeName is "LoadConstantToRegister"
		return FormatLoadConst
	typeName is "LoadVariableToRegister" then FormatLoadVar else FormatRest
FormatSet Text
	"Set " + Register.NameOf(register) + " " + amount to Text
FormatLoadConst Text
	"LoadConstant " + Register.NameOf(register) + " " + amount to Text
FormatLoadVar Text
	"LoadVariable " + label + " " + Register.NameOf(register)
FormatRest Text
	if typeName is "StoreConstantToVariable"
		return "StoreConstant " + label + " " + amount to Text
	if typeName is "StoreRegisterToVariable"
		return FormatStoreReg
	typeName is "Return" then FormatReturn else typeName is "Print" then "Print " + label else FormatBinary
FormatStoreReg Text
	"StoreRegister " + Register.NameOf(register) + " " + label
FormatReturn Text
	"Return " + Register.NameOf(register)
FormatBinary Text
	if typeName is "Add"
		return typeName + " " + ThreeRegs
	if typeName is "Subtract"
		return typeName + " " + ThreeRegs
	if typeName is "Multiply"
		return typeName + " " + ThreeRegs
	typeName is "Divide" then typeName + " " + ThreeRegs else FormatMore
FormatMore Text
	if typeName is "Modulo"
		return typeName + " " + ThreeRegs
	if typeName is "Equal"
		return typeName + " " + ThreeRegs
	if typeName is "NotEqual"
		return typeName + " " + ThreeRegs
	typeName is "Invoke" then "Invoke " + label else typeName + " " + amount to Text
ThreeRegs Text
	Register.NameOf(register) + " " + Register.NameOf(amount) + " " + label