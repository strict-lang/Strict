has folder Text
has base Inferring
has stamps Numbers
has raw TypeInference
has refined TypeInference
has mentioned Texts
has joined TypeInference
has tested Text = ""
has signature Text = ""
constant Nothing = ResolveCheck.Counting
constant Empty = KeptInference("", Inferring.None, List(Number), Nothing, Nothing, List(Text), Nothing)
constant Pair = ("Logger.strict", "TextWriter.strict")
constant Swapped = ("TextWriter.strict", "Logger.strict")
constant Writer = List(Text) + "TextWriter.strict"
constant Loggers = Empty.Of(Pair, "Logger.strict")
constant One = List(Scope) + KnownTypes.NoMembers
constant Counted = TypeInference(KnownTypes(List(Text) + "TextWriter", List(Scope) + KnownTypes.CountMembers, One, One), One)
constant Writing = Empty.Of(Pair, "TextWriter.strict")
constant Reading = ("mutable n Number", "Go Number", "\tn")
constant Doctored = KeptInference(Loggers, raw = Counted, refined = Counted)
Of(files Texts, path Text) KeptInference
	Loggers.joined is ResolveCheck.Inference(Pair) and Loggers.base.files is Writer
	Loggers.Of(Swapped, "Logger.strict").joined is ResolveCheck.Inference(Swapped)
	Doctored.Of(Pair, "Logger.strict").joined.types.members(1) is KnownTypes.CountMembers
	Empty.Of(Pair, "TextWriter.strict").joined is ResolveCheck.Inference(Pair)
	Writing.tested is "TextWriter.strict" and Writing.Of(Pair, "TextWriter.strict").joined is ResolveCheck.Inference(Pair)
	at = files.Index(path)
	if at >= 0 and IsCurrent(files, path)
		return Replaced(files, at)
	rest = Rest(files, path)
	isKept = IsKept(rest)
	names = isKept then mentioned else Mentioned(rest)
	name = ResolveCheck.TypeName(path)
	if at < 0 or name is in names or name + "s" is in names
		return at < 0 then KeptInference(value, joined = ResolveCheck.Inference(files)) else Mentioned(files, at)
	(isKept then value else Fresh(rest, names)).Joined(files, at)
Matches(files Texts, path Text) Boolean
	Writing.Matches(Pair, "TextWriter.strict") and Writing.Matches(Pair, "Logger.strict") is false
	Fits(Rest(files, path)) or tested is path and base.files is files
IsCurrent(files Texts, path Text) Boolean
	Writing.IsCurrent(Pair, "TextWriter.strict") and Loggers.IsCurrent(Pair, "Logger.strict") is false
	KeptInference(Writing, signature = "x").IsCurrent(Pair, "TextWriter.strict") is false
	if tested is not path or base.files is not files or folder is not Directory.Current
		return false
	Stamps(Rest(files, path)) is stamps and Signature(ResolveCheck.Shapes(List(Text) + path).First.lines) is signature
Signature(lines Texts) Text
	Empty.Signature(("Run", "\t1")) is Empty.Signature(("Run", "\t2"))
	Empty.Signature(("has items Generics", "Run", "\t1")) is not Empty.Signature(("has items Numbers", "Run", "\t1"))
	Empty.Signature(Reading) is not Empty.Signature(("mutable n Number", "Go Number", "\tn = 1"))
	marks = Changes(lines).Methods + "|" + Changes(lines, true).Methods
	Text.Combine(Unindented(lines) + marks, "\n")
Unindented(lines Texts) Texts
	Empty.Unindented(("Run", "\t1")) is ("Run")
	for lines
		if value.StartsWith("\t") is false
			value
Mentioned(files Texts, at Number) KeptInference
	Writing.base.files is Pair and Writing.stamps.Length is 1
	shapes = BuildProfile.Shapes(files)
	inferring = Inferring(files, shapes, ResolveCheck.Generics(files, shapes))
	inferred = inferring.Raw
	typed = inferring.Refined(inferred)
	stamped = Stamps(Rest(files, files(at)))
	signed = Signature(shapes(at).lines)
	KeptInference(Directory.Current, inferring, stamped, inferred, typed, mentioned, typed, files(at), signed)
Replaced(files Texts, at Number) KeptInference
	Writing.Replaced(Pair, 1).joined is ResolveCheck.Inference(Pair)
	shape = ResolveCheck.Shapes(List(Text) + files(at)).First
	shapes = base.shapes.Slice(0, at) + shape + base.shapes.Slice(at + 1, base.shapes.Length - at - 1)
	indexed = TypeInference(KnownTypes(raw.types, positions = ResolveCheck.Positions(raw.types.names)), raw.constants)
	typed = Inferring(files, shapes, base.templates).Typed(indexed, at)
	methods = refined.types.methods.Slice(0, at) + typed + refined.types.methods.Slice(at + 1, files.Length - at - 1)
	KeptInference(value, joined = TypeInference(KnownTypes(refined.types, methods = methods), refined.constants))
IsKept(rest Texts) Boolean
	Loggers.IsKept(Writer) and Empty.IsKept(List(Text)) is false
	Loggers.IsKept(List(Text) + "Text.strict") is false
	KeptInference(Loggers, stamps = List(Number) + 1).IsKept(Writer) is false
	Fits(rest) then Stamps(rest) is stamps else false
Fits(rest Texts) Boolean
	Loggers.Fits(Writer) and Loggers.Fits(Pair) is false and Empty.Fits(List(Text)) is false
	folder is Directory.Current and rest is base.files
Rest(files Texts, path Text) Texts
	Empty.Rest(Pair, "Logger.strict") is Writer and Empty.Rest(Pair, "Text.strict") is Pair
	at = files.Index(path)
	at < 0 then files else files.Slice(0, at) + files.Slice(at + 1, files.Length - at - 1)
Stamps(sources Texts) Numbers
	Empty.Stamps(List(Text) + "Missing.strict") is (0)
	for sources
		File(value).Modified
Mentioned(sources Texts) Texts
	Empty.Mentioned(Pair).Slice(0, 3) is ("Logger", "TextWriter", "TextWriter")
	"Logger" is not in Empty.Mentioned(Writer)
	mutable names = ResolveCheck.TypeNames(sources)
	for sources
		names = names + SourceFiles(".").Mentioned(value)
	names
Fresh(rest Texts, names Texts) KeptInference
	Empty.Fresh(Writer, List(Text)).refined is ResolveCheck.Inference(Writer)
	Empty.Fresh(Writer, List(Text)).IsKept(Writer)
	current = Stamps(rest)
	shapes = BuildProfile.Shapes(rest)
	inferring = Inferring(rest, shapes, ResolveCheck.Generics(rest, shapes))
	inferred = inferring.Raw
	KeptInference(Directory.Current, inferring, current, inferred, inferring.Refined(inferred), names, inferred)
Joined(files Texts, at Number) KeptInference
	Loggers.Joined(Swapped, 1).joined.types.names is ("TextWriter", "Logger")
	shape = ResolveCheck.Shapes(List(Text) + files(at)).First
	name = ResolveCheck.TypeName(files(at))
	templates = shape.UsesGenerics then base.templates + name else base.templates
	leaf = Inferring(List(Text) + files(at), List(TypeShape) + shape, templates).Raw
	shapes = base.shapes.Slice(0, at) + shape + base.shapes.Slice(at, base.shapes.Length - at)
	indexed = Whole(raw, leaf, at, files)
	typed = Inferring(files, shapes, templates).Typed(indexed, at)
	own = leaf.types
	overloaded = ResolveCheck.OverloadedMembers(indexed.types, shapes, own.members.First.types, own.parameters.First)
	renewed = KnownTypes(own, methods = List(Scope) + typed, parameters = List(Scope) + overloaded)
	KeptInference(value, joined = Whole(refined, TypeInference(renewed, leaf.constants), at, files))
Whole(kept TypeInference, leaf TypeInference, at Number, files Texts) TypeInference
	Loggers.Whole(Counted, Counted, 1, Pair).types.Index("TextWriter") is 1
	names = ResolveCheck.TypeNames(files)
	members = Among(kept.types.members, at, leaf.types.members)
	methods = Among(kept.types.methods, at, leaf.types.methods)
	parameters = Among(kept.types.parameters, at, leaf.types.parameters)
	types = KnownTypes(names, members, methods, parameters, ResolveCheck.Positions(names))
	TypeInference(types, Among(kept.constants, at, leaf.constants))
Among(scopes Scopes, at Number, added Scopes) Scopes
	Empty.Among(KnownTypes.NoMemberPair, 1, List(Scope) + KnownTypes.CountMembers)(1) is KnownTypes.CountMembers
	Empty.Among(KnownTypes.NoMemberPair, 1, List(Scope) + KnownTypes.CountMembers).Length is 3
	scopes.Slice(0, at) + added + scopes.Slice(at, scopes.Length - at)
