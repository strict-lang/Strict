has types List(TypeEntry)
constant Offset = MemberEntry("offset", "Strict/Pair", List(InstructionEntry), false, 32)
constant Counted = MemberEntry("count", "Strict/Number", List(InstructionEntry) + InstructionEntry.Set(List(Text), (1, 7)), false)
constant OffsetReal = (InstructionEntry.Named(InstructionType.LoadVariableToRegister, 0, "offset"), InstructionEntry(InstructionType.FieldLoad, ("real", "Pair"), (1, 0, -1, -2)), InstructionEntry.Return(1))
constant Shifting = MethodEntry("Shifted", (Offset, Counted), "Strict/Number", OffsetReal)
constant Drawer = TypeEntry("Strict/Drawer", (Offset, Counted), List(MethodEntry) + Shifting)
constant Shift = InstructionEntry.Invoke(5, ("Strict/Drawer", "Shifted", "Strict/Number", "offset", "count"), (4, 3), -1)
constant Defaulted = InstructionEntry.Invoke(5, ("Strict/Drawer", "Shifted", "Strict/Number", "offset", "count"), List(Number) + 4, 2)
constant Made = InstructionEntry.Invoke(6, ("Strict/Drawer", "from", "Strict/Drawer", "offset", "count"), (4, 3), -1)
constant Offsets = InstructionEntry(InstructionType.FieldLoad, ("offset", "Drawer"), (3, 2, -1, -2))
constant Sample = LaneCalls((StructLanes.Pair, Drawer))
constant Shifts = List(Text) + "offset Pair"
constant Sizing = LaneCalls(List(TypeEntry) + StructLanes.Sized)
constant Sized = MemberEntry("Size", "Strict/Size", List(InstructionEntry), false)
constant Looped = TypeEntry("Looped", List(MemberEntry) + MemberEntry("sample", "Strict/Examples/Looped", List(InstructionEntry), false), List(MethodEntry))
constant Twin = TypeEntry("Strict/Pair", StructLanes.Pair.members, List(MethodEntry) + Shifting)
constant Stub = TypeEntry("Strict/Drawer", Drawer.members, List(MethodEntry) + MethodEntry("Shifted", (Offset, Counted), "Strict/Number", List(InstructionEntry)))
constant Paired = InstructionEntry.Invoke(5, ("Strict/Pair", "Shifted", "Strict/Number", "offset", "count"), (4, 3), -1)
constant Swapped = InstructionEntry.Invoke(5, ("Strict/Drawer", "Shifted", "Strict/Number", "count", "offset"), (4, 3), -1)
constant Doubled = InstructionEntry.Invoke(5, ("Strict/Drawer", "Shifted", "Strict/Number", "offset", "offset"), (4, 3), -1)
constant Changed = InstructionEntry.Named(InstructionType.StoreRegisterToVariable, 0, "changed_0")
constant BuiltFrom = InstructionEntry.Invoke(6, ("Strict/Custom", "from", "Custom", "offset", "count"), (4, 3), -1)
constant FromSplit = MethodEntry("from", (Offset, Counted), "Strict/Custom", OffsetReal)
constant FromChanged = MethodEntry("from", (Offset, Counted), "Strict/Custom", OffsetReal + Changed)
constant Custom = TypeEntry("Strict/Custom", Drawer.members, List(MethodEntry) + FromSplit)
constant Mutating = TypeEntry("Strict/Custom", Drawer.members, List(MethodEntry) + FromChanged)
Laned(members List(MemberEntry)) Texts
	Sample.Laned(Drawer.members) is ("offset Pair")
	Sample.Laned(StructLanes.Pair.members).Length is 0
	LaneCalls((Twin, Drawer)).Signature(Paired).Length is 0
	LaneCalls((StructLanes.Pair, Stub)).Signature(Shift).Length is 0
	Sample.Signature(Offsets).Length is 0
	LaneCalls((StructLanes.Pair, Stub)).Signature(Made) is ("offset Pair")
	LaneCalls((Twin, Drawer)).Signature(Shift) is ("offset Pair")
	for members
		if Lanes(value).Length > 0
			value.Name + " " + TypeEntry.ShortName(value.typeName)
Lanes(member MemberEntry) Texts
	Sample.Lanes(Offset) is ("real", "imaginary")
	Sample.Lanes(Counted).Length is 0
	Sample.Lanes(MemberEntry("seed", "Strict/Pair", List(InstructionEntry) + StructLanes.Constructed, false)).Length is 0
	Sample.Lanes(MemberEntry("zero", "Strict/Pair", List(InstructionEntry), true)).Length is 0
	isFixed = member.IsConstant or member.initial.Length > 0 or StructLanes.IsLane(member)
	if isFixed or LaneNesting.IsPlainType(member.typeName)
		return List(Text)
	StructLanes(types).Members(Inliner(types).TypeOf(member.typeName))
Divided(members List(MemberEntry)) List(MemberEntry)
	Sample.Divided(Drawer.members).Length is 3
	Sample.Divided(Drawer.members)(1).Name is "offset_imaginary"
	Sample.Divided(Drawer.members)(1).Bits is 32
	mutable result = List(MemberEntry)
	for members
		member = value
		lanes = Lanes(member)
		result = lanes.Length is 0 then result + member else result + Split(member, lanes)
	result
Split(member MemberEntry, lanes Texts) List(MemberEntry)
	Sample.Split(Offset, ("real", "imaginary")).First.Name is "offset_real"
	Sample.Split(Offset, ("real", "imaginary")).First.typeName is "Strict/Number"
	Sizing.Split(Sized, ("Width", "Height")).Last.Bits is 32
	bits = member.Bits > 0 then member.Bits else LeafBits(Inliner(types).TypeOf(member.typeName))
	for lanes
		MemberEntry(StructLanes.Lane(member.Name, value), "Strict/Number", List(InstructionEntry), false, bits)
Signature(call InstructionEntry) Texts
	Sample.Signature(Shift) is ("offset Pair")
	Sample.Signature(Made) is ("offset Pair")
	Sample.Signature(StructLanes.Constructed).Length + Sample.Signature(StructLanes.Calling(4)).Length is 0
	LaneCalls((StructLanes.Pair, Mutating)).Signature(BuiltFrom).Length is 0
	LaneCalls((StructLanes.Pair, Custom)).Signature(BuiltFrom) is ("offset Pair")
	if call.kind is not InstructionType.Invoke
		return List(Text)
	type = Inliner(types).TypeOf(call.texts(0))
	if call.texts(1) is "from" and Inliner(types).Declared(type, call).instructions.Length is 0
		return StructLanes(types).Members(type).Length > 0 then List(Text) else Laned(type.members)
	LaneNesting(types).MethodSignature(type, call)
Width(call InstructionEntry, position Number, signature Texts) Number
	Sample.Width(Shift, 0, Shifts) is 2
	Sample.Width(Shift, 1, Shifts) is 0
	Sample.Width(Swapped, 1, Shifts) is 2
	type = LaneFlow(types).Typed(signature, call.texts(3 + position))
	type is "" then 0 else StructLanes(types).Members(Inliner(types).TypeOf(type)).Length
Called(call InstructionEntry, laned Texts, base Number, signature Texts) List(InstructionEntry)
	Sample.Called(Shift, "4 Pair", 9, Shifts).Length is 3
	Sample.Called(Shift, "4 Pair", 9, Shifts).First.texts is ("lanes4_real")
	Sample.Called(Shift, List(Text), 9, Shifts).First.texts is ("real", "Pair")
	Sample.Called(Shift, "4 Pair", 9, Shifts).Last.texts(4) is "offset_imaginary"
	Sample.Called(Shift, "4 Pair", 9, Shifts).Last.payload is (5, -1, -2, 3, -4, -5, -6, -3, 3, 9, 10, 3, 0)
	Sample.Called(Defaulted, "4 Pair", 9, Shifts).Last.payload is (5, -1, -2, 3, -4, -5, -6, -3, 2, 9, 10, 1, 2)
	reads = LoadReuse(List(InstructionEntry)).InvokeReads(call)
	instance = reads.Length > Given(call) then call.payload(reads.Last) else -1
	names = (call.texts(0), call.texts(1), call.texts(2)) + Names(call, signature)
	made = InstructionEntry.Invoke(call.payload(0), names, Registers(call, base, signature), instance)
	Loads(call, laned, base, signature) + InstructionEntry(made.kind, made.texts, made.payload, call.line)
Given(call InstructionEntry) Number
	Sample.Given(Defaulted) is 1
	Sample.Spread(StructLanes.Constructed, "Pair", 8).Length is 5
	Sample.Spread(StructLanes.Constructed, "Pair", 8)(1).texts is ("real", "Pair")
	Sample.Spread(StructLanes.Constructed, "Pair", 8)(1).payload is (8, 2, -1, -2)
	Sample.Spread(Offsets, "Pair", 8).First.payload is (8, 2, -1, -2)
	Sample.Spread(Offsets, "Pair", 8).Length is 4 and Sample.Spread(Offsets, "Pair", 8)(1).texts is ("lanes3_real")
	call.payload(5 + call.payload(3))
Names(call InstructionEntry, signature Texts) Texts
	Sample.Names(Made, Shifts) is ("offset_real", "offset_imaginary", "count")
	mutable names = List(Text)
	for Range(3, call.texts.Length)
		name = call.texts(value)
		type = LaneFlow(types).Typed(signature, name)
		names = type is "" then names + name else names + Prefixed(name, LaneNesting(types).MembersOf(type))
	names
Prefixed(name Text, lanes Texts) Texts
	Sample.Prefixed("a", ("x", "y")) is ("a_x", "a_y")
	Sample.Divided(Drawer.members).Last.Name is "count"
	for lanes
		StructLanes.Lane(name, value)
Registers(call InstructionEntry, base Number, signature Texts) Numbers
	Sample.Registers(Shift, 9, Shifts) is (9, 10, 3)
	reads = LoadReuse(List(InstructionEntry)).InvokeReads(call)
	mutable registers = List(Number)
	mutable next = base
	for Given(call)
		width = Width(call, value, signature)
		registers = width is 0 then registers + call.payload(reads(value)) else registers + Sequence(next, width)
		next = next + width
	registers
Sequence(start Number, count Number) Numbers
	Sample.Sequence(9, 2) is (9, 10)
	Sample.Registers(Doubled, 9, Shifts) is (9, 10, 11, 12)
	Sample.Loads(Doubled, List(Text), 9, Shifts).Last.payload is (12, 3, -1, -2)
	Sample.Loads(Swapped, List(Text), 9, Shifts).Length is 2
	for count
		start + index
Loads(call InstructionEntry, laned Texts, base Number, signature Texts) List(InstructionEntry)
	Sample.Loads(Shift, "4 Pair", 9, Shifts)(1).payload is (10, -1)
	Sample.Loads(Shift, List(Text), 9, Shifts)(1).payload is (10, 4, -1, -2)
	mutable lines = List(InstructionEntry)
	mutable offset = 0
	for Given(call)
		type = LaneFlow(types).Typed(signature, call.texts(3 + value))
		if type is not ""
			reg = call.payload(LoadReuse(List(InstructionEntry)).InvokeReads(call)(value))
			lines = lines + Read(reg, type, LaneFlow(types).Typed(laned, reg to Text) is not "", base + offset, call.line)
			offset = offset + Width(call, value, signature)
	lines
Read(register Number, type Text, isLaned Boolean, base Number, line Number) List(InstructionEntry)
	Sample.Read(4, "Pair", true, 9, 0)(1).texts is ("lanes4_imaginary")
	Sample.Read(4, "Pair", false, 9, 0)(1).texts is ("imaginary", "Pair")
	mutable lines = List(InstructionEntry)
	for StructLanes(types).Members(Inliner(types).TypeOf(type))
		name = StructLanes.Lane("lanes" + register, value)
		lane = StructLanes.Named(InstructionType.LoadVariableToRegister, base + index, name, line)
		lines = isLaned then lines + lane else lines + Field(register, type, value, base + index, line)
	lines
Field(register Number, type Text, name Text, target Number, line Number) List(InstructionEntry)
	Sample.Field(4, "Pair", "imaginary", 10, 0).First.texts is ("imaginary", "Pair")
	owner = Inliner(types).TypeOf(type)
	at = name.IndexOf("_")
	isDivided = types.Length > 0 and StructLanes(types).Members(owner).Length is 0
	if at < 0 or LaneNesting.Member(owner, name).Name is name or isDivided
		entry = InstructionEntry(InstructionType.FieldLoad, (name, type), (target, register, -1, -2), line)
		return List(InstructionEntry) + entry
	parent = name.Substring(0, at)
	sub = name.Substring(at + 1, name.Length - at - 1)
	subType = TypeEntry.ShortName(LaneNesting.Member(owner, parent).typeName)
	head = InstructionEntry(InstructionType.FieldLoad, (parent, type), (target, register, -1, -2), line)
	head + Field(target, subType, sub, target, line)
Spread(entry InstructionEntry, type Text, base Number) List(InstructionEntry)
	Sample.Spread(Offsets, "Pair", 8).First.texts is ("offset_real", "Drawer")
	isField = entry.kind is InstructionType.FieldLoad
	owner = TypeEntry.ShortName(type)
	sourceType = isField then entry.texts(1) else owner
	source = entry.payload(isField then 1 else 0)
	mutable lines = isField then List(InstructionEntry) else List(InstructionEntry) + entry
	for StructLanes(types).Members(Inliner(types).TypeOf(type))
		fieldName = isField then StructLanes.Lane(entry.texts(0), value) else value
		lane = StructLanes.Lane("lanes" + entry.payload(0), value)
		stored = StructLanes.Named(InstructionType.StoreRegisterToVariable, base, lane, entry.line)
		lines = lines + Field(source, sourceType, fieldName, base, entry.line) + stored
	lines
LeafBits(type TypeEntry) Number
	Sample.LeafBits(StructLanes.Pair) is 0
	LaneCalls(List(TypeEntry) + Looped).LeafBits(Looped) is 0
	if type.members.Length is 0
		return 0
	first = type.members.First
	member = Inliner(types).TypeOf(first.typeName)
	isLeaf = first.typeName is "Strict/Number" or member.Name is type.Name or LaneNesting.IsPlainType(first.typeName)
	first.Bits > 0 or isLeaf then first.Bits else LeafBits(member)
