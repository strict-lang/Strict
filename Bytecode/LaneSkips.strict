has lanes Texts
has relevant Texts
has structs Texts
has fields Texts
has isChecked Boolean = false
constant Paired = LaneSkips((StructLanes.Pair, StructLanes.Caller))
constant Drawn = LaneSkips((StructLanes.Pair, LaneCalls.Drawer))
constant None = LaneSkips(List(TypeEntry))
constant Sizes = LaneSkips(List(TypeEntry) + StructLanes.Sized)
from(types List(TypeEntry))
	Paired.lanes is ("Pair")
	LaneSkips(List(TypeEntry) + StructLanes.Caller).lanes.Length is 0
	Sizes.structs is ("Size") and Drawn.fields is ("Drawer.offset Pair")
	found = Lanes(types)
	lanes = found
	relevant = Built(found) + Called(types, found)
	firsts = Firsts(types)
	structs = Structs(types, firsts)
	fields = Fields(types, firsts)
Lanes(types List(TypeEntry)) Texts
	Paired.Lanes((StructLanes.Pair, StructLanes.Caller)) is ("Pair")
	Drawn.lanes is ("Pair", "Drawer")
	calls = LaneCalls(types)
	for types
		if StructLanes(types).Members(value).Length > 0 or calls.Laned(value.members).Length > 0
			TypeEntry.ShortName(value.Name)
IsUntouched(type TypeEntry, method MethodEntry) Boolean
	Paired.IsUntouched(StructLanes.Caller, MethodEntry.CountingLoop)
	Paired.IsUntouched(StructLanes.Pair, MethodEntry.CountingLoop) is false
	Paired.IsUntouched(StructLanes.Caller, StructLanes.Caller.methods.First) is false
	if lanes.Length is 0
		return true
	if TypeEntry.ShortName(type.Name) is in lanes
		return false
	Mentioned(Header(type, method), lanes) is false and Mentioned(Texts(method), lanes) is false
Header(type TypeEntry, method MethodEntry) Text
	Paired.Header(StructLanes.Caller, MethodEntry.CountingLoop).EndsWith("None")
	(type.members to Text) + (method.parameters to Text) + method.declaredType
Texts(method MethodEntry) Text
	Paired.Texts(MethodEntry.CountingLoop) is not Paired.Texts(StructLanes.Caller.methods.First)
	mutable joined = ""
	for method.instructions
		joined = joined + " " + Text.Combine(value.texts, " ")
	joined
Mentioned(text Text, names Texts) Boolean
	Paired.Mentioned("Strict/Pair", Paired.lanes) and Paired.Mentioned("Number", Paired.lanes) is false
	for names
		if text.IndexOf(value) >= 0
			return true
	false
Firsts(types List(TypeEntry)) List(TypeEntry)
	Paired.Firsts((StructLanes.Pair, StructLanes.Pair, StructLanes.Caller)).Length is 2
	mutable seen = List(Text)
	mutable firsts = List(TypeEntry)
	for types
		short = TypeEntry.ShortName(value.Name)
		if "(" is not in value.Name and short is not in seen
			seen = seen + short
			firsts = firsts + value
	firsts
Structs(types List(TypeEntry), firsts List(TypeEntry)) Texts
	Sizes.Structs(List(TypeEntry) + StructLanes.Sized, List(TypeEntry) + StructLanes.Sized) is ("Size")
	analysis = StructLanes(types)
	for firsts
		if analysis.Members(value).Length > 0
			TypeEntry.ShortName(value.Name)
Fields(types List(TypeEntry), firsts List(TypeEntry)) Texts
	Drawn.Fields((StructLanes.Pair, LaneCalls.Drawer), (StructLanes.Pair, LaneCalls.Drawer)) is ("Drawer.offset Pair")
	for type, field in firsts, LaneCalls(types).Laned(type.members)
		TypeEntry.ShortName(type.Name) + "." + field
IsTabled(name Text) Boolean
	Drawn.IsTabled("Strict/Drawer") and Drawn.IsTabled("Strict/List(Pair)") is false and None.IsTabled("Pair") is false
	lanes.Length > 0 and "(" is not in name
Built(names Texts) Texts
	Paired.Built(Paired.lanes) is ("Pair.from")
	for names
		value + ".from"
Called(types List(TypeEntry), names Texts) Texts
	Drawn.Called(List(TypeEntry) + LaneCalls.Drawer, Drawn.lanes) is ("Drawer.Shifted")
	for type, method in types, type.methods
		if Mentioned(method.parameters to Text, names)
			TypeEntry.ShortName(type.Name) + "." + method.Name
IsPlainCall(entry InstructionEntry) Boolean
	Paired.IsPlainCall(StructLanes.Calling(4))
	Paired.IsPlainCall(StructLanes.Constructed) is false
	Drawn.IsPlainCall(LaneCalls.Shift) is false
	None.IsPlainCall(StructLanes.Calling(4)) is false
	if entry.kind is not InstructionType.Invoke or entry.texts.Length < 2 or lanes.Length is 0
		return false
	TypeEntry.ShortName(entry.texts(0)) + "." + entry.texts(1) is not in relevant
Checked(type TypeEntry, rewritten MethodEntry, full MethodEntry)
	Paired.Checked(StructLanes.Caller, MethodEntry.CountingLoop, MethodEntry.CountingLoop) is not Error
	if isChecked then rewritten.instructions is not full.instructions else false
		Logger.Log("LaneSkipMismatch: " + type.Name + "." + rewritten.Name)
