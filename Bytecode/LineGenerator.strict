has state GenerationResult
GenerateLine(line Text) GenerationResult
	LineGenerator.Empty.GenerateLine("mutable sum = 0").instructions(0).label is "sum"
	LineGenerator.Empty.GenerateLine("sum = sum + 1").Count is 4
	if line.StartsWith("return ")
		return GenerateReturn(line)
	if line.StartsWith("if ")
		return GenerateIf(line)
	if line.StartsWith("for ")
		return GenerateFor(line)
	if line.IndexOf(" = ") is not -1
		return GenerateAssignment(WithoutDeclarationKeyword(line))
	ExpressionCodegen(state).GenerateExpression(line)
WithoutDeclarationKeyword(line Text) Text
	WithoutDeclarationKeyword("mutable a = 1") is "a = 1"
	WithoutDeclarationKeyword("a = 1") is "a = 1"
	for ("constant ", "let ", "mutable ")
		if line.StartsWith(value)
			return line.Substring(value.Length, line.Length - value.Length)
	line
GenerateReturn(line Text) GenerationResult
	LineGenerator.Empty.GenerateReturn("return 7").Count is 2
	let expr = ExpressionCodegen(state).GenerateExpression(line.Substring(7, line.Length - 7).Trim)
	expr.Append(BytecodeInstruction.ReturnOp(expr.LastRegister))
GenerateAssignment(rest Text) GenerationResult
	LineGenerator.Empty.GenerateAssignment("a = 1").Count is 1
	let eq = rest.IndexOf(" = ")
	let name = rest.Substring(0, eq).Trim
	let exprText = rest.Substring(eq + 3, rest.Length - eq - 3).Trim
	if NumberLiteral(exprText).IsNumber
		return state.Append(BytecodeInstruction.StoreConstant(name, exprText to Number))
	let expr = ExpressionCodegen(state).GenerateExpression(exprText)
	expr.Append(BytecodeInstruction.StoreRegister(expr.LastRegister, name))
GenerateIf(line Text) GenerationResult
	LineGenerator.Empty.GenerateIf("if 1 > 0").instructions(3).label is "if0"
	let expr = ExpressionCodegen(state).GenerateExpression(line.Substring(3, line.Length - 3).Trim)
	expr.Append(BytecodeInstruction("JumpToIdIfFalse", expr.LastRegister, 0, "if" + state.Count))
GenerateFor(line Text) GenerationResult
	LineGenerator.Empty.GenerateFor("for 3").instructions(1).label is "loop0"
	LineGenerator.Empty.GenerateFor("for 3").instructions(5).label is "loop0End"
	let id = "loop" + state.Count
	let indexStart = state.Append(BytecodeInstruction.StoreConstant("index", 0))
	let started = indexStart.Append(BytecodeInstruction("JumpEnd", 0, 0, id))
	let condition = ExpressionCodegen(started).GenerateExpression("index < " + line.Substring(4, line.Length - 4).Trim)
	condition.Append(BytecodeInstruction("JumpToIdIfFalse", condition.LastRegister, 0, id + "End"))
CloseBlock(openId Text) GenerationResult
	LineGenerator.Empty.CloseBlock("if0").instructions(0).typeName is "JumpEnd"
	LineGenerator.Empty.CloseBlock("loop0End").Count is 6
	if not openId.StartsWith("loop")
		return state.Append(BlockEnd(openId))
	constant increment = GenerateAssignment("index = index + 1")
	let backJump = increment.Append(BytecodeInstruction("Jump", 0, 0, openId.Substring(0, openId.Length - 3)))
	backJump.Append(BlockEnd(openId))
BlockEnd(id Text) BytecodeInstruction
	BlockEnd("if0").typeName is "JumpEnd"
	BytecodeInstruction("JumpEnd", 0, 0, id)
GenerateBodyLine(line Text, openId Text) GenerationResult
	LineGenerator.Empty.GenerateBodyLine("1", "if0").instructions(0).typeName is "JumpEnd"
	if line.StartsWith("\t")
		return GenerateLine(line.Trim)
	if openId is ""
		return GenerateLine(line)
	if line is "else"
		return state.Append(BytecodeInstruction("Jump", 0, 0, openId + "End")).Append(BlockEnd(openId))
	LineGenerator(CloseBlock(openId)).GenerateLine(line)
OpenIdAfter(line Text, openId Text, result GenerationResult) Text
	OpenIdAfter("\treturn 1", "if0", GenerationResult.Empty) is "if0"
	OpenIdAfter("2", "if0", GenerationResult.Empty) is ""
	if line.StartsWith("if ") or line.StartsWith("for ")
		return result.instructions(result.Count - 1).label
	if line is "else"
		return openId + "End"
	line.StartsWith("\t") then openId else ""
GenerateBody(lines Texts) GenerationResult
	LineGenerator.Empty.GenerateBody("constant a = 2", "a * 3").LastRegister is 2
	LineGenerator.Empty.GenerateBody("if 1 > 0", "\treturn 1", "2").instructions(6).typeName is "JumpEnd"
	LineGenerator.Empty.GenerateBody("if 1 > 0", "\treturn 1", "else", "\treturn 2").Count is 11
	mutable current = GenerationResult.Empty
	mutable openId = ""
	for lines
		current = LineGenerator(current.WithRegistry(Registry.Empty)).GenerateBodyLine(value, openId)
		openId = OpenIdAfter(value, openId, current)
	if openId is ""
		return current
	LineGenerator(current.WithRegistry(Registry.Empty)).CloseBlock(openId)
GenerateReturningBody(lines Texts) GenerationResult
	LineGenerator.Empty.GenerateReturningBody("constant a = 2", "a * 3").Count is 5
	LineGenerator.Empty.GenerateReturningBody(("return 7")).Count is 2
	let body = GenerateBody(lines)
	if body.Count > 0
		if body.instructions(body.Count - 1).IsReturn
			return body
	body.Append(BytecodeInstruction.ReturnOp(body.LastRegister))
Empty LineGenerator
	LineGenerator(GenerationResult.Empty)
to Text
	state to Text