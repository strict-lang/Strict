has linker Linker
constant Sample = LinkCompile(Linker.Sample)
constant Housed = LinkCompile(Linker.Housed)
constant Adding = TypeEntry("Strict/Logger", List(MemberEntry), List(MethodEntry) + MethodEntry.Logged)
LinkedType(type Text, methods Texts, compiled TypeEntry) TypeEntry slow
	Sample.LinkedType("Strict/Logger", List(Text), Sample.Compiling("Strict/Logger", List(Text))).Name is "Strict/Logger"
	Sample.LinkedType("Strict/Bytecode/Crc", List(Text), Sample.Compiling("Strict/Bytecode/Crc", List(Text))).Name is "Crc"
	Housed.Home("Strict/Logger", List(Text) + "Missing").methods.Length is 0
	Housed.Home("Strict/Bytecode/Logged", "Run").Name is "Logged"
	homed = Assemble(type, methods, compiled)
	if Linker.IsChecking is false
		return homed
	checked = Compile(type, methods)
	if BinaryLinks.User.Pick(checked, methods) is not BinaryLinks.User.Pick(homed, methods)
		Logger.Log("LinkCheckFailed: " + type + " " + Text.Combine(methods, ", "))
	checked
Own(type Text) TypeEntry
	Housed.Own("Strict/Logger") is TypeEntry.HelloLogger
	Sample.Own("Strict/Logger").Name is ""
	type is in linker.Homes then linker.Homes(type) else BinaryLinks.Unknown
Absent(type Text, methods Texts) Texts
	Sample.Absent("Strict/Logger", List(Text)).Length is 0
	Sample.Absent("Strict/Logger", List(Text) + "Log") is ("Log")
	BinaryLinks.User.Compilable(Own(type), methods, linker.main.inference.types.MethodsOf(TypeEntry.ShortName(type)))
IsCompiled(type Text, methods Texts) Boolean
	Sample.IsCompiled("Strict/Logger", List(Text) + "from")
	Housed.IsCompiled("Strict/Logger", List(Text))
	Housed.IsCompiled("Strict/Logger", List(Text) + "Log")
	Housed.IsCompiled("Strict/Logger", List(Text) + "Run") is false
	methods.Length is 0 or Own(type).Name is "" or Absent(type, methods).Length > 0
Compiling(type Text, methods Texts) TypeEntry slow
	Sample.Compiling("Strict/Bytecode/Crc", List(Text)).Name is "Crc"
	Housed.Compiling("Strict/Logger", List(Text) + "Run") is BinaryLinks.Unknown
	IsCompiled(type, methods) then Compile(type, Absent(type, methods)) else BinaryLinks.Unknown
Assemble(type Text, methods Texts, compiled TypeEntry) TypeEntry
	Housed.Assemble("Strict/Logger", List(Text) + "Run", BinaryLinks.Unknown).methods.Length is 1
	Housed.Assemble("Strict/Logger", List(Text), Linker.Go) is Linker.Go
	Housed.Assemble("Strict/Logger", ("Run", "Add"), Adding).methods.Length is 2
	Housed.Assemble("Strict/Logger", List(Text) + "Run", Linker.Reading).members is TypeEntry.HelloLogger.members
	Sample.Assemble("Strict/Logger", List(Text) + "Run", Linker.Reading).members is Linker.Reading.members
	if methods.Length is 0
		return compiled
	own = Own(type)
	whole = TypeEntry(own, methods = own.methods + compiled.methods)
	members = own.Name is "" then compiled.members else own.members
	TypeEntry(linker.main.Local(type), members, BinaryLinks.User.Pick(whole, methods))
Home(type Text, methods Texts) TypeEntry slow
	Housed.Home("Strict/Logger", "Run").Name is "Strict/Logger"
	Sample.Home("Strict/Logger", ("Log", "Reset")).methods.First.Name is "Log"
	Assemble(type, methods, Compiling(type, methods))
Compile(type Text, methods Texts) TypeEntry slow
	Sample.Compile("Strict/Bytecode/Crc", List(Text)).methods.Length is 0
	Housed.Home("Strict/Logger", ("Run", "from")).methods.Length is 1
	Housed.Home("Strict/Logger", List(Text) + "from").Name is "Strict/Logger"
	Generate(type, Prepare(type, methods), methods)
Prepare(type Text, methods Texts) Texts slow
	Sample.Prepare("Strict/Bytecode/Crc", List(Text)).Length > 0
	folder = Path(linker.SourcePath(type)).PathOnly.text
	source = Fusion(File(linker.SourcePath(type)).ReadLines, folder).Fused
	generator = Automatic(source, TypeEntry.ShortName(type), Instantiation(linker.main.inference.types))
	automatic = generator.Lines(methods) + OptionsCodegen(generator, folder).Lines(methods)
	MemberAverage(type, linker.main.inference.types).Replace(automatic)
Generate(type Text, lines Texts, methods Texts) TypeEntry
	Sample.Generate("Strict/Logger", ("Run", "\t1"), List(Text)).Name is "Strict/Logger"
	generator = TypeCodegen(type, lines, linker.main.inference, linker.main.typeNames)
	TypeEntry(generator.Select(methods), Name = linker.main.Local(type))
