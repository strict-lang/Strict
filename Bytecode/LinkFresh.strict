has round LinkRound
has earliest Dictionary(Text, Number)
constant Nothing = Dictionary(Text, TypeEntry)
constant Unplaced = Dictionary(Text, Number)
constant Earliest = Dictionary(("Strict/Logger", 0))
constant Logging = List(Text) + "Strict/Logger:"
constant Single = LinkFresh(LinkRound.Single, Unplaced)
constant Twice = LinkFresh(LinkRound.Twice, Earliest)
constant Logged = LinkFresh(LinkRound(LinkRound.Twice, signatures = List(Text) + "Strict/Logger:Log"), Earliest)
constant Running = LinkFresh(LinkRound(LinkRound.Twice, signatures = List(Text) + "Strict/Logger:Log;Run"), Earliest)
constant Covered = LinkFresh(LinkRound(LinkRound.Single, linker = Linker(Linker.Hello, Known = Dictionary(("Strict/B:Add;Go", Linker.Go)))), Unplaced)
constant Homing = LinkFresh(LinkRound(LinkRound.Single, linker = Linker.Housed), Unplaced)
Entry(signature Text, positions Dictionary(Text, Number), compiled Dictionary(Text, TypeEntry)) TypeEntry slow
	Twice.Entry("Strict/Logger:", ResolveCheck.Positions(LinkRound.Twice.signatures), Nothing) is Linker.Go
	LinkFresh(LinkRound.Cached, Unplaced).Entry("Strict/Logger:", Unplaced, Nothing) is LinkRound.Rooted("Strict/Logger:")
	Single.Entry("Strict/Logger:", Unplaced, Single.Precompile(Logging, Unplaced)).Name is "Strict/Logger"
	if signature is in positions
		return round.entries(positions(signature) + 1)
	known = Covering(signature)
	if known is not ""
		return TypeEntry(round.linker.Known(known), Name = round.linker.main.Local(Signature(signature).Type))
	Fresh(signature, compiled(signature))
Precompile(signed Texts, positions Dictionary(Text, Number)) Dictionary(Text, TypeEntry) slow
	Single.Precompile(Logging, Unplaced)("Strict/Logger:").Name is "Strict/Logger"
	fresh = Probe(signed, positions).Unique
	generated = Generating(fresh, Read(fresh))
	mutable compiled = Dictionary(Text, TypeEntry)
	for fresh
		compiled.Add(value, generated(index))
	compiled
Probe(signed Texts, positions Dictionary(Text, Number)) Texts
	Twice.Probe(("Strict/Logger:", "Strict/B:Go"), ResolveCheck.Positions(LinkRound.Twice.signatures)) is ("Strict/B:Go")
	LinkFresh(LinkRound.Cached, Unplaced).Probe(Logging, Unplaced).Length is 0
	for signed
		if value is not in positions and Covering(value) is ""
			value
Read(fresh Texts) List(Texts) slow
	Single.Read(Logging).First.Length > 0
	Twice.Read(List(Text) + "Strict/Logger:Log").Length is 1
	compile = LinkCompile(round.linker)
	mutable read = List(Mutable(Texts))
	for fresh
		type = Signature(value).Type
		wanted = Want(value)
		read.Add(compile.IsCompiled(type, wanted) then compile.Prepare(type, compile.Absent(type, wanted)) else List(Text))
	read
Generating(fresh Texts, read List(Texts)) List(TypeEntry)
	Single.Generating(Logging, List(Texts) + List(Text)).First.Name is "Strict/Logger"
	Homing.Generating(List(Text) + "Strict/Logger:Run", List(Texts) + List(Text)).First is BinaryLinks.Unknown
	compile = LinkCompile(round.linker)
	for fresh
		type = Signature(value).Type
		wanted = Want(value)
		absent = compile.Absent(type, wanted)
		compile.IsCompiled(type, wanted) then compile.Generate(type, read(index), absent) else BinaryLinks.Unknown
Compile(signature Text) TypeEntry slow
	Twice.Compile("Strict/Logger:Log").methods.Length is 1
	LinkCompile(round.linker).Compiling(Signature(signature).Type, Want(signature))
IsWhole(signature Text) Boolean
	Single.IsWhole("Strict/Logger:")
	Twice.IsWhole("Strict/Logger:Log") is false
	Logged.IsWhole("Strict/Logger:Reset")
	LinkFresh(LinkRound.Twice, Unplaced).IsWhole("Strict/Logger:Log")
	Earlier(signature) < 0 or (Older(signature) - Signature(signature).Names).Length > 0
Older(signature Text) Texts
	Twice.Older("Strict/Logger:Log").Length is 0
	Single.Older("Strict/Logger:").Length is 0
	Logged.Older("Strict/Logger:Log;Reset") is ("Log")
	earlier = Earlier(signature)
	earlier < 0 then List(Text) else Signature(round.signatures(earlier)).Names
Earlier(signature Text) Number
	Twice.Earlier("Strict/Logger:Log") is 0
	Single.Earlier("Strict/Logger:Log") is -1
	type = Signature(signature).Type
	type is in earliest then earliest(type) else Number.NotFound
Want(signature Text) Texts
	Twice.Want("Strict/Logger:Log") is ("Log")
	Logged.Want("Strict/Logger:Log;Reset") is ("Reset")
	Running.Want("Strict/Logger:Log;Reset") is ("Log", "Reset")
	IsWhole(signature) then Signature(signature).Names else Signature(signature).Names - Older(signature)
Fresh(signature Text, compiled TypeEntry) TypeEntry slow
	Single.Fresh("Strict/Logger:", Single.Compile("Strict/Logger:")).Name is "Strict/Logger"
	Twice.Fresh("Strict/Logger:Log", Twice.Compile("Strict/Logger:Log")).methods.Length is 2
	linked = LinkCompile(round.linker).LinkedType(Signature(signature).Type, Want(signature), compiled)
	if IsWhole(signature)
		return linked
	entry = round.entries(Earlier(signature) + 1)
	TypeEntry(entry.Name, entry.members, entry.methods + linked.methods)
Covering(signature Text) Text
	Covered.Covering("Strict/B:Go") is "Strict/B:Add;Go" and Covered.Covering("Strict/B:Add;Go") is "Strict/B:Add;Go"
	Covered.Covering("Strict/B:Run") is "" and Covered.Covering("Strict/C:Go") is ""
	if signature is in round.linker.Known
		return signature
	prefix = Signature(signature).Type + ":"
	wanted = Signature(signature).Names
	for round.linker.Known.keysAndValues
		if value.Key.StartsWith(prefix) and (wanted - Signature(value.Key).Names).Length is 0
			return value.Key
	""
