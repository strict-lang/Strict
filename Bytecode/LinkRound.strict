has linker Linker
has entries List(TypeEntry)
has signatures Texts
constant Unlinked = LinkRound(Linker.Hello, List(TypeEntry), List(Text))
constant Cached = LinkRound(Linker(".", TypeCodegen.Hello, Dictionary(("Strict/Logger:", Linker.Go))), List(TypeEntry), List(Text))
constant Single = LinkRound(Linker.Sample, List(TypeEntry) + Linker.Go, List(Text))
constant Twice = LinkRound(Linker.Sample, (Linker.Go, Linker.Go), List(Text) + "Strict/Logger:")
constant Greeting = LinkRound(Linker.Hello, List(TypeEntry) + TypeEntry.HelloLogger, List(Text))
constant Forwarding = (TypeEntry("HelloLogger", MemberEntry.LoggerMember, MethodEntry("Run", List(MemberEntry), "None", InstructionEntry.Invoke(0, ("Strict/W", "Code", "Strict/Text"), List(Number), -1))), TypeEntry("Strict/W", List(MemberEntry) + MemberEntry("hello", "Strict/HelloLogger", List(InstructionEntry), false), List(MethodEntry)))
constant Wrapping = LinkRound(Linker.Sample, (Linker.Go, TypeEntry.CharacterEntry, TypeEntry("Strict/Dictionary(Text)", MemberEntry.NumbersMember, List(MethodEntry))), ("Strict/Character:Floor", "Strict/Dictionary(Text):in"))
constant Chained = LinkRound(Linker.Sample, (Linker.Go, TypeEntry("Strict/Angle", List(MemberEntry) + MemberEntry("degrees", "Strict/Degrees", List(InstructionEntry), false), List(MethodEntry)), TypeEntry("Strict/Degrees", List(MemberEntry) + MemberEntry("number", "Strict/Number", List(InstructionEntry), false), List(MethodEntry))), ("Strict/Angle:Floor", "Strict/Degrees:Floor"))
constant Cycled = LinkRound(Linker.Sample, Chained.entries.Slice(0, 2) + TypeEntry("Strict/Degrees", List(MemberEntry) + MemberEntry("angle", "Strict/Angle", List(InstructionEntry), false), List(MethodEntry)), Chained.signatures)
constant Point = TypeEntry("Strict/Point", (MemberEntry("x", "Strict/Number", List(InstructionEntry), false), MemberEntry("y", "Strict/Number", List(InstructionEntry), false)), List(MethodEntry))
constant Texting = LinkRound(Linker.Sample, (TypeEntry(Linker.Go, methods = MethodEntry(Linker.Go.methods.First, instructions = InstructionEntry.Invoke(0, ("Strict/Point", "to", "Strict/Text"), List(Number), -1))), Point), List(Text))
constant Writing = LinkRound(Linker.Sample, List(TypeEntry) + TypeEntry(Linker.Go, methods = MethodEntry(Linker.Go.methods.First, instructions = InstructionEntry.Invoke(0, ("Strict/File", "Write", "None"), List(Number), -1))), List(Text))
Entries(signed Texts) Slow(List(TypeEntry))
	Single.Entries(List(Text) + "Strict/Logger:").First.Name is "Strict/Logger"
	Cached.Entries(List(Text) + "Strict/Logger:").First is Linker.Go
	for signed
		value is in linker.known then linker.known(value) else Fresh(value)
Fresh(signature Text) Slow(TypeEntry)
	Single.Fresh("Strict/Logger:").Name is "Strict/Logger"
	Twice.Fresh("Strict/Logger:Log").methods.Length is 2
	let known = signatures.Index(signature)
	if known >= 0
		return entries(known + 1)
	let earlier = Signature(signature).Earlier(signatures)
	let names = Signature(signature).Names
	let old = earlier < 0 then List(Text) else Signature(signatures(earlier)).Names
	if (earlier < 0) or ((old - names).Length > 0)
		return linker.LinkedType(Signature(signature).Type, names)
	let entry = entries(earlier + 1)
	TypeEntry(entry.Name, entry.members, entry.methods + linker.LinkedType(Signature(signature).Type, names - old).methods)
Forwarded(targets Texts, seen Texts = List(Text)) Texts
	Wrapping.Forwarded(List(Text) + "Strict/Character.Floor") is ("Strict/Number.Floor")
	Wrapping.Forwarded(("Strict/Character.from", "Strict/Dictionary(Text).in")).Length is 0
	Wrapping.Forwarded(List(Text) + "Strict/Character.Round").Length is 0
	Chained.Forwarded(List(Text) + "Strict/Angle.Floor") is ("Strict/Degrees.Floor", "Strict/Number.Floor")
	let indices = Indices
	mutable forwarded = List(Mutable(Text))
	for targets - seen
		let target = ForwardedTarget(value, indices)
		if target is not ""
			forwarded.Add(target)
	let fresh = (forwarded - seen - targets).Unique
	forwarded + (fresh.Length is 0 then List(Text) else Forwarded(fresh, seen + targets))
ForwardedTarget(target Text, indices Dictionary(Text, Number)) Text
	let type = target.Substring(0, target.LastIndexOf("."))
	let method = target.Substring(type.Length + 1, target.Length - type.Length - 1)
	if (type is in indices) and IsForwarded(type, indices(type), method)
		return entries(indices(type)).Changing.First.typeName + "." + method
	""
IsForwarded(type Text, index Number, method Text) Boolean
	Wrapping.IsForwarded("Strict/Character", 1, "Floor")
	Wrapping.IsForwarded("Strict/Character", 1, "Round") is false
	Cycled.Forwarded(List(Text) + "Strict/Angle.Floor").Length is 2
	let isRequested = (index is 0) or (method is in Signature(signatures(index - 1)).Names)
	let isOwn = (method is "from") or linker.IsNative(type, method)
	isRequested and (isOwn is false) and (entries(index).Chosen(method, -1, "", List(Text)) < 0)
Indices Dictionary(Text, Number)
	Wrapping.Indices("Strict/Character") is 1
	Wrapping.Indices.Length is 2
	mutable indices = Dictionary(Text, Number)
	let names = TypeNames
	for entries
		if value.Changing.Length is 1
			indices(names(index)) = index
	indices
TypeNames Texts
	for entries
		let local = Path(linker.main.fullName).PathOnly.text + "/" + value.Name
		value.Name.IndexOf("/") < 0 then local else value.Name
Checked List(TypeEntry)
	Linker.Hello.Linked(TypeEntry.HelloLogger, List(Text)).entries.Length is 15
	Linker.Sample.Linked(Linker.Iterating, List(Text)).entries.Length is 1
	let missing = Unresolved
	if missing.Length > 0
		Logger.Log("UnresolvedLink: " + missing.First)
		return List(TypeEntry)
	entries
Unresolved Texts
	Writing.Unresolved.Length is 0
	Texting.Unresolved.Length is 0
	mutable positions = Dictionary(Text, Number)
	for TypeNames
		positions(value) = index
	for linker.Targets(entries).Unique
		if Missing(value, List(Text), positions)
			value
Missing(target Text, seen Texts, positions Dictionary(Text, Number)) Boolean
	let type = target.Substring(0, target.LastIndexOf("."))
	let method = target.Substring(type.Length + 1, target.Length - type.Length - 1)
	let hosted = TypeEntry.ShortName(type) + "." + method is in Hosted.Methods
	if (method is in ("from", "in", "Index", "to", "to Text", "to Type")) or hosted or linker.IsNative(type, method)
		return false
	if (type is not in positions) or (target is in seen)
		return true
	let entry = entries(positions(type))
	let converted = method.StartsWith("to ") then method.Split(" ") else (method, "")
	let found = entry.Chosen(converted.First, -1, converted.Last, List(Text)) >= 0
	let next = entry.Changing.Length is 1 then entry.Changing.First.typeName + "." + method else ""
	(found is false) and ((next is "") or Missing(next, seen + target, positions))
IsSettled(next LinkRound) Boolean
	Single.IsSettled(Single)
	Single.IsSettled(Twice) is false
	Single.IsSettled(LinkRound(Linker.Sample, List(TypeEntry) + TypeEntry.Converting, List(Text))) is false
	let isSame = (next.signatures.Length is signatures.Length) and ((next.signatures - signatures).Length is 0)
	isSame and (next.entries.First.methods.Length is entries.First.methods.Length)
With(linked List(TypeEntry)) LinkRound
	Single.With(List(TypeEntry)).entries.Length is 0
	Twice.With(List(TypeEntry)).signatures is ("Strict/Logger:")
	LinkRound(linker, linked, signatures)
Known(known Dictionary(Text, TypeEntry)) Dictionary(Text, TypeEntry)
	Twice.Known(Dictionary(Text, TypeEntry))("Strict/Logger:") is Linker.Go
	Single.Known(Dictionary(Text, TypeEntry)).Length is 0
	LinkRound(Linker.Sample, (Linker.Go, Linker.Go), List(Text)).Known(Dictionary(Text, TypeEntry)).Length is 0
	if entries.Length is not signatures.Length + 1
		return known
	mutable result = known
	for signatures
		if value is not in result
			result.Add(value, entries(index + 1))
	result
