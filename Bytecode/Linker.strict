has root Text
has main TypeCodegen
constant Go = TypeEntry("A", List(MemberEntry), MethodEntry.GoRun)
constant CountCall = InstructionEntry.Invoke(0, ("Strict/Range", "Count", "Strict/Number"), List(Number), -1)
constant CountRun = MethodEntry("Run", List(MemberEntry), "None", CountCall)
constant Counted = TypeEntry("A", List(MemberEntry), List(MethodEntry) + CountRun)
constant ForNumbers = MethodEntry("for", List(MemberEntry), "Strict/Iterator(Number)", List(InstructionEntry))
constant Iterating = TypeEntry("A", List(MemberEntry), List(MethodEntry) + ForNumbers)
constant Sample = Linker(".", TypeCodegen("Strict/Bytecode/FileCompiler", List(Text), ValueCodegen.NoTypes, List(Text)))
constant Hello = Linker(".", TypeCodegen.Hello)
constant Reading = TypeEntry("A", List(MemberEntry) + MemberEntry("b", "Strict/List(Byte)", List(InstructionEntry), false), List(MethodEntry))
constant Parameters = TypeEntry("Strict/Bytecode/MethodEntry", List(MemberEntry) + MemberEntry("parameters", "Strict/List(MemberEntry)", List(InstructionEntry), false), List(MethodEntry))
constant DictionaryCode = MethodEntry("Run", List(MemberEntry), "None", List(InstructionEntry) + InstructionEntry.Invoke(0, ("Strict/Dictionary(Number, Text)", "Code", "Strict/Text"), List(Number), -1))
constant Natives = ("to", "not", "and", "or", "xor", "Exists", "ReadLines")
Linked(entries List(TypeEntry), signatures Texts) Slow(List(TypeEntry))
	Sample.Linked(Go, List(Text)).Length is 0
	mutable round = LinkRound(value, entries, signatures)
	for as long as true
		let started = Process.Elapsed
		let next = Next(round.entries, round.signatures)
		let complete = round.IsSettled(next)
		let phase = "Frontend / link pass (" + next.entries.Length + " types, complete " + complete + ")"
		BuildProfile(Logger).Reported(phase, started)
		if complete
			return next.Checked
		round = next
	List(TypeEntry)
Next(entries List(TypeEntry), signatures Texts) Slow(LinkRound)
	Sample.Next(Go, List(Text)).entries.Length is 1
	Hello.Next(TypeEntry.HelloLogger, List(Text)).signatures is ("Strict/Logger:")
	Hello.Next(LinkRound.Forwarding, List(Text) + "Strict/W:Code").entries.First.methods.Length is 2
	let invoked = Targets(entries).Unique
	let round = LinkRound(value, Completed(entries, invoked), signatures)
	let targets = invoked + round.Forwarded(invoked)
	let signed = Signatures(Linkable(BaseTypes(entries, targets), signatures), targets)
	LinkRound(value, (List(TypeEntry) + Completed(round.entries, targets).First) + round.Entries(signed), signed)
Completed(entries List(TypeEntry), targets Texts) Slow(List(TypeEntry))
	Sample.Completed(Go, List(Text)).Length is 1
	Sample.Completed((Go, Counted), List(Text))(1) is Counted
	let automatic = Automatic(main.lines, TypeEntry.ShortName(main.fullName), Instantiation(main.inference.types))
	let options = OptionsCodegen(automatic, Path(SourcePath(main.fullName)).PathOnly.text)
	let completed = options.Completed(main, automatic.Completed(main, entries.First, targets), targets)
	let first = Specialization(main.Generator).Completed(main, completed, targets)
	(List(TypeEntry) + first) + entries.Slice(1, entries.Length - 1)
Linkable(types Texts, signatures Texts) Texts
	Hello.Linkable(("Strict/Logger", "Strict/Missing"), List(Text)) is ("Strict/Logger")
	Hello.Linkable(List(Text) + "Strict/Missing", List(Text) + "Strict/Missing:") is ("Strict/Missing")
	mutable linked = Dictionary(Text, Boolean)
	for signatures
		linked.Add(Signature(value).Type, true)
	for types
		if value is in linked
			value
		else if IsLinkable(value)
			value
IsLinkable(type Text) Boolean
	Hello.IsLinkable("Strict/Logger")
	Hello.IsLinkable("Strict/Missing") is false
	let source = File(SourcePath(type))
	source.Exists and ((type.IndexOf("(") is -1) or (TypeShape(source.ReadLines).IsTrait is false))
Signatures(types Texts, targets Texts) Texts
	Sample.Signatures(("Strict/B"), ("Strict/B.Go")) is ("Strict/B:Go")
	Sample.Signatures(("Strict/B"), ("Strict/B.Go", "Strict/B.Add")) is ("Strict/B:Add;Go")
	Sample.Signatures(("Strict/B"), ("Strict/B.Go", "Strict/B.F(A, B)")) is ("Strict/B:F(A, B);Go")
	for types
		value + ":" + Text.Combine(UsedMethods(targets, value).Sorted, ";")
LinkedType(type Text, methods Texts) Slow(TypeEntry)
	Sample.LinkedType("Strict/Logger", List(Text)).Name is "Strict/Logger"
	Sample.LinkedType("Strict/Bytecode/Crc", List(Text)).Name is "Crc"
	let folder = Path(SourcePath(type)).PathOnly.text
	let source = Fusion(File(SourcePath(type)).ReadLines, folder).Fused
	let generator = Automatic(source, TypeEntry.ShortName(type), Instantiation(main.inference.types))
	let automatic = generator.Lines(methods) + OptionsCodegen(generator, folder).Lines(methods)
	let averaged = MemberAverage(type, main.inference.types).Replaced(automatic)
	let entry = TypeCodegen(type, averaged, main.inference, main.typeNames).Selected(methods)
	let isLocal = Path(type).PathOnly.text is Path(main.fullName).PathOnly.text
	isLocal then TypeEntry(Path(type).FileName.text, entry.members, entry.methods) else entry
BaseTypes(entries List(TypeEntry), targets Texts) Texts
	Sample.BaseTypes(Go, ("Strict/B.Go")) is ("Strict/B")
	mutable types = List(Mutable(Text))
	for targets
		types.Add(value.Substring(0, value.LastIndexOf(".")))
	let candidates = (types + UsedTypes(entries)).Unique
	for candidates
		if value is not main.fullName
			value
UsedMethods(targets Texts, type Text) Texts
	Sample.UsedMethods(("Strict/B.Go"), "Strict/B") is ("Go")
	Sample.UsedMethods(("Strict/Range.Count"), "Strict/Range") is ("Count")
	Sample.UsedMethods(("Strict/B.Go", "Strict/C.Go", "Strict/B.to Text"), "Strict/B") is ("Go", "to Text")
	Sample.UsedMethods(("Strict/Number.to Text", "Strict/Number.Floor"), "Strict/Number") is ("Floor")
	Sample.UsedMethods(("Strict/B.Go", "Strict/B.Go"), "Strict/B") is ("Go")
	let prefix = type + "."
	mutable used = List(Mutable(Text))
	for targets
		let method = value.StartsWith(prefix) then value.Substring(prefix.Length, value.Length - prefix.Length) else ""
		if (method is not "") and (method is not in used) and (IsNative(type, value.Split(".").Last) is false)
			used.Add(method)
	used
IsNative(type Text, method Text) Boolean
	Sample.IsNative("Strict/Compiler/BuildProfile", "Detailed")
	(Sample.IsNative("Strict/Text", "Upper") or Sample.IsNative("Strict/Range", "Length")) is false
	Sample.IsNative("Strict/Bytecode/B", "to") is false
	Sample.IsNative("Strict/Dictionary(Number, Number)", "get")
	Sample.IsNative("Strict/Number", "to")
	Sample.IsNative("Strict/NativeIO", "Exists") is false
	if type.LastIndexOf("/") > 6
		return TypeEntry.ShortName(type) + "." + method is in Hosted.Methods
	if (method is in ("Length", "Count")) or (SourceName(type) is "Dictionary")
		return (SourceName(type) is in ("List", "File", "Dictionary")) or ((type is "Strict/Text") and (method is "Length"))
	let isOwn = TypeEntry.IsBaseName(TypeEntry.ShortName(type)) or (SourceName(type) is in ("File", "Directory"))
	(method.Split(" ").First is in Natives) and isOwn
SourceName(type Text) Text
	Sample.SourceName("Strict/List(Number)") is "List"
	Sample.SourceName("Strict/Process") is "Process"
	let name = type.Substring(7, type.Length - 7)
	name.IndexOf("(") is -1 then name else name.Substring(0, name.IndexOf("("))
SourcePath(type Text) Text
	Sample.SourcePath("Strict/Process") is "./Process.strict"
	let local = "./" + SourceName(type) + ".strict"
	File(local).Exists then local else root + "/" + SourceName(type) + ".strict"
UsedTypes(entries List(TypeEntry)) Texts
	Sample.UsedTypes(Go) is List(Text)
	Sample.UsedTypes(Reading) is ("Strict/List(Byte)", "Strict/Byte")
	mutable types = List(Mutable(Text))
	for entries
		let name = value.Name.IndexOf("/") < 0 then main.fullName else value.Name
		types = types + Elements(value.UsedTypes.Unique, name.Substring(0, name.LastIndexOf("/")))
	types
Elements(types Texts, package Text) Texts
	Sample.Elements(("Strict/List(Byte)", "Strict/Text"), "Strict") is ("Strict/List(Byte)", "Strict/Byte", "Strict/Text")
	Sample.UsedTypes(Parameters) is ("Strict/List(MemberEntry)", "Strict/Bytecode/MemberEntry")
	Sample.Elements(List(Text) + "Strict/List(Character)", "Strict") is ("Strict/List(Character)", "Strict/Character")
	mutable result = List(Mutable(Text))
	for types
		result.Add(value)
		if value.StartsWith("Strict/List(") and (value.LastIndexOf("(") is 11)
			result.Add(Qualified(value.Substring(12, value.Length - 13), package))
	result
Qualified(element Text, package Text) Text
	Sample.Qualified("MemberEntry", "Strict/Bytecode") is "Strict/Bytecode/MemberEntry"
	Sample.Qualified("Logger", "Strict/Bytecode") is "Strict/Logger"
	let nearby = package + "/" + element
	File(SourcePath(nearby)).Exists then nearby else "Strict/" + element
Targets(entries List(TypeEntry)) Texts
	Sample.Targets(Go) is ("Strict/B.Go")
	Sample.Targets(Counted) is ("Strict/Range.Count")
	Sample.Targets((Go, Counted)) is ("Strict/B.Go", "Strict/Range.Count")
	Sample.Targets(TypeEntry("A", List(MemberEntry), List(MethodEntry) + DictionaryCode)).Last is "Strict/Text.Code"
	mutable targets = List(Mutable(Text))
	for entries
		targets = targets + value.Invoked
	for targets
		if value.StartsWith("Strict/Dictionary(") and value.EndsWith(".Code")
			return targets + "Strict/Text.Code"
	targets
