has root Text
has main TypeCodegen
has Known Dictionary(Text, TypeEntry) = Dictionary(Text, TypeEntry)
has Sourced BinarySources = Unsourced
has Homes Dictionary(Text, TypeEntry) = Dictionary(Text, TypeEntry)
has Places Dictionary(Text, Text) = Dictionary(Text, Text)
has isFast Boolean = false
constant Unsourced = BinarySources(List(Text))
constant Go = TypeEntry("A", List(MemberEntry), MethodEntry.GoRun)
constant CountCall = InstructionEntry.Invoke(0, ("Strict/Range", "Count", "Strict/Number"), List(Number), -1)
constant CountRun = MethodEntry("Run", List(MemberEntry), "None", CountCall)
constant Counted = TypeEntry("A", List(MemberEntry), List(MethodEntry) + CountRun)
constant ForNumbers = MethodEntry("for", List(MemberEntry), "Strict/Iterator(Number)", List(InstructionEntry))
constant Iterating = TypeEntry("A", List(MemberEntry), List(MethodEntry) + ForNumbers)
constant Sample = Linker(".", TypeCodegen("Strict/Bytecode/FileCompiler", List(Text), ValueCodegen.Logging, List(Text) + "Strict/Bytecode/Binary/MemberEntry"))
constant Hello = Linker(".", TypeCodegen.Hello)
constant Reading = TypeEntry("A", List(MemberEntry) + MemberEntry("b", "Strict/List(Byte)", List(InstructionEntry), false), List(MethodEntry))
constant Parameters = TypeEntry("Strict/Bytecode/Binary/MethodEntry", List(MemberEntry) + MemberEntry("parameters", "Strict/List(MemberEntry)", List(InstructionEntry), false), List(MethodEntry))
constant DictionaryCode = MethodEntry("Run", List(MemberEntry), "None", List(InstructionEntry) + InstructionEntry.Invoke(0, ("Strict/Dictionary(Number, Text)", "Code", "Strict/Text"), List(Number), -1))
constant Knowing = Linker(Sample, Known = Dictionary(("Strict/Bytecode/HelloLogger:", TypeEntry.HelloLogger)))
constant Housed = Linker(Sample, Homes = Dictionary(("Strict/Logger", TypeEntry.HelloLogger), ("Strict/Bytecode/Logged", TypeEntry.HelloLogger)))
constant IsChecking = Process.Variable("STRICT_LINK_CHECK") is "1"
constant Placed = BinarySources(List(Text) + "/elsewhere/Tripling.strict")
constant Natives = ("to", "not", "and", "or", "xor", "Exists", "ReadLines")
Link(entries List(TypeEntry), signatures Texts) LinkRound slow
	Sample.Link(Go, List(Text)).entries.Length is 0
	Linker(Sample, isFast = true).Link(Go, List(Text)).linker.Homes.Length is 0
	mutable round = LinkRound(value, entries, signatures)
	for as long as true
		started = Process.Elapsed
		next = Next(round)
		if IsSettled(next, round.IsSettled(next), started)
			return isFast then next else next.With(next.Checked)
		round = next
	round
IsSettled(next LinkRound, complete Boolean, started Number) Boolean
	BuildProfile.Report("Frontend / link pass (" + next.entries.Length + " types, complete " + complete + ")", started)
	complete
Next(round LinkRound) LinkRound slow
	Sample.Next(LinkRound.Single).entries.Length is 1
	Hello.Next(LinkRound.Greeting).signatures is ("Strict/Logger:")
	Hello.Next(LinkRound(Hello, LinkRound.Forwarding, List(Text) + "Strict/W:Code")).entries.First.methods.Length is 2
	Linker(Hello, isFast = true).Next(LinkRound.Greeting).linker.Homes.Length is 0
	invoked = round.Targets.Unique
	completed = LinkRound(round, entries = Complete(round.entries, invoked))
	targets = invoked + completed.Forward(invoked)
	signed = Signatures(Linkable(BaseTypes(round.UsedTypes, targets), round.signatures), targets)
	homed = isFast then completed else LinkHomes(completed).Homing(signed)
	homed.Advanced((List(TypeEntry) + Complete(completed.entries, targets).First) + homed.Entries(signed), signed)
Complete(entries List(TypeEntry), targets Texts) List(TypeEntry) slow
	Sample.Complete(Go, List(Text)).Length is 1
	Sample.Complete((Go, Counted), List(Text))(1) is Counted
	automatic = Automatic(main.lines, TypeEntry.ShortName(main.fullName), Instantiation(main.inference.types))
	options = OptionsCodegen(automatic, Path(SourcePath(main.fullName)).PathOnly.text)
	completed = options.Complete(main, automatic.Complete(main, entries.First, targets), targets)
	first = Specialization(main.Generator).Complete(main, completed, targets)
	(List(TypeEntry) + first) + entries.Slice(1, entries.Length - 1)
Linkable(types Texts, signatures Texts) Texts
	Hello.Linkable(("Strict/Logger", "Strict/Missing"), List(Text)) is ("Strict/Logger")
	Hello.Linkable(List(Text) + "Strict/Missing", List(Text) + "Strict/Missing:") is ("Strict/Missing")
	Knowing.Linkable(List(Text) + "Strict/Bytecode/HelloLogger", List(Text)).Length is 1
	mutable linked = Dictionary(Text, Boolean)
	for signatures
		linked(Signature(value).Type) = true
	for Known.keysAndValues
		linked(Signature(value.Key).Type) = true
	for types
		if value is in linked
			value
		else if IsLinkable(value)
			value
IsLinkable(type Text) Boolean
	Hello.IsLinkable("Strict/Logger")
	Hello.IsLinkable("Strict/Missing") is false
	source = File(SourcePath(type))
	source.Exists and (type.IndexOf("(") is -1 or TypeShape(source.ReadLines).IsTrait is false)
Signatures(types Texts, targets Texts) Texts
	Sample.Signatures("Strict/B", "Strict/B.Go") is ("Strict/B:Go")
	Sample.Signatures("Strict/B", ("Strict/B.Go", "Strict/B.Add")) is ("Strict/B:Add;Go")
	Sample.Signatures("Strict/B", ("Strict/B.Go", "Strict/B.F(A, B)")) is ("Strict/B:F(A, B);Go")
	used = UsedMethods(targets)
	for types
		value + ":" + Text.Combine((value is in used then used(value) else List(Text)).Sorted, ";")
BaseTypes(used Texts, targets Texts) Texts
	Sample.BaseTypes(List(Text), "Strict/Bytecode/FileCompiler.Go") is List(Text)
	"Strict/B" is not in Sample.UsedMethods(List(Text) + "Strict/C.Go")
	Sample.BaseTypes(List(Text), "Strict/B.Go") is ("Strict/B")
	Sample.BaseTypes(List(Text) + "Strict/C", "Strict/B.Go") is ("Strict/B", "Strict/C")
	mutable types = List(Mutable(Text))
	for targets
		types.Add(value.Substring(0, value.LastIndexOf(".")))
	for (types + used).Unique
		if value is not main.fullName
			value
UsedMethods(targets Texts) Dictionary(Text, Texts)
	Sample.UsedMethods(List(Text) + "Strict/B.Go")("Strict/B") is ("Go")
	Sample.UsedMethods(List(Text) + "Strict/Range.Count")("Strict/Range") is ("Count")
	Sample.UsedMethods(("Strict/B.Go", "Strict/C.Go", "Strict/B.to Text"))("Strict/B") is ("Go", "to Text")
	Sample.UsedMethods(("Strict/Number.to Text", "Strict/Number.Floor"))("Strict/Number") is ("Floor")
	Sample.UsedMethods(("Strict/B.Go", "Strict/B.Go"))("Strict/B") is ("Go")
	mutable used = Dictionary(Text, Texts)
	for targets
		dot = value.LastIndexOf(".")
		type = value.Substring(0, dot)
		method = value.Substring(dot + 1, value.Length - dot - 1)
		if IsNative(type, method) is false
			methods = type is in used then used(type) else List(Text)
			if method is not in methods
				used(type) = methods + method
	used
IsNative(type Text, method Text) Boolean
	Sample.IsNative("Strict/Compiler/BuildProfile", "IsDetailed")
	(Sample.IsNative("Strict/Text", "Upper") or Sample.IsNative("Strict/Range", "Length")) is false
	Sample.IsNative("Strict/Bytecode/B", "to") is false
	Sample.IsNative("Strict/Dictionary(Number, Number)", "get")
	Sample.IsNative("Strict/Number", "to")
	Sample.IsNative("Strict/NativeIO", "Exists") is false
	if type.LastIndexOf("/") > 6
		return TypeEntry.ShortName(type) + "." + method is in Hosted.Methods
	if method is in ("Length", "Count") or SourceName(type) is "Dictionary"
		return SourceName(type) is in ("List", "File", "Dictionary") or type is "Strict/Text" and method is "Length"
	isOwn = TypeEntry.IsBaseName(TypeEntry.ShortName(type)) or SourceName(type) is in ("File", "Directory")
	method.Split(" ").First is in Natives and isOwn
SourceName(type Text) Text
	Sample.IsNative("Strict/List(Number)", "Length")
	Sample.IsNative("Strict/File", "Count")
	Sample.IsNative("Strict/Text", "Length")
	Sample.IsNative("Strict/Text", "Count") is false
	Sample.SourceName("Strict/List(Number)") is "List"
	Sample.SourceName("Strict/Process") is "Process"
	name = type.Substring(7)
	name.IndexOf("(") is -1 then name else name.Substring(0, name.IndexOf("("))
SourcePath(type Text) Text
	Sample.IsNative("Strict/File", "ReadLines")
	Sample.IsNative("Strict/Directory", "Exists")
	Sample.SourcePath("Strict/Process") is "./Process.strict"
	Linker(Sample, Sourced = Placed).SourcePath("Strict/Tripling") is "/elsewhere/Tripling.strict"
	local = "./" + SourceName(type) + ".strict"
	if File(local).Exists
		return local
	rooted = root + "/" + SourceName(type) + ".strict"
	File(rooted).Exists then rooted else Outside("Strict/" + SourceName(type), rooted)
Outside(type Text, rooted Text) Text
	Linker(Sample, Sourced = Placed).Outside("Strict/Missing", "./Missing.strict") is "./Missing.strict"
	for Sourced.sources
		if FileCompiler.FullName(value, root) is type
			return value
	rooted
UsedTypes(entries List(TypeEntry)) Texts
	Sample.UsedTypes(TypeEntry("A", Parameters.members, List(MethodEntry))).Last is "Strict/Bytecode/Binary/MemberEntry"
	Sample.UsedTypes(TypeEntry("Strict/X", Parameters.members, List(MethodEntry))).Last is "Strict/MemberEntry"
	Sample.UsedTypes(Go) is List(Text)
	Sample.UsedTypes(Reading) is ("Strict/List(Byte)", "Strict/Byte")
	mutable types = List(Mutable(Text))
	for entries
		name = value.Name.IndexOf("/") < 0 then main.fullName else value.Name
		types = types + Elements(value.UsedTypes.Unique, name.Substring(0, name.LastIndexOf("/")))
	types
Elements(types Texts, package Text) Texts
	Sample.Elements(List(Text) + "Strict/Pair(Byte)", "Strict") is ("Strict/Pair(Byte)")
	Sample.Elements(("Strict/List(Byte)", "Strict/Text"), "Strict") is ("Strict/List(Byte)", "Strict/Byte", "Strict/Text")
	Sample.UsedTypes(Parameters) is ("Strict/List(MemberEntry)", "Strict/Bytecode/Binary/MemberEntry")
	Sample.Elements(List(Text) + "Strict/List(Character)", "Strict") is ("Strict/List(Character)", "Strict/Character")
	constant listPrefix = "Strict/List("
	mutable result = List(Mutable(Text))
	for types
		result.Add(value)
		if value.StartsWith(listPrefix) and value.LastIndexOf("(") is listPrefix.Length - 1
			result.Add(Qualify(value.Substring(listPrefix.Length, value.Length - listPrefix.Length - 1), package))
	result
Qualify(element Text, package Text) Text
	Sample.Elements(List(Text) + "Strict/List(List(Byte))", "Strict") is ("Strict/List(List(Byte))")
	Sample.Qualify("MemberEntry", "Strict/Bytecode") is "Strict/Bytecode/MemberEntry"
	Sample.Qualify("Logger", "Strict/Bytecode") is "Strict/Logger"
	nearby = package + "/" + element
	nearby is in main.typeNames then nearby else "Strict/" + element
Targets(entries List(TypeEntry)) Texts
	Sample.Targets(Go) is ("Strict/B.Go")
	Sample.Targets(Counted) is ("Strict/Range.Count")
	Sample.Targets((Go, Counted)) is ("Strict/B.Go", "Strict/Range.Count")
	Sample.Targets(TypeEntry("A", List(MemberEntry), List(MethodEntry) + DictionaryCode)).Last is "Strict/Text.Code"
	mutable targets = List(Mutable(Text))
	for entries
		targets = targets + value.Invoked
	targets
KnownNames Texts
	Knowing.KnownNames is ("HelloLogger")
	Sample.KnownNames.Length is 0
	for Known.keysAndValues
		main.Local(Signature(value.Key).Type)
