has values ValueCodegen
has borrowing Texts = List(Text)
constant Plain = ListCodegen(ValueCodegen.Plain)
constant Declared = CodeBlock.Empty.Declare("x", "Number")
constant Shared = CodeBlock.Empty.Declare("values", "Numbers").Sharing("values", true)
constant Owned = CodeBlock.Empty.Declare("values", "Numbers").Sharing("values", false)
constant Appending = BodyParser("Run", "\tvalues = values + 1").Block(1, 1).children(0)
constant WritingLoop = BodyParser("Run", "\tfor 3", "\t\tvalues(index) = index").Block(1, 1).children(0)
constant SharingLoop = BodyParser("Run", "\tfor values", "\t\tvalues(index) = index").Block(1, 1).children(0)
constant BranchCopy = BodyParser("Run", "\tmutable other = (1, 2)", "\tlet saved = other", "\tif 1 > 2", "\t\tother(0) = 5", "\tother(1) = 6").Block(1, 1)
constant Iterated = ListCodegen(LoopCodegen.Iterating.methods.values)
constant Colored = ListCodegen(ConversionCodegen.Colored.values)
constant AddColor = SyntaxNode("MethodCall", "Add", (ConversionCodegen.Pixels, ConversionCodegen.NewColor))
constant Counted = ListCodegen(ValueCodegen(TypeInference(KnownTypes.Sample, TypeInference.Limits), KnownTypes.NoMembers, CallTarget.Plain))
constant Limits = SyntaxNode("List", "", (SyntaxNode("Member", "Limit", SyntaxNode("Identifier", "Count")), ValueCodegen.One))
Of(node SyntaxNode, block CodeBlock) CodeBlock
	Plain.Of(ValueCodegen.Ones, CodeBlock.Empty).instructions.Length is 1
	Plain.Of(ValueCodegen.Ones, CodeBlock.Empty).instructions(0).texts is ("Strict/List(Number)")
	Plain.Of(SyntaxNode("List", "", ValueCodegen.Hi), CodeBlock.Empty).instructions(0).payload is (0, 6, -1, 1, 4, -2)
	Plain.IsUsed(SyntaxNode("Return", "", ValueCodegen.One), 0, true)
	Plain.IsUsed(SyntaxNode("Return", "", ValueCodegen.One), 0, false) is false
	Plain.IsUsed(SyntaxNode("Body", "", ValueCodegen.Ones.children), 1, true)
	Plain.IsUsed(SyntaxNode("Body", "", ValueCodegen.Ones.children), 0, true) is false
	Plain.IsUsed(SyntaxNode("If", "", ValueCodegen.Ones.children), 1, false) is false
	Counted.Of(Limits, CodeBlock.Empty).instructions(0).payload is (0, 6, -1, 2, 1, 3, 1, 1)
	SyntaxNode("List", "", Literals(node)).IsLiteral then Constant(node, block) else Built(node, block)
Literals(node SyntaxNode) List(SyntaxNode)
	Counted.Literals(Limits).First.text is "3"
	Plain.IsUsed(SyntaxNode("Else", "", ValueCodegen.Ones.children), 1, false) is false
	Plain.IsUsed(SyntaxNode("Binary", "then", ValueCodegen.Ones.children), 1, false) is false
	Plain.IsUsed(SyntaxNode("Binary", "else", ValueCodegen.Ones.children), 0, true)
	Plain.IsUsed(SyntaxNode("MethodCall", "Remove", ValueCodegen.One), 0, true)
	Plain.IsUsed(SyntaxNode("MethodCall", "B", ValueCodegen.One), 0, true) is false
	Plain.IsUsed(SyntaxNode("Binary", "is in", ValueCodegen.Ones.children), 1, true) is false
	Plain.IsUsed(SyntaxNode("Binary", "+", ValueCodegen.Ones.children), 1, true)
	for node.children
		ConstantFolding(values.target.TypeName, values.inference).Folded(value)
Constant(node SyntaxNode, block CodeBlock) CodeBlock
	Plain.Constant(ValueCodegen.Ones, CodeBlock.Empty).instructions(0).payload is (0, 6, -1, 2, 1, 1, 1, 1)
	Plain.Constant(SyntaxNode("List", "", ValueCodegen.Hi), CodeBlock.Empty).instructions(0).texts.Last is "Hi"
	mutable texts = List(Mutable(Text))
	texts.Add(values.target.FullName(values.TypeOf(node, block)))
	mutable content = List(Number) + block.register + 6 + -1 + node.children.Length
	for Literals(node)
		if value.Kind is "Text"
			texts.Add(value.Unquoted)
		let number = value.Kind is "Number" then value.text to Number else 0
		content = content + (value.Kind is "Text" then (4, -texts.Length) else InstructionEntry.NumberValue(number))
	block.Load(InstructionEntry(InstructionType.LoadConstantToRegister, texts, content))
Built(node SyntaxNode, block CodeBlock) CodeBlock
	Plain.Built(ValueCodegen.Ones, CodeBlock.Empty).instructions.Last.texts is ("listResult0")
	Plain.Added(ValueCodegen.Edits(0), CodeBlock.Empty).instructions(1).kind is InstructionType.InvokeWriteToList
	Plain.Built(SyntaxNode("List", "", (ValueCodegen.NoNode, ValueCodegen.One)), CodeBlock.Empty).instructions.Length is 6
	let name = "listResult" + block.nextId
	let type = values.target.FullName(values.TypeOf(node, block))
	let empty = InstructionEntry(InstructionType.LoadConstantToRegister, type, (0, 6, -1, 0))
	mutable result = block.Add(MethodCodegen.StoreConstant(empty, name)).WithNextId
	for node.children
		let element = values.Expression(value, result)
		let write = InstructionEntry.Named(InstructionType.InvokeWriteToList, element.Result, name)
		result = element.Add(write).At(block.register)
	result.Load(InstructionEntry.Named(InstructionType.LoadVariableToRegister, block.register, name))
Added(node SyntaxNode, block CodeBlock) CodeBlock
	Plain.Added(ValueCodegen.Edits(0), CodeBlock.Empty).register is 2
	Plain.Added(ValueCodegen.Edits(1), CodeBlock.Empty).instructions(1).kind is InstructionType.InvokeRemove
	Plain.Added(ValueCodegen.Edits(0), Shared).instructions.Last.kind is InstructionType.StoreRegisterToVariable
	Colored.Added(AddColor, ConversionCodegen.Pixelated).instructions(3).texts(1) is "to"
	let name = node.children(0).text
	if block.Owns(name) is false
		return Copied(node, block)
	let added = values.Expression(ConversionCodegen(values).Operand(node, block), block)
	let kind = node.text is "Add" then InstructionType.InvokeWriteToList else InstructionType.InvokeRemove
	let written = added.Add(InstructionEntry.Named(kind, added.Result, name))
	written.Load(InstructionEntry.Named(InstructionType.LoadVariableToRegister, written.register, name))
Copied(node SyntaxNode, block CodeBlock) CodeBlock
	Plain.Copied(ValueCodegen.Edits(1), Shared).instructions(2).payload is (3, 0, 1, 2)
	Plain.Copied(ValueCodegen.Edits(1), Shared).instructions(2).kind is InstructionType.Subtract
	Plain.Copied(ValueCodegen.Edits(0), Shared).instructions(2).kind is InstructionType.Add
	let list = values.Expression(node.children(0), block)
	let operand = ConversionCodegen(values).Operand(node, block)
	let isElement = ConversionCodegen(values).IsElement(values.TypeOf(node.children(0), block), operand, block)
	let element = values.Expression((isElement then SyntaxNode("List", "", List(SyntaxNode) + operand) else operand), list)
	let operation = node.text is "Add" then InstructionType.Add else InstructionType.Subtract
	let changed = element.Load(InstructionEntry.Binary(operation, (list.Result, element.Result, element.register)))
	changed.Stored(node.children(0).text)
CopiedBefore(loop SyntaxNode, block CodeBlock, isUsed Boolean) CodeBlock
	Plain.CopiedBefore(WritingLoop, Shared, false).instructions(0).kind is InstructionType.CopyList
	MethodCodegen.Plain.Body(BranchCopy, CodeBlock.Empty).instructions.Last.payload.Length is 3
	Plain.CopiedBefore(SharingLoop, Shared, false).instructions.Length is 0
	Plain.CopiedBefore(WritingLoop, Owned, false).instructions.Length is 0
	mutable result = block
	for ElementWritten(loop.children.Last)
		let owned = result.Sharing(value, false)
		if (result.Owns(value) is false) and Disowned(loop, owned, isUsed).Owns(value)
			result = owned.Add(InstructionEntry(InstructionType.CopyList, value, -1))
	result
ElementWritten(node SyntaxNode) Texts
	Plain.ElementWritten(WritingLoop) is ("values")
	Plain.ElementWritten(Appending).Length is 0
	Plain.ElementWritten(BodyParser("Run", "\tx.a(0) = 5").Block(1, 1).children(0)) is ("x.a")
	if (node.Kind is "Reassignment") and (node.children(0).Kind is "Call")
		return List(Text) + node.children(0).text
	if (node.Kind is "Reassignment") and (node.children(0).Kind is "MethodCall")
		return List(Text) + (node.children(0).children(0) to Text + "." + node.children(0).text)
	mutable names = List(Mutable(Text))
	for node.children
		names = names + ElementWritten(value)
	names
IsAppend(node SyntaxNode, block CodeBlock) Boolean
	Plain.IsAppend(Appending, Owned)
	Plain.IsAppend(BodyParser("Run", "\tvalues = values + values").Block(1, 1).children(0), Owned) is false
	Plain.IsAppend(BodyParser("Run", "\tx = values + 1").Block(1, 1).children(0), Owned) is false
	Plain.IsAppend(BodyParser("Run", "\ttext = text + 1").Block(1, 1).children(0), Owned.Declare("text", "Texts")) is false
	let sum = node.children.Last
	if node.Kind is not "Reassignment" or sum.text is not "+"
		return false
	let list = sum.children(0)
	let types = values.inference.types
	let isList = (list to Text is node.children(0) to Text) and types.IsPlural(values.TypeOf(list, block))
	let isVariable = (list.Kind is "Identifier") and (values.target.IsMember(values.target.TypeName, list.text) is false)
	isList and isVariable and (types.IsPlural(values.TypeOf(sum.children(1), block)) is false)
IsNew(node SyntaxNode) Boolean
	Plain.IsNew(ValueCodegen.Ones) is false
	Plain.IsNew(SyntaxNode("List", "", (SyntaxNode("Number", "1"), SyntaxNode("Identifier", "x"))))
	Plain.IsNew(ValueCodegen.GreeterText) is false
	Plain.IsNew(ValueCodegen.ToText) is false
	Plain.IsNew(SyntaxNode("Binary", "+", (SyntaxNode("Identifier", "values"), SyntaxNode("Number", "3")))) is false
	Plain.IsNew(SyntaxNode("Binary", "-", ValueCodegen.Ones.children))
	Plain.IsNew(SyntaxNode("Call", "List", ValueCodegen.One))
	Plain.IsNew(SyntaxNode("Call", "B", ValueCodegen.One)) is false
	Plain.IsNew(SyntaxNode("Member", "List", ValueCodegen.One)) is false
	if node.Kind is "Binary"
		return node.text is "+" then IsNew(node.children(0)) else node.text is not in ("to", "then", "else")
	((node.Kind is "List") and (node.IsLiteral is false)) or ((node.Kind is "Call") and (node.text is "List"))
Disowned(node SyntaxNode, block CodeBlock, isUsed Boolean) CodeBlock
	Plain.Disowned(BodyParser("Run", "\tlet saved = values").Block(1, 1), Owned, false).Owns("values") is false
	Plain.Disowned(BodyParser("Run", "\tvalues.Add(1)").Block(1, 1), Owned, false).Owns("values")
	Plain.Disowned(BodyParser("Run", "\t1 is not in values").Block(1, 1), Owned, false).Owns("values")
	Plain.Disowned(BodyParser("Run", "\tif 1 > 2", "\t\treturn values").Block(1, 1), Owned, false).Owns("values")
	if node.Kind is "Identifier"
		return isUsed then block.Disowned(node.text) else block
	mutable result = IsShared(node, block) then block.Disowned(node.children(0) to Text) else block
	for node.children
		let used = IsUsed(node, index, isUsed) and (Borrowing(values, borrowing).IsBorrowed(node, index, result) is false)
		result = Disowned(value, result, used)
	result
IsShared(node SyntaxNode, block CodeBlock) Boolean
	Plain.IsShared(BodyParser("Run", "\tvalues = other").Block(1, 1).children(0), Owned)
	Plain.IsShared(Appending, Owned) is false
	Plain.IsShared(BodyParser("Run", "\tvalues = List(Number)").Block(1, 1).children(0), Owned) is false
	(node.Kind is "Reassignment") and (IsNew(node.children(1)) is false) and (IsAppend(node, block) is false)
IsUsed(parent SyntaxNode, position Number, isUsed Boolean) Boolean
	Plain.IsUsed(ValueCodegen.Edits(0), 0, true)
	Plain.IsUsed(ValueCodegen.GreeterText, 0, true) is false
	let isLast = position is parent.children.Length - 1
	if parent.Kind is in ("Body", "Return")
		return parent.Kind is "Body" then (isUsed and isLast) else (isUsed or (borrowing.Length > 0))
	let isBranch = isLast and ((parent.Kind is in ("If", "ElseIf", "Else", "ElseValue", "For")) or (parent.text is "then"))
	if isBranch or (parent.text is "else")
		return isUsed
	if (parent.Kind is "MethodCall") and (position is 0)
		return isUsed and (parent.text is in ("Add", "Remove"))
	let instance = parent.text is in ("is in", "is not in") then 1 else 0
	position is not instance or parent.Kind is not in ("Member", "Binary", "If", "ElseIf", "Reassignment")
Argument(node SyntaxNode, position Number, parameters Texts, block CodeBlock) CodeBlock
	ListCodegen(ValueCodegen.Plain, ("values")).IsUsed(SyntaxNode("Return", "", ValueCodegen.One), 0, false)
	Plain.IsUsed(SyntaxNode("Return", "", ValueCodegen.Ones.children), 0, true)
	Plain.Argument(ValueCodegen.NoNode, 0, List(Text) + "Numbers", Declared).instructions.Length is 4
	Plain.Argument(ValueCodegen.NoNode, 0, List(Text) + "Number", Declared).instructions.Length is 1
	Plain.Argument(ValueCodegen.NoNode, 1, List(Text), Declared).instructions.Length is 1
	Iterated.Argument(ValueCodegen.Ones, 0, ("List"), Declared).instructions(0).payload(3) is 2
	let parameter = position < parameters.Length then parameters(position) else ""
	let element = values.inference.types.ElementType(parameter) is values.TypeOf(node, block)
	let wraps = values.inference.types.IsPlural(parameter) and element
	let converted = ConversionCodegen(values).Converted(node, parameter, block)
	values.Expression((wraps then SyntaxNode("List", "", node) else converted), block)
Grouped(node SyntaxNode, first Number, parameters Number) SyntaxNode
	Plain.Grouped(SyntaxNode("Call", "B", (ValueCodegen.One, ValueCodegen.One)), 0, 1).children.Length is 1
	Plain.Grouped(ValueCodegen.Edits(0), 1, 1).children(1).Kind is "Number"
	Plain.Grouped(ValueCodegen.Ones, 0, 1).children(0) is ValueCodegen.Ones
	Plain.Grouped(ValueCodegen.Ones, 0, 2) is ValueCodegen.Ones
	Plain.Grouped(SyntaxNode("B", "", ValueCodegen.Ones.children + ValueCodegen.One), 1, 1).children(1).Kind is "List"
	if parameters is not 1 or node.children.Length - first < 2
		return node
	mutable arguments = List(Mutable(SyntaxNode))
	for Range(first, node.children.Length)
		arguments.Add(node.children(value))
	let grouped = SyntaxNode("List", "", arguments)
	SyntaxNode(node.Kind, node.text, (first is 1 then (node.children(0), grouped) else List(SyntaxNode) + grouped))
Empty(type Text, block CodeBlock) CodeBlock
	Plain.IsUsed(SyntaxNode("MethodCall", "B", ValueCodegen.Ones.children), 1, true)
	Plain.Disowned(BodyParser("Run", "\tvalues = List(Number)").Block(1, 1), Owned, false).Owns("values")
	Plain.Empty("Numbers", CodeBlock.Empty).instructions(0).texts is ("Strict/List(Number)")
	Plain.IsAppend(SyntaxNode("Declaration", "", Appending.children), Owned) is false
	Plain.IsAppend(BodyParser("Run", "	x = x + 1").Block(1, 1).children(0), Owned.Declare("x", "Number")) is false
	Plain.Disowned(BodyParser("Run", "	values = values to Numbers").Block(1, 1), Owned, false).Owns("values") is false
	let listType = values.target.FullName(type)
	block.Load(InstructionEntry(InstructionType.LoadConstantToRegister, listType, (block.register, 6, -1, 0)))