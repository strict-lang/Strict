has methods MethodCodegen
constant Plain = LoopCodegen(MethodCodegen.Plain)
constant DoubledBody = BodyParser("Doubled Numbers", "\tfor 3", "\t\tindex * 2").Block(1, 1)
constant ProductBody = BodyParser("Product Number", "\tfor 3", "\t\t* index").Block(1, 1)
constant BranchLoops = BodyParser("Picked Numbers", "\tif 1 > 2", "\t\tfor 3", "\t\t\tindex", "\telse", "\t\tfor 2", "\t\t\tindex").Block(1, 1)
constant FilterLoop = MethodCodegen.FilterBody.children(0).children.Last
constant ForIterator = Scope(("for", "Length"), ("Iterator(Number)", "Number"))
constant Unscoped = (CallTarget.NoScope, CallTarget.NoScope, CallTarget.NoScope)
constant Iterating = LoopCodegen(MethodCodegen(ValueCodegen(TypeInference(KnownTypes(("A", "List", "Range"), Unscoped, (ForIterator, ForIterator, ForIterator), Unscoped), Unscoped), ValueCodegen.Plain.methods, CallTarget.Plain)))
constant NestedLoop = BodyParser("Pairs Numbers", "\tfor 2", "\t\tfor 3", "\t\t\tindex").Block(1, 1).children(0).children.Last
constant ForA = BodyParser("Run", "\tfor a", "\t\tvalue").Block(1, 1).children(0)
constant IndexA = BodyParser("Run", "\tfor a", "\t\tindex").Block(1, 1).children(0)
constant RowsBody = BodyParser("Rows List(Numbers)", "\tmutable row = (1)", "\tfor 2", "\t\trow.Add(index)", "\t\trow").Block(1, 1)
constant Leaded = BodyParser("Run", "\tlet x = 1", "\tfor 3", "\t\tindex").Block(1, 1)
constant BareFor = BodyParser("Upper Text", "\tfor", "\t\tUpper").Block(1, 1).children(0)
constant Numbered = MethodCodegen(ValueCodegen(TypeInference(KnownTypes.Sample, CallTarget.NoScopes), KnownTypes.NoMembers, CallTarget.Plain))
constant NumberPlus = KnownTypes(List(Text) + "Plus", List(Scope) + Scope(List(Text) + "number", List(Text) + "Number"), List(Scope) + Scope(List(Text) + "+", List(Text) + "Plus"), KnownTypes.NoMembers)
constant Adding = MethodCodegen(ValueCodegen(TypeInference(NumberPlus, CallTarget.NoScopes), KnownTypes.NoMembers, CallTarget.Plain))
constant OnText = LoopCodegen(MethodCodegen(ValueCodegen(ValueCodegen.NoTypes, ValueCodegen.Plain.methods, CallTarget(CallTarget.NoTypes, TypeShape("has characters"), "Strict/Text", List(Text)))))
constant Wanting = CodeBlock.Empty.Declare(CodeBlock.ElementMarker, "Text")
constant Letters = BodyParser("Letters Texts", "\tfor 2", "\t\tx(index)").Block(1, 1)
Aggregation(body SyntaxNode, returnType Text) Text
	Plain.Aggregation(MethodCodegen.SumBody, "Number") is "sum"
	Plain.Aggregation(DoubledBody, "Boolean") is "any"
	LoopCodegen(TypeSums.Paired.methods).Aggregation(MethodCodegen.SumBody, "Pair") is "add"
	Plain.Aggregation(BranchLoops, "Numbers") is "list"
	LoopCodegen(Numbered).Aggregation(MethodCodegen.SumBody, "Count") is "sum"
	let loop = BranchValues(returnType).LastLoop(body)
	let isList = methods.values.inference.types.IsPlural(returnType) or returnType.StartsWith("List(")
	if (loop.Kind is not "For") or (returnType is "Boolean") or isList
		return loop.Kind is not "For" then "" else (isList then "list" else "any")
	Reduced(BranchValues(returnType).Reduction(loop.children.Last.children.Last), returnType)
Reduced(reduction Text, returnType Text) Text
	LoopCodegen(Numbered).Reduced("*", "Count") is "product"
	LoopCodegen(TypeSums.Paired.methods).Reduced("*", "Pair") is ""
	LoopCodegen(Adding).Reduced("", "Plus") is "add"
	let hasAdd = OperatorCodegen(methods.values).HasOperator(returnType, "+")
	let member = methods.values.inference.types.MembersOf(returnType).TypeOf("number")
	if ((hasAdd is false) and (member is "Number")) or (returnType is in ("Number", "Text"))
		return reduction is in ("", "+") then "sum" else (reduction is "*" then "product" else "")
	(reduction is "") and hasAdd then "add" else ""
Aggregated(body SyntaxNode, block CodeBlock, returnType Text) CodeBlock
	Plain.Aggregated(MethodCodegen.SumBody, CodeBlock.Empty, "Number").Result is 0
	Plain.Aggregated(DoubledBody, CodeBlock.Empty, "Numbers").instructions(0).texts.Last is "forResult"
	Plain.Aggregated(ProductBody, CodeBlock.Empty, "Number").instructions(0) is InstructionEntry.LoadNumber(0, 1)
	Plain.Aggregated(DoubledBody, CodeBlock.Empty, "Boolean").instructions.Length is 13
	Plain.Aggregated(RowsBody, CodeBlock.Empty, "List(Numbers)").instructions(6).kind is InstructionType.Add
	let aggregation = Aggregation(body, returnType)
	if aggregation is in ("", "any")
		return methods.Valued((aggregation is "any" then AnyTrue(body) else body), block, returnType)
	let started = Initialized(body, block, returnType, aggregation)
	if body.children.Last.Kind is not "For"
		return Finished(methods.Body(BranchValues(aggregation).Rewritten(body), started), block.register)
	Finished(Loop(body.children.Last, started, aggregation), block.register)
Initialized(body SyntaxNode, block CodeBlock, returnType Text, aggregation Text) CodeBlock
	Plain.Initialized(DoubledBody, CodeBlock.Empty, "Numbers", "list").scope.TypeOf("forResult") is "Numbers"
	Plain.Initialized(Leaded, CodeBlock.Empty, "Numbers", "list").instructions(0).texts.Last is "x"
	Plain.Initialized(DoubledBody, Wanting, "Text", "sum").scope.TypeOf(CodeBlock.ElementMarker) is ""
	Plain.Aggregated(Letters, CodeBlock.Empty.Declare("x", "Text"), "Texts").instructions(6).kind is InstructionType.Invoke
	let leading = body.children.Last.Kind is "For" then Leading(body, block) else block
	let element = aggregation is "list" then methods.values.inference.types.ElementType(returnType) else ""
	let started = Started(leading, returnType, aggregation).Declare("forResult", returnType)
	started.Declare(CodeBlock.ElementMarker, element).At(block.register)
Finished(looped CodeBlock, register Number) CodeBlock
	Plain.Finished(CodeBlock.Empty.Declare("forResult", "Numbers"), 0).instructions.Last.texts.Last is "forResult"
	Plain.Started(CodeBlock.Empty, "Text", "sum").instructions(0) is InstructionEntry.LoadText(0, "")
	Plain.Started(CodeBlock.Empty, "Text", "sum").instructions(1).texts is ("forResult")
	Plain.Started(CodeBlock.Empty, "Number", "sum").instructions(1).texts is ("forResult")
	Plain.Started(CodeBlock.Empty, "Number", "sum").instructions(0) is InstructionEntry.LoadNumber(0, 0)
	LoopCodegen(TypeSums.Paired.methods).Started(CodeBlock.Empty, "Pair", "add").instructions.Length is 5
	LoopCodegen(TypeSums.Paired.methods).Collected(CodeBlock.Empty.At(1), "add").instructions.Length is 5
	Plain.Collected(CodeBlock.Empty.At(1), "sum").instructions(1).kind is InstructionType.Add
	Plain.Collected(CodeBlock.Empty.At(1), "sum").instructions(0).texts is ("forResult")
	Plain.Collected(CodeBlock.Empty.At(1), "sum").instructions(2).texts is ("forResult")
	let at = looped.At(register)
	at.Load(InstructionEntry.Named(InstructionType.LoadVariableToRegister, at.register, "forResult"))
Leading(body SyntaxNode, block CodeBlock) CodeBlock
	Plain.Leading(MethodCodegen.SumBody, CodeBlock.Empty).instructions.Length is 0
	Plain.Collected(CodeBlock.Empty.At(1), "list").instructions(0).texts is ("forResult")
	LoopCodegen(TypeSums.Paired.methods).Aggregation(ProductBody, "Pair") is ""
	Plain.Aggregation(MethodCodegen.SumBody, "Pair") is ""
	Plain.Aggregation(BodyParser("Minus Number", "	for 3", "		/ index").Block(1, 1), "Number") is ""
	Plain.Aggregated(BranchLoops, CodeBlock.Empty, "Numbers").scope.TypeOf("forResult") is "Numbers"
	Plain.Aggregated(BranchLoops, CodeBlock.Empty, "Numbers").instructions.Length is 25
	mutable result = block
	for body.children.Length - 1
		let statement = methods.Statement(body.children(index), result.At(block.register), methods.HasElse(body, index))
		result = methods.Lined(statement, result.instructions.Length, body.children(index).line)
	result.At(block.register)
AnyTrue(body SyntaxNode) SyntaxNode
	Plain.AnyTrue(DoubledBody).children.Last.Kind is "Boolean"
	Plain.AnyTrue(DoubledBody).children(0).children.Last.children(0).Kind is "If"
	Plain.AnyTrue(MethodCodegen.LoopBody).children(0) is MethodCodegen.LoopBody.children(0)
	Plain.AnyTrue(DoubledBody).Kind is "Body"
	Plain.AnyTrue(DoubledBody).children.Last is SyntaxNode("Boolean", "false")
	mutable statements = List(Mutable(SyntaxNode))
	for body.children
		statements.Add(index is body.children.Length - 1 then BranchValues("any").Branch(value) else value)
	SyntaxNode("Body", body.text, statements + SyntaxNode("Boolean", "false"))
Started(block CodeBlock, returnType Text, aggregation Text) CodeBlock
	Plain.Started(CodeBlock.Empty, "Number", "sum").instructions.Length is 2
	Plain.Started(CodeBlock.Empty, "Numbers", "list").instructions.Length is 1
	if returnType is "Text"
		return block.Load(InstructionEntry.LoadText(block.register, "")).Stored("forResult")
	let start = aggregation is "product" then 1 else 0
	if aggregation is in ("sum", "product")
		return block.Load(InstructionEntry.LoadNumber(block.register, start)).Stored("forResult")
	if aggregation is "add"
		return TypeSums(methods).Started(block, returnType)
	let type = methods.values.target.FullName(returnType)
	let empty = InstructionEntry(InstructionType.LoadConstantToRegister, type, (0, 6, -1, 0))
	block.Add(MethodCodegen.StoreConstant(empty, "forResult"))
Collected(block CodeBlock, aggregation Text) CodeBlock
	Plain.Collected(CodeBlock.Empty.Load(InstructionEntry.LoadNumber(0, 1)), "sum").instructions.Length is 4
	Plain.Collected(CodeBlock.Empty.Load(InstructionEntry.LoadNumber(0, 1)), "list").instructions.Length is 2
	Plain.Collected(CodeBlock.Empty.At(1), "product").instructions(1).kind is InstructionType.Multiply
	if aggregation is "list"
		return block.Add(InstructionEntry.Named(InstructionType.InvokeWriteToList, block.Result, "forResult"))
	if aggregation is "add"
		return TypeSums(methods).Added(block)
	let loaded = block.Load(InstructionEntry.Named(InstructionType.LoadVariableToRegister, block.register, "forResult"))
	let operation = aggregation is "product" then InstructionType.Multiply else InstructionType.Add
	loaded.Load(InstructionEntry.Binary(operation, (loaded.Result, block.Result, loaded.register))).Stored("forResult")
Loop(node SyntaxNode, block CodeBlock, aggregation Text) CodeBlock
	Plain.Begin(SyntaxNode("Call", "Range", ValueCodegen.Ones.children), CodeBlock.Empty).instructions.Length is 3
	Plain.Begin(SyntaxNode("Call", "Range", ValueCodegen.Ones.children), CodeBlock.Empty).instructions(2).payload(1) is 1
	Plain.Loop(LoopPeeling.Summing, LoopPeeling.Counted, "").instructions.Last.kind is InstructionType.LoopEnd
	Plain.Loop(LoopPeeling.Summing, LoopPeeling.Counted, "").instructions.Length is 30
	FileCompiler.Unoptimized.Loop(LoopPeeling.Summing, LoopPeeling.Counted, "").instructions.Length is 22
	let merged = methods.values.isOptimizing then FractionLoop.Merged(node) else node
	if merged.Kind is "Body"
		return methods.Body(merged, block)
	let peeled = methods.values.isOptimizing then LoopPeeling(methods, block).Peeled(node, aggregation) else node
	if peeled.Kind is "Body"
		return LoopPeeling(methods, block).Emitted(peeled, LoopCodegen(methods), aggregation)
	Unpeeled(node, block, aggregation)
Unpeeled(node SyntaxNode, block CodeBlock, aggregation Text) CodeBlock
	MethodCodegen.Plain.Generate(MethodCodegen.LoopBody, MethodCodegen.NoScope, "Number").instructions.Length is 6
	Plain.Loop(DoubledBody.children(0), CodeBlock.Empty, "list").instructions.Last.kind is InstructionType.LoopEnd
	Plain.Loop(DoubledBody.children(0), CodeBlock.Empty, "list").instructions.Last.line is 2
	Plain.Loop(DoubledBody.children(0), CodeBlock.Empty.Declare("value", "Text"), "").scope.TypeOf("outer") is ""
	Plain.Loop(Repeating.Countdown, CodeBlock.Empty.Declare("x", "Number"), "").instructions.Last.payload.Last is -1
	let loop = Repeating(methods.values).Rewritten(node)
	let copied = ListCodegen(methods.values).CopiedBefore(loop, block, aggregation is not "")
	let declared = Declared(loop, copied)
	let collected = aggregation is "" then declared else ListCodegen(methods.values).Disowned(loop, declared, true)
	let body = loop.children.Last
	let looped = aggregation is "" then methods.Body(body, declared) else AggregatedLoop(body, collected, aggregation)
	methods.Lined(Repeating(methods.values).Ended(node, looped, copied), block.instructions.Length, node.line)
Declared(node SyntaxNode, block CodeBlock) CodeBlock
	Iterating.Declared(ForA, CodeBlock.Empty.Declare("a", "A")).scope.TypeOf("value") is "Number"
	Iterating.Declared(IndexA, CodeBlock.Empty.Declare("a", "A")).instructions(1).texts(1) is "Length"
	Plain.Declared(BareFor, CodeBlock.Empty.Declare("value", "Text")).instructions(0).texts is ("value")
	OnText.Declared(BareFor, CodeBlock.Empty.Declare("value", "Text")).scope.TypeOf("value") is "Character"
	let iterator = Iterated((node.HasValue then node.children(0) else SyntaxNode("Identifier", "value")), block)
	let isRange = (iterator.Kind is "Call") and (iterator.text is "Range")
	let bodies = MethodBodies(methods.values.target.TypeName, methods.values.target.shape, methods.values.inference)
	let iterated = node.HasValue then methods.values.TypeOf(iterator, block) else bodies.IteratedType
	let element = isRange then "Number" else bodies.Element(iterated)
	let begun = Begin(Counted(iterator, node.children.Last, block, element), block)
	let nested = begun.Declare("index", "Number").Declare("outer", block.scope.TypeOf("value"))
	nested.Declare("value", element).Sharing("value", true).Sharing("outer", true)
Counted(iterator SyntaxNode, body SyntaxNode, block CodeBlock, element Text) SyntaxNode
	Plain.Counted(SyntaxNode("Number", "3"), DoubledBody, CodeBlock.Empty, "Number").text is "3"
	Plain.Counted(SyntaxNode("Identifier", "for"), DoubledBody, CodeBlock.Empty, "Number").text is "for"
	Plain.Counted(SyntaxNode("Member", "for", BranchValues.Value), IndexA.children.Last, CodeBlock.Empty, "").text is "for"
	Iterating.Declared(ForA, CodeBlock.Empty.Declare("a", "A")).instructions(1).texts(1) is "for"
	if iterator.Kind is not "Member" or iterator.text is not "for"
		return iterator
	let type = methods.values.TypeOf(iterator.children(0), block)
	if methods.values.inference.types.MethodsOf(type).TypeOf("Length") is not "Number"
		return iterator
	let scope = block.scope.With("outer", block.scope.TypeOf("value")).With("value", element)
	UsesValue(body, scope) then iterator else SyntaxNode("Member", "Length", iterator.children(0))
UsesValue(body SyntaxNode, scope Scope) Boolean
	Plain.UsesValue(DoubledBody, Scope(("value", "outer"), ("Number", "Number")))
	Plain.UsesValue(IndexA.children.Last, Scope(("value", "outer"), ("Number", "Number"))) is false
	Plain.UsesValue(ForA.children.Last, Scope(("value", "outer"), ("Number", "Number")))
	mutable names = List(Mutable(Text))
	for body.Statements
		if value.Kind is "For"
			return true
		names = names + value.HeadNames
	for names
		if (value is in ("value", "outer")) or (methods.values.target.ImplicitOwner(value, scope) is "value")
			return true
	false
Iterated(iterator SyntaxNode, block CodeBlock) SyntaxNode
	Iterating.Iterated(SyntaxNode("Identifier", "a"), CodeBlock.Empty.Declare("a", "A")).text is "for"
	Plain.Iterated(SyntaxNode("Number", "3"), CodeBlock.Empty).text is "3"
	Iterating.Iterated(SyntaxNode("Identifier", "a"), CodeBlock.Empty.Declare("a", "As")).text is "a"
	Iterating.Iterated(SyntaxNode("Identifier", "r"), CodeBlock.Empty.Declare("r", "Range")).text is "r"
	let type = methods.values.TypeOf(iterator, block)
	let types = methods.values.inference.types
	if (type is "Range") or types.IsPlural(type)
		return iterator
	types.MethodsOf(type).TypeOf("for").StartsWith("Iterator") then SyntaxNode("Member", "for", iterator) else iterator
Begin(iterator SyntaxNode, block CodeBlock) CodeBlock
	Plain.Begin(SyntaxNode("Number", "3"), CodeBlock.Empty).instructions.Last.kind is InstructionType.LoopBegin
	Plain.Begin(SyntaxNode("Identifier", "r"), CodeBlock.Empty.Declare("r", "Range")).instructions.Length is 4
	Plain.Begin(SyntaxNode("Number", "3"), CodeBlock.Empty).instructions.Last is InstructionEntry.LoopBegin(0, -1)
	Plain.UsesValue(BodyParser("Outer Number", "	outer").Block(1, 1), Scope(("value", "outer"), ("Number", "Number")))
	let isRange = (iterator.Kind is "Call") and (iterator.text is "Range")
	if (isRange is false) and (methods.values.TypeOf(iterator, block) is "Range")
		return RangeFields(iterator, block)
	let start = methods.values.Expression((isRange then iterator.children(0) else iterator), block)
	let end = isRange then methods.values.Expression(iterator.children(1), start) else start
	end.Add(InstructionEntry.LoopBegin(start.Result, (isRange then end.Result else -1)))
RangeFields(iterator SyntaxNode, block CodeBlock) CodeBlock
	Plain.RangeFields(SyntaxNode("Identifier", "r"), CodeBlock.Empty).instructions(1).texts is ("Start", "Range")
	Plain.RangeFields(SyntaxNode("Identifier", "r"), CodeBlock.Empty).instructions(2).texts is ("ExclusiveEnd", "Range")
	Plain.Declared(BareFor, CodeBlock.Empty.Declare("value", "Text")).scope.TypeOf("outer") is "Text"
	Plain.Declared(BareFor, CodeBlock.Empty.Declare("value", "Text")).scope.TypeOf("index") is "Number"
	Plain.Declared(BareFor, CodeBlock.Empty.Declare("value", "Text")).Owns("outer") is false
	Plain.Declared(BareFor, CodeBlock.Empty.Declare("value", "Text")).Owns("value") is false
	let range = methods.values.Expression(iterator, block)
	let start = methods.values.Field("Start", "Range", range, range.Result)
	let end = methods.values.Field("ExclusiveEnd", "Range", start, range.Result)
	end.Add(InstructionEntry.LoopBegin(start.Result, end.Result))
AggregatedLoop(body SyntaxNode, block CodeBlock, aggregation Text) CodeBlock
	Plain.AggregatedLoop(FilterLoop, CodeBlock.Empty, "sum").instructions.Last.kind is InstructionType.JumpEnd
	Plain.AggregatedLoop(NestedLoop, CodeBlock.Empty, "list").instructions.Last.kind is InstructionType.LoopEnd
	Plain.AggregatedLoop(NestedLoop, CodeBlock.Empty, "sum").instructions.Last.kind is InstructionType.LoopEnd
	Plain.AggregatedLoop(ProductBody.children(0).children.Last, CodeBlock.Empty, "product").instructions.Length is 4
	let last = body.children.Last
	if last.Kind is "For"
		return Loop(last, Leading(body, block), aggregation)
	if BranchValues(aggregation).Reduction(last) is not ""
		return Collected(methods.values.Expression(last.children(1), Leading(body, block)), aggregation)
	if last.Kind is not in ("If", "ElseIf", "Else")
		return Collected(methods.Valued(body, block, block.scope.TypeOf(CodeBlock.ElementMarker)), aggregation)
	methods.Body(BranchValues(aggregation).Rewritten(body), block)