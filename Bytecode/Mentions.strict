has lines Texts
constant Typo = Mentions(("constant Limit = 3", "has numbr", "has counts Numbers", "Add(other Number, most = Limit) Other", "	other"))
constant Hiding = Mentions(("has prefix Text", "Kata(skills Texts) Kata", "	Kata(prefix)"))
constant HiddenType = "MethodHidesTypeUseDifferentName: "
constant Units = Mentions(("has units List(Unit)", "has logger", "Scored(model Shape, count = 2) Number", "\tCounted(model).Area"))
Types Texts
	Units.Types is ("List", "Unit", "Shape", "Number", "Counted", "Units", "Logger")
	Mentions(("has Instruction", "has Registers")).Types is ("Instruction", "Registers")
	Mentions(("Run", "\tconstant Limit = 3", "\tLimit + Size")).Types is ("Size")
	shape = TypeShape(lines)
	own = shape.MemberScope.names + shape.MethodScope.names + Constants
	typed = Typed(shape)
	Distinct(CollectedNames(lines) + typed, typed, own)
Distinct(tokens Texts, typed Texts, own Texts) Texts
	Mentions(List(Text)).Distinct(("a", "a", "b"), List(Text) + "b", List(Text) + "a") is ("b")
	mutable seen = Dictionary(Text, Boolean)
	mutable result = List(Text)
	for tokens
		if value is not in seen and (value is in typed or value is not in own)
			seen(value) = true
			result = result + value
	result
CollectedNames(sources Texts) Texts
	Mentions(List(Text)).CollectedNames(("A + b", "C")) is ("A", "C")
	mutable names = List(Text)
	for sources
		names = names + Tokenizer(value.Trim).Names
	names
Typed(shape Expressions/TypeShape) Texts
	Units.Typed(TypeShape(Units.lines)) is ("Units", "Logger", "Shape", "Number")
	Mentions(("Size Size", "\touter.Size(1, 2)")).Types is ("Size")
	mutable types = shape.MemberScope.types
	for lines
		if shape.IsMethodHeader(value)
			types = types + HeaderTokens(Tokenizer(value).Tokens).ParameterTypes
		if value.IndexOf("outer.") >= 0
			types = types + Outer(Tokenizer(value.Trim).Tokens)
	CollectedNames(types)
Outer(tokens Texts) Texts
	Mentions.Outer(("outer", ".", "Key", ".", "F")) is ("Key")
	Mentions.Outer(("outer", "x", "A", "inner", ".", "B", "Key", "outer", ".")).Length is 0
	Mentions("\tRun(value Size)").Typed(TypeShape("has x Number")) is ("Number")
	Mentions.Declared(TypeShape(("has x List(Size)", "Run", "A Number", "B Number"))) is ("Sizes", "None", "Number")
	for tokens
		if index > 1 and tokens(index - 1) is "." and tokens(index - 2) is "outer"
			value
Missing(files Texts) Texts
	Typo.Missing(Directory.Files(".", "*.strict")) is ("Numbr")
	Mentions(("Run", "\tVectr2(1, 2)")).Missing(Directory.Files(".", "*.strict")) is ("Vectr2")
	Mentions(("has Size", "Run", "\tWidth + Area + Depth")).Missing(Directory.Files("Math", "*.strict")) is ("Depth")
	Unknown(Names(files) + Composed(files))
Composed(files Texts) Texts
	Mentions(("has Size", "has logger")).Composed(("Math/Size.strict", "Logger.strict")).First is "Width"
	members = TypeShape(lines).MemberScope.types
	mutable names = List(Mutable(Text))
	for files
		if Path(value.Replace("\\", "/")).FileName.RemoveExtension.text is in members
			shape = TypeShape(File(value).ReadLines)
			if shape.MemberScope.names.Length > 0
				names = names + shape.MemberScope.names + shape.MethodScope.names
	names
Unknown(names Texts) Texts
	Typo.Unknown(List(Text) + "Number") is ("Numbr", "Other")
	all = Named(names + Constants)
	for Declared(TypeShape(lines)) + TypeShape(lines).UsedTypes
		if IsKnown(value, all) is false
			value
Constants Texts
	Typo.Constants is ("Limit")
	Mentions(("Run", "\tconstant Missing = Error")).Constants is ("Missing")
	for lines
		if value.Trim.StartsWith("constant ")
			Tokenizer(value.Trim).Tokens(1)
Unmatched(names Texts, files Texts) Texts
	Mentions.Unmatched(("Vector2s", "Missing"), List(Text) + "./Math/Vector2.strict") is ("Missing")
	known = Named(Names(files))
	for names
		if IsKnown(value, known) is false
			value
Names(files Texts) Texts
	Mentions.Names(("./Math/Vector2.strict", "Math\\Size.strict")) is ("None", "Other", "Vector2", "Size")
	mutable known = List(Mutable(Text)) + "None" + "Other"
	for files
		known.Add(Path(value.Replace("\\", "/")).FileName.RemoveExtension.text)
	known
Named(names Texts) Dictionary(Text, Boolean)
	Mentions.Named(("a", "b", "a")).Length is 2
	mutable named = Dictionary(Text, Boolean)
	for names
		named(value) = true
	named
IsKnown(name Text, known Dictionary(Text, Boolean)) Boolean
	Mentions.IsKnown("Numbers", Named(List(Text) + "Number"))
	Mentions.IsKnown("Numbr", Named(List(Text) + "Number")) is false
	Mentions.IsKnown("Numberss", Named(List(Text) + "Number"))
	Mentions.IsKnown("Sizes", Named(List(Text) + "Number")) is false
	name is in known then true else name.EndsWith("s") and IsKnown(name.Substring(0, name.Length - 1), known)
Declared(shape Expressions/TypeShape) Texts
	Mentions.Declared(TypeShape(Typo.lines)) is ("Numbr", "Numbers", "Other", "Number")
	calls = shape.CallScope(List(Text))
	mutable types = shape.MemberScope.types + Returned(shape)
	for calls.names
		if value.LastIndexOf(" types") > 0
			types = types + calls.types(index).Split(",")
	mutable result = List(Mutable(Text))
	for types
		name = value.IndexOf("(") > 0 then value.Substring(0, value.IndexOf("(")) else value
		if name is not "" and name.IndexOf(")") < 0 and name.IndexOf(" ") < 0 and name is not in result
			result.Add(name)
	result
Returned(shape Expressions/TypeShape) Texts
	Mentions.Returned(TypeShape(("constant Pair = (1, 2)", "Add(other) Number", "	other"))) is ("Number")
	Mentions.Returned(TypeShape(("has x Number", "Area = 1", "Add(other) Number", "\tother"))) is ("Number")
	for shape.lines
		if shape.IsMethodHeader(value) and shape.IsComputed(value) is false
			HeaderTokens(Tokenizer(value).Tokens).ReturnType
Hidden(path Text, type Text) Text
	Hiding.Hidden("A.strict", "Kata") is "A.strict:line 2: " + HiddenType + "Kata, the method Kata hides the type"
	Typo.Hidden("A.strict", "Numbr") is ""
	shape = TypeShape(lines)
	for lines
		if shape.IsMethodHeader(value) and Tokenizer(value).Tokens.First is type
			return ResolveCheck.Located(path, index + 1, HiddenType + type + ", the method " + type + " hides the type")
	""
