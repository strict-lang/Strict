has values ValueCodegen
constant Plain = MethodCodegen(ValueCodegen.Plain)
constant NoNode = SyntaxNode("Identifier", "x")
constant One = SyntaxNode("Number", "1")
constant MixedList = SyntaxNode("List", "", (NoNode, One))
constant ElementAssignment = SyntaxNode("Reassignment", "", (SyntaxNode("MethodCall", "a", (NoNode, One)), NoNode))
constant NoScope = Scope(List(Text), List(Text))
constant SumBody = BodyParser("Sum Number", "\tfor 3", "\t\tindex").Block(1, 1)
constant IfBody = BodyParser("Run", "\tif 1 > 2", "\t\treturn 3", "\t4").Block(1, 1)
constant LoopBody = BodyParser("Run Number", "\tfor 3", "\t\tindex", "\t0").Block(1, 1)
constant FilterBody = BodyParser("Count Number", "\tfor 3", "\t\tif index > 0", "\t\t\t1").Block(1, 1)
constant ElseBody = BodyParser("Run", "\tif 1 > 2", "\t\t3", "\telse", "\t\t4").Block(1, 1)
constant ReturnElse = BodyParser("Run", "\tif 1 > 2", "\t\treturn 3", "\telse", "\t\treturn 4").Block(1, 1)
constant InRun = CodeBlock.Empty.Declare(CodeBlock.ErrorMarker, "Run")
constant CopiedBody = BodyParser("Run", "\tmutable copy = (1)", "\tlet saved = copy", "\tcopy.Add(1)").Block(1, 1)
Generate(body SyntaxNode, scope Scope, returnType Text) CodeBlock
	Plain.Generate(BodyParser("Run Number", "\tx + 2").Block(1, 1), NoScope, "None").instructions.Length is 4
	Plain.Generate(BodyParser("Run Number", "\treturn 1").Block(1, 1), NoScope, "None").instructions.Length is 2
	Plain.Generate(BodyParser("Exists Boolean").Block(1, 1), NoScope, "None").instructions.Length is 0
	Plain.Generate(SumBody, NoScope, "Number").instructions.Length is 11
	Plain.Generate(FilterBody, NoScope, "Number").instructions(12).kind is InstructionType.JumpEnd
	Plain.Generate(CopiedBody, NoScope, "None").instructions(5).kind is InstructionType.Add
	let start = CodeBlock(List(InstructionEntry), 0, 0, scope)
	let code = BranchValues(returnType).Rewritten(Production(body, start))
	let block = LoopCodegen(MethodCodegen(values)).Aggregated(code, start, returnType)
	if (code.children.Length is 0) or (block.instructions.Last.kind is InstructionType.Return)
		return block
	block.Add(InstructionEntry.Return(block.register is 0 then 0 else block.Result))
Production(body SyntaxNode, block CodeBlock) SyntaxNode
	Plain.Production(BodyParser("Run", "\tconstant a = 2", "\ta").Block(1, 1), CodeBlock.Empty).Lines("") is ("2")
	let inlined = ConstantFolding(values.target.TypeName, values.inference).Inlined(TestLines(values).Without(body, block))
	IndexCodegen(values).Unnested(inlined)
Body(body SyntaxNode, block CodeBlock) CodeBlock
	Plain.Body(BodyParser("Run", "\t1", "\t2").Block(1, 1), CodeBlock.Empty).register is 1
	Plain.Body(BodyParser("Run", "\t1", "\t2").Block(1, 1), CodeBlock.Empty).instructions.Last.line is 3
	mutable result = block
	for body.children
		let statement = Statement(value, result.At(block.register), HasElse(body, index))
		result = Lined(statement, result.instructions.Length, value.line)
	CodeBlock(result.instructions, result.register, result.nextId, block.scope)
Lined(block CodeBlock, start Number, line Number) CodeBlock
	Plain.Lined(CodeBlock.Empty.Load(InstructionEntry.LoadNumber(0, 1)), 0, 5).instructions.First.line is 5
	if line is 0
		return block
	mutable lined = List(Mutable(InstructionEntry))
	for block.instructions
		let isUnlined = (index >= start) and (value.line is 0)
		lined.Add(isUnlined then InstructionEntry(value.kind, value.texts, value.payload, line) else value)
	CodeBlock(lined, block.register, block.nextId, block.scope)
HasElse(body SyntaxNode, position Number) Boolean
	Plain.HasElse(ElseBody, 0) is true
	Plain.HasElse(ElseBody, 1) is false
	position + 1 < body.children.Length and (body.children(position + 1).Kind is in ("ElseIf", "Else"))
Statement(node SyntaxNode, previous CodeBlock, hasElse Boolean) CodeBlock
	Plain.Statement(SyntaxNode("Return", "", One), CodeBlock.Empty, false).instructions.Length is 2
	let block = ListCodegen(values).Disowned(node, previous, false)
	if node.Kind is in ("Declaration", "Reassignment")
		return Assignment(node, block)
	if node.Kind is in ("If", "ElseIf", "Else")
		return node.Kind is "If" then Conditional(node, block, hasElse, "") else Else(node, block, hasElse)
	if node.Kind is "For"
		return LoopCodegen(MethodCodegen(values)).Loop(node, block, "")
	if (node.Kind is "MethodCall") and (node.text is "Log")
		return Log(node.children(1), block)
	let generated = values.Expression((node.Kind is "Return" then node.children(0) else node), block)
	node.Kind is "Return" then generated.Add(InstructionEntry.Return(generated.Result)) else generated
Assignment(node SyntaxNode, block CodeBlock) CodeBlock
	Plain.Assignment(SyntaxNode("Declaration", "let a", One), CodeBlock.Empty).scope.TypeOf("a") is "Number"
	Plain.Assignment(SyntaxNode("Declaration", "let a", One), CodeBlock.Empty).instructions.First.payload is (1, 1, -1, 0)
	Plain.Assignment(SyntaxNode("Reassignment", "", (NoNode, NoNode)), CodeBlock.Empty).instructions.Length is 2
	Plain.Assignment(SyntaxNode("Declaration", "let a", MixedList), CodeBlock.Empty).instructions.Length is 7
	Plain.Assignment(ElementAssignment, CodeBlock.Empty).instructions.Last.texts is ("x.a(1)")
	Plain.Assignment(ListCodegen.Appending, ListCodegen.Owned).instructions(1).kind is InstructionType.InvokeWriteToList
	if ListCodegen(values).IsAppend(node, block)
		return ListCodegen(values).Added(SyntaxNode("MethodCall", "Add", node.children.Last.children), block)
	let name = AssignedName(node)
	let assigned = ConversionCodegen(values).Assigned(node, block)
	let stored = Stored(assigned, name, block, node.Kind is "Declaration")
	node.Kind is "Declaration" then Declared(stored, name, assigned) else stored
Stored(assigned SyntaxNode, name Text, block CodeBlock, isDeclaration Boolean) CodeBlock
	Plain.Stored(One, "a", CodeBlock.Empty, true).instructions.Length is 1
	Plain.Stored(SyntaxNode("Identifier", "Error"), "a", CodeBlock.Empty, true).instructions(0).texts is ("a")
	Plain.Stored(SyntaxNode("Identifier", "Error"), "a", InRun, false).instructions(0).texts is ("Run")
	Plain.Stored(One, "a(0)", CodeBlock.Empty, false).instructions.Last.kind is InstructionType.StoreRegisterToVariable
	let named = isDeclaration then block.Declare(CodeBlock.ErrorMarker, name) else block
	let generated = values.Expression(assigned, named)
	let restored = CodeBlock(generated.instructions, generated.register, generated.nextId, block.scope)
	let isConstant = assigned.IsLiteral and (name.IndexOf("(") < 0)
	isConstant then block.Add(StoreConstant(generated.instructions.Last, name)) else restored.Stored(name)
AssignedName(node SyntaxNode) Text
	Plain.AssignedName(SyntaxNode("Declaration", "let a", One)) is "a"
	Plain.AssignedName(ElementAssignment) is "x.a(1)"
	Plain.AssignedName(SyntaxNode("Reassignment", "", (SyntaxNode("Member", "Y", NoNode), One))) is "Y"
	if node.Kind is "Declaration"
		return Tokenizer(node.text).Tokens.Last
	let target = node.children(0)
	target.Kind is "Member" then target.text else target to Text
Declared(block CodeBlock, name Text, assigned SyntaxNode) CodeBlock
	Plain.Declared(CodeBlock.Empty.Declare("x", "Numbers"), "a", NoNode).Owns("a") is false
	block.Declare(name, values.TypeOf(assigned, block)).Sharing(name, ListCodegen(values).IsNew(assigned) is false)
StoreConstant(load InstructionEntry, name Text) InstructionEntry
	Plain.StoreConstant(InstructionEntry.LoadNumber(2, 7), "a").payload is (1, 7, -1, 0)
	let texts = load.texts + name
	InstructionEntry(InstructionType.StoreConstantToVariable, texts, LoadedValue(load) + (-1 - load.texts.Length) + 0)
LoadedValue(load InstructionEntry) Numbers
	Plain.LoadedValue(InstructionEntry.LoadNumber(2, 7)) is (1, 7)
	mutable content = List(Number) + load.payload(1)
	for Range(2, load.payload.Length)
		content = content + load.payload(value)
	content
Conditional(node SyntaxNode, block CodeBlock, hasElse Boolean, aggregation Text) CodeBlock
	Plain.Generate(IfBody, NoScope, "None").instructions.Length is 9
	Plain.Conditional(SelectorCodegen.Picked, CodeBlock.Empty, false, "").instructions.Length is 14
	if MethodBodies(values.target.TypeName, values.target.shape, values.inference).IsSelector(node)
		return SelectorCodegen(values).Selected(node, block)
	let condition = OperatorCodegen(values).Condition(node.children(0), block)
	let branch = Body(node.children.Last, condition)
	let body = aggregation is "" then branch else LoopCodegen(MethodCodegen(values)).Collected(branch, aggregation)
	let skipsElse = hasElse and body.instructions.Last.kind is not InstructionType.Return
	let flagged = skipsElse then body.Flagged else body
	flagged.Add(InstructionEntry.Jump(InstructionType.JumpEnd, condition.nextId - 1))
Else(node SyntaxNode, block CodeBlock, hasElse Boolean) CodeBlock
	Plain.Generate(ElseBody, NoScope, "None").instructions.Length is 12
	Plain.Generate(ReturnElse, NoScope, "None").instructions.Length is 9
	if block.instructions(block.instructions.Length - 2).kind is InstructionType.Return
		return node.Kind is "ElseIf" then Conditional(node, block, hasElse, "") else Body(node.children.Last, block)
	let jumped = block.Add(InstructionEntry.Jump(InstructionType.JumpToIdIfTrue, block.nextId)).WithNextId
	let inner = node.Kind is "ElseIf" then Conditional(node, jumped, hasElse, "") else Body(node.children.Last, jumped)
	inner.Add(InstructionEntry.Jump(InstructionType.JumpEnd, block.nextId))
Log(argument SyntaxNode, block CodeBlock) CodeBlock
	Plain.Log(SyntaxNode("Text", "\"Hi\""), CodeBlock.Empty).instructions(0).texts is ("Hi")
	Plain.Log(SyntaxNode("Number", "1"), CodeBlock.Empty).instructions.Length is 2
	if argument.Kind is "Text"
		return block.Add(InstructionEntry.Print(argument.Unquoted))
	let hasPrefix = (argument.Kind is "Binary") and (argument.text is "+") and (argument.children(0).Kind is "Text")
	let printed = hasPrefix then argument.children(1) else argument
	let generated = values.Expression(printed, block)
	let prefix = hasPrefix then argument.children(0).Unquoted else ""
	generated.Add(InstructionEntry.PrintValue(prefix, generated.Result, values.TypeOf(printed, generated) is "Text"))