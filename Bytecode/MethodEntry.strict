has Name Text
has parameters List(MemberEntry)
has declaredType Text
has instructions List(InstructionEntry)
has Slots Number = 0
constant PrintHi = InstructionEntry(InstructionType.Print, "Hi", (-1, 0), 3)
constant GoCall = InstructionEntry.Invoke(0, ("Strict/B", "Go", "None"), List(Number), -1)
constant Converting = MethodEntry("Run", List(MemberEntry), "None", InstructionEntry.Invoke(0, ("Strict/Digit", "to", "Strict/Text"), List(Number), -1))
constant GoRun = MethodEntry("Run", List(MemberEntry), "None", GoCall)
constant Indexing = MethodEntry("At", List(MemberEntry) + MemberEntry("index", "Strict/Number", List(InstructionEntry), false), "None", List(InstructionEntry))
constant CountingLoop = MethodEntry("Run", List(MemberEntry), "None", (InstructionEntry.LoopBegin(0, -1), InstructionEntry.Jump(InstructionType.LoopEnd, 1)))
constant Logged = MethodEntry("Add", MemberEntry.LoggerMember, "Strict/Number", List(InstructionEntry))
constant Initializing = MethodEntry("from", List(MemberEntry), "Strict/A", (InstructionEntry.LoadNumber(0, 7), InstructionEntry.Named(InstructionType.StoreRegisterToVariable, 0, "logger")))
constant Branching = MethodEntry("Run", List(MemberEntry), "None", (InstructionEntry.Jump(InstructionType.JumpToIdIfFalse, 0), InstructionEntry.Return(0), InstructionEntry.Jump(InstructionType.JumpEnd, 0), InstructionEntry.Return(1)))
constant HelloRun = MethodEntry("Run", List(MemberEntry), "None", (PrintHi, InstructionEntry.Return(0)))
returnType Text
	IsSlow then declaredType.Substring(5, declaredType.Length - 6) else declaredType
IsSlow Boolean
	declaredType.StartsWith("Slow(")
Names(names BinaryNames) BinaryNames
	MethodEntry("Run", List(MemberEntry), "Slow(Number)", List(InstructionEntry)).returnType is "Number"
	HelloRun.Names(BinaryNames("a", "b")).names.Length is 5
	MethodEntry("Add", MemberEntry.LoggerMember, "None", List(InstructionEntry)).Names(BinaryNames("a")).names.Length is 5
	mutable result = names.With(Name)
	for parameters
		result = value.Names(result)
	result = result.With(declaredType)
	for instructions
		result = value.Names(result)
	result
Integers(names BinaryNames) Numbers
	HelloRun.Integers(BinaryNames("Run", "None", "Hi")) is (0, 1, 0, 2, 7, 173, 1, 2, 2, 1, 0, 3, 4, 32, 0, 1, 0)
	mutable integers = List(Number) + names.Index(Name) + names.Index(declaredType) + parameters.Length
	for parameters
		let member = value.Integers(names)
		integers = integers + member.Length + member
	integers = integers + instructions.Length
	for instructions
		let instruction = value.Integers(names)
		integers = integers + instruction.Length + instruction
	integers
IsInitializer(members List(MemberEntry)) Boolean
	Initializing.IsInitializer(List(MemberEntry) + MemberEntry.LoggerMember)
	GoRun.IsInitializer(List(MemberEntry) + MemberEntry.LoggerMember) is false
	if Name is not "from"
		return false
	mutable names = List(Mutable(Text))
	for members
		names.Add(value.Name)
	for instructions
		if (value.kind is InstructionType.StoreRegisterToVariable) and (value.texts(0) is in names)
			return true
	false
ParameterNames Texts
	Logged.ParameterNames is ("logger")
	for parameters
		value.Name
Fit(name Text, count Number, target Text, names Texts) Number
	GoRun.Fit("Run", 0, "None", List(Text)) is 3
	Logged.Fit("Add", 1, "None", List(Text) + "other") is 2
	GoRun.Fit("Go", 0, "None", List(Text)) is 0
	Logged.Fit("Add", -1, "None", List(Text)) is 1
	let isAnyReturn = (name is not "to") or (target is "")
	let isReturning = isAnyReturn or (TypeEntry.ShortName(target) is TypeEntry.ShortName(returnType))
	if (Name is not name) or (isReturning is false)
		return 0
	if count < 0
		return 1
	if parameters.Length is count
		return ParameterNames is names then 3 else 2
	(count < parameters.Length) and (parameters(count).initial.Length > 0) then 1 else 0
SignatureTypes Texts
	Logged.SignatureTypes is ("Strict/Number", "Strict/Logger")
	mutable types = List(Mutable(Text))
	types.Add(returnType)
	for parameters
		types.Add(value.typeName)
	types
Invoked Texts
	GoRun.Invoked is ("Strict/B.Go")
	HelloRun.Invoked.Length is 0
	Converting.Invoked is ("Strict/Digit.to", "Strict/Digit.to Text")
	mutable targets = List(Mutable(Text))
	for instructions
		if value.kind is InstructionType.Invoke
			targets.Add(value.texts(0) + "." + value.texts(1))
			if value.texts(1) is "to"
				targets.Add(value.texts(0) + ".to " + TypeEntry.ShortName(value.texts(2)))
	targets
LoopBeginOf(position Number) Number
	CountingLoop.LoopBeginOf(1) is 0
	mutable depth = 0
	for position
		let candidate = position - 1 - index
		let kind = instructions(candidate).kind
		if (kind is InstructionType.LoopBegin) and (depth is 0)
			return candidate
		let change = kind is InstructionType.LoopEnd then 1 else kind is InstructionType.LoopBegin then -1 else 0
		depth = depth + change
	0
JumpEndOf(jump InstructionEntry) Number
	Branching.JumpEndOf(Branching.instructions(0)) is 2
	Branching.JumpEndOf(InstructionEntry.Jump(InstructionType.JumpToIdIfFalse, 5)) is 4
	for instructions
		if (value.kind is InstructionType.JumpEnd) and (value.payload is jump.payload)
			return index
	instructions.Length
LoopEndOf(position Number) Number
	CountingLoop.LoopEndOf(0) is 1
	mutable depth = 0
	for Range(position + 1, instructions.Length)
		let kind = instructions(value).kind
		if (kind is InstructionType.LoopEnd) and (depth is 0)
			return value
		let change = kind is InstructionType.LoopBegin then 1 else kind is InstructionType.LoopEnd then -1 else 0
		depth = depth + change
	instructions.Length
IsWritingResult(position Number) Boolean
	MlirLoops.Collecting.function.method.IsWritingResult(1)
	CountingLoop.IsWritingResult(0) is false
	mutable at = position + 1
	let end = LoopEndOf(position)
	for as long as at < end
		let entry = instructions(at)
		if (entry.kind is InstructionType.InvokeWriteToList) and (entry.texts.Last is "forResult")
			return true
		at = entry.kind is InstructionType.LoopBegin then LoopEndOf(at) + 1 else at + 1
	false