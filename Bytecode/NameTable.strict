has names Texts
Has(name Text) Boolean
	for names
		if value is name
			return true
	false
IndexOf(name Text) Number
	mutable index = 0
	for names
		if value is name
			return index
		index = index + 1
	-1
Get(index Number) Text
	if index < 0
		return ""
	if index >= names.Length
		return ""
	names(index)
Add(name Text) NameTable
	if Has(name)
		return NameTable(names)
	Append(name)
Append(name Text) NameTable
	NameTable.Empty.Append("a").Count is 1
	NameTable(names + name)
Count Number
	names.Length
CollectMany(items Texts) NameTable
	mutable table = NameTable(names)
	for items
		table = table.Add(value)
	table
BuiltIn NameTable
	BuiltIn.Has("Number") is true
	BuiltIn.Has("boolean") is true
	constant types = ("", "None", "Boolean", "Number", "Character", "Range", "Text", "Error", "List")
	constant more = ("Logger", "File", "Directory", "Mutable", "Dictionary", "Run")
	NameTable(types + more + ("from", "value", "number", "text", "boolean"))
Empty NameTable
	Empty.Count is 0
	constant noNames = List(Text)
	NameTable(noNames)
ForType(typeName Text) NameTable
	BuiltIn.Add(typeName)
to Text
	"names=" + Count to Text