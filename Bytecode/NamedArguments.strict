has values ValueCodegen
constant PartMembers = Scope(("buffer", "light", "mask"), ("Number", "Number", "Number"))
constant Constructing = Scope(("from", "from types", "light default", "mask default"), ("buffer,light,mask", "Number,Number,Number", "0", "0"))
constant Types = KnownTypes(("Part", "Number"), (PartMembers, KnownTypes.NoMembers), (KnownTypes.NoMembers, KnownTypes.NoMembers), (Constructing, KnownTypes.NoMembers))
constant Parts = NamedArguments(ValueCodegen(TypeInference(Types, CallTarget.NoScopes), KnownTypes.NoMembers, CallTarget(Types, CallTarget.Greeter, "Strict/Part", List(Text))))
constant Curving = Scope(("from", "from types", "light default", "mask default"), ("buffer,light,mask", "Number,Number,Curve", "0", "Curve.Flat"))
constant CurveTypes = KnownTypes(("Part", "Curve"), (PartMembers, KnownTypes.NoMembers), (KnownTypes.NoMembers, KnownTypes.NoMembers), (Curving, KnownTypes.NoMembers))
constant Curved = NamedArguments(ValueCodegen(TypeInference(CurveTypes, CallTarget.NoScopes), KnownTypes.NoMembers, Parts.values.target))
constant Named = SyntaxParser(Tokenizer("Part(buffer = 1, mask = 3)").Tokens).Parse
constant Masked = SyntaxParser(Tokenizer("Part(1, mask = 3)").Tokens).Parse
constant Shining = Constructing.WithAll(("Shine", "Shine light default", "Shine mask default"), ("light,mask", "0", "Curve.Flat"))
constant ShineTypes = KnownTypes(Types.names, Types.members, Types.methods, (Shining, KnownTypes.NoMembers))
constant Shined = NamedArguments(ValueCodegen(TypeInference(ShineTypes, CallTarget.NoScopes), KnownTypes.NoMembers, Parts.values.target))
constant Lights = (Scope(List(Text) + "Light", List(Text) + "1"), KnownTypes.NoMembers)
constant Lit = NamedArguments(ValueCodegen(Shined.values, inference = TypeInference(ShineTypes, Lights)))
constant OwnDefaults = NamedArguments(ValueCodegen(Lit.values, inference = TypeInference(KnownTypes(ShineTypes, parameters = (Constructing.With("mask default", "Light"), KnownTypes.NoMembers)), Lights)))
Arranged(call SyntaxNode, block CodeBlock) SyntaxNode slow
	Parts.Arranged(Masked, CodeBlock.Empty) to Text is "Part(1, 0, 3)"
	Parts.Arranged(SyntaxParser(Tokenizer("Part(1, 2)").Tokens).Parse, CodeBlock.Empty) to Text is "Part(1, 2)"
	Parts.Arranged(Named, CodeBlock.Empty) to Text is "Part(1, 0, 3)"
	Curved.Arranged(SyntaxParser(Tokenizer("Part(1)").Tokens).Parse, CodeBlock.Empty) to Text is "Part(1, 0, Curve.Flat)"
	Curved.Arranged(SyntaxParser(Tokenizer("Part()").Tokens).Parse, CodeBlock.Empty).children(0).Kind is "Identifier"
	let positional = Positional(call)
	let isType = IsConstructor(call)
	let isReplacing = isType and (positional > 0) and (values.TypeOf(call.children(0), block) is call.text)
	if (isType is false) or isReplacing
		return call
	let names = values.target.FromNames(call.text)
	Last(call, names) < positional then call else Filled(call, names, positional)
IsConstructor(call SyntaxNode) Boolean
	Parts.IsConstructor(Parts.Parsed("Part")) is false
	Parts.Arranged(Parts.Parsed("Part(Part(1), mask = 3)"), CodeBlock.Empty) to Text is "Part(Part(1), mask = 3)"
	Parts.Arranged(Parts.Parsed("Missing(1)"), CodeBlock.Empty) to Text is "Missing(1)"
	Parts.IsConstructor(Masked)
	Parts.IsConstructor(SyntaxParser(Tokenizer("Missing(1)").Tokens).Parse) is false
	let isOwnMethod = values.target.Header(call.text).tokens.Length > 0
	(call.Kind is "Call") and values.inference.types.IsKnown(call.text) and (isOwnMethod is false)
Filled(call SyntaxNode, names Texts, positional Number) SyntaxNode
	Parts.Filled(Masked, ("buffer", "light", "mask"), 1) to Text is "Part(1, 0, 3)"
	mutable arguments = List(Mutable(SyntaxNode))
	for Range(0, Last(call, names) + 1)
		arguments.Add(value < positional then call.children(value) else Argument(call, call.text, "", names(value)))
	SyntaxNode("Call", call.text, arguments, call.line)
Positional(call SyntaxNode) Number
	Parts.Last(SyntaxNode("Call", "Part"), ("light", "mask")) is 1
	Parts.Last(SyntaxNode("Call", "Part"), ("light", "buffer", "mask")) is 0
	Parts.Last(Parts.Parsed("Part(mask = 3)"), ("light", "buffer")) is -1
	Parts.Last(Parts.Parsed("Part(1, )"), ("buffer", "light", "mask")) is 0
	Parts.Positional(Masked) is 1
	for call.children
		if value.Kind is in ("Reassignment", "Missing")
			return index
	call.children.Length
Last(call SyntaxNode, names Texts) Number
	Parts.Last(Masked, ("buffer", "light", "mask")) is 2
	Curved.Last(SyntaxParser(Tokenizer("Part(1)").Tokens).Parse, ("buffer", "light", "mask")) is 2
	mutable last = -1
	for names
		let isDefaulted = (call.children.Length is 0) and (last is index - 1) and (Fallback(call.text, value) is not "")
		if IsComputed(call.text, value) or isDefaulted
			last = index
	for call.children
		let given = value.Kind is "Missing" then -1 else index
		let position = value.Kind is "Reassignment" then names.Index(value.children(0).text) else given
		last = position > last then position else last
	last
IsComputed(owner Text, key Text) Boolean
	Curved.IsComputed("Part", "mask")
	Curved.IsComputed("Part", "light") is false
	Shined.IsComputed("Part", "Shine mask")
	let fallback = Fallback(owner, key)
	(fallback is not "") and (ConstantFolding(owner, values.inference).Unwrapped(Parsed(fallback)).IsLiteral is false)
Argument(call SyntaxNode, owner Text, prefix Text, name Text) SyntaxNode
	OwnDefaults.Argument(SyntaxNode("Call", "Part"), "Part", "", "mask") to Text is "Part.Light"
	Parts.Argument(Masked, "Part", "", "light").text is "0"
	Parts.Argument(Masked, "Part", "", "mask").text is "3"
	Shined.Argument(SyntaxNode("Call", "Shine"), "Part", "Shine ", "mask").Kind is "Member"
	for call.children
		if (value.Kind is "Reassignment") and (value.children(0).text is name)
			return value.children(1)
	let fallback = Fallback(owner, prefix + name)
	fallback is "" then SyntaxNode("Identifier", name) else Qualified(owner, fallback)
Defaulted(call SyntaxNode, owner Text, start Number) SyntaxNode
	Shined.Defaulted(Parts.Parsed("Shine(1)"), "Part", 1) to Text is "Shine(1, 0, Curve.Flat)"
	Shined.Defaulted(SyntaxParser(Tokenizer("Shine(1)").Tokens).Parse, "Part", 0) to Text is "Shine(1, Curve.Flat)"
	Parts.Defaulted(Masked, "Part", 0) to Text is "Part(1, mask = 3)"
	Shined.Defaulted(Parts.Parsed("Shine(mask = 3)"), "Part", 0) to Text is "Shine(0, 3)"
	let given = Positional(call) - start
	let names = values.inference.types.ParametersOf(owner, call.text, call.children.Length - start)
	let last = Computed(call, owner, names, given)
	mutable children = call.children.Slice(0, Positional(call))
	for Range(given, last + 1)
		children = children + Argument(call, owner, call.text + " ", names(value))
	last < given then call else SyntaxNode(call.Kind, call.text, children, call.line)
Computed(call SyntaxNode, owner Text, names Texts, given Number) Number
	Shined.Computed(SyntaxNode("Call", "Shine"), "Part", ("light", "mask"), 2) is 1
	Shined.Computed(Parts.Parsed("Shine(light = 1)"), "Part", ("mask", "light"), 0) is 1
	Shined.Computed(SyntaxNode("Call", "Shine"), "Part", ("light", "mask"), 0) is 1
	Shined.Computed(SyntaxNode("Call", "Shine"), "Part", List(Text) + "light", 0) is -1
	mutable last = given - 1
	for names
		if (index >= given) and IsComputed(owner, call.text + " " + value)
			last = index
	for call.children
		let named = value.Kind is "Reassignment" then names.Index(value.children(0).text) else -1
		last = named > last then named else last
	last
Fallback(owner Text, key Text) Text
	Parts.IsComputed("Part", "buffer") is false
	Shined.Fallback("Part", "Shine mask") is "Curve.Flat"
	Parts.Fallback("Part", "light") is "0"
	values.inference.types.ParameterScope(owner).TypeOf(key + " default")
Qualified(owner Text, fallback Text) SyntaxNode
	Lit.Qualified("Part", "Light(1)") to Text is "Light(1)"
	Shined.Qualified("Part", "Curve.Flat").Kind is "Member"
	Lit.Qualified("Part", "Light") to Text is "Part.Light"
	Lit.Qualified("Part", "Dark") to Text is "Dark"
	let node = Parsed(fallback)
	let isOwn = (node.Kind is "Identifier") and (values.inference.ConstantOf(owner, node.text) is not "")
	isOwn then Parsed(TypeEntry.ShortName(owner) + "." + fallback) else node
Parsed(text Text) SyntaxNode
	Parts.Parsed("Curve.Flat").Kind is "Member"
	SyntaxParser(Tokenizer(text).Tokens).Parse