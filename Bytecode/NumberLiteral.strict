has dummy Number
IsNumberLiteral(text Text) Boolean
	IsNumberLiteral("42") is true
	IsNumberLiteral("x") is false
	if text is ""
		return false
	if text.IndexOf(" ") is -1
		return IsDigitStart(text)
	false
IsDigitStart(text Text) Boolean
	if text.StartsWith("-")
		return IsDigitChar(text.Substring(1, 1))
	IsDigitChar(text.Substring(0, 1))
IsDigitChar(text Text) Boolean
	if text is "0"
		return true
	if text is "1"
		return true
	if text is "2"
		return true
	if text is "3"
		return true
	if text is "4"
		return true
	IsDigitHigh(text)
IsDigitHigh(text Text) Boolean
	if text is "5"
		return true
	if text is "6"
		return true
	if text is "7"
		return true
	if text is "8"
		return true
	if text is "9"
		return true
	false
Empty NumberLiteral
	NumberLiteral(0)
