has values ValueCodegen
constant Plain = OperatorCodegen(ValueCodegen.Plain)
constant One = SyntaxNode("Number", "1")
constant NoNode = SyntaxNode("Identifier", "x")
constant Characters = OperatorCodegen(ValueCodegen(TypeInference(KnownTypes(("Character"), (KnownTypes.NoMembers), (Scope(("+"), ("Text"))), (KnownTypes.NoMembers)), CallTarget.NoScopes), KnownTypes.NoMembers, CallTarget.Plain))
constant Texts = OperatorCodegen(ValueCodegen(TypeInference(KnownTypes(("Text"), (KnownTypes.NoMembers), (Scope(("+", "<"), ("Text", "Boolean"))), (KnownTypes.NoMembers)), CallTarget.NoScopes), KnownTypes.NoMembers, CallTarget.Plain))
constant Hashes = OperatorCodegen(ValueCodegen(TypeInference(KnownTypes(("Hash"), (Scope(("number"), ("Number"))), (KnownTypes.NoMembers), (Scope(("from", "from types"), ("generic", "Generic")))), CallTarget.NoScopes), KnownTypes.NoMembers, CallTarget.Plain))
constant InOnes = SyntaxNode("Binary", "is in", (One, ValueCodegen.Ones))
constant Choose = SyntaxNode("Binary", "else", (SyntaxNode("Binary", "then", (NoNode, One)), One))
constant Narrowing = SyntaxParser(Tokenizer("x is Error then x.Name else \"\"").Tokens).Parse
constant Mismatched = SyntaxParser(Tokenizer("Dictionary(A, B) is Dictionary(B, A)").Tokens).Parse
constant Hiding = OperatorCodegen(ValueCodegen(ValueCodegen.NoTypes, Scope(List(Text) + "B", List(Text) + "Text"), CallTarget(CallTarget.NoTypes, TypeShape(("has text", "B Text", "\ttext")), "Strict/Examples/Hiding", List(Text))))
constant Comparisons = ("is", "is not", "<", ">", "xor", ">=", "<=")
constant ComparisonOffsets = (0, 1, 2, 3, 1, 2, 3)
Operation(node SyntaxNode, block CodeBlock) CodeBlock
	Plain.Operation(SyntaxNode("Binary", "<=", (One, One)), CodeBlock.Empty).Result is 4
	Plain.Operation(SyntaxNode("Negate", "", List(SyntaxNode) + NoNode), CodeBlock.Empty).Result is 2
	Plain.Operation(SyntaxNode("Converted", "Numbers", (NoNode, NoNode)), CodeBlock.Empty).instructions.Length is 7
	Plain.Operation(Mismatched, CodeBlock.Empty).instructions.Length is 1
	if node.children.Length < 2
		return Negative(node.children(0), block)
	if IsComposite(node, block)
		return Composite(node, block)
	let left = ErrorCodegen(values).Compared(node, node.children(0), block)
	let right = ErrorCodegen(values).Right(node, left, true)
	let result = right.Load(InstructionEntry.Binary(OperatorType(node.text), (left.Result, right.Result, right.register)))
	node.text is in (">=", "<=") then result.Negated else result
Negative(operand SyntaxNode, block CodeBlock) CodeBlock
	Plain.Negative(One, CodeBlock.Empty).instructions.Last.kind is InstructionType.Subtract
	let generated = values.Expression(operand, block)
	let zero = generated.Load(InstructionEntry.LoadNumber(generated.register, 0))
	zero.Load(InstructionEntry.Binary(InstructionType.Subtract, (zero.Result, generated.Result, zero.register)))
IsCustom(node SyntaxNode, block CodeBlock) Boolean
	Plain.IsCustom(SyntaxNode("Binary", "+", (One, One)), CodeBlock.Empty) is false
	Plain.IsCustom(SyntaxNode("Binary", "is", (NoNode, NoNode)), CodeBlock.Empty.Declare("x", "Size")) is false
	Characters.IsCustom(SyntaxNode("Binary", "+", (NoNode, NoNode)), CodeBlock.Empty.Declare("x", "Character"))
	Texts.IsCustom(SyntaxNode("Binary", "<", (NoNode, NoNode)), CodeBlock.Empty.Declare("x", "Text"))
	Plain.IsCustom(SyntaxNode("Binary", "xor", (One, One)), CodeBlock.Empty)
	Plain.IsCustom(SyntaxNode("Binary", "and", (NoNode, NoNode)), CodeBlock.Empty.Declare("x", "Boolean")) is false
	if (node.text is in ("and", "or", "xor")) and (values.TypeOf(node.children(0), block) is "Number")
		return true
	if node.text is not in ("+", "-", "*", "/", "%", "^", "<", ">", "<=", ">=")
		return false
	HasOperator(values.TypeOf(node.children(0), block), node.text)
HasOperator(type Text, operator Text) Boolean
	Texts.HasOperator("Text", "<")
	Texts.HasOperator("Text", "+") is false
	Plain.HasOperator("Number", "<") is false
	let isOrdered = operator is in ("<", ">", "<=", ">=")
	let isBase = (type is in ("Number", "Boolean")) or ((type is "Text") and (isOrdered is false))
	if isBase or type.StartsWith("List(") or values.inference.types.IsPlural(type)
		return false
	values.inference.types.MethodsOf(type).TypeOf(operator) is not ""
IsComposite(node SyntaxNode, block CodeBlock) Boolean
	Plain.IsComposite(Choose, CodeBlock.Empty)
	Plain.IsComposite(SyntaxNode("Binary", "+", (One, One)), CodeBlock.Empty) is false
	let isFixed = (node.Kind is "Converted") or (node.text is in ("and", "or", "is in", "is not in", "else"))
	isFixed or IsCustom(node, block) or (Decided(node, block) is not "")
Decided(node SyntaxNode, block CodeBlock) Text
	Plain.Decided(Mismatched, CodeBlock.Empty) is "false"
	Plain.Decided(SyntaxNode("Binary", "is not", (One, SyntaxNode("Identifier", "B"))), CodeBlock.Empty) is "true"
	Plain.Decided(SyntaxNode("Binary", "is", (One, One)), CodeBlock.Empty) is ""
	Hiding.Decided(SyntaxNode("Binary", "is", (One, SyntaxNode("Identifier", "B"))), CodeBlock.Empty) is ""
	if node.text is not in ("is", "is not")
		return ""
	let wanted = node.children.Last
	let isType = IsTypeTest(wanted, block)
	if (isType is false) and (IsMismatched(node, block) is false)
		return ""
	let matches = isType and Matches(values.TypeOf(node.children(0), block), wanted.text)
	(matches is (node.text is "is")) to Text
IsTypeTest(wanted SyntaxNode, block CodeBlock) Boolean
	Plain.IsTypeTest(SyntaxNode("Identifier", "B"), CodeBlock.Empty)
	Hiding.IsTypeTest(SyntaxNode("Identifier", "B"), CodeBlock.Empty) is false
	let isHiding = values.IsMethodCall(wanted, block) or (wanted.text is "Error")
	values.IsTypeName(wanted, block) and (isHiding is false)
IsMismatched(node SyntaxNode, block CodeBlock) Boolean
	Plain.IsMismatched(Mismatched, CodeBlock.Empty)
	Plain.IsMismatched(SyntaxNode("Binary", "is", (One, One)), CodeBlock.Empty) is false
	Hashes.IsMismatched(SyntaxParser(Tokenizer("Hash(1) is Hash(\"a\")").Tokens).Parse, CodeBlock.Empty) is false
	if node.text is not in ("is", "is not")
		return false
	let left = values.TypeOf(node.children(0), block)
	let right = values.TypeOf(node.children(1), block)
	let isInstance = (left.IndexOf("(") > 0) and (right.IndexOf("(") > 0) and (left is not right)
	let types = values.inference.types
	let isMethodGeneric = "Generic" is in types.ParametersOf(left, "from types", -1)
	isInstance and (isMethodGeneric is false) and (types.BaseName(left) is types.BaseName(right))
Matches(type Text, wanted Text) Boolean
	Plain.Matches("Numbers", "Iterator")
	Plain.Matches("A(Number)", "A")
	Plain.Matches("Number", "B") is false
	let types = values.inference.types
	let isIterable = (type is in ("Number", "Range", "Text")) or types.IsPlural(type) or (types.BaseName(type) is "List")
	(type is wanted) or (types.BaseName(type) is wanted) or (wanted is "Iterator") and isIterable
Composite(node SyntaxNode, block CodeBlock) CodeBlock
	Plain.Composite(Choose, CodeBlock.Empty).instructions.Last.kind is InstructionType.LoadVariableToRegister
	if Decided(node, block) is not ""
		return values.Expression(SyntaxNode("Boolean", Decided(node, block)), block)
	if node.Kind is "Converted"
		return ConversionCodegen(values).Looped(node, block)
	if IsCustom(node, block)
		return ErrorCodegen(values).Handled(SyntaxNode("MethodCall", node.text, node.children), block)
	if node.text is in ("and", "or")
		return Logical(node, block)
	node.text is "else" then Choice(node, block) else Contains(node, block)
Choice(node SyntaxNode, block CodeBlock) CodeBlock
	Plain.Choice(Choose, CodeBlock.Empty).instructions.Length is 14
	Plain.Choice(Narrowing, CodeBlock.Empty.Declare("x", "Number")).instructions(6).texts.First is "Strict/Error"
	let decision = node.children(0)
	let condition = Condition(decision.children(0), block)
	let name = "conditional" + (condition.nextId - 1)
	let narrowed = ErrorCodegen(values).Narrowed(decision.children(0), condition)
	let chosen = ErrorCodegen(values).Handled(decision.children(1), narrowed).Chosen(name, condition.nextId - 1)
	let isNarrowed = narrowed.scope.names.Length > condition.scope.names.Length
	let target = isNarrowed then decision.children(0).children(0).text else ""
	let restored = isNarrowed then chosen.Declare(target, condition.scope.TypeOf(target)) else chosen
	ErrorCodegen(values).Handled(node.children(1), restored).Joined(name, chosen.nextId - 1)
Logical(node SyntaxNode, block CodeBlock) CodeBlock
	Plain.Logical(SyntaxNode("Binary", "or", (One, One)), CodeBlock.Empty).nextId is 1
	let left = values.Expression(node.children(0), block)
	let name = "logical" + left.nextId
	let jump = node.text is "and" then InstructionType.JumpToIdIfFalse else InstructionType.JumpToIdIfTrue
	values.Expression(node.children(1), left.Skipping(name, jump)).Joined(name, left.nextId)
Contains(node SyntaxNode, block CodeBlock) CodeBlock
	Plain.Contains(InOnes, CodeBlock.Empty).instructions.Last.kind is InstructionType.Invoke
	let collection = node.children(1)
	let isErrors = values.inference.types.ElementType(values.TypeOf(collection, block)) is in ErrorCodegen.ErrorTypes
	let name = "contained" + block.nextId
	let stored = isErrors then ErrorCodegen(values).Kept(node.children(0), name, block) else block
	let element = isErrors then SyntaxNode("Identifier", name) else node.children(0)
	let call = SyntaxNode("MethodCall", "in", (collection, element))
	values.InstanceCall((node.text is "is in" then call else SyntaxNode("Not", "", List(SyntaxNode) + call)), stored)
Condition(node SyntaxNode, block CodeBlock) CodeBlock
	Plain.Condition(SyntaxNode("Boolean", "true"), CodeBlock.Empty).nextId is 1
	Plain.Condition(SyntaxNode("Binary", ">", (NoNode, NoNode)), CodeBlock.Empty).instructions.Length is 4
	let compared = Compared(node, block)
	compared.Add(InstructionEntry.Jump(InstructionType.JumpToIdIfFalse, compared.nextId)).WithNextId
Compared(node SyntaxNode, block CodeBlock) CodeBlock
	Plain.Compared(SyntaxNode("Binary", ">", (NoNode, NoNode)), CodeBlock.Empty).instructions.Length is 3
	Plain.Compared(NoNode, CodeBlock.Empty).instructions.Last.kind is InstructionType.Equal
	let isCompared = (node.Kind is "Binary") and (node.text is in ("is", "is not", "<", ">"))
	let isComparison = isCompared and (Decided(node, block) is "") and (IsCustom(node, block) is false)
	let operand = isComparison then node.children(0) else node
	let errors = ErrorCodegen(values)
	let left = errors.Compared(node, operand, block)
	let truth = InstructionEntry.LoadBoolean(left.register, true)
	let right = isComparison then errors.Right(node, left, false) else left.Load(truth)
	let type = isComparison then OperatorType(node.text) else InstructionType.Equal
	right.Add(InstructionEntry.Binary(type, (left.Result, right.Result)))
OperatorType(operator Text) Number
	Plain.OperatorType("*") is InstructionType.Multiply
	Plain.OperatorType("is not") is InstructionType.NotEqual
	Plain.OperatorType(">=") is InstructionType.LessThan
	Plain.OperatorType("xor") is InstructionType.NotEqual
	constant arithmetic = ("+", "-", "*", "/", "%", "^")
	constant UnsupportedOperator = Error
	if operator is in arithmetic
		return InstructionType.Add + arithmetic.Index(operator)
	if operator is in Comparisons
		return InstructionType.Equal + ComparisonOffsets(Comparisons.Index(operator))
	UnsupportedOperator