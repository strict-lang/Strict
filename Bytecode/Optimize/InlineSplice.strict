has callee MethodEntry
has call InstructionEntry
has base Number
has member Text
has kept Texts
has fields Texts = List(Text)
has scratch Number = -1
constant Sample = InlineSplice(Inliner.First, Inliner.Calling.instructions(1), 2, "elements", List(Text))
constant Jumps = (InstructionType.JumpToIdIfFalse, InstructionType.JumpToIdIfTrue, InstructionType.JumpEnd)
constant Squaring = InlineSplice(StructLanes.Squared, StructLanes.Calling(4), 5, "", List(Text), ("real", "imaginary"), 18)
constant Owning = InlineSplice(StructLanes.Squared, InstructionEntry.Invoke(4, ("Strict/Pair", "Squared", "Strict/Pair"), List(Number), -1), 5, "", ("real", "imaginary", "value"), ("real", "imaginary"), 18)
constant CheckedValue = (InstructionEntry.Named(InstructionType.LoadVariableToRegister, 0, "value"), InstructionEntry(InstructionType.CheckError, List(Text), List(Number) + 5), InstructionEntry.Return(0))
constant Rebuilt = (InstructionEntry.LoadNumber(0, 1), InstructionEntry.Named(InstructionType.StoreRegisterToVariable, 0, ChangedInstance.Name), InstructionEntry.Return(0))
constant Changing = InlineSplice(MethodEntry("Next", List(MemberEntry), "Strict/Number", Rebuilt), InstructionEntry.Invoke(4, ("Strict/R", "Next", "Strict/Number"), List(Number), 3), 4, "", List(Text))
constant Valued = InlineSplice(MethodEntry("V", List(MemberEntry), "Strict/Number", CheckedValue), Inliner.Calling.instructions(1), 2, "elements", List(Text))
Spliced List(InstructionEntry)
	Valued.Spliced.Length is 4
	Sample.Spliced.Length is 3
	Sample.Spliced(2).texts.First is "inline2_elements"
	Changing.Spliced.Last is InstructionEntry.Named(InstructionType.LoadVariableToRegister, 5, "inline4_changed_instance")
	returned = callee.instructions.Last.payload(0) + base
	mutable result = Prologue
	for callee.instructions
		if index < callee.instructions.Length - (IsChecked then 2 else 1)
			result = result + Move(value, returned)
	instance = Prefix + ChangedInstance.Name
	changed = InstructionEntry.Named(InstructionType.LoadVariableToRegister, call.payload(0) + 1, instance)
	IsChanging then result + changed else result
IsChanging Boolean
	Changing.IsChanging and Sample.IsChanging is false
	for callee.instructions
		if value.kind is InstructionType.StoreRegisterToVariable and value.texts.First is ChangedInstance.Name
			return true
	false
Prefix Text
	Sample.Prefix is "inline2_"
	"inline" + base + "_"
Prologue List(InstructionEntry)
	Sample.Prologue.Length is 1
	Sample.Prologue.First.texts.First is "inline2_elements"
	Owning.Prologue.Length is 0
	Valued.Prologue.Length is 2 and Valued.Prologue.Last.texts is ("inline2_value")
	reads = LoadReuse(List(InstructionEntry)).InvokeReads(call)
	mutable lines = List(Mutable(InstructionEntry))
	for callee.parameters
		lines.Add(Store(call.payload(reads(index)), value.Name))
	if member is ""
		return lines + ReadFields(reads)
	instance = call.payload(reads.Last)
	IsValued then lines + (Store(instance, member), Store(instance, "value")) else lines + Store(instance, member)
Move(entry InstructionEntry, returned Number) InstructionEntry
	Sample.Move(Inliner.First.instructions(1), 3).payload is (1, 2, -1)
	Sample.Move(Inliner.First.instructions(1), 3).line is Inliner.Calling.instructions(1).line
	Sample.Move(InstructionEntry.Jump(InstructionType.JumpEnd, 2), 3).payload is (186, 23)
	Owning.Move(StructLanes.Squared.instructions(0), 3).texts is ("real")
	rebased = LoadReuse(List(InstructionEntry)).Rebase(entry, base)
	isNamed = entry.kind is in Inliner.Renamed and entry.texts.First is not in kept
	texts = isNamed then List(Text) + (Prefix + entry.texts.First) else entry.texts
	payload = entry.kind is in Jumps then Jump(entry) else Register(rebased, returned, call.payload(0))
	InstructionEntry(entry.kind, texts, payload, call.line)
Register(entry InstructionEntry, source Number, target Number) Numbers
	Sample.Register(InstructionEntry.Return(5), 5, 9) is (9)
	Sample.Register(InstructionEntry.LoadNumber(0, 5), 5, 9) is (0, 1, 5)
	reuse = LoadReuse(List(InstructionEntry))
	positions = reuse.ReadPositions(entry) + reuse.WritePosition(entry)
	for entry.payload
		index is in positions and value is source then target else value
IsChecked Boolean
	Sample.IsChecked
	Valued.IsChecked is false
	instructions = callee.instructions
	last = instructions.Length > 1 then instructions(instructions.Length - 2) else instructions.Last
	last.kind is InstructionType.CheckError and last.payload(0) is instructions.Last.payload(0)
Store(register Number, name Text) InstructionEntry
	Sample.Store(4, "a").line is Inliner.Calling.instructions(1).line
	Sample.Store(4, "a").texts is ("inline2_a") and Sample.Store(4, "a").payload is (4, -1)
	InstructionEntry(Inliner.Store, List(Text) + (Prefix + name), (register, -1), call.line)
IsValued Boolean
	Sample.IsValued is false
	Valued.IsValued
	for callee.instructions
		if value.kind is InstructionType.LoadVariableToRegister and value.texts.First is "value"
			return true
	false
ReadFields(reads Numbers) List(InstructionEntry)
	Squaring.ReadFields(7).Length is 4
	Squaring.ReadFields(7)(3).texts is ("inline5_imaginary")
	Squaring.Spliced(4).texts is ("inline5_real")
	Squaring.Spliced(5).payload is (3, 5, 5, 7)
	Sample.ReadFields(7).Length is 0
	Owning.ReadFields(7).Length is 0
	if fields.Length is 0 or InlineRules(callee).IsOwn(call)
		return List(InstructionEntry)
	mutable lines = List(Mutable(InstructionEntry))
	for fields
		lines = lines + (Field(value, call.payload(reads.Last)), Store(scratch, value))
	lines
Field(name Text, instance Number) InstructionEntry
	Squaring.Field("imaginary", 2).texts is ("imaginary", "Pair")
	Squaring.Field("imaginary", 2).payload is (18, 2, -1, -2)
	owner = TypeEntry.ShortName(call.texts(0))
	InstructionEntry(InstructionType.FieldLoad, (name, owner), (scratch, instance, -1, -2), call.line)
Jump(entry InstructionEntry) Numbers
	Sample.Jump(InstructionEntry.Jump(InstructionType.JumpEnd, 300)) is (228, 25)
	InstructionEntry.Jump(entry.kind, ByteEncoder(entry.payload).Integers.First + (base + 1) * 1000).payload
