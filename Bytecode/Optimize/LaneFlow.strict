has types List(TypeEntry)
has lists Texts = List(Text)
has fixed Texts = List(Text)
has skips LaneSkips = LaneSkips.None
constant Sample = LaneFlow((StructLanes.Caller, StructLanes.Pair))
constant Kept = InstructionEntry.Named(InstructionType.StoreRegisterToVariable, 2, "pair")
constant Reloaded = InstructionEntry.Named(InstructionType.LoadVariableToRegister, 5, "pair")
constant Copying = (StructLanes.Constructed, Kept, Reloaded, InstructionEntry.Named(InstructionType.StoreRegisterToVariable, 5, "copy"))
constant Others = ("2 Strict/Other", "3 Pair")
constant Naming = (InstructionType.StoreConstantToVariable, InstructionType.IndexCall, InstructionType.InvokeWriteToList, InstructionType.InvokeWriteToTable, InstructionType.InvokeRemove, InstructionType.CheckError)
constant Checked = Copying + InstructionEntry(InstructionType.CheckError, List(Text) + "copy", (0, 5))
constant Pairs = MemberEntry("pairs", "Strict/List(Pair)", List(InstructionEntry), false)
constant Picking = InstructionEntry(InstructionType.IndexCall, "pairs", (2, 1, -1))
constant Holder = TypeEntry("Strict/Holder", List(MemberEntry) + Pairs, List(MethodEntry))
constant Mixed = Copying + InstructionEntry.Named(InstructionType.StoreRegisterToVariable, 0, "copy")
constant Chained = Copying + (InstructionEntry.Named(InstructionType.LoadVariableToRegister, 6, "copy"), InstructionEntry.Named(InstructionType.StoreRegisterToVariable, 6, "again"))
constant Changing = InstructionEntry.Invoke(6, ("Strict/Ticker", "Next", "Strict/Number"), List(Number), 3)
constant Crossed = (StructLanes.Constructed, InstructionEntry.Named(InstructionType.StoreRegisterToVariable, 2, "x"), InstructionEntry.Named(InstructionType.LoadVariableToRegister, 5, "y"))
constant Crossing = Crossed + (InstructionEntry.Named(InstructionType.StoreRegisterToVariable, 5, "x"), StructLanes.Constructed, InstructionEntry.Named(InstructionType.StoreRegisterToVariable, 2, "y"))
constant Cycle = Crossing + (InstructionEntry.Named(InstructionType.LoadVariableToRegister, 6, "x"), InstructionEntry.Named(InstructionType.StoreRegisterToVariable, 6, "y"))
constant ElementStore = (StructLanes.Constructed, StructLanes.Label(InstructionType.StoreRegisterToVariable, 2, "pairs(0)", 0))
Variables(instructions List(InstructionEntry), candidates Texts, rounds Number) Texts
	Sample.Variables(Copying, List(Text), 4) is ("pair Pair", "copy Pair")
	Sample.Variables(Copying, List(Text), 0) is ("pair Pair") and Sample.Variables(Mixed, List(Text), 4) is ("pair Pair")
	Sample.Variables(Chained, List(Text), 1) is ("pair Pair", "copy Pair")
	Sample.Variables(Chained, List(Text), 4) is ("pair Pair", "copy Pair", "again Pair")
	Sample.Variables(ElementStore, List(Text), 4).Length is 0
	Sample.Variables(Cycle, List(Text), 4) is ("x Pair", "y Pair")
	found = Scan(instructions, candidates)
	if found is not candidates
		return rounds is 0 then found else Variables(instructions, found, rounds - 1)
	hoped = LaneHopes(value, Stores(instructions, found)).Hoped
	kept = Scan(instructions, hoped)
	kept.Length is hoped.Length and (kept - hoped).Length is 0 then kept else found
Scan(instructions List(InstructionEntry), candidates Texts) Texts
	Sample.Scan(Copying, "pair Pair") is ("pair Pair", "copy Pair")
	Sample.Scan(Checked, "pair Pair") is ("pair Pair")
	Agreed(Stores(instructions, candidates))
Stores(instructions List(InstructionEntry), candidates Texts) Texts
	Sample.Stores(Copying, List(Text)) is ("pair Pair", "copy ?pair") and Sample.Stores(Mixed, List(Text)).Last is "copy -"
	mutable laned = List(Text)
	mutable loaded = List(Text)
	mutable stores = List(Text)
	for instructions
		if value.kind is in Naming and value.texts.Length > 0 or value.kind is InstructionType.StoreRegisterToVariable
			stores = stores + Store(value, laned, loaded)
		loaded = Load(value, loaded)
		laned = Track(value, laned, candidates + fixed)
	stores
Store(entry InstructionEntry, laned Texts, loaded Texts) Text
	Sample.Store(Kept, "2 Pair", List(Text)) is "pair Pair" and Sample.Store(Kept, List(Text), List(Text)) is "pair -"
	Sample.Store(Kept, List(Text), "2 other") is "pair ?other"
	Sample.Store(ElementStore.Last, "2 Pair", "2 other") is "pairs(0) -"
	Sample.Store(Picking, "2 Pair", "2 other") is "pairs -"
	isNamed = entry.kind is not InstructionType.StoreRegisterToVariable
	isFixed = isNamed or entry.texts(0).IndexOf("(") > 0 or entry.texts(0).StartsWith("changed_")
	type = isFixed then "" else FindType(laned, entry.payload(0) to Text)
	source = isFixed then "" else FindType(loaded, entry.payload(0) to Text)
	entry.texts(0) + " " + (type is not "" then type else source is "" then "-" else "?" + source)
Load(entry InstructionEntry, loaded Texts) Texts
	Sample.Load(Reloaded, List(Text)) is ("5 pair") and Sample.Load(StructLanes.Constructed, ("2 a", "5 b")) is ("5 b")
	written = LoadReuse(List(InstructionEntry)).Write(entry)
	kept = Without(loaded, written)
	entry.kind is InstructionType.LoadVariableToRegister then kept + (written + " " + entry.texts(0)) else kept
Agreed(stores Texts) Texts
	Sample.Agreed(("a Pair", "b -", "a Pair", "c Pair", "c -")) is ("a Pair")
	LaneFlow(Sample.types, List(Text), "pair Pair").Scan(Copying, List(Text)) is ("pair Pair", "copy Pair")
	Sample.Scan(Copying + InstructionEntry(InstructionType.StoreConstantToVariable, "pair", 0), List(Text)).Length is 0
	for stores
		if stores.Index(value) is index and IsUniform(stores, value)
			value
IsUniform(stores Texts, entry Text) Boolean
	Sample.IsUniform(("a Pair", "a -"), "a Pair") is false
	Sample.IsUniform(("a Pair", "b -"), "a Pair")
	Sample.IsUniform(("ab Pair", "a Pair"), "a Pair")
	if entry.EndsWith(" -") or entry.IndexOf(" ?") > 0
		return false
	prefix = entry.Substring(0, entry.IndexOf(" ") + 1)
	for stores
		if value.StartsWith(prefix) and value is not entry
			return false
	true
Track(entry InstructionEntry, laned Texts, variables Texts) Texts
	Sample.Track(StructLanes.Constructed, Others, List(Text)) is ("3 Pair", "2 Pair")
	Sample.Track(Reloaded, List(Text), "pair Pair") is ("5 Pair")
	Sample.Track(InstructionEntry.LoadNumber(3, 1), "3 Pair", List(Text)).Length is 0
	Sample.Track(Changing, ("7 Pair", "2 Pair", "9 Pair"), List(Text)) is ("2 Pair", "9 Pair")
	written = LoadReuse(List(InstructionEntry)).Write(entry)
	if written < 0
		return laned
	isCall = entry.kind is InstructionType.Invoke then entry.texts(1) is not "from" else false
	kept = isCall then Unchange(laned, entry) else Without(laned, written)
	type = Produce(entry, variables)
	type is "" then kept else kept + (written + " " + type)
Unchange(laned Texts, call InstructionEntry) Texts
	Sample.Unchange(("6 Pair", "7 Pair", "8 Pair", "9 Pair", "5 Pair"), Changing) is ("9 Pair", "5 Pair")
	written = call.payload(0)
	last = written + LoadReuse(List(InstructionEntry)).InvokeReads(call).Length + 1
	for laned
		register = value.Split(" ").First to Number
		if register < written or register > last
			value
Produce(entry InstructionEntry, variables Texts) Text
	Sample.Produce(StructLanes.Constructed, List(Text)) is "Pair"
	Sample.Produce(Reloaded, "pair Pair") is "Pair"
	Sample.Produce(StructLanes.Calling(4), List(Text)) is ""
	LaneFlow(Sample.types, "pairs Pair").Produce(Picking, List(Text)) is "Pair"
	LaneFlow(LaneCalls.Sample.types).Produce(LaneCalls.Offsets, List(Text)) is "Pair"
	LaneFlow(Sample.types, skips = LaneSkips.Drawn).Produce(LaneCalls.Offsets, List(Text)) is "Pair"
	if IsBuilt(entry)
		return TypeEntry.ShortName(entry.texts(0))
	if entry.kind is InstructionType.IndexCall
		return TypeEntry.ShortName(FindType(lists, entry.texts(0)))
	if entry.kind is InstructionType.FieldLoad
		return Field(entry)
	entry.kind is InstructionType.LoadVariableToRegister then FindType(variables, entry.texts(0)) else ""
Field(entry InstructionEntry) Text
	LaneFlow(LaneCalls.Sample.types).Field(LaneCalls.Offsets) is "Pair" and Sample.Field(LaneCalls.Offsets) is ""
	if skips.IsTabled(entry.texts(1))
		return FindType(skips.fields, TypeEntry.ShortName(entry.texts(1)) + "." + entry.texts(0))
	FindType(LaneCalls(types).Lane(Inliner(types).TypeOf(entry.texts(1)).members), entry.texts(0))
IsBuilt(entry InstructionEntry) Boolean
	Sample.IsBuilt(StructLanes.Constructed)
	Sample.IsBuilt(StructLanes.Calling(4)) is false
	LaneFlow(Sample.types, skips = LaneSkips.Sizes).IsBuilt(StructLanes.Constructed) is false
	Sample.IsBuilt(StructLanes.Calling(0)) is false
	Sample.IsBuilt(LaneCalls.Paired) is false
	Sample.IsBuilt(InstructionEntry.Invoke(2, ("Pair", "from", "Pair", "real"), List(Number) + 0, -1)) is false
	if entry.kind is not InstructionType.Invoke or entry.texts(1) is not "from"
		return false
	if skips.IsTabled(entry.texts(0)) and TypeEntry.ShortName(entry.texts(0)) is not in skips.structs
		return false
	reads = LoadReuse(List(InstructionEntry)).InvokeReads(entry)
	type = Inliner(types).TypeOf(entry.texts(0))
	if reads.Length is not entry.texts.Length - 3 or StructLanes(types).Members(type).Length is 0
		return false
	IsFull(type, entry.texts.Slice(3, entry.texts.Length - 3))
IsFull(type TypeEntry, passed Texts) Boolean
	Sample.IsFull(StructLanes.Pair, ("real", "imaginary"))
	Sample.IsFull(StructLanes.Pair, List(Text) + "real") is false
	for type.members
		if value.IsConstant is false and value.typeName is not in StructLanes.DataLess and value.Name is not in passed
			if StructLanes.IsLane(value) is false or value.initial.Length is 0
				return false
	true
FindType(entries Texts, name Text) Text
	Sample.FindType(("pair Pair", "other Strict/Other"), "other") is "Strict/Other"
	Sample.FindType("pair Pair", "pa") is ""
	Sample.IsBuilt(InstructionEntry.Invoke(2, ("Pair", "from", "Pair", "real", "imaginary", "x"), (0, 1), -1)) is false
	Sample.Scan(StructLanes.Calling, List(Text)).Length is 0
	for entries
		if value.StartsWith(name + " ")
			return value.Substring(name.Length + 1, value.Length - name.Length - 1)
	""
Without(laned Texts, register Number) Texts
	Sample.Without(("2 Pair", "3 Pair"), 2) is ("3 Pair")
	Sample.Without(("2 Pair", "23 Pair"), 2) is ("23 Pair")
	for laned
		if value.StartsWith(register + " ") is false
			value
Lists(type TypeEntry, method MethodEntry) Texts
	Sample.Lists(Holder, StructLanes.Squared) is ("pairs Strict/Pair")
	Sample.Lists(StructLanes.Caller, StructLanes.Squared).Length is 0
	Sample.Lists(StructLanes.Pair, StructLanes.Squared).Length is 0
	for type.members + method.parameters
		element = Element(value.typeName)
		if element is not ""
			value.Name + " " + element
Element(typeName Text) Text
	Sample.Element("Strict/List(Pair)") is "Strict/Pair"
	Sample.Element("Strict/Pairs") is "Strict/Pair"
	Sample.Element("Strict/List(Number)") is ""
	Sample.Element("Strict/Pairx") is "" and Sample.Element("Strict/Callers") is ""
	short = TypeEntry.ShortName(typeName)
	plural = short.EndsWith("s") then short.Substring(0, short.Length - 1) else ""
	element = Inliner(types).TypeOf(short.StartsWith("List(") then short.Substring(5, short.Length - 6) else plural)
	StructLanes(types).Members(element).Length > 0 then element.Name else ""
