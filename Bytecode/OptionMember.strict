has options OptionsCodegen
has line Text
constant Count = OptionMember(OptionsCodegen.Settings, "has count = 1")
constant Kind = OptionMember(OptionsCodegen.Settings, "has kind = Opcode.Add")
constant Sized = OptionMember(OptionsCodegen.Rendering, "has resolution Resolution")
Name Text
	Count.Name is "count"
	options.automatic.Header(line).MemberName
Type Text
	OptionMember(OptionsCodegen.Settings, "has loras = List(Text)").Type is "Texts"
	Count.Type is "Number"
	options.automatic.MemberType(line)
Default Text
	Count.Default is "1"
	Sized.Default is "resolution"
	at = line.IndexOf(" = ")
	at < 0 then Name else line.Substring(at + 3, line.Length - at - 3)
Source Texts
	Kind.Source.First is "constant Set"
	Count.Source.Length is 0
	kind = Type
	if kind is in ("Number", "Text", "Boolean", "Texts")
		return List(Text)
	path = options.folder + "/" + kind + ".strict"
	File(path).Exists then File(path).ReadLines else List(Text)
IsEnumerated Boolean
	Kind.IsEnumerated
	Count.IsEnumerated is false
	Sized.IsEnumerated is false
	IsEnumeratedSource(Source)
IsEnumeratedSource(source Texts) Boolean
	Kind.IsEnumeratedSource(Kind.Source)
	for source
		if value is not "" and value.StartsWith("constant ") is false
			return false
	source.Length > 0
IsNested Boolean
	Sized.IsNested
	Kind.IsNested is false
	source = Source
	source.Length > 0 and IsEnumeratedSource(source) is false
Choices Scope
	Kind.Choices.names(6) is "greaterthan"
	Kind.Choices.types(1) is "1"
	ChoicesOf(Source)
ChoicesOf(source Texts) Scope
	Kind.ChoicesOf(Kind.Source).types(1) is "1"
	scope = TypeShape(source).ConstantScope
	Scope(Text.Combine(scope.names, "|").Lower.Split("|"), scope.types)
Nested OptionsCodegen
	Sized.Nested.Names is ("width", "height")
	NestedOf(Source)
NestedOf(source Texts) OptionsCodegen
	Sized.NestedOf(Sized.Source).Names is ("width", "height")
	OptionsCodegen(Automatic(source, Type, options.automatic.instantiation), options.folder)
Names Texts
	Sized.Names is ("width", "height")
	Count.Names is ("count")
	source = Source
	source.Length > 0 and IsEnumeratedSource(source) is false then NestedOf(source).Names else List(Text) + Name
Argument Text
	Count.Argument is "line.Numeric(\"count\", 1)"
	Sized.Argument is "Resolution(line.Numeric(\"width\", 720), line.Numeric(\"height\", 1280))"
	Kind.Argument.StartsWith("line.Chosen(\"kind\", (\"set\", \"add\", ")
	at = ("Number", "Text", "Boolean", "Texts").Index(Type)
	if at >= 0
		return "line." + ("Numeric", "Option", "HasFlag", "Repeated")(at) + "(\"" + Name + "\", " + Default + ")"
	source = Source
	if source.Length is 0
		return Default
	if IsEnumeratedSource(source)
		return ChosenArgument(ChoicesOf(source))
	Type + "(" + Text.Combine(NestedOf(source).Arguments, ", ") + ")"
ChosenArgument(choices Scope) Text
	Count.ChosenArgument(Kind.Choices).StartsWith("line.Chosen(\"count\", (\"set\", \"add\", ")
	listed = options.Joined(options.Quoted(choices.names), "Text") + ", " + options.Joined(choices.types, "Number")
	"line.Chosen(\"" + Name + "\", " + listed + ", " + Default + ")"
Shown Texts
	Count.Shown is ("1 to Text")
	Sized.Shown is ("720 to Text", "1280 to Text")
	source = Source
	source.Length > 0 and IsEnumeratedSource(source) is false then NestedOf(source).Shown else List(Text) + Displayed
Displayed Text
	Count.Displayed is "1 to Text"
	Kind.Displayed.EndsWith("|jumpbackifnonzero)\"")
	kind = Type
	if kind is in ("Text", "Texts")
		return kind is "Text" then Default else "Text.Combine(" + Default + ", \" \")"
	source = kind is in ("Number", "Boolean") then List(Text) else Source
	if source.Length is 0 or IsEnumeratedSource(source) is false
		return Default + " to Text"
	choices = ChoicesOf(source)
	names = choices.names
	chosen = options.Joined(options.Quoted(names), "Text") + "(" + options.Joined(choices.types, "Number")
	chosen + ".Index(" + Default + ")) + \" (" + Text.Combine(names, "|") + ")\""
Described(help Text, at Number) Texts
	Count.Described("Help", 2) is ("Help(2)")
	Count.Described("", 0) is ("\"\"")
	Sized.Described("", 0) is ("Resolution.Help(0)", "Resolution.Help(1)")
	source = Source
	if source.Length > 0 and IsEnumeratedSource(source) is false
		return NestedOf(source).Descriptions(Type + ".")
	List(Text) + (help is "" then "\"\"" else help + "(" + at + ")")
