has automatic Automatic
has folder Text
constant Settings = OptionsCodegen(Automatic(("has prompt = \"prompt.txt\"", "has kind = Opcode.Add", "has count = 1", "has loras = List(Text)", "has jsonOutput = false"), "Settings", Instantiation.Pairing), "Examples")
constant Single = OptionsCodegen(Automatic(List(Text) + "has count = 1", "One", Instantiation.Pairing), "Examples")
constant Memberless = OptionsCodegen(Automatic(TypeCodegen.Hello.lines, "HelloLogger", Instantiation.Pairing), "Examples")
constant HelloParsed = List(Text) + "Strict/HelloLogger.Parsed"
constant Rendering = OptionsCodegen(Automatic(File("Examples/Rendering.strict").ReadLines, "Rendering", Instantiation.Pairing), "Examples")
constant SettingsParsed = Settings.Parsed
Lines(names Texts) Texts
	Settings.Lines(List(Text)).Length is 0
	Settings.Lines(("Parsed", "Usage")).Length is 5
	Settings.Lines(List(Text) + "Usage").First is "Usage Text"
	parsed = automatic.IsWanted("Parsed", names) then Parsed else List(Text)
	parsed + (automatic.IsWanted("Usage", names) then Usage else List(Text))
Completed(main TypeCodegen, entry TypeEntry, targets Texts) TypeEntry
	Settings.Completed(TypeCodegen.Hello, TypeEntry.HelloLogger, List(Text)) is TypeEntry.HelloLogger
	Memberless.Completed(TypeCodegen.Hello, TypeEntry.HelloLogger, HelloParsed) is TypeEntry.HelloLogger
	prefix = main.fullName + "."
	wanted = (prefix + "Parsed") is in targets or prefix + "Usage" is in targets
	if wanted is false or automatic.instantiation.types.Inherited(automatic.instance, "Parsed") is ""
		return entry
	names = entry.Chosen("Parsed", -1, "Parsed", List(Text)) < 0 then List(Text) + "Parsed" else List(Text)
	missing = names + (entry.Chosen("Usage", -1, "Usage", List(Text)) < 0 then List(Text) + "Usage" else List(Text))
	automatic.Appended(main, entry, automatic.lines + Lines(missing))
Parsed Texts
	Settings.Parsed.First is "Parsed(arguments Texts) Settings"
	SettingsParsed(1).EndsWith("\"loras\", \"jsonOutput\")).Checked")
	SettingsParsed.Last.StartsWith("\tSettings(line.Option(\"prompt\", \"prompt.txt\"), line.Chosen(\"kind\", ")
	SettingsParsed.Last.EndsWith("line.Repeated(\"loras\", List(Text)), line.HasFlag(\"jsonOutput\", false))")
	Single.Parsed(1) is "\tlet line = CommandLine(arguments, List(Text) + \"count\").Checked"
	Rendering.Parsed.Last.StartsWith("\tRendering(Resolution(line.Numeric(\"width\", 720), ")
	members = Members
	line = "\tlet line = CommandLine(arguments, " + Joined(Quoted(MemberNames(members)), "Text") + ").Checked"
	built = "\t" + automatic.instance + "(" + Text.Combine(MemberArguments(members), ", ") + ")"
	(List(Text) + ("Parsed(arguments Texts) " + automatic.instance) + line) + built
Usage Texts
	Settings.Usage.Last.EndsWith("false to Text), (\"\", \"\", \"\", \"\", \"\"))")
	Single.Usage.Last.EndsWith(".Usage(List(Text) + 1 to Text, List(Text) + \"\")")
	Rendering.Usage.Last.EndsWith(", (Resolution.Help(0), Resolution.Help(1), Help(0)))")
	members = Members
	shown = MemberShown(members)
	described = MemberDescriptions("", members)
	usage = ").Usage(" + Joined(shown, "Text") + ", " + Joined(described, "Text") + ")"
	(List(Text) + "Usage Text") + ("\tCommandLine(List(Text), " + Joined(Quoted(MemberNames(members)), "Text") + usage)
Listed Text
	Single.Listed is "List(Text) + \"count\""
	Joined(Quoted(Names), "Text")
Members List(OptionMember)
	Settings.Members.Length is 5
	for automatic.Stored
		OptionMember(OptionsCodegen(automatic, folder), value)
Names Texts
	Settings.Names is ("prompt", "kind", "count", "loras", "jsonOutput")
	Rendering.Names is ("width", "height", "samples")
	MemberNames(Members)
MemberNames(members List(OptionMember)) Texts
	Settings.MemberNames(Settings.Members) is ("prompt", "kind", "count", "loras", "jsonOutput")
	mutable names = List(Text)
	for members
		names = names + value.Names
	names
Arguments Texts
	Settings.Arguments(2) is "line.Numeric(\"count\", 1)"
	MemberArguments(Members)
MemberArguments(members List(OptionMember)) Texts
	Settings.MemberArguments(Settings.Members)(2) is "line.Numeric(\"count\", 1)"
	for members
		value.Argument
Shown Texts
	Settings.Shown.First is "\"prompt.txt\""
	Rendering.Shown is ("720 to Text", "1280 to Text", "4 to Text")
	MemberShown(Members)
MemberShown(members List(OptionMember)) Texts
	Settings.MemberShown(Settings.Members).First is "\"prompt.txt\""
	mutable shown = List(Text)
	for members
		shown = shown + value.Shown
	shown
Descriptions(prefix Text) Texts
	Settings.Descriptions("").First is "\"\""
	Rendering.Descriptions("") is ("Resolution.Help(0)", "Resolution.Help(1)", "Help(0)")
	MemberDescriptions(prefix, Members)
MemberDescriptions(prefix Text, members List(OptionMember)) Texts
	Settings.MemberDescriptions("", Settings.Members).First is "\"\""
	help = Text.Combine(automatic.lines, "\n").IndexOf("constant Help =") >= 0 then prefix + "Help" else ""
	mutable plain = 0
	mutable described = List(Text)
	for members
		described = described + value.Described(help, plain)
		plain = plain + (value.IsNested then 0 else 1)
	described
Quoted(texts Texts) Texts
	Settings.Quoted(("a", "b")) is ("\"a\"", "\"b\"")
	for texts
		"\"" + value + "\""
Joined(expressions Texts, type Text) Text
	Settings.Joined(("a", "b"), "Text") is "(a, b)"
	Settings.Joined(List(Text) + "1", "Number") is "List(Number) + 1"
	if expressions.Length is 1
		return "List(" + type + ") + " + expressions.First
	"(" + Text.Combine(expressions, ", ") + ")"
