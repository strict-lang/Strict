has target Text
constant Organization = "https://api.github.com/orgs/strict-lang/repos?per_page=100"
constant Raw = "https://raw.githubusercontent.com/"
constant Delimiters = (" ", ")", "]", "#", "?", "\"", "'", ">", "<", ",", "/")
constant Listing = ("  \"tree\": [", "      \"path\": \"Math/Vector2.strict\",", "      \"path\": \"Math/Size.strict\",", "      \"path\": \"Math/README.md\",", "      \"path\": \"Vector2.strict\",")
constant Readme = ("See https://github.com/strict-lang/Strict.", "[a](https://github.com/b/c.git) github.com/d")
constant Nested = ("Math/Vector2.strict", "Math/Shapes/Circle.strict", "Text.strict")
constant Listed = ("  {", "    \"full_name\": \"strict-lang/Strict\",", "    \"full_name\": \"strict-lang/sdk\",")
Download(type Text) Text
	for Clones
		local = SourceFiles(value).SubfolderWith(value, type)
		if local is not "" and IsHere(value) is false
			return Directory.Exists(target + "/" + Path(local).FileName.text) then "" else Copy(local, type)
	for Directory.Exists(Development + "/strict-lang") then List(Text) else Candidates
		folder = FetchFile(value, type)
		if folder is not ""
			return folder
	""
Development Text
	TypeSource.Absolute(TypeSource.Root).StartsWith(Repositories.Development + "/")
	Path(Path(TypeSource.Absolute(TypeSource.Root)).PathOnly.text).PathOnly.text
IsHere(folder Text) Boolean
	Repositories.IsHere(Directory.Current)
	Repositories.IsHere("C:/Missing") is false
	folder.Replace("\\", "/").Lower is Directory.Current.Replace("\\", "/").Lower
Clones Texts
	(Repositories.Clones.Length > 0) is Directory.Exists(Repositories.Development + "/strict-lang")
	file = File(target + "/README.md")
	readme = file.Exists then Link(file.ReadLines) else List(Text)
	mutable clones = List(Mutable(Text))
	for readme + Own("strict-lang")
		if Directory.Exists(Development + "/" + value) and Development + "/" + value is not in clones
			clones.Add(Development + "/" + value)
	clones
Own(owner Text) Texts
	Repositories.Own("missing-owner").Length is 0
	for Directory.Directories(Development + "/" + owner)
		owner + "/" + Path(value.Replace("\\", "/")).FileName.text
Candidates Texts
	file = File(target + "/README.md")
	mutable candidates = file.Exists then Link(file.ReadLines) else List(Text)
	for Quote(Fetch(Organization), "full_name")
		if value is not in candidates
			candidates = candidates + value
	candidates
FetchFile(repository Text, type Text) Text
	paths = Quote(Fetch("https://api.github.com/repos/" + repository + "/git/trees/HEAD?recursive=1"), "path")
	folder = Folder(paths, type)
	if folder is ""
		return ""
	local = target + "/" + Path(folder is "." then repository else folder).FileName.text
	for Files(paths, folder)
		Download(Raw + repository + "/HEAD/" + value, local + "/" + Relative(value, folder))
	File(local + "/.origin").Write(List(Text) + "https://github.com/" + repository + "/tree/HEAD/" + folder)
	logger.Log("Downloaded " + local + " from https://github.com/" + repository)
	Provide(local, type)
Download(url Text, file Text)
	Repositories("artifacts").Download("https://missing.invalid/a", "Compiler/output/a") is Error
	if Process.RunTool("curl", "-sfL --create-dirs -o \"" + file + "\" \"" + url + "\"").HasFailed
		return Error("DownloadFailed: " + url)
Copy(folder Text, type Text) Text slow
	Repositories("artifacts").Copy("Examples/NativeAdd", "Adder") is "artifacts/NativeAdd"
	local = target + "/" + Path(folder).FileName.text
	for BinaryFile(folder).Contain(folder)
		if value.EndsWith(".strict") or value.Replace("\\", "/").IndexOf("/native/") > 0
			File(local + "/" + Relative(value.Replace("\\", "/"), folder)).Write(File(value).ReadBytes)
	File(local + "/.origin").Write(List(Text) + folder)
	logger.Log("Copied " + local + " from " + folder)
	Provide(local, type)
Fetch(url Text) Texts
	token = Process.RunTool("gh", "auth token")
	isAuthorized = token.HasSucceeded and token.Output.Trim is not ""
	header = isAuthorized then "-H \"Authorization: Bearer " + token.Output.Trim + "\" " else ""
	Process.RunTool("curl", "-sfL " + header + "\"" + url + "\"").Output.Split("\n")
Link(lines Texts) Texts
	Repositories.Link(Readme) is ("strict-lang/Strict", "b/c")
	Repositories.Link(("github.com/a/b", "docs/c/d", "github.com/a/b")) is ("a/b")
	constant host = "github.com/"
	mutable repositories = List(Mutable(Text))
	for lines
		start = value.IndexOf(host)
		if start >= 0
			repository = Repository(value.Substring(start + host.Length, value.Length - start - host.Length))
			if repository is not "" and repository is not in repositories
				repositories.Add(repository)
	repositories
Repository(link Text) Text
	Repositories.Repository("strict-lang/Strict.") is "strict-lang/Strict"
	Repositories.Repository("b/c.git) and more") is "b/c"
	slash = link.IndexOf("/")
	if slash <= 0
		return ""
	mutable end = slash + 1
	for Range(slash + 1, link.Length)
		if end is value and link(value) is not in Delimiters
			end = value + 1
	repository = link.Substring(0, end).Replace(".git", "")
	last = repository.Length - 1
	repository.EndsWith(".") then repository.Substring(0, last) else repository
Quote(lines Texts, key Text) Texts
	Repositories.Quote(Listing, "path") is ("Math/Vector2.strict", "Math/Size.strict", "Math/README.md", "Vector2.strict")
	Repositories.Quote(Listed, "full_name") is ("strict-lang/Strict", "strict-lang/sdk")
	for lines
		start = value.IndexOf("\"" + key + "\": \"")
		if start >= 0
			value.Substring(start + key.Length + 5, value.LastIndexOf("\"") - start - key.Length - 5)
Folder(paths Texts, type Text) Text
	Repositories.Folder(Repositories.Quote(Listing, "path"), "Vector2") is "Math"
	Repositories.Folder(List(Text) + "Vector2.strict", "Vector2s") is "."
	Repositories.Folder(List(Text) + "Math/Size.strict", "Vector2") is ""
	singular = type.EndsWith("s") then type.Substring(0, type.Length - 1) else type
	for paths
		if Path(value).FileName.text is in (type + ".strict", singular + ".strict")
			return value.IndexOf("/") < 0 then "." else value.Substring(0, value.LastIndexOf("/"))
	""
Files(paths Texts, folder Text) Texts
	Repositories.Files(Repositories.Quote(Listing, "path"), "Math") is ("Math/Vector2.strict", "Math/Size.strict")
	Repositories.Files(Repositories.Quote(Listing, "path"), ".").Last is "Vector2.strict"
	Repositories.Files(Nested, "Math") is ("Math/Vector2.strict", "Math/Shapes/Circle.strict")
	Repositories.Files(("Pack/A.strict", "Pack/native/A.c", "Pack/B.txt"), "Pack") is ("Pack/A.strict", "Pack/native/A.c")
	prefix = folder is "." then "" else folder + "/"
	for paths
		if value.StartsWith(prefix) and (value.EndsWith(".strict") or value.IndexOf("/native/") > 0)
			value
Relative(path Text, folder Text) Text
	Repositories.Relative("Math/Shapes/Circle.strict", "Math") is "Shapes/Circle.strict"
	Repositories.Relative("Vector2.strict", ".") is "Vector2.strict"
	folder is "." then path else path.Substring(folder.Length + 1, path.Length - folder.Length - 1)
Provide(local Text, type Text) Text
	Repositories.Provide("./Math", "Vector2") is "./Math"
	Repositories.Provide("./Math", "Missing") is ""
	for BinaryFile(local).Contain(local)
		if value.Replace("\\", "/").EndsWith("/" + type + ".strict")
			return local
	""
Update(folder Text) Number
	Repositories.Update("./Math") is 0
	mutable updated = 0
	for Directory.Directories(folder)
		files = Directory.Files(value, "*.strict")
		if File(value + "/.origin").Exists and files.Length > 0
			type = Path(files.First.Replace("\\", "/")).FileName.text
			if Repositories(folder).Download(type.Substring(0, type.Length - 7)) is not ""
				updated = updated + 1
	updated