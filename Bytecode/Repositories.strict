has logger
has target Text
constant Organization = "https://api.github.com/orgs/strict-lang/repos?per_page=100"
constant Development = "C:/code/GitHub"
constant Raw = "https://raw.githubusercontent.com/"
constant Delimiters = (" ", ")", "]", "#", "?", "\"", "'", ">", "<", ",", "/")
constant Listing = ("  \"tree\": [", "      \"path\": \"Math/Vector2.strict\",", "      \"path\": \"Math/Size.strict\",", "      \"path\": \"Math/README.md\",", "      \"path\": \"Vector2.strict\",")
constant Readme = ("See https://github.com/strict-lang/Strict.", "[a](https://github.com/b/c.git) github.com/d")
constant Nested = ("Math/Vector2.strict", "Math/Shapes/Circle.strict", "Text.strict")
constant Listed = ("  {", "    \"full_name\": \"strict-lang/Strict\",", "    \"full_name\": \"strict-lang/sdk\",")
Downloaded(type Text) Text
	for Clones
		let local = SourceFiles(value).SubfolderWith(value, type)
		if (local is not "") and (IsHere(value) is false)
			return Copied(local, type)
	if Directory.Exists(Development + "/strict-lang")
		return ""
	for Candidates
		let folder = Fetched(value, type)
		if folder is not ""
			return folder
	""
IsHere(folder Text) Boolean
	Repositories.IsHere(Directory.Current)
	Repositories.IsHere("C:/Missing") is false
	folder.Replace("\\", "/").Lower is Directory.Current.Replace("\\", "/").Lower
Clones Texts
	(Repositories.Clones.Length > 0) is Directory.Exists(Repositories.Development + "/strict-lang")
	let file = File(target + "/README.md")
	let readme = file.Exists then Linked(file.ReadLines) else List(Text)
	mutable clones = List(Mutable(Text))
	for readme + Owned("strict-lang")
		if Directory.Exists(Development + "/" + value) and (Development + "/" + value is not in clones)
			clones.Add(Development + "/" + value)
	clones
Owned(owner Text) Texts
	Repositories.Owned("missing-owner").Length is 0
	for Directory.Directories(Development + "/" + owner)
		owner + "/" + Path(value.Replace("\\", "/")).FileName.text
Candidates Texts
	let file = File(target + "/README.md")
	mutable candidates = file.Exists then Linked(file.ReadLines) else List(Text)
	for Quoted(Fetch(Organization), "full_name")
		if value is not in candidates
			candidates = candidates + value
	candidates
Fetched(repository Text, type Text) Text
	let paths = Quoted(Fetch("https://api.github.com/repos/" + repository + "/git/trees/HEAD?recursive=1"), "path")
	let folder = Folder(paths, type)
	if folder is ""
		return ""
	let local = target + "/" + Path((folder is "." then repository else folder)).FileName.text
	for Files(paths, folder)
		let file = local + "/" + Relative(value, folder)
		Process.RunTool("curl", "-sfL --create-dirs -o \"" + file + "\" \"" + Raw + repository + "/HEAD/" + value + "\"")
	File(local + "/.origin").Write(List(Text) + "https://github.com/" + repository + "/tree/HEAD/" + folder)
	logger.Log("Downloaded " + local + " from https://github.com/" + repository)
	Provided(local, type)
Copied(folder Text, type Text) Slow(Text)
	Repositories(Logger, "artifacts").Copied("Examples/NativeAdd", "Adder") is "artifacts/NativeAdd"
	let local = target + "/" + Path(folder).FileName.text
	for BinaryFile(folder).Contained(folder)
		if value.EndsWith(".strict") or (value.Replace("\\", "/").IndexOf("/native/") > 0)
			File(local + "/" + Relative(value.Replace("\\", "/"), folder)).Write(File(value).ReadBytes)
	File(local + "/.origin").Write(List(Text) + folder)
	logger.Log("Copied " + local + " from " + folder)
	Provided(local, type)
Fetch(url Text) Texts
	let token = Process.RunTool("gh", "auth token")
	let isAuthorized = token.Succeeded and (token.Output.Trim is not "")
	let header = isAuthorized then "-H \"Authorization: Bearer " + token.Output.Trim + "\" " else ""
	Process.RunTool("curl", "-sfL " + header + "\"" + url + "\"").Output.Split("\n")
Linked(lines Texts) Texts
	Repositories.Linked(Readme) is ("strict-lang/Strict", "b/c")
	Repositories.Linked(("github.com/a/b", "docs/c/d", "github.com/a/b")) is ("a/b")
	mutable repositories = List(Mutable(Text))
	for lines
		let start = value.IndexOf("github.com/")
		if start >= 0
			let repository = Repository(value.Substring(start + 11, value.Length - start - 11))
			if (repository is not "") and (repository is not in repositories)
				repositories.Add(repository)
	repositories
Repository(link Text) Text
	Repositories.Repository("strict-lang/Strict.") is "strict-lang/Strict"
	Repositories.Repository("b/c.git) and more") is "b/c"
	let slash = link.IndexOf("/")
	if slash <= 0
		return ""
	mutable end = slash + 1
	for Range(slash + 1, link.Length)
		if (end is value) and (link.Substring(value, 1) is not in Delimiters)
			end = value + 1
	let repository = link.Substring(0, end).Replace(".git", "")
	let last = repository.Length - 1
	repository.Substring(last, 1) is "." then repository.Substring(0, last) else repository
Quoted(lines Texts, key Text) Texts
	Repositories.Quoted(Listing, "path") is ("Math/Vector2.strict", "Math/Size.strict", "Math/README.md", "Vector2.strict")
	Repositories.Quoted(Listed, "full_name") is ("strict-lang/Strict", "strict-lang/sdk")
	for lines
		let start = value.IndexOf("\"" + key + "\": \"")
		if start >= 0
			value.Substring(start + key.Length + 5, value.LastIndexOf("\"") - start - key.Length - 5)
Folder(paths Texts, type Text) Text
	Repositories.Folder(Repositories.Quoted(Listing, "path"), "Vector2") is "Math"
	Repositories.Folder(List(Text) + "Vector2.strict", "Vector2s") is "."
	Repositories.Folder(List(Text) + "Math/Size.strict", "Vector2") is ""
	let singular = type.Substring(type.Length - 1, 1) is "s" then type.Substring(0, type.Length - 1) else type
	for paths
		let file = Path(value).FileName.text
		if file is in (type + ".strict", singular + ".strict")
			return value.IndexOf("/") < 0 then "." else value.Substring(0, value.LastIndexOf("/"))
	""
Files(paths Texts, folder Text) Texts
	Repositories.Files(Repositories.Quoted(Listing, "path"), "Math") is ("Math/Vector2.strict", "Math/Size.strict")
	Repositories.Files(Repositories.Quoted(Listing, "path"), ".").Last is "Vector2.strict"
	Repositories.Files(Nested, "Math") is ("Math/Vector2.strict", "Math/Shapes/Circle.strict")
	Repositories.Files(("Pack/A.strict", "Pack/native/A.c", "Pack/B.txt"), "Pack") is ("Pack/A.strict", "Pack/native/A.c")
	let prefix = folder is "." then "" else folder + "/"
	for paths
		if value.StartsWith(prefix) and (value.EndsWith(".strict") or (value.IndexOf("/native/") > 0))
			value
Relative(path Text, folder Text) Text
	Repositories.Relative("Math/Shapes/Circle.strict", "Math") is "Shapes/Circle.strict"
	Repositories.Relative("Vector2.strict", ".") is "Vector2.strict"
	folder is "." then path else path.Substring(folder.Length + 1, path.Length - folder.Length - 1)
Provided(local Text, type Text) Text
	Repositories.Provided("./Math", "Vector2") is "./Math"
	Repositories.Provided("./Math", "Missing") is ""
	for BinaryFile(local).Contained(local)
		if value.Replace("\\", "/").EndsWith("/" + type + ".strict")
			return local
	""
Updated(folder Text) Number
	Repositories.Updated("./Math") is 0
	mutable updated = 0
	for Directory.Directories(folder)
		let files = Directory.Files(value, "*.strict")
		if File(value + "/.origin").Exists and (files.Length > 0)
			let type = Path(files.First.Replace("\\", "/")).FileName.text
			if Repositories(logger, folder).Downloaded(type.Substring(0, type.Length - 7)) is not ""
				updated = updated + 1
	updated