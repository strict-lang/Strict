has root Text
constant Imaging = List(Text) + "./Compression/Deflate.strict"
constant Plain = SourceFiles(".")
constant Compressed = Directory.Files("./Compression", "*.strict")
Of(path Text, others Texts = List(Text)) Texts slow
	SourceFiles(".").Of("./Missing/A.strict").Length is Directory.Files(".", "*.strict").Length
	"./Math/Size.strict" is in SourceFiles(".").Of("./Math/Vector2.strict", List(Text) + "Math/Size.strict")
	"./Xml/Xml.strict" is in SourceFiles(".").Of("./Xml")
	mutable start = List(Mutable(Text))
	for Added(List(Text) + path, others + Folder(path))
		if File(value).Exists
			start = Added(start, List(Text) + FileCompiler.Normalized(value))
	let base = Directory.Files(root, "*.strict")
	let reached = Reached(Added(Indexed(start), base), start, base)
	TypeChoice(File(path).Exists then File(path).ReadLines else List(Text)).Chosen(reached, path)
Folder(path Text) Texts
	Plain.Folder("./Math").Length > 10
	Plain.Folder("./Math/Vector2.strict").Length is 0
	if Directory.Exists(path) is false
		return List(Text)
	mutable files = List(Text)
	for ResolveCheck.Tree(path)
		files = files + Directory.Files(value, "*.strict")
	files
Indexed(paths Texts) Texts
	"./Math/Size.strict" is in SourceFiles(".").Indexed(List(Text) + "./Math/Vector2.strict")
	let project = File("./Any.strict").Exists then List(Text) else ResolveCheck.Tree(".")
	mutable local = List(Mutable(Text))
	for paths
		local = Added(local, List(Text) + Path(value).PathOnly.text)
	mutable files = List(Mutable(Text))
	for project.Length > 0 then Added(project, local) else Folders(local, 3)
		files = files + Directory.Files(value, "*.strict")
	files
Reached(known Texts, frontier Texts, reached Texts, searched = List(Text)) Texts slow
	"./Compression/Inflate.strict" is in Plain.Reached(Compressed, Imaging, List(Text))
	if frontier.Length is 0
		return reached
	mutable mentioned = List(Mutable(Text))
	for frontier
		mentioned = Added(mentioned, Mentioned(value))
	let unmatched = Mentions.Unmatched(mentioned, known) - searched
	let indexed = Added(known, Nearby(unmatched))
	let all = Added(reached, frontier)
	Reached(indexed, Matching(mentioned, indexed) - all, all, searched + unmatched)
Matching(names Texts, files Texts) Texts
	SourceFiles(".").Reached(Imaging, List(Text), Imaging) is Imaging
	SourceFiles(".").Matching(("Vector2s", "Missing"), Imaging + "./Math/Vector2.strict") is ("./Math/Vector2.strict")
	mutable wanted = Dictionary(Text, Boolean)
	for names
		wanted(value) = true
	for files
		let slashed = value.IndexOf("\\") >= 0 then value.Replace("\\", "/") else value
		let slash = slashed.LastIndexOf("/")
		let end = slashed.EndsWith(".strict") then slashed.Length - 7 else slashed.Length
		let name = slash < 0 then slashed.Substring(0, end) else slashed.Substring(slash + 1, end - slash - 1)
		if (name is in wanted) or ((name + "s") is in wanted)
			value
Folders(folders Texts, depth Number, scanned = 0) Texts
	SourceFiles(".").Folders(List(Text) + "./Missing", 2).Length is 1
	mutable result = folders
	for Range(scanned, folders.Length)
		result = Added(result, Referenced(folders(value)))
	(depth is 0) or (result.Length is folders.Length) then result else Folders(result, depth - 1, folders.Length)
Added(folders Texts, more Texts) Texts
	SourceFiles(".").Added(("a", "b"), ("b", "c")) is ("a", "b", "c")
	if more.Length is 0
		return folders
	mutable seen = Dictionary(Text, Boolean)
	for folders
		seen(value) = true
	mutable added = List(Mutable(Text))
	for more
		if value is not in seen
			seen(value) = true
			added.Add(value)
	added.Length is 0 then folders else folders + added
Referenced(folder Text) Texts
	SourceFiles(".").Referenced("./Missing").Length is 0
	mutable result = List(Mutable(Text))
	for Directory.Files(folder, "*.strict")
		result = Added(result, Packages(value))
	result
Packages(file Text) Texts
	SourceFiles(".").Packages("./Bytecode/SourceFiles.strict") is List(Text)
	constant kind = "packages"
	if Memo.Has(file, kind)
		let cached = Memo.Texts(file, kind)
		return cached.First is "-" then List(Text) else cached
	let found = PackagesIn(File(file).ReadLines)
	let stored = Memo.Kept(file, kind, found.Length is 0 then List(Text) + "-" else found)
	found.Length is 0 then List(Text) else stored
Mentioned(file Text) Texts
	"Number" is in SourceFiles(".").Mentioned("./Math/Vector2.strict")
	constant kind = "mentions"
	Memo.Has(file, kind) then Memo.Texts(file, kind) else Memo.Kept(file, kind, Mentions(File(file).ReadLines).Types)
PackagesIn(lines Texts) Texts
	SourceFiles(".").PackagesIn("has a Bytecode/X", "Run") is List(Text) + "./Bytecode"
	mutable result = List(Mutable(Text))
	for lines
		if value.IndexOf("/") >= 0
			if (value.Trim.StartsWith("//") is false) and (value.Replace(" / ", "").IndexOf("/") >= 0)
				result = Added(result, PackageNames(Tokenizer(value).Tokens))
	result
PackageNames(tokens Texts) Texts
	SourceFiles(".").PackageNames("Bytecode", "/", "X", "Strict", "/", "Y") is List(Text) + "./Bytecode"
	for tokens
		if index + 1 < tokens.Length
			if tokens(index + 1) is "/"
				let package = Package(value)
				if package is not ""
					package
Package(name Text) Text
	SourceFiles(".").Package("Bytecode") is "./Bytecode"
	SourceFiles(".").Package("Strict") is ""
	SourceFiles("C:/Missing").Package("Missing") is ""
	if (name is "Strict") or Directory.Exists("./" + name)
		return name is "Strict" then "" else "./" + name
	Directory.Exists(root + "/" + name) then root + "/" + name else ""
Nearby(types Texts) Texts
	SourceFiles(".").Nearby(List(Text) + "Vector2").Length is Directory.Files("./Math", "*.strict").Length
	let local = MatchedFolders(FolderIndex(List(Text) + root), types)
	mutable parents = List(Text) + root
	if local.Length < types.Length
		for Directory.Directories("..")
			let project = Path(value.Replace("\\", "/")).FileName.text
			if (project(0) is project(0).Upper) and (project(0) is not project(0).Lower)
				parents = parents + ("../" + project)
	mutable files = List(Mutable(Text))
	for parents.Length is 1 then local else MatchedFolders(FolderIndex(parents), types)
		files = Added(files, Directory.Files(value, "*.strict"))
	files
FolderIndex(parents Texts) Dictionary(Text, Text)
	"Vector2" is in Plain.FolderIndex(List(Text) + ".")
	mutable map = Dictionary(Text, Text)
	for parents
		let parent = value
		for Directory.Directories(parent)
			let folder = parent + "/" + Path(value.Replace("\\", "/")).FileName.text
			for Directory.Files(folder, "*.strict")
				let name = Path(value.Replace("\\", "/")).FileName.RemoveExtension.text
				if name is not in map
					map(name) = folder
	map
MatchedFolders(indexed Dictionary(Text, Text), types Texts) Texts
	Plain.MatchedFolders(Dictionary(("Vector2", "./Math")), List(Text) + "Vector2s") is ("./Math")
	mutable matched = List(Mutable(Text))
	for types
		mutable name = value
		for as long as name.EndsWith("s") and (name is not in indexed)
			name = name.Substring(0, name.Length - 1)
		if name is in indexed
			matched = Added(matched, List(Text) + indexed(name))
	matched
PackageWith(type Text, projects Text) Text
	SourceFiles("C:/Missing").PackageWith("Adder", ".") is "./Examples/NativeAdd"
	for Directory.Directories(projects)
		let project = Path(value.Replace("\\", "/")).FileName.text
		let first = project(0)
		let sub = (first is first.Upper) and (first is not first.Lower) then projects + "/" + project else ""
		let folder = sub is "" then "" else SubfolderWith(sub, type)
		if folder is not ""
			return folder
	""
SubfolderWith(parent Text, type Text) Text
	SourceFiles(".").SubfolderWith(".", "Vector2") is "./Math"
	SourceFiles(".").SubfolderWith(".", "Vector2s") is "./Math"
	for Directory.Directories(parent)
		let folder = parent + "/" + Path(value.Replace("\\", "/")).FileName.text
		if File(folder + "/" + type + ".strict").Exists
			return folder
	type.EndsWith("s") then SubfolderWith(parent, type.Substring(0, type.Length - 1)) else ""
