has root Text
constant Imaging = List(Text) + "./ImageProcessing/Png.strict"
constant Typo = ("constant Limit = 3", "has numbr", "has counts Numbers", "Add(other Number, most = Limit) Other", "	other")
Of(path Text) Slow(Texts)
	SourceFiles(".").Of("./Missing/A.strict").Length is Directory.Files(".", "*.strict").Length
	mutable files = List(Mutable(Text))
	let project = File("./Any.strict").Exists then List(Text) else ResolveCheck.Tree(".")
	for Folders(Added(project, List(Text) + Path(path).PathOnly.text), 3)
		files = files + Directory.Files(value, "*.strict")
	let local = Directory.Files(Path(path).PathOnly.text, "*.strict")
	let closed = Closed(Added(files, Directory.Files(root, "*.strict")), Added(Added(local, List(Text) + path), files), 9)
	let lines = File(path).Exists then File(path).ReadLines else List(Text)
	TypeChoice(lines).Chosen(closed, path)
Closed(found Texts, sources Texts, depth Number) Slow(Texts)
	Directory.Files("./Compression", "*.strict").First is in SourceFiles(".").Closed(List(Text), Imaging, 0)
	mutable missing = List(Mutable(Text))
	for sources
		missing = Added(missing, Missing(File(value).ReadLines, found))
	let nearby = Nearby(missing)
	let added = Added(found, nearby)
	(depth is 0) or (added.Length is found.Length) then added else Closed(added, nearby, depth - 1)
Folders(folders Texts, depth Number) Texts
	SourceFiles(".").Folders(List(Text) + "./Missing", 2).Length is 1
	mutable result = folders
	for folders
		result = Added(result, Referenced(value))
	(depth is 0) or (result.Length is folders.Length) then result else Folders(result, depth - 1)
Added(folders Texts, more Texts) Texts
	SourceFiles(".").Added(("a", "b"), ("b", "c")) is ("a", "b", "c")
	mutable result = folders
	for more
		if value is not in result
			result = result + value
	result
Referenced(folder Text) Texts
	SourceFiles(".").Referenced("./Missing").Length is 0
	mutable result = List(Mutable(Text))
	for Directory.Files(folder, "*.strict")
		result = Added(result, PackagesIn(File(value).ReadLines))
	result
PackagesIn(lines Texts) Texts
	SourceFiles(".").PackagesIn("has a Bytecode/X", "Run") is List(Text) + "./Bytecode"
	mutable result = List(Mutable(Text))
	for lines
		if value.IndexOf("/") >= 0
			result = Added(result, PackageNames(Tokenizer(value).Tokens))
	result
PackageNames(tokens Texts) Texts
	SourceFiles(".").PackageNames("Bytecode", "/", "X", "Strict", "/", "Y") is List(Text) + "./Bytecode"
	for tokens
		if index + 1 < tokens.Length and (tokens(index + 1) is "/") and (Package(value) is not "")
			Package(value)
Package(name Text) Text
	SourceFiles(".").Package("Bytecode") is "./Bytecode"
	SourceFiles(".").Package("Strict") is ""
	SourceFiles("C:/Missing").Package("Missing") is ""
	if (name is "Strict") or Directory.Exists("./" + name)
		return name is "Strict" then "" else "./" + name
	Directory.Exists(root + "/" + name) then root + "/" + name else ""
Missing(lines Texts, files Texts) Texts
	SourceFiles(".").Missing(Typo, Directory.Files(".", "*.strict")) is ("Numbr")
	SourceFiles(".").Missing(("Run", "\tVectr2(1, 2)"), Directory.Files(".", "*.strict")) is ("Vectr2")
	mutable known = List(Mutable(Text)) + "None" + "Other"
	for files
		known.Add(Path(value.Replace("\\", "/")).FileName.RemoveExtension.text)
	for lines
		if value.StartsWith("constant ")
			let tokens = Tokenizer(value).Tokens
			known.Add(tokens(1))
	for Declared(TypeShape(lines)) + TypeShape(lines).UsedTypes
		if IsKnown(value, known) is false
			value
IsKnown(name Text, known Texts) Boolean
	SourceFiles(".").IsKnown("Numbers", List(Text) + "Number")
	SourceFiles(".").IsKnown("Numbr", List(Text) + "Number") is false
	SourceFiles(".").IsKnown("Numberss", List(Text) + "Number")
	if name is in known
		return true
	(name.Substring(name.Length - 1, 1) is "s") and IsKnown(name.Substring(0, name.Length - 1), known)
Declared(shape Expressions/TypeShape) Texts
	SourceFiles(".").Declared(TypeShape(Typo)) is ("Numbr", "Numbers", "Other", "Number", "Limit")
	let calls = shape.CallScope(List(Text))
	mutable types = shape.MemberScope.types + Returned(shape)
	for calls.names
		if value.LastIndexOf(" types") > 0
			types = types + calls.types(index).Split(",")
	mutable result = List(Mutable(Text))
	for types
		let name = value.IndexOf("(") > 0 then value.Substring(0, value.IndexOf("(")) else value
		if (name is not "") and (name.IndexOf(")") < 0) and (name.IndexOf(" ") < 0) and (name is not in result)
			result.Add(name)
	result
Returned(shape Expressions/TypeShape) Texts
	SourceFiles(".").Returned(TypeShape(("constant Pair = (1, 2)", "Add(other) Number", "	other"))) is ("Number")
	for shape.lines
		if shape.IsMethodHeader(value) and (shape.IsComputed(value) is false)
			HeaderTokens(Tokenizer(value).Tokens).ReturnType
Nearby(types Texts) Texts
	SourceFiles(".").Nearby(List(Text) + "Vector2").Length is Directory.Files("./Math", "*.strict").Length
	mutable files = List(Mutable(Text))
	for types
		let local = SubfolderWith(root, value)
		let folder = local is "" then PackageWith(value, "..") else local
		if folder is not ""
			files = Added(files, Directory.Files(folder, "*.strict"))
	files
PackageWith(type Text, projects Text) Text
	SourceFiles("C:/Missing").PackageWith("Adder", ".") is "./Examples/NativeAdd"
	for Directory.Directories(projects)
		let project = Path(value.Replace("\\", "/")).FileName.text
		let first = project.Substring(0, 1)
		let isPackage = (first is first.Upper) and (first is not first.Lower)
		let folder = isPackage then SubfolderWith(projects + "/" + project, type) else ""
		if folder is not ""
			return folder
	""
SubfolderWith(parent Text, type Text) Text
	SourceFiles(".").SubfolderWith(".", "Vector2") is "./Math"
	for Directory.Directories(parent)
		let folder = parent + "/" + Path(value.Replace("\\", "/")).FileName.text
		if File(folder + "/" + type + ".strict").Exists
			return folder
	""