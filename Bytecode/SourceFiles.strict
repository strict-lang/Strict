has root Text
Of(path Text) Texts
	SourceFiles(".").Of("./Missing/A.strict").Length is Directory.Files(".", "*.strict").Length
	mutable files = List(Mutable(Text))
	let project = File("./Any.strict").Exists then List(Text) else Tree(".")
	for Folders(Added(project, List(Text) + Path(path).PathOnly.text), 3)
		files = files + Directory.Files(value, "*.strict")
	Added(files, Directory.Files(root, "*.strict"))
Folders(folders Texts, depth Number) Texts
	SourceFiles(".").Folders(List(Text) + "./Missing", 2).Length is 1
	mutable result = folders
	for folders
		result = Added(result, Referenced(value))
	(depth is 0) or (result.Length is folders.Length) then result else Folders(result, depth - 1)
Added(folders Texts, more Texts) Texts
	SourceFiles(".").Added(("a", "b"), ("b", "c")) is ("a", "b", "c")
	mutable result = folders
	for more
		if value is not in result
			result = result + value
	result
Referenced(folder Text) Texts
	SourceFiles(".").Referenced("./Missing").Length is 0
	mutable result = List(Mutable(Text))
	for Directory.Files(folder, "*.strict")
		result = Added(result, PackagesIn(File(value).ReadLines))
	result
PackagesIn(lines Texts) Texts
	SourceFiles(".").PackagesIn("has a Bytecode/X", "Run") is List(Text) + "./Bytecode"
	mutable result = List(Mutable(Text))
	for lines
		result = Added(result, PackageNames(Tokenizer(value).Tokens))
	result
PackageNames(tokens Texts) Texts
	SourceFiles(".").PackageNames("Bytecode", "/", "X", "Strict", "/", "Y") is List(Text) + "./Bytecode"
	for tokens
		if index + 1 < tokens.Length and (tokens(index + 1) is "/") and (Package(value) is not "")
			Package(value)
Package(name Text) Text
	SourceFiles(".").Package("Bytecode") is "./Bytecode"
	SourceFiles(".").Package("Strict") is ""
	SourceFiles("C:/Missing").Package("Missing") is ""
	if (name is "Strict") or Directory.Exists("./" + name)
		return name is "Strict" then "" else "./" + name
	Directory.Exists(root + "/" + name) then root + "/" + name else ""
Tree(folder Text) Texts
	SourceFiles(".").Tree("./Math") is List(Text) + "./Math"
	mutable folders = List(Mutable(Text)) + folder
	for Directory.Directories(folder)
		let name = Path(value.Replace("\\", "/")).FileName.text
		let first = name.Substring(0, 1)
		if (first is first.Upper) and (first is not first.Lower)
			folders = folders + Tree(folder + "/" + name)
	folders