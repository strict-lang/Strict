has root Text
constant Imaging = List(Text) + "./ImageProcessing/Png.strict"
constant Plain = SourceFiles(".")
constant Compressed = Directory.Files("./Compression", "*.strict")
Of(path Text, others Texts = List(Text)) Slow(Texts)
	SourceFiles(".").Of("./Missing/A.strict").Length is Directory.Files(".", "*.strict").Length
	"./Math/Size.strict" is in SourceFiles(".").Of("./Math/Vector2.strict", List(Text) + "Math/Size.strict")
	mutable start = List(Mutable(Text))
	for Added(List(Text) + path, others)
		if File(value).Exists
			start = Added(start, List(Text) + FileCompiler.Normalized(value))
	let base = Directory.Files(root, "*.strict")
	let reached = Reached(Added(Indexed(start), base), start, base)
	let lines = File(path).Exists then File(path).ReadLines else List(Text)
	TypeChoice(lines).Chosen(reached, path)
Indexed(paths Texts) Texts
	"./Math/Size.strict" is in SourceFiles(".").Indexed(List(Text) + "./Math/Vector2.strict")
	let project = File("./Any.strict").Exists then List(Text) else ResolveCheck.Tree(".")
	mutable local = List(Mutable(Text))
	for paths
		local = Added(local, List(Text) + Path(value).PathOnly.text)
	mutable files = List(Mutable(Text))
	for project.Length > 0 then Added(project, local) else Folders(local, 3)
		files = files + Directory.Files(value, "*.strict")
	files
Reached(known Texts, frontier Texts, reached Texts) Slow(Texts)
	"./Compression/Inflate.strict" is in Plain.Reached(Compressed, Imaging, List(Text))
	mutable all = reached
	mutable pending = frontier
	mutable indexed = known
	for as long as pending.Length > 0
		all = Added(all, pending)
		mutable mentioned = List(Mutable(Text))
		for pending
			mentioned = Added(mentioned, Mentions(File(value).ReadLines).Types)
		indexed = Added(indexed, Nearby(Mentions.Unmatched(mentioned, indexed)))
		pending = Matching(mentioned, indexed) - all
	all
Matching(names Texts, files Texts) Texts
	SourceFiles(".").Reached(Imaging, List(Text), Imaging) is Imaging
	SourceFiles(".").Matching(("Vector2s", "Missing"), Imaging + "./Math/Vector2.strict") is ("./Math/Vector2.strict")
	for files
		let name = Path(value.Replace("\\", "/")).FileName.RemoveExtension.text
		if (name is in names) or ((name + "s") is in names)
			value
Folders(folders Texts, depth Number) Texts
	SourceFiles(".").Folders(List(Text) + "./Missing", 2).Length is 1
	mutable result = folders
	for folders
		result = Added(result, Referenced(value))
	(depth is 0) or (result.Length is folders.Length) then result else Folders(result, depth - 1)
Added(folders Texts, more Texts) Texts
	SourceFiles(".").Added(("a", "b"), ("b", "c")) is ("a", "b", "c")
	mutable result = folders
	for more
		if value is not in result
			result = result + value
	result
Referenced(folder Text) Texts
	SourceFiles(".").Referenced("./Missing").Length is 0
	mutable result = List(Mutable(Text))
	for Directory.Files(folder, "*.strict")
		result = Added(result, PackagesIn(File(value).ReadLines))
	result
PackagesIn(lines Texts) Texts
	SourceFiles(".").PackagesIn("has a Bytecode/X", "Run") is List(Text) + "./Bytecode"
	mutable result = List(Mutable(Text))
	for lines
		if value.IndexOf("/") >= 0
			result = Added(result, PackageNames(Tokenizer(value).Tokens))
	result
PackageNames(tokens Texts) Texts
	SourceFiles(".").PackageNames("Bytecode", "/", "X", "Strict", "/", "Y") is List(Text) + "./Bytecode"
	for tokens
		if index + 1 < tokens.Length and (tokens(index + 1) is "/") and (Package(value) is not "")
			Package(value)
Package(name Text) Text
	SourceFiles(".").Package("Bytecode") is "./Bytecode"
	SourceFiles(".").Package("Strict") is ""
	SourceFiles("C:/Missing").Package("Missing") is ""
	if (name is "Strict") or Directory.Exists("./" + name)
		return name is "Strict" then "" else "./" + name
	Directory.Exists(root + "/" + name) then root + "/" + name else ""
Nearby(types Texts) Texts
	SourceFiles(".").Nearby(List(Text) + "Vector2").Length is Directory.Files("./Math", "*.strict").Length
	mutable files = List(Mutable(Text))
	for types
		let local = SubfolderWith(root, value)
		let folder = local is "" then PackageWith(value, "..") else local
		if folder is not ""
			files = Added(files, Directory.Files(folder, "*.strict"))
	files
PackageWith(type Text, projects Text) Text
	SourceFiles("C:/Missing").PackageWith("Adder", ".") is "./Examples/NativeAdd"
	for Directory.Directories(projects)
		let project = Path(value.Replace("\\", "/")).FileName.text
		let first = project.Substring(0, 1)
		let isPackage = (first is first.Upper) and (first is not first.Lower)
		let folder = isPackage then SubfolderWith(projects + "/" + project, type) else ""
		if folder is not ""
			return folder
	""
SubfolderWith(parent Text, type Text) Text
	SourceFiles(".").SubfolderWith(".", "Vector2") is "./Math"
	SourceFiles(".").SubfolderWith(".", "Vector2s") is "./Math"
	for Directory.Directories(parent)
		let folder = parent + "/" + Path(value.Replace("\\", "/")).FileName.text
		if File(folder + "/" + type + ".strict").Exists
			return folder
	type.EndsWith("s") then SubfolderWith(parent, type.Substring(0, type.Length - 1)) else ""
