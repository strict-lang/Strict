has types List(TypeEntry) = List(TypeEntry)
constant Real = MemberEntry("real", "Strict/Number", List(InstructionEntry), false)
constant Imaginary = MemberEntry("imaginary", "Strict/Number", List(InstructionEntry), false)
constant Made = InstructionEntry.Invoke(12, ("Strict/Pair", "from", "Pair", "real", "imaginary"), (6, 11), -1)
constant SquareLoads = (InstructionEntry.Named(InstructionType.LoadVariableToRegister, 0, "real"), InstructionEntry.Binary(InstructionType.Multiply, (0, 0, 2)), InstructionEntry.Named(InstructionType.LoadVariableToRegister, 3, "imaginary"))
constant SquaredDifference = SquareLoads + (InstructionEntry.Binary(InstructionType.Multiply, (3, 3, 5)), InstructionEntry.Binary(InstructionType.Subtract, (2, 5, 6)), InstructionEntry.LoadNumber(7, 2))
constant SquaredProduct = SquaredDifference + (InstructionEntry.Binary(InstructionType.Multiply, (7, 0, 9)), InstructionEntry.Binary(InstructionType.Multiply, (9, 3, 11)))
constant Squared = MethodEntry("Squared", List(MemberEntry), "Strict/Pair", SquaredProduct + (Made, InstructionEntry(InstructionType.CheckError, List(Text), List(Number) + 12), InstructionEntry.Return(12)))
constant Pair = TypeEntry("Strict/Pair", (Real, Imaginary), List(MethodEntry) + Squared)
constant Constructed = InstructionEntry.Invoke(2, ("Strict/Pair", "from", "Pair", "real", "imaginary"), (0, 1), -1)
constant ConstructedPair = (InstructionEntry.LoadNumber(0, 3), InstructionEntry.LoadNumber(1, 2), Constructed, InstructionEntry(InstructionType.CheckError, List(Text), List(Number) + 2))
constant SquaredReal = (InstructionEntry(InstructionType.CheckError, List(Text), List(Number) + 3), InstructionEntry(InstructionType.FieldLoad, ("real", "Pair"), (4, 3, -1, -2)), InstructionEntry.Return(4))
constant Calling = ConstructedPair + InstructionEntry.Invoke(3, ("Strict/Pair", "Squared", "Strict/Pair"), List(Number), 2) + SquaredReal
constant Caller = TypeEntry("Strict/Caller", List(MemberEntry), List(MethodEntry) + MethodEntry("Run", List(MemberEntry), "Strict/Number", Calling))
constant Sample = StructLanes((Caller, Pair))
constant Halves = TypeEntry("Strict/Halves", (Real, MemberEntry("half", "Strict/Number", List(InstructionEntry), false, 32)), List(MethodEntry))
constant Custom = TypeEntry("Strict/Custom", (Real, Imaginary), List(MethodEntry) + MethodEntry("from", List(MemberEntry), "Strict/Custom", List(InstructionEntry)))
constant Labeled = TypeEntry("Strict/Named", (MemberEntry("name", "Strict/Text", List(InstructionEntry), false), Real), List(MethodEntry))
constant Kept = TypeEntry("Strict/Kept", (Real, MemberEntry("Zero", "Strict/Kept", List(InstructionEntry), true)), List(MethodEntry))
constant Splitting = StructLanes(Inliner((Caller, Pair), true).Inlined)
constant Width = MemberEntry("Width", "Strict/Number", List(InstructionEntry), false, 32)
constant Height = MemberEntry("Height", "Strict/Number", List(InstructionEntry), false, 32)
constant Iterated = MemberEntry("iterator", "Strict/Iterator", List(InstructionEntry), false)
constant Validating = MethodEntry("Validated", List(MemberEntry), "Strict/Size", List(InstructionEntry))
constant Widths = (0, Number.SingleBits, Number.DoubleBits)
constant DataLess = List(Text) + "Strict/Iterator"
constant ConstantKinds = (InstructionType.Set, InstructionType.LoadConstantToRegister)
constant Sized = TypeEntry("Strict/Size", (Width, Height, Iterated), List(MethodEntry) + Validating)
Members(type TypeEntry) Texts
	StructLanes.Members(Pair) is ("real", "imaginary")
	StructLanes.Members(Caller).Length is 0
	StructLanes.Members(Kept).Length is 0
	StructLanes.Members(Halves).Length is 0 and StructLanes.Members(Custom).Length is 0
	StructLanes.Members(Sized) is ("Width", "Height")
	if type.Name is "" or type.members.Length is 0 or LaneNesting.IsPlainType(type.Name)
		return List(Text)
	for type.methods
		if value.Name is "from"
			return List(Text)
	fields = Fields(type)
	fields.Length < 2 or fields.Length > 4 or "" is in fields then List(Text) else fields
Fields(type TypeEntry) Texts
	StructLanes.Fields(Pair) is ("real", "imaginary")
	StructLanes.Fields(Kept) is ("real")
	StructLanes.Fields(Labeled) is ("")
	StructLanes.Members(TypeEntry("Strict/Five", (Real, Real, Real, Real, Real), List(MethodEntry))).Length is 0
	bits = LaneCalls(types).LeafBits(type)
	mutable names = List(Text)
	for type.members
		if names.Length > 4 or "" is in names
			return names
		if value.IsConstant is false and value.typeName is not in DataLess
			sub = LaneNesting(types).SubFields(value, bits, type.Name)
			names = sub.Length is 0 then names + "" else names + sub
	names
IsLane(member MemberEntry) Boolean
	StructLanes.IsLane(Real)
	StructLanes.IsLane(MemberEntry("half", "Strict/Number", List(InstructionEntry), false, 32))
	StructLanes.IsLane(MemberEntry("named", "Strict/Text", List(InstructionEntry), false)) is false
	StructLanes.IsLane(MemberEntry("real", "Strict/Number", InstructionEntry.Return(0), false)) is false
	isConstant = member.initial.Length is 1 and member.initial.First.kind is in ConstantKinds
	member.typeName is "Strict/Number" and member.Bits is in Widths and (member.initial.Length is 0 or isConstant)
Split List(TypeEntry)
	Sample.Split.First.methods.First.instructions.Length is 11
	Splitting.Split.First.methods.First.instructions.Length is 20
	Splitting.Split.First.methods.First.instructions(18).texts is ("lanes3_real")
	skips = LaneSkips(LaneSkips(types), isChecked = Process.Variable("STRICT_LANES_CHECK") is "1")
	for types
		members = Members(value).Length > 0 then value.members else LaneCalls(types).Divide(value.members)
		TypeEntry(value.Name, members, Methods(value, skips))
Methods(type TypeEntry, skips LaneSkips) List(MethodEntry)
	Sample.Methods(Caller, LaneSkips(Sample.types)).First.instructions(2).texts is ("lanes2_real")
	nesting = LaneNesting(types)
	for type.methods
		isSkipped = skips.IsUntouched(type, value)
		rewritten = isSkipped then Unlane(value) else Rewritten(type, value, skips)
		skips.Check(type, rewritten, skips.isChecked then Rewritten(type, value, LaneSkips.None) else rewritten)
		split = isSkipped then false else Members(type).Length is 0 and nesting.Fix(value).Length > 0
		parameters = split then LaneCalls(types).Divide(value.parameters) else value.parameters
		MethodEntry(value.Name, parameters, value.declaredType, rewritten.instructions, value.Slots)
Unlane(method MethodEntry) MethodEntry
	Sample.Unlane(MethodEntry.CountingLoop) is MethodEntry.CountingLoop
	MethodEntry(method, instructions = Inliner(types).Loop(method.instructions))
Rewritten(type TypeEntry, method MethodEntry, skips LaneSkips) MethodEntry
	Sample.Rewritten(Caller, MethodEntry.CountingLoop, LaneSkips(Sample.types)) is MethodEntry.CountingLoop
	calls = LaneCalls(types)
	fixed = Members(type).Length > 0 then List(Text) else LaneNesting(types).Fix(method) + calls.Lane(type.members)
	flow = LaneFlow(types, LaneFlow(types).Lists(type, method), fixed, skips)
	variables = flow.Variables(method.instructions, List(Text), 4) + fixed
	base = LoadReuse(method.instructions).RegisterCount
	mutable laned = List(Text)
	mutable result = List(InstructionEntry)
	for method.instructions
		plain = skips.IsPlainCall(value) then Materialize(value, laned, base) + value else List(InstructionEntry)
		result = result + (plain.Length > 0 then plain else Replace(value, flow, laned, variables, base))
		laned = flow.Track(value, laned, variables)
	MethodEntry(method.Name, method.parameters, method.declaredType, Inliner(types).Loop(result), method.Slots)
Replace(entry InstructionEntry, flow LaneFlow, laned Texts, variables Texts, base Number) List(InstructionEntry)
	Sample.Replace(Calling(3), LaneFlow.Sample, "2 Strict/Pair", List(Text), 8).Length is 0
	Sample.Replace(Calling(4), LaneFlow.Sample, "2 Strict/Pair", List(Text), 8).Last is Calling(4)
	Sample.Replace(Calling(6), LaneFlow.Sample, "3 Pair", List(Text), 8).First.texts is ("lanes3_real")
	if entry.kind is InstructionType.FieldLoad and flow.FindType(laned, entry.payload(1) to Text) is not ""
		return Forward(entry, base)
	produced = flow.Produce(entry, List(Text))
	if produced is not ""
		isCall = entry.kind is InstructionType.Invoke
		return isCall then Build(entry, laned, base) else LaneCalls(types).Spread(entry, produced, base)
	isMoved = entry.kind is in (InstructionType.LoadVariableToRegister, InstructionType.StoreRegisterToVariable)
	variable = isMoved then flow.FindType(variables, entry.texts(0)) else ""
	variable is "" then Other(entry, flow, laned, base) else Copy(entry, variable, base)
Other(entry InstructionEntry, flow LaneFlow, laned Texts, base Number) List(InstructionEntry)
	Sample.Other(Calling(6), LaneFlow.Sample, "3 Pair", 8).First.texts is ("lanes3_real")
	StructLanes(LaneCalls.Sample.types).Other(LaneCalls.Shift, LaneFlow.Sample, "4 Pair", 9).Length is 3
	Sample.Other(Calling(4), LaneFlow.Sample, "2 Pair", 8).Last is Calling(4)
	source = entry.kind is InstructionType.FieldLoad then 1 else 0
	laneType = entry.payload.Length > source then flow.FindType(laned, entry.payload(source) to Text) else ""
	if laneType is not "" and entry.kind is in (InstructionType.FieldLoad, InstructionType.CheckError)
		return Forward(entry, base)
	calls = LaneCalls(types)
	signature = calls.Signature(entry)
	signature.Length > 0 then calls.Call(entry, laned, base, signature) else Materialize(entry, laned, base) + entry
Forward(entry InstructionEntry, base = 0) List(InstructionEntry)
	Sample.Forward(Calling(6)).First.texts is ("lanes3_real")
	Sample.Forward(Calling(6)).First.payload is (4, -1)
	Sample.Forward(Calling(3)).Length is 0
	if entry.kind is InstructionType.CheckError
		return List(InstructionEntry)
	subType = LaneNesting.Member(Inliner(types).TypeOf(entry.texts(1)), entry.texts(0)).typeName
	lane = Lane("lanes" + entry.payload(1), entry.texts(0))
	if types.Length > 0 and Members(Inliner(types).TypeOf(subType)).Length > 0
		return Moves(lane, "lanes" + entry.payload(0), subType, base, entry.line)
	List(InstructionEntry) + Label(InstructionType.LoadVariableToRegister, entry.payload(0), lane, entry.line)
Build(entry InstructionEntry, laned = List(Text), base = 0) List(InstructionEntry)
	Sample.Build(Constructed).Last.texts is ("lanes2_imaginary")
	Sample.Build(Constructed).Last.payload is (1, -1)
	LaneNesting(types).Build(entry, laned, base)
Copy(entry InstructionEntry, type Text, base Number) List(InstructionEntry)
	Sample.Copy(LaneFlow.Kept, "Strict/Pair", 8)(1).texts is ("pair_real")
	Sample.Copy(LaneFlow.Reloaded, "Strict/Pair", 8)(1).texts is ("lanes5_real")
	Sample.Copy(LaneFlow.Reloaded, "Strict/Pair", 8)(0).texts is ("pair_real")
	Sample.Copy(LaneFlow.Kept, "Strict/Pair", 8)(0).texts is ("lanes2_real")
	register = "lanes" + entry.payload(0)
	isStored = entry.kind is InstructionType.StoreRegisterToVariable
	Moves(isStored then register else entry.texts(0), isStored then entry.texts(0) else register, type, base, entry.line)
Moves(source Text, target Text, type Text, base Number, line Number) List(InstructionEntry)
	Sample.Moves("a", "b", "Strict/Pair", 8, 0).Length is 4
	Sample.Moves("a", "b", "Strict/Pair", 8, 0)(3).texts is ("b_imaginary")
	mutable lines = List(InstructionEntry)
	for Members(Inliner(types).TypeOf(type))
		loaded = Label(InstructionType.LoadVariableToRegister, base, Lane(source, value), line)
		lines = lines + (loaded, Label(InstructionType.StoreRegisterToVariable, base, Lane(target, value), line))
	lines
Materialize(entry InstructionEntry, laned Texts, base Number) List(InstructionEntry)
	Sample.Materialize(Calling(4), "2 Strict/Pair", 8).Last.payload is (2, -1, -2, 2, -4, -5, -3, 2, 8, 9, 0)
	Sample.Materialize(Calling(7), List(Text), 8).Length is 0
	mutable lines = List(InstructionEntry)
	for LoadReuse(List(InstructionEntry)).Reads(entry)
		type = LaneFlow(types).FindType(laned, value to Text)
		if type is not ""
			lines = lines + Rebuilt(value, type, base + lines.Length, entry.line)
	lines
Rebuilt(register Number, type Text, base Number, line Number) List(InstructionEntry)
	Sample.Rebuilt(2, "Strict/Pair", 8, 0)(1).texts is ("lanes2_imaginary")
	Sample.Rebuilt(2, "Strict/Pair", 8, 0)(1).payload is (9, -1)
	Sample.Rebuilt(2, "Strict/Pair", 8, 0).Last.texts(1) is "from"
	LaneNesting(types).Rebuilt(register, type, base, line)
Label(kind Number, register Number, name Text, line Number) InstructionEntry
	StructLanes.Label(InstructionType.LoadVariableToRegister, 2, "a", 7).line is 7
	InstructionEntry(kind, List(Text) + name, (register, -1), line)
IsLaned(member MemberEntry) Boolean
	StructLanes.IsLaned(LaneCalls.Sample.Divide(LaneCalls.Drawer.members).First)
	StructLanes.IsLaned(Real) is false
	member.Name.IndexOf("_") > 0
Lane(owner Text, member Text) Text
	StructLanes.Lane("lanes2", "real") is "lanes2_real"
	owner + "_" + member
