has types List(TypeEntry)
constant Counted = MemberEntry("number", "Strict/Number", List(InstructionEntry), false)
constant Again = InstructionEntry.Invoke(1, ("Strict/Counting", "Count", "Strict/Number", "number"), List(Number) + 0, -1)
constant Counting = MethodEntry("Count", List(MemberEntry) + Counted, "Strict/Number", (InstructionEntry.Named(InstructionType.LoadVariableToRegister, 0, "number"), Again, InstructionEntry.Return(1)))
constant Counter = TypeEntry("Strict/Counting", List(MemberEntry), List(MethodEntry) + Counting)
constant Kept = InstructionEntry.Named(InstructionType.StoreRegisterToVariable, 1, "conditional0")
constant Branched = (Again, Kept, InstructionEntry(InstructionType.JumpEnd, List(Text), List(Number)), InstructionEntry.Named(InstructionType.LoadVariableToRegister, 2, "conditional0"), InstructionEntry.Return(2))
constant Sample = TailCalls(List(TypeEntry) + Counter)
constant Itself = MethodEntry("Count", List(MemberEntry), "Strict/Number", (InstructionEntry.Invoke(1, ("Strict/Counting", "Count", "Strict/Number"), List(Number), -1), InstructionEntry.Return(1)))
constant Constant = TypeEntry("Strict/Counting", List(MemberEntry) + MemberEntry("Count", "Strict/Number", List(InstructionEntry), true), List(MethodEntry) + Itself)
constant TailId = 1000000
constant Start = InstructionEntry.Jump(InstructionType.JumpEnd, TailId)
constant Restart = InstructionEntry.Jump(InstructionType.JumpToIdIfTrue, TailId)
constant Varied = TypeEntry("Strict/Counting", List(MemberEntry), MethodEntry("Count", Counted, "Strict/Number", Again))
Rewritten List(TypeEntry)
	Sample.Rewritten.First.methods.First.instructions.Length is 7
	Constant.Name is "Strict/Counting" and Constant.members(0).typeName is "Strict/Number"
	Constant.methods.Length is 1 and Itself.Name + Itself.declaredType is "CountStrict/Number"
	Itself.instructions(0).texts is ("Strict/Counting", "Count", "Strict/Number")
	Counting.declaredType is "Strict/Number" and Counting.instructions(0).texts is ("number")
	Sample.Methods(Varied).First.instructions.Length is 1
	Varied.Name + Varied.methods(0).Name + Varied.methods(0).declaredType is "Strict/CountingCountStrict/Number"
	for types
		TypeEntry(value.Name, value.members, Methods(value))
Methods(type TypeEntry) List(MethodEntry)
	Sample.Methods(Counter).First.instructions.First is Start
	Sample.Follow(InstructionEntry.Named(InstructionType.LoadVariableToRegister, 2, "x"), "%v_x") is "%r2"
	Sample.Follow(Kept, "%v_conditional0") is "" and Sample.Follow(Again, "%r1") is ""
	Sample.Follow(InstructionEntry(InstructionType.CheckError, List(Text), 1), "%r1") is "%r1"
	Sample.Follow(InstructionEntry(InstructionType.CheckError, List(Text), 1), "%r2") is ""
	Sample.IsTail(TypeEntry("Strict/Other", List(MemberEntry), Counting), Counting, 1) is false
	Sample.IsTail(TypeEntry("Strict/Counting", List(MemberEntry), List(MethodEntry)), Counting, 1) is false
	for type.methods
		Loop(type, value)
Loop(type TypeEntry, method MethodEntry) MethodEntry
	Sample.Loop(Counter, Counting).instructions.First is Start
	Sample.Loop(Counter, MethodEntry.CountingLoop) is MethodEntry.CountingLoop
	TailCalls(List(TypeEntry) + Constant).Loop(Constant, Itself) is Itself
	mutable instructions = List(Mutable(InstructionEntry))
	for method.instructions
		replaced = IsTail(type, method, index) then Jump(method, value) else List(InstructionEntry) + value
		instructions = instructions + replaced
	if instructions.Length is method.instructions.Length
		return method
	MethodEntry(method.Name, method.parameters, method.declaredType, Start + instructions, method.Slots)
IsTail(type TypeEntry, method MethodEntry, position Number) Boolean
	Sample.IsTail(Counter, Counting, 1)
	Sample.IsTail(Counter, Counting, 0) is false
	call = method.instructions(position)
	if call.kind is not InstructionType.Invoke
		return false
	count = 5 + call.payload(3)
	isOwn = TypeEntry.ShortName(call.texts(0)) is TypeEntry.ShortName(type.Name) and type.ConstantSlot(method) < 0
	isCounted = call.payload(count + 1 + call.payload(count)) is 0
	isSame = isOwn and isCounted and IsLooped(method, position) is false and Inliner(types).Callee(type, call) is method
	isSame and Returns(method.instructions, call.payload(0), position + 1)
IsLooped(method MethodEntry, position Number) Boolean
	Sample.IsLooped(MethodEntry.CountingLoop, 1)
	Sample.IsLooped(Counting, 1) is false
	Sample.IsLooped(MethodEntry.CountingLoop, 2) is false
	Sample.IsLooped(MethodEntry("Run", List(MemberEntry), "None", (InstructionEntry.LoopBegin(0, -1), Kept, Kept)), 2)
	mutable depth = 0
	for Range(0, position)
		kind = method.instructions(value).kind
		depth = depth + (kind is InstructionType.LoopBegin then 1 else kind is InstructionType.LoopEnd then -1 else 0)
	depth > 0
Jump(method MethodEntry, call InstructionEntry) List(InstructionEntry)
	Sample.Jump(Counting, Again).Length is 4
	Sample.Jump(Counting, Again).First.texts is ("number")
	Sample.Jump(Counting, Again).Last is Restart
	Sample.Jump(Counting, Again).First.payload is (0, -1)
	reads = LoadReuse(List(InstructionEntry)).InvokeReads(call)
	result = call.payload(0)
	mutable lines = List(Mutable(InstructionEntry))
	for method.parameters
		lines.Add(InstructionEntry(Inliner.Store, List(Text) + value.Name, (call.payload(reads(index)), -1), call.line))
	flagged = InstructionEntry.Binary(InstructionType.Equal, (result, result))
	lines + (InstructionEntry.LoadNumber(result, 0), flagged, Restart)
Returns(instructions List(InstructionEntry), register Number, start Number) Boolean
	Sample.Returns(Counting.instructions, 1, 2)
	Sample.Returns(Counting.instructions, 0, 2) is false
	Sample.Returns(Branched, 1, 1)
	Sample.Returns(Branched, 2, 1) is false
	mutable current = "%r" + register
	for Range(start, instructions.Length)
		current = Follow(instructions(value), current)
		if current is in ("", "returned")
			return current is "returned"
	false
Follow(entry InstructionEntry, current Text) Text
	Sample.Follow(Kept, "%r1") is "%v_conditional0"
	Sample.Follow(InstructionEntry.Return(2), "%r1") is ""
	if entry.kind is InstructionType.JumpEnd
		return current
	register = "%r" + entry.payload(0)
	if entry.kind is InstructionType.StoreRegisterToVariable and register is current
		return "%v_" + entry.texts(0)
	isLoaded = entry.kind is InstructionType.LoadVariableToRegister and "%v_" + entry.texts(0) is current
	isChecked = entry.kind is InstructionType.CheckError and register is current
	isReturned = entry.kind is InstructionType.Return and register is current
	isReturned then "returned" else isLoaded then register else isChecked then current else ""