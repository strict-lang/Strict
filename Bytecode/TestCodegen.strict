has types TypeCodegen
has isQuiet Boolean = false
constant Even = TestCodegen(TypeCodegen("Strict/Even", ("IsEven(number Number) Boolean", "\tIsEven(2) is true", "\tnumber % 2 is 0"), TypeCodegen.NoTypes, List(Text)))
constant Counter = CodeBlock.Empty.Declare("failed", "Number")
constant OneIsOne = SyntaxNode("Binary", "is", (MethodCodegen.One, MethodCodegen.One))
constant EvenFailed = InstructionEntry(InstructionType.Print, "Test failed: IsEven(2) is true in IsEven at Even.strict:line 2", (-1, 0), 2)
constant EvenPassed = InstructionEntry(InstructionType.Print, "Test passed: IsEven(2) is true in IsEven at Even.strict:line 2", (-1, 0), 2)
constant Runner = "$Tests"
Tests MethodEntry
	Even.Tests.Name is Runner
	Even.Tests.instructions.Last.kind is InstructionType.Return
	let scope = types.Generator.target.shape.MemberScope.With("failed", "Number")
	let start = CodeBlock(List(InstructionEntry), 0, 0, scope)
	mutable block = start.Add(MethodCodegen.StoreConstant(InstructionEntry.LoadNumber(0, 0), "failed"))
	for types.lines
		if TypeShape(types.lines).IsMethodHeader(value)
			block = Method(index, block)
	let failed = block.At(0).Load(InstructionEntry.Named(InstructionType.LoadVariableToRegister, 0, "failed"))
	MethodEntry(Runner, List(MemberEntry), "Strict/Number", failed.Add(InstructionEntry.Return(0)).instructions)
Method(start Number, block CodeBlock) CodeBlock
	Even.Method(0, Counter).instructions.Index(EvenFailed) > 0 is true
	Even.Method(0, Counter).instructions.Index(EvenPassed) > 0 is true
	TestCodegen(Even.types, true).Method(0, Counter).instructions.Index(EvenPassed) is -1
	Even.Method(0, Counter).instructions.Last.line is 2
	let name = Tokenizer(types.lines(start)).Tokens.First
	mutable result = block.Declare(CodeBlock.ErrorMarker, name)
	for TestLines(types.Generator).Tests(BodyParser(types.lines).Method(start + 1), block)
		result = MethodCodegen(types.Generator).Lined(Line(value, name, result.At(0)), result.instructions.Length, value.line)
	result
Line(line SyntaxNode, method Text, block CodeBlock) CodeBlock
	Even.Line(OneIsOne, "IsEven", Counter).instructions.Length > 4 is true
	if line.Kind is "Declaration"
		return MethodCodegen(types.Generator).Statement(line, block, false)
	Checked(line, method, block)
Checked(test SyntaxNode, method Text, block CodeBlock) CodeBlock
	Even.Checked(SyntaxNode("Boolean", "true"), "A", Counter).instructions.Last.kind is InstructionType.JumpEnd
	let generated = types.Generator.Expression(test, block)
	let truth = generated.Load(InstructionEntry.LoadBoolean(generated.register, true))
	let compared = truth.Add(InstructionEntry.Binary(InstructionType.Equal, (generated.Result, truth.Result)))
	let file = TypeEntry(types.fullName, List(MemberEntry), List(MethodEntry)).File
	let place = test to Text + " in " + method + " at " + file + ":line " + test.line
	let reported = isQuiet then compared else Passed(compared, place)
	let jumped = reported.Add(InstructionEntry.Jump(InstructionType.JumpToIdIfTrue, reported.nextId)).WithNextId
	let printed = Got(test, jumped.Add(InstructionEntry.Print("Test failed: " + place)))
	Counted(printed).Add(InstructionEntry.Jump(InstructionType.JumpEnd, jumped.nextId - 1))
Passed(compared CodeBlock, place Text) CodeBlock
	Even.Passed(Counter, "x").instructions.Length is 3
	let passed = compared.Add(InstructionEntry.Jump(InstructionType.JumpToIdIfFalse, compared.nextId)).WithNextId
	let printed = passed.Add(InstructionEntry.Print("Test passed: " + place))
	printed.Add(InstructionEntry.Jump(InstructionType.JumpEnd, passed.nextId - 1))
Got(test SyntaxNode, block CodeBlock) CodeBlock
	Even.Got(OneIsOne, Counter).instructions.Last.kind is InstructionType.Print
	Even.Got(MethodCodegen.One, Counter).instructions.Length is 0
	if (test.Kind is not "Binary") or (test.text is not "is")
		return block
	let left = types.Generator.Expression(test.children(0), block)
	let isText = types.Generator.TypeOf(test.children(0), left) is "Text"
	left.Add(InstructionEntry.PrintValue("  got: ", left.Result, isText))
Counted(block CodeBlock) CodeBlock
	Even.Counted(Counter).instructions.Last.texts is ("failed")
	constant sum = SyntaxNode("Binary", "+", (SyntaxNode("Identifier", "failed"), SyntaxNode("Number", "1")))
	types.Generator.Expression(sum, block).Stored("failed")