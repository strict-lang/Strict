has values ValueCodegen
constant Scalars = ("Text", "Boolean", "Error", "ErrorWithValue", "Dictionary")
constant Plain = TestComparison(ValueCodegen.Plain)
constant Deep = "Numberssssssssss"
Precise(left SyntaxNode, right SyntaxNode, block CodeBlock) Boolean
	let kinds = (values.TypeOf(left, block), values.TypeOf(right, block))
	if values.IsTypeName(right, block) or (kinds.Last is in ("Error", "ErrorWithValue"))
		return true
	if kinds.First is in Scalars
		return true
	let fields = values.inference.types.MembersOf(kinds.First).names.Length > 0
	let list = values.inference.types.BaseName(kinds.First) is "List"
	(kinds.First is not "Number") and (fields is false) and (list is false)
Checked(test SyntaxNode, left SyntaxNode, right SyntaxNode, block CodeBlock) CodeBlock
	let tested = SyntaxNode("Identifier", ErrorCodegen.Tested)
	let step = StepRounding(values)
	let exact = (step.StepOf(left, block) is not "") or (step.StepOf(right, block) is not "")
	let operator = test.text is in ("is", "is not") then test.text else "is"
	let comparison = SyntaxNode("Binary", operator, (tested, right), test.line)
	if Precise(left, right, block)
		return values.Expression(comparison, block)
	let compared = Compared(tested, right, block, exact)
	operator is "is not" then compared.Negated else compared
Compared(left SyntaxNode, right SyntaxNode, block CodeBlock, exact Boolean) CodeBlock
	let generated = values.Expression(right, block).Stored("testExpected").At(block.register)
	let declared = generated.Declare("testExpected", values.TypeOf(right, block))
	let kinds = (values.TypeOf(left, block), values.TypeOf(right, block))
	let lines = Lines(left to Text, "testExpected", kinds, "0", exact, List(Text))
	mutable indented = List(Text) + "Run"
	for lines + "testEqual0"
		indented = indented + ("\t" + value)
	MethodCodegen(values).Body(BodyParser(indented).Block(1, 1), declared)
Lines(left Text, right Text, kinds Texts, slot Text, exact Boolean, expanded Texts) Texts
	Plain.Lines("left", "right", ("Number", "Number"), "0", true, List(Text)).Last is "let testEqual0 = left is right"
	let same = List(Text) + ("let testEqual" + slot + " = " + left + " is " + right)
	if exact or (kinds.First is not kinds.Last) or (kinds.First is in expanded)
		return same
	if kinds.First is "Number"
		return Numeric(left, right, slot)
	let base = values.inference.types.BaseName(kinds.First)
	if base is "List"
		return Elements(left, right, kinds.First, slot, expanded + kinds.First)
	if (values.inference.types.MembersOf(kinds.First).names.Length is 0) or (base is in Scalars)
		return same
	Fields(left, right, kinds.First, slot, expanded + kinds.First)
Numeric(left Text, right Text, slot Text) Texts
	let scale = "testScale" + slot
	let difference = "testDelta" + slot
	let maximum = left + ".Absolute > " + right + ".Absolute then " + left + ".Absolute else " + right + ".Absolute"
	let bound = "0.0000001 * (1 + " + scale + ")"
	let close = difference + " < 1 / 0 and " + difference + " <= " + bound
	let first = "let " + scale + " = " + maximum
	let second = "let " + difference + " = (" + left + " - " + right + ").Absolute"
	(first, second, "let testEqual" + slot + " = " + left + " is " + right + " or (" + close + ")")
Elements(left Text, right Text, kind Text, slot Text, expanded Texts) Texts
	Text.Combine(Plain.Elements("left", "right", Deep, "0", List(Text))).IndexOf("testDelta") > 0
	let same = "testEqual" + slot
	let child = slot + "x"
	let item = values.inference.types.ElementType(kind)
	let head = "mutable " + same + " = " + left + ".Length is " + right + ".Length"
	mutable lines = (head, "if " + same, "\tfor " + left + ".Length")
	let first = "testLeft" + child
	let second = "testRight" + child
	lines = lines + ("\t\tlet " + first + " = " + left + "(index)", "\t\tlet " + second + " = " + right + "(index)")
	for Lines(first, second, (item, item), child, false, expanded)
		lines = lines + ("\t\t" + value)
	lines + ("\t\t" + same + " = " + same + " and testEqual" + child)
Fields(left Text, right Text, kind Text, slot Text, expanded Texts) Texts
	let members = values.inference.types.MembersOf(kind)
	mutable lines = List(Text) + ("mutable testEqual" + slot + " = true")
	for members.names
		let child = slot + "x" + index
		let type = members.types(index)
		let step = values.inference.types.ParameterScope(kind).TypeOf(value + " step")
		let nested = Lines(left + "." + value, right + "." + value, (type, type), child, step is not "", expanded)
		lines = lines + nested + ("testEqual" + slot + " = testEqual" + slot + " and testEqual" + child)
	lines
