has values ValueCodegen
constant Plain = TestComparison(ValueCodegen.Plain)
constant Logical = SyntaxParser(Tokenizer("true and (1 is 1)").Tokens).Parse
constant Equal = Logical.children.Last
constant Pair = SyntaxParser("(", "1", ",", "2", ")").ParseRange(0, 5)
constant Unequal = SyntaxNode("Binary", "is not", (ValueCodegen.One, Pair))
constant Letter = SyntaxNode("Text", "\"a\"")
IsPrecise(left SyntaxNode, right SyntaxNode, block CodeBlock) Boolean
	Plain.IsPrecise(ValueCodegen.One, ValueCodegen.One, CodeBlock.Empty) is false
	Plain.IsPrecise(Letter, Letter, CodeBlock.Empty) and Plain.IsPrecise(Pair, Pair, CodeBlock.Empty) is false
	Plain.IsPrecise(ValueCodegen.One, SyntaxNode("Identifier", "Error"), CodeBlock.Empty)
	kinds = (values.TypeOf(left, block), values.TypeOf(right, block))
	step = StepRounding(values)
	if values.IsTypeName(right, block) or kinds.Last is in ("Error", "ErrorWithValue")
		return true
	if kinds.First is in Closeness.Scalars or kinds.First is not kinds.Last
		return true
	if step.StepOf(left, block) is not "" or step.StepOf(right, block) is not ""
		return true
	fields = values.inference.types.MembersOf(kinds.First).names.Length > 0
	list = values.inference.types.BaseName(kinds.First) is "List"
	kinds.First is not "Number" and fields is false and list is false
Check(test SyntaxNode, left SyntaxNode, right SyntaxNode, block CodeBlock) CodeBlock
	Plain.Check(Equal, ValueCodegen.One, ValueCodegen.One, CodeBlock.Empty).instructions.Length is 3
	Plain.Check(Unequal, Pair, Pair, CodeBlock.Empty).instructions.Length is 5
	tested = SyntaxNode("Identifier", ErrorCodegen.Tested)
	operator = test.text is in ("is", "is not") then test.text else "is"
	Nearly(SyntaxNode("Binary", operator, (tested, right), test.line), IsPrecise(left, right, block), block)
Nearly(comparison SyntaxNode, isPrecise Boolean, block CodeBlock) CodeBlock
	Plain.Nearly(Logical.children.Last, true, CodeBlock.Empty).scope.Count(TestReports.Nearing) is 0
	if isPrecise
		return values.Expression(comparison, block)
	compared = Compare(comparison.children(0), comparison.children(1), block)
	comparison.text is "is not" then compared.Negated else compared
IsLogical(node SyntaxNode, block CodeBlock) Boolean
	Plain.IsLogical(Logical, CodeBlock.Empty)
	Plain.IsLogical(SyntaxNode("Binary", "and", (ValueCodegen.One, ValueCodegen.One)), CodeBlock.Empty) is false
	node.Kind is "Binary" and node.text is in ("and", "or") and OperatorCodegen(values).IsCustom(node, block) is false
Evaluat(node SyntaxNode, block CodeBlock) CodeBlock
	Plain.Evaluat(Logical.children.Last, CodeBlock.Empty).instructions.Last.kind is InstructionType.Invoke
	if IsLogical(node, block)
		return OperatorCodegen(values, true).Logical(node, block)
	if node.Kind is "Binary" and node.text is in ("is", "is not")
		return Nearly(node, IsPrecise(node.children(0), node.children(1), block), block)
	values.Expression(node, block)
Compare(left SyntaxNode, right SyntaxNode, block CodeBlock) CodeBlock
	Plain.Compare(ValueCodegen.One, ValueCodegen.One, CodeBlock.Empty).instructions.Last.texts(1) is "$TestsNear0"
	Plain.Compare(ValueCodegen.One, ValueCodegen.One, CodeBlock.Empty).scope.TypeOf(" near") is "Number"
	key = values.TypeOf(left, block)
	marked = TestReports.Mark(block, TestReports.Nearing, key)
	expected = values.Expression(right, marked)
	tested = values.Expression(left, expected)
	name = TestCodegen.Runner + "Near" + TestReports.MarkAll(marked.scope, TestReports.Nearing).Index(key)
	signature = (values.target.fullName, name, "Strict/Boolean", ErrorCodegen.Tested, TestReports.Expected)
	tested.Load(InstructionEntry.Invoke(tested.register, signature, (tested.Result, expected.Result), -1))
Store(test SyntaxNode, left SyntaxNode, block CodeBlock) CodeBlock
	Plain.Store(Logical, Logical, CodeBlock.Empty).scope.TypeOf(TestReports.Nearing) is "Number"
	if IsLogical(test, block) is false
		return ErrorCodegen(values).Caught(test, left, block)
	Evaluat(test, block).Stored(ErrorCodegen.Tested).At(block.register)
Shortcut(left Text, lines Texts) Texts
	TestComparison(ValueCodegen.Plain).Shortcut("x", List(Text))(2) is "\tif (testEqual0 is false) and (x is not Error)"
	TestComparison(ValueCodegen.Plain).Shortcut("x", List(Text))(0) is "Run"
	TestComparison(ValueCodegen.Plain).Shortcut("x", List(Text))(1) is "\tmutable testEqual0 = x is testExpected"
	TestComparison(ValueCodegen.Plain).Shortcut("x", List(Text))(3) is "\t\ttestEqual0 = testEqual1"
	TestComparison(ValueCodegen.Plain).Shortcut("x", List(Text)).Last is "\ttestEqual0"
	guard = "\tif (testEqual0 is false) and (" + left + " is not Error)"
	mutable indented = ("Run", "\tmutable testEqual0 = " + left + " is testExpected", guard)
	for lines + "testEqual0 = testEqual1"
		indented = indented + ("\t\t" + value)
	indented + "\ttestEqual0"