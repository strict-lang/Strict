has values ValueCodegen
Precise(left SyntaxNode, right SyntaxNode, block CodeBlock) Boolean
	let kinds = (values.TypeOf(left, block), values.TypeOf(right, block))
	if values.IsTypeName(right, block) or (kinds.Last is in ("Error", "ErrorWithValue"))
		return true
	if kinds.First is in Closeness.Scalars
		return true
	let fields = values.inference.types.MembersOf(kinds.First).names.Length > 0
	let list = values.inference.types.BaseName(kinds.First) is "List"
	(kinds.First is not "Number") and (fields is false) and (list is false)
Checked(test SyntaxNode, left SyntaxNode, right SyntaxNode, block CodeBlock) CodeBlock
	let tested = SyntaxNode("Identifier", ErrorCodegen.Tested)
	let step = StepRounding(values)
	let exact = (step.StepOf(left, block) is not "") or (step.StepOf(right, block) is not "")
	let operator = test.text is in ("is", "is not") then test.text else "is"
	let comparison = SyntaxNode("Binary", operator, (tested, right), test.line)
	if Precise(left, right, block)
		return values.Expression(comparison, block)
	let compared = Compared(tested, right, block, exact)
	operator is "is not" then compared.Negated else compared
Compared(left SyntaxNode, right SyntaxNode, block CodeBlock, exact Boolean) CodeBlock
	let generated = values.Expression(right, block).Stored("testExpected").At(block.register)
	let declared = generated.Declare("testExpected", values.TypeOf(right, block))
	let kinds = (values.TypeOf(left, block), values.TypeOf(right, block))
	let lines = Closeness(values.inference.types).Lines(left to Text, "testExpected", kinds, "1", exact, List(Text))
	MethodCodegen(values).Body(BodyParser(Shortcut(left to Text, lines)).Block(1, 1), declared)
Shortcut(left Text, lines Texts) Texts
	TestComparison(ValueCodegen.Plain).Shortcut("x", List(Text) + "let testEqual1 = x")(2) is "\tif testEqual0 is false"
	mutable indented = ("Run", "\tmutable testEqual0 = " + left + " is testExpected", "\tif testEqual0 is false")
	for lines + "testEqual0 = testEqual1"
		indented = indented + ("\t\t" + value)
	indented + "\ttestEqual0"