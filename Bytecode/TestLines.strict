has values ValueCodegen
constant Plain = TestLines(ValueCodegen.Plain)
constant One = MethodCodegen.One
constant Framed = BodyParser("Run(frames = 0 with value >= 0) Number", "\tRun(1) is 1", "\tframes").Block(1, 1)
constant FramedHeader = HeaderTokens(Tokenizer("Run(frames = 0 with value >= 0) Number").Tokens)
constant Declared = BodyParser("Run", "\tconstant a = 1", "\ta is 1", "\t2").Block(1, 1)
constant Sizing = TestLines(ValueCodegen(ValueCodegen.NoTypes, MethodCodegen.NoScope, CallTarget(CallTarget.NoTypes, TypeShape("has Height Number", "has Width Number with value > 0"), "Strict/Size", List(Text))))
constant Validating = HeaderTokens(Tokenizer("Validated Size").Tokens)
constant Even = TestLines(ValueCodegen(ValueCodegen.NoTypes, Scope(List(Text) + "IsEven", List(Text) + "Boolean"), CallTarget(CallTarget.NoTypes, TypeShape("IsEven(number Number) Boolean", "\tnumber % 2 is 0"), "Strict/C", List(Text))))
constant Attacking = KnownTypes(List(Text) + "C", List(Scope) + Scope(List(Text) + "attack", List(Text) + "Boolean"), List(Scope) + Scope(List(Text) + "Read", List(Text) + "C"), List(Scope) + KnownTypes.NoMembers)
constant Reading = TestLines(ValueCodegen(TypeInference(Attacking, CallTarget.NoScopes), Scope(List(Text) + "Read", List(Text) + "C"), CallTarget(Attacking, TypeShape("has attack Boolean", "Read C", "\tC(true)"), "Strict/C", List(Text))))
Without(body SyntaxNode, block CodeBlock) SyntaxNode
	Plain.Without(BodyParser("Run", "	1 is 1", "	2 is not 3", "	2").Block(1, 1), CodeBlock.Empty).children.Length is 1
	Plain.Without(BodyParser("Run", "\t2 is in (1, 2)", "\t2").Block(1, 1), CodeBlock.Empty).children.Length is 1
	Plain.Without(BodyParser("Run Boolean", "\t3 > 1", "\ttrue").Block(1, 1), CodeBlock.Empty).children.Length is 1
	Plain.Without(Declared, CodeBlock.Empty).children.Length is 1
	let end = LeadingEnd(body, block)
	mutable code = List(Mutable(SyntaxNode))
	for body.children
		if index >= end
			code.Add(value)
	SyntaxNode("Body", "", UsedConstants(body, code, block) + code)
UsedConstants(body SyntaxNode, code SyntaxNodes, block CodeBlock) SyntaxNodes
	Plain.UsedConstants(Declared, Declared.children, CodeBlock.Empty).Length is 1
	mutable names = List(Mutable(Text))
	for SyntaxNode("Body", "", code).Statements
		names = names + value.HeadNames
	let end = LeadingEnd(body, block)
	for body.children
		if (index < end) and IsTestConstant(body, index, block) and (Tokenizer(value.text).Tokens.Last is in names)
			value
Tests(body SyntaxNode, block CodeBlock) SyntaxNodes
	Plain.Tests(BodyParser("Run", "\t1 is 1", "\t2 is not 3", "\t2").Block(1, 1), CodeBlock.Empty).Length is 2
	Plain.Tests(BodyParser("Run", "\tlet a = 1", "\ta is 1", "\ta").Block(1, 1), CodeBlock.Empty).Length is 0
	Plain.Tests(BodyParser("Run", "\tconstant a = 1", "\ta is 1", "\ta").Block(1, 1), CodeBlock.Empty).Length is 2
	Plain.Tests(BodyParser("Run", "\t1 is 1", "\tconstant a = 1", "\ta").Block(1, 1), CodeBlock.Empty).Length is 1
	Plain.Tests(BodyParser("Run", "\tmutable a = 1", "\ta is 1", "\ta").Block(1, 1), CodeBlock.Empty).Length is 0
	Reading.Tests(BodyParser("Run", "\t1 is 1", "\tRead.attack", "\t2").Block(1, 1), CodeBlock.Empty).Length is 2
	let end = LeadingEnd(body, block)
	for body.children
		if index < end
			value
LeadingEnd(body SyntaxNode, block CodeBlock) Number
	Plain.LeadingEnd(Declared, CodeBlock.Empty) is 2
	for body.children
		let isLast = index is body.children.Length - 1
		if isLast or ((IsTest(value, true, block) or IsTestConstant(body, index, block)) is false)
			return index
	body.children.Length
IsTestConstant(body SyntaxNode, position Number, block CodeBlock) Boolean
	Plain.IsTestConstant(BodyParser("Run", "\tconstant a = 1", "\ta is 1", "\ta").Block(1, 1), 0, CodeBlock.Empty) is true
	let line = body.children(position)
	let isDeclared = (line.Kind is "Declaration") and line.text.StartsWith("constant ")
	isDeclared and (position + 2 < body.children.Length) and IsTest(body.children(position + 1), true, block)
IsTest(line SyntaxNode, isLeading Boolean, block CodeBlock) Boolean
	Plain.IsTest(SyntaxNode("Binary", ">", (One, One)), false, CodeBlock.Empty) is false
	Plain.IsTest(SyntaxNode("Not", "", SyntaxNode("Binary", "is", (One, One))), false, CodeBlock.Empty) is true
	Plain.IsTest(SyntaxNode("Binary", "+", (One, One)), true, CodeBlock.Empty) is false
	Plain.IsTest(SyntaxNode("Declaration", "let a", SyntaxParser("1", "is", "1").Parse), false, CodeBlock.Empty) is false
	Even.IsTest(SyntaxNode("Call", "IsEven", One), true, CodeBlock.Empty) is true
	if line.Kind is in ("If", "ElseIf", "Else", "Declaration", "Reassignment")
		return false
	let lineText = line to Text
	if isLeading and IsCalling(line, block) or lineText.IndexOf(" is ") >= 0
		return values.TypeOf(line, block) is "Boolean"
	false
IsCalling(line SyntaxNode, block CodeBlock) Boolean
	Reading.IsCalling(SyntaxNode("Member", "attack", SyntaxNode("Identifier", "Read")), CodeBlock.Empty) is true
	Reading.IsCalling(SyntaxNode("Identifier", "attack"), CodeBlock.Empty) is false
	if line.Kind is "Member"
		return values.IsMethodCall(line, block) or IsCalling(line.children(0), block)
	values.IsMethodCall(line, block)
Guarded(body SyntaxNode, header HeaderTokens, line Number, scope Scope) SyntaxNode
	Plain.Guarded(Framed, FramedHeader, 1, MethodCodegen.NoScope).children(1).Kind is "If"
	Plain.Guarded(Framed, FramedHeader, 1, MethodCodegen.NoScope).children.Length is 3
	let end = LeadingEnd(body, CodeBlock(List(InstructionEntry), 0, 0, scope))
	let checks = Validations(header) + Checks(header, line)
	mutable statements = List(Mutable(SyntaxNode))
	for body.children
		statements = index is end then statements + checks + value else statements + value
	SyntaxNode("Body", "", statements)
Validations(header HeaderTokens) SyntaxNodes
	Sizing.Validations(Validating).Length is 1
	Sizing.Validations(Validating).First.line is 2
	Sizing.Validations(FramedHeader).Length is 0
	if header.tokens(0) is not "Validated"
		return List(SyntaxNode)
	Automatic(values.target.shape.lines, "", Instantiation(values.inference.types)).Validations
Checks(header HeaderTokens, line Number) SyntaxNodes
	Plain.Checks(FramedHeader, 1).First.line is 1
	let parameterTypes = header.ParameterTypes
	mutable checks = List(Mutable(SyntaxNode))
	for header.ParameterNames
		let constraint = Constraint.Parameter(header, value)
		if constraint is not ""
			checks.Add(Constraint(value, parameterTypes(index), values.inference.types).Checked(constraint, line))
	checks