has fullName Text
has lines Texts
has inference Expressions/TypeInference
has typeNames Texts
has isOptimizing Boolean = true
constant NoTypes = ValueCodegen.NoTypes
constant Guarded = ("Run(a = 0 with value > 0) Number", "\ta")
constant Hello = TypeCodegen("Strict/HelloLogger", ("has logger", "Run", "\tlogger.Log(\"Hi\")"), ValueCodegen.Logging, List(Text))
constant Greeted = CodeBlock.Empty.Add(MethodEntry.PrintHi).Nothing.instructions
constant Logging = HeaderTokens("has", "logger")
constant Alpha = HeaderTokens("has", "alpha", "=", "1", "with", "value", ">", "0")
constant Unscoped = Scope(List(Text), List(Text))
constant Aliased = TypeCodegen("Strict/F", ("constant Fast = \"f\"", "constant x = Fast"), NoTypes, List(Text)).Member(HeaderTokens("constant", "x", "=", "Fast"), 1, TypeShape(("constant Fast = \"f\"", "constant x = Fast")).MethodScope)
constant Limit = TypeCodegen("Strict/Limit", ("constant limit = 10", "Run Number", "\tlimit"), NoTypes, List(Text))
constant Iterating = TypeCodegen("Strict/Size", ("has Width Number", "for Iterator(Number)", "\tfor Width", "\t\tindex"), NoTypes, List(Text))
constant Grid = TypeCodegen("Strict/Size", ("has Width Number", "has Height Number", "for Iterator(Vector2)", "\tfor Height", "\t\tfor Width", "\t\t\tVector2(index, outer.index)"), NoTypes, List(Text))
constant Created = TypeCodegen("Strict/C", ("has a Number", "from(b Number)", "\ta = b"), NoTypes, List(Text))
constant VectorTypes = KnownTypes(List(Text) + "Vector2", List(Scope) + Scope(List(Text) + "numbers", List(Text) + "Numbers"), List(Scope) + KnownTypes.NoMembers, List(Scope) + KnownTypes.NoMembers)
constant Vectors = TypeCodegen("Strict/C", List(Text), TypeInference(VectorTypes, List(Scope) + KnownTypes.NoMembers), List(Text))
constant Texted = TypeCodegen("Strict/Digit", ("has a Number", "to Text", "\t\"c\""), NoTypes, List(Text))
constant Leveled = TypeCodegen("Strict/L", ("has level = Fast", "constant Fast = \"a\""), NoTypes, List(Text))
constant Flats = (Scope(("from", "from types", "items default"), ("items", "Texts", "Plain.Flat")), KnownTypes.NoMembers)
constant Filling = TypeInference(KnownTypes(DefaultInstance.Bags, parameters = Flats), DefaultInstance.Computing.constants)
constant Defaulted = TypeCodegen("Strict/Bag", ("has items Texts = Plain.Flat", "Count Number", "\titems.Length"), Filling, List(Text))
constant Rebuilt = SyntaxParser(Tokenizer("Greeter(Greeter(\"a\"), text = \"b\")").Tokens).Parse
Entry TypeEntry slow
	Texted.Methods(("to")).Length is 1
	Hello.Entry is TypeEntry(TypeEntry.HelloLogger, methods = MethodEntry(MethodEntry.HelloRun, instructions = Greeted))
	ConstantMethods.Counting.Methods(List(Text)).Length is 2
	Specialization.Coding.Methods(List(Text) + Specialization.Halving).Length is 1
	TypeEntry(Generator.target.TypeName, Members, Methods(List(Text)))
Selected(names Texts) TypeEntry slow
	Limit.Selected("Run").Name is "Strict/Limit"
	Limit.Selected("Missing").methods.Length is 0
	Limit.Selected(List(Text)).methods.Length is 0
	Limit.Selected("Run").methods.Length is 1
	Limit.Selected(("to Number")).methods.Length is 0
	TypeCodegen("Strict/S", ("W Number", "H Number"), NoTypes, List(Text)).Selected(List(Text)).methods.Length is 2
	TypeCodegen("Strict/B", ("Not Boolean", "\ttrue"), NoTypes, List(Text)).Selected(List(Text)).methods.Length is 0
	let membersOnly = (names.Length is 0) and (TypeShape(lines).IsTrait is false)
	TypeEntry(fullName, Members, (membersOnly then List(MethodEntry) else Methods(names)))
Generator ValueCodegen
	Limit.Generator.target.TypeName is "Limit"
	TypeCodegen("S/List(Number)", ("has x Generic"), NoTypes, List(Text)).Members.First.typeName is "Strict/Number"
	Leveled.Member(HeaderTokens("has", "x", "Fast"), 0, Scope(("Fast"), ("Text"))).typeName is "Strict/Fast"
	let target = CallTarget(inference.types, TypeShape(lines), fullName, typeNames)
	ValueCodegen(inference, inference.types.MethodsOf(target.TypeName), target, isOptimizing)
Members List(MemberEntry) slow
	Limit.Members.First.initial.First.payload is (1, 10, 0)
	Leveled.Members.First.typeName is "Strict/Text"
	mutable members = List(Mutable(MemberEntry))
	let methods = TypeShape(lines).MethodScope
	for lines
		if TypeShape(lines).IsMemberLine(value)
			members.Add(Member(HeaderTokens(Tokenizer(value).Tokens), index, methods))
	members
Member(header HeaderTokens, position Number, methods Scope) MemberEntry
	Hello.Member(Logging, 0, Unscoped).typeName is "Strict/Logger" and (Aliased.typeName is "Strict/Text")
	Hello.Member(HeaderTokens("constant", "Add"), 0, Unscoped).initial.First.payload is (1, 0, 0)
	Hello.Member(Alpha, 0, Unscoped).initial.First.payload is (1, 1, 0)
	Hello.Member(HeaderTokens("has", "x", "Number", "with", "value", ".", "Bits", "is", "32"), 0, Unscoped).Bits is 32
	Hello.Member(HeaderTokens("has", "numbers", "with", "Length", "is", "3"), 0, Unscoped).Count is 3
	let isConstant = header.tokens(0) is "constant"
	let typed = header.DeclaredType(1)
	let own = "=" is not in header.tokens then "" else methods.TypeOf(typed)
	let declared = Scope(List(Text) + header.MemberName, List(Text) + (own is "" then typed else own))
	let member = Instantiation(inference.types).Members(Generator.target.TypeName, declared)
	let type = Generator.target.FullName(Concrete(member.types.First))
	MemberEntry(header.MemberName, type, InitialOf(header, position), isConstant).Limited(Text.Combine(header.tokens, " "))
InitialOf(header HeaderTokens, position Number) List(InstructionEntry)
	Hello.InitialOf(HeaderTokens("has", "count", "Number"), 0).Length is 0
	if (header.tokens(0) is "constant") and (header.tokens.Length is 2)
		let number = InstructionEntry.NumberValue(TypeShape(lines).EnumValue(position))
		return List(InstructionEntry) + InstructionEntry.Set(List(Text), number)
	let equals = header.tokens.Index("=")
	if equals is -1
		return List(InstructionEntry)
	let constraints = header.tokens.Index("with")
	let end = constraints is -1 then header.tokens.Length else constraints
	Initial(SyntaxParser(header.tokens).ParseRange(equals + 1, end))
Initial(node SyntaxNode) List(InstructionEntry)
	Hello.Initial(SyntaxNode("Text", "\"a\"")).First.payload is (4, -1, 0)
	Hello.Initial(SyntaxNode("Call", "Range")).Length is 0
	Vectors.Initial(SyntaxParser(Tokenizer("Vector2(1, 2)").Tokens).Parse).First.payload is (6, -1, 2, 1, 1, 1, 2, 0)
	Hello.Initial(SyntaxParser("(", "1", ",", "2", ")").ParseRange(0, 5)).First.payload is (6, -1, 2, 1, 1, 1, 2, 0)
	let literal = ConstantFolding(Generator.target.TypeName, inference, isOptimizing).Unwrapped(node)
	if literal.IsLiteral is false
		return List(InstructionEntry)
	let load = Generator.Expression(literal, CodeBlock.Empty).instructions(0)
	List(InstructionEntry) + InstructionEntry.Set(load.texts, MethodCodegen.LoadedValue(load))
Methods(names Texts) List(MethodEntry)
	Limit.Methods(List(Text)).First.instructions.Length is 2
	Limit.Methods(List(Text)).First.Name is "Run" and (Texted.Methods(("to Text")).Length is 1)
	Defaulted.Methods(List(Text)).Last.Name is DefaultInstance.Starter and (Defaulted.Methods(("Count")).Length is 1)
	mutable methods = List(Mutable(MethodEntry))
	for lines
		if TypeShape(lines).IsMethodHeader(value)
			let tokens = Tokenizer(value).Tokens
			let converted = tokens.First is "to" then "to " + HeaderTokens(tokens).ReturnType else tokens.First
			if (names.Length is 0) or (tokens.First is in names) or (converted is in names)
				methods.Add(Method(index))
	let constants = ConstantMethods(inference, isOptimizing).Methods(value, names)
	methods + constants + Specialization(Generator).Methods(value, names) + Starts(names)
Starts(names Texts) List(MethodEntry)
	Limit.Starts(List(Text)).Length is 0
	Defaulted.Starts(("Count")).Length is 0 and (Defaulted.Starts((DefaultInstance.Starter)).Length is 1)
	Defaulted.Starts(List(Text)).First.instructions(2).texts is ("Strict/Bag", "from", "Bag", "items")
	Defaulted.Starts(List(Text)).First.instructions.Last.kind is InstructionType.Return
	constant generator = Generator
	let type = generator.target.TypeName
	let isAsked = (names.Length is 0) or (DefaultInstance.Starter is in names)
	if (isAsked and DefaultInstance(generator).HasComputed(type)) is false
		return List(MethodEntry)
	let scope = MethodScope(HeaderTokens(DefaultInstance.Starter), generator.target)
	let code = generator.Expression(SyntaxNode("Call", type), CodeBlock(List(InstructionEntry), 0, 0, scope))
	List(MethodEntry) + MethodEntry(DefaultInstance.Starter, List(MemberEntry), fullName, code.Ended(type).instructions)
Method(start Number) MethodEntry slow
	(Hello.Method(1).returnType, Created.Method(1).returnType) is ("None", "Strict/C")
	Iterating.Method(1).instructions(0).texts.First is "Strict/List(Number)"
	Iterating.Method(1).returnType is "Strict/Iterator(Number)"
	(Grid.Method(2).instructions(5).texts, Grid.Method(2).instructions(6).texts) is (("index"), ("outer.index"))
	let header = HeaderTokens(Tokenizer(lines(start)).Tokens)
	constant generator = Generator
	let scope = MethodScope(header, generator.target)
	let returnType = Declared(header)
	let body = TestLines(generator).Guarded(BodyParser(lines).Method(start + 1), header, start + 1, scope)
	let code = MethodCodegen(generator).Generate(body, scope, BodyType(header))
	let optimized = LoadReuse(ChangedInstance(generator, header.tokens(0)).Kept(code).instructions).Optimized
	MethodEntry(header.tokens(0), Parameters(header), returnType, optimized)
Declared(header HeaderTokens) Text
	Hello.Declared(HeaderTokens(Tokenizer("Run Number slow").Tokens)) is "Slow(Strict/Number)"
	Created.Declared(HeaderTokens(Tokenizer("from(b Number)").Tokens)) is "Strict/C"
	Hello.Member(HeaderTokens("constant", "Add"), 0, Unscoped).IsConstant
	let result = header.tokens(0) is "from" then Generator.target.TypeName else Concrete(Returned(header))
	let full = Generator.target.FullName(result)
	header.ReturnsSlow then "Slow(" + full + ")" else full
MethodScope(header HeaderTokens, target CallTarget) Scope
	Hello.MethodScope(HeaderTokens("Run"), Hello.Generator.target).TypeOf(CodeBlock.ErrorMarker) is "Run"
	TypeCodegen("S/C", Guarded, NoTypes, List(Text)).Method(0).instructions.First.line is 1
	let declared = Instantiation(inference.types).Members(target.TypeName, target.shape.MemberScope)
	let members = MethodBodies(target.TypeName, target.shape, inference).HeaderScope(header, declared)
	members.With(CodeBlock.ErrorMarker, header.tokens(0))
BodyType(header HeaderTokens) Text
	Iterating.BodyType(HeaderTokens("for", "Iterator", "(", "Number", ")")) is "Numbers"
	Hello.BodyType(HeaderTokens("Run", "Number")) is "Number"
	TypeCodegen("Strict/List(Number)", List(Text), NoTypes, List(Text)).Concrete("Generic") is "Number"
	TypeCodegen("Strict/List(Number)", List(Text), NoTypes, List(Text)).Concrete("Text") is "Text"
	let returnType = Returned(header)
	Concrete(returnType.StartsWith("Iterator(") then inference.types.ElementType(returnType) + "s" else returnType)
Returned(header HeaderTokens) Text
	Hello.Returned(HeaderTokens("Run", "Number")) is "Number"
	TypeCodegen("S/A(B)", List(Text), NoTypes, List(Text)).Returned(HeaderTokens("x", "A")) is "y"
	TypeCodegen("S/A(B)", List(Text), NoTypes, List(Text)).Returned(HeaderTokens("x", "B")) is "B"
	TypeCodegen("S/A", List(Text), NoTypes, List(Text)).Returned(HeaderTokens("x", "A")) is "A"
	TypeCodegen("S/A", List(Text), NoTypes, List(Text)).Returned(HeaderTokens("x", "=")) is "y"
	let returned = header.ReturnType
	let name = Generator.target.TypeName
	let isTemplate = (returned is inference.types.BaseName(name)) and (name.IndexOf("(") > 0)
	(returned is "=") or isTemplate then inference.types.MethodsOf(name).TypeOf(header.tokens(0)) else returned
Parameters(header HeaderTokens) List(MemberEntry)
	Hello.Parameters(HeaderTokens("Add", "(", "first", "Number", ")")).Length is 1
	Hello.Parameters(HeaderTokens("Add", "(", "x", "=", "1", ")")).First.initial.Length is 1
	Hello.Parameters(HeaderTokens(Tokenizer("D(a Numbers with value.Bits is 32, b Numbers)").Tokens)).First.Bits is 32
	Hello.Parameters(HeaderTokens(Tokenizer("D(a Numbers with value.Bits is 32, b Numbers)").Tokens)).Last.Bits is 0
	let types = HeaderEntries(header, inference.types.MethodsOf(Generator.target.TypeName)).ParameterTypes
	mutable parameters = List(Mutable(MemberEntry))
	for header.ParameterNames
		let type = Generator.target.FullName(Concrete(types(index)))
		let bits = Constraint.Bits(Constraint.Parameter(header, value))
		parameters.Add(MemberEntry(value, type, Default(header, header.ParameterPosition(value)), false, bits))
	parameters
Default(header HeaderTokens, position Number) List(InstructionEntry)
	Hello.Default(HeaderTokens("Add", "(", "x", ")"), 2).Length is 0
	Hello.Default(HeaderTokens(Tokenizer("Run(frames = 0 with value >= 0)").Tokens), 2).Length is 1
	Hello.Default(HeaderTokens(Tokenizer("Run(name Text = \"a\")").Tokens), 2).Length is 1
	let equals = header.tokens(position + 1) is "=" then position + 1 else position + 2
	if (equals >= header.tokens.Length) or (header.tokens(equals) is not "=")
		return List(InstructionEntry)
	mutable end = -1
	for Range(equals + 1, header.tokens.Length)
		if (end is -1) and (header.tokens(value) is in (",", ")", "with"))
			end = value
	Initial(SyntaxParser(header.tokens).ParseRange(equals + 1, end))
Concrete(type Text) Text
	TypeCodegen("Strict/List(Number)", List(Text), NoTypes, List(Text)).Concrete("Generics") is "Numbers"
	TypeCodegen("Strict/List(Text)", List(Text), NoTypes, List(Text)).Concrete("List") is "Texts"
	TypeCodegen("Strict/Dictionary(Text, Text)", List(Text), NoTypes, List(Text)).Concrete("List") is "Textss"
	TypeCodegen("Strict/List(Number, Text)", List(Text), NoTypes, List(Text)).Concrete("Generics") is "List(Number, Text)"
	Hello.Concrete("Generic") is "Generic"
	Hello.Concrete("Iterator(Generic)") is "Iterator"
	let open = fullName.IndexOf("(")
	let element = MethodBodies.Item(fullName.Substring(open + 1, fullName.Length - open - 2))
	let elements = fullName.StartsWith("Strict/List(") and (fullName.IndexOf(",") > 0) then element else element + "s"
	let other = type is in ("Generics", "List") then elements else Instantiation(inference.types).Own(fullName, type)
	open is -1 then type.Replace("(Generic)", "") else (type is "Generic" then element else other)
Local(type Text) Text
	Hello.Local("Strict/Logger") is "Logger"
	Hello.Local("Strict/Bytecode/Crc") is "Strict/Bytecode/Crc"
	Path(type).PathOnly.text is Path(fullName).PathOnly.text then Path(type).FileName.text else type
