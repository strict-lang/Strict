has Name Text
has members List(MemberEntry)
has methods List(MethodEntry)
constant Numbers = TypeEntry("Strict/List(Number)", (MemberEntry("iterator", "Strict/Iterator", List(InstructionEntry), false), MemberEntry("elements", "Strict/List(Number)", List(InstructionEntry), false)), List(MethodEntry))
constant FormatVersion = 7
constant HelloLogger = TypeEntry("HelloLogger", MemberEntry.LoggerMember, MethodEntry.HelloRun)
constant CharacterEntry = TypeEntry("Strict/Character", List(MemberEntry) + MemberEntry("number", "Strict/Number", List(InstructionEntry), false), List(MethodEntry))
constant Rounded = TypeEntry("Strict/Float8", CharacterEntry.members, List(MethodEntry) + MethodEntry("from", CharacterEntry.members, "Strict/Float8", List(InstructionEntry)))
constant Scaling = TypeEntry("Strict/Vector", List(MemberEntry), (MethodEntry("*", List(MemberEntry) + MemberEntry("other", "Strict/Vector", List(InstructionEntry), false), "Strict/Number", List(InstructionEntry)), MethodEntry("*", List(MemberEntry) + MemberEntry("scale", "Strict/Number", List(InstructionEntry), false), "Strict/Vector", List(InstructionEntry))))
constant Initialized = TypeEntry("A", List(MemberEntry) + MemberEntry("B", "C", MethodEntry.GoRun.instructions, true), List(MethodEntry))
constant Kept = TypeEntry("A", List(MemberEntry) + MemberEntry("B", "C", List(InstructionEntry), true), List(MethodEntry) + MethodEntry("B", List(MemberEntry), "C", List(InstructionEntry)))
constant ToNumber = MethodEntry("to", List(MemberEntry), "Strict/Number", List(InstructionEntry))
constant Converting = TypeEntry("Strict/Digit", List(MemberEntry), (ToNumber, MethodEntry("to", List(MemberEntry) + MemberEntry.SevenMember, "Strict/Text", List(InstructionEntry))))
Names BinaryNames
	HelloLogger.Names.names is ("HelloLogger", "logger", "Strict/Logger", "Run", "None", "Hi")
	mutable result = BinaryNames.Empty.With(Name)
	for members
		result = value.Names(result)
	for methods
		result = value.Names(result)
	result
Bytes Numbers
	HelloLogger.Bytes.Length is 74
	let names = Names
	mutable integers = names.Integers + names.Index(Name) + members.Length
	for members
		let member = value.Integers(names)
		integers = integers + member.Length + member
	integers = integers + methods.Length
	for methods
		let method = value.Integers(names)
		integers = integers + method.Length + method
	ByteEncoder.Empty.SevenBits(integers).bytes
Chosen(name Text, count Number, returnType Text, names Texts) Number
	HelloLogger.Chosen("Run", 0, "None", List(Text)) is 0
	HelloLogger.Chosen("Missing", 0, "None", List(Text)) is -1
	Converting.Chosen("to", -1, "", List(Text)) is 0
	mutable chosen = -1
	mutable best = 0
	for methods
		let fit = value.Fit(name, count, returnType, names)
		if fit > best
			chosen = index
			best = fit
	chosen
Callee(name Text, count Number, returnType Text, names Texts) MethodEntry
	HelloLogger.Callee("Run", 0, "None", List(Text)).instructions.Length is 2
	Converting.Callee("to", 0, "Text", List(Text)).parameters.Length is 1
	Converting.Callee("to", 0, "Strict/Number", List(Text)).parameters.Length is 0
	Scaling.Callee("*", 1, "Strict/Vector", List(Text) + "scale").returnType is "Strict/Vector"
	let chosen = Chosen(name, count, returnType, names)
	chosen < 0 then MethodEntry(name, List(MemberEntry), "None", List(InstructionEntry)) else methods(chosen)
OverloadSuffix(method MethodEntry) Text
	Scaling.OverloadSuffix(Scaling.methods.Last) is "_scale"
	HelloLogger.OverloadSuffix(MethodEntry.HelloRun) is ""
	mutable count = 0
	for methods
		if (value.Name is method.Name) and (value.Name is not "to") and (value.parameters.Length is method.parameters.Length)
			count = count + 1
	count > 1 then "_" + Text.Combine(method.ParameterNames, "_") else ""
ShortName(typeName Text) Text
	HelloLogger.ShortName("Strict/Bytecode/TypeEntry") is "TypeEntry"
	HelloLogger.ShortName("Strict/List(TypeEntry)") is "List(TypeEntry)"
	HelloLogger.ShortName("Number") is "Number"
	HelloLogger.ShortName("Strict/List(Mutable(Text))") is "List(Text)"
	if typeName.IndexOf("Mutable(") is not -1
		return ShortName(typeName.Replace("Mutable(", "").Substring(0, typeName.Length - 9))
	let open = typeName.IndexOf("(")
	let head = open < 0 then typeName else typeName.Substring(0, open)
	let slash = head.LastIndexOf("/")
	slash < 0 then typeName else typeName.Substring(slash + 1, typeName.Length - slash - 1)
Wrapped Text
	HelloLogger.Wrapped is "Logger"
	Converting.Wrapped is ""
	let short = ShortName(Name)
	if IsBaseName(short) or (short is in ("Logger", "File"))
		return ""
	let changing = Changing
	changing.Length is 1 then ShortName(changing.First.typeName) else ""
IsStruct Boolean
	HelloLogger.IsStruct is false
	CharacterEntry.IsStruct is false
	Converting.IsStruct
	(IsBaseName(ShortName(Name)) is false) and (Wrapped is "")
Changing List(MemberEntry)
	HelloLogger.Changing.Length is 1
	TypeEntry("A", List(MemberEntry) + MemberEntry.SevenMember, List(MethodEntry)).Changing.Length is 0
	for members
		if value.IsConstant is false
			value
HasMemberFrom Boolean
	Rounded.HasMemberFrom
	CharacterEntry.HasMemberFrom is false
	let changing = Changing
	if changing.Length is not 1
		return false
	for methods
		if (value.Name is "from") and (value.parameters.Length is 1)
			if value.parameters.First.typeName is changing.First.typeName
				return true
	false
IsBaseName(short Text) Boolean
	HelloLogger.IsBaseName("Character")
	HelloLogger.IsBaseName("List(Text)")
	HelloLogger.IsBaseName("Shape") is false
	(short is in ("Number", "Text", "Boolean", "Character", "None")) or short.StartsWith("List(")
JustName Text
	TypeEntry("Strict/Process", List(MemberEntry), List(MethodEntry)).JustName is "Process"
	HelloLogger.JustName is "HelloLogger"
	Name.Substring(Name.LastIndexOf("/") + 1, Name.Length - Name.LastIndexOf("/") - 1)
UsedTypes Texts
	TypeEntry("A", List(MemberEntry) + MemberEntry.LoggerMember, List(MethodEntry)).UsedTypes is ("Strict/Logger")
	TypeEntry("A", List(MemberEntry), MethodEntry.Logged).UsedTypes is ("Strict/Number", "Strict/Logger")
	mutable types = List(Mutable(Text))
	for members
		types.Add(value.typeName)
	for methods
		types = types + value.SignatureTypes
	for types
		if value.StartsWith("Strict/")
			value
ConstantSlot(method MethodEntry) Number
	Kept.ConstantSlot(Kept.methods.First) is 0
	HelloLogger.ConstantSlot(HelloLogger.methods.First) is -1
	if method.parameters.Length > 0
		return -1
	for members
		if value.IsConstant and (value.Name is method.Name)
			return index
	-1
Invoked Texts
	TypeEntry("A", List(MemberEntry), MethodEntry.GoRun).Invoked is ("Strict/B.Go")
	Initialized.Invoked is ("Strict/B.Go")
	mutable targets = List(Mutable(Text))
	for methods
		targets = targets + value.Invoked
	for members
		targets = targets + MethodEntry(value.Name, List(MemberEntry), value.typeName, value.initial).Invoked
	targets
Source Text
	CharacterEntry.Source is "Character.strict"
	let folder = Name.IndexOf("/") + 1
	Name.Substring(folder, Name.Length - folder) + ".strict"
