has owner TypeEntry
constant Logged = TypeReference(TypeEntry.HelloLogger)
constant Memberless = TypeReference(TypeEntry("HelloLogger", MemberEntry.LoggerMember, List(MethodEntry)))
constant Changed = TypeReference(TypeEntry(TypeEntry.HelloLogger, methods = MethodEntry(MethodEntry.HelloRun, instructions = (InstructionEntry(InstructionType.Print, "Ho", (-1, 0), 3), InstructionEntry.Return(0)))))
Covers(needed TypeEntry) Boolean
	Logged.Covers(TypeEntry.HelloLogger)
	Logged.Covers(TypeEntry.Converting) is false
	Memberless.Covers(TypeEntry.HelloLogger) is false
	if (owner.Name is not needed.Name) or (owner.members is not needed.members)
		return false
	for needed.methods
		if value is not in owner.methods
			return false
	true
Selection(needed TypeEntry) Numbers
	Logged.Selection(TypeEntry.HelloLogger).Last is 0
	mutable selection = Stamp
	for needed.methods
		selection = selection + owner.methods.Index(value)
	selection
Selected(selection Numbers) TypeEntry
	Logged.Selected(List(Number)).methods.Length is 0
	Logged.Selected(Logged.Selection(TypeEntry.HelloLogger)) is TypeEntry.HelloLogger
	Changed.owner.Bytes.Length is Logged.owner.Bytes.Length
	Changed.Selected(Logged.Selection(TypeEntry.HelloLogger)).Name is ""
	let unknown = TypeEntry("", List(MemberEntry), List(MethodEntry))
	if IsValid(selection) is false
		return unknown
	mutable methods = List(Mutable(MethodEntry))
	for selection.Slice(2, selection.Length - 2)
		methods.Add(owner.methods(value))
	TypeEntry(owner.Name, owner.members, methods)
Stamp Numbers
	let bytes = owner.Bytes
	(bytes.Length, Crc(bytes).Value)
IsValid(selection Numbers) Boolean
	Logged.IsValid(Logged.Selection(TypeEntry.HelloLogger) + 999) is false
	if (selection.Length < 2) or (selection.Slice(0, 2) is not Stamp)
		return false
	for selection.Slice(2, selection.Length - 2)
		if (value < 0) or (value >= owner.methods.Length) or (value.Floor is not value)
			return false
	true
