has entry TypeEntry
constant Sizing = TypeSource(TypeEntry("Strict/Math/Size", List(MemberEntry), List(MethodEntry)))
constant InternalPackages = ("Compiler", "Runtime", "Bytecode", "Expressions")
Root Text
	TypeSource.Root is "."
	let folder = Path(Process.Current.executable.Replace("\\", "/")).PathOnly.text
	File("Any.strict").Exists then "." else File(folder + "/Any.strict").Exists then folder else Path(folder).PathOnly.text
Located(folder Text) Text
	Sizing.Located("./Fonts") is "Math/Size.strict"
	TypeSource(TypeEntry("Strict/List(Number)", List(MemberEntry), List(MethodEntry))).Located("") is "List.strict"
	TypeSource(TypeEntry.HelloLogger).Located("./Examples") is "Examples/HelloLogger.strict"
	TypeSource(TypeEntry("Strict/Examples/Sum", List(MemberEntry), List(MethodEntry))).Located("") is "Examples/Sum.strict"
	let open = entry.Source.IndexOf("(")
	let file = open < 0 then entry.Source else entry.Source.Substring(0, open) + ".strict"
	let relative = folder.StartsWith("./") then folder.Substring(2, folder.Length - 2) else folder
	let local = folder is "" then file else relative + "/" + file
	if File(local).Exists
		return local
	(Root is ".") or (File(Root + "/" + file).Exists is false) then file else Root + "/" + file
Location(methodName Text, file Text) Text
	TypeSource(TypeEntry.CharacterEntry).Location("Lower", "Character.strict") is "Character.Lower in Character.strict"
	TypeEntry.ShortName(entry.Name) + "." + methodName + " in " + file
Relative(path Text) Text
	Sizing.Relative(Directory.Current + "\\Math/Size.strict") is "./Math/Size.strict"
	Sizing.Relative("Q:/elsewhere/A.strict") is "Q:/elsewhere/A.strict"
	let current = Directory.Current.Replace("\\", "/") + "/"
	let slashed = path.Replace("\\", "/")
	let isInside = slashed.Lower.StartsWith(current.Lower)
	isInside then "./" + slashed.Substring(current.Length, slashed.Length - current.Length) else path
Absolute(path Text) Text
	Sizing.Absolute("C:/a/b.strict") is "C:/a/b.strict"
	Sizing.Absolute("./a.strict") is Directory.Current.Replace("\\", "/") + "/a.strict"
	Sizing.Absolute(".") is Directory.Current.Replace("\\", "/")
	let slashed = path.Replace("\\", "/")
	if (slashed.IndexOf(":") is 1) or slashed.StartsWith("/")
		return slashed
	let inside = slashed.StartsWith("./") then slashed.Substring(2, slashed.Length - 2) else slashed
	let current = Directory.Current.Replace("\\", "/")
	inside is "." then current else current + "/" + inside
Cased(path Text) Text
	(Sizing.Cased("strict") is "Strict.strict") and (Sizing.Cased("Examples/sum.STRICT") is "Examples/Sum.strict")
	(Sizing.Cased("Missing") is "Missing") and (Sizing.Cased("Examples") is "Examples")
	let slashed = path.Replace("\\", "/")
	let named = slashed.Lower.EndsWith(".strict") then Path(slashed).RemoveExtension.text else slashed
	let folder = named.IndexOf("/") < 0 then "." else Path(named).PathOnly.text
	let wanted = Path(named).FileName.text.Lower
	for Directory.Files(folder, "*.strict")
		let file = Path(value.Replace("\\", "/")).FileName.text
		if file.Lower is wanted + ".strict"
			return folder is "." then file else folder + "/" + file
	path
Project(path Text) Text
	Sizing.Project("Examples/Sum.strict") is ""
	Directory.Create("Compiler/output/Projected") or Directory.Exists("Compiler/output/Projected")
	Directory.Create("Compiler/output/Projected/.git") or Directory.Exists("Compiler/output/Projected/.git")
	Sizing.Project("Compiler/output/Projected/A/B.strict") is Sizing.Absolute("Compiler/output/Projected")
	Sizing.Project("Compiler/output/Projected") is Sizing.Absolute("Compiler/output/Projected")
	Sizing.Project("Examples") is ""
	let full = Absolute(path)
	mutable folder = Directory.Exists(full) then full else Path(full).PathOnly.text
	for as long as (folder.Length > 3) and (IsProject(folder) is false)
		folder = Path(folder).PathOnly.text
	IsProject(folder) and (folder.Lower is not Directory.Current.Replace("\\", "/").Lower) then folder else ""
IsProject(folder Text) Boolean
	Sizing.IsProject(".")
	Sizing.IsProject("Examples") is false
	Directory.Exists(folder + "/.git") or File(folder + "/.git").Exists
NativeFolder(path Text, root Text) Text
	TypeSource(TypeEntry("Gpu", List(MemberEntry), List(MethodEntry))).NativeFolder("Gpu.strict", ".") is "./native"
	TypeSource(TypeEntry("Strict/P/T", List(MemberEntry), List(MethodEntry))).NativeFolder("A", "C:") is "C:/P/native"
	let source = File(entry.Source).Exists then entry.Source else root + "/" + entry.Source
	let parent = Path(entry.Name.IndexOf("/") < 0 then path else source).PathOnly.text
	(parent is "" then "." else parent) + "/native"
IsSlow(fullName Text, header HeaderTokens) Boolean
	TypeSource.IsSlow("Strict/Compiler/Even", HeaderTokens("Run", "Number"))
	TypeSource.IsSlow("Strict/Even", HeaderTokens("Run", "Slow", "(", "Number", ")"))
	TypeSource.IsSlow("Strict/Even", HeaderTokens("Run", "Number")) is false
	TypeSource.IsSlow("Game/Compiler/Even", HeaderTokens("Run", "Number")) is false
	TypeSource.IsSlow("Strict/Compiler", HeaderTokens("Run", "Number")) is false
	TypeSource.IsSlow("Strict/Math/Size", HeaderTokens("Run", "Number")) is false
	let parts = fullName.Split("/")
	header.ReturnsSlow or ((parts.Length > 2) and (parts(0) is "Strict") and (parts(1) is in InternalPackages))
