has entry TypeEntry
constant Sizing = TypeSource(TypeEntry("Strict/Math/Size", List(MemberEntry), List(MethodEntry)))
Root Text
	TypeSource.Root is "."
	File("Any.strict").Exists then "." else Path(Process.Current.executable.Replace("\\", "/")).PathOnly.text
Located(folder Text) Text
	Sizing.Located("./Fonts") is "Math/Size.strict"
	TypeSource(TypeEntry("Strict/List(Number)", List(MemberEntry), List(MethodEntry))).Located("") is "List.strict"
	TypeSource(TypeEntry.HelloLogger).Located("./Examples") is "Examples/HelloLogger.strict"
	TypeSource(TypeEntry("Strict/Examples/Sum", List(MemberEntry), List(MethodEntry))).Located("") is "Examples/Sum.strict"
	let open = entry.Source.IndexOf("(")
	let file = open < 0 then entry.Source else entry.Source.Substring(0, open) + ".strict"
	let local = (folder.StartsWith("./") then folder.Substring(2, folder.Length - 2) else folder) + "/" + file
	if (folder is not "") and File(local).Exists
		return local
	(Root is ".") or (File(Root + "/" + file).Exists is false) then file else Root + "/" + file
Location(methodName Text) Text
	TypeSource(TypeEntry.CharacterEntry).Location("Lower") is "Character.Lower in Character.strict"
	TypeEntry.ShortName(entry.Name) + "." + methodName + " in " + Located("")
NativeFolder(path Text, root Text) Text
	TypeSource(TypeEntry("Gpu", List(MemberEntry), List(MethodEntry))).NativeFolder("Gpu.strict", ".") is "./native"
	TypeSource(TypeEntry("Strict/P/T", List(MemberEntry), List(MethodEntry))).NativeFolder("A", "C:") is "C:/P/native"
	let source = File(entry.Source).Exists then entry.Source else root + "/" + entry.Source
	let file = entry.Name.IndexOf("/") < 0 then path else source
	let parent = Path(file).PathOnly.text
	(parent is "" then "." else parent) + "/native"