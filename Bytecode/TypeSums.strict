has methods MethodCodegen
constant PairTypes = KnownTypes("Pair", Scope(("x", "y"), ("Number", "Number")), Scope("+", "Pair"), KnownTypes.NoMembers)
constant Paired = TypeSums(MethodCodegen(ValueCodegen(TypeInference(PairTypes, CallTarget.NoScopes), KnownTypes.NoMembers, CallTarget.Plain)))
constant Pairs = CodeBlock.Empty.Declare("forResult", "Pair").Declare("forValue", "Pair").Load(InstructionEntry.LoadNumber(0, 1))
Start(block CodeBlock, type Text) CodeBlock
	Paired.Start(CodeBlock.Empty, "Pair").instructions(0) is InstructionEntry.LoadNumber(0, 0)
	Paired.Start(CodeBlock.Empty, "Pair").scope.TypeOf("forValue") is "Pair"
	Text.Combine(Paired.Start(CodeBlock.Empty, "Pair").instructions.Last.texts) is "forResult"
	zeros = Zeros(methods.values.inference.types.MembersOf(type).names)
	methods.values.Expression(SyntaxNode("Call", type, zeros), block).Stored("forResult").Declare("forValue", type)
Zeros(names Texts) SyntaxNodes
	Paired.Zeros(("x", "y")).Length is 2
	Paired.Zeros(("x", "y"))(1) to Text is "0"
	for names
		SyntaxNode("Number", "0")
Add(block CodeBlock) CodeBlock
	Text.Combine(Paired.Add(Pairs).instructions.Last.texts) is "forResult"
	Paired.Add(Pairs).instructions.Length is 9
	Text.Combine(Paired.Add(Pairs).instructions(1).texts) is "forValue"
	Text.Combine(Paired.Add(Pairs).instructions(6).texts) is "forValue"
	Paired.Add(Pairs).instructions(3).texts(1) is "+"
	sum = SyntaxNode("MethodCall", "+", (SyntaxNode("Identifier", "forResult"), SyntaxNode("Identifier", "forValue")))
	ErrorCodegen(methods.values).Handle(sum, block.Stored("forValue")).Stored("forResult")
