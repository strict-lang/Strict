has inference Expressions/TypeInference
has methods Expressions/Scope
has target CallTarget
constant NoNode = SyntaxNode("Identifier", "x")
constant NewGreeter = SyntaxNode("Call", "Greeter")
constant NoTypes = TypeInference(CallTarget.Plain.types)
constant Plain = ValueCodegen(NoTypes, Scope(("Greet", "Run"), ("Text", "None")), CallTarget.Plain)
Expression(node SyntaxNode, block CodeBlock) CodeBlock
	Plain.Expression(SyntaxNode("Identifier", "a"), CodeBlock.Empty).register is 1
	Plain.Expression(SyntaxNode("Binary", "+", (NoNode, NoNode)), CodeBlock.Empty).Result is 2
	if node.Kind is in ("Number", "Text", "Boolean")
		return Literal(node, block)
	if node.Kind is "Identifier"
		return Variable(node, block)
	if (node.Kind is in ("Call", "Member", "MethodCall", "Not")) or (node.text is "to")
		return Call(node, block)
	let left = Expression(node.children(0), block)
	let right = Expression(node.children(1), left)
	right.Load(InstructionEntry.Binary(OperatorType(node.text), (left.Result, right.Result, right.register)))
Variable(node SyntaxNode, block CodeBlock) CodeBlock
	Plain.Variable(SyntaxNode("Identifier", "a"), CodeBlock.Empty).instructions(0).texts is ("a")
	Plain.Variable(SyntaxNode("Identifier", "Greet"), CodeBlock.Empty).instructions(0).kind is InstructionType.Invoke
	if (block.scope.TypeOf(node.text) is "") and target.Header(node.text).tokens.Length > 0
		return Invoke(node, block, -1, TypeOf(node, block))
	block.Load(InstructionEntry.Named(InstructionType.LoadVariableToRegister, block.register, node.text))
Literal(node SyntaxNode, block CodeBlock) CodeBlock
	Plain.Literal(SyntaxNode("Number", "7"), CodeBlock.Empty).instructions(0).payload is (0, 1, 7)
	Plain.Literal(SyntaxNode("Text", "\"a\""), CodeBlock.Empty).instructions(0).texts is ("a")
	Plain.Literal(SyntaxNode("Boolean", "true"), CodeBlock.Empty).instructions(0).payload is (0, 5, 1)
	if node.Kind is "Number"
		return block.Load(InstructionEntry.LoadNumber(block.register, node.text to Number))
	if node.Kind is "Text"
		return block.Load(InstructionEntry.LoadText(block.register, node.Unquoted))
	block.Load(InstructionEntry.LoadBoolean(block.register, node.text is "true"))
Call(node SyntaxNode, block CodeBlock) CodeBlock
	Plain.Call(SyntaxNode("Call", "Greeter", SyntaxNode("Text", "\"a\"")), CodeBlock.Empty).Result is 1
	Plain.Call(SyntaxNode("Member", "Greet", NoNode), CodeBlock.Empty).instructions(1).payload.Last is 0
	Plain.Call(SyntaxNode("Binary", "to", (NoNode, SyntaxNode("Identifier", "Text"))), CodeBlock.Empty).Result is 1
	Plain.Call(SyntaxNode("Member", "text", NewGreeter), CodeBlock.Empty).instructions(1).kind is InstructionType.FieldLoad
	if (node.Kind is "Call") or IsTypeName(node.children(0), block)
		return Invoke(node, block, -1, TypeOf(node, block))
	let instance = Expression(node.children(0), block)
	if (node.Kind is "Member") and target.IsMember(TypeOf(node.children(0), block), node.text)
		return instance.Load(InstructionEntry(InstructionType.FieldLoad, node.text, (instance.register, instance.Result, -1)))
	let method = node.Kind is "Not" then "not" else "to"
	let call = node.Kind is in ("Binary", "Not") then SyntaxNode("Member", method, node.children(0)) else node
	Invoke(call, instance, instance.Result, TypeOf(node, block))
IsTypeName(node SyntaxNode, block CodeBlock) Boolean
	Plain.IsTypeName(SyntaxNode("Identifier", "B"), CodeBlock.Empty) is true
	Plain.IsTypeName(NoNode, CodeBlock.Empty) is false
	(node.Kind is "Identifier") and (block.scope.TypeOf(node.text) is "") and inference.types.IsKnown(node.text)
Invoke(node SyntaxNode, block CodeBlock, instance Number, returnType Text) CodeBlock
	Plain.Invoke(SyntaxNode("Call", "Greet"), CodeBlock.Empty, -1, "Text").instructions(0).texts.Last is "Strict/Text"
	mutable result = block
	mutable arguments = List(Mutable(Number))
	let first = node.Kind is in ("Member", "MethodCall") then 1 else 0
	for Range(first, node.children.Length)
		result = Expression(node.children(value), result)
		arguments.Add(result.Result)
	let owner = Owner(node, block)
	let signature = target.Signature(node.text, owner, returnType)
	result.Load(InstructionEntry.Invoke(result.register, signature, arguments, instance))
Owner(node SyntaxNode, block CodeBlock) Text
	Plain.Owner(SyntaxNode("Call", "Greet"), CodeBlock.Empty) is "Greeter"
	if node.Kind is in ("Member", "MethodCall")
		return TypeOf(node.children(0), block)
	inference.types.IsKnown(node.text) then node.text else target.TypeName
Condition(node SyntaxNode, block CodeBlock) CodeBlock
	Plain.Condition(SyntaxNode("Boolean", "true"), CodeBlock.Empty).nextId is 1
	Plain.Condition(SyntaxNode("Binary", ">", (NoNode, NoNode)), CodeBlock.Empty).instructions.Length is 4
	let isComparison = (node.Kind is "Binary") and (node.text is in ("is", "is not", "<", ">"))
	let operand = isComparison then node.children(0) else node
	let left = Expression(operand, block)
	let truth = InstructionEntry.LoadBoolean(left.register, true)
	let right = isComparison then Expression(node.children(1), left) else left.Load(truth)
	let type = isComparison then OperatorType(node.text) else InstructionType.Equal
	let compared = right.Add(InstructionEntry.Binary(type, (left.Result, right.Result)))
	compared.Add(InstructionEntry.Jump(InstructionType.JumpToIdIfFalse, block.nextId)).WithNextId
OperatorType(operator Text) Number
	Plain.OperatorType("*") is InstructionType.Multiply
	Plain.OperatorType("is not") is InstructionType.NotEqual
	constant arithmetic = ("+", "-", "*", "/", "%", "^")
	constant comparisons = ("is", "is not", "<", ">")
	constant UnsupportedOperator = Error
	if operator is in arithmetic
		return InstructionType.Add + arithmetic.Index(operator)
	operator is in comparisons then InstructionType.Equal + comparisons.Index(operator) else UnsupportedOperator
TypeOf(node SyntaxNode, block CodeBlock) Text
	Plain.TypeOf(SyntaxNode("Number", "1"), CodeBlock.Empty) is "Number"
	inference.TypeOf(node, block.scope, methods)
ElementType(iterated Text) Text
	Plain.ElementType("Number") is "Number"
	iterated is "Number" then iterated else inference.types.ElementType(iterated)