has inference Expressions/TypeInference
has methods Expressions/Scope
has target CallTarget
constant NoNode = SyntaxNode("Identifier", "x")
constant NewGreeter = SyntaxNode("Call", "Greeter")
constant GreeterText = SyntaxNode("Member", "text", NewGreeter)
constant One = SyntaxNode("Number", "1")
constant Hi = SyntaxNode("Text", "\"Hi\"")
constant Ones = SyntaxNode("List", "", (One, One))
constant ToText = SyntaxNode("Binary", "to", (NoNode, SyntaxNode("Identifier", "Text")))
constant AddOne = SyntaxNode("MethodCall", "Add", (SyntaxNode("Identifier", "values"), One))
constant RemoveOne = SyntaxNode("MethodCall", "Remove", (SyntaxNode("Identifier", "values"), One))
constant NoTypes = TypeInference(CallTarget.Plain.types, CallTarget.NoScopes)
constant OwnA = ValueCodegen(NoTypes, Scope(("A", "limits"), ("Text", "Numbers")), CallTarget.Plain)
constant Plain = ValueCodegen(NoTypes, Scope(("Greet", "Run"), ("Text", "None")), CallTarget.Plain)
Expression(node SyntaxNode, block CodeBlock) CodeBlock
	Plain.Expression(SyntaxNode("Identifier", "a"), CodeBlock.Empty).register is 1
	Plain.Expression(SyntaxNode("Binary", "+", (NoNode, NoNode)), CodeBlock.Empty).Result is 2
	Plain.Expression(SyntaxNode("Binary", "+", (One, One)), CodeBlock.Empty).instructions(0).payload is (0, 1, 2)
	Plain.Expression(SyntaxNode("Binary", ">=", (One, NoNode)), CodeBlock.Empty).instructions.Length is 5
	Plain.Expression(SyntaxNode("Binary", "and", (NoNode, NoNode)), CodeBlock.Empty).instructions.Length is 9
	Plain.Expression(SyntaxNode("Identifier", "Error"), CodeBlock.Empty).instructions.Last.kind is InstructionType.Invoke
	ErrorCodegen(value).Checked(node, block)
Variable(node SyntaxNode, block CodeBlock) CodeBlock
	Plain.Variable(SyntaxNode("Identifier", "a"), CodeBlock.Empty).instructions(0).texts is ("a")
	Plain.Variable(SyntaxNode("Identifier", "Greet"), CodeBlock.Empty).instructions(0).kind is InstructionType.Invoke
	Plain.Variable(SyntaxNode("Identifier", "Numbers"), CodeBlock.Empty).instructions(0).payload is (0, 6, -1, 0)
	let isFree = block.scope.TypeOf(node.text) is ""
	let owner = target.ImplicitOwner(node.text, block.scope)
	if isFree and owner is not ""
		return InstanceCall(SyntaxNode("Member", node.text, SyntaxNode("Identifier", owner)), block)
	if IsMethodCall(node, block) or isFree and (node.text is "Error")
		return Invoke(node, block, -1, TypeOf(node, block))
	if isFree and inference.types.IsPlural(node.text)
		return Elements.Empty(node.text, block)
	block.Load(InstructionEntry.Named(InstructionType.LoadVariableToRegister, block.register, node.text))
Leaf(node SyntaxNode, block CodeBlock) CodeBlock
	Plain.Leaf(SyntaxNode("Number", "7"), CodeBlock.Empty).instructions(0).payload is (0, 1, 7)
	Plain.Leaf(SyntaxNode("Text", "\"a\""), CodeBlock.Empty).instructions(0).texts is ("a")
	Plain.Leaf(SyntaxNode("Boolean", "true"), CodeBlock.Empty).instructions(0).payload is (0, 5, 1)
	if node.Kind is "Identifier"
		return Variable(node, block)
	if node.Kind is "List"
		return Elements.Of(node, block)
	if node.Kind is "Number"
		return block.Load(InstructionEntry.LoadNumber(block.register, node.text to Number))
	if node.Kind is "Text"
		return block.Load(InstructionEntry.LoadText(block.register, node.Unquoted))
	block.Load(InstructionEntry.LoadBoolean(block.register, node.text is "true"))
Call(node SyntaxNode, block CodeBlock) CodeBlock
	Plain.Call(SyntaxNode("Call", "Greeter", SyntaxNode("Text", "\"a\"")), CodeBlock.Empty).Result is 1
	Plain.Call(SyntaxNode("Call", "List", One), CodeBlock.Empty).instructions(0).payload is (0, 6, -1, 0)
	Plain.Call(SyntaxNode("Call", "Dictionary", One), CodeBlock.Empty).instructions.Last.kind is not InstructionType.Invoke
	if (node.Kind is "Call") and (node.text is in ("List", "Dictionary", "Mutable"))
		return Constructed(node, block)
	if IndexCodegen(value).IsIndexing(node, block)
		return IndexCodegen(value).Indexed(node, block)
	if (node.Kind is "Call") or IsTypeName(node.children(0), block)
		return Replacing(node, block)
	let first = node.children(0)
	let isListVariable = (first.Kind is "Identifier") and inference.types.IsPlural(TypeOf(first, block))
	(node.text is in ("Add", "Remove")) and isListVariable then Elements.Added(node, block) else InstanceCall(node, block)
Constructed(node SyntaxNode, block CodeBlock) CodeBlock
	Plain.Constructed(SyntaxNode("Call", "List", One), CodeBlock.Empty).instructions(0).payload is (0, 6, -1, 0)
	Plain.Constructed(SyntaxNode("Call", "Dictionary"), CodeBlock.Empty).instructions(0).payload is (0, 6, -1, 0)
	Plain.Constructed(SyntaxNode("Call", "Mutable", One), CodeBlock.Empty).instructions(0).payload is (0, 1, 1)
	if node.text is "Mutable"
		return ErrorCodegen(value).Handled(node.children(0), block)
	let isEmpty = (node.text is "List") or (node.children.Length is 0) or IsTypeName(node.children(0), block)
	isEmpty then Elements.Empty(TypeOf(node, block), block) else Elements.Of(SyntaxNode("List", "", node.children), block)
InstanceCall(node SyntaxNode, block CodeBlock) CodeBlock
	Plain.InstanceCall(SyntaxNode("Member", "Greet", NoNode), CodeBlock.Empty).instructions(1).payload.Last is 0
	Plain.InstanceCall(ToText, CodeBlock.Empty).Result is 1
	Plain.InstanceCall(GreeterText, CodeBlock.Empty).instructions(2).kind is InstructionType.FieldLoad
	Plain.InstanceCall(SyntaxParser("outer", ".", "index").Parse, CodeBlock.Empty).instructions(0).texts is ("outer.index")
	if (node.Kind is "Member") and (node.text is "index") and (node.children(0).text is "outer")
		return block.Load(InstructionEntry.Named(InstructionType.LoadVariableToRegister, block.register, "outer.index"))
	let instance = Expression(node.children(0), block)
	if (node.Kind is "Member") and (IsMethodCall(node, block) is false)
		return Field(node.text, TypeOf(node.children(0), block), instance, instance.Result)
	let method = node.Kind is "Not" then "not" else "to"
	let call = node.Kind is in ("Binary", "Not") then SyntaxNode("Member", method, node.children(0)) else node
	Invoke(call, instance, instance.Result, TypeOf(node, block))
Field(member Text, owner Text, block CodeBlock, instance Number) CodeBlock
	Plain.InstanceCall(GreeterText, CodeBlock.Empty).instructions(2).texts is ("text", "Greeter")
	block.Load(InstructionEntry(InstructionType.FieldLoad, (member, owner), (block.register, instance, -1, -2)))
IsMethodCall(node SyntaxNode, block CodeBlock) Boolean
	Plain.IsMethodCall(SyntaxNode("Identifier", "Greet"), CodeBlock.Empty) is true
	Plain.IsMethodCall(SyntaxNode("Member", "Greet", NewGreeter), CodeBlock.Empty) is true
	Plain.IsMethodCall(GreeterText, CodeBlock.Empty) is false
	Plain.IsMethodCall(SyntaxNode("Call", "text", One), CodeBlock.Empty) is false
	Plain.IsMethodCall(ToText, CodeBlock.Empty) is false
	if node.Kind is "Binary"
		return node.text is not in ("to", "then", "else")
	if node.Kind is "Identifier"
		return (block.scope.TypeOf(node.text) is "") and target.Header(node.text).tokens.Length > 0
	if node.Kind is "Member"
		return (node.text is not "value") and (target.IsMember(TypeOf(node.children(0), block), node.text) is false)
	(node.Kind is in ("Call", "MethodCall")) and (IndexCodegen(value).IsIndexing(node, block) is false)
Replacing(node SyntaxNode, block CodeBlock) CodeBlock
	Plain.Replacing(TypeCodegen.Rebuilt, CodeBlock.Empty).instructions(3).texts is ("replaced0")
	let replaced = ConversionCodegen(value).Replaced(node)
	let instance = node.children.Length > 0 then node.children(0) else node
	if (replaced is node) or (instance.Kind is "Identifier")
		return ErrorCodegen(value).Validated(node, block, Invoke(replaced, block, -1, TypeOf(node, block)))
	let name = "replaced" + block.nextId
	let stored = Expression(instance, block).Stored(name).At(block.register).Declare(name, TypeOf(instance, block))
	mutable children = node.children
	children(0) = SyntaxNode("Identifier", name)
	let renamed = ConversionCodegen(value).Replaced(SyntaxNode(node.Kind, node.text, children, node.line))
	ErrorCodegen(value).Validated(node, block, Invoke(renamed, stored.WithNextId, -1, TypeOf(node, block)))
IsTypeName(node SyntaxNode, block CodeBlock) Boolean
	Plain.IsTypeName(SyntaxNode("Identifier", "B"), CodeBlock.Empty) is true
	Plain.IsTypeName(NoNode, CodeBlock.Empty) is false
	Plain.IsTypeName(SyntaxNode("Type", "Run"), CodeBlock.Empty) is true
	if node.Kind is "Type"
		return true
	(node.Kind is "Identifier") and (block.scope.TypeOf(node.text) is "") and inference.types.IsKnown(node.text)
Invoke(node SyntaxNode, block CodeBlock, instance Number, returnType Text) CodeBlock
	Plain.Invoke(SyntaxNode("Call", "Greet"), CodeBlock.Empty, -1, "Text").instructions(0).texts.Last is "Strict/Text"
	let owner = Owner(node, block)
	let argumentTypes = ConversionCodegen(value).ArgumentTypes(node, owner, block)
	let signature = target.Signature(node.text, owner, returnType, argumentTypes)
	let call = Elements.Grouped(target.WithErrorArguments(node, block.scope), ArgumentStart(node), signature.Length - 3)
	let parameters = target.ParameterTypes(node.text, owner, argumentTypes)
	mutable result = block
	mutable arguments = List(Mutable(Number))
	for Range(ArgumentStart(node), call.children.Length)
		result = Elements.Argument(call.children(value), value - ArgumentStart(node), parameters, result)
		arguments.Add(result.Result)
	result.Load(InstructionEntry.Invoke(result.register, signature, arguments, instance))
ArgumentStart(node SyntaxNode) Number
	Plain.ArgumentStart(GreeterText) is 1
	node.Kind is in ("Member", "MethodCall") then 1 else 0
Owner(node SyntaxNode, block CodeBlock) Text
	Plain.Owner(SyntaxNode("Call", "Greet"), CodeBlock.Empty) is "Greeter"
	OwnA.Owner(SyntaxNode("Call", "A"), CodeBlock.Empty) is "Greeter"
	if node.Kind is in ("Member", "MethodCall")
		return TypeOf(node.children(0), block)
	let isOwnMethod = methods.TypeOf(node.text) is not ""
	let instance = TypeOf(node, block)
	if inference.types.IsKnown(node.text) and (not isOwnMethod)
		return instance.StartsWith(node.text + "(") then instance else node.text
	target.TypeName
Elements ListCodegen
	Plain.Elements.values.target.TypeName is "Greeter"
	ListCodegen(ValueCodegen(inference, methods, target))
TypeOf(node SyntaxNode, block CodeBlock) Text
	Plain.TypeOf(SyntaxNode("Number", "1"), CodeBlock.Empty) is "Number"
	inference.TypeOf(node, block.scope, methods)