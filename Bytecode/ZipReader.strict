has bytes Numbers
constant LocalHeader = 6.7324752e7
constant EndHeader = 1.01010256e8
constant LocalHeaderSize = 30
constant EndRecordSize = 22
constant SizeOffset = 18
constant NameLengthOffset = 26
constant ExtraLengthOffset = 28
constant Sample = ZipReader(ZipWriter.Sample.Bytes)
Entries List(ZipEntry)
	Sample.Entries is ZipWriter.Sample.entries
	ZipReader(List(Number)).Entries.Length is 0
	mutable entries = List(Mutable(ZipEntry))
	mutable position = 0
	for bytes.Length
		if IsEntry(position) is false
			return entries
		entries.Add(Entry(position))
		position = End(position)
	entries
IsEntry(position Number) Boolean
	Sample.IsEntry(0)
	Sample.IsEntry(1) is false
	ZipReader(Sample.Content(0, 60)).IsEntry(0) is false
	ZipReader((80, 75, 3, 4) + Sample.Content(Sample.bytes.Length - EndRecordSize, EndRecordSize)).IsEntry(0) is false
	if position + LocalHeaderSize > bytes.Length
		return false
	(Read(bytes.Length - EndRecordSize, 4) is EndHeader) and (Read(position, 4) is LocalHeader)
Entry(position Number) ZipEntry
	Sample.Entry(0) is ZipWriter.Sample.entries.First
	let size = Read(position + SizeOffset, 4)
	let name = ByteEncoder(bytes).Spelled(position + LocalHeaderSize, Read(position + NameLengthOffset, 2))
	ZipEntry(name, Content(End(position) - size, size))
End(position Number) Number
	Sample.End(0) is 33
	let lengths = Read(position + NameLengthOffset, 2) + Read(position + ExtraLengthOffset, 2)
	position + LocalHeaderSize + lengths + Read(position + SizeOffset, 4)
Read(start Number, size Number) Number
	ZipReader(1, 2).Read(0, 2) is 513
	mutable result = 0
	for size
		result = result + bytes(start + index) * Byte.Values ^ index
	result
Content(start Number, size Number) Numbers
	ZipReader(1, 2, 3).Content(1, 2) is (2, 3)
	for Range(start, start + size)
		bytes(value)
Copied(file Bytes, start Number, size Number) Numbers
	ZipReader.Copied(List(Byte) + Byte(7) + Byte(8), 1, 1) is (8)
	for Range(start, start + size)
		file(value).number