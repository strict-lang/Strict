has number
constant zeroCharacter = 48
constant NewLine = Character(10)
constant Tab = Character(9)
constant LowercaseA = 97
constant LowercaseZ = 122
constant UppercaseA = 65
constant UppercaseZ = 90
constant CaseOffset = 32
from(text)
	Character("b") is "b"
	Character(9) is Tab
	7 to Character is "7"
	Character("ab") is Error
	Character("b") is in ("a", "b")
	text.Length is 1 then text(0) else Error
Code Text
	Character("a").Code is "Character(\"a\")"
	"Character(" + (value to Text).Code + ")"
to Text
	Character("a") to Text is "a"
	"" + value
+(other) Text
	Character("1") + Character("2") is "12"
	value to Text + other
to Number
	Character("3") to Number is 3
	constant notANumber = Error
	Character("A") to Number is notANumber
	let result = number - zeroCharacter
	result is in Range(0, 10) then result else notANumber(value)
Upper Character
	Character("a").Upper is "A"
	Character("A").Upper is "A"
	Character("z").Upper is "Z"
	Character("{").Upper is "{"
	if number is in Range(LowercaseA, LowercaseZ + 1)
		return Character(number - CaseOffset)
	value
Lower Character
	Character("A").Lower is "a"
	Character("a").Lower is "a"
	Character("Z").Lower is "z"
	Character("[").Lower is "["
	if number is in Range(UppercaseA, UppercaseZ + 1)
		return Character(number + CaseOffset)
	value