constant BuildWait = 90
constant FirstTraceLines = 3
constant LastTraceLines = 3
constant LongTrace = "Error: A\n\t1\n\t2\n\t3\n\t4\n\t5\n\t6\n\tat Strict.Logged in Strict.strict:line 66"
Run(arguments Texts) Number
	resident = Resident(Path(Process.Current.executable).PathOnly.text)
	command = arguments.Length > 0 then arguments(0) else ""
	if command is in ("coordinator", "serve", "linked", "status")
		Host(command, arguments, resident)
		return 0
	rebuilt = SelfBuild(resident.root, Process.Current.executable).Rebuilt(arguments)
	if rebuilt is not SelfBuild.Current
		return rebuilt
	passed = CommandLimit(Scripted.Pack(arguments)).Armed
	forwarded = Forwarding(resident.root).Forward(passed)
	forwarded is Forwarding.Ended then 1 else forwarded is Error then Log(passed).code else forwarded
Host(command Text, arguments Texts, resident Resident) slow
	if command is "coordinator"
		mutable coordinator = Coordinator
		return coordinator.Serve
	if command is "serve"
		return Serve(arguments.Length > 1 then Resident(resident.root, arguments(1)) else resident)
	if command is "status"
		return Coordinator.Report
	rest = arguments.Slice(1, arguments.Length - 1)
	NativeChunks(rest(2)).Save(rest(0), rest(1), rest.Slice(3, rest.Length - 3))
Serve(resident Resident) slow
	server = resident.Opened
	if server is Error
		return server
	built = File(Process.Current.executable).Modified
	mutable socket = resident.Accept(server, built)
	mutable answer = Answer(0, Dictionary(Text, TypeEntry))
	for as long as socket is not Error
		request = resident.ReadRequest(socket)
		arguments = resident.Arguments(request)
		answer = Reply(resident, request, socket, arguments, Resident.Variables, answer)
		socket = arguments is (Resident.Stopping) then Resident.Unaccepted else resident.Accept(server, built)
	resident.Close(server)
Reply(resident Resident, request Text, socket Number, arguments Texts, variables Text, last Answer) Answer slow
	isStopping = arguments is (Resident.Stopping)
	isAnswered = isStopping is false and resident.IsCurrent(request, variables)
	started = isAnswered and Scripted.IsRun(arguments) is false then Time.Now else 0
	answer = isAnswered then GenerateAnswer(resident, request, socket, arguments, last) else last
	stamped = isAnswered and started > 0 then answer.Stamped(started) else answer
	resident.FreePort(request)
	code = isAnswered then stamped.code else (isStopping then 0 else Resident.Refused)
	logger.Log(Time(Time.Now).Iso8601 + " " + Text.Combine(arguments, " ") + " exit " + code)
	resident.End(socket, code)
	stamped
GenerateAnswer(resident Resident, request Text, socket Number, arguments Texts, last Answer) Answer slow
	home = Directory.Current
	folder = resident.Folder(request)
	isMoved = folder is not home
	if isMoved
		Directory.Change(folder)
	Socket.Output(socket)
	isCode = Scripted.IsRun(arguments)
	answer = Log(CommandLimit(arguments).Armed, isCode then last else Answer(last, known = last.Fresh(folder)))
	TestBudget.Limit(0, "")
	Socket.Output(0)
	if isMoved
		Directory.Change(home)
	isCode then answer else Answer(answer, folder = folder).Carried(last)
Log(arguments Texts, last = Answer(0, Dictionary(Text, TypeEntry))) Answer slow
	isCode = Scripted.IsRun(arguments)
	answer = isCode then GenerateCodeAnswer(arguments, last) else RunForAnswer(arguments, last.known, last.inferred)
	if answer is Error
		logger.Log(Shorten(answer to Text))
		return Answer(1, last.known, last.folder, last.stamps, last.files, last.Types, last.script)
	answer
GenerateCodeAnswer(arguments Texts, last Answer) Answer slow
	if Scripted.IsCode(arguments)
		return Scripted(arguments(2)).RanWith(arguments, TypeSource.Root, last)
	given = arguments(1)
	path = File(given).Exists then given else TypeSource.Case(given)
	if File(path).Exists is false
		logger.Log(given + " not found")
		return Answer(2, last.known, last.folder, last.stamps, last.files, last.Types, last.script)
	Scripted(File(path).ReadText).RanWith(arguments, TypeSource.Root, last, path)
Shorten(trace Text) Text
	Strict.Shorten("Error: A\n\t1") is "Error: A\n\t1"
	Strict.Shorten(LongTrace) is "Error: A\n\t1\n\t2\n\t... (skipped 1 lines)\n\t4\n\t5\n\t6"
	logged = trace.LastIndexOf("\n\tat Strict.Logged ")
	lines = (logged < 0 then trace else trace.Substring(0, logged)).Split("\n")
	if lines.Length <= FirstTraceLines + LastTraceLines
		return Text.Combine(lines, "\n")
	gap = "\t... (skipped " + (lines.Length - FirstTraceLines - LastTraceLines) + " lines)"
	Text.Combine(lines.Slice(0, FirstTraceLines) + gap + lines.Slice(lines.Length - LastTraceLines, LastTraceLines), "\n")
RunForAnswer(arguments Texts, known = Dictionary(Text, TypeEntry), inferred = InferenceCache.None) Answer slow
	folder = Directory.Current
	head = arguments.Length > 0 then arguments(0) else ""
	given = head is in Command.Informing then List(Text) + head else Command.Project(Command.InsertMainFile(arguments))
	command = given.Length > 0 then given(0) else "help"
	rest = Command.Clean(command, Command.Root(command is in Command.Commands then Command.Rest(given) else given))
	message = Command.Message(command, rest)
	if message is not ""
		logger.Log(message)
		return Answer(command is in Command.Informing then 0 else 2, known)
	if command is in ("build", "check", "update", "format", "suggest")
		return command is "build" then Answer(Command.Native(command, rest), known) else Command.Tool(command, rest, known)
	command is "test" then Examine(rest, known, inferred) else Answer(Launch(rest, folder), known)
Examine(rest Texts, known Dictionary(Text, TypeEntry), inferred InferenceCache) Answer slow
	"nightly" is in rest then Answer(Nightly(rest), known) else Testing(rest, known, inferred)
Nightly(rest Texts) Number slow
	if File(rest(0)).Exists is false
		return Folders.Nightly(rest(0), rest(1)) + Command.Native("test", (rest(0), rest(1), "native"))
	unit = Execute.Serve(rest(0), rest(1), true).code
	unit > 0 then unit else Execute("*").Serve(rest(0), rest(1), true).code
Testing(rest Texts, known = Dictionary(Text, TypeEntry), inferred = InferenceCache.None) Answer slow
	Strict.Testing(("Missing.strict", ".")).code is 1
	request = TestRequest(rest)
	if request.Message is not ""
		logger.Log(request.Message)
		return Answer(2, known)
	if request.Option is "-"
		File(FileCompiler.Normalize(rest(0))).InMemory(Process.Input)
	if request.Option is in ("values", "trace", "profile", "sampled")
		return Answer(Trace(request, rest), known)
	execute = request.Executing(known, inferred)
	if request.Option is in ("lines", "native")
		return Answer(Command.Native("test", rest), known)
	execute.Serve(rest(0), rest(1))
Launch(rest Texts, folder Text) Number slow
	if NativeBuild.IsProgram(rest(0)) is false
		return Command.Native("test", (rest(0), rest(1), "native"))
	base = NativeBuild.Output(rest(0), true)
	extension = Toolchain(Platform.Current, rest(1)).Extension
	cache = NativeCache("build", (rest(0), rest(1)))
	fresh = cache.IsCurrent then BuildOutput.Fresh(base, extension, List(Text)) else ""
	if fresh is ""
		tested = Retest(rest)
		if tested is not 0
			return tested
	Start(rest, folder, fresh)
Retest(rest Texts) Number slow
	quietUntil = Process.Elapsed + Command.QuietSeconds
	tested = Execute("", quietUntil = quietUntil).Serve(rest(0), rest(1)).code
	if tested is 0 and Process.Elapsed >= quietUntil
		logger.Log(Execute.Summary(0, rest(0)))
	tested
Compile(rest Texts, fresh Text) Number slow
	if fresh is not ""
		return 0
	NativeCache("build", (rest(0), rest(1))).IsCurrent then 0 else Command.Native("build", (rest(0), rest(1)))
Start(rest Texts, folder Text, fresh Text) Number slow
	base = NativeBuild.Output(rest(0), true)
	tools = Toolchain(Platform.Current, rest(1))
	built = Compile(rest, fresh)
	if built is not 0
		return built
	if fresh is not ""
		logger.Log("Up to date: " + fresh)
	target = TypeSource.Absolute(fresh is "" then tools.Executable(base) else fresh)
	Directory.Change(folder)
	Process(target).Start(Command.Join(rest.Slice(2, rest.Length - 2)).Trim)
Test(text Text) Text slow
	Trial(text).Ran
Trace(request TestRequest, rest Texts) Number slow
	trace = ValueTrace(request.Selection)
	profile = Profile(request.Selection)
	if request.Option is in ("profile", "sampled")
		return request.Option is "profile" then profile.Run(rest(0), rest(1)) else profile.Sample(rest(0), rest(1))
	request.Option is "values" then trace.Run(rest(0), rest(1)) else trace.Trace(rest(0), rest(1))
