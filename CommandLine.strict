has arguments Texts
has names Texts
constant Sample = CommandLine(("--quality", "fastest", "--lora", "a.safetensors:0.8", "--lora=b", "--json_output", "--count", "8", "--seed", "-3"), ("quality", "lora", "jsonOutput", "count", "seed", "width"))
constant Choices = ("best", "fastest")
constant Slow = CommandLine(("--quality", "slow"), List(Text) + "quality")
constant Flags = CommandLine(List(Text), ("count", "jsonOutput"))
Checked CommandLine
	Sample.Checked is Sample
	CommandLine(List(Text) + "--colour", List(Text) + "color").Checked is Error("UnknownOption:--colour")
	for arguments
		if value.StartsWith("--") and (value.Split("=").First is not in Spellings)
			return Error("UnknownOption:" + value.Split("=").First)
	CommandLine(arguments, names)
Option(name Text, default Text) Text
	Sample.Option("quality", "best") is "fastest"
	Sample.Option("width", "720") is "720"
	Repeated(name, List(Text) + default).Last
Numeric(name Text, default Number) Number
	Sample.Numeric("count", 1) is 8
	Sample.Numeric("seed", 0) is -3
	Sample.Numeric("width", 720) is 720
	CommandLine(("--count", "many"), List(Text) + "count").Numeric("count", 1) is Error("InvalidNumber:--count")
	let text = Option(name, "")
	if text is ""
		return default
	let number = text to Number
	number.IsFinite and ((number to Text) is text) then number else Error("InvalidNumber:" + Spelled(name))
Flag(name Text, default Boolean) Boolean
	Sample.Flag("jsonOutput", false)
	Sample.Flag("width", false) is false
	CommandLine(List(Text) + "--json_output=false", List(Text) + "jsonOutput").Flag("jsonOutput", true) is false
	let option = Spelled(name)
	if option is in arguments
		return true
	let written = Values(option)
	written.Length is 0 then default else written.Last is "true"
Repeated(name Text, defaults Texts) Texts
	Sample.Repeated("lora", List(Text)) is ("a.safetensors:0.8", "b")
	Sample.Repeated("width", List(Text) + "x") is ("x")
	let found = Values(Spelled(name))
	found.Length is 0 then defaults else found
Chosen(name Text, choices Texts, values Numbers, default Number) Number
	Sample.Chosen("quality", Choices, (0, 5), 0) is 5
	Sample.Chosen("width", Choices, (0, 5), 5) is 5
	Slow.Chosen("quality", Choices, (0, 5), 0) is Error("UnknownChoice:--quality")
	let text = Option(name, "")
	if text is ""
		return default
	let at = choices.Index(text)
	at < 0 then Error("UnknownChoice:" + Spelled(name)) else values(at)
Spelled(name Text) Text
	CommandLine.Spelled("jsonOutput") is "--json_output"
	CommandLine.Spelled("count") is "--count"
	mutable spelled = "--"
	for name
		let letter = value to Text
		spelled = spelled + (letter.Lower is letter then letter else "_" + letter.Lower)
	spelled
Usage(defaults Texts, descriptions Texts) Text
	Flags.Usage(("1", "false"), ("Outputs", "")) is "--count 1  Outputs\n--json_output false"
	Text.Combine(Lines(defaults, descriptions), "\n")
Spellings Texts
	Sample.Spellings.First is "--quality"
	for names
		Spelled(value)
Values(option Text) Texts
	Sample.Values("--lora") is ("a.safetensors:0.8", "b")
	for arguments
		if value.StartsWith(option + "=")
			value.Substring(option.Length + 1, value.Length - option.Length - 1)
		else if value is option
			Following(option, index)
Following(option Text, at Number) Text
	Sample.Following("--count", 6) is "8"
	CommandLine(List(Text) + "--count", List(Text) + "count").Following("--count", 0) is Error("MissingValue:--count")
	let next = at + 1 < arguments.Length then arguments(at + 1) else "--"
	next.StartsWith("--") then Error("MissingValue:" + option) else next
Lines(defaults Texts, descriptions Texts) Texts
	CommandLine(List(Text), List(Text) + "count").Lines(List(Text) + "1", List(Text)) is ("--count 1")
	for names
		let described = (index < descriptions.Length) and (descriptions(index) is not "")
		Spelled(value) + " " + defaults(index) + (described then "  " + descriptions(index) else "")
