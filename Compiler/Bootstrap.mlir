  func.func @main(%argc: i32, %argv: !llvm.ptr) -> i32 {
    %frameLevel = arith.constant 0 : i32
    %stackBase = llvm.call_intrinsic "llvm.frameaddress.p0"(%frameLevel) : (i32) -> !llvm.ptr
