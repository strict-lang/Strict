    %zero = arith.constant 0.0 : f64
    %selfslot = llvm.alloca %one x f64 : (i64) -> !llvm.ptr
    llvm.store %zero, %selfslot : f64, !llvm.ptr
    %arg0 = func.call @strict_argument_texts(%argc, %argv) : (i32, !llvm.ptr) -> f64
    %self = llvm.load %selfslot : !llvm.ptr -> f64
    %result = func.call @Strict_Run_1(%self, %arg0) : (f64, f64) -> f64
