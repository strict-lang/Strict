has logger
Reported(phase Text, started Number) Number
	let elapsed = Process.Elapsed - started
	if elapsed >= 3
		logger.Log(phase + ": " + elapsed.Round(2) + " s")
	elapsed
Inputs(cache NativeCache) Texts
	let started = Process.Elapsed
	let inputs = cache.Snapshot(cache.Inputs.Unique)
	Reported("Dependency snapshot", started)
	inputs
Compiled(command Text, rest Texts) Number
	let started = Process.Elapsed
	let result = NativeCompiler(logger).Compiled(command, rest)
	Reported("Total compilation", started)
	result
Program(module MlirModule, base Text, root Text, build NativeBuild) Text
	let started = Process.Elapsed
	let text = module.Text
	Reported("MLIR emission", started)
	let before = Process.Elapsed
	let program = build.Device(text, base, root)
	Reported("GPU preparation", before)
	program