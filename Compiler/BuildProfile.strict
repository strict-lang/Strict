has logger
constant IsRequested = Process.Variable("STRICT_BUILD_PROFILE") is "1"
Detailed Boolean
	IsRequested
Reported(phase Text, started Number)
	let elapsed = Process.Elapsed - started
	if Detailed or (elapsed >= 3)
		logger.Log((Detailed then "[build] " + phase else phase) + ": " + elapsed.Round(Detailed then 4 else 2) + " s")
Current(cache NativeCache, phase = "Compiler build cache") Boolean
	let started = Process.Elapsed
	let current = cache.IsCurrent
	Reported(phase + (current then " hit" else " miss"), started)
	current
Inputs(cache NativeCache, files Texts) Texts
	let started = Process.Elapsed
	let paths = cache.Inputs(files).Unique
	Reported("Dependency inventory (" + paths.Length + " inputs)", started)
	let before = Process.Elapsed
	let inputs = cache.Snapshot(paths)
	Reported("Dependency snapshot", before)
	inputs
Compiled(cache NativeCache) Number
	let started = Process.Elapsed
	let files = cache.IsEnabled then cache.Files else List(Text)
	if files.Length > 0
		Reported("Frontend / source discovery (" + files.Length + " files)", started)
	let inputs = cache.IsEnabled then Inputs(cache, files) else List(Text)
	let result = NativeCompiler(logger).Compiled(cache.command, cache.rest, files)
	Reported("Total compilation", started)
	if result is 0
		let before = Process.Elapsed
		cache.Saved(inputs)
		Reported("Build stamp write", before)
	result
Program(module MlirModule, base Text, root Text, build NativeBuild) Text
	let started = Process.Elapsed
	let text = module.Text
	Reported("MLIR emission", started)
	let before = Process.Elapsed
	let program = build.Device(WebBuild.Shaded(text, base, build.isWeb), base, root)
	Reported("GPU preparation", before)
	program
Entry(main TypeCodegen, withTests Boolean, isQuiet Boolean, selection = "") TypeEntry
	let started = Process.Elapsed
	let entry = withTests then TestCodegen(main, isQuiet, selection).Entry else main.Entry
	Reported("Frontend / main codegen (" + entry.methods.Length + " methods)", started)
	entry
Linked(linker Linker, entry TypeEntry) LinkRound
	let started = Process.Elapsed
	let linked = linker.Linked(entry, List(Text))
	Reported("Frontend / dependency linking (" + linked.entries.Length + " types)", started)
	linked
Parsed(compiler FileCompiler, sources Texts) Boolean
	let started = Process.Elapsed
	let problems = compiler.Problems(sources) - ""
	Reported("Frontend / syntax validation (" + sources.Length + " files)", started)
	if problems.Length > 0
		logger.Log(problems.First)
	problems.Length is 0
Issues(compiler FileCompiler, sources Texts, inference TypeInference) List(Texts)
	let started = Process.Elapsed
	let issues = compiler.Issues(sources, inference)
	Reported("Frontend / name validation (" + sources.Length + " files)", started)
	issues
Runtime(build NativeBuild, program Text, root Text) Text
	let started = Process.Elapsed
	let text = build.Mlir(program, root, build.Target)
	Reported("Host runtime assembly", started)
	text
Emitted(module MlirModule, texts List(MlirFunction), functions List(MlirFunction), recursive Texts) Texts
	let started = Process.Elapsed
	let emitted = module.Emitted(texts, functions, recursive)
	Reported("Emission / function bodies (" + texts.Length + " functions)", started)
	emitted
Shapes(files Texts) List(TypeShape)
	let started = Process.Elapsed
	let shapes = ResolveCheck.Shapes(files)
	Reported("Frontend / shape loading and fusion (" + files.Length + " files)", started)
	shapes
Inlined(types List(TypeEntry)) List(TypeEntry)
	let started = Process.Elapsed
	let inlined = StructLanes(Inliner(types, true).Inlined).Split
	Reported("Frontend / inlining", started)
	inlined
Packaged(build NativeBuild, base Text, program Text, tools Toolchain)
	if build.isFast
		return
	let started = Process.Elapsed
	Release(logger, base).Packaged(program, tools.isWeb, build.isCrossing, build.Target, build.isReleased)
	Reported("Packaging", started)
Lowered(tools Toolchain, base Text) Text
	let started = Process.Elapsed
	let lowered = tools.Lowered(base, "", (tools.platform is Platform.Windows then Toolchain.Parts else 1))
	Reported("Host lowering and translation", started)
	lowered
