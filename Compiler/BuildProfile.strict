mutable cached EmissionMemory = EmissionMemory.Empty
IsCurrent(cache NativeCache, phase = "Compiler build cache") Boolean
	started = Process.Elapsed
	current = cache.IsCurrent
	Phases.Report(phase + (current then " hit" else " miss"), started)
	current
Inputs(cache NativeCache, files Texts) Texts
	started = Process.Elapsed
	paths = cache.Inputs(files).Unique
	Phases.Report("Dependency inventory (" + paths.Length + " inputs)", started)
	before = Process.Elapsed
	inputs = cache.Snapshot(paths)
	Phases.Report("Dependency snapshot", before)
	inputs
Compile(cache NativeCache, emission = EmissionMemory.Empty) Number
	cached = emission
	started = Process.Elapsed
	files = cache.IsEnabled then cache.Files else List(Text)
	if files.Length > 0
		Phases.Report("Frontend / source discovery (" + files.Length + " files)", started)
	inputs = cache.IsEnabled then Inputs(cache, files) else List(Text)
	mutable compiler = NativeCompiler
	result = compiler.Compile(cache.command, cache.rest, files, emission)
	cached = compiler.cached
	if result is 0 and compiler.delivered is not ""
		logger.Log(Announce(compiler.delivered, Process.Elapsed - started))
	if result is 0
		before = Process.Elapsed
		cache.Save(inputs)
		Phases.Report("Build stamp write", before)
	result
Announce(delivered Text, elapsed Number) Text
	BuildProfile.Announce("Built ./strict.exe", 36.784) is "strict.exe built in 36.78s"
	BuildProfile.Announce("Built ./obj/A.exe, unchanged", 1) is "A.exe built in 1s"
	BuildProfile.Announce("", 1) is ""
	if delivered is ""
		return ""
	Path(delivered.Substring(6).Split(", ").First).FileName.text + " built in " + elapsed.Round(2) + "s"
Runtime(build NativeBuild, program Text, root Text) Text
	started = Process.Elapsed
	text = build.Mlir(program, root, build.Target)
	Phases.Report("Host runtime assembly", started)
	text
Inline(types List(TypeEntry)) List(TypeEntry)
	started = Process.Elapsed
	inlined = Inliner(types, true).Inlined
	Phases.Report("Frontend / inlining", started)
	before = Process.Elapsed
	split = StructLanes(inlined).Split
	Phases.Report("Frontend / struct lanes", before)
	split
Package(build NativeBuild, base Text, program Text, tools Toolchain)
	if build.isFast
		return
	started = Process.Elapsed
	Release(base).Package(program, tools.isWeb, build.isCrossing, build.Target, build.isReleased)
	Phases.Report("Packaging", started)
Lower(tools Toolchain, base Text) Text
	started = Process.Elapsed
	lowered = tools.Lower(base, "", tools.platform is Platform.Windows then Toolchain.Parts else 1)
	Phases.Report("Host lowering and translation", started)
	lowered
