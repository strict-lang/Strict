has library MlirLibrary
constant Utf8 = "[MarshalAs(UnmanagedType.LPUTF8Str)]"
constant Thrown = "\t\t\tthrow new InvalidOperationException(Marshal.PtrToStringUTF8(strict_last_error()));"
constant Policy = CSharpBinding(MlirLibrary.Policy)
constant Trades = CSharpBinding(MlirLibrary.Trades)
constant Book = CSharpBinding(LibraryLists.Book.library)
constant Texted = ("\t\tvar text = Marshal.PtrToStringUTF8(result);", "\t\tstrict_release(result);", "\t\treturn text;")
constant Using = ("// Generated by strict build <file> library, do not edit", "using System;", "using System.Runtime.InteropServices;")
constant Released = ("\t[DllImport(Library)] static extern IntPtr strict_last_error();", "\t[DllImport(Library)] static extern void strict_release(IntPtr text);", "\tstatic double[] Block<T>(T[] values) where T : unmanaged { var flat = MemoryMarshal.Cast<T, double>(values); var block = new double[flat.Length + 1]; block[0] = values.Length; flat.CopyTo(block.AsSpan(1)); return block; }", "\tstatic T[] Items<T>(IntPtr block) where T : unmanaged { var count = new double[1]; Marshal.Copy(block, count, 0, 1); var flat = new double[(int)count[0] * Marshal.SizeOf<T>() / 8]; Marshal.Copy(block + 8, flat, 0, flat.Length); strict_release(block); return MemoryMarshal.Cast<double, T>(flat).ToArray(); }")
Lines Texts
	Policy.Lines.Index("public static class Policy") is 3
	Trades.Lines.Index("public struct Trade { public double price; public double amount; }") is 3
	Book.Lines.Index("public struct Trade { public double price; public double amount; }") is 3
	let name = TypeEntry.ShortName(library.types.First.Name)
	let isRecord = library.IsRecord(library.types.First.Name)
	let declaration = "\tconst string Library = \"" + name + "\";"
	let header = "public static class " + name + (isRecord then "Methods" else "")
	mutable lines = Using + Structs + header + "{" + declaration + Released
	for library.Exported
		lines = lines + Imported(value) + Method(value)
	lines + "}"
Structs Texts
	Policy.Structs.Length is 0
	mutable structs = List(Mutable(Text))
	for TypeNames
		let element = LibraryLists(library).Element(value)
		let record = element is in ("", "Number") then value else element
		if library.IsRecord(record) and (Struct(record) is not in structs)
			structs.Add(Struct(record))
	structs
TypeNames Texts
	Trades.TypeNames is ("Strict/Trade", "Strict/Number")
	mutable typeNames = List(Text) + library.types.First.Name
	for library.Exported
		typeNames = typeNames + value.returnType
		for value.parameters
			typeNames = typeNames + value.typeName
	typeNames
Struct(typeName Text) Text
	Trades.Struct("Strict/Trade") is "public struct Trade { public double price; public double amount; }"
	let type = MlirFunction(library.types, library.types.First, MlirLibrary.Total).TypeOf(typeName)
	mutable fields = ""
	for MlirInstances(MlirFunction(library.types, type, MlirLibrary.Total), 0).Stored(type)
		fields = fields + " public double " + value.Name + ";"
	"public struct " + TypeEntry.ShortName(typeName) + " {" + fields + " }"
Imported(method MethodEntry) Text
	Policy.Imported(MlirLibrary.Start).EndsWith(" string mode, int enabled, out IntPtr result);") is true
	Book.Imported(LibraryLists.Valued).EndsWith("(double[] trades, out IntPtr result);") is true
	let instance = "ref " + TypeEntry.ShortName(library.types.First.Name) + " instance"
	mutable parameters = library.IsRecord(library.types.First.Name) then List(Text) + instance else List(Text)
	for method.parameters
		parameters = parameters + (Native(value.typeName) + " " + value.Name)
	let returned = Managed(method.returnType)
	let native = library.IsRecord(method.returnType) then returned else Native(method.returnType)
	let result = "out " + ((returned is "string") or returned.EndsWith("[]") then "IntPtr" else native) + " result"
	let symbol = TypeEntry.ShortName(library.types.First.Name) + "_" + method.Name
	"\t[DllImport(Library)] static extern int " + symbol + "(" + Text.Combine(parameters + result, ", ") + ");"
Method(method MethodEntry) Texts
	Policy.Method(MlirLibrary.Start).First is "\tpublic static string Start(string mode, bool enabled)"
	Trades.Method(MlirLibrary.Total).First is "\tpublic static double Total(Trade instance)"
	let symbol = TypeEntry.ShortName(library.types.First.Name) + "_" + method.Name
	let declared = Managed(method.returnType) + " " + method.Name
	let header = "\tpublic static " + declared + "(" + Text.Combine(Parameters(method), ", ") + ")"
	let call = "\t\tif (" + symbol + "(" + Text.Combine(Arguments(method) + "out var result", ", ") + ") != 0)"
	(header, "\t{", call, Thrown) + Returned(method.returnType) + "\t}"
Parameters(method MethodEntry) Texts
	Trades.Parameters(MlirLibrary.Total) is ("Trade instance")
	let instance = TypeEntry.ShortName(library.types.First.Name) + " instance"
	mutable parameters = library.IsRecord(library.types.First.Name) then List(Text) + instance else List(Text)
	for method.parameters
		parameters = parameters + (Managed(value.typeName) + " " + value.Name)
	parameters
Arguments(method MethodEntry) Texts
	Trades.Arguments(MlirLibrary.Total) is ("ref instance")
	mutable arguments = library.IsRecord(library.types.First.Name) then List(Text) + "ref instance" else List(Text)
	for method.parameters
		arguments = arguments + Argument(value.typeName, value.Name)
	arguments
Argument(typeName Text, name Text) Text
	Policy.Argument("Strict/Boolean", "on") is "on ? 1 : 0"
	Policy.Argument("Strict/Numbers", "prices") is "Block(prices)"
	let kind = Managed(typeName)
	if kind.EndsWith("[]")
		return "Block(" + name + ")"
	kind is "bool" then name + " ? 1 : 0" else library.IsRecord(typeName) then "ref " + name else name
Returned(returnType Text) Texts
	Policy.Returned("Strict/Number") is ("\t\treturn result;")
	Policy.Returned("Strict/List(Number)") is ("\t\treturn Items<double>(result);")
	Book.Returned("Strict/List(Trade)") is ("\t\treturn Items<Trade>(result);")
	let kind = Managed(returnType)
	if kind.EndsWith("[]")
		return List(Text) + ("\t\treturn Items<" + kind.Substring(0, kind.Length - 2) + ">(result);")
	if kind is "string"
		return Texted
	List(Text) + (kind is "bool" then "\t\treturn result != 0;" else "\t\treturn result;")
Native(typeName Text) Text
	Policy.Native("Strict/Text") is Utf8 + " string"
	let kind = Managed(typeName)
	if library.IsRecord(typeName)
		return "ref " + kind
	let native = kind.EndsWith("[]") then "double[]" else kind
	kind is "string" then Utf8 + " string" else kind is "bool" then "int" else native
Managed(typeName Text) Text
	Policy.Managed("Strict/Boolean") is "bool"
	Policy.Managed("Strict/Numbers") is "double[]"
	Book.Managed("Strict/List(Trade)") is "Trade[]"
	let name = TypeEntry.ShortName(typeName)
	let element = LibraryLists(library).Element(typeName)
	if element is not ""
		return Managed(element) + "[]"
	name is "Text" then "string" else name is "Boolean" then "bool" else name is "Number" then "double" else name
