constant ToolSeconds = 270
constant ShortSeconds = 60
constant TraitExit = 49
constant LinkChainSrc = "Examples/LinkChain/LinkChain.strict"
constant ProfCode = "has profile Compiler/BuildProfile\nRun Number\n\tBuildProfile(Logger).Reported(\"Fast phase\", Process.Elapsed)\n\tBuildProfile(Logger).Reported(\"Slow phase\", Process.Elapsed - 3.1)\n\t0"
constant NamedCode = "has logger\nNext(number Number) Number\n\tnumber + 1\nRun\n\tNext(3)\n\tlogger.Log(\"done\")"
constant MovedA = "has logger\nhas weights Numbers with value.Bits is 32\nLoop(count Number) Numbers\n\tfor count\n\t\tweights(index % 4) * 3\n"
constant MovedB = "Run(count Number)\n\tlet results = MovedCheck(logger, (1.1, 2.2, 3.3, 5.5)).Loop(count)\n\tlogger.Log(results(0) to Text)"
constant NestedA = "has numbers Numbers\nhas logger\nRun Number\n\tlet result = NestedGpu(Counted(256), logger).Totals(8192).Sum\n\tlogger.Log(result to Text)\n\t0\n"
constant NestedB = "Totals(c Number) Numbers\n\tfor c\n\t\tSquared.Sum + index\nSquared Numbers\n\tfor numbers\n\t\tvalue * value\nCounted(c Number) Numbers\n\tfor c\n\t\tindex"
constant TraitFilesA = "Service.strict|Result Number\nServiceValue.strict|has number\nResult Number\n\tnumber\nServiceOther.strict|has number\nResult Number\n\tnumber * 2"
constant TraitFilesB = "ServiceHolder.strict|has service Service\nResult Number\n\tservice.Result"
constant TraitA = "has logger\nRun Number\n\tlet first = ServiceHolder(ServiceValue(7)).Result + Read(ServiceOther(7))\n\tlet second = ServiceHolder(ServiceOther(7)).Result + Read(ServiceValue(7))\n"
constant TraitB = "\tlet result = first + second + ServiceHolder(ServiceValue(7)).service.Result\n\tlogger.Log(result to Text)\n\tresult\nRead(service Service) Number\n\tservice.Result"
constant HC01 = "#define _CRT_SECURE_NO_WARNINGS\n#include <windows.h>\n#include <stdint.h>\n#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n"
constant HC02 = "static void touch(const char*p,int64_t ns){HANDLE h=CreateFileA(p,FILE_WRITE_ATTRIBUTES,7,0,OPEN_EXISTING,0,0);"
constant HC03 = "if(h==INVALID_HANDLE_VALUE)return;FILETIME ft;GetFileTime(h,0,0,&ft);ULARGE_INTEGER u={{ft.dwLowDateTime,ft.dwHighDateTime}};"
constant HC04 = "if(ns==0){SYSTEMTIME s;GetSystemTime(&s);SystemTimeToFileTime(&s,&ft);}else{u.QuadPart+=(uint64_t)(ns/100);\nft.dwLowDateTime=u.LowPart;ft.dwHighDateTime=u.HighPart;}SetFileTime(h,0,0,&ft);CloseHandle(h);}"
constant HC06 = "static int held_lock(const char*f,const char*c){FILE*fp=fopen(f,\"wb\");int r=system(c);if(fp)fclose(fp);return r;}"
constant HC07 = "static PROCESS_INFORMATION spawn(const char*c){STARTUPINFOA si={sizeof(si)};PROCESS_INFORMATION pi={0};\nchar*cp=_strdup(c);CreateProcessA(0,cp,0,0,0,0,0,0,&si,&pi);free(cp);return pi;}"
constant HC09 = "static void killt(DWORD p){char c[64];snprintf(c,64,\"taskkill /T /F /PID %lu >nul 2>nul\",p);system(c);}"
constant HC10 = "static int chk_held(const char*st,const char*sr,const char*ex){HANDLE ps[2]={0};FILE*f;for(int a=0;a<3;a++){char cd[256];"
constant HC11 = "snprintf(cd,256,\"Run(seconds Number)\\n\\tlet s = Process.Elapsed\\n\\tfor as long as Process.Elapsed - s < seconds\\n\\t\\tProcess.Wait(0.1%d)\\n\",a);"
constant HC12 = "f=fopen(sr,\"wb\");fwrite(cd,1,strlen(cd),f);fclose(f);char cm[512];snprintf(cm,512,\"\\\"%s\\\" build \\\"%s\\\"\",st,sr);"
constant HC13 = "if(system(cm)!=0)return 2;if(a<2){char rc[512];snprintf(rc,512,\"\\\"%s\\\" 60\",ex);ps[a]=spawn(rc).hProcess;}}"
constant HC14 = "char o2[512];snprintf(o2,512,\"%.*s.old2.exe\",(int)(strlen(ex)-4),ex);int ok=GetFileAttributesA(o2)!=INVALID_FILE_ATTRIBUTES;"
constant HC15 = "for(int i=0;i<2;i++)if(ps[i]){TerminateProcess(ps[i],1);WaitForSingleObject(ps[i],5000);CloseHandle(ps[i]);}return ok?0:3;}"
constant HC16 = "static int chk_conc(const char*st,const char*sr,const char*lk,const char*ex){char cm[512];"
constant HC17 = "snprintf(cm,512,\"\\\"%s\\\" build \\\"%s\\\"\",st,sr);PROCESS_INFORMATION p1=spawn(cm);"
constant HC18 = "for(int i=0;i<3000&&GetFileAttributesA(lk)==INVALID_FILE_ATTRIBUTES;i++)Sleep(20);PROCESS_INFORMATION p2=spawn(cm);"
constant HC19 = "WaitForSingleObject(p1.hProcess,120000);WaitForSingleObject(p2.hProcess,120000);DWORD e1=1,e2=1;GetExitCodeProcess(p1.hProcess,&e1);"
constant HC20 = "GetExitCodeProcess(p2.hProcess,&e2);CloseHandle(p1.hProcess);CloseHandle(p2.hProcess);if(e1||e2)return 4;"
constant HC21 = "DeleteFileA(lk);FILE*f=fopen(sr,\"wb\");const char*s=\"Run Number\\n\\t1 is 1\\n\\t4\\n\";fwrite(s,1,strlen(s),f);fclose(f);"
constant HC22 = "PROCESS_INFORMATION pk=spawn(cm);for(int i=0;i<3000&&GetFileAttributesA(lk)==INVALID_FILE_ATTRIBUTES;i++)Sleep(20);"
constant HC23 = "PROCESS_INFORMATION pr=spawn(cm);Sleep(200);killt(pk.dwProcessId);WaitForSingleObject(pk.hProcess,10000);"
constant HC24 = "WaitForSingleObject(pr.hProcess,120000);DWORD er=1;GetExitCodeProcess(pr.hProcess,&er);CloseHandle(pk.hProcess);"
constant HC25 = "CloseHandle(pr.hProcess);if(er)return 5;PROCESS_INFORMATION x=spawn(ex);WaitForSingleObject(x.hProcess,10000);"
constant HC26 = "DWORD exx=0;GetExitCodeProcess(x.hProcess,&exx);CloseHandle(x.hProcess);return exx==4?0:6;}"
constant HC27 = "system(\"taskkill /F /IM ResidentCheck.exe\");return ok?0:8;}\nint main(int c,char**v){if(!strcmp(v[1],\"touch\")){touch(v[2],strtoll(v[3],0,10));return 0;}\nif(!strcmp(v[1],\"lock\"))return held_lock(v[2],v[3]);"
constant HC28 = "if(!strcmp(v[1],\"held\"))return chk_held(v[2],v[3],v[4]);if(!strcmp(v[1],\"conc\"))return chk_conc(v[2],v[3],v[4],v[5]);if(!strcmp(v[1],\"res\"))return chk_res(v[2],v[3],v[4]);return 9;}"
Run Number
	let folder = "Examples/BuildCheck" + 1000000.Random.Floor
	if Directory.Create(folder) is Error
		return Error("DirectoryNotCreated")
	let h = CompiledHelper(folder)
	let err = h is Error then h else CheckHeadersAndTraits(folder, h)
	Directory.Delete(folder)
	if err is Error
		return err
	logger.Log("CheckBuild passed")
	0
CompiledHelper(folder Text) Text
	if Process.OperatingSystem is not "Windows"
		return Error("CheckBuild async helpers currently require Windows")
	mutable out = List(Text)
	out = out + (HC01 + HC02 + "\n" + HC03 + "\n" + HC04 + "\n" + HC06 + "\n" + HC07)
	out = out + (HC09 + "\n" + HC10 + "\n" + HC11 + "\n" + HC12 + "\n" + HC13 + "\n" + HC14 + "\n" + HC15 + "\n" + HC16)
	out = out + (HC17 + "\n" + HC18 + "\n" + HC19 + "\n" + HC20 + "\n" + HC21 + "\n" + HC22 + "\n" + HC23 + "\n" + HC24)
	out = out + (HC25 + "\n" + HC26 + "\n" + HelperCMain)
	File(folder + "/helper.c").Write(Text.Combine(out, "\n").Split("\n"))
	let comp = Process.RunTool("clang", "-O2 \"" + folder + "/helper.c\" -o \"" + folder + "/helper.exe\"", ShortSeconds)
	comp.exitCode is not 0 then Error("HelperCompileFailed: " + comp.Output + comp.error) else folder + "/helper.exe"
CheckHeadersAndTraits(folder Text, helper Text) Boolean
	if File("Compiler/Bootstrap.mlir").ReadText.IndexOf("@NativeCompiler_Checked_") < 0
		return Error("BootstrapNotChecked")
	for (TraitFilesA + "\n" + TraitFilesB).Split("\n")
		File(folder + "/" + value.Split("|")(0)).Write(value.Split("|")(1).Split("\\n"))
	let trait = Built(folder, "TraitCheck", TraitA + TraitB)
	if trait is Error or Process.RunTool(trait, "", ShortSeconds).exitCode is not TraitExit
		return Error("TraitCheckFailed")
	File(folder + "/NativeChange.strict").Write(("has logger", "Run", "\tlogger.Log(Hmac.Sha256(\"key\", \"text\"))"))
	CheckCleanup(folder, helper)
CheckCleanup(folder Text, helper Text) Boolean
	let src = folder + "/CleanupCheck.strict"
	let locked = folder + "/Locked"
	let call = "Intermediates(Logger).Removed(\"" + locked + "\") is Error then 1 else 0"
	File(src).Write(("has build Compiler/NativeBuild", "Run Number", "\t" + call))
	let cmd = "\\\"" + Process.Current.executable + "\\\" \\\"" + src + "\\\""
	let ran = Process.RunTool(helper, "lock \"" + locked + ".ll\" \"" + cmd + "\"", ShortSeconds)
	if "Could not remove build intermediate: " + locked + ".ll" is not in ran.Output
		return Error("CleanupLockMessageMissing: " + ran.Output)
	let built = Built(folder, "CleanupCheck", "")
	Directory.Create(folder + "/Content")
	File(folder + "/Content/data.txt").Write("initial")
	built is Error then built else CheckNestedAndCache(folder, helper)
CheckNestedAndCache(folder Text, helper Text) Boolean
	let nested = Built(folder, "NestedGpu", NestedA + NestedB)
	if nested is Error
		return nested
	let mlir = Text.Combine(File(folder + "/obj/NestedGpu.mlir").ReadLines, "\n")
	if "func.call @strict_parallel(%t" is not in mlir or "func.call @strict_gpu_run(%t" is not in mlir
		return Error("NestedCpuGpuMissing")
	let ran = Process.RunTool("cmd", "/c set STRICT_THREADS=4&& set STRICT_GPU=all&& \"" + nested + "\"", ShortSeconds)
	if ran.exitCode is not 1 or "GpuLoopMustRunOnGpu" is not in ran.Output
		return Error("ForcedGpuDidNotStop: " + ran.Output)
	CheckProfileAndBuildCache(folder, helper)
CheckProfileAndBuildCache(folder Text, helper Text) Boolean
	let prof = Built(folder, "ProfileCheck", ProfCode)
	let out = prof is Error then prof to Text else Process.RunTool(prof, "", ShortSeconds).Output
	if "Fast phase:" is in out or "Slow phase:" is not in out
		return Error("DefaultProfileThresholdsBroken: " + out)
	File(folder + "/BuildValue.strict").Write(("Result Number", "\t0"))
	let src = folder + "/BuildCheck.strict"
	File(src).Write(("Run Number", "\t1 is 2", "\tBuildValue.Result"))
	let fail = Process.RunTool(Process.Current.executable, "build " + src, ToolSeconds)
	if fail.exitCode is 0 or File(folder + "/BuildCheck.exe").Exists
		return Error("FailedUnitBuiltProgram")
	File(src).Write(("Run Number", "\t1 is 1", "\tBuildValue.Result"))
	CheckInc(folder, helper, src)
CheckInc(folder Text, helper Text, src Text) Boolean
	let exe = Built(folder, "BuildCheck", "")
	if exe is Error or Process.RunTool(exe, "", ShortSeconds).exitCode is not 0
		return Error("CleanBuildFailed")
	let stamp = File(exe).Modified
	File(folder + "/obj/BuildCheck.mlir").Delete
	let h = Process.RunTool(Process.Current.executable, "build " + src, ShortSeconds)
	if "Up to date:" is not in h.Output or File(exe).Modified is not stamp
		return Error("CacheHitFailed: " + h.Output)
	File(folder + "/BuildValue.strict").Write(("Result Number", "\t1"))
	let dep = Process.RunTool(Process.Current.executable, "build " + src, ToolSeconds)
	let bad = dep.exitCode is not 0 or Process.RunTool(exe, "", ShortSeconds).exitCode is not 1
	bad then Error("Dep") else CheckReleaseAndFiles(folder, helper)
CheckReleaseAndFiles(folder Text, helper Text) Boolean
	let b = folder + "/Built"
	let r = folder + "/Release"
	let h = "has release Compiler/Release\nRun Number slow\n\tReleaseCheck(Release(Logger, \"" + b + "\")).Retained"
	let m = " is true\n\t0\nRetained Boolean\n\tFile(\"" + b + ".exe\").Write(\"built\")\n\t"
	let m2 = "release.Refreshed(\"" + r + "\", \"\", \"" + b + "\", (\".exe\"))\n\tFile(\"" + b + ".exe\").Exists"
	File(folder + "/ReleaseCheck.strict").Write((h + m + m2).Split("\n"))
	let rt = Process.RunTool(Process.Current.executable, "test " + folder + "/ReleaseCheck.strict native", ToolSeconds)
	if rt.exitCode is not 0 or Text.Combine(File(r + "/Built.exe").ReadLines, "") is not "built"
		return Error("ReleaseCheckFailed")
	CheckNativeTestCache(folder, helper)
CheckNativeTestCache(folder Text, helper Text) Boolean
	let src = folder + "/CachedTests.strict"
	let mrk = folder + "/Ran.exe"
	let l = ("Run Number", "\tTouched is true", "\t0", "Touched Boolean", "\tFile(\"" + mrk + "\").Write(\"t\")", "\ttrue")
	File(src).Write(l)
	let t1 = Process.RunTool(Process.Current.executable, "test " + src + " native unit", ToolSeconds)
	if t1.exitCode is not 0 or not File(mrk).Exists
		return Error("InitialNativeTestFailed")
	File(mrk).Delete
	File(folder + "/obj/CachedTests.test.mlir").Delete
	let t2 = Process.RunTool(Process.Current.executable, "test " + src + " native unit", ShortSeconds)
	let miss = t2.exitCode is not 0 or File(mrk).Exists or File(folder + "/obj/CachedTests.test.mlir").Exists
	miss then Error("NativeTestCacheMiss") else CheckGpuCacheEntry(folder, helper)
CheckGpuCacheEntry(folder Text, helper Text) Boolean
	File(folder + "/OldGpu.kernels.mlir").Write("module {\n}")
	File(folder + "/OldGpu.ptx").Write("// cached")
	let l1 = "has cache Compiler/PtxCache\nRun Number\n\tGpuCacheCheck(PtxCache(\"" + folder + "/OldGpu\")).Previous is 1"
	let c = (l1, "\t0", "Previous Number", "\tcache.Previous(\"module {\\n}\", false)")
	File(folder + "/GpuCacheCheck.strict").Write(c)
	let g = Process.RunTool(Process.Current.executable, "test " + folder + "/GpuCacheCheck.strict", ShortSeconds)
	if g.exitCode is not 0
		return Error("GpuCacheCheckFailed: " + g.Output)
	File(folder + "/GpuCacheCheck.strict").Delete
	CheckReadTextAndLinks(folder, helper)
CheckReadTextAndLinks(folder Text, helper Text) Boolean
	File(folder + "/sample.txt").Write("one\r\ntwo\r".Bytes)
	let rtSrc = folder + "/ReadTextCheck.strict"
	let fnLine = "\tJoined(\"" + folder + "/sample.txt\") is \"one\\ntwo\""
	File(rtSrc).Write(("Joined(path Text) Text", fnLine, "\tText.Combine(File(path).ReadLines, \"\\n\")"))
	let rt = Process.RunTool(Process.Current.executable, "test " + rtSrc + " native", ToolSeconds)
	let mlir = Text.Combine(File(folder + "/obj/ReadTextCheck.test.mlir").ReadLines, "\n")
	if rt.exitCode is not 0 or "@strict_file_joined(" is not in mlir
		return Error("ReadTextFusionFailed: " + rt.Output)
	let cmd = "/c set STRICT_THREADS=1&& \"" + Process.Current.executable + "\" test " + LinkChainSrc + " native"
	let l1 = Process.RunTool("cmd", cmd, ToolSeconds)
	File(folder + "/NamedCheck.strict").Write(NamedCode.Split("\n"))
	l1.exitCode is not 0 then Error("LinkChainFailed: " + l1.Output) else CheckNamedAndMoved(folder, helper)
CheckNamedAndMoved(folder Text, helper Text) Boolean
	let nr = Process.RunTool(Process.Current.executable, "build " + folder + "/NamedCheck.strict", ToolSeconds)
	if nr.exitCode is 1 or "ResultMustBeUsed: Next(3)" is not in nr.Output
		return Error("NamedFailureWrong: " + nr.Output)
	let moved = Built(folder, "MovedCheck", MovedA + MovedB)
	if moved is Error
		return moved
	let d = folder + "/elsewhere"
	Directory.Create(d)
	File(d + "/MovedCheck.exe").Write(File(moved).ReadBytes)
	let mr = Process.RunTool("cmd", "/c cd /d \"" + d + "\" && MovedCheck.exe 32000", ShortSeconds)
	let bad = mr.exitCode is not 1 or "is missing or empty" is not in mr.Output
	bad then Error("MovedPtx") else CheckNativeFolder(folder, helper)
CheckNativeFolder(folder Text, helper Text) Boolean
	let cmd = "/c cd /d Examples && \"" + Process.Current.executable + "\" test Fibonacci.strict"
	let s1 = Process.RunTool(Process.Current.executable, "stop", ShortSeconds)
	if s1.exitCode < 0 or Process.RunTool("cmd", cmd, ToolSeconds).exitCode is not 0
		return Error("FibonacciFailed")
	File("NeuralNetworks/obj/Layer.strictbinary").Delete
	let r2 = Process.RunTool(Process.Current.executable, "test NeuralNetworks/Layer.strict", ToolSeconds)
	if r2.exitCode is not 0 or "GgufFileNotReadable" is in r2.Output
		return Error("LayerRelativePathFailed: " + r2.Output)
	File(folder + "/MovingCheck.strict").Write(("Moved Number", "\tDirectory.Change(\"Math\") is not Error", "\t1"))
	let mv = Process.RunTool(Process.Current.executable, "build " + folder + "/MovingCheck.strict", ToolSeconds)
	let ok = Process.RunTool(Process.Current.executable, "stop", ShortSeconds).exitCode >= 0 and mv.exitCode is 0
	ok then CheckEnvAndConcurrency(folder, helper) else Error("MovingCheckFailed: " + mv.Output)
CheckEnvAndConcurrency(folder Text, helper Text) Boolean
	let src = folder + "/ConcurrentCheck.strict"
	File(src).Write(("Run Number", "\t1 is 1", "\t3"))
	let lk = folder + "/obj/ConcurrentCheck.strict.lock"
	let aC = "conc \"" + Process.Current.executable + "\" \"" + src + "\" \"" + lk + "\" \""
	if Process.RunTool(helper, aC + folder + "/ConcurrentCheck.exe\"", ToolSeconds).exitCode is not 0
		return Error("ConcurrentBuildFailed: " + helper)
	let aH = "held \"" + Process.Current.executable + "\" \"" + folder + "/HeldCheck.strict\" \""
	if Process.RunTool(helper, aH + folder + "/HeldCheck.exe\"", ToolSeconds).exitCode is not 0
		return Error("HeldCopyFailed: " + helper)
	let aR = "res \"" + Process.Current.executable + "\" \"" + folder + "/ResidentCheck.strict\" \""
	let res = Process.RunTool(helper, aR + folder + "/ResidentCheck.exe\"", ToolSeconds)
	res.exitCode is not 0 then Error("ResidentFail: " + res.Output) else CheckCompilerChange(folder, helper)
CheckCompilerChange(folder Text, helper Text) Boolean
	File(folder + "/CompilerUsed.strict").Write(("Doubled(number Number) Number", "\tDoubled(2) is 4", "\tnumber * 2"))
	let src = folder + "/CompilerChange.strict"
	File(src).Write(("Tripled(number Number) Number", "\tTripled(2) is 6", "\tCompilerUsed.Doubled(number) + number"))
	let usedBin = folder + "/obj/CompilerUsed.strictbinary"
	if Process.RunTool(Process.Current.executable, "test " + src + " native", ToolSeconds).exitCode is not 0
		return Error("CompilerChangeInitFailed")
	let stored = File(usedBin).Modified
	let tc = Process.RunTool(helper, "touch \"" + src + "\" 0", ShortSeconds)
	let t1 = Process.RunTool(Process.Current.executable, "test " + src + " native", ToolSeconds)
	if tc.exitCode is not 0 or t1.exitCode is not 0 or File(usedBin).Modified is not stored
		return Error("UnchangedCompiler")
	CheckCompilerTouch(folder, helper, src, usedBin, stored)
CheckCompilerTouch(folder Text, helper Text, src Text, usedBin Text, stored Number) Boolean
	let tA = Process.RunTool(helper, "touch \"" + Process.Current.executable + "\" 1000000000", ShortSeconds)
	let t2 = Process.RunTool(Process.Current.executable, "test " + src + " native", ToolSeconds)
	let tB = Process.RunTool(helper, "touch \"" + Process.Current.executable + "\" -1000000000", ShortSeconds)
	if tA.exitCode is not 0 or tB.exitCode is not 0 or t2.exitCode is not 0 or File(usedBin).Modified is stored
		return Error("ChangedCompilerReusedOldBytecode: " + usedBin)
	if Built(folder, "NativeChange", "") is Error
		return Error("NativeChangeInitFailed")
	for ("Networking/native/Hmac.c", "Networking/Hmac.strict")
		let tch = Process.RunTool(helper, "touch \"" + value + "\" 0", ShortSeconds)
		if tch.exitCode is not 0 or Built(folder, "NativeChange", "") is Error
			return Error("NativeBuildFailed: " + value)
	true
Built(folder Text, name Text, code Text) Text
	let src = folder + "/" + name + ".strict"
	if code is not ""
		File(src).Write(code.Split("\n"))
	let res = Process.RunTool(Process.Current.executable, "build " + src, ToolSeconds)
	res.exitCode is not 0 then Error("BuildFail " + name + ": " + res.Output) else folder + "/" + name + ".exe"
HelperCMain Text
	mutable out = List(Text)
	out = out + "static int chk_res(const char*st,const char*sr,const char*ex){HANDLE pr=0;for(int a=0;a<2;a++){\n"
	out = out + "char cd[512];snprintf(cd,512,\"Run(seconds Number)\\n\\tlet r = Resident(Path(Process.Current."
	out = out + "executable).PathOnly.text)\\n\\tlet v = r.Opened\\n\\tlet s = Process.Elapsed\\n\\tfor as long "
	out = out + "as Process.Elapsed - s < seconds\\n\\t\\tProcess.Wait(0.1%d)\\n\\tr.Closed(v)\\n\",a);\n"
	out = out + "FILE*f=fopen(sr,\"wb\");fwrite(cd,1,strlen(cd),f);fclose(f);char cm[512];\n"
	out = out + "snprintf(cm,512,\"\\\"%s\\\" build \\\"%s\\\"\",st,sr);if(system(cm)!=0)return 7;\n"
	out = out + "if(a==0){char rc[512];snprintf(rc,512,\"\\\"%s\\\" 60\",ex);pr=spawn(rc).hProcess;Sleep(1000);}}\n"
	out = out + "int ok=WaitForSingleObject(pr,3000)!=WAIT_TIMEOUT;CloseHandle(pr);\n"
	Text.Combine(out, "") + HC27 + "\n" + HC28