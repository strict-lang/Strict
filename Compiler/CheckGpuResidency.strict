constant ToolSeconds = 120
constant ByteCount = 20000
constant ByteMod = 200
constant ResWantsA = ("folded 4096 2.5", "summed 2048 5", "mixed 4000 2.5", "read 1000 1.375", "joined 3073 8", "averaged 4194304 2", "packed 2536 2, written 20000", "swapped 8 1.625 1")
constant ResWantsB = ("Strict GPU download of 4096 numbers", "Strict GPU download of 1000 numbers in 64 bits")
constant ResBansA = ("Strict GPU download of 16384 numbers", "Strict GPU download of 8192 numbers")
constant ResBansB = ("Strict GPU download of 16000 numbers", "Strict GPU download of 12288 numbers", "Strict GPU download of 6144 numbers")
constant ViewA = "has zoom Number\nhas seed Pair = Pair.Zero\nhas center Pair\nZoomed(factor Number) Viewing\n\tViewing(2, Pair(1, 1), Pair(3, 4)).Zoomed(2) is Viewing(4, Pair(1, 1), Pair(3, 4))\n"
constant ViewB = "\tViewing(2, center = Pair(3, 4)).Zoomed(2) is Viewing(4, Pair.Zero, Pair(3, 4))\n\tViewing(zoom * factor, seed, center)"
constant ResA1 = "has logger\nTable(count Number) Numbers\n\tGpuResidency(Logger).Table(2) is (1, 1.125)\n\tfor count\n\t\tindex / 8 + 1"
constant ResA2 = "Squares(count Number) Numbers\n\tGpuResidency(Logger).Squares(2) is (0, 0.25)\n\tfor count\n\t\t(index / 2) ^ 2"
constant ResB1 = "Codes(count Number) Bytes\n\tGpuResidency(Logger).Codes(2) is (0, 1)\n\tfor count\n\t\tindex % 200\n"
constant ResB2 = "Mixed(codes Bytes, table Numbers) Numbers\n\tGpuResidency(Logger).Mixed((1, 2, 3, 4), (3, 4, 5, 6)) is (4)\n\tfor codes.Length / 4\n\t\tcodes(index) + table(index * 4)"
constant ResC1 = "Written(path Text) Number\n\tGpuResidency(Logger).Written(\"written.bin\") is 20000\n\tFile(path).Write(Codes(20000))\n\tFile(path).Length"
constant ResC2 = "Averaged(first Numbers, second Numbers) Numbers\n\tGpuResidency(Logger).Averaged((1, 2), (3, 5)) is (2, 3.5)\n\tfor first.Length\n\t\t(first(index) + second(index)) / 2"
constant ResD1 = "Folded(table Numbers) Numbers\n\tGpuResidency(Logger).Folded((1, 2, 3, 4, 5, 6, 7, 8)) is (2, 6)\n\tfor table.Length / 4\n\t\ttable(index * 4) + 1"
constant ResD2 = "Run\n\tlet folded = Folded(Table(16384))\n\tlet summed = Folded(Squares(8192))\n\tlet mixed = Mixed(Codes(16000), Table(16384))\n\tlet read = Table(1000)"
constant ResE1 = "\tlet joined = Folded(Mixed(Codes(49152), Table(49152)) + (7, 0, 0, 0))\n\tlogger.Log(\"folded \" + folded.Length + \" \" + folded(1))"
constant ResE2 = "\tlogger.Log(\"summed \" + summed.Length + \" \" + summed(1))\n\tlogger.Log(\"mixed \" + mixed.Length + \" \" + mixed(1))\n\tlogger.Log(\"read \" + read.Length + \" \" + read(3))"
constant ResF1 = "\tlogger.Log(\"joined \" + joined.Length + \" \" + joined(3072))\n\tlet averaged = Averaged(Averaged(Table(4194304), Table(4194304)), Table(4194304))"
constant ResF2 = "\tlogger.Log(\"averaged \" + averaged.Length + \" \" + averaged(8))\n\tlet packed = Folded(Mixed(Codes(24576), Table(24576)) + mixed)"
constant ResG1 = "\tlogger.Log(\"packed \" + packed.Length + \" \" + packed(1536) + \", written \" + Written(\"codes.bin\"))"
constant ResG2 = "\tlet swapped = Table(8).Slice(4, 4) + Table(8).Slice(0, 4)\n\tlogger.Log(\"swapped \" + swapped.Length + \" \" + swapped(1) + \" \" + swapped(4))"
constant SmallA = "has logger\nTable(count Number) Numbers\n\tSmallGpu(Logger).Table(2) is (1, 1.125)\n\tfor count\n\t\tindex / 8 + 1\nDoubled(table Numbers) Numbers\n\tSmallGpu(Logger).Doubled((1, 2)) is (2, 4)"
constant SmallB = "\tfor table.Length\n\t\ttable(index) * 2\nRun\n\tlet opened = Table(2000000)\n\tlet before = Process.Executed\n\tlet doubled = Doubled(Table(200000))\n\tlet after = Process.Executed"
constant SmallC = "\tlogger.Log(\"gpu kernels \" + (after(3) - before(3)) + \", doubled \" + doubled(16) + \", opened \" + opened(8))"
constant PairA = "has real Number\nhas imaginary Number\n+(other) Pair\n\tPair(1, 2) + Pair(3, -1) is Pair(4, 1)\n\tPair(real + other.real, imaginary + other.imaginary)"
constant PairB = "Squared Pair\n\tPair(1, 2).Squared is Pair(-3, 4)\n\tPair(real * real - imaginary * imaginary, 2 * real * imaginary)\nSquaredLength Number\n\tPair(3, 4).SquaredLength is 25\n\treal * real + imaginary * imaginary"
constant SimpleA = "has logger\nTable(count Number) Numbers\n\tSimpleRead(Logger).Table(2) is (0, 0.5)\n\tfor count\n\t\tindex / count\nRead(table Numbers, count Number) Numbers\n\tSimpleRead(Logger).Read((1, 2), 3) is (2, 4, 2)"
constant SimpleB = "\tfor count\n\t\ttable(index % table.Length) * 2\nRun\n\tlet read = Read(Table(1000), 2000000)\n\tlogger.Log(\"read \" + read(0) + \" \" + read(1999999))"
Run Number
	folder = "Compiler/output/ResidencyCheck" + 1000000.Random.Floor
	if Directory.Create(folder) is Error
		return Error("DirectoryNotCreated")
	result = Checked(folder)
	Directory.Delete(folder)
	if result is Error
		return result
	logger.Log("A list computed on the GPU from numbers alone stays there until the CPU reads it")
	0
Checked(folder Text) Boolean
	first = CheckPrimary(folder)
	if first is Error
		return first
	second = CheckSmallAndPair(folder)
	if second is Error
		return second
	third = CheckSimpleAndOrbit(folder)
	third is Error then third else CheckViewingAndPending(folder)
CheckPrimary(folder Text) Boolean
	out = BuiltAndRan(folder, "GpuResidency", PrimaryCode, true, true)
	if out is Error
		return out
	checkedOut = CheckedStrings(out, ResWantsA + ResWantsB, ResBansA + ResBansB)
	if checkedOut is Error
		return checkedOut
	if out.Split("Strict GPU download of 4194304 numbers").Length is not 2
		return Error("Averaged download count wrong")
	CheckedBytes(File(folder + "/codes.bin").ReadBytes)
PrimaryCode Text
	a = ResA1 + "\n" + ResA2 + "\n" + ResB1 + ResB2 + "\n" + ResC1 + "\n" + ResC2 + "\n" + ResD1
	a + "\n" + ResD2 + "\n" + PrimaryTail
PrimaryTail Text
	ResE1 + "\n" + ResE2 + "\n" + ResF1 + "\n" + ResF2 + "\n" + ResG1 + "\n" + ResG2
CheckedBytes(bytes Bytes) Boolean
	if bytes.Length is not ByteCount
		return Error("codes.bin wrong length: " + bytes.Length)
	for ByteCount
		if bytes(index) is not (index % ByteMod)
			return Error("codes.bin byte mismatch at " + index)
	true
CheckSmallAndPair(folder Text) Boolean
	small = BuiltAndRan(folder, "SmallGpu", SmallA + "\n" + SmallB + "\n" + SmallC, false, false)
	if small is Error or "gpu kernels 2, doubled 6, opened 2" is not in small
		return Error("SmallGpu failed: " + (small to Text))
	File(folder + "/Pair.strict").Write((PairA + "\n" + PairB).Split("\n"))
	pair = BuiltAndRan(folder, "PairEscape", EscapeSrc, false, false)
	pair is Error or "gpu kernels 1, 64 3" is not in pair then Error("PairEscape failed: " + (pair to Text)) else true
CheckSimpleAndOrbit(folder Text) Boolean
	simple = BuiltAndRan(folder, "SimpleRead", SimpleA + "\n" + SimpleB, false, false)
	if simple is Error or "read 0 1.998" is not in simple
		return Error("SimpleRead failed: " + (simple to Text))
	File(folder + "/Orbiting.strict").Write(OrbitingSrc.Split("\n"))
	orbit = BuiltAndRan(folder, "OrbitGpu", OrbitGpuSrc, false, false)
	orbit is Error or "gpu kernels 1, 3 6 32" is not in orbit then Error("OrbitGpu failed: " + (orbit to Text)) else true
CheckViewingAndPending(folder Text) Boolean
	File(folder + "/Pair.strict").Write(UpdatedPair.Split("\n"))
	File(folder + "/Viewing.strict").Write((ViewA + ViewB).Split("\n"))
	built = Process.RunTool(Process.Find("strict").executable, "build " + folder + "/Viewing.strict", ToolSeconds)
	if built.exitCode is not 0
		return Error("BuildViewingFailed: " + built.Output + built.error)
	ext = Process.OperatingSystem is "Windows" then ".exe" else ""
	tested = Process.RunTool(folder + "/obj/Viewing.test" + ext, "", ToolSeconds)
	if tested.exitCode is not 0
		return Error("Viewing native test failed: " + tested.Output + tested.error)
	pend = BuiltAndRan(folder, "PendingRead", PendingSrc, false, true)
	out = pend is Error then pend to Text else pend
	CheckedStrings(out, List(Text) + "halved 128 ", List(Text) + "Strict GPU download of 256 numbers")
UpdatedPair Text
	(PairA + "\n" + PairB).Replace("has imaginary Number\n", "has imaginary Number\nconstant Zero = Pair(0, 0)\n")
BuiltAndRan(folder Text, name Text, code Text, allGpu Boolean, downloads Boolean) Text
	File(folder + "/" + name + ".strict").Write(code.Split("\n"))
	built = Process.RunTool(Process.Find("strict").executable, "build " + folder + "/" + name + ".strict", ToolSeconds)
	if built.exitCode is not 0
		return Error("BuildFailed " + name + ": " + built.Output + built.error)
	win = Process.OperatingSystem is "Windows"
	dl = downloads then (win then "set STRICT_GPU_DOWNLOADS=1&& " else "STRICT_GPU_DOWNLOADS=1 ") else ""
	gStr = (win then "set STRICT_GPU=" + (allGpu then "all" else "") + "&& " else "STRICT_GPU= ") + dl
	target = "\"" + folder + "/" + name + (win then ".exe\"" else "\"")
	c1 = "cd " + (win then "/d " else "") + "\"" + folder + "\" && " + gStr + target
	ran = Process.RunTool(win then "cmd" else "sh", win then "/c " + c1 else "-c \"" + c1 + "\"", ToolSeconds)
	logger.Log(ran.Output.Trim)
	ran.exitCode is not 0 then Error("RunFailed " + name + ": " + ran.Output + ran.error) else ran.Output
CheckedStrings(output Text, wants Texts, bans Texts) Boolean
	for wants
		if value is not in output
			return Error("Missing output: " + value + "\n" + output)
	for bans
		if value is in output
			return Error("Unexpected output: " + value + "\n" + output)
	true
EscapeSrc Text
	mutable out = List(Text)
	out = out + "has logger\nEscaped(count Number) Numbers\n\tPairEscape(Logger).Escaped(2) is (3, 64)\n\tfor count"
	out = out + "\t\tlet c = Pair(index / count * 2 - 1.5, 0.5)\n\t\tmutable z = Pair(0, 0)\n\t\tmutable steps = 0"
	out = out + "\t\tfor 64\n\t\t\tif z.SquaredLength < 4\n\t\t\t\tz = z.Squared + c"
	out = out + "\t\t\t\tsteps = steps + 1\n\t\tsteps"
	out = out + "Run\n\tlet before = Process.Executed\n\tlet escaped = Escaped(2000000)\n\tlet after = Process.Executed"
	out = out + "\tlogger.Log(\"gpu kernels \" + (after(3) - before(3)) + \", \" + escaped(1000000) + \" \" + escaped(0))"
	Text.Combine(out, "\n")
OrbitingSrc Text
	mutable out = List(Text)
	out = out + "has orbit List(Pair)\nhas shift Pair\nEscaped(count Number) Numbers"
	out = out + "\tOrbiting((Pair(0, 0), Pair(0.5, 0.5)), Pair(-1.5, 0)).Escaped(2) is (32, 3)\n\tfor count"
	out = out + "\t\tlet reference = orbit(index % orbit.Length)"
	out = out + "\t\tSteps(reference, Pair(index / count, reference.imaginary) + shift)\nSteps(start Pair, c Pair) Number"
	out = out + "\tOrbiting((Pair(0, 0)), Pair(0, 0)).Steps(Pair(0, 0), Pair(2, 0)) is 1\n\tmutable z = start"
	out = out + "\tfor 32\n\t\tif z.SquaredLength >= 4\n\t\t\treturn index\n\t\tz = z.Squared + c\n\t32"
	Text.Combine(out, "\n")
OrbitGpuSrc Text
	mutable out = List(Text)
	out = out + "has logger\nOrbit(count Number) List(Pair)"
	out = out + "\tOrbitGpu(Logger).Orbit(2) is (Pair(0, 0.5), Pair(0.5, 0.25))"
	out = out + "\tfor count\n\t\tPair(index / count, 0.5 - index / count / 2)\nRun\n\tlet before = Process.Executed"
	out = out + "\tlet escaped = Orbiting(Orbit(1000), Pair(-1.5, 0)).Escaped(2000000)\n\tlet after = Process.Executed"
	out = out + "\tlogger.Log(\"gpu kernels \" + (after(3) - before(3)) + \", \" + escaped(0) + \" \" + escaped(1000000)"
	Text.Combine(out, "\n") + " + \" \" + escaped(1999999))"
PendingSrc Text
	mutable out = List(Text) + "has logger\nTable(count Number) Numbers\n\tPendingRead(Logger).Table(2) is (1, 1.125)"
	out = out + "\tfor count\n\t\tindex / 8 + 1\nSampled(table Numbers) Bytes"
	out = out + "\tPendingRead(Logger).Sampled((1, 2))(1) is 0\n\tfor 256"
	out = out + "\t\tlet start = table((index * 7919) % table.Length)\n\t\tmutable sum = 0\n\t\tfor table.Length / 10"
	out = out + "\t\t\tsum = sum + start / (index % 2 + 1)\n\t\t(sum / table.Length) % 200"
	out = out + "Halved(sampled Numbers) Numbers"
	out = out + "\tPendingRead(Logger).Halved((1, 2, 3, 4)) is (3, 7)\n\tfor sampled.Length / 2"
	out = out + "\t\tsampled(2 * index) + sampled(2 * index + 1)\nRun\n\tlet halved = Halved(Sampled(Table(2000000)))"
	out = out + "\tlogger.Log(\"halved \" + halved.Length + \" \" + halved(0))"
	Text.Combine(out, "\n")