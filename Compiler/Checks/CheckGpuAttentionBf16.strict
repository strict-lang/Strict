constant BuildSeconds = 120
constant CompileSeconds = 60
constant WriteSeconds = 30
constant RunSeconds = 60
constant ProgramHead = ("has logger", "Brains(input Numbers, factor Number) BFloat16s", "	AttentionBrains(Logger).Brains((0, 1), 131072) is (0, 131072)", "	for input.Length", "		input(index) * factor")
constant ProgramRun = ("Run", "	let table = Safetensors(\"attention.safetensors\", 32).Values(\"input\")", "	let numbers = Brains(table, 1)", "	let queries = Brains(table, 131072)")
constant ProgramTail = ("	let attended = Attention(queries, queries, numbers, 1, 1, 128, 128, false).Merged", "	logger.Log(\"attention \" + attended.Length + \" \" + attended.First + \" \" + attended.Last)")
constant WriterA = ("#define _CRT_SECURE_NO_WARNINGS", "#include <stdio.h>", "#include <stdint.h>", "#include <string.h>")
constant WriterB = ("int main(int c,char**v){FILE*f=fopen(v[1],\"wb\");uint64_t n=2113536;")
constant WriterC = ("  const char*h=\"{\\\"input\\\":{\\\"dtype\\\":\\\"F32\\\",\\\"shape\\\":[2113536],\\\"data_offsets\\\":[0,8454144]}}\";")
constant WriterD = ("  uint64_t hl=strlen(h),pl=hl+((-hl)&7);fwrite(&pl,8,1,f);fwrite(h,1,hl,f);for(uint64_t i=hl;i<pl;i++)fputc(' ',f);")
constant WriterE = ("  float pair[2]={0.0f,1.0f};for(uint64_t i=0;i<n/2;i++)fwrite(pair,4,2,f);fclose(f);return 0;}")
Run Number
	folder = "Compiler/output/AttentionBf16" + 1000000.Random.Floor
	if Directory.Create(folder) is Error
		return Error("DirectoryNotCreated")
	Check(folder)
	Directory.Delete(folder)
	0
Check(folder Text) slow
	isWin = Process.OperatingSystem is "Windows"
	if PreparedData(folder, isWin) is Error
		return Error("PrepareSafetensorsFailed")
	File(folder + "/AttentionBrains.strict").Write(ProgramHead + ProgramRun + ProgramTail)
	built = Process.RunTool(Process.Find("strict").executable, "build " + folder + "/AttentionBrains.strict", BuildSeconds)
	if built.exitCode is not 0
		return Error("BuildFailed: " + built.Output + built.error)
	VerifiedBuild(folder, isWin)
VerifiedBuild(folder Text, isWin Boolean) slow
	obj = folder + "/obj/AttentionBrains.runtime.ptx"
	ptx = Text.Combine(File(File(obj).Exists then obj else folder + "/AttentionBrains.runtime.ptx").ReadLines, "\n")
	if ptx is ""
		return Error("MissingRuntimePtx")
	if not Regex("mma\\.sync\\.aligned\\.m16n8k16\\.row\\.col\\.f32\\.bf16\\.bf16\\.f32").IsMatch(ptx)
		return Error("Bf16PromptAttentionStillConvertsToFp16")
	ran = RunGpu(folder, "AttentionBrains" + (isWin then ".exe" else ""))
	if ran.exitCode is not 0 or "attention 2113536 0 1" is not in ran.Output
		return Error("AttentionFailed: " + ran.Output + ran.error)
	logger.Log(ran.Output.Trim)
PreparedData(folder Text, isWin Boolean) slow
	cFile = folder + "/gen.c"
	exe = folder + "/gen" + (isWin then ".exe" else "")
	File(cFile).Write(WriterA + WriterB + WriterC + WriterD + WriterE)
	comp = Process.RunTool("clang", "-O2 \"" + cFile + "\" -o \"" + exe + "\"", CompileSeconds)
	if comp.exitCode is not 0
		return Error("CompileGenFailed: " + comp.Output + comp.error)
	if Process.RunTool(exe, "\"" + folder + "/attention.safetensors\"", WriteSeconds).exitCode is not 0
		return Error("WriteDataFailed")
RunGpu(folder Text, exe Text) ProcessResult slow
	win = Process.OperatingSystem is "Windows"
	env = win then "set STRICT_GPU=all&& " else "STRICT_GPU=all "
	cmd = "cd " + (win then "/d \"" + folder.Replace("/", "\\") else "\"" + folder) + "\" && " + env + exe
	Process.RunTool(win then "cmd" else "sh", win then "/c " + cmd else "-c \"" + cmd + "\"", RunSeconds)
