has root Text
constant Folders = Intermediates.CompilerFolders + ("Bytecode", "Bytecode/Binary", "Bytecode/Optimize", "Expressions", "Expressions/Syntax")
constant Range = 1000000007
constant Output = CodegenStamp("Compiler/output")
constant Waiting = CodegenStamp("Compiler/output/Waiting")
constant Promoting = CodegenStamp("Compiler/output/Promoting")
Hashed Text
	Output.Hashed is Output.Hashed
	Output.Hashed is not Waiting.Hashed
	mutable sum = 0
	for Sources
		sum = (sum + HashCode(value + "|" + File(value).ReadText).number % Range) % Range
	sum to Text
Sources Texts
	"./Compiler/MlirEquality.strict" is in CodegenStamp(".").Sources
	"./Compiler/Mlir/MlirTraits.strict" is in CodegenStamp(".").Sources
	"./Compiler/NativeRuntime.mlir" is not in CodegenStamp(".").Sources
	"./Compiler/CheckAudit.strict" is not in CodegenStamp(".").Sources
	"./Bytecode/FileCheck.strict" is not in CodegenStamp(".").Sources
	mutable files = Directory.Files(root, "*.strict")
	for Folders
		files = Directory.Exists(root + "/" + value) then files + Directory.Files(root + "/" + value, "*.strict") else files
	for files
		if IsCodegen(value, Path(value).FileName.text)
			value
IsCodegen(path Text, name Text) Boolean
	CodegenStamp(".").IsCodegen("./Compiler/MlirEquality.strict", "MlirEquality.strict")
	CodegenStamp(".").IsCodegen("./Compiler/SelfBuild.strict", "SelfBuild.strict") is false
	if name.StartsWith("Check") or name.EndsWith("Check.strict")
		return false
	if path.IndexOf("/Compiler/") >= 0
		return name.StartsWith("Mlir") or name is "CallGraph.strict" or name is "EmissionCache.strict"
	true
Pending(path Text)
	Directory.Create("Compiler/output/Waiting") is not Error
	Directory.Create("Compiler/output/Waiting/obj") is not Error
	File("Compiler/output/Waiting/obj/Strict.codegen.pending").Write("old") is not Error
	Waiting.Pending("Examples/Sum.strict") is not Error
	File("Compiler/output/Waiting/obj/Strict.codegen.pending").ReadText is "old"
	Waiting.Pending("Strict.strict") is not Error
	File("Compiler/output/Waiting/obj/Strict.codegen.pending").ReadText is Waiting.Hashed
	if Path(path).FileName.text is "Strict.strict"
		Directory.Create(root + "/obj")
		File(root + "/obj/Strict.codegen.pending").Write(Hashed)
Promote(executable Text)
	Directory.Create("Compiler/output/Promoting") is not Error
	Promoting.Pending("Strict.strict") is not Error
	Promoting.Promote(Process.Current.executable) is not Error
	File("Compiler/output/Promoting/obj/Strict.codegen.pending").Exists is false
	pending = File(root + "/obj/Strict.codegen.pending")
	if pending.Exists
		File(root + "/obj/Strict.codegen").Write(pending.ReadText + "\n" + File(executable).Modified)
		pending.Delete
Current(executable Text) Text
	Output.Pending("Strict.strict") is not Error
	Output.Promote(Process.Current.executable) is not Error
	Output.Current(Process.Current.executable) is "codegen " + Output.Hashed
	Output.Current("Compiler/output/missing.exe").StartsWith("Compiler/output/missing.exe|")
	stamp = File(root + "/obj/Strict.codegen")
	lines = stamp.Exists then stamp.ReadLines else List(Text)
	isOwn = lines.Length is 2 then lines(1) is File(executable).Modified to Text else false
	isOwn then "codegen " + lines(0) else executable + "|" + File(executable).Modified
