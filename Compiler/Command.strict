mutable cached EmissionMemory = EmissionMemory.Empty
constant Version = "1.0"
constant Commands = ("build", "test", "check", "update", "format", "suggest")
constant QuietSeconds = 5
constant Informing = ("version", "--version", "help", "--help")
constant RunHelp = List(Text) + "strict <file or Type> [arguments]  run the program natively (built first when outdated); a type without Run runs its native tests, not again while they passed and nothing changed"
constant CodeHelp = ("strict run -c <code> [arguments]  run these lines on the Strict VM (short: strict -c <code>)", "strict run <file.strict> [args]   run a single .strict script file on the Strict VM")
constant BuildHelp = ("strict build <file or Type>  compile a native executable without running tests (Name.test without Run)", "strict build [platform]    build the program named like this folder (in FractalZoomer/: FractalZoomer.strict)")
constant PlatformHelp = ("strict build <file> linux  also the Linux executable (on Windows through WSL)", "strict build <file> web  build Name.html, .js and .wasm for the browser (Emscripten in Tools/emsdk)")
constant EditHelp = "strict build <file> web edit  faster web build to try an edit (no wasm-opt, no Closure), publish with web"
constant AppHelp = ("strict build <file> android  build an arm64-v8a shared library and stage Release/Android (Android NDK)", "strict build <file> ios    build an arm64 iOS static archive and stage Release/iOS (native packages need Xcode)")
constant BuildModeHelp = ("strict build <file> library  build a shared library of its public methods and a C# binding", "strict build <file> fast   quick build for this computer, GPU loops run on the CPU (not for NeuralNetworks or games)")
constant TestHelp = ("strict test <file>         run the inline tests of every method on the Strict VM", "strict test <file> native  build and run its native tests explicitly")
constant TestInputHelp = ("strict test <folder> --no-recursive  test only files directly in folder", "strict test <file> -       test the source read from standard input as <file>, nothing is written")
constant LinesHelp = List(Text) + "strict test <file> lines   run them natively and print how often and how long each line ran (a folder: one build)"
constant ValuesHelp = List(Text) + "strict test <file> values  run them on the Strict VM and print how often each line ran and the value it set"
constant FullHelp = ("strict test <folder> full  remove its obj/ folders, then retest everything with Slow tests and all mutants", "strict build <file> full   remove the obj/ folders of its folder, then build everything again")
constant SourceHelp = ("strict check <folder>      validate the .strict files: type rules, unused members, limits", "strict format <file>       print the file in its canonical form, each method body as the parser reads it")
constant MaintenanceHelp = ("strict update <folder>     refresh the packages copied into the folder (.origin) from their clone or GitHub", "strict version             show the version number and when this strict executable was built")
constant SuggestHelp = List(Text) + "strict suggest <file> <method>  print bodies passing its tests; add - to read unsaved source"
constant Entry = "Compiler/Strict.strict"
constant Help = RunHelp + CodeHelp + BuildHelp + PlatformHelp + EditHelp + AppHelp + BuildModeHelp + TestHelp + TestInputHelp + LinesHelp + ValuesHelp + FullHelp + SourceHelp + MaintenanceHelp + SuggestHelp
constant FirstTraceLines = 3
constant LastTraceLines = 3
constant LongTrace = "Error: A\n\t1\n\t2\n\t3\n\t4\n\t5\n\t6\n\tat Strict.Logged in Strict.strict:line 66"
Shorten(trace Text) Text
	Command.Shorten("Error: A\n\t1") is "Error: A\n\t1"
	Command.Shorten(LongTrace) is "Error: A\n\t1\n\t2\n\t... (skipped 1 lines)\n\t4\n\t5\n\t6"
	logged = trace.LastIndexOf("\n\tat Strict.Logged ")
	lines = (logged < 0 then trace else trace.Substring(0, logged)).Split("\n")
	if lines.Length <= FirstTraceLines + LastTraceLines
		return Text.Combine(lines, "\n")
	gap = "\t... (skipped " + (lines.Length - FirstTraceLines - LastTraceLines) + " lines)"
	Text.Combine(lines.Slice(0, FirstTraceLines) + gap + lines.Slice(lines.Length - LastTraceLines, LastTraceLines), "\n")
Clean(command Text, rest Texts) Texts slow
	Command.Clean("build", ("Compiler/output/Clean/A.strict", ".", "full")).Last is "."
	Command.Clean("test", ("Compiler/output/Clean", ".", "full")).Last is "full"
	if "full" is not in rest
		return rest
	folder = Directory.Exists(rest(0)) then rest(0) else Path(rest(0)).PathOnly.text
	target = folder is "" then "." else folder
	logger.Log("Removed " + Folders.Clean(target) + " files in the obj folders of " + target)
	command is "build" then rest - "full" else rest
Message(command Text, rest Texts) Text slow
	Command.Message("version", List(Text)).StartsWith(Version + " 20")
	Command.Message("help", List(Text)).StartsWith("strict <file or Type> [arguments]  run")
	Command.Message("test", ("a.strict", ".")) is "a.strict not found"
	Command.Message("test", ("Compiler", ".")) is "" and Command.Message("check", ("Compiler", ".")) is ""
	Command.Message("suggest", (Entry, ".")).StartsWith("strict <file or Type> [arguments]  run")
	constant DateAndMinuteLength = 16
	if command is in ("version", "--version")
		return Version + " " + Process.Current.Built.Substring(0, DateAndMinuteLength)
	if command is in Informing or rest.Length < (command is "suggest" then 3 else 2)
		return Text.Combine(Help, "\n")
	isFolder = command is "test" and Directory.Exists(rest(0))
	command is in ("check", "update") or isFolder or File(rest(0)).Exists then "" else rest(0) + " not found"
AdviseBootstrap(base Text) Text
	Command.AdviseBootstrap("./Examples/obj/Sum") is ""
	Command.AdviseBootstrap("./Compiler/obj/Strict").StartsWith("\nThis strict is too old to build itself, run ")
	bootstrap = Process.OperatingSystem is "Windows" then "Compiler\\Bootstrap.cmd" else "sh Compiler/bootstrap.sh"
	Path(base).FileName.text.Lower is "strict" then "\nThis strict is too old to build itself, run " + bootstrap else ""
Root(arguments Texts) Texts slow
	Command.Root(List(Text) + "a.strict") is ("a.strict", ".")
	Command.Root(("a.strict", ".")) is ("a.strict", ".")
	Command.Root(("a.strict", "Compiler")) is ("a.strict", ".", "Compiler")
	Command.Root(("a.strict", "5")) is ("a.strict", ".", "5")
	if arguments.Length is 0 or arguments.Length > 1 and File(arguments(1) + "/Any.strict").Exists
		return arguments
	(List(Text) + arguments(0) + TypeSource.Root) + Rest(arguments)
FindMainFile(folder Text) Text slow
	Command.FindMainFile(".") is Entry
	Command.FindMainFile("Missing") is ""
	isCurrent = folder is "" or folder is "."
	target = (isCurrent then Directory.Current else folder).Replace("\\", "/")
	clean = target.EndsWith("/") and target.Length > 1 then target.Substring(0, target.Length - 1) else target
	named = TypeSource.Case((isCurrent then "" else clean + "/") + Path(clean).FileName.text)
	if named.EndsWith(".strict") and File(named).Exists
		return named
	files = Directory.Files(isCurrent then "." else clean, "*.strict")
	isCurrent and File(Entry).Exists then Entry else (files.Length is 1 then files.First else "")
InsertMainFile(arguments Texts) Texts slow
	Command.InsertMainFile(("build", "web")) is ("build", Entry, "web")
	Command.InsertMainFile(List(Text) + "build") is ("build", Entry)
	Command.InsertMainFile(("build", ".", "windows")) is ("build", Entry, "windows")
	Command.InsertMainFile(("build", "Examples/Sum.strict")) is ("build", "Examples/Sum.strict")
	Command.InsertMainFile(("test", "Math")) is ("test", "Math")
	Command.InsertMainFile(("test", "native")) is ("test", Entry, "native")
	Command.Project(Command.InsertMainFile(("build", "strict"))) is ("build", Entry)
	main = FindMainFile(".")
	if arguments.Length is 0
		return main is "" or main is Entry then arguments else List(Text) + main
	arguments(0) is in ("build", "test") then Resolve(arguments, main) else arguments
Resolve(arguments Texts, main Text) Texts slow
	Command.Resolve(("build", "."), Entry) is ("build", Entry)
	Command.Resolve(("test", "."), Entry) is ("test", ".")
	Command.Resolve(List(Text) + "test", Entry) is ("test", Entry)
	Command.Resolve(("build", "strict", "windows"), Entry) is ("build", Entry, "windows")
	given = arguments.Length > 1 then arguments(1) else ""
	if arguments(0) is "build" and (given is "." or Directory.Exists(given))
		folder = FindMainFile(given)
		return folder is "" then arguments else List(Text) + "build" + folder + arguments.Slice(2, arguments.Length - 2)
	if given.Lower is in ("strict", "strict.strict") and main is Entry
		return List(Text) + arguments(0) + Entry + arguments.Slice(2, arguments.Length - 2)
	isSource = given is not "" and IsSource(given)
	target = arguments(0) is "test" and main is "" then "." else main
	isSource or target is "" then arguments else List(Text) + arguments(0) + target + Rest(arguments)
IsSource(given Text) Boolean slow
	Command.IsSource("Examples/Sum") and Command.IsSource("Math")
	Command.IsSource("LICENSE") is false
	named = TypeSource.Case(given)
	named.EndsWith(".strict") and File(named).Exists or Directory.Exists(given)
Project(arguments Texts) Texts slow
	Command.Project(("test", "Examples/Sum.strict")) is ("test", "Examples/Sum.strict")
	Command.Project(("Examples/Sum", "5")) is ("Examples/Sum.strict", "5")
	Command.Project(("build", "Examples/Sum", "web")) is ("build", "Examples/Sum.strict", "web")
	at = arguments.Length > 0 and arguments(0) is in Commands then 1 else 0
	source = TypeSource.Case(arguments.Length > at then arguments(at) else "")
	project = source.EndsWith(".strict") or Directory.Exists(source) then TypeSource.Project(source) else ""
	full = TypeSource.Absolute(source)
	if project is not ""
		Directory.Change(project)
	for arguments
		index is at then (project is "" then source else TypeSource.Relative(full)) else value
Join(arguments Texts) Text
	Command.Join(("a b", "c")) is " \"a b\" c"
	mutable joined = ""
	for arguments
		joined = joined + " " + (value.IndexOf(" ") >= 0 then "\"" + value + "\"" else value)
	joined
Launch(rest Texts, folder Text) Number slow
	if NativeBuild.IsProgram(rest(0)) is false
		return Native("test", (rest(0), rest(1), "native"))
	base = NativeBuild.Output(rest(0), true)
	extension = Toolchain(Platform.Current, rest(1)).Extension
	cache = NativeCache("build", (rest(0), rest(1)))
	fresh = cache.IsCurrent then BuildOutput.Fresh(base, extension, List(Text)) else ""
	if fresh is ""
		tested = Retest(rest)
		if tested is not 0
			return tested
	Start(rest, folder, fresh)
Retest(rest Texts) Number slow
	quietUntil = Process.Elapsed + QuietSeconds
	tested = Execute("", quietUntil = quietUntil).Serve(rest(0), rest(1)).code
	if tested is 0 and Process.Elapsed >= quietUntil
		logger.Log(Execute.Summary(0, rest(0)))
	tested
Compile(rest Texts, fresh Text) Number slow
	if fresh is not ""
		return 0
	NativeCache("build", (rest(0), rest(1))).IsCurrent then 0 else Native("build", (rest(0), rest(1)))
Start(rest Texts, folder Text, fresh Text) Number slow
	base = NativeBuild.Output(rest(0), true)
	tools = Toolchain(Platform.Current, rest(1))
	built = Compile(rest, fresh)
	if built is not 0
		return built
	if fresh is not ""
		logger.Log("Up to date: " + fresh)
	target = TypeSource.Absolute(fresh is "" then tools.Executable(base) else fresh)
	Directory.Change(folder)
	Process(target).Start(Join(rest.Slice(2, rest.Length - 2)).Trim)
Rest(arguments Texts) Texts
	Command.Rest(("test", "a", "b")) is ("a", "b")
	for Range(1, arguments.Length)
		arguments(value)
Native(command Text, rest Texts, emission = EmissionMemory.Empty) Number slow
	Command.Native("test", ("Missing.strict", ".", "values", "other")) is 2
	mutable compiler = NativeCompiler
	code = compiler.RunCommand((List(Text) + command) + rest, emission)
	cached = compiler.cached
	code
Format(path Text) Text slow
	Command.Format("Examples/HelloLogger.strict").StartsWith("Run\n\tlogger.Log(")
	lines = RoundTrip.Tab(File(path).ReadLines)
	broken = FileCompiler.Unparsable(lines)
	if broken >= 0
		return Error(ResolveCheck.Locate(FileCompiler.Normalize(path), broken + 1, FileCheck.Problem(lines, broken)))
	Text.Combine(RoundTrip.Format(lines), "\n")
