has typeName Text
has register Number
has Amount Number
has label Text
to Text
	typeName + " r" + register to Text
IsLoadConstant Boolean
	typeName is "LoadConstantToRegister"
IsLoadVariable Boolean
	typeName is "LoadVariableToRegister"
IsStoreRegister Boolean
	typeName is "StoreRegisterToVariable"
IsStoreConstant Boolean
	typeName is "StoreConstantToVariable"
IsReturn Boolean
	typeName is "Return"
IsBinary Boolean
	CompInstruction.BinaryOp("Divide", 0, 1, 2).IsBinary is true
	typeName is in ("Add", "Subtract", "Multiply", "Divide", "Modulo")
IsCompare Boolean
	CompInstruction("LessThan", 0, 1, "2").IsCompare is true
	typeName is in ("Equal", "NotEqual", "GreaterThan", "LessThan")
ResultRegister Number
	CompInstruction.BinaryOp("Add", 0, 1, 2).ResultRegister is 2
	if IsBinary or IsCompare
		return label to Number
	register
LoadConstant(reg Number, number Number) CompInstruction
	CompInstruction.LoadConstant(0, 5).IsLoadConstant is true
	CompInstruction("LoadConstantToRegister", reg, number, "")
BinaryOp(name Text, left Number, right Number, result Number) CompInstruction
	CompInstruction.BinaryOp("Add", 0, 1, 2).IsBinary is true
	CompInstruction(name, left, right, result to Text)
ReturnOp(reg Number) CompInstruction
	CompInstruction.ReturnOp(0).IsReturn is true
	CompInstruction("Return", reg, 0, "")