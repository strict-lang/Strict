has instructions CompInstructions
Count Number
	instructions.Length
At(index Number) CompInstruction
	CompList.Empty.At(1).IsReturn is true
	if index < 0 or index >= instructions.Length
		return CompInstruction.ReturnOp(0)
	instructions(index)
Append(instruction CompInstruction) CompList
	CompList.Empty.Append(CompInstruction.ReturnOp(1)).Count is 1
	mutable next = List(Mutable(CompInstruction))
	for instructions
		next.Add(value)
	next.Add(instruction)
	CompList(next)
SimpleAdd(seed Number) CompList
	CompList.SimpleAdd(0).Count is 4
	let first = CompList.Empty.Append(CompInstruction("LoadConstantToRegister", 0, 2 + seed, "2"))
	let second = first.Append(CompInstruction("LoadConstantToRegister", 1, 3 + seed, "3"))
	second.Append(CompInstruction("Add", 0, 1, "2")).Append(CompInstruction.ReturnOp(2))
Empty CompList
	CompList.Empty.Count is 0
	constant noInstructions = List(CompInstruction)
	CompList(noInstructions)
to Text
	"ops=" + Count to Text