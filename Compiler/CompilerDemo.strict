has logger
Run
	logger.Log("=== Strict native compiler demo ===")
	Directory.Create("Compiler/output")
	constant platform = Platform.Current
	constant build = NativeBuild("Compiler/output/add.asm", platform)
	logger.Log(build.WriteAsm(InstructionsToNasm.SimpleAdd(platform).Compile))
	logger.Log(build.Assemble)
	constant exePath = "Compiler/output/add" + NasmFormat(platform).ExeExtension
	logger.Log(build.Link(exePath))
	logger.Log(Process(exePath).Run(""))