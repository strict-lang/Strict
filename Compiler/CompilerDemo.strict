has logger
Run
	logger.Log("=== Strict native compiler demo ===")
	Directory.Create("Compiler/output")
	constant build = NativeBuild("Compiler/output/add.asm", Platform.Windows)
	logger.Log(build.WriteAsm(InstructionsToNasm.SimpleAdd(Platform.Windows).Compile))
	logger.Log(build.Assemble)
	logger.Log(build.Link("Compiler/output/add.exe"))
	logger.Log(Process("Compiler/output/add.exe").Run(""))