has logger
Run
	logger.Log("=== Strict native compiler demo ===")
	logger.Log(Process.Find("nasm"))
	Directory.Create("Compiler/output")
	constant asm = InstructionsToNasm.Empty.CompileSimpleAdd(Platform.Windows)
	logger.Log(asm)
	File("Compiler/output/add.asm").Write(asm)
	logger.Log("wrote Compiler/output/add.asm")
	constant nasm = Process.RunTool("nasm", "-f win64 Compiler/output/add.asm -o Compiler/output/add.obj")
	logger.Log(nasm)
	constant link = Process.RunTool("gcc", "Compiler/output/add.obj -o Compiler/output/add.exe -s")
	logger.Log(link)