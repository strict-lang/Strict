has tools Toolchain
has isShipped Boolean = true
constant Local = CubinBuild(Toolchain(Platform.Current, "."))
constant Cubin = "Compiler/output/Cubin"
constant Outdating = "Compiler/output/Outdated"
constant Emptied = "Compiler/output/Emptied"
constant Broken = "Compiler/output/Broken"
constant Tiny = ".version 7.8\n.target sm_75\n.address_size 64\n.visible .entry tiny()\n{\n\tret;\n}"
constant Architectures = ("sm_75", "sm_86", "sm_89", "sm_120")
Fatbin(base Text) Text
	Local.Fatbin("Compiler/output/missing") is ""
	File("Compiler/output/missing.fatbin").Exists is false
	PtxCache(Cubin).HasWritten(List(Text) + Tiny, ".ptx")
	Local.Fatbin(Cubin) is ""
	File(Cubin + ".fatbin").Exists is (Local.tools.Locate("ptxas") is not "")
	ptxas = IsOutdated(base) and isShipped then tools.Locate("ptxas") else ""
	if ptxas is "" or File(base + ".ptx").Exists is false
		return ""
	stem = base + "." + 1000000000.Random.Floor
	failures = Cubins(ptxas, base, stem)
	packed = Pack(stem, base)
	failures.Length > 0 then failures.First else packed
IsOutdated(base Text) Boolean
	PtxCache(Outdating).Save((".fatbin", ".ptx"), ("old", "// newer")) is not Error
	CubinBuild(Local.tools, false).Fatbin(Outdating) is ""
	File(Outdating + ".fatbin").Exists is false
	ptx = File(base + ".ptx")
	target = File(base + ".fatbin")
	if ptx.Exists and target.Exists and target.Modified > ptx.Modified
		return false
	target.Delete
	true
Cubins(ptxas Text, base Text, stem Text) Texts
	Local.Cubins("ptxas", "Compiler/output/missing", "Compiler/output/missing").First.StartsWith("ptxas failed")
	PtxCache(Emptied).Save((".ptx", ".older.ptx"), (Tiny, "")) is not Error
	(Local.Cubins("ptxas", Emptied, Emptied).Length is 0) is (Local.tools.Locate("ptxas") is not "")
	constant splitting = " --split-compile 8 "
	mutable arguments = List(Mutable(Text))
	for Architectures
		source = value is "sm_75" and File(base + ".older.ptx").Length > 0 then ".older.ptx" else ".ptx"
		output = tools.Quote(stem + "." + value + ".cubin")
		arguments.Add("-arch=" + value + splitting + tools.Quote(base + source) + " -o " + output)
	for ToolRunner(ptxas).ExecuteAll(arguments, "GPU cubins " + Path(base).FileName.text)
		if value.HasFailed
			"ptxas failed: " + value.error
Pack(stem Text, base Text) Text
	Local.Pack("Compiler/output/missing", "Compiler/output/missing").StartsWith("fatbinary failed")
	PtxCache(Broken).Save((".ptx", ".older.ptx"), (Tiny, "broken")) is not Error
	Local.Fatbin(Broken).StartsWith("ptxas failed") or Local.tools.Locate("ptxas") is ""
	Directory.Files("Compiler/output", "Broken.*.cubin").Length is 0
	arguments = "--compress-all --create=" + tools.Quote(stem + ".fatbin") + Images(stem)
	packed = ToolRunner(tools.Locate("fatbinary")).Execute(arguments)
	for Architectures
		File(stem + "." + value + ".cubin").Delete
	if packed.HasFailed
		return "fatbinary failed: " + packed.error
	File(stem + ".fatbin").Rename(base + ".fatbin")
	""
Images(stem Text) Text
	Local.Images("a").EndsWith(" --image3=kind=elf,sm=120,file=\"a.sm_120.cubin\"")
	mutable images = ""
	for Architectures
		cubin = tools.Quote(stem + "." + value + ".cubin")
		images = images + " --image3=kind=elf,sm=" + value.Substring(3) + ",file=" + cubin
	images
Ship(source Text, target Text) Text
	PtxCache("Compiler/output/Shipped").Save(".fatbin", "stale") is not Error
	Local.Ship("Compiler/output/missing", "Compiler/output/Shipped") is ""
	File("Compiler/output/Shipped.fatbin").Exists is false
	failed = Fatbin(source)
	binary = File(source + ".fatbin")
	if binary.Exists
		File(target + ".fatbin").Write(binary.ReadBytes)
	if binary.Exists is false
		File(target + ".fatbin").Delete
	failed
