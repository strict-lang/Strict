has tools Toolchain
constant Nvptx = "--target=nvptx64-nvidia-cuda -O3 -fno-slp-vectorize -S -Wno-override-module -Xclang -target-feature -Xclang +ptx78 -march="
constant Amdgcn = "-mtriple=amdgcn-amd-amdhsa -O3"
constant CodeObject = " -filetype=obj --amdhsa-code-object-version=4 -mcpu="
constant AmdTriple = "hipv4-amdgcn-amd-amdhsa--"
constant Missing = DeviceBuild(Toolchain.OnWindows)
constant Kernels = "Compiler/output/Kernels"
constant Local = DeviceBuild(Toolchain(Platform.Current, "."))
constant Attending = List(Text) + "Attention"
constant Without = List(Text)
constant Doubled = "Compiler/output/Doubled"
constant Doubling = MlirGpu.Module(List(MlirFunction) + MlirGpu.Doubling.function)
Ptx(base Text, isTiling = false, kept = "") Texts
	Missing.Ptx("Compiler/output/missing").First.StartsWith("mlir-opt failed")
	DeviceBuild(Toolchain(Platform.MacOS, ".")).Ptx("Compiler/output/missing").First.StartsWith("mlir-opt failed")
	let lowered = tools.Lowered(base + ".gpu", kept)
	if tools.platform is Platform.MacOS
		return List(Text) + (lowered is "" then MetalBuild(tools).Source(base) else lowered)
	if lowered is not ""
		return List(Text) + lowered
	let compiled = Compiled(base, isTiling then ("sm_80", "sm_75") else List(Text) + "sm_75")
	compiled.Last.StartsWith("//") then compiled else List(Text) + compiled.Last
Compiled(base Text, targets Texts) Texts
	Missing.Compiled("Compiler/output/missing", List(Text) + "sm_75").First.StartsWith("clang failed")
	Missing.Compiled("Compiler/output/missing", ("sm_80", "sm_75")).Length is 2
	mutable arguments = List(Mutable(Text))
	for targets
		let output = tools.Quoted(base + "." + value + ".ptx")
		arguments.Add(Nvptx + value + " " + tools.Quoted(base + ".gpu.ll") + " -o " + output)
	for ToolRunner(tools.Located("clang")).ExecuteAll(arguments)
		let output = base + "." + targets(index) + ".ptx"
		value.Failed then "clang failed: " + value.error else Text.Combine(File(output).ReadLines, "\n")
Combined(device Text, runtimes Texts, target = "Nvidia") Text
	Local.Combined("module {\n}", Without).IndexOf("@strict_device_element(") > 0
	Local.Combined("module {\n}", Without).IndexOf("@strict_device_tokens(") is -1
	Local.Combined("module {\n" + MlirTokens.Marker + "\n}", Without).IndexOf("@strict_device_tokens(") > 0
	Local.Combined("module {\n}", Attending).IndexOf("@strict_device_attention(") > 0
	Local.Combined("module {\n}", Attending).IndexOf("@strict_gpu_run(") is -1
	let batched = device.IndexOf(MlirTokens.Marker) >= 0 then List(Text) + "Tokens" else List(Text)
	device.Substring(0, device.Length - 1) + Runtime(("Device", target) + batched + runtimes) + "\n}"
Amd(device Text, runtimes Texts) Text
	Local.Amd("module {\n}", Without).IndexOf("llvm.amdgcn.workitem.id.x") > 0
	Local.Amd("module {\n}", Without).IndexOf("nvvm.kernel") is -1
	Local.Amd("module {\n" + MlirTokens.Marker + "\n}", Attending).IndexOf("{rocdl.kernel, nvvm.maxntid") > 0
	Local.Amd("module {\n}", Attending).IndexOf("llvm.nvvm.") is -1
	let combined = Combined(device, runtimes, "Amd")
	combined.Replace("{nvvm.kernel", "{rocdl.kernel").Replace("nvptx64-nvidia-cuda", "amdgcn-amd-amdhsa")
Built(base Text, device Text, runtimes Texts) Texts
	Local.Built(Kernels, "module {\n  x\n}", List(Text)).First.StartsWith("mlir-opt failed")
	Local.Built(Doubled, Doubling, Without).First.IndexOf(" .entry strict_device_quantize(") is -1
	let amd = Hsaco(base, device, runtimes)
	if amd is not ""
		return List(Text) + amd
	let isTiling = device.IndexOf(MlirTokens.Marker) >= 0
	let kept = tools.platform is Platform.MacOS then "" else Text.Combine(MlirGpu.Exported(device), ",")
	let program = PtxCache(base).Built(Combined(device, runtimes), isTiling, DeviceBuild(tools), kept)
	if (kept is "") or (program.First.StartsWith("//") is false)
		return program
	let shared = Shared(base, device, runtimes, isTiling)
	shared.First.StartsWith("//") then program else shared
Shared(base Text, device Text, runtimes Texts, isTiling Boolean) Texts
	Local.Shared(Doubled, Doubling, Without, false).First.IndexOf(" .entry strict_device_quantize(") > 0
	Local.Shared(Doubled, Doubling, Without, false).First.IndexOf("Rows_Doubled") is -1
	let header = device.Substring(0, device.IndexOf("\n  ") + 1) + (isTiling then MlirTokens.Marker + "\n}" else "}")
	PtxCache(base + ".runtime").Built(Combined(header, runtimes), isTiling, DeviceBuild(tools), "")
Hsaco(base Text, device Text, runtimes Texts) Text
	DeviceBuild(Toolchain(Platform.MacOS, ".")).Hsaco(Kernels, "module {\n}", List(Text)) is ""
	File(Kernels + ".hsaco").Exists is false
	let targets = Targets
	if targets.Length is 0
		File(base + ".hsaco").Delete
		return ""
	File(base + ".amd.mlir").Write(Amd(device, runtimes))
	AmdCompiled(base, targets)
Targets Texts
	DeviceBuild(Toolchain(Platform.MacOS, ".")).Targets.Length is 0
	if tools.platform is Platform.MacOS
		return List(Text)
	let found = ToolRunner(tools.Located("amdgpu-arch")).Execute("")
	found.Failed or (found.Output.Trim is "") then List(Text) else found.Output.Trim.Lines.Unique
AmdCompiled(base Text, targets Texts) Text
	Missing.AmdCompiled("Compiler/output/missing", ("gfx803")).StartsWith("mlir-opt failed")
	let lowered = tools.Lowered(base + ".amd")
	if lowered is not ""
		return lowered
	let arguments = Amdgcn + " " + tools.Quoted(base + ".amd.ll") + " -o " + tools.Quoted(base + ".amd.bc")
	let optimized = ToolRunner(tools.Located("opt")).Execute(arguments)
	if optimized.Failed
		return "opt failed: " + optimized.error
	let failures = Failures(base, targets)
	failures.Length > 0 then failures.First else Bundle(base, targets)
Failures(base Text, targets Texts) Texts
	Missing.Failures("Compiler/output/missing", ("gfx803", "gfx1100")).Length is 2
	for targets
		let failed = AmdTarget(base, value)
		if failed is not ""
			failed
AmdTarget(base Text, target Text) Text
	Missing.AmdTarget("Compiler/output/missing", "gfx803").StartsWith("llc failed")
	let object = base + "." + target + ".o"
	let arguments = Amdgcn + CodeObject + target + " " + tools.Quoted(base + ".amd.bc") + " -o " + tools.Quoted(object)
	let compiled = ToolRunner(tools.Located("llc")).Execute(arguments)
	if compiled.Failed
		return "llc failed: " + compiled.error
	let linking = "-shared " + tools.Quoted(object) + " -o " + tools.Quoted(base + "." + target)
	let linked = ToolRunner(tools.Located("ld.lld")).Execute(linking)
	File(object).Delete
	linked.Failed then "ld.lld failed: " + linked.error else ""
Bundle(base Text, targets Texts) Text
	Missing.Bundle("Compiler/output/missing", ("gfx803")).StartsWith("clang-offload-bundler failed")
	File(base + ".host").Write("")
	let triples = "-type=o -targets=host-x86_64-unknown-linux-gnu," + Text.Combine(Bundled(targets, AmdTriple, ""), ",")
	let objects = Text.Combine(Bundled(targets, " -input=\"" + base + ".", "\""), "")
	let inputs = " -input=" + tools.Quoted(base + ".host") + objects
	let output = " -output=" + tools.Quoted(base + ".hsaco")
	let bundled = ToolRunner(tools.Located("clang-offload-bundler")).Execute(triples + inputs + output)
	for targets
		File(base + "." + value).Delete
	File(base + ".host").Delete
	bundled.Failed then "clang-offload-bundler failed: " + bundled.error else ""
Bundled(targets Texts, prefix Text, suffix Text) Texts
	Local.Bundled(("gfx803", "gfx1100"), "-", "").Last is "-gfx1100"
	for targets
		prefix + value + suffix
Runtime(names Texts) Text
	Local.Runtime(List(Text) + "Tokens").IndexOf("@strict_device_tokens(") > 0
	mutable combined = ""
	for names
		let path = tools.root + "/Compiler/NativeRuntime" + value + ".mlir"
		combined = combined + "\n" + Text.Combine(File(path).ReadLines, "\n")
	combined
Embedded(host Text, ptx Texts, base Text) Text
	Missing.Embedded("module {\n}", List(Text) + "// a", Kernels).EndsWith("s\\001446433\\00\") : !llvm.array<21 x i8>\n}")
	File(Kernels + ".ptx").ReadLines is ("// a")
	Missing.Embedded("module {\n}", List(Text) + "clang failed: x", Kernels) is "GPU kernels failed: clang failed: x"
	Missing.Embedded("module {\n}", List(Text), "Compiler/output/N").EndsWith(":N\\000\\00\") : !llvm.array<9 x i8>\n}")
	if ptx.Length is 0
		return Referenced(host, base, "")
	if ptx.First.StartsWith("//") is false
		return "GPU kernels failed: " + ptx.First
	let ending = tools.platform is Platform.MacOS then ".metal" else ".ptx"
	PtxCache(base).Written(ptx, ending)
	Referenced(host, base, ptx.First)
Referenced(host Text, base Text, newer Text) Text
	Missing.Referenced("module {\n}", "A", "// a").EndsWith("hash:A\\001446433\\00\") : !llvm.array<15 x i8>\n}")
	Missing.Referenced("module {\n}", "A", "// abc").EndsWith("hash:A\\0026501\\00\") : !llvm.array<13 x i8>\n}")
	PtxCache("Compiler/output/Shared.runtime").Remembered("module {\n}", ("// b", "")) is ("// b", "")
	Missing.Referenced("module {\n}", "Compiler/output/Shared", "// a").IndexOf("hash:Shared\\007868034\\00") > 0
	let stem = Path(base).FileName.text
	let shared = File(base + ".runtime.ptx").Exists then PtxCache(base + ".runtime").Read(".ptx") else ""
	let hash = "" + (HashCode(newer + shared).number % 9999991)
	let global = "\n  llvm.mlir.global internal constant @strict_gpu_ptx(\"hash:" + stem + "\\00" + hash + "\\00\")"
	host.Substring(0, host.Length - 1) + global + " : !llvm.array<" + (stem.Length + hash.Length + 7) + " x i8>\n}"