has tools Toolchain
has isShipped Boolean = false
constant Nvptx = "--target=nvptx64-nvidia-cuda -O3 -fno-slp-vectorize -S -Wno-override-module -Xclang -target-feature -Xclang +ptx78 -march="
constant Amdgcn = "-mtriple=amdgcn-amd-amdhsa -O3"
constant CodeObject = " -filetype=obj --amdhsa-code-object-version=4 -mcpu="
constant AmdTriple = "hipv4-amdgcn-amd-amdhsa--"
constant Missing = DeviceBuild(Toolchain.OnWindows)
constant Kernels = "Compiler/output/Kernels"
constant Local = DeviceBuild(Toolchain(Platform.Current, "."))
constant Attending = List(Text) + "Attention"
constant Without = List(Text)
constant Doubled = "Compiler/output/Doubled"
constant Doubling = MlirGpu.Module(List(MlirFunction) + MlirGpu.Doubling.function)
Ptx(base Text, isTiling = false, kept = "") Texts
	Missing.Ptx("Compiler/output/missing").First.StartsWith("mlir-opt failed")
	DeviceBuild(Toolchain(Platform.MacOS, ".")).Ptx("Compiler/output/missing").First.StartsWith("mlir-opt failed")
	lowered = tools.Lower(base + ".gpu", kept)
	if tools.platform is Platform.MacOS
		return List(Text) + (lowered is "" then MetalBuild(tools).Source(base) else lowered)
	if lowered is not ""
		return List(Text) + lowered
	compiled = Compile(base, isTiling then ("sm_80", "sm_75") else List(Text) + "sm_75")
	compiled.Last.StartsWith("//") then compiled else List(Text) + compiled.Last
Compile(base Text, targets Texts) Texts
	Missing.Compile("Compiler/output/missing", List(Text) + "sm_75").First.StartsWith("clang failed")
	Missing.Compile("Compiler/output/missing", ("sm_80", "sm_75")).Length is 2
	mutable arguments = List(Mutable(Text))
	for targets
		output = tools.Quote(base + "." + value + ".ptx")
		arguments.Add(Nvptx + value + " " + tools.Quote(base + ".gpu.ll") + " -o " + output)
	phase = "GPU PTX " + Path(base).FileName.text + " (" + Text.Combine(targets, ", ") + ")"
	for ToolRunner(tools.Locate("clang")).ExecuteAll(arguments, phase)
		output = base + "." + targets(index) + ".ptx"
		value.HasFailed then "clang failed: " + value.error else Text.Combine(File(output).ReadLines, "\n")
Combine(device Text, runtimes Texts, target = "Nvidia") Text
	Local.Combine("module {\n}", Without).IndexOf("@strict_device_element(") > 0
	Local.Combine("module {\n}", Without).IndexOf("@strict_device_tokens(") is -1
	Local.Combine("module {\n" + MlirTokens.Marker + "\n}", Without).IndexOf("@strict_device_tokens(") > 0
	Local.Combine("module {\n}", Attending).IndexOf("@strict_device_attention(") > 0
	Local.Combine("module {\n}", Attending).IndexOf("@strict_gpu_run(") is -1
	Local.Combine("module {\n}", Without).IndexOf("%widthRow = arith.minui %at, %count : i64") > 0
	batched = device.IndexOf(MlirTokens.Marker) >= 0 then List(Text) + "Tokens" else List(Text)
	device.Substring(0, device.Length - 1) + Runtime(("Device", target) + batched + runtimes) + "\n}"
Amd(device Text, runtimes Texts) Text
	Local.Amd("module {\n}", Without).IndexOf("llvm.amdgcn.workitem.id.x") > 0
	Local.Amd("module {\n}", Without).IndexOf("nvvm.kernel") is -1
	Local.Amd("module {\n" + MlirTokens.Marker + "\n}", Attending).IndexOf("{rocdl.kernel, nvvm.maxntid") > 0
	Local.Amd("module {\n}", Attending).IndexOf("llvm.nvvm.") is -1
	combined = Combine(device, runtimes, "Amd")
	combined.Replace("{nvvm.kernel", "{rocdl.kernel").Replace("nvptx64-nvidia-cuda", "amdgcn-amd-amdhsa")
Build(base Text, device Text, runtimes Texts) Texts
	Local.Build(Kernels, "module {\n  x\n}", List(Text)).First.StartsWith("mlir-opt failed")
	Local.Build(Doubled, Doubling, Without).First.IndexOf(" .entry strict_device_quantize(") is -1
	amd = Hsaco(base, device, runtimes)
	if amd is not ""
		return List(Text) + amd
	isTiling = device.IndexOf(MlirTokens.Marker) >= 0 or "Attention" is in runtimes
	kept = tools.platform is Platform.MacOS then "" else Text.Combine(MlirGpu.Export(device), ",")
	program = PtxCache(base).Build(Combine(device, runtimes), isTiling, DeviceBuild(tools), kept)
	if kept is "" or program.First.StartsWith("//") is false
		return program
	shared = Share(base, device, runtimes, isTiling)
	shared.First.StartsWith("//") then program else shared
Share(base Text, device Text, runtimes Texts, isTiling Boolean) Texts
	Local.Share(Doubled, Doubling, Without, false).First.IndexOf(" .entry strict_device_quantize(") > 0
	Local.Share(Doubled, Doubling, Without, false).First.IndexOf("Rows_Doubled") is -1
	header = device.Substring(0, device.IndexOf("\n  ") + 1) + (isTiling then MlirTokens.Marker + "\n}" else "}")
	PtxCache(base + ".runtime").Share(Combine(header, runtimes), isTiling, DeviceBuild(tools, isShipped))
Hsaco(base Text, device Text, runtimes Texts) Text
	DeviceBuild(Toolchain(Platform.MacOS, ".")).Hsaco(Kernels, "module {\n}", List(Text)) is ""
	File(Kernels + ".hsaco").Exists is false
	targets = Targets
	if targets.Length is 0
		File(base + ".hsaco").Delete
		return ""
	File(base + ".amd.mlir").Write(Amd(device, runtimes))
	AmdCompile(base, targets)
Targets Texts
	DeviceBuild(Toolchain(Platform.MacOS, ".")).Targets.Length is 0
	Local.HasAmdDriver or Local.Targets.Length is 0
	if tools.platform is Platform.MacOS or HasAmdDriver is false
		return List(Text)
	found = ToolRunner(tools.Locate("amdgpu-arch")).Execute("")
	found.HasFailed or found.Output.Trim is "" then List(Text) else found.Output.Trim.Lines.Unique
HasAmdDriver Boolean
	Missing.HasAmdDriver is Local.HasAmdDriver
	folder = Process.Variable("SystemRoot") + "/System32"
	ToolRunner.IsWindows then Directory.Files(folder, "amdhip64*.dll").Length > 0 else Directory.Exists("/sys/class/kfd")
AmdCompile(base Text, targets Texts) Text
	Missing.AmdCompile("Compiler/output/missing", "gfx803").StartsWith("mlir-opt failed")
	lowered = tools.Lower(base + ".amd")
	if lowered is not ""
		return lowered
	arguments = Amdgcn + " " + tools.Quote(base + ".amd.ll") + " -o " + tools.Quote(base + ".amd.bc")
	optimized = ToolRunner(tools.Locate("opt")).Execute(arguments)
	if optimized.HasFailed
		return "opt failed: " + optimized.error
	failures = Failures(base, targets)
	failures.Length > 0 then failures.First else Bundle(base, targets)
Failures(base Text, targets Texts) Texts
	Missing.Failures("Compiler/output/missing", ("gfx803", "gfx1100")).Length is 2
	for targets
		failed = AmdTarget(base, value)
		if failed is not ""
			failed
AmdTarget(base Text, target Text) Text
	Missing.AmdTarget("Compiler/output/missing", "gfx803").StartsWith("llc failed")
	object = base + "." + target + ".o"
	arguments = Amdgcn + CodeObject + target + " " + tools.Quote(base + ".amd.bc") + " -o " + tools.Quote(object)
	compiled = ToolRunner(tools.Locate("llc")).Execute(arguments)
	if compiled.HasFailed
		return "llc failed: " + compiled.error
	linking = "-shared " + tools.Quote(object) + " -o " + tools.Quote(base + "." + target)
	linked = ToolRunner(tools.Locate("ld.lld")).Execute(linking)
	File(object).Delete
	linked.HasFailed then "ld.lld failed: " + linked.error else ""
Bundle(base Text, targets Texts) Text
	Missing.Bundle("Compiler/output/missing", "gfx803").StartsWith("clang-offload-bundler failed")
	File(base + ".host").Write("")
	triples = "-type=o -targets=host-x86_64-unknown-linux-gnu," + Text.Combine(BundleTargets(targets, AmdTriple, ""), ",")
	objects = Text.Combine(BundleTargets(targets, " -input=\"" + base + ".", "\""), "")
	inputs = " -input=" + tools.Quote(base + ".host") + objects
	output = " -output=" + tools.Quote(base + ".hsaco")
	bundled = ToolRunner(tools.Locate("clang-offload-bundler")).Execute(triples + inputs + output)
	for targets
		File(base + "." + value).Delete
	File(base + ".host").Delete
	bundled.HasFailed then "clang-offload-bundler failed: " + bundled.error else ""
BundleTargets(targets Texts, prefix Text, suffix Text) Texts
	Local.BundleTargets(("gfx803", "gfx1100"), "-", "").Last is "-gfx1100"
	for targets
		prefix + value + suffix
Runtime(names Texts) Text
	Local.Runtime(List(Text) + "Tokens").IndexOf("@strict_device_tokens(") > 0
	mutable combined = ""
	for names
		path = tools.root + "/Compiler/NativeRuntime" + value + ".mlir"
		combined = combined + "\n" + Text.Combine(File(path).ReadLines, "\n")
	combined
Emb(host Text, ptx Texts, base Text) Text
	Missing.Emb("module {\n}", List(Text) + "// a", Kernels).EndsWith("s\\001446433\\00\") : !llvm.array<21 x i8>\n}")
	File(Kernels + ".ptx").ReadLines is ("// a")
	Missing.Emb("module {\n}", List(Text) + "clang failed: x", Kernels) is "GPU kernels failed: clang failed: x"
	Missing.Emb("module {\n}", List(Text), "Compiler/output/N").EndsWith(":N\\000\\00\") : !llvm.array<9 x i8>\n}")
	if ptx.Length is 0
		return Reference(host, base, "")
	if ptx.First.StartsWith("//") is false
		return "GPU kernels failed: " + ptx.First
	ending = tools.platform is Platform.MacOS then ".metal" else ".ptx"
	written = PtxCache(base).IsWritten(ptx, ending) or PtxCache(base).HasWritten(ptx, ending)
	failure = written then CubinBuild(tools, isShipped).Fatbin(base) else "could not write " + base + ending
	failure is "" then Reference(host, base, ptx.First) else "GPU kernels failed: " + failure
Reference(host Text, base Text, newer Text) Text
	Missing.Reference("module {\n}", "A", "// a").EndsWith("hash:A\\001446433\\00\") : !llvm.array<15 x i8>\n}")
	Missing.Reference("module {\n}", "A", "// abc").EndsWith("hash:A\\0026501\\00\") : !llvm.array<13 x i8>\n}")
	PtxCache("Compiler/output/Shared.runtime").Remember("module {\n}", ("// b", "")) is ("// b", "")
	Missing.Reference("module {\n}", "Compiler/output/Shared", "// a").IndexOf("hash:Shared\\007868034\\00") > 0
	stem = Path(base).FileName.text
	shared = File(base + ".runtime.ptx").Exists then PtxCache(base + ".runtime").Read(".ptx") else ""
	constant hashModulus = 9999991
	hash = "" + (HashCode(newer + shared).number % hashModulus)
	global = "\n  llvm.mlir.global internal constant @strict_gpu_ptx(\"hash:" + stem + "\\00" + hash + "\\00\")"
	declared = global + " : !llvm.array<" + (stem.Length + hash.Length + 7) + " x i8>\n}"
	host.Substring(0, host.Length - 1) + declared