has tools Toolchain
constant Nvptx = "--target=nvptx64-nvidia-cuda -O3 -S -Wno-override-module -march="
constant Missing = DeviceBuild(Toolchain.OnWindows)
constant Kernels = "Compiler/output/Kernels"
constant Local = DeviceBuild(Toolchain(Platform.Current, "."))
Ptx(base Text, isTiling = false) Texts
	Missing.Ptx("Compiler/output/missing").First.StartsWith("mlir-opt failed")
	let lowered = tools.Lowered(base + ".gpu")
	let older = lowered is "" then Compiled(base, "sm_75") else lowered
	(isTiling is false) or (older.StartsWith("//") is false) then List(Text) + older else (Compiled(base, "sm_80"), older)
Compiled(base Text, target Text) Text
	Missing.Compiled("Compiler/output/missing", "sm_75").StartsWith("clang failed")
	let output = base + "." + target + ".ptx"
	let arguments = Nvptx + target + " " + tools.Quoted(base + ".gpu.ll") + " -o " + tools.Quoted(output)
	let compiled = ToolRunner(tools.Located("clang")).Execute(arguments)
	compiled.Failed then "clang failed: " + compiled.error else Text.Combine(File(output).ReadLines, "\n")
Combined(device Text, isAttending = false) Text
	Local.Combined("module {\n}").IndexOf("@strict_device_element(") > 0
	Local.Combined("module {\n}").IndexOf("@strict_device_tokens(") is -1
	Local.Combined("module {\n" + MlirTokens.Marker + "\n}").IndexOf("@strict_device_tokens(") > 0
	Local.Combined("module {\n}", true).IndexOf("@strict_device_attention(") > 0
	let batched = device.IndexOf(MlirTokens.Marker) >= 0 then "\n" + Runtime("Tokens") else ""
	let attending = isAttending then "\n" + Runtime("Attention") else ""
	device.Substring(0, device.Length - 1) + Runtime("Device") + batched + attending + "\n}"
Runtime(name Text) Text
	Local.Runtime("Tokens").IndexOf("@strict_device_tokens(") > 0
	Text.Combine(File(tools.root + "/Compiler/NativeRuntime" + name + ".mlir").ReadLines, "\n")
Embedded(host Text, ptx Texts, base Text) Text
	Missing.Embedded("module {\n}", List(Text) + "// a", Kernels).EndsWith("file:Kernels\\00\") : !llvm.array<13 x i8>\n}")
	File(Kernels + ".ptx").ReadLines is ("// a")
	Missing.Embedded("module {\n}", List(Text) + "clang failed: x", Kernels) is "GPU kernels failed: clang failed: x"
	if ptx.First.StartsWith("//") is false
		return "GPU kernels failed: " + ptx.First
	File(base + ".ptx").Write(ptx.First)
	File(base + ".older.ptx").Write(ptx.Length > 1 then ptx.Last else "")
	let stem = Path(base).FileName.text
	let global = "\n  llvm.mlir.global internal constant @strict_gpu_ptx(\"file:" + stem + "\\00\")"
	host.Substring(0, host.Length - 1) + global + " : !llvm.array<" + (stem.Length + 6) + " x i8>\n}"