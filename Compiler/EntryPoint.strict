has dummy Number
Build(methodName Text, platform Number) Text
	if platform is Platform.Windows
		return WindowsMain(methodName)
	if platform is Platform.Linux
		return LinuxStart(methodName)
	if platform is Platform.MacOS
		return MacMain(methodName)
	LinuxStart(methodName)
WindowsMain(methodName Text) Text
	WinHead + methodName + WinTail
WinHead Text
	constant nl = "\n"
	constant top = nl + "extern ExitProcess" + nl + nl + "global main" + nl
	top + nl + "main:" + nl + "push rbp" + nl + "mov rbp, rsp" + nl + "sub rsp, 32" + nl + "call "
WinTail Text
	constant nl = "\n"
	nl + "xor rcx, rcx" + nl + "call ExitProcess" + nl + "ret"
LinuxStart(methodName Text) Text
	LinHead + methodName + LinTail
LinHead Text
	constant nl = "\n"
	constant top = nl + "global _start" + nl + nl + "_start:" + nl
	top + "push rbp" + nl + "mov rbp, rsp" + nl + "call "
LinTail Text
	constant nl = "\n"
	nl + "mov rdi, 0" + nl + "mov rax, 60" + nl + "syscall"
MacMain(methodName Text) Text
	MacHead + methodName + MacTail
MacHead Text
	constant nl = "\n"
	constant top = nl + "global _main" + nl + nl + "_main:" + nl
	top + "push rbp" + nl + "mov rbp, rsp" + nl + "call "
MacTail Text
	constant nl = "\n"
	nl + "xor rdi, rdi" + nl + "mov rax, 0x2000001" + nl + "syscall"
Empty EntryPoint
	EntryPoint(0)