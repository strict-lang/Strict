has given Texts
constant Options = ("windows", "linux", "web", "edit", "android", "ios", "fast", "library", "full")
IsBare Boolean
	FolderBuild(List(Text) + "build").IsBare and FolderBuild(("build", ".", "windows")).IsBare
	FolderBuild(List(Text) + "run").IsBare
	FolderBuild(("build", "Examples/Sum.strict")).IsBare is false
	FolderBuild(List(Text) + "test").IsBare is false
	if given.Length is 0 or given(0) is not in ("build", "run")
		return false
	for given.Slice(1, given.Length - 1)
		if value is not "." and value is not in Options
			return false
	true
Programs(folder Text) Texts slow
	FolderBuild(List(Text)).Programs("Examples").Length > 5
	FolderBuild(List(Text)).Programs("Math").Length is 0
	for Directory.Files(folder, "*.strict")
		if "Run" is in TypeShape(File(value).ReadLines).MethodScope.names
			value
Result Number slow
	FolderBuild(List(Text) + "build").IsBare
	programs = Programs(".")
	if programs.Length is 0
		return Error("NothingToBuild: no file in " + Directory.Current + " has Run")
	options = given.Slice(1, given.Length - 1) - "."
	main = Command.FindMainFile(".")
	chosen = main is "" then programs else List(Text) + main
	if given(0) is "run"
		return chosen.Length is 1 then Command.Launch(Command.Root(chosen + options), ".") else Several(programs)
	wanted = Buildable(programs, options)
	failing = BuildAll(wanted, options)
	logger.Log(Summary(wanted, failing))
	failing.Length
BuildAll(programs Texts, options Texts) Texts slow
	FolderBuild(List(Text)).BuildAll(List(Text), List(Text)).Length is 0
	mutable failing = List(Text)
	for programs
		if index > 0
			logger.Log(" ")
		if Command.Native("build", (List(Text) + value + TypeSource.Root) + options) is not 0
			failing = failing + value
	failing
Buildable(programs Texts, options Texts) Texts
	FolderBuild(List(Text)).Buildable(("./A.strict", "./MossWeb.strict"), List(Text)) is List(Text) + "./A.strict"
	FolderBuild(List(Text)).Buildable(("./A.strict", "./MossWeb.strict"), List(Text) + "web").Length is 2
	for programs
		if NativeCompiler.IsWebOnly(value, options) is false
			value
Summary(built Texts, failing Texts) Text
	FolderBuild(List(Text)).Summary(("./A.strict", "./B.strict"), List(Text)) is "Built 2 programs: A, B"
	FolderBuild(List(Text)).Summary(("A", "B"), List(Text) + "B") is "Built 1 of 2 programs: A, failed: B"
	total = failing.Length is 0 then "" else " of " + built.Length
	failed = failing.Length is 0 then "" else ", failed: " + Text.Combine(Names(failing, List(Text)))
	"Built " + (built.Length - failing.Length) + total + " programs: " + Text.Combine(Names(built, failing)) + failed
Names(paths Texts, skipped Texts) Texts
	FolderBuild(List(Text)).Names(("./A.strict", "B.strict"), List(Text) + "B.strict") is List(Text) + "A"
	for paths
		if value is not in skipped
			Path(value).FileName.text.Replace(".strict", "")
Several(programs Texts) Error
	FolderBuild(List(Text) + "run").Several(("a.strict", "b.strict")).text.StartsWith("SeveralPrograms")
	Error("SeveralPrograms: run one of " + Text.Combine(programs) + " with strict <file>")
