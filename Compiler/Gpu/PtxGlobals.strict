has path Text
has prefix Text
constant Sample = PtxGlobals("Compiler/output/Globals.ptx", "ptx/")
Write(lines Texts) slow
	exists = File(path).Exists
	old = exists then File(path).ReadLines else List(Text)
	composed = Compose((Keep(old) + lines).Unique)
	if exists is false or Text.Combine(old, "\n") is not composed
		File(path).Write(composed)
Keep(old Texts) Texts
	Sample.Keep(("// a", ".shared a;", "")) is List(Text) + ".shared a;"
	for old
		if PtxModule.Sample.IsShared(value)
			value
Compose(lines Texts) Text
	Sample.Compose(List(Text) + "a;") is "// strict library ptx/Globals needs \na;\n// strict definitions\n"
	"// strict library " + prefix + "Globals needs \n" + Text.Combine(lines + PtxLibraries.Marker, "\n") + "\n"