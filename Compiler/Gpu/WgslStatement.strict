has function MlirFunction
has at Number
constant Twice = MlirDeviceStatements.Twice
constant Doubled = MlirDeviceStatements.Doubled
constant Making = MethodEntry("Made", List(MemberEntry), "Strict/Degrees", (GpuNumberSamples.ValueLoaded, MlirDeviceCalls.Making, InstructionEntry.Return(1)))
constant Made = MlirFunction(MlirGpuCheck.Floored.types + MlirLayout.Degrees, MlirGpuCheck.Floored.type, Making)
constant Absolute = MlirGpuCheck.Absolute
constant Summed = MlirDeviceStatements.Summed
constant Records = MlirDeviceRecords.Holding
constant Less = InstructionEntry.Binary(InstructionType.LessThan, (0, 1, 2))
constant Measuring = MlirFunction(Summed.types, GpuLayerSamples.Layered, GpuLayerSamples.Measured)
constant Looping = ("let e2 = r0l;", "let s2i = v_index;", "let s2v = v_value;", "let c2 = e2.y;", "for (var k2 = 0u; k2 < c2; k2++) {", "v_index = n_int(i32(k2));", "v_value = n_of(n_item(e2.x, k2));")
constant Indexing = ("let k6 = n_index(r3);", "if (r3.f >= 0.0 && k6 < v_inputl.y) { r4 = n_of(n_item(v_inputl.x, k6)); }", "else { failed[0] = 1u; r4 = n_int(0); }")
constant Recording = ("let k4 = n_index(r1) * 2u;", "if (r1.f >= 0.0 && k4 < v_pairsl.y) { r2 = n_int(i32(k4)); }", "else { failed[0] = 1u; r2 = n_int(0); }")
constant Fielding = ("let k5 = n_index(r2) + 1u;", "if (k5 < v_pairsl.y) { r3 = n_of(n_item(v_pairsl.x, k5)); }", "else { failed[0] = 1u; r3 = n_int(0); }")
constant Arithmetic = ("n_add(", "n_sub(", "n_mul(", "n_div(", "n_mod(")
constant Comparisons = ("n_equal(", "n_unequal(", "n_less(", "n_more(")
Lines Texts
	WgslStatement(Doubled, 3).Lines is ("r1 = v_value;")
	WgslStatement(Twice, 1).Lines is ("r1 = n_int(2);")
	WgslStatement(Doubled, 5).Lines is ("output[at] = r2.f;")
	entry = function.method.instructions(at)
	if entry.kind < InstructionType.IndexCall
		return Move(entry)
	if entry.kind is in (InstructionType.IndexCall, InstructionType.FieldLoad)
		return entry.kind is InstructionType.IndexCall then EmitIndex(entry) else Field(entry)
	if entry.kind < InstructionType.BinaryOperatorsSeparator
		return Calculate(entry)
	isLoop = entry.kind is in (InstructionType.LoopBegin, InstructionType.LoopEnd)
	entry.kind is InstructionType.Invoke then Call(entry) else isLoop then Loop(entry) else Finish(entry)
Move(entry InstructionEntry) Texts
	WgslStatement(Twice, 0).Move(Twice.method.instructions(0)) is ("r0 = v_number;")
	WgslStatement(Summed, 0).Lines is ("v_sum = n_int(0);")
	WgslStatement(Summed, 10).Lines is ("v_sum = r6;")
	WgslStatement(Twice, 0).Move(MethodCodegen.StoreConstant(Twice.method.instructions(1), "a")) is ("v_a = n_int(2);")
	if entry.kind is InstructionType.LoadVariableToRegister
		return Copy("v_" + entry.texts(0), "r" + entry.payload(0), entry.texts(0))
	if entry.kind is InstructionType.StoreRegisterToVariable
		return Copy("r" + entry.payload(0), "v_" + entry.texts(0), entry.texts(0))
	isLoad = entry.kind is InstructionType.LoadConstantToRegister
	target = isLoad then "r" + entry.payload(0) else "v_" + entry.texts.Last
	List(Text) + (target + " = " + Literal(PayloadDecoder(entry).Value(isLoad then 1 else 0).number) + ";")
Copy(source Text, target Text, name Text) Texts
	WgslStatement(Summed, 5).Copy("v_input", "r3", "input") is ("r3l = v_inputl;")
	WgslStatement(Summed, 6).Lines is Indexing
	WgslStatement(Records, 4).Lines is Recording
	WgslStatement(Records, 5).Lines is Fielding
	isList = MlirDeviceStatements(function, at).IsList(MlirKinds(function).VariableKind(at + 1, name))
	List(Text) + (isList then target + "l = " + source + "l;" else target + " = " + source + ";")
Literal(number Number) Text
	WgslStatement(Twice, 1).Literal(-0.5) is "n_float(-0.5)"
	WgslStatement(Twice, 1).Literal(0.00000000000001) is "n_float(1e-14)"
	WgslStatement(Twice, 1).Literal(117964800) is "n_int(117964800)"
	WgslStatement(Twice, 1).Literal(2147483648) is "n_float(2147483648)"
	WgslStatement(Twice, 1).Literal(-2147483648) is "n_int(-2147483648)"
	WgslStatement(Twice, 1).Literal(-2147483649) is "n_float(-2147483649)"
	constant int32Limit = 2147483648
	isWhole = number is number.Floor and number >= -int32Limit and number < int32Limit
	(isWhole then "n_int(" else "n_float(") + number + ")"
Calculate(entry InstructionEntry) Texts
	WgslStatement(Twice, 2).Calculate(Twice.method.instructions(2)) is ("r2 = n_mul(r0, r1);")
	WgslStatement(Absolute, 2).Calculate(Absolute.method.instructions(2)) is ("flag = n_less(r0, r1);")
	WgslStatement(Twice, 2).Calculate(Less)(1) is "r2 = n_int(select(0, 1, flag));"
	left = "r" + entry.payload(1)
	right = "r" + entry.payload(2)
	target = entry.payload(0) is 3 then "r" + entry.payload(3) else ""
	if entry.kind is InstructionType.Power
		return List(Text) + (target + " = n_power(" + left + ", " + right + ");")
	if entry.kind < InstructionType.ArithmeticSeparator
		return List(Text) + (target + " = " + Arithmetic(entry.kind - InstructionType.Add) + left + ", " + right + ");")
	compared = "flag = " + Comparisons(entry.kind - InstructionType.Equal) + left + ", " + right + ");"
	target is "" then List(Text) + compared else (compared, target + " = n_int(select(0, 1, flag));")
EmitIndex(entry InstructionEntry) Texts
	WgslStatement(Summed, 6).EmitIndex(Summed.method.instructions(6)).First.StartsWith("let k6 = n_index(r")
	WgslStatement(Summed, 6).EmitIndex(Summed.method.instructions(6))(1).IndexOf(" = n_of(n_item(v_") > 0
	slots = MlirDeviceRecords(function, at).Slots(MlirKinds(function).VariableKind(at, entry.texts(0)))
	if slots > 0
		return Record(entry, slots)
	list = "v_" + entry.texts(0) + "l"
	index = "r" + entry.payload(1)
	target = "r" + entry.payload(0)
	position = "k" + at
	inside = "if (" + index + ".f >= 0.0 && " + position + " < " + list + ".y) { "
	read = inside + target + " = n_of(n_item(" + list + ".x, " + position + ")); }"
	("let " + position + " = n_index(" + index + ");", read, "else { failed[0] = 1u; " + target + " = n_int(0); }")
Call(entry InstructionEntry) Texts
	WgslStatement(Doubled, 4).Call(Doubled.method.instructions(4)) is ("r2 = s_Rows_Twice_1(n_int(0), r1);")
	WgslStatement(MlirGpuCheck.Floored, 1).Call(MlirGpuCheck.Flooring) is ("r1 = n_floor(r0);")
	WgslStatement(Made, 1).Call(MlirDeviceCalls.Making) is ("r1 = r0;")
	register = MlirDeviceCalls(function, at, function).Register(entry)
	if IsNative(entry)
		return List(Text) + Native(entry, "r" + register)
	callees = MlirReach(function.types).Call(function, at)
	if callees.Length is not 1 or entry.texts(1) is in MlirDeviceCalls.Natives
		return List(Text) + ("unsupported: " + entry.texts(1))
	called = WgslFunction(callees.First)
	instance = register < 0 then "n_int(0)" else "r" + register
	List(Text) + ("r" + entry.payload(0) + " = " + called.Name + "(" + instance + called.Arguments(entry) + ");")
IsNative(entry InstructionEntry) Boolean
	WgslStatement(Made, 1).IsNative(MlirDeviceCalls.Making)
	WgslStatement(Doubled, 4).IsNative(MlirDeviceCalls.Rounding)
	WgslStatement(Doubled, 4).IsNative(MlirDeviceCalls.Sining)
	WgslStatement(MlirDeviceCalls.Turned.function, 1).IsNative(MlirDeviceCalls.Turning) is false
	WgslStatement(Measuring, 1).Lines is ("r1 = n_int(i32(r0l.y));")
	WgslStatement(Doubled, 4).Call(MlirDeviceCalls.Rounding) is ("r1 = n_float8(r0);")
	WgslStatement(Twice, 2).Call(Doubled.method.instructions(4)) is ("unsupported: Twice")
	WgslStatement(MlirGpuCheck.Powered, 2).Lines is ("r2 = n_power(r0, r1);")
	name = entry.texts(1)
	isRounding = MlirDeviceCalls(function, at, function).IsRounding(entry)
	isMade = name is "from" and isRounding is false and MlirDeviceMembers(function).IsNativeCall(at)
	name is in ("Floor", "Length") or name is in MlirDeviceCalls.Approximations or isRounding or isMade
Native(entry InstructionEntry, instance Text) Text
	WgslStatement(Doubled, 4).Native(MlirGpuCheck.Flooring, "r0") is "r1 = n_floor(r0);"
	WgslStatement(Doubled, 4).Native(MlirDeviceCalls.Logarithmic, "r0") is "r1 = n_Logarithm(r0);"
	WgslStatement(Doubled, 4).Native(MlirDeviceCalls.Sining, "r0") is "r1 = n_Sin(r0);"
	register = MlirDeviceCalls(function, at, function).Register(entry)
	slots = MlirDeviceRecords(function, at).Slots(MlirKinds(function).KindOf(at, register))
	counted = slots > 0 then "n_int(i32(" + instance + "l.y / " + slots + "u))" else "n_int(i32(" + instance + "l.y))"
	name = entry.texts(1)
	if name is "from"
		arg = "r" + PayloadDecoder(entry).Arguments.First
		rounded = MlirDeviceCalls(function, at, function).IsRounding(entry) then "n_float8(" + arg + ")" else arg
		return "r" + entry.payload(0) + " = " + rounded + ";"
	called = name is "Floor" then "n_floor(" + instance + ")" else "n_" + name + "(" + instance + ")"
	"r" + entry.payload(0) + " = " + (name is "Length" then counted else called) + ";"
Loop(entry InstructionEntry) Texts
	WgslStatement(Summed, 11).Loop(Summed.method.instructions(11)) is ("}", "v_index = s2i;", "v_value = s2v;")
	WgslStatement(Summed, 2).Lines is Looping
	WgslStatement(Summed, 7).Lines is List(Text)
	if entry.kind is InstructionType.LoopBegin
		return Begun("r" + entry.payload(0), entry)
	begin = function.method.LoopBeginOf(at)
	("}", "v_index = s" + begin + "i;", "v_value = s" + begin + "v;")
Begun(register Text, entry InstructionEntry) Texts
	WgslStatement(Summed, 2).Begun("r0", Summed.method.instructions(2)).Last.StartsWith("v_value = ")
	WgslStatement(Records, 2).Begun("r0", Records.method.instructions(2))(3) is "let c2 = n_index(r0);"
	WgslStatement(Records, 2).Lines.Last is "v_value = n_int(i32(k2));"
	isList = MlirDeviceStatements(function, at).IsList(MlirKinds(function).KindOf(at, entry.payload(0)))
	counter = "k" + at
	saved = ("let e" + at + " = " + register + "l;", "let s" + at + "i = v_index;", "let s" + at + "v = v_value;")
	count = "let c" + at + " = " + (isList then "e" + at + ".y;" else "n_index(" + register + ");")
	item = isList then "n_of(n_item(e" + at + ".x, " + counter + "))" else "n_int(i32(" + counter + "))"
	loop = "for (var " + counter + " = 0u; " + counter + " < c" + at + "; " + counter + "++) {"
	saved + count + loop + ("v_index = n_int(i32(" + counter + "));") + ("v_value = " + item + ";")
Finish(entry InstructionEntry) Texts
	WgslStatement(Twice, 3).Finish(Twice.method.instructions(3)) is ("return r2;")
	WgslStatement(Absolute, 3).Finish(Absolute.method.instructions(3)) is ("if (flag) {")
	WgslStatement(Absolute, 11).Finish(Absolute.method.instructions(11)) is ("if (!flag) {")
	WgslStatement(Absolute, 10).Finish(Absolute.method.instructions(10)) is ("}")
	if entry.kind is InstructionType.CheckError
		return List(Text)
	if entry.kind is in (InstructionType.JumpToIdIfFalse, InstructionType.JumpToIdIfTrue)
		return List(Text) + (entry.kind is InstructionType.JumpToIdIfFalse then "if (flag) {" else "if (!flag) {")
	register = "r" + entry.payload(0)
	line = entry.kind is InstructionType.Return then "return " + register + ";" else "output[at] = " + register + ".f;"
	List(Text) + (entry.kind is InstructionType.JumpEnd then "}" else line)
Record(entry InstructionEntry, slots Number) Texts
	WgslStatement(Records, 4).Record(LaneFlow.Picking, 2).First is "let k4 = n_index(r1) * 2u;"
	position = "k" + at
	target = "r" + entry.payload(0)
	first = "let " + position + " = n_index(r" + entry.payload(1) + ") * " + slots + "u;"
	inside = "if (r" + entry.payload(1) + ".f >= 0.0 && " + position + " < v_" + entry.texts(0) + "l.y) { "
	read = inside + target + " = n_int(i32(" + position + ")); }"
	(first, read, "else { failed[0] = 1u; " + target + " = n_int(0); }")
Field(entry InstructionEntry) Texts
	WgslStatement(Records, 5).Field(MlirDeviceRecords.Field)(1).EndsWith("r3 = n_of(n_item(v_pairsl.x, k5)); }")
	list = "v_" + function.method.instructions(MlirKinds(function).Writer(at, entry.payload(1))).texts(0) + "l"
	member = StructLanes(function.types).Members(function.TypeOf(entry.texts(1))).Index(entry.texts(0))
	position = "k" + at
	target = "r" + entry.payload(0)
	item = "n_of(n_item(" + list + ".x, " + position + "))"
	read = "if (" + position + " < " + list + ".y) { " + target + " = " + item + "; }"
	first = "let " + position + " = n_index(r" + entry.payload(1) + ") + " + member + "u;"
	(first, read, "else { failed[0] = 1u; " + target + " = n_int(0); }")
