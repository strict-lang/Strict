has base Text
has tools Toolchain
constant Sample = GpuBuilt("Compiler/output/Parted", Toolchain.OnWindows)
Built(device Text, kept Text, isTiling Boolean, stamp Text) Texts slow
	let module = GpuModule(device.Split("\n"))
	let parts = GpuParts(module.Functions, kept.Split(","))
	let types = parts.Types
	let targets = isTiling then ("sm_80", "sm_75") else List(Text) + "sm_75"
	Directory.Create(Path(base).PathOnly.text + "/ptx")
	Directory.Create(Path(base).PathOnly.text + "/ptx/built")
	let failure = Compiled(types, parts.Texts(module, stamp), targets)
	failure is "" then Joined(types, targets) else List(Text) + failure
Compiled(types Texts, texts Texts, targets Texts) Text slow
	let stale = Stale(types, texts, targets)
	for stale
		File(Slot(types(value)) + ".mlir").Write(texts(value))
	let failure = Lowered(Slots(types, stale), targets)
	for stale
		Finished(Slot(types(value)), failure is "" then Key(texts(value)) else "")
	failure
Finished(slot Text, key Text) slow
	for (".mlir", ".llvm.mlir", ".ll")
		File(slot + value).Delete
	File(slot + ".key").Write(key)
Stale(types Texts, texts Texts, targets Texts) Numbers slow
	for types
		if IsStale(Slot(value), Key(texts(index)), targets)
			index
IsStale(slot Text, key Text, targets Texts) Boolean slow
	Sample.IsStale("Compiler/output/missing", "1", List(Text) + "sm_75")
	let isKept = File(slot + ".key").Exists and PtxCache(slot).Read(".key") is key
	let isBuilt = File(slot + "." + targets.First + ".ptx").Exists and File(slot + "." + targets.Last + ".ptx").Exists
	(isKept and isBuilt) is false
Key(text Text) Text
	Sample.Key("a") is "97"
	"" + HashCode(text).number
Slot(type Text) Text
	Sample.Slot("A") is "Compiler/output/ptx/built/Parted.A"
	Path(base).PathOnly.text + "/ptx/built/" + Path(base).FileName.text + "." + type
Slots(types Texts, stale Numbers) Texts
	Sample.Slots(("A", "B"), List(Number) + 1) is List(Text) + "Compiler/output/ptx/built/Parted.B"
	for stale
		Slot(types(value))
Lowered(slots Texts, targets Texts) Text slow
	Sample.Lowered(List(Text), List(Text) + "sm_75") is ""
	let optimized = MlirParts.Ran("mlir-opt", Optimizing(slots), tools)
	let translated = optimized is "" then MlirParts.Ran("mlir-translate", Translating(slots), tools) else optimized
	translated is "" then MlirParts.Ran("clang", Compiling(slots, targets), tools) else translated
Optimizing(slots Texts) Texts
	Sample.Optimizing(List(Text) + "a").First.StartsWith("\"a.mlir\" --symbol-dce")
	for slots
		tools.Quoted(value + ".mlir") + MlirSplit.Passes + " -o " + tools.Quoted(value + ".llvm.mlir")
Translating(slots Texts) Texts
	Sample.Translating(List(Text) + "a").First.EndsWith("\"a.llvm.mlir\" -o \"a.ll\"")
	for slots
		MlirSplit.Translating + tools.Quoted(value + ".llvm.mlir") + " -o " + tools.Quoted(value + ".ll")
Compiling(slots Texts, targets Texts) Texts
	Sample.Compiling(("a", "b"), ("sm_80", "sm_75")).Length is 4
	mutable arguments = List(Text)
	for slots
		arguments = arguments + Targeted(value, targets)
	arguments
Targeted(slot Text, targets Texts) Texts
	Sample.Targeted("a", List(Text) + "sm_75").First.EndsWith("-march=sm_75 \"a.ll\" -o \"a.sm_75.ptx\"")
	for targets
		DeviceBuild.Nvptx + value + " " + tools.Quoted(slot + ".ll") + " -o " + tools.Quoted(slot + "." + value + ".ptx")
Joined(types Texts, targets Texts) Texts slow
	for targets
		Text.Combine(Read(types, value), "\n")
Read(types Texts, target Text) Texts slow
	for types
		PtxCache(Slot(value)).Read("." + target + ".ptx")