constant Sides = (MemberEntry("left", "Strict/Number", List(InstructionEntry), false), MemberEntry("right", "Strict/Number", List(InstructionEntry), false))
constant Compared = (InstructionEntry.Named(InstructionType.LoadVariableToRegister, 0, "left"), InstructionEntry.Named(InstructionType.LoadVariableToRegister, 1, "right"), InstructionEntry.Binary(InstructionType.GreaterThan, (0, 1)))
constant LeftStored = (GpuNumberSamples.IfJumped, InstructionEntry.Named(InstructionType.LoadVariableToRegister, 2, "left"), InstructionEntry.Named(InstructionType.StoreRegisterToVariable, 2, "conditional0"))
constant LeftEnded = (InstructionEntry.LoadBoolean(3, true), InstructionEntry.Binary(InstructionType.Equal, (3, 3))) + GpuNumberSamples.ElseJumped
constant RightStored = (InstructionEntry.Named(InstructionType.LoadVariableToRegister, 4, "right"), InstructionEntry.Named(InstructionType.StoreRegisterToVariable, 4, "conditional0"), GpuNumberSamples.IfEnded)
constant Larger = MethodEntry("Larger", Sides, "Strict/Number", Compared + LeftStored + LeftEnded + RightStored + (InstructionEntry.Named(InstructionType.LoadVariableToRegister, 5, "conditional0"), InstructionEntry.Return(5)))
constant Scoring = (MemberEntry("scores", "Strict/List(Number)", List(InstructionEntry), false), MemberEntry("positions", "Strict/Number", List(InstructionEntry), false))
constant FirstScore = (InstructionEntry.LoadNumber(0, 0), InstructionEntry(InstructionType.IndexCall, "scores", (1, 0, -1)), InstructionEntry.Named(InstructionType.StoreRegisterToVariable, 1, "largest"))
constant Positioning = (InstructionEntry.Named(InstructionType.LoadVariableToRegister, 0, "positions"), InstructionEntry.LoopBegin(0, -1), InstructionEntry.Named(InstructionType.LoadVariableToRegister, 1, "largest"))
constant FirstChecked = InstructionEntry(InstructionType.CheckError, List(Text), List(Number) + 1)
constant ScoreIndexed = (FirstChecked, InstructionEntry.Named(InstructionType.LoadVariableToRegister, 2, "index"), InstructionEntry(InstructionType.IndexCall, "scores", (3, 2, -1)))
constant LargerCalled = (InstructionEntry(InstructionType.CheckError, List(Text), List(Number) + 3), InstructionEntry.Invoke(4, ("Strict/Chosen", "Larger", "Strict/Number"), (1, 3), -1))
constant LargestStored = (InstructionEntry.Named(InstructionType.StoreRegisterToVariable, 4, "largest"), InstructionEntry.Jump(InstructionType.LoopEnd, 9))
constant LargestReturned = (InstructionEntry.Named(InstructionType.LoadVariableToRegister, 0, "largest"), InstructionEntry(InstructionType.CheckError, List(Text), List(Number) + 0), InstructionEntry.Return(0))
constant Largest = MethodEntry("Largest", Scoring, "Strict/Number", FirstScore + Positioning + ScoreIndexed + LargerCalled + LargestStored + LargestReturned)
constant HeadPosition = MemberEntry("position", "Strict/Number", List(InstructionEntry), false)
constant HeadWeighted = (InstructionEntry.Named(InstructionType.LoadVariableToRegister, 0, "position"), InstructionEntry(InstructionType.IndexCall, "weights", (1, 0, -1)), FirstChecked)
constant HeadDivided = (InstructionEntry.Named(InstructionType.LoadVariableToRegister, 2, "heads"), InstructionEntry.Binary(InstructionType.Divide, (1, 2, 3)), InstructionEntry.Return(3))
constant Head = MethodEntry("Head", List(MemberEntry) + HeadPosition, "Strict/Number", HeadWeighted + HeadDivided)
constant HeadCount = MemberEntry("count", "Strict/Number", List(InstructionEntry), false)
constant Counting = (MlirLoops.Emptied, InstructionEntry.Named(InstructionType.LoadVariableToRegister, 0, "count"), InstructionEntry.LoopBegin(0, -1), InstructionEntry.Named(InstructionType.LoadVariableToRegister, 1, "index"))
constant HeadCalled = InstructionEntry.Invoke(2, ("Strict/Headed", "Head", "Strict/Number", "position"), List(Number) + 1, -1)
constant Heading = MethodEntry("Heading", List(MemberEntry) + HeadCount, "Strict/List(Number)", Counting + HeadCalled + GpuLayerSamples.CheckedWritten + GpuLayerSamples.ResultReturned)
constant Headed = TypeEntry("Strict/Headed", (MemberEntry("heads", "Strict/Number", List(InstructionEntry), false), MemberEntry("weights", "Strict/List(Number)", List(InstructionEntry), false)), (Heading, Head))
constant Weighted = TypeEntry("Strict/Headed", (Headed.members(0), MemberEntry("weights", "Strict/List(Number)", List(InstructionEntry), true)), (Heading, Head))
constant Weighting = MlirFunction(List(TypeEntry) + Weighted, Weighted, Heading)
constant Chosen = TypeEntry("Strict/Chosen", List(MemberEntry), (Largest, Larger))