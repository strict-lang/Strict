constant Row = MemberEntry("row", "Strict/List(Number)", List(InstructionEntry), false)
constant Input = MemberEntry("input", "Strict/List(Number)", List(InstructionEntry), false)
constant ChosenIndices = MemberEntry("chosen", "Strict/List(Number)", List(InstructionEntry), false)
constant RowLoaded = InstructionEntry.Named(InstructionType.LoadVariableToRegister, 0, "row")
constant ElementLoaded = InstructionEntry.Named(InstructionType.LoadVariableToRegister, 1, "value")
constant SecondChecked = InstructionEntry(InstructionType.CheckError, List(Text), List(Number) + 2)
constant SecondWritten = InstructionEntry.Named(InstructionType.InvokeWriteToList, 2, "forResult")
constant FifthLooped = InstructionEntry.Jump(InstructionType.LoopEnd, 5)
constant CheckedWritten = (SecondChecked, SecondWritten, FifthLooped)
constant FourthChecked = InstructionEntry(InstructionType.CheckError, List(Text), List(Number) + 4)
constant ResultReturned = (InstructionEntry.Named(InstructionType.LoadVariableToRegister, 0, "forResult"), InstructionEntry.Return(0))
constant Doubling = (MlirLoops.Emptied, InstructionEntry.Named(InstructionType.LoadVariableToRegister, 0, "numbers"), InstructionEntry.LoopBegin(0, -1), ElementLoaded)
constant Twice = InstructionEntry.Invoke(2, ("Strict/Rows", "Twice", "Strict/Number", "number"), List(Number) + 1, -1)
constant Trailing = MethodEntry("Trailing", List(MemberEntry) + MlirLists.Items, "Strict/List(Number)", Doubling + (Twice, SecondWritten, SecondChecked, FifthLooped))
constant Checked = MethodEntry("Checked", List(MemberEntry) + MlirLists.Items, "Strict/List(Number)", Doubling + Twice + CheckedWritten)
constant Zeroed = MethodCodegen.StoreConstant(InstructionEntry.LoadNumber(0, 0), "sum")
constant Summing = (InstructionEntry.LoopBegin(0, -1), InstructionEntry.Named(InstructionType.LoadVariableToRegister, 1, "sum"))
constant SumReturned = (InstructionEntry.Named(InstructionType.LoadVariableToRegister, 0, "sum"), InstructionEntry.Return(0))
constant RowSumming = (Zeroed, RowLoaded) + Summing + InstructionEntry.Named(InstructionType.LoadVariableToRegister, 2, "value")
constant InputIndexed = (InstructionEntry.Named(InstructionType.LoadVariableToRegister, 3, "index"), InstructionEntry(InstructionType.IndexCall, "input", (4, 3, -1)), FourthChecked)
constant ProductAdded = (InstructionEntry.Binary(InstructionType.Multiply, (2, 4, 5)), InstructionEntry.Binary(InstructionType.Add, (1, 5, 6)), InstructionEntry.Named(InstructionType.StoreRegisterToVariable, 6, "sum"))
constant Summed = MethodEntry("Summed", (Row, Input), "Strict/Number", RowSumming + InputIndexed + ProductAdded + InstructionEntry.Jump(InstructionType.LoopEnd, 10) + SumReturned)
constant Weighing = (MlirLoops.Emptied, InstructionEntry.Named(InstructionType.LoadVariableToRegister, 0, "weights"), InstructionEntry.LoopBegin(0, -1), ElementLoaded)
constant RowSummed = (InstructionEntry.Named(InstructionType.LoadVariableToRegister, 2, "input"), InstructionEntry.Invoke(3, ("Strict/Layered", "Summed", "Strict/Number", "row", "input"), (1, 2), -1))
constant BiasRead = (InstructionEntry(InstructionType.CheckError, List(Text), List(Number) + 3), InstructionEntry.Named(InstructionType.LoadVariableToRegister, 4, "index"), InstructionEntry(InstructionType.IndexCall, "biases", (5, 4, -1)))
constant BiasAdded = (InstructionEntry(InstructionType.CheckError, List(Text), List(Number) + 5), InstructionEntry.Binary(InstructionType.Add, (3, 5, 6)), InstructionEntry.Named(InstructionType.InvokeWriteToList, 6, "forResult"))
constant Sums = MethodEntry("Sums", List(MemberEntry) + Input, "Strict/List(Number)", Weighing + RowSummed + BiasRead + BiasAdded + InstructionEntry.Jump(InstructionType.LoopEnd, 11) + ResultReturned)
constant Choosing = (MlirLoops.Emptied, InstructionEntry.Named(InstructionType.LoadVariableToRegister, 0, "chosen"), InstructionEntry.LoopBegin(0, -1), ElementLoaded, InstructionEntry(InstructionType.IndexCall, "weights", (2, 1, -1)))
constant PickedSummed = (InstructionEntry.Named(InstructionType.LoadVariableToRegister, 3, "input"), InstructionEntry.Invoke(4, ("Strict/Layered", "Summed", "Strict/Number", "row", "input"), (2, 3), -1))
constant PickedWritten = (FourthChecked, InstructionEntry.Named(InstructionType.InvokeWriteToList, 4, "forResult"), InstructionEntry.Jump(InstructionType.LoopEnd, 8))
constant Picked = MethodEntry("Picked", (ChosenIndices, Input), "Strict/List(Number)", Choosing + SecondChecked + PickedSummed + PickedWritten + ResultReturned)
constant Measured = MethodEntry("Measured", List(MemberEntry) + Row, "Strict/Number", (RowLoaded, InstructionEntry.Invoke(1, ("Strict/List(Number)", "Length", "Strict/Number"), List(Number), 0), InstructionEntry.Return(1)))
constant Rowed = MethodEntry("Rowed", List(MemberEntry) + MemberEntry("rows", "Strict/List(Numbers)", List(InstructionEntry), false), "Strict/Number", (InstructionEntry.LoadNumber(0, 0), InstructionEntry.Return(0)))
constant Layered = TypeEntry("Strict/Layered", (MemberEntry("weights", "Strict/List(Numbers)", List(InstructionEntry), false), MemberEntry("biases", "Strict/List(Number)", List(InstructionEntry), false)), (Sums, Summed, Picked, Measured))
constant Gathered = MethodEntry("Gathered", List(MemberEntry) + ChosenIndices, "Strict/List(Numbers)", Choosing + CheckedWritten + ResultReturned)
constant Gathering = MlirFunction(List(TypeEntry) + Layered, Layered, Gathered)