constant ValueLoaded = InstructionEntry.Named(InstructionType.LoadVariableToRegister, 0, "value")
constant IfJumped = InstructionEntry(InstructionType.JumpToIdIfFalse, List(Text), List(Number) + 0)
constant ElseJumped = (InstructionEntry.Jump(InstructionType.JumpEnd, 0), InstructionEntry(InstructionType.JumpToIdIfTrue, List(Text), List(Number) + 1))
constant IfEnded = InstructionEntry.Jump(InstructionType.JumpEnd, 1)
constant Negative = (ValueLoaded, InstructionEntry.LoadNumber(1, 0), InstructionEntry.Binary(InstructionType.LessThan, (0, 1)), IfJumped)
constant Negated = (InstructionEntry.LoadNumber(2, 0), InstructionEntry.Named(InstructionType.LoadVariableToRegister, 3, "value"), InstructionEntry.Binary(InstructionType.Subtract, (2, 3, 4)))
constant NegatedStored = (InstructionEntry.Named(InstructionType.StoreRegisterToVariable, 4, "conditional0"), InstructionEntry.LoadBoolean(5, true), InstructionEntry.Binary(InstructionType.Equal, (5, 5)))
constant Positive = (InstructionEntry.Named(InstructionType.LoadVariableToRegister, 6, "value"), InstructionEntry.Named(InstructionType.StoreRegisterToVariable, 6, "conditional0"))
constant AbsoluteReturned = (IfEnded, InstructionEntry.Named(InstructionType.LoadVariableToRegister, 7, "conditional0"), InstructionEntry.Return(7))
constant Absolute = MethodEntry("Absolute", List(MemberEntry), "Strict/Number", Negative + Negated + NegatedStored + ElseJumped + Positive + AbsoluteReturned)
constant Powered = MethodEntry("Powered", List(MemberEntry), "Strict/Number", (ValueLoaded, InstructionEntry.LoadNumber(1, 0.5), InstructionEntry.Binary(InstructionType.Power, (0, 1, 2)), InstructionEntry.Return(2)))
constant Floored = MethodEntry("Floored", List(MemberEntry), "Strict/Number", (ValueLoaded, InstructionEntry.Invoke(1, ("Strict/Number", "Floor", "Strict/Number"), List(Number), 0), InstructionEntry.Return(1)))
constant Sined = MethodEntry("Sined", List(MemberEntry), "Strict/Number", (ValueLoaded, InstructionEntry.Invoke(1, ("Strict/Degrees", "Sin", "Strict/Ratio"), List(Number), 0), InstructionEntry.Return(1)))
constant Numbered = TypeEntry("Strict/Number", List(MemberEntry), (Absolute, Powered, Floored))
constant InputRange = (GpuLayerSamples.Input, MemberEntry("start", "Strict/Number", List(InstructionEntry), false), MemberEntry("size", "Strict/Number", List(InstructionEntry), false))
constant SizeSumming = (GpuLayerSamples.Zeroed, InstructionEntry.Named(InstructionType.LoadVariableToRegister, 0, "size")) + GpuLayerSamples.Summing + InstructionEntry.Named(InstructionType.LoadVariableToRegister, 2, "start")
constant FirstIndexed = (InstructionEntry.Named(InstructionType.LoadVariableToRegister, 3, "index"), InstructionEntry.Binary(InstructionType.Add, (2, 3, 4)), InstructionEntry(InstructionType.IndexCall, "input", (5, 4, -1)))
constant FifthChecked = InstructionEntry(InstructionType.CheckError, List(Text), List(Number) + 5)
constant SecondIndexed = (InstructionEntry.Named(InstructionType.LoadVariableToRegister, 6, "start"), InstructionEntry.Named(InstructionType.LoadVariableToRegister, 7, "index"), InstructionEntry.Binary(InstructionType.Add, (6, 7, 8)))
constant SquareAdded = (InstructionEntry(InstructionType.IndexCall, "input", (9, 8, -1)), InstructionEntry(InstructionType.CheckError, List(Text), List(Number) + 9), InstructionEntry.Binary(InstructionType.Multiply, (5, 9, 10)))
constant SquareStored = (InstructionEntry.Binary(InstructionType.Add, (1, 10, 11)), InstructionEntry.Named(InstructionType.StoreRegisterToVariable, 11, "sum"), InstructionEntry.Jump(InstructionType.LoopEnd, 15))
constant Squared = MethodEntry("Squared", InputRange, "Strict/Number", SizeSumming + FirstIndexed + FifthChecked + SecondIndexed + SquareAdded + SquareStored + GpuLayerSamples.SumReturned)
constant Ranging = (MlirLoops.Emptied, InstructionEntry.LoadNumber(0, 1), InstructionEntry.LoadNumber(1, 300), InstructionEntry.LoopBegin(0, 1), InstructionEntry.Named(InstructionType.LoadVariableToRegister, 2, "value"))
constant RangeDoubled = (InstructionEntry.Invoke(3, ("Strict/Rows", "Twice", "Strict/Number", "number"), List(Number) + 2, -1), InstructionEntry.Named(InstructionType.InvokeWriteToList, 3, "forResult"))
constant Ranged = MethodEntry("Ranged", List(MemberEntry), "Strict/List(Number)", Ranging + RangeDoubled + InstructionEntry.Jump(InstructionType.LoopEnd, 4))