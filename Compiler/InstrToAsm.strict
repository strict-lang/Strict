has instruction Bytecode/BytecodeInstruction
has position Number
Emit Text
	InstrToAsm(BytecodeInstruction.ReturnOp(2), 0).Emit is "movsd xmm0, xmm2\npop rbp\nret"
	InstrToAsm(BytecodeInstruction.LoadConstant(1, 5), 3).Emit is "movsd xmm1, [rel const_3]"
	InstrToAsm(BytecodeInstruction.LoadVariable(0, "x"), 0).Emit is "movsd xmm0, [rel var_x]"
	if instruction.typeName is "LoadConstantToRegister"
		return "movsd " + Xmm(instruction.register) + ", [rel " + ConstantLabel + "]"
	if instruction.typeName is "LoadVariableToRegister"
		return "movsd " + Xmm(instruction.register) + ", [rel var_" + instruction.label + "]"
	if instruction.IsReturn
		return "movsd xmm0, " + Xmm(instruction.register) + "\npop rbp\nret"
	EmitStoreOrOperation
EmitStoreOrOperation Text
	InstrToAsm(BytecodeInstruction.StoreRegister(2, "sum"), 0).EmitStoreOrOperation is "movsd [rel var_sum], xmm2"
	"[rel var_n], xmm15" is in InstrToAsm(BytecodeInstruction.StoreConstant("n", 4), 1).EmitStoreOrOperation
	if instruction.typeName is "StoreConstantToVariable"
		return "movsd xmm15, [rel " + ConstantLabel + "]\nmovsd [rel var_" + instruction.label + "], xmm15"
	if instruction.typeName is "StoreRegisterToVariable"
		return "movsd [rel var_" + instruction.label + "], " + Xmm(instruction.register)
	EmitOperation
EmitOperation Text
	InstrToAsm(BytecodeInstruction("Invoke", 0, 0, ""), 0).EmitOperation is "unknown Invoke"
	InstrToAsm(BytecodeInstruction("JumpEnd", 0, 0, "if3"), 0).EmitOperation is "label_if3:"
	if instruction.IsCompare
		return EmitCompare
	if instruction.typeName.StartsWith("Jump")
		return EmitJump
	if instruction.IsBinary
		return EmitBinary
	"unknown " + instruction.typeName
EmitJump Text
	"je label_if3" is in InstrToAsm(BytecodeInstruction("JumpToIdIfFalse", 2, 0, "if3"), 0).EmitJump
	InstrToAsm(BytecodeInstruction("Jump", 0, 0, "if3End"), 0).EmitJump is "jmp label_if3End"
	if instruction.typeName is "JumpToIdIfFalse"
		return "xorpd xmm15, xmm15\nucomisd " + Xmm(instruction.register) + ", xmm15\nje label_" + instruction.label
	if instruction.typeName is "Jump"
		return "jmp label_" + instruction.label
	"label_" + instruction.label + ":"
EmitCompare Text
	"setb al" is in InstrToAsm(BytecodeInstruction("LessThan", 0, 1, "2"), 0).EmitCompare
	let compare = "xor eax, eax\nucomisd " + Xmm(instruction.register) + ", " + Xmm(instruction.amount)
	compare + "\n" + SetCondition + " al\ncvtsi2sd " + Xmm(instruction.ResultRegister) + ", eax"
SetCondition Text
	InstrToAsm(BytecodeInstruction("LessThan", 0, 1, "2"), 0).SetCondition is "setb"
	if instruction.typeName is "GreaterThan"
		return "seta"
	if instruction.typeName is "LessThan"
		return "setb"
	instruction.typeName is "Equal" then "sete" else "setne"
ConstantLabel Text
	InstrToAsm(BytecodeInstruction.LoadConstant(0, 5), 7).ConstantLabel is "const_7"
	"const_" + position
ConstantData Text
	InstrToAsm(BytecodeInstruction.LoadConstant(0, 5), 2).ConstantData is "const_2: dq 5.0\n"
	InstrToAsm(BytecodeInstruction.StoreConstant("n", 2.5), 0).ConstantData is "const_0: dq 2.5\n"
	InstrToAsm(BytecodeInstruction.ReturnOp(0), 0).ConstantData is ""
	if instruction.typeName is in ("LoadConstantToRegister", "StoreConstantToVariable")
		return ConstantLabel + ": dq " + FloatText(instruction.amount) + "\n"
	""
FloatText(number Number) Text
	InstrToAsm(BytecodeInstruction.ReturnOp(0), 0).FloatText(-3) is "-3.0"
	let text = number to Text
	"." is in text then text else text + ".0"
EmitBinary Text
	InstrToAsm(BytecodeInstruction("Modulo", 0, 1, "2"), 0).EmitBinary is "binary Modulo"
	if instruction.typeName is "Add"
		return TwoOperands("addsd")
	if instruction.typeName is "Subtract"
		return TwoOperands("subsd")
	if instruction.typeName is "Multiply"
		return TwoOperands("mulsd")
	if instruction.typeName is "Divide"
		return TwoOperands("divsd")
	"binary " + instruction.typeName
TwoOperands(opCode Text) Text
	InstrToAsm(BytecodeInstruction("Add", 0, 1, "2"), 0).TwoOperands("addsd") is "movsd xmm2, xmm0\naddsd xmm2, xmm1"
	let result = Xmm(instruction.ResultRegister)
	"movsd " + result + ", " + Xmm(instruction.register) + "\n" + opCode + " " + result + ", " + Xmm(instruction.amount)
Xmm(reg Number) Text
	InstrToAsm(BytecodeInstruction.ReturnOp(0), 0).Xmm(7) is "xmm7"
	"xmm" + reg to Text