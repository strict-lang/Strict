has instruction CompInstruction
Emit Text
	InstrToAsm(CompInstruction.ReturnOp(2)).Emit is "movsd xmm0, xmm2"
	if instruction.IsLoadConstant
		return "movsd " + Xmm(instruction.register) + ", [rel const_" + ConstLabel + "]"
	if instruction.IsLoadVariable
		return "movsd " + Xmm(instruction.register) + ", [rel var_" + instruction.label + "]"
	if instruction.IsReturn
		return "movsd xmm0, " + Xmm(instruction.register)
	EmitStoreOrOperation
EmitStoreOrOperation Text
	InstrToAsm("Jump", 0, 0, "").EmitStoreOrOperation is "unknown Jump"
	if instruction.IsStoreConstant
		return "store const " + instruction.label
	if instruction.IsStoreRegister
		return "movsd [rel var_" + instruction.label + "], " + Xmm(instruction.register)
	if instruction.IsBinary
		return EmitBinary
	if instruction.IsCompare
		return "ucomisd " + Xmm(instruction.register) + ", " + Xmm(instruction.Amount)
	"unknown " + instruction.typeName
ConstLabel Text
	InstrToAsm(CompInstruction.LoadConstant(0, 5)).ConstLabel is "5"
	if instruction.label is ""
		return instruction.Amount to Text
	instruction.label
EmitBinary Text
	InstrToAsm(CompInstruction.BinaryOp("Modulo", 0, 1, 2)).EmitBinary is "binary Modulo"
	if instruction.typeName is "Add"
		return TwoOperands("addsd")
	if instruction.typeName is "Subtract"
		return TwoOperands("subsd")
	if instruction.typeName is "Multiply"
		return TwoOperands("mulsd")
	if instruction.typeName is "Divide"
		return TwoOperands("divsd")
	"binary " + instruction.typeName
TwoOperands(opCode Text) Text
	InstrToAsm(CompInstruction.BinaryOp("Add", 0, 1, 2)).TwoOperands("addsd") is "movsd xmm2, xmm0\naddsd xmm2, xmm1"
	let result = Xmm(instruction.ResultRegister)
	"movsd " + result + ", " + Xmm(instruction.register) + "\n" + opCode + " " + result + ", " + Xmm(instruction.Amount)
Xmm(reg Number) Text
	InstrToAsm(CompInstruction.ReturnOp(0)).Xmm(7) is "xmm7"
	"xmm" + reg to Text