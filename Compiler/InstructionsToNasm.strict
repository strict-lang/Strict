has ops CompList
has methodName Text
has platform Number
constant Extension = ".asm"
Compile Text
	InstructionsToNasm.SimpleAdd(Platform.Linux).Compile.StartsWith("section .data") is true
	DataSection + MethodHeader + EmitAll(0, "") + "pop rbp\nret\n" + EntryPoint(methodName, platform).Build
DataSection Text
	"const_3: dq 3.0" is in InstructionsToNasm.SimpleAdd(Platform.Linux).DataSection
	"section .data\nconst_2: dq 2.0\nconst_3: dq 3.0\n\n"
MethodHeader Text
	InstructionsToNasm.SimpleAdd(Platform.Linux).MethodHeader.StartsWith("section .text") is true
	"section .text\nglobal " + methodName + "\n\n" + methodName + ":\npush rbp\nmov rbp, rsp\n"
EmitAll(index Number, result Text) Text
	InstructionsToNasm.SimpleAdd(Platform.Linux).EmitAll(3, "") is "movsd xmm0, xmm2\n"
	if index >= ops.Count
		return result
	EmitAll(index + 1, result + InstrToAsm(ops.At(index)).Emit + "\n")
SimpleAdd(target Number) InstructionsToNasm
	InstructionsToNasm.SimpleAdd(Platform.Windows).ops.Count is 4
	InstructionsToNasm(CompList.SimpleAdd(target), "Run", target)
to Text
	"nasm"