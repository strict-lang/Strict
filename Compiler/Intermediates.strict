constant CrossEndings = (".ios.o", ".ios.new.a", ".android.o", ".llvm.mlir", ".ll", ".res", ".gpu.mlir", ".gpu.kept.mlir", ".gpu.llvm.mlir", ".gpu.ll", ".sm_75.ptx", ".sm_80.ptx", ".amd.mlir", ".amd.llvm.mlir", ".amd.ll", ".amd.bc")
constant LinuxEndings = (".linux.mlir", ".linux.llvm.mlir", ".linux.ll", ".linux.o", ".pre.js", ".shaders.js", ".o", ".gpu.opt.ll")
constant RuntimeEndings = (".runtime.gpu.mlir", ".runtime.gpu.kept.mlir", ".runtime.gpu.llvm.mlir", ".runtime.gpu.ll", ".runtime.sm_75.ptx", ".runtime.sm_80.ptx")
constant Endings = CrossEndings + LinuxEndings + RuntimeEndings
constant Swapped = PtxCache("Compiler/output/Swapped")
constant Held = PtxCache("./Compiler/output/Held")
constant Renewing = Held.base + ".new.exe"
constant Rooted = "Compiler/output/Rooted"
constant SourceFolders = ("Compiler", "Bytecode", "Expressions", "Runtime", "")
constant Guarded = ("Expressions", "Compiler")
constant IsWindows = Process.OperatingSystem is "Windows"
constant Kept = "Compiler\\output\\Held.old.exe"
constant Holding = "/c copy /y %SystemRoot%\\System32\\PING.EXE " + Kept + " >nul & start \"\" /b " + Kept + " -n 3 127.0.0.1 >nul"
Removed(base Text)
	Intermediates.Removed("Compiler/output/missing") is not Error
	mutable files = Directory.Files(Path(base).PathOnly.text, Path(base).FileName.text + ".ios-*.o")
	for Endings
		files = files + (base + value)
	for Toolchain.Parts
		files = files + Part(base + "-" + value) + Part(base + ".linux-" + value) + Part(base + ".web-" + value)
	for files
		if Deleted(value) is Error
			logger.Log("Could not remove build intermediate: " + value + " (another program still held it after 5 s)")
			return Error("IntermediateNotRemoved")
Part(name Text) Texts
	Intermediates.Part("a") is ("a", "a.mlir", "a.llvm.mlir")
	(name, name + ".mlir", name + ".llvm.mlir")
Deleted(path Text)
	Intermediates.Deleted("Compiler/output/missing") is not Error
	started = Process.Elapsed
	for as long as File(path).Exists and Process.Elapsed - started < 5
		File(path).Delete
		if File(path).Exists
			Process.Wait(0.1)
	if File(path).Exists
		return Error("FileNotDeleted: " + path)
Replaced(executable Text, target Text) Text
	Swapped.Saved((".exe", ".old.exe", ".new.exe"), ("a", "b", "built")) is not Error
	Intermediates.Replaced("Compiler/output/Swapped.exe", "Compiler/output/Swapped.new.exe") is ""
	Swapped.Read(".exe") is "built"
	unrunnable = Unrunnable(executable, target)
	refused = unrunnable is "" then Unchecked(executable, target) else unrunnable
	if refused is not ""
		return refused
	old = Free(executable)
	File(executable).Rename(old)
	File(target).Rename(executable)
	if File(target).Exists
		File(old).Rename(executable)
	File(old).Delete
	if File(target).Exists is false and Path(executable).FileName.RemoveExtension.text is "strict"
		CodegenStamp(Path(executable).PathOnly.text).Promoted(executable)
	File(target).Exists then Used(executable, executable) else Running(executable).Restarted(old)
Unrunnable(executable Text, target Text) Text
	Intermediates.Unrunnable("Compiler/output/A.exe", "Compiler/output/A.new.exe") is ""
	Intermediates.Unrunnable("Compiler/output/strict.exe", "Compiler/output/missing.new.exe").Length > 0
	Intermediates.Unrunnable("Compiler/output/strict.exe", Process.Find("strict").executable) is ""
	if Path(executable).FileName.RemoveExtension.text is not "strict"
		return ""
	ran = Process.RunTool(target, "version")
	ran.exitCode is 0 then "" else target + " does not run (version exit " + ran.exitCode + "), " + executable + " stays"
Unchecked(executable Text, target Text) Text slow
	Intermediates.Unchecked("Compiler/output/A.exe", "Compiler/output/A.new.exe") is ""
	Intermediates.Unchecked("Compiler/output/Missing/strict.exe", "Compiler/output/missing.new.exe") is ""
	Directory.Create(Rooted) is not Error and Directory.Create(Rooted + "/Compiler") is not Error
	File(Rooted + "/Compiler/A.strict").Write("has a Number") is not Error
	Intermediates.Unchecked(Rooted + "/strict.exe", "Compiler/output/missing.new.exe").Length > 0
	isStrict = Path(executable).FileName.RemoveExtension.text is "strict"
	if (isStrict then IsCompilerChanged(executable) else false) is false
		return ""
	for Process.RunTools(IsWindows then "cmd" else "sh", (Locally(target, Guarded(0)), Locally(target, Guarded(1))))
		if value.exitCode is not 0
			return target + " fails strict check " + Guarded(index) + " (exit " + value.exitCode + "), " + executable + " stays"
	""
Locally(target Text, folder Text) Text
	Intermediates.Locally("a.exe", "Compiler").IndexOf("STRICT_SERVER=0") >= 0
	Intermediates.Locally("a.exe", "Compiler").IndexOf("a.exe") > 0
	Intermediates.Locally("a.exe", "Compiler").IndexOf(" check Compiler") > 0
	quoted = "\"" + target + "\" check " + folder
	IsWindows then "/c set STRICT_SERVER=0&& " + quoted else "-c \"STRICT_SERVER=0 " + quoted.Replace("\"", "'") + "\""
IsCompilerChanged(executable Text) Boolean slow
	Intermediates.IsCompilerChanged("Compiler/output/Missing/strict.exe") is false
	Intermediates.IsCompilerChanged("./missing.exe")
	built = File(executable).Modified
	root = Path(executable).PathOnly.text
	for folder, file in SourceFolders, Directory.Files(folder is "" then root else root + "/" + folder, "*.strict")
		if File(file).Modified > built
			return true
	false
Free(executable Text) Text
	Intermediates.Free("Compiler/output/Missing/A.exe") is "Compiler/output/Missing/A.old.exe"
	IsWindows is false or Process.Find(Process.Variable("ComSpec")).Started(Holding) is 0
	IsWindows is false or Intermediates.Free(Held.base + ".exe") is Held.base + ".old2.exe"
	pattern = Path(executable).FileName.text.Replace(".exe", ".old*.exe")
	for Directory.Files(Path(executable).PathOnly.text, pattern)
		File(value).Delete
	mutable number = 1
	for as long as File(Old(executable, number)).Exists
		number = number + 1
	Old(executable, number)
Old(executable Text, number Number) Text
	Intermediates.Old("a.exe", 1) is "a.old.exe"
	Intermediates.Old("a.exe", 3) is "a.old3.exe"
	executable.Replace(".exe", number is 1 then ".old.exe" else ".old" + number + ".exe")
Used(file Text, executable Text) Text slow
	File("Compiler/output/Held.exe").IsLocked
	Held.Saved(List(Text) + ".new.exe", List(Text) + "built") is not Error
	Intermediates.Replaced(Held.base + ".exe", Renewing) is Held.base + ".exe is in use by another program"
	File("Compiler/output/Held.exe").Delete
	file + " is in use by " + Running(executable).Described
