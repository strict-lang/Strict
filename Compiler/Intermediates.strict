has logger
constant CrossEndings = (".ios.o", ".ios.new.a", ".android.o", ".llvm.mlir", ".ll", ".res", ".gpu.mlir", ".gpu.kept.mlir", ".gpu.llvm.mlir", ".gpu.ll", ".sm_75.ptx", ".sm_80.ptx", ".amd.mlir", ".amd.llvm.mlir", ".amd.ll", ".amd.bc")
constant LinuxEndings = (".linux.mlir", ".linux.llvm.mlir", ".linux.ll", ".linux.o", ".pre.js", ".shaders.js", ".o", ".gpu.opt.ll")
constant RuntimeEndings = (".runtime.gpu.mlir", ".runtime.gpu.kept.mlir", ".runtime.gpu.llvm.mlir", ".runtime.gpu.ll", ".runtime.sm_75.ptx", ".runtime.sm_80.ptx")
constant Endings = CrossEndings + LinuxEndings + RuntimeEndings
constant Swapped = PtxCache("Compiler/output/Swapped")
constant Held = PtxCache("./Compiler/output/Held")
constant Renewing = Held.base + ".new.exe"
Removed(base Text)
	Intermediates(Logger).Removed("Compiler/output/missing") is not Error
	mutable files = Directory.Files(Path(base).PathOnly.text, Path(base).FileName.text + ".ios-*.o")
	for Endings
		files = files + (base + value)
	for Toolchain.Parts
		files = files + Part(base + "-" + value) + Part(base + ".linux-" + value) + Part(base + ".web-" + value)
	for files
		if Deleted(value) is Error
			logger.Log("Could not remove build intermediate: " + value + " (another program still held it after 5 s)")
			return Error("IntermediateNotRemoved")
Part(name Text) Texts
	Intermediates(Logger).Part("a") is ("a", "a.mlir", "a.llvm.mlir")
	(name, name + ".mlir", name + ".llvm.mlir")
Deleted(path Text)
	Intermediates(Logger).Deleted("Compiler/output/missing") is not Error
	let started = Process.Elapsed
	for as long as File(path).Exists and (Process.Elapsed - started < 5)
		File(path).Delete
		if File(path).Exists
			Process.Wait(0.1)
	if File(path).Exists
		return Error("FileNotDeleted")
Replaced(executable Text, target Text) Text
	Swapped.Saved((".exe", ".old.exe", ".new.exe"), ("a", "b", "built")) is not Error
	Intermediates(Logger).Replaced("Compiler/output/Swapped.exe", "Compiler/output/Swapped.new.exe") is ""
	Swapped.Read(".exe") is "built"
	let old = Free(executable)
	File(executable).Rename(old)
	File(target).Rename(executable)
	if File(target).Exists
		File(old).Rename(executable)
	File(old).Delete
	File(target).Exists then Used(executable, executable) else Running(logger, executable).Restarted(old)
Free(executable Text) Text
	Intermediates(Logger).Free("Compiler/output/Missing/A.exe") is "Compiler/output/Missing/A.old.exe"
	let pattern = Path(executable).FileName.text.Replace(".exe", ".old*.exe")
	for Directory.Files(Path(executable).PathOnly.text, pattern)
		File(value).Delete
	mutable number = 1
	for as long as File(Old(executable, number)).Exists
		number = number + 1
	Old(executable, number)
Old(executable Text, number Number) Text
	Intermediates.Old("a.exe", 1) is "a.old.exe"
	Intermediates.Old("a.exe", 3) is "a.old3.exe"
	executable.Replace(".exe", number is 1 then ".old.exe" else ".old" + number + ".exe")
Used(file Text, executable Text) Slow(Text)
	File("Compiler/output/Held.exe").Locked
	Held.Saved(List(Text) + ".new.exe", List(Text) + "built") is not Error
	Intermediates(Logger).Replaced(Held.base + ".exe", Renewing) is Held.base + ".exe is in use by another program"
	File("Compiler/output/Held.exe").Delete
	file + " is in use by " + Running(logger, executable).Described
