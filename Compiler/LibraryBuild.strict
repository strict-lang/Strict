constant NoExports = ", a library exports the public methods with Number, Text, Boolean or record values and lists of numbers or records"
Build(path Text, root Text)
	Export(MlirLibrary(Execute.Load(path, root, false)), NativeBuild.Output(path, true), root)
Export(library MlirLibrary, base Text, root Text)
	if library.Exported.Length is 0
		logger.Log("No exported methods in " + base + ".strict" + NoExports)
		return Error("NoExportedMethods")
	program = NativeBuild.Device(library.Text, base, root)
	File(base + ".mlir").Write(NativeBuild.Mlir(program, root, Platform.Current))
	error = program is "" then "Failed " + base else Link(base, Toolchain(Platform.Current, root), library)
	logger.Log(error is "" then "Built " + Target(base, Platform.Current) + " and " + base + ".cs" else error)
	if error is not ""
		return Error("LibraryNotBuilt")
	File(base + ".cs").Write(CSharpBinding(library, File(base + ".strict").ReadLines).Lines)
	Intermediates.Remove(base)
Link(base Text, tools Toolchain, library MlirLibrary) Text
	lowered = tools.Lower(base)
	if lowered is not ""
		return lowered
	target = Toolchain.Quote(Target(base, Platform.Current))
	linking = tools.Quote(base + ".ll") + " -o " + target + Toolchain.Optimized + Share(library)
	linked = ToolRunner(tools.Locate("clang")).Execute(linking)
	linked.HasFailed then "clang failed: " + linked.error else ""
Target(base Text, platform Number) Text
	LibraryBuild.Target("./Games/Policy", Platform.Windows) is "./Games/Policy.dll"
	LibraryBuild.Target("./Games/Policy", Platform.Linux) is "./Games/libPolicy.so"
	LibraryBuild.Target("./Games/Policy", Platform.MacOS) is "./Games/libPolicy.dylib"
	name = Path(base).FileName.text
	folder = base.Substring(0, base.Length - name.Length)
	platform is Platform.Windows then base + ".dll" else folder + "lib" + name + Platform.LibraryExtension(platform)
Share(library MlirLibrary) Text
	LibraryBuild.Share(MlirLibrary.Policy).EndsWith("Policy_Start") is (Platform.Current is Platform.Windows)
	if Platform.Current is not Platform.Windows
		return " -shared -fPIC -lm -lpthread"
	mutable exports = " -shared -Wl,/EXPORT:strict_last_error -Wl,/EXPORT:strict_release"
	for library.Exported
		exports = exports + " -Wl,/EXPORT:" + TypeEntry.ShortName(library.types.First.Name) + "_" + value.Name
	exports