has nasmCommand Text
has linkerCommand Text
has ObjectPath Text
has ExePath Text
to Text
	nasmCommand + " | " + linkerCommand
ForAsm(asmPath Text, platform Number) LinkerPlan
	if platform is Platform.Windows
		return ForWindows(asmPath)
	if platform is Platform.MacOS
		return ForMac(asmPath)
	ForLinux(asmPath)
ForWindows(asmPath Text) LinkerPlan
	let objPath = asmPath + ".obj"
	let executable = asmPath + ".exe"
	let nasm = "nasm -f win64 " + asmPath + " -o " + objPath
	LinkerPlan(nasm, WindowsLink(objPath, executable), objPath, executable)
ForLinux(asmPath Text) LinkerPlan
	let objPath = asmPath + ".o"
	let nasm = "nasm -f elf64 " + asmPath + " -o " + objPath
	LinkerPlan(nasm, "gcc " + objPath + " to " + asmPath, objPath, asmPath)
ForMac(asmPath Text) LinkerPlan
	let objPath = asmPath + ".o"
	let nasm = "nasm -f macho64 " + asmPath + " -o " + objPath
	LinkerPlan(nasm, "clang " + objPath + " to " + asmPath, objPath, asmPath)
WindowsLink(objPath Text, executable Text) Text
	LinkerPlan.ForWindows("out.asm").linkerCommand is "gcc out.asm.obj to out.asm.exe with kernel32"
	"gcc " + objPath + " to " + executable + " with kernel32"