has hashes Dictionary(Text, Number)
has callees Dictionary(Text, Text)
has callers Dictionary(Text, Text)
constant Range = 4503599627370496
constant Shift = 1048576
constant Invoking = (InstructionEntry.Invoke(0, ("Strict/B", "Go", "Strict/Number"), List(Number), -1), InstructionEntry.Return(0))
constant Going = MethodEntry("Go", List(MemberEntry), "Strict/Number", List(InstructionEntry) + InstructionEntry.Return(0))
constant Running = MethodEntry("Run", List(MemberEntry), "Strict/Number", Invoking)
constant Types = (TypeEntry("Strict/A", List(MemberEntry), List(MethodEntry) + Running), TypeEntry("Strict/B", List(MemberEntry), List(MethodEntry) + Going))
constant Graph = CallGraph(Types)
constant Lined = (Graph.Copy(Invoking(0), 5, -1), Graph.Copy(Invoking(1), 6, -1))
constant Shifted = (TypeEntry(Types.First, methods = List(MethodEntry) + MethodEntry(Running, instructions = Lined)), Types.Last)
constant Aimed = (Graph.Copy(Invoking(0), 0, 4), InstructionEntry.Return(0))
from(types List(TypeEntry))
	Graph.callees("A.Run") is ",B.Go" and Graph.callers("B.Go") is ",A.Run"
	hashes = HashTypes(types)
	callees = Call(types)
	callers = Callers(types)
Key(type TypeEntry, method MethodEntry) Text
	Graph.Key(Types.First, Running) is "A.Run"
	TypeEntry.ShortName(type.Name) + "." + method.Name
Copy(entry InstructionEntry, line Number, target Number) InstructionEntry
	Copy(Invoking(0), 5, 4).line is 5 and Copy(Invoking(0), 5, 4).Target is 4
	InstructionEntry(entry.kind, entry.texts, entry.payload, line, target)
Stable(instructions List(InstructionEntry)) List(InstructionEntry)
	Stable(Lined).First.line is 0 and Stable(Lined).Last.line is 0
	Stable(Lined).First.Target is -1 and Stable(Aimed).First.Target is 4
	for instructions
		InstructionEntry(value.kind, value.texts, value.payload, 0, value.Target)
HashTypes(types List(TypeEntry)) Dictionary(Text, Number)
	Graph.HashTypes(Types).Length is 2
	Graph.HashTypes(Types)("A.Run") > 1000000007
	MethodEntry(Running, instructions = Lined).instructions.First.line is 5
	Graph.HashTypes(Shifted)("A.Run") is Graph.HashTypes(Types)("A.Run")
	mutable hashed = Dictionary(Text, Number)
	for type, method in types, type.methods
		key = Key(type, method)
		earlier = key is in hashed then hashed(key) else 0
		stable = Stable(method.instructions)
		wide = HashCode(stable).number * Shift + HashCode(stable.Reverse).number
		hashed = hashed.set(key, (earlier + wide % Range) % Range)
	hashed
Call(types List(TypeEntry)) Dictionary(Text, Text)
	Graph.Call(Types)("A.Run") is ",B.Go"
	mutable called = Dictionary(Text, Text)
	for type, method in types, type.methods
		called = Join(Key(type, method), Targets(method), called)
	called
Callers(types List(TypeEntry)) Dictionary(Text, Text)
	Graph.Callers(Types)("B.Go") is ",A.Run"
	mutable calling = Dictionary(Text, Text)
	for type, method in types, type.methods
		calling = Reverse(Key(type, method), Targets(method), calling)
	calling
Targets(method MethodEntry) Texts
	Graph.Targets(Running) is ("B.Go")
	for method.instructions
		if value.kind is InstructionType.Invoke and value.texts.Length > 1
			TypeEntry.ShortName(value.texts(0)) + "." + value.texts(1)
Join(key Text, targets Texts, edges Dictionary(Text, Text)) Dictionary(Text, Text)
	Graph.Join("A.Run", ("B.Go", "C.Do"), Dictionary(Text, Text))("A.Run") is ",B.Go,C.Do"
	edges.set(key, (key is in edges then edges(key) else "") + Text.Combine(Prefix(targets), ""))
Prefix(targets Texts) Texts
	Graph.Prefix("B.Go") is (",B.Go")
	for targets
		"," + value
Reverse(caller Text, targets Texts, edges Dictionary(Text, Text)) Dictionary(Text, Text)
	Graph.Reverse("A.Run", "B.Go", Dictionary(Text, Text)).Length is 1
	mutable reversed = edges
	for targets
		reversed = Join(value, List(Text) + caller, reversed)
	reversed
CollectEdges(key Text, edges Dictionary(Text, Text)) Texts
	Graph.CollectEdges("A.Run", Graph.callees) is ("B.Go") and Graph.CollectEdges("B.Go", Graph.callees).Length is 0
	key is in edges then edges(key).Split(",") - "" else List(Text)
Hash(key Text) Number
	Graph.Hash("A.Run") is Graph.hashes("A.Run") and Graph.Hash("C.Do") is 1
	key is in hashes then hashes(key) else 1
Closure(start Text) Text
	Graph.Closure("A.Run") is not Graph.Closure("B.Go")
	mutable seen = Dictionary(Text, Number).Add(start, 1)
	mutable pending = List(Mutable(Text)) + start
	mutable sum = 0
	for as long as pending.Length > 0
		current = pending.Last
		fresh = Unvisit(CollectEdges(current, callees), seen)
		sum = (sum + Hash(current)) % Range
		pending = pending.Slice(0, pending.Length - 1) + fresh
		seen = Mark(fresh, seen)
	sum to Text
Unvisit(names Texts, seen Dictionary(Text, Number)) Texts
	Graph.Unvisit(("B.Go", "C.Do"), Dictionary(Text, Number).Add("B.Go", 1)) is ("C.Do")
	for names
		if value is not in seen
			value
Mark(names Texts, seen Dictionary(Text, Number)) Dictionary(Text, Number)
	Graph.Mark("B.Go", Dictionary(Text, Number)).Length is 1
	mutable marked = seen
	for names
		marked = marked.set(value, 1)
	marked
Calling(own Text) Text
	Graph.Calling("B.Go") is Graph.hashes("A.Run") to Text and Graph.Calling("A.Run") is "0"
	mutable sum = 0
	for CollectEdges(own, callers)
		sum = (sum + Hash(value)) % Range
	sum to Text
