mutable module MlirModule
has functions List(MlirFunction)
has recursive Texts
mutable kept Texts = List(Text)
mutable kernel Text = ""
constant Separator = "\n// strict emission "
constant Range = 4503599627370496
constant Counting = EmissionCache(MlirModule.Counters, MlirModule.Counters.Functions, List(Text))
constant SafeCounter = MlirFunction(MlirModule.Counters.Functions.First, safeCalls = Dictionary(("Counter_Run_0", 1)))
constant Safe = EmissionCache(MlirModule.Counters, List(MlirFunction) + SafeCounter, List(Text))
Hold(texts List(MlirFunction)) EmissionCache slow
	Carry(Emit(texts), kernel)
HoldDevice(all List(MlirFunction)) EmissionCache slow
	Carry(kept, Device(all))
Carry(lines Texts, text Text) EmissionCache
	Counting.Carry(List(Text) + "module {", "kernel").kept.First is "module {"
	Counting.Carry(List(Text), "kernel").kernel is "kernel"
	EmissionCache(module, functions, recursive, lines, text)
Emit(texts List(MlirFunction)) Texts slow
	Counting.Emit(MlirModule.Counters.Functions).First.IndexOf("@Counter_Run_0(") > 0
	if module.Cached is ""
		return Fresh(texts)
	started = Process.Elapsed
	keys = Keys(texts)
	stored = Load(module.Cached)
	emitted = Reuse(texts, keys, stored, Process.Variable("STRICT_EMISSION_CHECK") is "1", started)
	Save(keys, emitted, stored, module.Cached)
	emitted
Device(all List(MlirFunction)) Text slow
	Counting.Device(MlirModule.Counters.Functions) is ""
	if module.Cached is ""
		return DeviceParts.Assemble(DeviceParts.Parts(all))
	keys = Keys(all)
	path = module.Cached + ".gpu"
	stored = Load(path)
	mutable parts = List(Mutable(Text))
	for all
		parts.Add(keys(index) is in stored then stored(keys(index)) else DeviceParts.Part(value))
	Save(keys, parts, stored, path)
	DeviceParts.Assemble(parts)
Fresh(texts List(MlirFunction)) Texts
	Counting.Fresh(MlirModule.Counters.Functions).Length is 1
	for texts
		MlirEmission(functions, recursive).Emit(value)
Reuse(texts List(MlirFunction), keys Texts, stored Dictionary(Text, Text), isChecked Boolean, started Number) Texts slow
	mutable reused = 0
	for keys
		reused = value is in stored then reused + 1 else reused
	Logger.Log(Phases.Line(Report(reused, texts.Length, isChecked), Process.Elapsed - started))
	Pick(texts, keys, stored, isChecked)
Report(reused Number, count Number, isChecked Boolean) Text
	Counting.Report(0, 2, true) is "Emitting all 2 functions, fresh build: nothing cached to reuse"
	Counting.Report(1, 2, true) is "1 of 2 functions reused from emission cache, each compared with a fresh emission"
	if reused is 0
		return "Emitting all " + count + " functions, fresh build: nothing cached to reuse"
	checking = isChecked then ", each compared with a fresh emission" else ""
	(reused to Text) + " of " + count + " functions reused from emission cache" + checking
Pick(texts List(MlirFunction), keys Texts, stored Dictionary(Text, Text), isChecked Boolean) Texts slow
	for texts
		Chosen(value, keys(index), stored, isChecked)
Chosen(function MlirFunction, key Text, stored Dictionary(Text, Text), isChecked Boolean) Text slow
	if key is not in stored
		return MlirEmission(functions, recursive).Emit(function)
	if isChecked is false
		return stored(key)
	fresh = MlirEmission(functions, recursive).Emit(function)
	if stored(key) is not fresh
		Logger.Log("EmissionCacheMismatch: " + function.Symbol + function.Variant)
	fresh
Load(path Text) Dictionary(Text, Text) slow
	isGpu = path.EndsWith(".gpu")
	if isGpu and module.memory.HasGpu(path)
		return module.memory.device.Table
	if isGpu is false and module.memory.HasFile(path)
		return module.memory.files.Table
	parsed = File(path).Exists then Parse(File(path).ReadText) else Dictionary(Text, Text)
	module.Store(path, parsed)
	parsed
Parse(text Text) Dictionary(Text, Text)
	Counting.Parse(Separator + "a\nx" + Separator + "b\ny").Length is 2
	Counting.Parse(Separator + "a\nx" + Separator + "a\ny")("a") is "x"
	mutable stored = Dictionary(Text, Text)
	for text.Split(Separator)
		end = value.IndexOf("\n")
		key = end > 0 then value.Substring(0, end) else ""
		if key is not "" and key is not in stored
			stored = stored.Add(key, value.Substring(end + 1))
	stored
Save(keys Texts, emitted Texts, stored Dictionary(Text, Text), path Text) slow
	mutable isNew = keys.Length is not stored.Length
	mutable joined = List(Mutable(Text))
	for keys
		isNew = isNew or value is not in stored
		joined.Add(Separator + value + "\n" + emitted(index))
	if isNew
		File(path).Write(Text.Combine(joined, ""))
	kept = Process.Variable("STRICT_SERVER") is "0" or isNew is false
	module.Store(path, kept then stored else Parse(Text.Combine(joined, "")))
Keys(texts List(MlirFunction)) Texts slow
	Counting.Keys(MlirModule.Counters.Functions).Length is 1
	Counting.Keys(MlirModule.Counters.Functions).First.StartsWith("Counter_Run_0|")
	Counting.Keys(MlirModule.Counters.Functions).First.EndsWith("|")
	shared = Share(CodegenStamp(TypeSource.Root).Current(Process.Current.executable))
	graph = CallGraph(module.types)
	for texts
		own = TypeEntry.ShortName(value.type.Name) + "." + value.method.Name
		callers = MlirWholeFunction(value).IsWhole then graph.Calling(own) else ""
		Flags(value) + "|" + shared + "|" + graph.Closure(own) + "|" + callers
Flags(function MlirFunction) Text
	Counting.Flags(MlirModule.Counters.Functions.First).StartsWith("Counter_Run_0|")
	loops = function.FastLoop + "|" + function.Group + "|" + function.Guarded
	slots = loops + "|" + function.Packing + "|" + function.Float
	calls = (function.lineSlots to Text) + "|" + function.IsDeferred
	function.Symbol + "|" + function.Variant + "|" + slots + "|" + calls + "|" + (function.Symbol is in recursive)
Share(compiler Text) Text
	Counting.Share("a").Length > 0
	Counting.Share("a") is not Counting.Share("b")
	Safe.Share("a") is not Counting.Share("a")
	safe = functions.Length > 0 then functions.First.safeCalls to Text else ""
	entry = compiler + "|" + safe + "|" + module.entryName + "|" + module.entries + "|" + module.entrySymbol
	mutable sum = Wide(entry + "|" + module.platform + "|" + (module.countedFiles to Text))
	for module.types
		sum = (sum + Wide(Layout(value))) % Range
	sum to Text
Wide(text Text) Number
	Counting.Wide("Strict.Run") > 1000000007 and Counting.Wide("a") is not Counting.Wide("b")
	(HashCode(text).number * CallGraph.Shift + HashCode(text + "|").number) % Range
Layout(type TypeEntry) Text
	Counting.Layout(MlirModule.Counters.types.First).StartsWith("Strict/Counter|")
	mutable headers = List(Mutable(Text))
	for type.methods
		headers.Add(value.Name + "(" + (value.parameters to Text) + ")" + value.returnType)
	type.Name + "|" + (type.members to Text) + "|" + Text.Combine(headers, ";")
