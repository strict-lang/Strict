has function MlirFunction
has position Number
constant IndexLoad = InstructionEntry.Named(InstructionType.LoadVariableToRegister, 1, "index")
constant Remaining = InstructionEntry.Binary(InstructionType.Modulo, (1, 2, 3))
constant Divided = (Remaining, InstructionEntry.Binary(InstructionType.Divide, (1, 2, 4)))
constant FloorNames = ("Strict/Number", "Floor", "Strict/Number")
constant Floored = InstructionEntry.Invoke(5, FloorNames, List(Number), 4)
constant Written = InstructionEntry.Named(InstructionType.InvokeWriteToList, 6, "forResult")
constant Ended = InstructionEntry.Jump(InstructionType.LoopEnd, 8)
constant Summed = (InstructionEntry.Binary(InstructionType.Add, (3, 5, 6)), Written, Ended)
constant Quarters = MlirKernel.NumbersLoop + IndexLoad + InstructionEntry.LoadNumber(2, 4) + Divided + Floored + Summed
constant Doubler = MlirKernel.Doubler
constant Number = TypeEntry("Strict/Number", List(MemberEntry), List(MethodEntry))
constant Body = List(InstructionEntry) + MlirLoops.Emptied + Quarters
constant Quartered = MethodEntry("Quartered", Doubler.method.parameters, "Strict/List(Number)", Body)
constant Quotient = "    %t7i = arith.divsi %t2ki, %t7w : i64"
constant Quartering = MlirCounter(MlirFunction(Doubler.types, Doubler.type, Quartered, List(Number), 2), 5)
constant CountBegin = (MlirLoops.Emptied, InstructionEntry.LoadNumber(0, 16), InstructionEntry.LoopBegin(0, -1))
constant Counted = CountBegin + IndexLoad + InstructionEntry.Jump(InstructionType.LoopEnd, 2)
constant Sixteen = MethodEntry("Sixteen", Doubler.method.parameters, "None", Counted)
constant Unrolling = MlirFastLoop(MlirFunction(Doubler.types, Doubler.type, Sixteen, List(Number), 2), 2)
constant Unrollable = 16
constant Unrolled = " {loop_annotation = #llvm.loop_annotation<unroll = #llvm.loop_unroll<full = true>>}"
constant ModuloSlot = "%mok"
constant ExactLimit = 4503599627370496
constant ValueWrite = InstructionEntry.Named(InstructionType.InvokeWriteToList, 3, "forResult")
constant ValueLoad = (InstructionEntry.Named(InstructionType.LoadVariableToRegister, 1, "value"), InstructionEntry.LoadNumber(2, 7))
constant ValueRem = (List(InstructionEntry) + MlirLoops.Emptied + MlirKernel.NumbersLoop) + ValueLoad + Remaining + ValueWrite + InstructionEntry.Jump(InstructionType.LoopEnd, 7)
constant FastRem = MlirCounter(MlirFunction(Doubler.types, Doubler.type, MethodEntry("Rem", Doubler.method.parameters, "Strict/List(Number)", ValueRem), List(Number), 2), 2)
Remainder(entry InstructionEntry, lines Texts) Texts
	MlirStatements(Quartering.function, 5).Calculate(Remaining)(1) is "    %t5i = arith.remsi %t2ki, %t5w : i64"
	Quartering.Remainder(Divided.First, List(Text)).Last is "    llvm.store %t5c, %r3 : f64, !llvm.ptr"
	MlirCounter(MlirFunction(Quartering.function, FastLoop = -1), 5).Remainder(Divided.First, "x") is ("x")
	fast = Divisor(entry.payload(1), entry.payload(2))
	if fast > 0
		return Whole(fast, "remsi", entry.payload(3), lines)
	IsFastModulo(entry) is false then lines else lines.Slice(0, 2) + FastFloating(Temp("a"), Temp("b")) + lines.Last
Floor(entry InstructionEntry, lines Texts) Texts
	MlirNatives(Quartering.function, 7).Emit(Floored, Number, "strict_floor")(1) is Quotient
	Quartering.At(7).Floor(Floored, List(Text)).Last is "    llvm.store %t7c, %r5 : f64, !llvm.ptr"
	Quartering.At(8).Floor(InstructionEntry.Invoke(5, FloorNames, List(Number), 3), "x") is ("x")
	instance = PayloadDecoder(entry).Instance
	writer = LoadReuse(function.method.instructions).Writer(instance, position, function.FastLoop)
	divide = writer < 0 then entry else function.method.instructions(writer)
	if divide.kind is not InstructionType.Divide
		return lines
	Whole(At(writer).Divisor(divide.payload(1), divide.payload(2)), "divsi", entry.payload(0), lines)
Divisor(left Number, right Number) Number
	Quartering.Divisor(1, 2) is 4
	Quartering.Divisor(2, 1) is 0
	Quartering.At(4).Divisor(1, 2) is 0
	terms = MlirKernel(function, function.FastLoop).Terms(left, position)
	function.FastLoop >= 0 and terms is ("index") then Constant(right, function.FastLoop) else 0
Constant(register Number, after Number) Number
	Quartering.Constant(2, 2) is 4
	Quartering.Constant(1, 2) is 0
	Quartering.At(2).Constant(0, -1) is 0
	writer = LoadReuse(function.method.instructions).Writer(register, position, after)
	if writer < 0
		return 0
	loaded = function.method.instructions(writer)
	if loaded.kind is not InstructionType.LoadConstantToRegister
		return 0
	number = PayloadDecoder(loaded).Value(1).number
	number >= 1 and number is number.Floor then number else 0
Branch(target Text) Text
	Unrolling.Looped.Last is "    llvm.br ^loop2(%t2next : i64)" + Unrolled
	Quartering.At(2).Branch("^loop2") is "    cf.br ^loop2"
	isCounted = MlirLoops(function, position).Collection is ""
	count = isCounted then Constant(function.method.instructions(position).payload(0), -1) else 0
	count > 0 and count <= Unrollable then "    llvm.br " + target + Unrolled else "    cf.br " + target
Whole(divisor Number, operation Text, register Number, lines Texts) Texts
	Quartering.Whole(0, "remsi", 3, "x") is ("x")
	Quartering.Whole(4, "divsi", 3, List(Text)).First is "    %t5w = arith.constant 4 : i64"
	Quartering.Whole(4, "divsi", 3, List(Text))(2) is "    %t5c = arith.sitofp %t5i : i64 to f64"
	if divisor is 0
		return lines
	literal = "    " + Temp("w") + " = arith.constant " + divisor + " : i64"
	whole = "    " + Temp("i") + " = arith." + operation + " %t" + function.FastLoop + "ki, " + Temp("w") + " : i64"
	number = "    " + Temp("c") + " = arith.sitofp " + Temp("i") + " : i64 to f64"
	(literal, whole, number, function.Store(Temp("c"), "%r" + register))
Temp(suffix Text) Text
	Quartering.Temp("w") is "%t5w"
	"%t" + position + suffix
At(at Number) MlirCounter
	Quartering.At(7).position is 7
	MlirCounter(function, at)
BeforeNames Texts
	FastRem.BeforeNames is ("forResult")
	mutable names = List(Mutable(Text))
	for position
		before = function.method.instructions(index)
		if before.kind is in (InstructionType.StoreRegisterToVariable, InstructionType.StoreConstantToVariable)
			names.Add(before.texts.Last)
	names
IsPureLoop Boolean
	FastRem.IsPureLoop
	if MlirLoops(function, position).IsCollecting is false
		return false
	names = BeforeNames
	for Range(position + 1, function.method.LoopEndOf(position))
		inner = function.method.instructions(value)
		if inner.kind is InstructionType.StoreRegisterToVariable
			if inner.texts(0).IndexOf("(") >= 0 or inner.texts(0) is in names
				return false
	true
IsFastModulo(entry InstructionEntry) Boolean
	FastRem.At(5).IsFastModulo(Remaining)
	Quartering.IsFastModulo(Remaining) is false
	if function.FastLoop < 0 or entry.kind is not InstructionType.Modulo
		return false
	divisor = Constant(entry.payload(2), function.FastLoop)
	if divisor <= 0 or divisor >= ExactLimit or Divisor(entry.payload(1), entry.payload(2)) > 0
		return false
	MlirCounter(function, function.FastLoop).IsPureLoop
HasFastModulo Boolean
	FastRem.HasFastModulo
	Quartering.At(2).HasFastModulo is false
	if IsPureLoop is false
		return false
	loop = MlirFunction(function, FastLoop = position)
	for Range(position + 1, function.method.LoopEndOf(position))
		if MlirCounter(loop, value).IsFastModulo(function.method.instructions(value))
			return true
	false
FastFloating(left Text, right Text) Texts
	FastRem.At(5).FastFloating("%a", "%b").First is "    %t5mq = arith.divf %a, %b : f64"
	FastRem.At(5).FastFloating("%a", "%b").Length is 13
	mutable lines = List(Mutable(Text))
	lines.Add("    " + Temp("mq") + " = arith.divf " + left + ", " + right + " : f64")
	lines.Add("    " + Temp("mt") + " = llvm.intr.trunc(" + Temp("mq") + ") : (f64) -> f64")
	lines.Add("    " + Temp("mp") + " = arith.mulf " + Temp("mt") + ", " + right + " : f64")
	lines.Add("    " + Temp("c") + " = arith.subf " + left + ", " + Temp("mp") + " : f64")
	lines + ExactCheck(left)
ExactCheck(left Text) Texts
	FastRem.At(5).ExactCheck("%a").Last is "    llvm.store %t5mal, %mok2 : i1, !llvm.ptr"
	slot = ModuloSlot + function.FastLoop
	mutable lines = List(Text) + ("    " + Temp("mlt") + " = llvm.intr.trunc(" + left + ") : (f64) -> f64")
	lines = lines + ("    " + Temp("mle") + " = arith.cmpf oeq, " + Temp("mlt") + ", " + left + " : f64")
	lines = lines + ("    " + Temp("mls") + " = llvm.intr.fabs(" + left + ") : (f64) -> f64")
	lines = lines + ("    " + Temp("mll") + " = arith.constant 9007199254740992.0 : f64")
	lines = lines + ("    " + Temp("mlb") + " = arith.cmpf olt, " + Temp("mls") + ", " + Temp("mll") + " : f64")
	lines = lines + ("    " + Temp("mok") + " = arith.andi " + Temp("mle") + ", " + Temp("mlb") + " : i1")
	lines = lines + ("    " + Temp("mpr") + " = llvm.load " + slot + " : !llvm.ptr -> i1")
	lines = lines + ("    " + Temp("mal") + " = arith.andi " + Temp("mpr") + ", " + Temp("mok") + " : i1")
	lines + ("    llvm.store " + Temp("mal") + ", " + slot + " : i1, !llvm.ptr")
Finish(letter Text) Texts
	Quartering.At(2).Finish("") is List(Text) + "    cf.br ^loop2joined"
	FastRem.Finish("").Last is "    cf.cond_br %f2mok, ^loop2joined, ^loop2generic"
	label = "^loop" + position
	if HasFastModulo is false
		return List(Text) + ("    cf.br " + label + "joined")
	flag = "%f" + letter + position + "mok"
	mutable lines = List(Mutable(Text))
	lines.Add("    " + flag + " = llvm.load " + ModuloSlot + position + " : !llvm.ptr -> i1")
	lines.Add("    cf.cond_br " + flag + ", " + label + "joined, " + label + "generic")
	lines
Slot Texts
	Quartering.At(2).Slot.Length is 0
	FastRem.Slot is List(Text) + "    %mok2 = llvm.alloca %one x i1 : (i64) -> !llvm.ptr"
	if HasFastModulo is false
		return List(Text)
	List(Text) + ("    " + ModuloSlot + position + " = llvm.alloca %one x i1 : (i64) -> !llvm.ptr")
Started Texts
	Quartering.At(2).Started.Length is 0
	FastRem.Started.Last is "    llvm.store %t2mt, %mok2 : i1, !llvm.ptr"
	if HasFastModulo is false
		return List(Text)
	mutable lines = List(Mutable(Text))
	lines.Add("    " + Temp("mt") + " = arith.constant true")
	lines.Add("    llvm.store " + Temp("mt") + ", " + ModuloSlot + position + " : i1, !llvm.ptr")
	lines
