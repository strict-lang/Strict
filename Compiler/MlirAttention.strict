has function MlirFunction
constant Marker = "@strict_gpu_attention("
constant Members = ("queries", "keys", "values", "heads", "groups", "size", "sequences")
constant Called = ("    %attentionPtx = llvm.mlir.addressof @strict_gpu_ptx : !llvm.ptr", "    %attended = func.call @strict_gpu_attention(%attentionPtx, %attention0, %attention1, %attention2, %attention3, %attention4, %attention5, %attention6) : (!llvm.ptr, f64, f64, f64, f64, f64, f64, f64) -> f64", "    %isAttended = arith.cmpf une, %attended, %zero : f64", "    cf.cond_br %isAttended, ^attended, ^computed", "  ^attended:", "    return %attended : f64", "  ^computed:")
constant Merging = MethodEntry("Merged", List(MemberEntry), "Strict/List(Number)", (InstructionEntry.Invoke(0, ("Strict/Softmax", "Shares", "Strict/List(Number)"), List(Number), -1), InstructionEntry.Invoke(1, ("Strict/Softmax", "Weighted", "Strict/Number"), List(Number), -1), MlirLoops.Emptied, InstructionEntry.Named(InstructionType.LoadVariableToRegister, 0, "queries"), InstructionEntry.LoopBegin(0, -1), InstructionEntry.Named(InstructionType.LoadVariableToRegister, 1, "value"), InstructionEntry.Named(InstructionType.InvokeWriteToList, 1, "forResult"), InstructionEntry.Jump(InstructionType.LoopEnd, 3)))
constant Attended = TypeEntry("Strict/Attention", (MemberEntry("queries", "Strict/List(Number)", List(InstructionEntry), false), MemberEntry("keys", "Strict/List(Number)", List(InstructionEntry), false), MemberEntry("values", "Strict/List(Number)", List(InstructionEntry), false), MemberEntry("heads", "Strict/Number", List(InstructionEntry), false), MemberEntry("groups", "Strict/Number", List(InstructionEntry), false), MemberEntry("size", "Strict/Number", List(InstructionEntry), false), MemberEntry("sequences", "Strict/Number", List(InstructionEntry), false)), List(MethodEntry) + Merging)
constant Attending = MlirAttention(MlirFunction(List(TypeEntry) + Attended, Attended, Merging))
IsAttention Boolean
	Attending.IsAttention
	MlirAttention(MlirGpu.Layering.function).IsAttention is false
	let isMember = MlirInstances(function, 0).StoredNames(function.type) is Members
	isMember and (function.method.parameters.Length is 0) and IsInvoked("Softmax.Shares") and IsInvoked("Softmax.Weighted")
IsInvoked(name Text) Boolean
	Attending.IsInvoked("Softmax.Shares")
	Attending.IsInvoked("Softmax.Largests") is false
	for function.method.Invoked
		if value.EndsWith("/" + name)
			return true
	false
IsComputed Boolean
	Attending.IsComputed
	MlirAttention(MlirFunction.Counter).IsComputed is false
	for function.method.instructions
		if (value.kind is InstructionType.LoopBegin) and MlirGpuCheck(function, index).IsGpu
			return true
	false
Prologue Texts
	Attending.Prologue.Length is 14
	"    cf.cond_br %isAttended, ^attended, ^computed" is in Attending.Prologue
	MlirAttention(MlirGpu.Layering.function).Prologue.Length is 0
	IsAttention and IsComputed then Loads + Called else List(Text)
Loads Texts
	Attending.Loads.First is "    %attention0 = llvm.load %v_queries : !llvm.ptr -> f64"
	for Members
		function.Load("%attention" + index, "%v_" + value)
