has function MlirFunction
constant Prologue = ("    %zero = arith.constant 0.0 : f64", "    %unset = arith.cmpf oeq, %value, %zero : f64", "    cf.cond_br %unset, ^unset, ^set", "  ^unset:", "    %emptyText = llvm.mlir.addressof @strict_empty : !llvm.ptr", "    %empty = func.call @strict_bits(%emptyText) : (!llvm.ptr) -> f64", "    return %empty : f64", "  ^set:", "    %p = func.call @strict_ptr(%value) : (f64) -> !llvm.ptr", "    %l0 = func.call @strict_list_empty() : () -> f64")
constant Parentheses = ("    %openText = llvm.mlir.addressof @strict_open_paren : !llvm.ptr", "    %open = func.call @strict_bits(%openText) : (!llvm.ptr) -> f64", "    %closeText = llvm.mlir.addressof @strict_close_paren : !llvm.ptr", "    %close = func.call @strict_bits(%closeText) : (!llvm.ptr) -> f64", "    %opened = func.call @strict_text_concat(%open, %joined) : (f64, f64) -> f64", "    %result = func.call @strict_text_concat(%opened, %close) : (f64, f64) -> f64", "    return %result : f64", "  }")
constant Sample = MlirAutomatic(MlirEquality.Same)
Functions Texts
	Sample.Functions.First.StartsWith("  func.func private @strict_automatic_") is true
	mutable lines = List(Mutable(Text))
	mutable symbols = List(Mutable(Text))
	for function.types
		let kind = MlirKinds(function).Short(value.Name)
		let equality = MlirEquality(function, 0)
		if equality.IsKnown(kind) and (equality.Symbol(kind) is not in symbols)
			symbols.Add(equality.Symbol(kind))
			lines = lines + Function(value) + Listed(equality.Symbol(kind))
	lines
Listed(symbol Text) Texts
	Sample.Listed("Shape").Length is 5
	let header = "  func.func private @strict_automatic_list_" + symbol + "(%value: f64) -> f64 {"
	let converter = "    %converter = func.constant @strict_automatic_" + symbol + " : (f64) -> f64"
	let call = "    %result = func.call @strict_list_text_mapped(%value, %converter) : (f64, (f64) -> f64) -> f64"
	(header, converter, call, "    return %result : f64", "  }")
Function(type TypeEntry) Texts
	Sample.Function(MlirFunction.Shape).Length is 24
	let name = MlirEquality(function, 0).Symbol(MlirKinds(function).Short(type.Name))
	mutable lines = List(Text) + ("  func.func private @strict_automatic_" + name + "(%value: f64) -> f64 {") + Prologue
	mutable count = 0
	for MlirInstances(function, 0).Stored(type)
		let member = Member(value, index, count)
		if member.Length > 0
			lines = lines + member
			count = count + 1
	let joined = "    %joined = func.call @strict_text_combine(%zero, %l" + count + ", %zero) : (f64, f64, f64) -> f64"
	lines + joined + Parentheses
Member(member MemberEntry, slot Number, count Number) Texts
	Sample.Member(MlirFunction.Shape.members.First, 0, 0).Last.IndexOf("@strict_list_add(%l0, %x0)") > 0 is true
	let conversion = Conversion(MlirKinds(function).Short(member.typeName))
	if conversion is "skip"
		return List(Text)
	let memory = MlirMemory(function, 0)
	let value = memory.Temp("m" + slot + "v")
	let text = conversion is "" then value else "%x" + slot
	let converted = conversion is "" then List(Text) else List(Text) + memory.Called(text, conversion, List(Text) + value)
	let added = "    %l" + (count + 1) + " = func.call @strict_list_add(%l" + count + ", " + text + ") : (f64, f64) -> f64"
	memory.Loaded("%p", slot, "m" + slot) + converted + added
ListConversion(kind Text) Text
	Sample.ListConversion("List(Logger)") is "skip"
	Sample.ListConversion("List(Shape)") is "strict_automatic_list_Shape"
	Sample.ListConversion("List(List(Text))") is "strict_list_text_lists_text"
	let inner = Conversion(MlirLayout(function).Represented(MlirKinds(function).ElementKind(kind)))
	if inner is in ("strict_list_text_text", "strict_list_text_number")
		return inner.Replace("strict_list_text_", "strict_list_text_lists_")
	inner.StartsWith("strict_automatic_") then inner.Replace("strict_automatic_", "strict_automatic_list_") else "skip"
Conversion(kind Text) Text
	Sample.Conversion("Text") is ""
	Sample.Conversion("Number") is "strict_number_text"
	Sample.Conversion("Shape") is "strict_automatic_Shape"
	Sample.Conversion("Logger") is "skip"
	let represented = MlirLayout(function).Represented(kind)
	if represented is "Text"
		return ""
	let helper = MlirTexts(function, 0).Helper(represented)
	if helper is not ""
		return helper
	represented.StartsWith("List(") then ListConversion(represented) else Structured(represented)
Structured(kind Text) Text
	Sample.Structured("Shape") is "strict_automatic_Shape"
	let equality = MlirEquality(function, 0)
	equality.IsKnown(kind) then "strict_automatic_" + equality.Symbol(kind) else "skip"