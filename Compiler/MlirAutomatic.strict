has function MlirFunction
constant UnsetPrologue = ("    %zero = arith.constant 0.0 : f64", "    %unset = arith.cmpf oeq, %value, %zero : f64", "    cf.cond_br %unset, ^unset, ^set", "  ^unset:")
constant EmptyReturned = ("    %emptyText = llvm.mlir.addressof @strict_empty_text : !llvm.ptr", "    %empty = func.call @strict_text_constant(%emptyText) : (!llvm.ptr) -> f64", "    return %empty : f64", "  ^set:")
constant Prologue = UnsetPrologue + EmptyReturned + ("    %p = func.call @strict_ptr(%value) : (f64) -> !llvm.ptr", "    %l0 = func.call @strict_list_empty() : () -> f64")
constant OpenParenthesis = ("    %openText = llvm.mlir.addressof @strict_open_paren_text : !llvm.ptr", "    %open = func.call @strict_text_constant(%openText) : (!llvm.ptr) -> f64")
constant CloseParenthesis = ("    %closeText = llvm.mlir.addressof @strict_close_paren_text : !llvm.ptr", "    %close = func.call @strict_text_constant(%closeText) : (!llvm.ptr) -> f64")
constant Concatenated = ("    %opened = func.call @strict_text_concat(%open, %joined) : (f64, f64) -> f64", "    %result = func.call @strict_text_concat(%opened, %close) : (f64, f64) -> f64", "    return %result : f64", "  }")
constant Parentheses = OpenParenthesis + CloseParenthesis + Concatenated
constant Sample = MlirAutomatic(MlirEquality.Same)
constant Priced = MemberEntry("prices", "Strict/Dictionary(Text, Shape)", List(InstructionEntry), false)
constant Nested = MemberEntry("inner", "Strict/Shape", List(InstructionEntry), false)
constant Holder = TypeEntry("Strict/Holder", (Priced, Nested), List(MethodEntry))
constant Stating = TypeEntry("Strict/States", List(MemberEntry) + MemberEntry("states", "Strict/Dictionary(Number, Missing)", List(InstructionEntry), false), List(MethodEntry))
constant Doubled = MlirAutomatic(MlirFunction(Sample.function.types + MlirFunction.Shape + Stating, Stating, Sample.function.method))
constant Shaped = Sample.Function(MlirFunction.Shape)
constant Converting = "(f64) -> f64"
constant PairSignature = " : (f64, (f64) -> f64, (f64) -> f64) -> f64"
Functions Texts
	Sample.Functions.First.StartsWith("  func.func private @strict_automatic_")
	Text.Combine(Sample.Functions).IndexOf("@strict_automatic_list_list_") > 0
	Doubled.Functions is Sample.Functions
	mutable lines = List(Mutable(Text))
	mutable symbols = List(Mutable(Text))
	for function.types
		let kind = TypeEntry.ShortName(value.Name)
		let symbol = MlirEquality(function, 0).Symbol(kind)
		if MlirEquality(function, 0).IsKnown(kind) and (symbol is not in symbols)
			symbols.Add(symbol)
			lines = lines + Function(value) + Collection(symbol) + Collection("list_" + symbol) + Hash(symbol)
	lines
Collection(symbol Text) Texts
	Sample.Collection("Shape").Length is 5
	Sample.Collection("list_Shape").First is "  func.func private @strict_automatic_list_list_Shape(%value: f64) -> f64 {"
	Sample.Collection("list_Shape")(1) is "    %converter = func.constant @strict_automatic_list_Shape : (f64) -> f64"
	let header = "  func.func private @strict_automatic_list_" + symbol + "(%value: f64) -> f64 {"
	let converter = MlirMemory(function, 0).Constant("%converter", "strict_automatic_" + symbol, Converting)
	constant call = "    %result = func.call @strict_list_text_mapped(%value, %converter) : (f64, (f64) -> f64) -> f64"
	(header, converter, call, "    return %result : f64", "  }")
Hash(symbol Text) Texts
	Sample.Hash("Shape").First is "  func.func private @strict_hash_Shape(%value: f64) -> i64 {"
	let header = "  func.func private @strict_hash_" + symbol + "(%value: f64) -> i64 {"
	let text = "    %text = func.call @strict_automatic_" + symbol + "(%value) : (f64) -> f64"
	(header, text, "    %hash = func.call @strict_hash_text(%text) : (f64) -> i64", "    return %hash : i64", "  }")
Function(type TypeEntry) Texts
	(Shaped.Length is 24) and (Shaped.First is "  func.func private @strict_automatic_Shape(%value: f64) -> f64 {")
	Text.Combine(Sample.Function(Stating)).IndexOf("@skip") is -1
	let name = MlirEquality(function, 0).Symbol(TypeEntry.ShortName(type.Name))
	mutable lines = List(Text) + ("  func.func private @strict_automatic_" + name + "(%value: f64) -> f64 {") + Prologue
	mutable count = 0
	for MlirInstances(function, 0).Stored(type)
		let member = Member(type, value, index, count)
		if member.Length > 0
			lines = lines + member
			count = count + 1
	let joined = "    %joined = func.call @strict_text_combine(%zero, %l" + count + ", %zero) : (f64, f64, f64) -> f64"
	lines + joined + Parentheses
Member(owner TypeEntry, member MemberEntry, slot Number, count Number) Texts
	Sample.Member(MlirFunction.Shape, MlirFunction.Shape.members.First, 0, 0).Last.IndexOf("add(%l0, %x0)") > 0
	Sample.Member(Holder, Priced, 0, 0).Length is 6
	Sample.Member(Holder, Nested, 1, 0).Last.IndexOf("@strict_list_add_set(%l0, %x1, %t0m1v)") > 0
	let kind = TypeEntry.ShortName(member.typeName)
	if IsSkipped(kind)
		return List(Text)
	let conversion = Conversion(kind)
	let memory = MlirMemory(function, 0)
	let loaded = memory.Temp("m" + slot + "v")
	let text = conversion is "" then loaded else "%x" + slot
	let read = MlirEmbedded(function).Read(memory, owner, member, "%p", "m" + slot)
	read + Converted(text, kind, loaded) + Added(count, text, loaded, kind)
IsSkipped(kind Text) Boolean
	Sample.IsSkipped("Logger")
	Sample.IsSkipped("Dictionary(Number, Missing)")
	Sample.IsSkipped("Dictionary(Text, Number)") is false
	let pair = MlirLayout(function).Paired(kind)
	"skip" is in (pair.Length is 0 then List(Text) + Conversion(kind) else (Converter(pair(0)), Converter(pair(1))))
Added(count Number, text Text, loaded Text, kind Text) Text
	Sample.Added(0, "%x0", "%v", "Number") is "    %l1 = func.call @strict_list_add(%l0, %x0) : (f64, f64) -> f64"
	Sample.Added(1, "%x1", "%v", "Shape").IndexOf("@strict_list_add_set(%l1, %x1, %v)") > 0
	let target = "    %l" + (count + 1) + " = func.call @"
	if MlirLayout(function).Represented(kind) is in ("Number", "Boolean", "Character")
		return target + "strict_list_add(%l" + count + ", " + text + ") : (f64, f64) -> f64"
	target + "strict_list_add_set(%l" + count + ", " + text + ", " + loaded + ") : (f64, f64, f64) -> f64"
Converted(target Text, kind Text, loaded Text) Texts
	Sample.Converted("%x", "Text", "%v").Length is 0
	Sample.Converted("%x", "Number", "%v").First.IndexOf("@strict_number_text(%v)") > 0
	if MlirLayout(function).Paired(kind).Length > 0
		return Pairs(target, kind, loaded)
	let conversion = Conversion(kind)
	let call = MlirMemory(function, 0).Called(target, conversion, List(Text) + loaded)
	conversion is "" then List(Text) else List(Text) + call
Pairs(target Text, kind Text, loaded Text) Texts
	Sample.Pairs("%x", "List(Text, Shape)", "%v").Last.IndexOf("@strict_pair_text(%v, %xk, %xv)") > 0
	Sample.Pairs("%x", "Dictionary(Text, Number)", "%v").Last.IndexOf("@strict_pairs_text(") > 0
	let layout = MlirLayout(function)
	let pair = layout.Paired(kind)
	let memory = MlirMemory(function, 0)
	let runtime = MethodBodies.Pair(layout.Represented(kind)).Length > 0 then "strict_pair_text(" else "strict_pairs_text("
	let call = "    " + target + " = func.call @" + runtime + loaded + ", " + target + "k, " + target + "v)"
	let key = memory.Constant(target + "k", Converter(pair(0)), Converting)
	(key, memory.Constant(target + "v", Converter(pair(1)), Converting), call + PairSignature)
Converter(kind Text) Text
	Sample.Converter("Text") is "strict_text_itself"
	Sample.Converter("Shape") is "strict_automatic_Shape"
	let conversion = Conversion(kind)
	conversion is "" then "strict_text_itself" else conversion
ElementConversion(kind Text) Text
	Sample.ElementConversion("List(Logger)") is "skip"
	Sample.ElementConversion("List(Shape)") is "strict_automatic_list_Shape"
	Sample.ElementConversion("List(List(Text))") is "strict_list_text_lists_text"
	MlirAutomatic(MlirPairs.Sample.function).ElementConversion("List(Pairing)") is "strict_list_text_two"
	Sample.ElementConversion("List(Boolean)") is "strict_list_text_boolean"
	let inner = Conversion(MlirLayout(function).Represented(MlirKinds(function).ElementKind(kind)))
	if inner is in ("strict_list_text_text", "strict_list_text_number")
		return inner.Replace("strict_list_text_", "strict_list_text_lists_")
	if inner is in ("strict_two_text", "strict_boolean_text", "strict_character_text")
		return inner.Replace("_text", "").Replace("strict_", "strict_list_text_")
	inner.StartsWith("strict_automatic_") then inner.Replace("strict_automatic_", "strict_automatic_list_") else "skip"
Conversion(kind Text) Text
	Sample.Conversion("Text") is ""
	Sample.Conversion("Number") is "strict_number_text"
	Sample.Conversion("Shape") is "strict_automatic_Shape"
	Sample.Conversion("Logger") is "skip"
	Sample.Conversion("Float32") is "strict_number_text"
	let represented = MlirLayout(function).Represented(kind)
	if represented is "Text"
		return ""
	let helper = MlirTexts(function, 0).Helper(represented)
	if helper is not ""
		return helper
	represented.StartsWith("List(") then ElementConversion(represented) else Structured(represented)
Structured(kind Text) Text
	Sample.Structured("Shape") is "strict_automatic_Shape"
	let equality = MlirEquality(function, 0)
	equality.IsKnown(kind) then "strict_automatic_" + equality.Symbol(kind) else "skip"