has function MlirFunction
has position Number
IsUsed Boolean
	if IsPlain is false
		return false
	if Reads.Length is 0
		return false
	linear = MlirBatchLinear(MlirFunction(function, Float = "f32"), position).IsLinear
	IsSafe and linear
IsPlain Boolean
	if function.method.instructions(position).kind is not InstructionType.LoopBegin
		return false
	loops = MlirLoops(function, position)
	if loops.Collection is not "" or loops.IsCollecting is false or function.Group >= 0
		return false
	MlirGroups(function, position).Call < 0 and IsFloat
IsFloat Boolean
	MlirBatchCheck(MlirLayout.Singles, 2).IsFloat
	MlirBatchCheck(MlirLayout.Eights, 2).IsFloat is false
	MlirLayout(function).Pack(position) is in (0, MlirDoubles.BFloat16Format, Number.SingleBits)
Reads Numbers
	for Range(position + 1, function.method.LoopEndOf(position))
		if function.method.instructions(value).kind is InstructionType.IndexCall
			value
IsSafe Boolean
	for Range(position + 1, function.method.LoopEndOf(position))
		if IsAllowed(value, function.method.instructions(value)) is false
			return false
	true
IsAllowed(at Number, entry InstructionEntry) Boolean
	if entry.kind is InstructionType.IndexCall
		return IsRead(at, entry)
	if entry.kind is InstructionType.Invoke
		return at is function.Group or at > Reads.Last or entry.texts(1) is in ("Floor", "Length")
	moved = entry.kind is in MlirGpuCheck.Moves
	calculated = entry.kind > InstructionType.StoreSeparator and entry.kind < InstructionType.ArithmeticSeparator
	moved or calculated or entry.kind is in (InstructionType.CheckError, InstructionType.InvokeWriteToList)
IsRead(at Number, entry InstructionEntry) Boolean
	kind = MlirKinds(function).VariableKind(at, entry.texts(0))
	flat = MlirDeviceStatements(function, at).IsList(kind)
	free = entry.texts(0) is in MlirGpuCheck(function, position).Free
	flat and free and MlirFeeding(function, at).IsFeeding(at, entry.payload(0)) is false
