has function MlirFunction
has position Number
constant ArithmeticKinds = (InstructionType.Add, InstructionType.Subtract, InstructionType.Multiply, InstructionType.Divide, InstructionType.Modulo)
constant AlignedKinds = (InstructionType.Add, InstructionType.Subtract, InstructionType.Multiply, InstructionType.Modulo)
constant Defaults = ("    %linearBase = arith.constant true", "    %linearZero = arith.constant 0 : i64", "    %linearMask = arith.constant 3 : i64")
constant Paired = MlirBatchLinear(MlirFunction(MlirBatched.Paired.function, Float = "f32"), 2)
constant Indexed = Paired.function.method.instructions.Slice(0, 4)
constant NegativeIndex = (InstructionEntry.Named(InstructionType.LoadVariableToRegister, 3, "count"), InstructionEntry.Binary(InstructionType.Subtract, (1, 3, 4)), InstructionEntry.Binary(InstructionType.Modulo, (4, 3, 7)))
constant NegativeReads = (InstructionEntry(InstructionType.IndexCall, "input", (2, 7, -1)), InstructionEntry(InstructionType.IndexCall, "input", (5, 7, -1)), InstructionEntry.Binary(InstructionType.Multiply, (2, 5, 6)))
constant Negating = Indexed + NegativeIndex + NegativeReads + (InstructionEntry.Named(InstructionType.InvokeWriteToList, 6, "forResult"), InstructionEntry.Jump(InstructionType.LoopEnd, 8))
constant Negative = MlirBatchLinear(MlirFunction(Paired.function, method = MethodEntry(Paired.function.method, instructions = Negating)), 2)
constant ScaledStep = (InstructionEntry.LoadNumber(3, 4), InstructionEntry.Binary(InstructionType.Divide, (1, 3, 4)), InstructionEntry.Named(InstructionType.StoreRegisterToVariable, 3, "step"))
constant ScaledProduct = (InstructionEntry.Named(InstructionType.LoadVariableToRegister, 5, "step"), InstructionEntry.Binary(InstructionType.Multiply, (4, 5, 6)))
constant ScaledFloor = (InstructionEntry.Invoke(7, ("Strict/Number", "Floor", "Strict/Number"), List(Number), 4), InstructionEntry.LoadNumber(2, -4))
constant Scaling = Indexed + ScaledStep + ScaledProduct + ScaledFloor + (InstructionEntry.Named(InstructionType.InvokeWriteToList, 6, "forResult"), InstructionEntry.Jump(InstructionType.LoopEnd, 9))
constant Scaled = MlirBatchLinear(MlirFunction(Paired.function, method = MethodEntry(Paired.function.method, instructions = Scaling)), 2)
IsLinear Boolean
	MlirBatchLinear(MlirBatched.Paired.function, 2).IsLinear is false
	Paired.IsLinear
	Negative.IsLinear is false
	if function.Float is not "f32"
		return false
	if function.method.instructions(position).payload(1) is 1
		return false
	for MlirBatchCheck(function, position).Reads
		if Slope(value, function.method.instructions(value).payload(1)) is not 1
			return false
	true
Slope(at Number, register Number) Number
	Paired.Slope(4, 1) is 1
	Negative.Slope(2, 0) is -1
	Scaled.Slope(6, 4) is 2
	Paired.Arithmetic(6, InstructionEntry.Binary(InstructionType.Divide, (3, 3, 4))) is 3
	Paired.Arithmetic(6, InstructionEntry.Binary(InstructionType.Add, (3, 3, 4))) is 0
	Paired.Arithmetic(6, InstructionEntry.Binary(InstructionType.Add, (1, 1, 4))) is -1
	Paired.Arithmetic(6, InstructionEntry.Binary(InstructionType.Subtract, (1, 3, 4))) is 1
	Paired.Arithmetic(6, InstructionEntry.Binary(InstructionType.Subtract, (3, 1, 4))) is -1
	Paired.Arithmetic(6, InstructionEntry.Binary(InstructionType.Multiply, (1, 3, 4))) is -1
	let writer = MlirKinds(function).Writer(at, register)
	writer <= position then -1 else Written(writer)
Written(at Number) Number
	Paired.Written(5) is 0
	Paired.Written(4) is -1
	Scaled.Written(9) is 0
	let entry = function.method.instructions(at)
	if entry.kind is InstructionType.LoadVariableToRegister
		return Variable(at, entry.texts(0))
	if entry.kind is InstructionType.LoadConstantToRegister
		return MlirWholeValues(at).IsWhole(PayloadDecoder(entry).Value(1)) then 0 else -1
	if entry.kind is InstructionType.Invoke
		return Floored(at, entry)
	Arithmetic(at, entry)
Variable(at Number, name Text) Number
	Paired.Variable(3, "index") is 1
	Paired.Variable(3, "value") is 1
	Negative.Variable(4, "count") is 0
	Paired.Variable(3, "other") is -1
	Scaled.Variable(8, "step") is 0
	Scaled.Arithmetic(6, InstructionEntry.Binary(InstructionType.Add, (0, 4, 8))) is -1
	let stored = MlirKinds(function).Stored(at, name)
	if stored > position
		return Slope(stored, function.method.instructions(stored).payload(0))
	if name is in ("index", "value")
		return 1
	name is in MlirGpuCheck(function, position).Free then 0 else -1
Arithmetic(at Number, entry InstructionEntry) Number
	if entry.kind is not in ArithmeticKinds
		return -1
	let left = Slope(at, entry.payload(1))
	let right = Slope(at, entry.payload(2))
	if (left is 0) and (right is 0)
		return entry.kind is InstructionType.Divide then 3 else 0
	if (entry.kind is InstructionType.Add) and (left >= 0) and (right >= 0) and (left + right is 1)
		return 1
	if (entry.kind is InstructionType.Subtract) and (left is 1) and (right is 0)
		return 1
	Divided(at, entry, left, right)
Divided(at Number, entry InstructionEntry, left Number, right Number) Number
	Negative.Divided(6, InstructionEntry.Binary(InstructionType.Divide, (4, 3, 7)), 1, 0) is 2
	Negative.Divided(6, InstructionEntry.Binary(InstructionType.Modulo, (1, 3, 7)), 1, 0) is 1
	Negative.Divided(6, InstructionEntry.Binary(InstructionType.Multiply, (4, 3, 7)), 1, 0) is -1
	if (left is not 1) or (right is not 0)
		return -1
	if (Aligned(at, entry.payload(1)) is false) or (Divisor(at, entry.payload(2)) is false)
		return -1
	if entry.kind is InstructionType.Modulo
		let nonnegative = MlirBatchSign(function, position).IsNonnegative(at, entry.payload(1))
		return nonnegative then 1 else -1
	entry.kind is InstructionType.Divide then 2 else -1
Floored(at Number, entry InstructionEntry) Number
	Paired.Floored(6, InstructionEntry.Invoke(7, ("Strict/List", "Length", "Strict/Number"), List(Number), 1)) is 0
	Paired.Floored(6, InstructionEntry.Invoke(7, ("Strict/Number", "Floor", "Strict/Number"), List(Number), 1)) is -1
	Paired.Floored(6, InstructionEntry.Invoke(7, ("Strict/Number", "Run", "Strict/Number"), List(Number), 3)) is -1
	if entry.texts(1) is "Length"
		return 0
	if entry.texts(1) is not "Floor"
		return -1
	let source = MlirDeviceCalls(function, at, function).Register(entry)
	let slope = Slope(at, source)
	slope is in (0, 2, 3) then 0 else -1
Aligned(at Number, register Number) Boolean
	Paired.Aligned(4, 1)
	Negative.Aligned(2, 0) is false
	Paired.Aligned(6, 3) is false
	Paired.Aligned(8, 2) is false
	Negative.Aligned(6, 4)
	Paired.Aligned(7, 4) is false
	Scaled.Aligned(9, 6)
	Scaled.Arithmetic(6, InstructionEntry.Binary(InstructionType.Add, (4, 0, 8))) is -1
	let writer = MlirKinds(function).Writer(at, register)
	(writer > position) and AlignedWritten(writer)
AlignedWritten(at Number) Boolean
	let entry = function.method.instructions(at)
	if entry.kind is InstructionType.LoadVariableToRegister
		return AlignedVariable(at, entry.texts(0))
	if entry.kind is InstructionType.LoadConstantToRegister
		return AlignedConstant(at, entry)
	if entry.kind is not in AlignedKinds
		return false
	let left = Aligned(at, entry.payload(1))
	let right = Aligned(at, entry.payload(2))
	entry.kind is InstructionType.Multiply then left or right else left and right
AlignedConstant(at Number, entry InstructionEntry) Boolean
	Negative.Divided(6, InstructionEntry.Binary(InstructionType.Modulo, (1, 3, 7)), 0, 0) is -1
	Negative.Divided(6, InstructionEntry.Binary(InstructionType.Modulo, (1, 3, 7)), 1, 1) is -1
	Negative.Divided(6, InstructionEntry.Binary(InstructionType.Divide, (0, 3, 7)), 1, 0) is -1
	Negative.Divided(6, InstructionEntry.Binary(InstructionType.Divide, (1, 1, 7)), 1, 0) is -1
	Paired.AlignedConstant(5, InstructionEntry.LoadNumber(3, 8))
	Paired.AlignedConstant(5, InstructionEntry.LoadNumber(3, 6)) is false
	Paired.AlignedConstant(5, InstructionEntry.LoadNumber(3, 4.5)) is false
	Paired.AlignedWritten(5) is false
	let number = PayloadDecoder(entry).Value(1)
	MlirWholeValues(at).IsWhole(number) and (number.number % 4 is 0)
AlignedVariable(at Number, name Text) Boolean
	Paired.AlignedVariable(3, "index")
	Paired.AlignedVariable(3, "value")
	Negative.AlignedVariable(4, "count")
	Paired.AlignedVariable(3, "input") is false
	Scaled.AlignedVariable(8, "step")
	let stored = MlirKinds(function).Stored(at, name)
	if stored > position
		return Aligned(stored, function.method.instructions(stored).payload(0))
	(name is in ("index", "value")) or (name is in Parameters)
Divisor(at Number, register Number) Boolean
	Negative.Divisor(6, 3)
	Paired.Divisor(6, 3) is false
	Negative.Divisor(2, 0) is false
	Paired.Divisor(5, 1) is false
	Paired.Divisor(8, 2) is false
	Scaled.Divisor(9, 5)
	Scaled.DivisorWritten(4)
	Scaled.DivisorWritten(10) is false
	let writer = MlirKinds(function).Writer(at, register)
	(writer > position) and DivisorWritten(writer)
DivisorWritten(at Number) Boolean
	let entry = function.method.instructions(at)
	if entry.kind is InstructionType.LoadConstantToRegister
		let number = PayloadDecoder(entry).Value(1).number
		return (number > 0) and (number % 4 is 0)
	if entry.kind is not InstructionType.LoadVariableToRegister
		return false
	let stored = MlirKinds(function).Stored(at, entry.texts(0))
	if stored > position
		return Divisor(stored, function.method.instructions(stored).payload(0))
	entry.texts(0) is in Parameters
Parameters Texts
	Paired.Arithmetic(6, InstructionEntry.Binary(InstructionType.IndexCall, (3, 3, 4))) is -1
	Paired.Arithmetic(6, InstructionEntry.Binary(InstructionType.Add, (3, 1, 4))) is 1
	Paired.Arithmetic(6, InstructionEntry.Binary(InstructionType.Subtract, (1, 1, 4))) is -1
	Scaled.Arithmetic(6, InstructionEntry.Binary(InstructionType.Subtract, (4, 3, 8))) is -1
	Scaled.Aligned(6, 4) is false
	Paired.Aligned(9, 6) is false
	Negative.Parameters is ("count")
	for MlirGpuCheck(function, position).Free
		if MlirDevice(function, position).IsList(value) is false
			value
Guard Texts
	mutable lines = Defaults
	for Parameters
		lines = lines + Guarded(value, index)
	let ready = Parameters.Length is 0 then "%linearBase" else "%linear" + (Parameters.Length - 1)
	lines + ("    cf.cond_br " + ready + ", ^linearStart, ^scalarLoadStart")
Guarded(name Text, at Number) Texts
	let prefix = "%linear" + at
	let previous = at is 0 then "%linearBase" else "%linear" + (at - 1)
	let rest = "    " + prefix + "Rest = arith.andi %e_" + name + ", %linearMask : i64"
	let aligned = "    " + prefix + "Aligned = arith.cmpi eq, " + prefix + "Rest, %linearZero : i64"
	let positive = "    " + prefix + "Positive = arith.cmpi sgt, %e_" + name + ", %linearZero : i64"
	let valid = "    " + prefix + "Valid = arith.andi " + prefix + "Aligned, " + prefix + "Positive : i1"
	let both = "    " + prefix + " = arith.andi " + previous + ", " + prefix + "Valid : i1"
	(rest, aligned, positive, valid, both)