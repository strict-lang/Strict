constant Storing = "    func.call @strict_device_cached_stored(%result, %batchFirst, %batchActive, %batchOutput, %results)"
has function MlirFunction
has position Number
Slots Texts
	mutable lines = Allocate("%batchOutput", "f32")
	for MlirBatchCheck(function, position).Reads
		lines = lines + Allocate("%indices" + value, "i64") + Allocate("%cached" + value, "f32")
	lines
Allocate(name Text, kind Text) Texts
	allocated = "    " + name + "Private = llvm.alloca %batchSize x " + kind
	constant typed = " : (i64) -> !llvm.ptr<5>"
	(allocated + typed, "    " + name + " = llvm.addrspacecast " + name + "Private : !llvm.ptr<5> to !llvm.ptr")
Prefetch(at Number) Texts
	entry = function.method.instructions(at)
	if entry.kind is InstructionType.IndexCall
		return Save(at)
	feeding = MlirFeeding(function, at)
	written = LoadReuse(function.method.instructions).Write(entry)
	stored = entry.kind is in (InstructionType.StoreRegisterToVariable, InstructionType.StoreConstantToVariable)
	needed = stored then feeding.IsLoaded(at, entry.texts.Last) else feeding.IsFeeding(at, written)
	needed then MlirDeviceStatements(function, at).Emitted else List(Text)
Save(at Number) Texts
	entry = function.method.instructions(at)
	temp = "%d" + at
	indexed = MlirExact(function, at).Position("%r" + entry.payload(1), temp + "position")
	pointer = "    " + temp + "Pointer = llvm.getelementptr %indices" + at + "[%batchIndex]"
	constant typed = " : (!llvm.ptr, i64) -> !llvm.ptr, i64"
	indexed + pointer + typed + MlirTyped.Integer.Store(temp + "position", temp + "Pointer")
Loaded Texts
	mutable lines = List(Mutable(Text))
	for MlirBatchCheck(function, position).Reads
		lines = lines + LoadedRead(value)
	lines
LoadedRead(at Number) Texts
	temp = "%read" + at
	list = "%v_" + function.method.instructions(at).texts(0)
	data = MlirTyped.Pointer.Load(temp + "Data", list + "_d")
	bits = MlirTyped.Integer.Load(temp + "Bits", list + "_b")
	count = MlirTyped.Integer.Load(temp + "Count", list + "_n")
	call = "    func.call @strict_device_cached_four(%failed, " + temp + "Data, " + temp + "Bits, "
	arguments = temp + "Count, %indices" + at + ", %cached" + at + ", %batchActive)"
	(data, bits, count, call + arguments + " : (!llvm.ptr, !llvm.ptr, i64, i64, !llvm.ptr, !llvm.ptr, i64) -> ()")
Compute(at Number) Texts
	MlirBatchReads(MlirBatched.Single.function, 2).Compute(6).Length is 0
	MlirBatchReads(MlirBatched.Single.function, 2).Compute(8).Length > 0
	entry = function.method.instructions(at)
	if function.Float is "f64"
		return MlirDeviceStatements(function, at).Emitted
	if entry.kind is InstructionType.IndexCall
		return Cache(at)
	if entry.kind is InstructionType.InvokeWriteToList
		return Collect(at)
	IsComputed(at, entry) then MlirDeviceStatements(function, at).Emitted else List(Text)
IsComputed(at Number, entry InstructionEntry) Boolean
	feeding = MlirFeeding(function, at)
	if entry.kind is in (InstructionType.StoreRegisterToVariable, InstructionType.StoreConstantToVariable)
		return feeding.IsFloatedVariable(at, entry.texts.Last)
	written = LoadReuse(function.method.instructions).Write(entry)
	written < 0 or feeding.IsFloated(at, written)
Cache(at Number) Texts
	temp = "%d" + at
	pointer = "    " + temp + "Pointer = llvm.getelementptr %cached" + at + "[%batchIndex]"
	constant typed = " : (!llvm.ptr, i64) -> !llvm.ptr, f32"
	read = function.Load(temp + "Value", temp + "Pointer")
	target = "%r" + function.method.instructions(at).payload(0)
	(pointer + typed, read) + MlirFeeding(function, at).Store(temp + "Value", target)
Collect(at Number) Texts
	temp = "%d" + at
	pointer = "    " + temp + "Pointer = llvm.getelementptr %batchOutput[%batchIndex]"
	constant typed = " : (!llvm.ptr, i64) -> !llvm.ptr, f32"
	read = function.Load(temp + "Value", "%r" + function.method.instructions(at).payload(0))
	(pointer + typed, read, function.Store(temp + "Value", temp + "Pointer"))
Stored Texts
	List(Text) + Storing + " : (!llvm.ptr, i64, i64, !llvm.ptr, i64) -> ()"
LinearPrefetch(at Number) Texts
	emitted = Prefetch(at)
	function.method.instructions(at).kind is not InstructionType.IndexCall then emitted else emitted + Fill(at)
Fill(at Number) Texts
	mutable lines = List(Mutable(Text))
	for 3
		prefix = "%d" + at + "Next" + index
		number = MlirTyped.Integer.Constant(prefix + "Lane", "" + (index + 1))
		added = "    " + prefix + " = arith.addi %d" + at + "position, " + prefix + "Lane : i64"
		pointer = "    " + prefix + "Pointer = llvm.getelementptr %indices" + at + "[" + (index + 1) + "]"
		constant typed = " : (!llvm.ptr) -> !llvm.ptr, i64"
		lines = lines + number + added + (pointer + typed) + MlirTyped.Integer.Store(prefix, prefix + "Pointer")
	lines