has name Text
constant Converting = MlirBits("%n")
constant ConvertedFields = ("    %nb = llvm.bitcast %v : f64 to i64", "    %n0 = arith.constant 0 : i64", "    %n1 = arith.constant 1 : i64")
constant ConvertedIntegers = ("    %n52 = arith.constant 52 : i64", "    %nk1 = arith.constant 2047 : i64", "    %nx = arith.shrui %nb, %n52 : i64", "    %nk = arith.andi %nx, %nk1 : i64", "    %nmm = arith.constant 4503599627370495 : i64", "    %nm = arith.andi %nb, %nmm : i64", "    %niu = arith.constant 4503599627370496 : i64", "    %niz = arith.cmpi ne, %nk, %n0 : i64", "    %nii = arith.select %niz, %niu, %n0 : i64", "    %ni = arith.ori %nm, %nii : i64", "    %nrr = arith.constant 1075 : i64", "    %nr = arith.subi %nrr, %nk : i64")
constant ConvertedMagnitude = ("    %n63 = arith.constant 63 : i64", "    %nt = arith.minui %nr, %n63 : i64", "    %nf = arith.shrui %ni, %nt : i64", "    %nn = arith.cmpi slt, %nb, %n0 : i64", "    %nc = arith.subi %n0, %nf : i64", "    %n_e = arith.select %nn, %nc, %nf : i64")
constant ConvertedExact = ("    %nh = arith.shli %n1, %nt : i64", "    %ny = arith.subi %nh, %n1 : i64", "    %nj = arith.andi %ni, %ny : i64", "    %nw = arith.cmpi eq, %nj, %n0 : i64", "    %n_q = arith.extui %nw : i1 to i64")
Converted(number Text) Texts
	Converting.Converted("%v") is ConvertedFields + ConvertedIntegers + ConvertedMagnitude + ConvertedExact
	Converting.Converted("%v").First is "    %nb = llvm.bitcast %v : f64 to i64"
	Converting.Converted("%v").Last is "    %n_q = arith.extui %nw : i1 to i64"
	let fields = (Line("b", "llvm.bitcast " + number + " : f64 to i64"), Constant("0", "0"), Constant("1", "1"))
	fields + Integers + Magnitude + Exact
Integers Texts
	Converting.Integers is ConvertedIntegers
	Converting.Integers(5) is "    %nm = arith.andi %nb, %nmm : i64"
	Converting.Integers(8) is "    %nii = arith.select %niz, %niu, %n0 : i64"
	let exponent = (Constant("52", "52"), Constant("k1", "2047"), Operation("x", "shrui", "b", "52"))
	let masked = (Operation("k", "andi", "x", "k1"), Constant("mm", "4503599627370495"), Operation("m", "andi", "b", "mm"))
	let present = (Constant("iu", "4503599627370496"), Operation("iz", "cmpi ne,", "k", "0"))
	let implicit = Line("ii", "arith.select " + Named("iz") + ", " + Named("iu") + ", " + Named("0") + " : i64")
	let combined = (implicit, Operation("i", "ori", "m", "ii"), Constant("rr", "1075"), Operation("r", "subi", "rr", "k"))
	exponent + masked + present + combined
Magnitude Texts
	Converting.Magnitude is ConvertedMagnitude
	Converting.Magnitude.Last is "    %n_e = arith.select %nn, %nc, %nf : i64"
	let shifted = (Constant("63", "63"), Operation("t", "minui", "r", "63"), Operation("f", "shrui", "i", "t"))
	let negative = (Operation("n", "cmpi slt,", "b", "0"), Operation("c", "subi", "0", "f"))
	shifted + negative + Line("_e", "arith.select " + Named("n") + ", " + Named("c") + ", " + Named("f") + " : i64")
Exact Texts
	Converting.Exact is ConvertedExact
	Converting.Exact(1) is "    %ny = arith.subi %nh, %n1 : i64"
	Converting.Exact.Last is "    %n_q = arith.extui %nw : i1 to i64"
	let lost = (Operation("h", "shli", "1", "t"), Operation("y", "subi", "h", "1"), Operation("j", "andi", "i", "y"))
	lost + Operation("w", "cmpi eq,", "j", "0") + Line("_q", "arith.extui " + Named("w") + " : i1 to i64")
Operation(result Text, operation Text, left Text, right Text) Text
	Converting.Operation("k", "andi", "x", "k1") is "    %nk = arith.andi %nx, %nk1 : i64"
	Line(result, "arith." + operation + " " + Named(left) + ", " + Named(right) + " : i64")
Constant(result Text, number Text) Text
	Converting.Constant("52", "52") is "    %n52 = arith.constant 52 : i64"
	Line(result, "arith.constant " + number + " : i64")
Line(result Text, operation Text) Text
	Converting.Line("e", "arith.addi %a, %b : i64") is "    %ne = arith.addi %a, %b : i64"
	"    " + Named(result) + " = " + operation
Named(suffix Text) Text
	Converting.Named("b") is "%nb"
	name + suffix
