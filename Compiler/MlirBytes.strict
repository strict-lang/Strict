has function MlirFunction
has position Number
constant Looped = (InstructionEntry.Named(InstructionType.LoadVariableToRegister, 0, "numbers"), InstructionEntry.LoopBegin(0, -1))
constant Values = Looped + (InstructionEntry.Named(InstructionType.LoadVariableToRegister, 1, "value"), InstructionEntry.Jump(InstructionType.LoopEnd, 2))
constant Valuing = MlirBytes(MlirFunction(List(TypeEntry) + MlirFunction.Shape, MlirFunction.Shape, MethodEntry("Run", List(MemberEntry) + MlirLists.Items, "None", Values)), 1)
constant Indexes = Looped + (InstructionEntry.LoadNumber(1, 0), InstructionEntry(InstructionType.IndexCall, "value", (2, 1, -1)), InstructionEntry.Jump(InstructionType.LoopEnd, 3))
constant Indexing = MlirBytes(MlirFunction(List(TypeEntry) + MlirFunction.Shape, MlirFunction.Shape, MethodEntry("Run", List(MemberEntry) + MlirLists.Items, "None", Indexes)), 1)
constant Placed = Looped + (InstructionEntry.LoadNumber(1, 0), InstructionEntry.Named(InstructionType.StoreRegisterToVariable, 1, "numbers(value)"), InstructionEntry.Jump(InstructionType.LoopEnd, 3))
constant Placing = MlirBytes(MlirFunction(Valuing.function, method = MethodEntry(Valuing.function.method, instructions = Placed)), 1)
constant Iterating = MlirBytes(MlirLoops.Bytewise.function, 1)
constant Collecting = MlirBytes(MlirFastLoop.Byting.function, 2)
constant Doubling = MlirBytes(MlirFastLoop.Doubling.function, 2)
constant Laning = MlirBytes(MlirLanes.Collecting, 2)
constant Singling = MlirBytes(MlirFunction(List(TypeEntry), MlirFunction.Shape, MlirLayout.Singles.method), 2)
IsIterated Boolean
	Iterating.IsIterated
	Laning.IsIterated
	MlirBytes(MlirLoops.Listing.function, 1).IsIterated is false
	Iterated > 0
Iterated Number
	Iterating.Iterated is 9
	Laning.Iterated is MlirDoubles.LanesFormat
	Doubling.Iterated is 0
	let entry = function.method.instructions(position)
	let kind = entry.payload(1) is 1 then "" else MlirKinds(function).KindOf(position, entry.payload(0))
	if kind is in ("Bytes", "List(Byte)")
		return 9
	MlirLanes(function, 0).IsPacked(MlirKinds(function).ElementKind(kind)) then MlirDoubles.LanesFormat else 0
Item Text
	Iterating.Item is "byte"
	Laning.Item is "lane"
	Iterated is MlirDoubles.LanesFormat then "lane" else "byte"
IsCollected Boolean
	Collecting.IsCollected
	Laning.IsCollected
	Singling.IsCollected
	Doubling.IsCollected is false
	MlirLayout(function).Packed(position) is in (9, MlirDoubles.Float32Format, MlirDoubles.LanesFormat)
Itemizer Text
	Collecting.Itemizer is "@strict_list_data"
	Doubling.Itemizer is "@strict_list_items"
	IsCollected then "@strict_list_data" else "@strict_list_items"
Width Text
	Collecting.Width is "i8"
	Doubling.Width is "f64"
	Laning.Width is "i32"
	Singling.Width is "f32"
	let packed = MlirLayout(function).Packed(position)
	IsCollected then ("i8", "f32", "i32")((9, MlirDoubles.Float32Format, MlirDoubles.LanesFormat).Index(packed)) else "f64"
Started(result Text, items Text) Texts
	Collecting.Started("%r", "%i").Last is "    %i = func.call @strict_list_data(%r) : (f64) -> !llvm.ptr"
	Doubling.Started("%t2r", "%i").Last is "    %i = func.call @strict_list_items(%t2r) : (f64) -> !llvm.ptr"
	let created = IsCollected then Created(result) else MlirLoops(function, position).Presized
	created + ("    " + items + " = func.call " + Itemizer + "(" + result + ") : (f64) -> !llvm.ptr")
Hoisted(items Text, list Text, itemizer = "items") Texts
	Iterating.Hoisted("%h", "%v")(1) is "    %h = func.call @strict_list_byte_items(%v) : (f64) -> !llvm.ptr"
	Doubling.Hoisted("%h", "%v") is ("    %h = func.call @strict_list_items(%v) : (f64) -> !llvm.ptr")
	Laning.Hoisted("%h", "%v")(1) is "    %h = func.call @strict_list_lane_items(%v) : (f64) -> !llvm.ptr"
	MlirBytes(MlirFunction(Doubling.function, Packing = "for 32"), 2).Hoisted("%h", "%v").First.IndexOf("_data(%v)") > 0
	let reader = MlirWidths(function, position).Element(MlirFastLoop.Iterated) is "f64" then itemizer else "data"
	let plain = "    " + items + " = func.call @strict_list_" + reader + "(" + list + ") : (f64) -> !llvm.ptr"
	if IsIterated is false
		return List(Text) + plain
	let data = "    " + items + "b = func.call @strict_list_" + Item + "s(" + list + ") : (f64) -> !llvm.ptr"
	(data, "    " + items + " = func.call @strict_list_" + Item + "_items(" + list + ") : (f64) -> !llvm.ptr")
Created(result Text) Texts
	Collecting.Created("%r")(3) is "    %r = func.call @strict_packed_new(%relements, %rformat) : (i64, i64) -> f64"
	Doubling.Created("%r").Length is 0
	Laning.Created("%r")(2) is "    %rformat = arith.constant 33 : i64"
	if IsCollected is false
		return List(Text)
	let count = "    " + result + "positive = arith.maximumf %t" + position + "n, %zero : f64"
	let whole = "    " + result + "elements = arith.fptosi " + result + "positive : f64 to i64"
	let format = "    " + result + "format = arith.constant " + MlirLayout(function).Packed(position) + " : i64"
	let operands = "(" + result + "elements, " + result + "format) : (i64, i64) -> f64"
	let created = "    " + result + " = func.call @strict_packed_new" + operands
	(count, whole, format, created, function.Store(result, "%v_forResult"))
Stored(element Text, pointer Text) Texts
	Collecting.Stored("%e", "%p").First is "    %eb = func.call @strict_byte_packed(%e) : (f64) -> i8"
	Collecting.Stored("%e", "%p").Last is "    llvm.store %eb, %p : i8, !llvm.ptr"
	Doubling.Stored("%e", "%p") is ("    llvm.store %e, %p : f64, !llvm.ptr")
	Laning.Stored("%e", "%p") is ("    %eb = arith.fptoui %e : f64 to i32", "    llvm.store %eb, %p : i32, !llvm.ptr")
	Singling.Stored("%e", "%p") is ("    %eb = arith.truncf %e : f64 to f32", "    llvm.store %eb, %p : f32, !llvm.ptr")
	if IsCollected is false
		return List(Text) + ("    llvm.store " + element + ", " + pointer + " : f64, !llvm.ptr")
	let byte = "    " + element + "b = func.call @strict_byte_packed(" + element + ") : (f64) -> i8"
	let lanes = "    " + element + "b = arith.fptoui " + element + " : f64 to i32"
	let single = "    " + element + "b = arith.truncf " + element + " : f64 to f32"
	let converted = Width is "f32" then single else (Width is "i32" then lanes else byte)
	(converted, "    llvm.store " + element + "b, " + pointer + " : " + Width + ", !llvm.ptr")
IsValued Boolean
	Valuing.IsValued
	Indexing.IsValued
	Placing.IsValued
	MlirBytes(MlirLoops.Listing.function, 1).IsValued is false
	for Range(position + 1, function.method.LoopEndOf(position))
		let entry = function.method.instructions(value)
		let named = entry.texts.Length > 0 then entry.texts(0) else ""
		let element = MlirLists(function, value).IsElementStore then PayloadDecoder(entry).ElementParts(1) else ""
		if IsValueName(named) or IsValueName(element)
			return true
	false
IsValueName(name Text) Boolean
	Valuing.IsValueName("outer.index")
	Valuing.IsValueName("numbers") is false
	(name is in ("value", "outer")) or name.StartsWith("value(") or name.StartsWith("outer.")
