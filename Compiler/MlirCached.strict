has function MlirFunction
constant Seven = MethodEntry("B", List(MemberEntry), "Strict/Number", (InstructionEntry.LoadNumber(0, 7), InstructionEntry.Return(0)))
constant Kept = MlirCached(MlirFunction(List(TypeEntry) + TypeEntry.Kept, TypeEntry.Kept, Seven))
constant Global = "  llvm.mlir.global internal @"
constant Pointer = " : !llvm.ptr"
constant Address = " = llvm.mlir.addressof @"
constant Checked = ("    %setBits = llvm.load %set atomic acquire {alignment = 8 : i64} : !llvm.ptr -> i64", "    %unset = arith.constant 0 : i64", "    %isSet = arith.cmpi ne, %setBits, %unset : i64", "    %cached = llvm.load %cache : !llvm.ptr -> f64", "    cf.cond_br %isSet, ^done(%cached : f64), ^compute", "  ^compute:")
constant Stored = ("    func.call @strict_pin(%computed) : (f64) -> ()", "    llvm.store %computed, %cache : f64, !llvm.ptr", "    %one = arith.constant 1 : i64", "    llvm.store %one, %set atomic release {alignment = 8 : i64} : i64, !llvm.ptr", "    cf.br ^done(%computed : f64)", "  ^done(%result: f64):", "    return %result : f64", "  }")
Called Text
	Kept.Called is "A_B_0Cached"
	MlirCached(MlirFunction.Counter).Called is "Counter_Run_0"
	function.type.ConstantSlot(function.method) >= 0 then function.Symbol + "Cached" else function.Symbol
Wrapper Texts
	Kept.Wrapper(1) is "  llvm.mlir.global internal @sA_B_0(0 : i64) : i64"
	Kept.Wrapper.Index("    llvm.store %one, %set atomic release {alignment = 8 : i64} : i64, !llvm.ptr") > 0
	Kept.Wrapper.Index("    %computed = func.call @A_B_0(%p0) : (f64) -> f64") > 0
	MlirCached(MlirFunction.Counter).Wrapper.Length is 0
	if function.type.ConstantSlot(function.method) < 0
		return List(Text)
	let symbol = function.Symbol
	let globals = (Global + "k" + symbol + "(0.0 : f64) : f64", Global + "s" + symbol + "(0 : i64) : i64")
	let header = "  func.func private @" + Called + "(%p0: f64) -> f64 {"
	let addresses = ("    %cache" + Address + "k" + symbol + Pointer, "    %set" + Address + "s" + symbol + Pointer)
	globals + header + addresses + Checked + ("    %computed = func.call @" + symbol + "(%p0) : (f64) -> f64") + Stored
