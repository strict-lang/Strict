has function MlirFunction
has position Number
constant NewShape = InstructionEntry.Invoke(1, ("Strict/Shape", "from", "Strict/Shape", "width"), 0, -1)
constant Area = InstructionEntry.Invoke(2, ("Strict/Shape", "Area", "Strict/Number"), List(Number), 1)
constant AreaMethod = MethodEntry("Area", List(MemberEntry), "Strict/Number", (InstructionEntry.LoadNumber(0, 2), InstructionEntry.Return(0)))
constant AreaShape = TypeEntry("Strict/Shape", MlirFunction.Shape.members, List(MethodEntry) + AreaMethod)
constant Shapes = MlirFunction(List(TypeEntry) + AreaShape, AreaShape, MethodEntry("Run", List(MemberEntry), "None", (InstructionEntry.LoadNumber(0, 3), NewShape, Area, InstructionEntry.PrintValue("Hi ", 0, false))))
Temp(suffix Text) Text
	MlirCalls(Shapes, 1).Temp("a") is "%t1a"
	"%t" + position + suffix
Emitted Texts
	MlirCalls(Shapes, 1).Emitted.Last is "    llvm.store %t1of, %r1 : f64, !llvm.ptr"
	let entry = function.method.instructions(position)
	if entry.kind is InstructionType.Print
		return Printed(entry)
	if entry.kind is InstructionType.FieldLoad
		return MlirInstances(function, position).Field(entry)
	if MlirTexts(function, position).IsConversion
		return MlirTexts(function, position).Converted(entry)
	let decoder = PayloadDecoder(entry)
	if decoder.Text(2) is "from"
		return MlirInstances(function, position).Constructed(entry, decoder.Text(1))
	Invoked(entry, decoder)
Invoked(entry InstructionEntry, decoder PayloadDecoder) Texts
	MlirCalls(Shapes, 2).Invoked(Area, PayloadDecoder(Area)).Last is "    llvm.store %t2r, %r2 : f64, !llvm.ptr"
	let type = function.TypeOf(decoder.Text(1))
	let count = entry.payload(5 + entry.payload(3))
	let helper = NativeHelper(entry, decoder)
	if helper is not ""
		return MlirNatives(function, position).Emitted(entry, type, helper)
	Compiled(entry, decoder, type, count)
Compiled(entry InstructionEntry, decoder PayloadDecoder, type TypeEntry, count Number) Texts
	MlirCalls(Shapes, 2).Compiled(Area, PayloadDecoder(Area), AreaShape, 0).Length is 3
	let callee = Callee(type, decoder.Text(2), count, decoder.Text(4 + entry.payload(3)))
	if callee.instructions.Length is 0
		return List(Text) + MlirStatements(function, position).Unsupported("call of " + type.Name + "." + decoder.Text(2))
	let target = MlirFunction(function.types, type, callee)
	let types = Text.Combine(ArgumentTypes(target.Parameters.Length), ", ")
	let call = "    " + Temp("r") + " = func.call @" + target.Symbol + "(" + Operands(entry) + ") : (" + types + ") -> f64"
	Loads(entry, type) + call + function.Store(Temp("r"), "%r" + entry.payload(0))
NativeHelper(entry InstructionEntry, decoder PayloadDecoder) Text
	MlirCalls(Shapes, 2).NativeHelper(Area, PayloadDecoder(Area)) is ""
	let type = function.TypeOf(decoder.Text(1))
	let count = entry.payload(5 + entry.payload(3))
	let natives = MlirNatives(function, position)
	let owned = natives.Helper(Owner(entry, type), decoder.Text(2), count)
	owned is "" then natives.Helper(type.Name, decoder.Text(2), count) else owned
Owner(entry InstructionEntry, type TypeEntry) Text
	MlirCalls(Shapes, 2).Owner(Area, AreaShape) is "Shape"
	let countPosition = 5 + entry.payload(3)
	let flagPosition = countPosition + 1 + entry.payload(countPosition)
	let hasInstance = entry.payload(flagPosition) is 1
	hasInstance then MlirKinds(function).KindOf(position, entry.payload(flagPosition + 1)) else type.Name
Callee(type TypeEntry, name Text, count Number, returnType Text) MethodEntry
	MlirCalls(Shapes, 1).Callee(AreaShape, "Size", 0, "Number").instructions.Length is 0
	let returned = MlirKinds(function).Short(returnType)
	for type.methods
		let isReturning = name is not "to" or (MlirKinds(function).Short(value.returnType) is returned)
		if (value.Name is name) and (value.parameters.Length is count) and isReturning
			return value
	MethodEntry(name, List(MemberEntry), "None", List(InstructionEntry))
Loads(entry InstructionEntry, type TypeEntry) Texts
	MlirCalls(Shapes, 2).Loads(Area, AreaShape).Length is 1
	let countPosition = 5 + entry.payload(3)
	let flagPosition = countPosition + 1 + entry.payload(countPosition)
	let hasInstance = entry.payload(flagPosition) is 1
	let isOwn = type.Name is function.type.Name
	let self = hasInstance then "%r" + entry.payload(flagPosition + 1) else isOwn then "%instance" else ""
	constant none = "    " + Temp("m") + " = arith.constant 0.0 : f64"
	let first = self is "" then none else function.Load(Temp("m"), self)
	List(Text) + first + ArgumentLoads(entry)
ArgumentLoads(entry InstructionEntry) Texts
	MlirCalls(Shapes, 2).ArgumentLoads(Area).Length is 0
	let countPosition = 5 + entry.payload(3)
	for entry.payload(countPosition)
		function.Load(Temp("a" + index), "%r" + entry.payload(countPosition + 1 + index))
Operands(entry InstructionEntry) Text
	MlirCalls(Shapes, 2).Operands(Area) is "%t2m"
	let names = List(Text) + Temp("m") + ArgumentNames(entry.payload(5 + entry.payload(3)))
	Text.Combine(names, ", ")
ArgumentNames(count Number) Texts
	MlirCalls(Shapes, 2).ArgumentNames(2) is ("%t2a0", "%t2a1")
	for count
		Temp("a" + index)
ArgumentTypes(count Number) Texts
	MlirCalls(Shapes, 1).ArgumentTypes(2) is ("f64", "f64")
	for count
		"f64"
Printed(entry InstructionEntry) Texts
	MlirCalls(Shapes, 3).Printed(InstructionEntry.PrintValue("Hi ", 0, false)).Length is 6
	let address = "    " + Temp("a") + " = llvm.mlir.addressof @s" + function.Symbol + "_" + position + " : !llvm.ptr"
	constant printf = " = llvm.call @printf("
	constant vararg = ") vararg(!llvm.func<i32 (ptr, ...)>) : (!llvm.ptr"
	if entry.payload(1) is 0
		return (address, "    " + Temp("c") + printf + Temp("a") + vararg + ") -> i32")
	constant pointerCall = "    " + Temp("c") + printf + Temp("a") + ", " + Temp("bp") + vararg + ", !llvm.ptr) -> i32"
	List(Text) + address + MlirTexts(function, position).Pointer(entry.payload(2), "b") + pointerCall