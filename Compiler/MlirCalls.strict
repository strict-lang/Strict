has function MlirFunction
has position Number
constant NewShape = InstructionEntry.Invoke(1, ("Strict/Shape", "from", "Strict/Shape", "width"), 0, -1)
constant Area = InstructionEntry.Invoke(2, ("Strict/Shape", "Area", "Strict/Number"), List(Number), 1)
constant AreaShape = TypeEntry("Strict/Shape", MlirFunction.Shape.members, List(MethodEntry) + MethodEntry("Area", List(MemberEntry), "Strict/Number", (InstructionEntry.LoadNumber(0, 2), InstructionEntry.Return(0))))
constant Shapes = MlirFunction(List(TypeEntry) + AreaShape, AreaShape, MethodEntry("Run", List(MemberEntry), "None", (InstructionEntry.LoadNumber(0, 3), NewShape, Area, InstructionEntry.PrintValue("Hi ", 0, false))))
constant FromText = MethodEntry("from", MemberEntry("text", "Strict/Text", List(InstructionEntry), false), "Strict/Hash", (InstructionEntry.LoadNumber(0, 3), InstructionEntry.Return(0)))
constant Hash = TypeEntry("Strict/Hash", MemberEntry("number", "Strict/Number", List(InstructionEntry), false), List(MethodEntry) + FromText)
constant Defaulted = MethodEntry("from", MemberEntry("text", "Strict/Text", InstructionEntry.Set(List(Text), InstructionEntry.NumberValue(2)), false), "Strict/Hash", FromText.instructions)
constant Hashed = InstructionEntry.Invoke(1, ("Strict/Hash", "from", "Strict/Hash", "text"), 0, -1)
constant Hashes = MlirFunction(List(TypeEntry) + Hash, Hash, MethodEntry("Run", List(MemberEntry), "None", (InstructionEntry.LoadText(0, "abc"), Hashed)))
constant Holding = MlirFunction(TypeEntry.Holding, TypeEntry.Holding(1), MethodEntry("Run", List(MemberEntry), "None", (InstructionEntry.LoadNumber(0, 5), InstructionEntry.HolderFrom)))
constant CounterType = TypeEntry(MlirForeign.Counter.Name, MlirForeign.Counter.members, List(MethodEntry) + MlirForeign.Started)
constant NewCounter = InstructionEntry.Invoke(2, (CounterType.Name, "from", CounterType.Name, "left", "right"), (0, 1), -1)
constant Counters = MlirCalls(MlirFunction(List(TypeEntry) + CounterType, CounterType, MethodEntry("Run", List(MemberEntry), "None", (InstructionEntry.LoadNumber(0, 10), InstructionEntry.LoadNumber(1, 5), NewCounter))), 2)
Temp(suffix Text) Text
	Text.Combine(MlirCalls(Shapes, 3).Print(InstructionEntry.Print("Hi"))).Length is 128
	Text.Combine(MlirCalls(Shapes, 3).Print(InstructionEntry.PrintValue("Hi ", 0, false))).Length is 448
	MlirCalls(Shapes, 3).Print(InstructionEntry.Print("Hi")).Last.IndexOf("@strict_log(%t3a, %t3a)") > 0
	Text.Combine(MlirCalls(Shapes, 2).Compile(Area, PayloadDecoder(Area), AreaShape, 0)).Length is 143
	Text.Combine(Counters.Creat(NewCounter, PayloadDecoder(NewCounter))).Length is 554
	MlirCalls(Shapes, 1).Temp("a") is "%t1a"
	"%t" + position + suffix
Emitted Texts
	MlirCalls(Shapes, 1).Emitted.Last is "    llvm.store %t1r, %r1 : f64, !llvm.ptr"
	MlirCalls(Hashes, 1).Emitted.Last is "    llvm.store %t1r, %r1 : f64, !llvm.ptr"
	Text.Combine(MlirCalls(Shapes, 1).Emitted).IndexOf("@strict_pin(%t1of)") > 0
	entry = function.method.instructions(position)
	if entry.kind is InstructionType.Print
		return Print(entry)
	if entry.kind is InstructionType.FieldLoad
		return MlirInstances(function, position).Field(entry)
	if MlirTexts(function, position).IsConversion
		return MlirTexts(function, position).Convert(entry)
	decoder = PayloadDecoder(entry)
	decoder.Text(2) is "from" then Creat(entry, decoder) else Invoke(entry, decoder)
Creat(entry InstructionEntry, decoder PayloadDecoder) Texts
	MlirCalls(Shapes, 1).Creat(NewShape, PayloadDecoder(NewShape)).Last is "    llvm.store %t1r, %r1 : f64, !llvm.ptr"
	Text.Combine(MlirCalls(Hashes, 1).Creat(Hashed, PayloadDecoder(Hashed))).IndexOf("@Hash_from_1(%t1m") > 0
	Text.Combine(Counters.Creat(NewCounter, PayloadDecoder(NewCounter))).IndexOf("@Counter_from_foreign(") > 0
	type = function.TypeOf(decoder.Text(1))
	count = PayloadDecoder(entry).ArgumentCount
	custom = decoder.Callee(type)
	instances = MlirInstances(function, position)
	target = "%r" + entry.payload(0)
	isForeign = MlirForeign(MlirFunction(function.types, type, custom, typeIndex = function.typeIndex)).IsForeign
	if custom.instructions.Length is 0 and isForeign is false or IsMemberValue(entry, type, custom)
		return Share(MlirPairs(function, position).Construct(entry, decoder.Text(1), instances), target)
	instances.Fresh(type, target, "f", List(Text)) + Compile(entry, decoder, type, count)
Share(constructed Texts, target Text) Texts
	MlirCalls(Shapes, 1).Share(List(Text), "%r1").Last is "    llvm.store %t1r, %r1 : f64, !llvm.ptr"
	MlirCalls(Hashes, 1).Share(List(Text), "%r1").Length is 0
	if MlirConstants(function, position).IsConstant is false
		return constructed
	isFlat = MlirFlats(function, position).Count(function.method.instructions(position).texts(0)) > 0
	pin = isFlat then "strict_flat_pin" else "strict_pin"
	MlirLists(function, position).Cache(constructed, Temp("of"), pin) + function.Store(Temp("r"), target)
IsMemberValue(entry InstructionEntry, type TypeEntry, chosen MethodEntry) Boolean
	MlirCalls(Hashes, 1).IsMemberValue(Hashed, Hash, FromText) is false
	MlirCalls(Holding, 1).IsMemberValue(InstructionEntry.HolderFrom, Holding.type, Holding.type.methods.First) is false
	layout = MlirLayout(function)
	members = type.Changing
	arguments = PayloadDecoder(entry).Arguments
	if members.Length is not 1 or arguments.Length is not 1 or chosen.parameters.Length is not 1
		return false
	member = layout.Represent(TypeEntry.ShortName(members.First.typeName))
	if layout.Represent(TypeEntry.ShortName(chosen.parameters.First.typeName)) is member
		return false
	argument = MlirKinds(function).KindOf(position, arguments.First)
	argument is TypeEntry.ShortName(type.Name) or layout.Represent(argument) is member
Invoke(entry InstructionEntry, decoder PayloadDecoder) Texts
	MlirCalls(Shapes, 2).Invoke(Area, PayloadDecoder(Area)).Last is "    llvm.store %t2r, %r2 : f64, !llvm.ptr"
	Text.Combine(MlirCalls(MlirGroups.Norming.function, 11).Emitted).IndexOf("^t11kept") > 0
	MlirCalls(MlirTails.Sample.function, 1).Emitted.Last is "  ^tail1:"
	type = MlirLayout(function).Owner(function.TypeOf(decoder.Text(1)), decoder.Text(2))
	if MlirTails(function, position).IsTail
		return MlirTails(function, position).Jump(entry, type)
	count = PayloadDecoder(entry).ArgumentCount
	helper = NativeHelper(entry, decoder)
	if helper is not ""
		return MlirDestined(function, position).Aim(entry, MlirNatives(function, position).Emit(entry, type, helper))
	compiled = MlirDestined(function, position).Aim(entry, Compile(entry, decoder, type, count))
	MlirGrouped(function, position).Keep(compiled, entry.payload(0))
Compile(entry InstructionEntry, decoder PayloadDecoder, type TypeEntry, count Number) Texts
	MlirCalls(Shapes, 2).Compile(Area, PayloadDecoder(Area), AreaShape, 0).Length is 3
	callee = decoder.Callee(type)
	target = MlirFunction(function.types, type, callee, typeIndex = function.typeIndex)
	if callee.instructions.Length is 0 and MlirForeign(target).IsForeign is false
		return List(Text) + MlirStatements(function, position).Unsupport("call of " + type.Name + "." + decoder.Text(2))
	types = Text.Combine(ArgumentTypes(target.Parameters.Length), ", ")
	texts = MlirTextLists(value, MlirTextLists.IsTexted(type.Name, Owner(entry, type)), callee.declaredType)
	names = Text.Combine(List(Text) + texts.Instance + ArgumentNames(callee.parameters.Length), ", ")
	called = "    " + texts.Result + " = func.call @" + MlirCached(target).Called
	call = called + "(" + names + ") : (" + types + ") -> f64"
	returned = MlirSpent(function, position).Dead + MlirChecks(function, position).EmitReturn(target, entry.payload(0))
	defaults = Defaults(callee, count)
	MlirWholeCall(function, position).Dispatch(texts.Call(Loads(entry, type), defaults, call) + returned)
Defaults(callee MethodEntry, count Number) Texts
	MlirCalls(Hashes, 1).Defaults(Defaulted, 0).Last is "    %t1a0 = llvm.load %r1 : !llvm.ptr -> f64"
	if count > callee.parameters.Length
		called = function.type.Name + "." + function.method.Name + " calls " + callee.Name + " with " + count
		return Error("InvalidCallArity: " + called + " instead of " + callee.parameters.Length)
	scratch = "%r" + function.method.instructions(position).payload(0)
	mutable lines = List(Mutable(Text))
	for Range(count, callee.parameters.Length)
		initial = Natives(function.types).Initial(callee.parameters(value))
		named = MlirDefaults(function).NameParameter(initial)
		literal = MlirStatements(function, position).Literal(initial, scratch, "p" + value, named)
		lines = lines + literal + function.Load(Temp("a" + value), scratch)
	lines
NativeHelper(entry InstructionEntry, decoder PayloadDecoder) Text
	MlirCalls(Shapes, 2).NativeHelper(Area, PayloadDecoder(Area)) is ""
	if MlirCodes(function, position).IsPairCode(entry)
		return "strict_pairs_text"
	type = function.TypeOf(decoder.Text(1))
	count = PayloadDecoder(entry).ArgumentCount
	isWrite = decoder.Text(2) is "Write" and decoder.Names.Length is 1
	name = isWrite then "Write" + decoder.Names.First.Capitalize else decoder.Text(2)
	declared = MlirNatives(function, position).Helper(type.Name, name, count)
	owned = MlirNatives(function, position).Helper(Owner(entry, type), name, count)
	paired = MlirPairs(function, position).Helper(entry, Owner(entry, type), name)
	fallback = TypeEntry.ShortName(type.Name).StartsWith("Dictionary") or owned is "" then declared else owned
	helper = MlirReadText(function, position).Helper(paired is "" then fallback else paired)
	helper.StartsWith("strict_list_") and MlirTextLists.IsTexted(type.Name, Owner(entry, type)) then "" else helper
Owner(entry InstructionEntry, type TypeEntry) Text
	MlirCalls(Shapes, 2).Owner(Area, AreaShape) is "Shape"
	instance = PayloadDecoder(entry).Instance
	instance >= 0 then MlirKinds(function).KindOf(position, instance) else type.Name
Loads(entry InstructionEntry, type TypeEntry) Texts
	MlirCalls(Shapes, 2).Loads(Area, AreaShape).Length is 1
	instance = PayloadDecoder(entry).Instance
	isOwn = type.Name is function.type.Name
	owned = instance >= 0 then "%r" + instance else isOwn then "%instance" else ""
	self = entry.texts(1) is "from" then "%r" + entry.payload(0) else owned
	constant none = "    " + Temp("m") + " = arith.constant 0.0 : f64"
	first = self is "" then none else function.Load(Temp("m"), self)
	List(Text) + first + ArgumentLoads(entry, type)
ArgumentLoads(entry InstructionEntry, type TypeEntry) Texts
	MlirCalls(Shapes, 2).ArgumentLoads(Area, AreaShape).Length is 0
	Counters.ArgumentLoads(NewCounter, CounterType).First is "    %t2a0 = llvm.load %r0 : !llvm.ptr -> f64"
	for PayloadDecoder(entry).ArgumentCount
		Argument(entry, type, index)
Argument(entry InstructionEntry, type TypeEntry, number Number) Text
	Counters.Argument(NewCounter, CounterType, 1) is "    %t2a1 = llvm.load %r1 : !llvm.ptr -> f64"
	register = PayloadDecoder(entry).Arguments(number)
	layout = MlirLayout(function)
	kind = layout.Represent(MlirKinds(function).KindOf(position, register))
	parameters = PayloadDecoder(entry).Callee(type).parameters
	wanted = number < parameters.Length then TypeEntry.ShortName(parameters(number).typeName) else ""
	isText = kind is "Text" and TypeEntry.ShortName(type.Name) is "List(Character)"
	isCharacter = isText and wanted is in ("Character", "Generic")
	if isCharacter is false and (kind is not "List(Number)" or layout.Represent(wanted) is not "List(Text)")
		return function.Load(Temp("a" + number), "%r" + register)
	raw = Temp("an" + number)
	helper = isCharacter then "strict_text_character" else "strict_list_texts"
	converted = MlirMemory(function, position).Call(Temp("a" + number), helper, List(Text) + raw)
	function.Load(raw, "%r" + register) + Character.NewLine + converted
ArgumentNames(count Number) Texts
	MlirCalls(Shapes, 1).Loads(NewShape, AreaShape)(0) is "    %t1m = llvm.load %r1 : !llvm.ptr -> f64"
	MlirCalls(Shapes, 2).Loads(Area, AreaShape) is ("    %t2m = llvm.load %r1 : !llvm.ptr -> f64")
	MlirCalls(Shapes, 2).Loads(InstructionEntry.Invoke(2, ("T", "A", "N"), List(Number), -1), Hash).First.Length is 35
	MlirCalls(Shapes, 2).Loads(InstructionEntry.Invoke(2, ("T", "A", "N"), List(Number), -1), AreaShape).First.Length is 49
	Text.Combine(MlirCalls(Hashes, 1).Defaults(Defaulted, 0)).Length is 143
	Text.Combine(MlirCalls(Shapes, 1).Share(List(Text), "%r1")).Length is 459
	MlirCalls(Shapes, 2).ArgumentNames(2) is ("%t2a0", "%t2a1")
	for count
		Temp("a" + index)
ArgumentTypes(count Number) Texts
	MlirCalls(Shapes, 1).ArgumentTypes(2) is ("f64", "f64")
	for count
		"f64"
Print(entry InstructionEntry) Texts
	MlirCalls(Shapes, 3).Print(InstructionEntry.PrintValue("Hi ", 0, false)).Last.IndexOf("@strict_log(") > 0
	address = "    " + Temp("a") + " = llvm.mlir.addressof @s" + function.Symbol + "_" + position + " : !llvm.ptr"
	text = entry.payload(1) is 0 then Temp("a") else Temp("bp")
	logged = "    func.call @strict_log(" + Temp("a") + ", " + text + ") : (!llvm.ptr, !llvm.ptr) -> ()"
	if entry.payload(1) is 0
		return (address, logged)
	List(Text) + address + MlirTexts(function, position).Pointer(entry.payload(2), "b") + logged