has function MlirFunction
has isOwner Boolean = true
constant Outer = MemberEntry("outer", "Strict/Outer", List(InstructionEntry), false)
constant Same = MethodEntry("Same", List(MemberEntry) + Outer, "Strict/Outer", (InstructionEntry.Named(InstructionType.LoadVariableToRegister, 0, "outer"), InstructionEntry.Return(0)))
constant Stale = MethodEntry("Stale", Same.parameters, "Strict/Outer", (InstructionEntry.Named(InstructionType.LoadVariableToRegister, 0, "last"), InstructionEntry.Return(0)))
constant Itself = MethodEntry("Itself", List(MemberEntry), "Strict/Holder", (InstructionEntry.Named(InstructionType.LoadVariableToRegister, 0, "value"), InstructionEntry.Return(0)))
constant Holder = TypeEntry("Strict/Holder", List(MemberEntry) + MemberEntry("last", "Strict/Outer", List(InstructionEntry), false), (Same, Stale, Itself))
constant Calling = InstructionEntry.Invoke(4, ("Strict/Holder", "Same", "Strict/Outer", "outer"), List(Number) + 3, -1)
constant Staling = InstructionEntry.Invoke(4, ("Strict/Holder", "Stale", "Strict/Outer", "outer"), List(Number) + 3, -1)
constant Making = (InstructionEntry.LoadNumber(0, 1), InstructionEntry.LoadNumber(1, 2), MlirOwned.Making)
constant Made = Making + (InstructionEntry.Named(InstructionType.StoreRegisterToVariable, 2, "kept"), InstructionEntry.Named(InstructionType.LoadVariableToRegister, 3, "kept"))
constant Ended = (InstructionEntry.LoadNumber(7, 0), InstructionEntry.Return(7))
constant Stored = InstructionEntry.Named(InstructionType.StoreRegisterToVariable, 4, "kept")
constant Types = (Holder, MlirInstances.Outer, MlirFunction.Shape)
constant Carrying = MlirCarried(MlirFunction(Types, Holder, MethodEntry("Run", List(MemberEntry), "None", (Made + Calling + Stored) + Ended)))
constant Leaking = MlirCarried(MlirFunction(Types, Holder, MethodEntry("Run", List(MemberEntry), "None", (Made + Staling + Stored) + Ended)))
constant Branched = InstructionEntry.Named(InstructionType.StoreRegisterToVariable, 4, "conditional0")
constant Branches = (Branched, InstructionEntry.Named(InstructionType.LoadVariableToRegister, 5, "kept"), InstructionEntry(Branched, payload = (5, -1)))
constant Joined = (InstructionEntry.Named(InstructionType.LoadVariableToRegister, 6, "conditional0"), InstructionEntry.Named(InstructionType.StoreRegisterToVariable, 6, "kept"))
constant Branching = MlirCarried(MlirFunction(Types, Holder, MethodEntry("Run", List(MemberEntry), "None", (Made + Calling + Branches + Joined) + Ended)))
constant Returning = MlirCarried(MlirFunction(Types, Holder, Same), false)
constant Kept = List(Text) + "kept"
constant Copied = MlirCarried(MlirOwned.Copying)
constant Escaping = MlirCarried(MlirFunction(Types, Holder, MethodEntry("Run", List(MemberEntry), "None", (Made + InstructionEntry.Named(InstructionType.StoreRegisterToVariable, 3, "other")) + Ended)))
constant Looping = MlirCarried(MlirFunction(Types, Holder, MethodEntry("Run", List(MemberEntry), "None", (Made + InstructionEntry.LoopBegin(3, -1)) + Ended)))
constant Reading = MlirCarried(MlirFunction(Types, Holder, MethodEntry("Run", List(MemberEntry), "None", (Made + InstructionEntry(InstructionType.FieldLoad, "shape", (5, 3, -1))) + Ended)))
constant Counted = (InstructionEntry.LoadNumber(5, 1), InstructionEntry.Named(InstructionType.StoreRegisterToVariable, 5, "count"))
constant Mixed = MlirCarried(MlirFunction(Types, Holder, MethodEntry("Run", List(MemberEntry), "None", (Made + Calling + Stored) + Counted + Ended)))
constant Sum = (InstructionEntry.Binary(InstructionType.Add, (0, 1, 5)), InstructionEntry.Named(InstructionType.StoreRegisterToVariable, 5, "kept"))
constant Summed = MlirCarried(MlirFunction(Types, Holder, MethodEntry("Run", List(MemberEntry), "None", (Making + Sum) + Ended)))
constant SelfCall = (InstructionEntry.Named(InstructionType.LoadVariableToRegister, 3, "last"), InstructionEntry.Invoke(4, ("Strict/Holder", "Itself", "Strict/Holder"), List(Number), 3))
constant Selfing = MlirCarried(MlirFunction(Types, Holder, MethodEntry("Run", List(MemberEntry), "None", SelfCall)))
IsCarried(name Text) Boolean
	Carrying.IsCarried("kept") and (Leaking.IsCarried("kept") is false) and (Copied.IsCarried("kept") is false)
	Branching.IsCarried("kept") and (Branching.IsCarried("conditional0") is false)
	if (IsPlain(name) is false) or (MlirOwned(function, 0).IsReference(name) is false)
		return false
	for function.method.instructions
		if (value.kind is in MlirAlone.Named) and (value.texts(0) is name)
			let isLoad = value.kind is InstructionType.LoadVariableToRegister
			if (isLoad then IsKeptRead(index, name, 0) else IsKeptValue(index, value.payload(0), (name), 0)) is false
				return false
	true
IsPlain(name Text) Boolean
	Carrying.IsPlain("kept") and (Carrying.IsPlain("conditional0") is false) and (Carrying.IsPlain("value") is false)
	MlirCarried(MlirFunction(Types, Holder, Stale)).IsPlain("last") is false
	(Carrying.IsPlain("listResult0") is false) and (Carrying.IsPlain("index") is false)
	Mixed.IsCarried("kept") and (Mixed.IsCarried("count") is false) and Reading.IsCarried("kept")
	(Escaping.IsCarried("kept") is false) and (Looping.IsCarried("kept") is false) and (Summed.IsCarried("kept") is false)
	let isTemporary = (name is in MlirOwned.Temporaries) or name.StartsWith("listResult") or name.StartsWith("conditional")
	let isOuter = (name is in function.Parameters) or (name is in MlirInstances(function, 0).StoredNames(function.type))
	(isTemporary or isOuter) is false
IsKeptRead(at Number, name Text, depth Number) Boolean
	Carrying.IsKeptRead(4, "kept", 0) and (Leaking.IsKeptRead(4, "kept", 0) is false)
	Branching.IsKeptRead(7, "kept", 0) and Branching.IsKeptRead(4, "kept", 0)
	(Escaping.IsKeptRead(4, "kept", 0) is false) and (Looping.IsKeptRead(4, "kept", 0) is false)
	let instructions = function.method.instructions
	let register = instructions(at).payload(0)
	let reuse = LoadReuse(instructions)
	for Range(at + 1, instructions.Length)
		if IsSafeUse(value, register, name, depth) is false
			return false
		if reuse.Written(instructions(value)) is register
			return true
	true
IsSafeUse(at Number, register Number, name Text, depth Number) Boolean
	Carrying.IsSafeUse(6, 4, "kept", 0) and (Carrying.IsSafeUse(5, 3, "kept", 7) is false)
	Leaking.IsSafeUse(5, 3, "kept", 0) is false
	(Escaping.IsSafeUse(5, 3, "kept", 0) is false) and (Looping.IsSafeUse(5, 3, "kept", 0) is false)
	let entry = function.method.instructions(at)
	if (entry.kind is InstructionType.StoreRegisterToVariable) and (entry.payload(0) is register)
		return IsBack(entry.texts(0), name, depth)
	if ((entry.kind is InstructionType.LoopBegin) and (entry.payload(0) is register)) or (depth > 6)
		return false
	let isPassed = (entry.kind is InstructionType.Invoke) and MlirOwned(function, 0).IsLeaked(at, register)
	(isPassed is false) or (IsKeepingCall(at, (name), depth + 1) and IsKeptRead(at, name, depth + 1))
IsBack(target Text, name Text, depth Number) Boolean
	Branching.IsBack("conditional0", "kept", 0) and Branching.IsBack("kept", "kept", 0)
	(Branching.IsBack("conditional0", "other", 0) is false) and (Branching.IsBack("other", "kept", 0) is false)
	Reading.IsKeptRead(4, "kept", 0) and (Summed.IsKeptValue(4, 5, Kept, 0) is false)
	if (target is name) or (target.StartsWith("conditional") is false)
		return target is name
	for function.method.instructions
		if (value.kind is InstructionType.LoadVariableToRegister) and (value.texts(0) is target)
			if IsKeptRead(index, name, depth) is false
				return false
	true
IsKeptValue(at Number, register Number, allowed Texts, depth Number) Boolean
	Carrying.IsKeptValue(6, 4, Kept, 0) and (Leaking.IsKeptValue(6, 4, Kept, 0) is false)
	Branching.IsKeptValue(10, 6, Kept, 0) and (Carrying.IsKeptValue(6, 4, Kept, 7) is false)
	if (depth > 6) or MlirOwned(function, 0).IsFresh(function, at, register, 0)
		return depth <= 6
	let writer = MlirKinds(function).Writer(at, register)
	let entry = writer < 0 then InstructionEntry.Return(0) else function.method.instructions(writer)
	if entry.kind is InstructionType.Invoke
		return IsKeepingCall(writer, allowed, depth + 1)
	let loaded = entry.kind is InstructionType.LoadVariableToRegister then entry.texts(0) else ""
	if (loaded is "") or (loaded is in allowed)
		return loaded is not ""
	((isOwner is false) or loaded.StartsWith("conditional")) and IsHeld(loaded, allowed + loaded, depth)
IsHeld(local Text, allowed Texts, depth Number) Boolean
	Branching.IsHeld("conditional0", Kept + "conditional0", 0) and (Leaking.IsHeld("last", Kept, 0) is false)
	if (local.StartsWith("conditional") is false) and (IsPlain(local) is false)
		return false
	for function.method.instructions
		if (value.kind is InstructionType.StoreRegisterToVariable) and (value.texts(0) is local)
			if IsKeptValue(index, value.payload(0), allowed, depth) is false
				return false
	true
IsKeepingCall(at Number, allowed Texts, depth Number) Boolean
	Carrying.IsKeepingCall(5, Kept, 0) and (Leaking.IsKeepingCall(5, Kept, 0) is false)
	Carrying.IsKeepingCall(2, Kept, 0) is false
	let callees = MlirModule(function.types, "").Called(function, at)
	if (callees.Length is 0) or (depth > 6)
		return false
	let callee = MlirCarried(callees.First, false)
	callee.IsPassing(value, at, allowed, depth) and callee.IsReturning(callee.Typed, depth)
IsPassing(caller MlirCarried, at Number, allowed Texts, depth Number) Boolean
	Returning.IsPassing(Carrying, 5, Kept, 0)
	Returning.IsPassing(Carrying, 5, Kept, 7) is false
	MlirCarried(MlirFunction(Types, Holder, Itself), false).IsPassing(Selfing, 1, Kept, 0) is false
	let entry = caller.function.method.instructions(at)
	let positions = LoadReuse(caller.function.method.instructions).InvokeReads(entry)
	let count = entry.payload(5 + entry.payload(3))
	for positions
		let parameter = index < count then function.Parameters(index + 1) else "value"
		if (parameter is in Typed) and (caller.IsKeptValue(at, entry.payload(value), allowed, depth) is false)
			return false
	true
IsReturning(allowed Texts, depth Number) Boolean
	Returning.IsReturning(List(Text) + "outer", 0)
	MlirCarried(MlirFunction(Types, Holder, Stale)).IsReturning(List(Text) + "outer", 0) is false
	for function.method.instructions
		if value.kind is InstructionType.Return
			if IsKeptValue(index, value.payload(0), allowed, depth) is false
				return false
	true
Typed Texts
	Returning.Typed is ("outer")
	MlirCarried(MlirFunction(Types, MlirInstances.Outer, Same)).Typed is ("value", "outer")
	let returned = TypeEntry.ShortName(function.method.returnType)
	((TypeEntry.ShortName(function.type.Name) is returned) then ("value") else List(Text)) + Named(returned)
Named(returned Text) Texts
	Returning.Named("Outer") is ("outer")
	Returning.Named("Shape").Length is 0
	for function.method.parameters
		if TypeEntry.ShortName(value.typeName) is returned
			value.Name
