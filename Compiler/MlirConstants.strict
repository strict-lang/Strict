has function MlirFunction
has position Number
IsConstant Boolean
	MlirConstants(MlirTexts.Joined, 0).IsConstant is true
	MlirConstants(MlirTexts.Joined, 1).IsConstant is false
	MlirConstants(MlirTexts.Joined, 2).IsConstant is false
	let isMember = position >= function.method.instructions.Length
	let kind = isMember then InstructionType.LoadConstantToRegister else function.method.instructions(position).kind
	if kind is not in (InstructionType.LoadConstantToRegister, InstructionType.StoreConstantToVariable)
		return false
	constant literal = Constant
	(literal.kind is "Text") or (literal.kind is "List") and TextElements(literal).Length > 0
TextElements(literal Runtime/VmValue) Numbers
	MlirConstants(MlirTexts.Joined, 0).TextElements(VmValue.OfList(VmValue.OfNumber(1), VmValue.OfText("a"))) is (1)
	for literal.items
		if value.kind is "Text"
			index
Constant Runtime/VmValue
	MlirConstants(MlirTexts.Joined, 0).Constant.text is "a%"
	if position >= function.method.instructions.Length
		let referenced = MlirInstances(function, 0).ReferencedConstants
		let member = referenced(position - MlirInstances.MemberBase)
		return Natives(function.types).Initial(member)
	let entry = function.method.instructions(position)
	PayloadDecoder(entry).Value(entry.kind is InstructionType.LoadConstantToRegister then 1 else 0)
Global Text
	MlirConstants(MlirTexts.Joined, 0).Global.IndexOf("@cShape_Run_0_0(\"a%\\00\") : !llvm.array<3 x i8>") > 0 is true
	constant literal = Constant
	if literal.kind is "Text"
		return TextGlobal(literal.text, "")
	mutable lines = List(Mutable(Text))
	for TextElements(literal)
		lines = lines + TextGlobal(literal.items(value).text, "_" + value)
	Text.Combine(lines, "\n")
TextGlobal(text Text, symbol Text) Text
	MlirConstants(MlirTexts.Joined, 0).TextGlobal("b", "_1").IndexOf("@cShape_Run_0_0_1(") > 0 is true
	let name = "@c" + function.Symbol + "_" + position + symbol + "(\"" + Escaped(text, false) + "\\00\")"
	"  llvm.mlir.global internal constant " + name + " : !llvm.array<" + (EscapedLength(text, false) + 1) + " x i8>"
Literal(text Text, slot Text, suffix Text) Texts
	MlirConstants(MlirTexts.Joined, 0).Literal("a%", "%r0", "").Length is 3
	MlirConstants(MlirTexts.Joined, 1).Literal("", "%s", "d0").First.IndexOf("@strict_empty") > 0 is true
	MlirConstants(MlirTexts.Joined, 1).Literal("b", "%s", "").First.StartsWith("unsupported") is true
	if text is not "" and (IsConstant is false)
		return List(Text) + MlirStatements(function, position).Unsupported("Text constant")
	Address(text, "", suffix) + function.Store(MlirMemory(function, position).Temp(suffix + "xf"), slot)
Address(text Text, symbol Text, suffix Text) Texts
	MlirConstants(MlirTexts.Joined, 0).Address("a", "_2", "e").First.IndexOf("@cShape_Run_0_0_2 ") > 0 is true
	let memory = MlirMemory(function, position)
	let name = text is "" then "@strict_empty" else "@c" + function.Symbol + "_" + position + symbol
	let address = "    " + memory.Temp(suffix + "c") + " = llvm.mlir.addressof " + name + " : !llvm.ptr"
	List(Text) + address + memory.Bits(memory.Temp(suffix + "c"), suffix + "x")
Escaped(text Text, isFormat Boolean) Text
	MlirConstants(MlirTexts.Joined, 0).Escaped("a\"%", true) is "a\\22%%"
	MlirConstants(MlirTexts.Joined, 0).Escaped("a%", false) is "a%"
	constant digits = "0123456789ABCDEF"
	mutable result = ""
	for ByteEncoder.Empty.UnicodeBytes(text)
		let isPlain = value >= 32 and value < 127 and value is not in (34, 37, 92)
		let hex = "\\" + digits.Substring((value / 16).Floor, 1) + digits.Substring(value % 16, 1)
		let percent = isFormat then "%%" else "%"
		result = result + (isPlain then Character(value) to Text else value is 37 then percent else hex)
	result
EscapedLength(text Text, isFormat Boolean) Number
	MlirConstants(MlirTexts.Joined, 0).EscapedLength("a%", true) is 3
	MlirConstants(MlirTexts.Joined, 0).EscapedLength("a%", false) is 2
	let bytes = ByteEncoder.Empty.UnicodeBytes(text)
	isFormat then bytes.Length + bytes.Count(37) else bytes.Length