has function MlirFunction
has position Number
constant External = ("File", "Directory", "Process")
constant Outside = 20000
constant Native = 8
constant Repeats = 15
constant Work = 50000
constant FileExists = InstructionEntry.Invoke(2, ("Strict/File", "Exists", "Strict/Boolean"), List(Number), 1)
constant Reading = MethodEntry("Reading", MlirParallel.Timed.parameters, "Strict/List(Number)", (MlirParallel.Timed.instructions.Slice(0, 4) + FileExists) + MlirParallel.Timed.instructions.Slice(5, 2))
constant Doubling = MlirCost(MlirParallel.Doubling.function, 2)
constant Filtering = MlirCost(MlirFunction(List(TypeEntry) + MlirParallel.Rows, MlirParallel.Rows, MlirParallel.Filtered), 2)
constant RowsMember = MemberEntry("rows", "Strict/List(List(Number))", List(InstructionEntry), false)
constant RowsLoop = (MlirLoops.Emptied, InstructionEntry.Named(InstructionType.LoadVariableToRegister, 0, "rows"), InstructionEntry.LoopBegin(0, -1), InstructionEntry.Named(InstructionType.LoadVariableToRegister, 1, "value"))
constant DoubledRow = (InstructionEntry.Invoke(2, ("Strict/Rows", "Doubled", "Strict/List(Number)", "numbers"), List(Number) + 1, -1), InstructionEntry.Named(InstructionType.InvokeWriteToList, 2, "forResult"))
constant Doubler = MethodEntry("Doubler", List(MemberEntry) + RowsMember, "Strict/List(List(Number))", RowsLoop + DoubledRow + InstructionEntry.Jump(InstructionType.LoopEnd, 4))
constant Devices = MlirCost(MlirFunction(List(TypeEntry) + MlirParallel.Rows, MlirParallel.Rows, Doubler), 2)
constant Reader = RowsLoop + FileExists + DoubledRow + InstructionEntry.Jump(InstructionType.LoopEnd, 5)
constant Device = 4096
constant SlowLoop = MlirCost(MlirFunction(Doubling.function, method = MethodEntry(Doubling.function.method, declaredType = "Slow(Numbers)")), 2)
constant Normed = MlirGroups.Norming.function
constant Norming = MlirCost(Normed, 2)
Threshold Number
	SlowLoop.Threshold is Doubling.Threshold
	Doubling.Threshold is 6250
	Filtering.Threshold is 8334
	Devices.Threshold is Device
	MlirCost(MlirFunction(Devices.function, method = MethodEntry(Doubler, instructions = Reader)), 2).Threshold is 3
	let count = (Work / Iteration).Ceiling
	let isDevice = (Iteration < Outside) and IsDevice(function, position + 1, function.method.LoopEndOf(position), 0)
	let least = isDevice then Device else 2
	count < least then least else count
IsDevice(inspected MlirFunction, first Number, last Number, depth Number) Boolean
	Devices.IsDevice(Devices.function, 3, 6, 0)
	Doubling.IsDevice(Doubling.function, 3, 6, 0) is false
	for Range(first, last)
		if (inspected.method.instructions(value).kind is InstructionType.LoopBegin) and MlirGpuCheck(inspected, value).IsGpu
			return true
		let callees = depth < 4 then MlirModule(inspected.types, "").Called(inspected, value) else List(MlirFunction)
		if (callees.Length > 0) and IsDevice(callees.First, 0, callees.First.method.instructions.Length, depth + 1)
			return true
	false
Iteration Number
	Doubling.Iteration is 8
	MlirCost(MlirFunction(List(TypeEntry) + MlirParallel.Rows, MlirParallel.Rows, Reading), 2).Iteration is 20002
	Norming.Iteration < Norming.Sum(Normed, 3, Normed.method.LoopEndOf(2), 0)
	let total = Sum(function, position + 1, function.method.LoopEndOf(position), 0)
	let kept = MlirGroups(function, position).Call
	kept < 0 then total else total - Called(function, kept, 0) + Native
Sum(inspected MlirFunction, first Number, last Number, depth Number) Number
	Doubling.Sum(Doubling.function, 3, 6, 0) is 8
	mutable total = 0
	for Range(first, last)
		total = total + Instruction(inspected, value, depth)
	total
Instruction(inspected MlirFunction, at Number, depth Number) Number
	Doubling.Instruction(Doubling.function, 3, 0) is 1
	Doubling.Instruction(Doubling.function, 4, 0) is 6
	let entry = inspected.method.instructions(at)
	if entry.kind is InstructionType.LoopBegin
		return 1 + Repeats * Sum(inspected, at + 1, inspected.method.LoopEndOf(at), depth)
	entry.kind is InstructionType.Invoke then Called(inspected, at, depth) else 1
Called(inspected MlirFunction, at Number, depth Number) Number
	Doubling.Called(Doubling.function, 4, 0) is 6
	Doubling.Called(Doubling.function, 4, 4) is Native
	if TypeEntry.ShortName(PayloadDecoder(inspected.method.instructions(at)).Text(1)) is in External
		return Outside
	let callees = MlirModule(inspected.types, "").Called(inspected, at)
	if callees.Length is 0
		return Native
	depth >= 4 then Native else 2 + Sum(callees.First, 0, callees.First.method.instructions.Length, depth + 1)
Shift Number
	Doubling.Shift is 0
	MlirCost(MlirFunction(List(TypeEntry) + MlirParallel.Rows, MlirParallel.Rows, Reading), 2).Shift is 11
	constant maximumShift = 16
	let relative = Iteration / Doubling.Iteration
	let shift = relative < 2 then 0 else (relative.Logarithm / 2.Logarithm).Floor
	shift > maximumShift then maximumShift else shift
