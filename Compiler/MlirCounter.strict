has function MlirFunction
has position Number
constant IndexLoad = InstructionEntry.Named(InstructionType.LoadVariableToRegister, 1, "index")
constant Remaining = InstructionEntry.Binary(InstructionType.Modulo, (1, 2, 3))
constant Divided = (Remaining, InstructionEntry.Binary(InstructionType.Divide, (1, 2, 4)))
constant FloorNames = ("Strict/Number", "Floor", "Strict/Number")
constant Floored = InstructionEntry.Invoke(5, FloorNames, List(Number), 4)
constant Written = InstructionEntry.Named(InstructionType.InvokeWriteToList, 6, "forResult")
constant Ended = InstructionEntry.Jump(InstructionType.LoopEnd, 8)
constant Summed = (InstructionEntry.Binary(InstructionType.Add, (3, 5, 6)), Written, Ended)
constant Quarters = MlirKernel.NumbersLoop + IndexLoad + InstructionEntry.LoadNumber(2, 4) + Divided + Floored + Summed
constant Doubler = MlirKernel.Doubler
constant Number = TypeEntry("Strict/Number", List(MemberEntry), List(MethodEntry))
constant Body = List(InstructionEntry) + MlirLoops.Emptied + Quarters
constant Quartered = MethodEntry("Quartered", Doubler.method.parameters, "Strict/List(Number)", Body)
constant Quotient = "    %t7i = arith.divsi %t2ki, %t7w : i64"
constant Quartering = MlirCounter(MlirFunction(Doubler.types, Doubler.type, Quartered, List(Number), 2), 5)
constant CountBegin = (MlirLoops.Emptied, InstructionEntry.LoadNumber(0, 16), InstructionEntry.LoopBegin(0, -1))
constant Counted = CountBegin + IndexLoad + InstructionEntry.Jump(InstructionType.LoopEnd, 2)
constant Sixteen = MethodEntry("Sixteen", Doubler.method.parameters, "None", Counted)
constant Unrolling = MlirFastLoop(MlirFunction(Doubler.types, Doubler.type, Sixteen, List(Number), 2), 2)
constant Unrollable = 16
constant Unrolled = " {loop_annotation = #llvm.loop_annotation<unroll = #llvm.loop_unroll<full = true>>}"
Remainder(entry InstructionEntry, lines Texts) Texts
	MlirStatements(Quartering.function, 5).Calculated(Remaining)(1) is "    %t5i = arith.remsi %t2ki, %t5w : i64"
	Quartering.Remainder(Divided.First, List(Text)).Last is "    llvm.store %t5c, %r3 : f64, !llvm.ptr"
	MlirCounter(MlirFunction(Quartering.function, FastLoop = -1), 5).Remainder(Divided.First, ("x")) is ("x")
	Whole(Divisor(entry.payload(1), entry.payload(2)), "remsi", entry.payload(3), lines)
Floor(entry InstructionEntry, lines Texts) Texts
	MlirNatives(Quartering.function, 7).Emitted(Floored, Number, "strict_floor")(1) is Quotient
	Quartering.At(7).Floor(Floored, List(Text)).Last is "    llvm.store %t7c, %r5 : f64, !llvm.ptr"
	Quartering.At(8).Floor(InstructionEntry.Invoke(5, FloorNames, List(Number), 3), ("x")) is ("x")
	let instance = PayloadDecoder(entry).Instance
	let writer = LoadReuse(function.method.instructions).Writer(instance, position, function.FastLoop)
	let divide = writer < 0 then entry else function.method.instructions(writer)
	if divide.kind is not InstructionType.Divide
		return lines
	Whole(At(writer).Divisor(divide.payload(1), divide.payload(2)), "divsi", entry.payload(0), lines)
Divisor(left Number, right Number) Number
	Quartering.Divisor(1, 2) is 4
	Quartering.Divisor(2, 1) is 0
	Quartering.At(4).Divisor(1, 2) is 0
	let terms = MlirKernel(function, function.FastLoop).Terms(left, position)
	(function.FastLoop >= 0) and (terms is ("index")) then Constant(right, function.FastLoop) else 0
Constant(register Number, after Number) Number
	Quartering.Constant(2, 2) is 4
	Quartering.Constant(1, 2) is 0
	Quartering.At(2).Constant(0, -1) is 0
	let writer = LoadReuse(function.method.instructions).Writer(register, position, after)
	if writer < 0
		return 0
	let loaded = function.method.instructions(writer)
	if loaded.kind is not InstructionType.LoadConstantToRegister
		return 0
	let number = PayloadDecoder(loaded).Value(1).number
	(number >= 1) and (number is number.Floor) then number else 0
Branched(target Text) Text
	Unrolling.Looped.Last is "    llvm.br ^loop2(%t2next : i64)" + Unrolled
	Quartering.At(2).Branched("^loop2") is "    cf.br ^loop2"
	let isCounted = MlirLoops(function, position).Collection is ""
	let count = isCounted then Constant(function.method.instructions(position).payload(0), -1) else 0
	(count > 0) and (count <= Unrollable) then "    llvm.br " + target + Unrolled else "    cf.br " + target
Whole(divisor Number, operation Text, register Number, lines Texts) Texts
	Quartering.Whole(0, "remsi", 3, ("x")) is ("x")
	Quartering.Whole(4, "divsi", 3, List(Text)).First is "    %t5w = arith.constant 4 : i64"
	Quartering.Whole(4, "divsi", 3, List(Text))(2) is "    %t5c = arith.sitofp %t5i : i64 to f64"
	if divisor is 0
		return lines
	let literal = "    " + Temp("w") + " = arith.constant " + divisor + " : i64"
	let whole = "    " + Temp("i") + " = arith." + operation + " %t" + function.FastLoop + "ki, " + Temp("w") + " : i64"
	let number = "    " + Temp("c") + " = arith.sitofp " + Temp("i") + " : i64 to f64"
	(literal, whole, number, function.Store(Temp("c"), "%r" + register))
Temp(suffix Text) Text
	Quartering.Temp("w") is "%t5w"
	"%t" + position + suffix
At(at Number) MlirCounter
	Quartering.At(7).position is 7
	MlirCounter(function, at)
