has function MlirFunction
has position Number
constant SizeMembers = (MemberEntry("Width", "Strict/Number", List(InstructionEntry), false, 32), MemberEntry("Height", "Strict/Number", List(InstructionEntry), false, 32))
constant Sizing = TypeEntry("Strict/Math/Sizing", SizeMembers + MemberEntry("iterator", "Strict/Iterator", List(InstructionEntry), false), List(MethodEntry))
constant Sized = InstructionEntry.Invoke(2, ("Strict/Math/Sizing", "from", "Sizing", "Width", "Height"), (0, 1), -1)
constant Heights = InstructionEntry(InstructionType.FieldLoad, "Height", (3, 2, -1))
constant Walkers = (MemberEntry("a", "Iterator", List(InstructionEntry), false), MemberEntry("b", "Strict/Iterator", List(InstructionEntry), false), MemberEntry("c", "Number", List(InstructionEntry), false))
constant Sample = MlirCouples(MlirFunction(List(TypeEntry) + Sizing, Sizing, MethodEntry("Run", List(MemberEntry), "None", (InstructionEntry.LoadNumber(0, 3), InstructionEntry.LoadNumber(1, 4), Sized, Heights))), 2)
constant Instances = MlirInstances(Sample.function, 2)
constant Turning = TypeEntry("Strict/Math/Turning", List(MemberEntry) + MemberEntry("number", "Strict/Number", List(InstructionEntry), false, 32), List(MethodEntry))
constant Turned = InstructionEntry.Invoke(1, ("Strict/Math/Turning", "from", "Turning", "number"), 0, -1)
constant Turns = MlirCouples(MlirFunction(List(TypeEntry) + Turning, Turning, MethodEntry("Run", List(MemberEntry), "None", (InstructionEntry.LoadNumber(0, 3), Turned))), 1)
constant Listing = InstructionEntry(InstructionType.FieldLoad, "numbers", (1, 0, -1))
constant OtherList = (InstructionEntry.Named(InstructionType.LoadVariableToRegister, 0, "other"), Listing, InstructionEntry.Named(InstructionType.StoreRegisterToVariable, 1, "list0"))
constant Cells = OtherList + (InstructionEntry.LoadNumber(2, 1), InstructionEntry(InstructionType.IndexCall, "list0", (3, 2)), InstructionEntry.Return(3))
constant Other = MemberEntry("other", "Strict/Math/Tripling", List(InstructionEntry), false)
constant Celled = MlirCouples(MlirFunction((MlirFlats.Tripling, MlirFlats.Summing), MlirFlats.Tripling, MethodEntry("Cell", List(MemberEntry) + Other, "Strict/Number", Cells)), 1)
constant Listed = MlirCouples(MlirPairs.Sample.function, 2)
constant Own = MlirCouples(MlirFunction(List(TypeEntry) + Sizing, Sizing, MethodEntry.CountingLoop), 0)
IsCoupled(kind Text) Boolean
	Sample.IsCoupled("Sizing")
	Sample.IsCoupled("Strict/Math/Sizing")
	Sample.IsCoupled("Number") is false
	mutable halves = 0
	for function.TypeOf(kind, true).members
		if IsPart(value)
			if IsHalf(value) is false
				return false
			halves = halves + 1
	halves is 2
Halves(type TypeEntry) List(MemberEntry)
	Sample.Halves(Sizing).Length is 2
	Sample.Halves(TypeEntry("Strict/Walking", Walkers, List(MethodEntry))).Length is 1
	for type.members
		if IsPart(value)
			value
IsPart(member MemberEntry) Boolean
	Sample.IsPart(Sizing.members.First)
	Sample.IsPart(MemberEntry("walker", "Strict/Iterator", List(InstructionEntry), false)) is false
	Sample.Aliased(InstructionEntry(InstructionType.FieldLoad, "value", (3, 2, -1)), "Sizing").Length is 2
	Turns.Constructed(Turned, "Turning", Instances) is Turns.Single(Turned, "Turning")
	Sample.Constructed(Sized, "Sizing", Instances)(1) is "    %t2cy = llvm.load %r1 : !llvm.ptr -> f64"
	constant packing = "    %t2cp = func.call @strict_two_packed(%t2cx, %t2cy) : (f64, f64) -> f64"
	Sample.Constructed(Sized, "Sizing", Instances)(2) is packing
	member.IsStored and (member.typeName is not "Iterator") and (member.typeName.EndsWith("/Iterator") is false)
IsHalf(member MemberEntry) Boolean
	Sample.IsHalf(Sizing.members.First)
	Sample.IsHalf(Sizing.members.Last) is false
	Sample.IsHalf(MemberEntry("Width", "Strict/Text", List(InstructionEntry), false, 32)) is false
	Sample.IsHalf(MemberEntry("Width", "Number", List(InstructionEntry) + Heights, false, 32)) is false
	Sample.IsHalf(MemberEntry("Width", "Number", List(InstructionEntry), false, 32))
	Sample.IsHalf(MemberEntry("Width", "Strict/Number", List(InstructionEntry), false)) is false
	let isNumber = member.typeName is in ("Number", "Strict/Number")
	isNumber and (member.initial.Length is 0) and (member.Bits is Number.SingleBits)
Constructed(entry InstructionEntry, typeName Text, instances MlirInstances) Texts
	Sample.Constructed(Sized, "Sizing", Instances).Last is "    llvm.store %t2cp, %r2 : f64, !llvm.ptr"
	Sample.Constructed(Sized, "Sizing", Instances).First is "    %t2cx = llvm.load %r0 : !llvm.ptr -> f64"
	if IsSingle(typeName)
		return Single(entry, typeName)
	if IsCoupled(typeName) is false
		return MlirFlats(function, position).Constructed(entry, typeName, instances)
	let halves = Halves(function.TypeOf(typeName, true))
	let temp = "%t" + position + "c"
	let packed = "    " + temp + "p = func.call @strict_two_packed(" + temp + "x, " + temp + "y) : (f64, f64) -> f64"
	let first = function.Load(temp + "x", Argument(entry, halves.First.Name, 0))
	let second = function.Load(temp + "y", Argument(entry, halves.Last.Name, 1))
	(first, second, packed, function.Store(temp + "p", "%r" + entry.payload(0)))
IsSingle(kind Text) Boolean
	Turns.IsSingle("Turning")
	Sample.IsSingle("Sizing") is false
	Sample.IsFlatRead(Heights) is false
	MlirCouples(MlirFlats.Reader.function, 1).IsFlatField(-1) is false
	let halves = Halves(function.TypeOf(kind, true))
	(halves.Length is 1) and (IsHalf(halves.First) or (halves.First.Bits is 8))
Single(entry InstructionEntry, kind Text) Texts
	Turns.Single(Turned, "Turning")(1) is "    %t1cr = func.call @strict_single(%t1cx) : (f64) -> f64"
	Turns.Single(Turned, "Turning").Last is "    llvm.store %t1cr, %r1 : f64, !llvm.ptr"
	Turns.Single(Turned, "Turning").First is "    %t1cx = llvm.load %r0 : !llvm.ptr -> f64"
	let member = Halves(function.TypeOf(kind, true)).First
	let temp = "%t" + position + "c"
	let rounding = member.Bits is 8 then "@strict_byte(" else "@strict_single("
	let rounded = "    " + temp + "r = func.call " + rounding + temp + "x) : (f64) -> f64"
	let loaded = function.Load(temp + "x", Argument(entry, member.Name, 0))
	(loaded, rounded, function.Store(temp + "r", "%r" + entry.payload(0)))
Argument(entry InstructionEntry, name Text, fallback Number) Text
	Sample.Argument(Sized, "Height", 0) is "%r1"
	Sample.Argument(Sized, "Other", 0) is "%r0"
	MlirCouples(MlirFlats.Made.function, 2).Constructed(MlirFlats.Construction, "Tripling", Instances).Length is 3
	constant run = MethodEntry("Run", List(MemberEntry) + Sizing.members.First, "None", List(InstructionEntry))
	MlirCouples(MlirFunction(List(TypeEntry) + Sizing, Sizing, run), 0).Unpacked.Length is 3
	let named = Invocation(entry, List(VmValue), VmValue.None).ParameterNames.Index(name)
	"%r" + PayloadDecoder(entry).Arguments(named < 0 then fallback else named)
Rounded(member MemberEntry, register Number, loaded Text) Texts
	Turns.Rounded(Turning.members.First, 0, "%a").Last is "    %a = func.call @strict_single(%aw) : (f64) -> f64"
	Turns.Rounded(Sizing.members.First, 0, "%a").Last.IndexOf("@strict_single(%aw)") > 0
	constant wide = MemberEntry("width", "Strict/Number", List(InstructionEntry), false)
	Turns.Rounded(wide, 0, "%a") is ("    %a = llvm.load %r0 : !llvm.ptr -> f64")
	constant singles = MemberEntry("orbit", "Strict/List(Number)", List(InstructionEntry), false, 32)
	Turns.Rounded(singles, 0, "%a").Last.IndexOf("@strict_list_single(%aw)") > 0
	let kind = MlirLayout(function).Represented(TypeEntry.ShortName(member.typeName))
	if (member.Bits is not Number.SingleBits) or (kind is not in ("Number", "List(Number)"))
		return List(Text) + function.Load(loaded, "%r" + register)
	let call = " = func.call " + (kind is "Number" then "@strict_single(" else "@strict_list_single(")
	(function.Load(loaded + "w", "%r" + register), "    " + loaded + call + loaded + "w) : (f64) -> f64")
Aliased(entry InstructionEntry, kind Text) Texts
	Sample.Aliased(Heights, "Sizing")(1) is "    %t2hv = func.call @strict_two_y(%t2hp) : (f64) -> f64"
	Listed.Aliased(Listing, "Pairing")(1) is "    %t2hv = func.call @strict_two_list(%t2hp) : (f64) -> f64"
	MlirCouples(MlirFlats.Sample.function, 2).Aliased(Listing, "Tripling")(1).IndexOf("@strict_flat_list(") > 0
	let isListed = MlirFlats(function, position).IsListed(kind) and (IsBlock is false)
	if (entry.texts(0) is "value") or ((IsCoupled(kind) is false) and (isListed is false))
		return function.Copied("%r" + entry.payload(1), "%r" + entry.payload(0), "%t" + position + "a")
	let halves = Halves(function.TypeOf(kind, true))
	let half = isListed then "list" else (halves.First.Name is entry.texts(0) then "x" else "y")
	let helper = MlirFlats(function, position).Count(kind) > 0 then "flat_list" else "two_" + half
	let temp = "%t" + position + "h"
	let read = "    " + temp + "v = func.call @strict_" + helper + "(" + temp + "p) : (f64) -> f64"
	(function.Load(temp + "p", "%r" + entry.payload(1)), read, function.Store(temp + "v", "%r" + entry.payload(0)))
Unpacked Texts
	Own.Unpacked.Length is 5
	Own.Unpacked.Last is "    llvm.store %tcouple1, %v_Height : f64, !llvm.ptr"
	Own.Unpacked(0) is "    %tcouple = llvm.load %instance : !llvm.ptr -> f64"
	Own.Unpacked(1) is "    %tcouple0 = func.call @strict_two_x(%tcouple) : (f64) -> f64"
	Own.Unpacked(3) is "    %tcouple1 = func.call @strict_two_y(%tcouple) : (f64) -> f64"
	mutable lines = List(Text) + function.Load("%tcouple", "%instance")
	for Halves(function.type)
		if value.Name is not in function.method.ParameterNames
			let half = index is 0 then "x" else "y"
			let read = "    %tcouple" + index + " = func.call @strict_two_" + half + "(%tcouple) : (f64) -> f64"
			lines = lines + read + function.Store("%tcouple" + index, "%v_" + value.Name)
	lines
IsFlatRead(entry InstructionEntry) Boolean
	MlirCouples(MlirFlats.Reader.function, 1).IsFlatRead(MlirFlats.Tripling.methods.Last.instructions(1))
	constant widths = InstructionEntry(InstructionType.FieldLoad, "Width", (3, 2, -1))
	Sample.Aliased(widths, "Sizing")(1) is "    %t2hv = func.call @strict_two_x(%t2hp) : (f64) -> f64"
	Sample.Aliased(Heights, "Sizing").First is "    %t2hp = llvm.load %r2 : !llvm.ptr -> f64"
	Sample.Aliased(Heights, "Sizing").Last is "    llvm.store %t2hv, %r3 : f64, !llvm.ptr"
	Sample.Aliased(Heights, "Number").First is "    %t2a = llvm.load %r2 : !llvm.ptr -> f64"
	Sample.Aliased(Heights, "Number").Last is "    llvm.store %t2a, %r3 : f64, !llvm.ptr"
	Celled.Aliased(Listing, "Tripling").Length is 2
	let isFlat = MlirFlats(function, position).Count(MlirKinds(function).VariableKind(position, entry.texts(0))) > 0
	isFlat or IsFlatAlias(entry.texts(0))
IsFlatAlias(name Text) Boolean
	Celled.IsFlatAlias("list0")
	Celled.IsFlatAlias("other") is false
	let steps = function.method.instructions
	mutable source = -1
	for steps
		let isNamed = value.texts.Length > 0 then value.texts(0) is name else false
		if isNamed and (value.kind is not in (Inliner.Store, InstructionType.IndexCall))
			return false
		let isStore = isNamed and (value.kind is Inliner.Store)
		source = isStore then (source is -1 then MlirKinds(function).Writer(index, value.payload(0)) else -2) else source
	IsFlatField(source)
IsFlatField(at Number) Boolean
	Celled.IsFlatField(1)
	Celled.IsFlatField(0) is false
	Sample.IsFlatField(3) is false
	Celled.IsFlatAlias("missing") is false
	Turns.Rounded(Turning.members.First, 0, "%a").First is "    %aw = llvm.load %r0 : !llvm.ptr -> f64"
	MlirFlats(Celled.function, 4).Indexed(Cells(4), MlirLists(Celled.function, 4))(2).IndexOf("flat_at(") > 0
	let field = at >= 0 then function.method.instructions(at) else InstructionEntry.Return(0)
	let isField = field.kind is InstructionType.FieldLoad
	isField then MlirFlats(function, at).Count(MlirKinds(function).KindOf(at, field.payload(1))) > 0 else false
IsBlock Boolean
	Celled.IsBlock
	MlirCouples(Celled.function, 0).IsBlock is false
	let steps = function.method.instructions
	if position + 1 >= steps.Length
		return false
	let next = steps(position + 1)
	let isStored = (next.kind is Inliner.Store) and (next.payload(0) is steps(position).payload(0))
	isStored then IsFlatAlias(next.texts(0)) else false
