has function MlirFunction
constant Labeled = TypeCodegen("Strict/Labeled", ("has label Text = \"Names\"", "has names Texts = (\"a\", \"b\")"), ValueCodegen.NoTypes, List(Text)).Entry
constant Labeling = MlirDefaults(MlirFunction(List(TypeEntry) + Labeled, Labeled, MethodEntry("Run", List(MemberEntry), "None", List(InstructionEntry))))
constant Label = Labeled.members.First
constant Instances = MlirInstances(Labeling.function, 0)
constant Greeting = TypeCodegen("Strict/Greeting", ("Greeted(name = \"Hi\") Text", "\tname"), ValueCodegen.NoTypes, List(Text)).Entry
constant Greets = MlirDefaults(MlirFunction(List(TypeEntry) + Greeting, Greeting, MethodEntry("Run", List(MemberEntry), "None", List(InstructionEntry))))
constant JoinTexts = MemberEntry("texts", "Strict/List(Text)", Labeled.members.Last.initial, false)
constant Joining = TypeEntry("Strict/Joining", List(MemberEntry), List(MethodEntry) + MethodEntry("Join", List(MemberEntry) + JoinTexts, "Strict/Text", List(InstructionEntry)))
constant Joins = MlirDefaults(MlirFunction(List(TypeEntry) + Joining, Joining, MethodEntry("Run", List(MemberEntry), "None", List(InstructionEntry))))
constant Pair = VmValue.OfList(VmValue.OfText("a"), VmValue.OfText("b"))
constant LargestWhole = 1000000
constant Mixed = TypeCodegen("Strict/Mixed", ("has empty Text = \"\"", "has count = 3", "Run(name = \"Hi\", other = \"\", again = \"Hi\", count = 3) Text", "\tname"), ValueCodegen.NoTypes, List(Text)).Entry
constant Mixing = MlirDefaults(MlirFunction(List(TypeEntry) + Mixed, Mixed, MethodEntry("Run", List(MemberEntry), "None", List(InstructionEntry))))
constant LabelGlobal = "  llvm.mlir.global internal constant @dLabeled_label(\"\\05\\00\\00\\00\\00\\00\\00\\00\\05\\00\\00\\00\\00\\00\\00\\00Names\\00\") : !llvm.array<22 x i8>"
constant HiGlobal = "  llvm.mlir.global internal constant @dp0(\"\\02\\00\\00\\00\\00\\00\\00\\00\\02\\00\\00\\00\\00\\00\\00\\00Hi\\00\") : !llvm.array<19 x i8>"
Name(owner TypeEntry, member MemberEntry) Text
	Labeling.Name(Labeled, Label) is "@dLabeled_label"
	Text.Combine(Instances.Default(Labeled, Label, "%s", "d")).IndexOf(" @dLabeled_label ") > 0
	"@d" + MlirEquality(function, 0).Symbol(owner.JustName) + "_" + member.Name
Globals Texts
	Labeling.Globals.First is LabelGlobal
	Labeling.Globals.Last.StartsWith("  llvm.mlir.global internal constant @dLabeled_names_1(\"\\01")
	Labeling.Globals.Length is 3
	Greets.Globals is List(Text) + HiGlobal
	mutable lines = List(Mutable(Text))
	for function.types
		type = value
		for MlirInstances(function, 0).Store(type)
			lines = lines + Declare(type, value)
	lines + ParameterGlobals + ElementGlobals
Declare(owner TypeEntry, member MemberEntry) Texts
	Labeling.Declare(Labeled, Label) is (LabelGlobal)
	Mixing.Declare(Mixed, Mixed.members.First).Length is 0
	Mixing.Declare(Mixed, Mixed.members.Last).Length is 0
	literal = Natives(function.types).Initial(member)
	constants = MlirConstants(function, 0, Name(owner, member))
	if literal.kind is "Text"
		return literal.text is "" then List(Text) else List(Text) + constants.TextGlobal(literal.text, "")
	for constants.TextElements(literal)
		constants.TextGlobal(literal.items(value).text, "_" + value)
ParameterName(text Text) Text
	Greets.ParameterName("Hi") is "@dp0"
	Greets.ParameterName("") is ""
	text is "" then "" else "@dp" + ParameterTexts.Index(text)
ParameterGlobals Texts
	Greets.ParameterGlobals.Length is 1
	for ParameterTexts
		MlirConstants(function, 0, "@dp" + index).TextGlobal(value, "")
NameParameter(initial Runtime/VmValue) Text
	Greets.NameParameter(VmValue.OfText("Hi")) is "@dp0"
	Greets.NameParameter(VmValue.OfNumber(1)) is ""
	Joins.NameParameter(Pair) is "@dl0"
	if initial.kind is "Text"
		return ParameterName(initial.text)
	at = initial.kind is "List" then ParameterLists.Index(initial) else -1
	at < 0 then "" else "@dl" + at
ElementGlobals Texts
	Joins.ElementGlobals.Last.StartsWith("  llvm.mlir.global internal constant @dl0_1(")
	Joins.ElementGlobals.Length is 2 and Greets.ElementGlobals.Length is 0
	mutable lines = List(Mutable(Text))
	for ParameterLists
		list = value
		constants = MlirConstants(function, 0, "@dl" + index)
		for constants.TextElements(list)
			lines.Add(constants.TextGlobal(list.items(value).text, "_" + value))
	lines
ParameterLists List(Runtime/VmValue)
	Joins.ParameterLists is (Pair)
	Greets.ParameterLists.Length is 0
	mutable lists = List(Mutable(VmValue))
	for type, method, parameter in function.types, type.methods, method.parameters
		initial = Natives(function.types).Initial(parameter)
		if initial.kind is "List" and initial is not in lists and MlirConstants(function, 0).TextElements(initial).Length > 0
			lists.Add(initial)
	lists
ParameterTexts Texts
	Greets.ParameterTexts is ("Hi")
	mutable texts = List(Mutable(Text))
	for type, method in function.types, type.methods
		texts = Add(texts, method.parameters)
	texts
Add(texts Texts, parameters List(MemberEntry)) Texts
	Greets.Add(List(Text), Greeting.methods.First.parameters) is ("Hi")
	Mixing.Add(List(Text), Mixed.methods.First.parameters) is ("Hi")
	mutable added = texts
	for parameters
		initial = Natives(function.types).Initial(value)
		if initial.text is not "" and initial.text is not in added
			added = added + initial.text
	added
IsWhole(parameter MemberEntry) Boolean
	MlirDefaults(MlirDeviceCalls.Twice.function).IsWhole(MlirDeviceCalls.Decimals)
	MlirDefaults(MlirDeviceCalls.Twice.function).IsWhole(MlirDeviceCalls.Spaced) is false
	MlirDefaults(MlirDeviceCalls.Twice.function).IsWhole(MlirDeviceCalls.Half) is false
	MlirDefaults(MlirDeviceCalls.Twice.function).IsWhole(MlirDeviceCalls.Tiny) is false
	MlirDefaults(MlirDeviceCalls.Twice.function).IsWhole(MlirDeviceCalls.Large) is false
	MlirDefaults(MlirDeviceCalls.Twice.function).IsWhole(MlirDeviceCalls.Twice.callee.method.parameters.First) is false
	Greets.IsWhole(Greeting.methods.First.parameters.First) is false
	initial = Natives(function.types).Initial(parameter)
	isFraction = (initial.number - initial.number.Floor) > 0
	isNumber = parameter.initial.Length > 0 and initial.kind is "Number"
	isNumber and isFraction is false and initial.number.Absolute < LargestWhole
Whole(parameter MemberEntry) Number
	MlirDefaults(MlirDeviceCalls.Twice.function).Whole(MlirDeviceCalls.Decimals) is 3
	Natives(function.types).Initial(parameter).number
