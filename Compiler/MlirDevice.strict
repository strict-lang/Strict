has function MlirFunction
has position Number
constant Doubling = MlirDevice(MlirParallel.Doubling.function, 2)
constant Twice = MlirDevice(MlirFunction(Doubling.function.types, MlirParallel.Rows, MlirParallel.Twice), 0)
constant Layering = MlirDevice(MlirGpu.Layering.function, 2)
constant Summing = MlirDevice(MlirFunction(MlirGpu.Layering.function.types, GpuSamples.Layered, GpuSamples.Summed), 0)
constant Fixed = "%count: i64, %result: !llvm.ptr, %failed: !llvm.ptr, %source: !llvm.ptr, %columns: i64, %bits: i64"
constant DoublingHeader = "  llvm.func @Rows_Doubled_1_gpu2(" + Fixed + ") attributes {nvvm.kernel} {"
constant Ending = ("    cf.br ^exit", "  ^exit:", "    llvm.return", "  }")
constant Allocated = " = llvm.alloca %one x "
constant Launches = ("    %lanesWanted = arith.constant 32 : i64", "    %lanesSingle = arith.constant 1 : i64", "    %launchBlocks = nvvm.read.ptx.sreg.nctaid.x : i32", "    %launchBlocksWide = arith.extui %launchBlocks : i32 to i64", "    %launchWidth = arith.extui %width : i32 to i64", "    %launchThreads = arith.muli %launchBlocksWide, %launchWidth : i64", "    %warpThreads = arith.muli %count, %lanesWanted : i64", "    %laneWarped = arith.cmpi uge, %launchThreads, %warpThreads : i64", "    %lanes = arith.select %laneWarped, %lanesWanted, %lanesSingle : i64")
Name Text
	Doubling.Name is "Rows_Doubled_1_gpu2"
	MlirDevice(MlirFunction(Doubling.function, Float = "f32"), 2).Name is "Rows_Doubled_1_gpu2s"
	function.Symbol + "_gpu" + position + MlirTyped(function.Float).Suffix
Kernel Texts
	Doubling.Kernel.First is DoublingHeader
	Text.Combine(MlirDevice(MlirGroups.Norming.function, 2).Kernel).IndexOf("arith.minsi %group") > 0
	Text.Combine(Doubling.Kernel).IndexOf("func.call @Rows_Twice_1_device(") > 0
	Layering.Kernel.First.IndexOf("%f_biasesb: i64) attributes") > 0
	Text.Combine(MlirDevice(MlirFunction(Doubling.function, Float = "f32"), 2).Kernel).IndexOf("i32 to f32") > 0
	let call = MlirGroups(function, position).Call
	if (function.Group < 0) and (call >= 0)
		return MlirDevice(MlirFunction(function, Group = call), position).Kernel
	let header = "  llvm.func @" + Name + "(" + Fixed + Freed + ") attributes {nvvm.kernel} {"
	let body = Emitted(position + 1, function.method.LoopEndOf(position))
	(List(Text) + header) + Slots + Given + Indexed + Started + body + Ending
Freed Text
	Doubling.Freed is ""
	Layering.Freed.StartsWith(", %f_inputd: !llvm.ptr, %f_inputn: i64")
	mutable text = ""
	for MlirGpuCheck(function, position).Free
		let parts = ", %f_" + value + "d: !llvm.ptr, %f_" + value + "n: i64, %f_" + value + "b: i64"
		text = text + (IsList(value) then parts else ", %f_" + value + ": f64")
	text
IsList(name Text) Boolean
	Layering.IsList("input")
	Doubling.IsList("value") is false
	MlirDevice(MlirDeviceRows.Picking, 2).IsList("weights")
	let kind = MlirKinds(function).VariableKind(position, name)
	MlirDeviceStatements(function, position).IsList(kind) or MlirDeviceRows(function, position).IsRows(kind)
Given Texts
	Layering.Given.First is "    llvm.store %f_inputd, %v_inputd : !llvm.ptr, !llvm.ptr"
	mutable lines = List(Mutable(Text))
	for MlirGpuCheck(function, position).Free
		let given = "%f_" + value
		let slot = "%v_" + value
		lines = IsList(value) then lines + Stores(given, slot) else lines + MlirTyped(function.Float).Given(given, slot)
	lines
Stores(source Text, target Text) Texts
	Doubling.Stores("%a", "%b").First is "    llvm.store %ad, %bd : !llvm.ptr, !llvm.ptr"
	for MlirTyped.Parts
		MlirTyped(MlirTyped.Types(index)).Store(source + value, target + value)
Function Texts
	Twice.Function.First.EndsWith("%lane: i64, %lanes: i64, %p0: f64, %p1: f64) -> f64 {")
	Twice.Function.Last is "  }"
	let calls = MlirDeviceCalls(function, 0, function)
	mutable parameters = ("%failed: !llvm.ptr", "%lane: i64", "%lanes: i64", "%p0: " + function.Float)
	for function.method.parameters
		let name = "%p" + (index + 1)
		let parts = (name + "d: !llvm.ptr", name + "n: i64", name + "b: i64")
		parameters = calls.IsList(index) then parameters + parts else parameters + (name + ": " + function.Float)
	let symbol = function.Symbol + "_device" + MlirTyped(function.Float).Suffix
	let header = "  func.func private @" + symbol + "(" + Text.Combine(parameters, ", ") + ") -> " + function.Float + " {"
	(List(Text) + header) + Slots + Entry + Emitted(0, function.method.instructions.Length) + "  }"
Slots Texts
	Doubling.Slots.Last is "    %loop2 = llvm.alloca %one x i64 : (i64) -> !llvm.ptr"
	mutable lines = ("    %one = arith.constant 1 : i64", "    %flag = llvm.alloca %one x i1 : (i64) -> !llvm.ptr")
	for LoadReuse(function.method.instructions).RegisterCount
		lines = lines + Slot("%r" + index)
	for function.VariableNames
		lines = lines + Slot("%v_" + value)
	for function.method.instructions
		if value.kind is InstructionType.LoopBegin
			lines = lines + ("    %loop" + index + Allocated + "i64 : (i64) -> !llvm.ptr")
	lines
Slot(name Text) Texts
	Doubling.Slot("%r0").Last is "    %r0b = llvm.alloca %one x i64 : (i64) -> !llvm.ptr"
	mutable lines = List(Text) + ("    " + name + Allocated + function.Float + " : (i64) -> !llvm.ptr")
	for MlirTyped.Parts
		lines = lines + ("    " + name + value + Allocated + MlirTyped.Types(index) + " : (i64) -> !llvm.ptr")
	lines
Entry Texts
	Twice.Entry is ("    llvm.store %p0, %v_value : f64, !llvm.ptr", "    llvm.store %p1, %v_number : f64, !llvm.ptr")
	Summing.Entry.Last is "    llvm.store %p2b, %v_inputb : i64, !llvm.ptr"
	let calls = MlirDeviceCalls(function, 0, function)
	mutable lines = List(Text) + function.Store("%p0", "%v_value")
	for function.method.parameters
		let number = "%p" + (index + 1)
		let slot = "%v_" + value.Name
		lines = calls.IsList(index) then lines + Stores(number, slot) else lines + function.Store(number, slot)
	lines
Indexed Texts
	Doubling.Indexed.Last is "    cf.cond_br %inside, ^body, ^exit"
	constant thread = "    %thread = nvvm.read.ptx.sreg.tid.x : i32"
	constant block = "    %block = nvvm.read.ptx.sreg.ctaid.x : i32"
	constant width = "    %width = nvvm.read.ptx.sreg.ntid.x : i32"
	constant start = "    %start = arith.muli %block, %width : i32"
	constant sum = "    %sum = arith.addi %start, %thread : i32"
	constant global = "    %global = arith.extui %sum : i32 to i64"
	(thread, block, width, start, sum, global) + MlirGrouped(function, position).Indexed
Laned Texts
	Layering.Laned.First is "    %lanes = arith.constant 32 : i64"
	Doubling.Laned.First is "    %lanes = arith.constant 1 : i64"
	Text.Combine(MlirDevice(MlirDeviceSums.Spreading.function, 2).Laned).IndexOf("nvvm.read.ptx.sreg.nctaid.x") > 0
	constant divided = ("    %at = arith.divui %global, %lanes : i64", "    %lane = arith.remui %global, %lanes : i64")
	let sums = MlirDeviceSums(function, position)
	if sums.IsSpread
		return Launches + divided
	List(Text) + MlirTyped.Integer.Constant("%lanes", sums.IsWarped then "32" else "1") + divided
Started Texts
	Doubling.Started.Last is "    llvm.store %element, %v_value : f64, !llvm.ptr"
	Layering.Started.Last is "    llvm.store %rowed#1, %v_valueb : i64, !llvm.ptr"
	constant narrow = "    %narrow = arith.trunci %at : i64 to i32"
	let converted = ("  ^body:", narrow) + MlirDeviceLoops(function, position).Counted
	let index = converted + function.Store("%index", "%v_index")
	let collection = MlirLoops(function, position).Collection
	if collection is ""
		return index + function.Store("%index", "%v_value")
	if collection is not "List(Number)"
		return index + Rowed
	let read = MlirTyped(function.Float).Read("%element", "(%source, %bits, %at, %count)")
	index + (read, function.Store("%element", "%v_value"))
Rowed Texts
	Layering.Rowed.First is "    %rowed:3 = func.call @strict_device_row(%source, %at)" + MlirDeviceRows.Types
	constant row = "    %rowed:3 = func.call @strict_device_row(%source, %at)" + MlirDeviceRows.Types
	let view = (MlirTyped.Pointer.Store("%rowed#0", "%v_valued"), MlirTyped.Integer.Store("%columns", "%v_valuen"))
	(List(Text) + row) + view + MlirTyped.Integer.Store("%rowed#1", "%v_valueb")
Emitted(first Number, limit Number) Texts
	Doubling.Emitted(3, 4).Last is "    llvm.store %d3, %r1 : f64, !llvm.ptr"
	MlirDevice(MlirDeviceDot.Summed, 0).Emitted(3, 12).Length is 0
	mutable lines = List(Mutable(Text))
	for Range(first, limit)
		if MlirDeviceDot(function, value).IsCovered is false
			lines = lines + MlirDeviceStatements(function, value).Labeled + MlirDeviceStatements(function, value).Emitted
	lines