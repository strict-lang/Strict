has function MlirFunction
has position Number
constant Doubling = MlirDevice(MlirParallel.Doubling.function, 2)
constant Twice = MlirDevice(MlirFunction(Doubling.function.types, MlirParallel.Rows, MlirParallel.Twice), 0)
constant Layering = MlirDevice(MlirGpu.Layering.function, 2)
constant Summing = MlirDevice(MlirFunction(MlirGpu.Layering.function.types, GpuSamples.Layered, GpuSamples.Summed), 0)
constant Exact = MlirDevice(MlirGuards.Shifted, 2)
constant Gated = MlirDevice(MlirFunction(Doubling.function.types, MlirParallel.Rows, MethodEntry("Run", List(MemberEntry), "None", (InstructionEntry.Named(InstructionType.StoreRegisterToVariable, 0, "gate"), InstructionEntry.Named(InstructionType.StoreRegisterToVariable, 0, "gated")))), 0)
constant Fixed = "%count: i64, %result: !llvm.ptr, %failed: !llvm.ptr, %source: !llvm.ptr, %columns: i64, %bits: i64"
constant DoublingHeader = "  llvm.func @Rows_Doubled_1_gpu2(" + Fixed + ", %results: i64) attributes {nvvm.kernel} {"
constant Ending = ("    cf.br ^exit", "  ^exit:", "    llvm.return", "  }")
constant Launches = ("    %lanesWanted = arith.constant 32 : i64", "    %lanesSingle = arith.constant 1 : i64", "    %launchBlocks = func.call @strict_device_block_count() : () -> i32", "    %launchBlocksWide = arith.extui %launchBlocks : i32 to i64", "    %launchWidth = arith.extui %width : i32 to i64", "    %launchThreads = arith.muli %launchBlocksWide, %launchWidth : i64", "    %warpThreads = arith.muli %count, %lanesWanted : i64", "    %laneWarped = arith.cmpi uge, %launchThreads, %warpThreads : i64", "    %lanes = arith.select %laneWarped, %lanesWanted, %lanesSingle : i64")
Name Text
	Doubling.Name is "Rows_Doubled_1_gpu2"
	MlirDevice(MlirFunction(Doubling.function, Float = "f32"), 2).Name is "Rows_Doubled_1_gpu2s"
	Exact.Name.EndsWith("_gpu2sx")
	let suffix = MlirTyped(function.Float).Suffix + (function.Guarded is position then "x" else "")
	function.Symbol + "_gpu" + position + suffix
Kernel Texts
	Doubling.Kernel.First is DoublingHeader
	Text.Combine(MlirDevice(MlirGroups.Norming.function, 2).Kernel).IndexOf("arith.minsi %group") > 0
	Text.Combine(Doubling.Kernel).IndexOf("func.call @Rows_Twice_1_device(") > 0
	Layering.Kernel.First.IndexOf("%f_biases_b: i64, %results: i64) attributes") > 0
	Text.Combine(MlirDevice(MlirFunction(Doubling.function, Float = "f32"), 2).Kernel).IndexOf("i32 to f32") > 0
	Text.Combine(Exact.Kernel).IndexOf("^generic") is -1
	let call = MlirGroups(function, position).Call
	if (function.Group < 0) and (call >= 0)
		return MlirDevice(MlirFunction(function, Group = call), position).Kernel
	let header = "  llvm.func @" + Name + "(" + Fixed + Freed + MlirPassed(function, position).Header
	let body = Emitted(position + 1, function.method.LoopEndOf(position))
	(List(Text) + header) + Slots + Given + Indexed + Started + body + Ending
Freed Text
	Doubling.Freed is ""
	Layering.Freed.StartsWith(", %f_input_d: !llvm.ptr, %f_input_n: i64")
	mutable text = ""
	for MlirGpuCheck(function, position).Free
		let parts = ", %f_" + value + "_d: !llvm.ptr, %f_" + value + "_n: i64, %f_" + value + "_b: i64"
		text = text + (IsList(value) then parts else ", %f_" + value + ": f64")
	text
IsList(name Text) Boolean
	Layering.IsList("input")
	Doubling.IsList("value") is false
	MlirDevice(MlirDeviceRows.Picking, 2).IsList("weights")
	if MlirWholeKernel(function, position).IsKernel
		return MlirWholeKernel(function, position).IsList(name)
	let kind = MlirKinds(function).VariableKind(position, name)
	MlirDeviceStatements(function, position).IsList(kind) or MlirDeviceRows(function, position).IsRows(kind)
Given Texts
	Layering.Given.First is "    llvm.store %f_input_d, %v_input_d : !llvm.ptr, !llvm.ptr"
	mutable lines = List(Mutable(Text))
	for MlirGpuCheck(function, position).Free
		let given = "%f_" + value
		let slot = "%v_" + value
		let typed = MlirTyped(function.Float).Given(given, slot)
		let number = typed + MlirPassed(function, position).Given(value, slot)
		lines = IsList(value) then lines + Stores(given, slot) else lines + number
	lines + (function.Guarded is position then Assumed else List(Text))
Assumed Texts
	Exact.Assumed is ("    llvm.store %one, %v_offset_q : i64, !llvm.ptr")
	for MlirGuards(function, position).Parameters
		MlirTyped.Integer.Store("%one", "%v_" + value + "_q")
Stores(source Text, target Text) Texts
	Doubling.Stores("%a", "%b").First is "    llvm.store %a_d, %b_d : !llvm.ptr, !llvm.ptr"
	for MlirTyped.Parts
		MlirTyped(MlirTyped.Types(index)).Store(source + value, target + value)
Function Texts
	Twice.Function.First.EndsWith("%lane: i64, %lanes: i64, %p0: f64, %p1: f64) -> !llvm.struct<(f64)> {")
	Twice.Function.Last is "  }"
	let typed = MlirDeviceCalls(function, 0, function).Parameters + MlirDeviceMembers(function).Typed(function.Float)
	let symbol = function.Symbol + "_device" + MlirTyped(function.Float).Suffix
	let returned = MlirExact(function, 0).Returned
	let header = "  func.func private @" + symbol + "(" + Text.Combine(typed, ", ") + ") -> " + returned + " {"
	(List(Text) + header) + Slots + Entry + Emitted(0, function.method.instructions.Length) + "  }"
Slots Texts
	Doubling.Slots.Last is "    %loop2 = llvm.addrspacecast %loop2.private : !llvm.ptr<5> to !llvm.ptr"
	Gated.Slots.Index("    %v_gate_d = llvm.addrspacecast %v_gate_d.private : !llvm.ptr<5> to !llvm.ptr") > 0
	mutable lines = (List(Text) + "    %one = arith.constant 1 : i64") + MlirTyped("i1").Private("%flag")
	lines = function.Float is "f32" then lines + MlirTyped.Integer.Constant("%inexact", "0") else lines
	for LoadReuse(function.method.instructions).RegisterCount
		lines = lines + Slot("%r" + index)
	for function.VariableNames
		lines = lines + Slot("%v_" + value)
	for function.method.instructions
		if value.kind is InstructionType.LoopBegin
			lines = lines + MlirTyped.Integer.Private("%loop" + index)
	lines
Slot(name Text) Texts
	Doubling.Slot("%r0").Last is "    %r0_b = llvm.addrspacecast %r0_b.private : !llvm.ptr<5> to !llvm.ptr"
	mutable lines = MlirTyped(function.Float).Private(name)
	for MlirTyped.Parts
		lines = lines + MlirTyped(MlirTyped.Types(index)).Private(name + value)
	lines + MlirExact(function, 0).Slots(name)
Entry Texts
	Twice.Entry is ("    llvm.store %p0, %v_value : f64, !llvm.ptr", "    llvm.store %p1, %v_number : f64, !llvm.ptr")
	"    llvm.store %m0, %v_heads : f64, !llvm.ptr" is in MlirDevice(MlirDeviceMembers.Head, 0).Entry
	Summing.Entry.Last is "    llvm.store %p2_b, %v_input_b : i64, !llvm.ptr"
	let calls = MlirDeviceCalls(function, 0, function)
	let exact = MlirExact(function, 0)
	mutable lines = (List(Text) + function.Store("%p0", "%v_value")) + exact.Set("%p0_e", "%p0_q", "%v_value")
	for function.method.parameters
		let number = "%p" + (index + 1)
		let slot = "%v_" + value.Name
		let stored = (List(Text) + function.Store(number, slot)) + exact.Set(number + "_e", number + "_q", slot)
		lines = calls.IsList(index) then lines + Stores(number, slot) else lines + stored
	lines + MlirDeviceMembers(function).Stored(function.Float)
Indexed Texts
	Doubling.Indexed.Last is "    cf.cond_br %inside, ^body, ^exit"
	Doubling.Indexed.First is "    %thread = func.call @strict_device_thread_index() : () -> i32"
	constant thread = "    %thread = func.call @strict_device_thread_index() : () -> i32"
	constant block = "    %block = func.call @strict_device_block_index() : () -> i32"
	constant width = "    %width = func.call @strict_device_block_size() : () -> i32"
	constant start = "    %start = arith.muli %block, %width : i32"
	constant sum = "    %sum = arith.addi %start, %thread : i32"
	constant global = "    %global = arith.extui %sum : i32 to i64"
	(thread, block, width, start, sum, global) + MlirGrouped(function, position).Indexed
Laned Texts
	Layering.Laned.First is "    %lanes = arith.constant 32 : i64"
	Doubling.Laned.First is "    %lanes = arith.constant 1 : i64"
	Text.Combine(MlirDevice(MlirDeviceSums.Spreading.function, 2).Laned).IndexOf("@strict_device_block_count()") > 0
	constant divided = ("    %at = arith.divui %global, %lanes : i64", "    %lane = arith.remui %global, %lanes : i64")
	let sums = MlirDeviceSums(function, position)
	if sums.IsSpread
		return Launches + divided
	List(Text) + MlirTyped.Integer.Constant("%lanes", sums.IsWarped then "32" else "1") + divided
Started Texts
	Doubling.Started.Last is "    llvm.store %element, %v_value : f64, !llvm.ptr"
	Layering.Started.Last is "    llvm.store %rowed#1, %v_value_b : i64, !llvm.ptr"
	constant narrow = "    %narrow = arith.trunci %at : i64 to i32"
	let loops = MlirDeviceLoops(function, position)
	let index = (("  ^body:", narrow) + loops.Counted + loops.Indexes) + loops.Indexed("%v_index")
	let collection = MlirLoops(function, position).Collection
	if collection is ""
		return index + loops.Indexed("%v_value")
	if collection is not "List(Number)"
		return index + Rowed
	let read = MlirTyped(function.Float).Read("%element", "(%source, %bits, %at, %count)")
	index + (read, function.Store("%element", "%v_value"))
Rowed Texts
	Layering.Rowed.First is "    %rowed:3 = func.call @strict_device_row(%source, %at)" + MlirDeviceRows.Types
	constant row = "    %rowed:3 = func.call @strict_device_row(%source, %at)" + MlirDeviceRows.Types
	let view = (MlirTyped.Pointer.Store("%rowed#0", "%v_value_d"), MlirTyped.Integer.Store("%columns", "%v_value_n"))
	(List(Text) + row) + view + MlirTyped.Integer.Store("%rowed#1", "%v_value_b")
Emitted(first Number, limit Number) Texts
	Doubling.Emitted(3, 4).Last is "    llvm.store %d3, %r1 : f64, !llvm.ptr"
	MlirDevice(MlirDeviceDot.Summed, 0).Emitted(3, 12).Length is 0
	mutable lines = List(Mutable(Text))
	for Range(first, limit)
		if MlirDeviceDot(function, value).IsCovered is false
			lines = lines + MlirDeviceStatements(function, value).Labeled + MlirDeviceStatements(function, value).Emitted
	lines