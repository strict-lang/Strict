has function MlirFunction
has row Number
constant Picking = MlirWholeRows(MlirWholeKernel.Measure.Callee, 1)
constant Types = MlirWholeTypes(MlirWholeKernel.Measure.Callee)
constant Extras = ("%rx", "%ry", "%rw")
constant RelayArguments = (InstructionEntry.Named(InstructionType.LoadVariableToRegister, 0, "board"), InstructionEntry.Named(InstructionType.LoadVariableToRegister, 1, "pixel"))
constant RelayCall = (InstructionEntry.Invoke(2, ("Strict/Board", "Picked", "Strict/Rgb", "board", "pixel"), (0, 1), -1), InstructionEntry.Return(2))
constant Relays = RelayArguments + RelayCall
constant RelayedCall = "_whole_row1(%failed, %t2a0, %t2a1, %t2a2, %t2a3, %t2a4)"
constant Relay = MlirFunction(MlirWholeKernel.Measure.function.types, MlirWholeKernel.Measured, MethodEntry("Relay", MlirWholeKernel.Picked.parameters, "Strict/Rgb", Relays))
constant Relaying = MlirWholeRows(Relay, 1)
constant Relayed = MlirWholeStatements(Relay, 2, MlirWholeTypes(Relay).Part(0), MlirWholeTypes(Relay).Part(1), MlirWholeTypes(Relay).Part(2))
constant Wrapping = MlirWholeStatements(MlirWholeKernel.Measure.Callee, 7, Types.Part(0), Types.Part(1), Types.Part(2))
IsRowed Boolean
	Picking.IsRowed
	MlirWholeRows(MlirWholeKernel.Kernel.Callee, 1).IsRowed is false
	MlirWholeRows(MlirWholeKernel.Measure.Callee, 0).IsRowed is false
	if MlirWholeFunction(function).Kinds(row) is not "i"
		return false
	for function.method.instructions
		isDivided = value.kind is in (InstructionType.Modulo, InstructionType.Divide)
		if isDivided and IsIndex(value.payload(1), index) or Pass(value, index) >= 0
			return true
	false
IsIndex(register Number, at Number) Boolean
	Picking.IsIndex(5, 7)
	Picking.IsIndex(4, 7) is false
	writer = MlirKinds(function).Writer(at, register)
	loaded = writer < 0 then InstructionEntry.Return(0) else function.method.instructions(writer)
	loaded.kind is InstructionType.LoadVariableToRegister and loaded.texts(0) is function.method.parameters(row).Name
Pass(entry InstructionEntry, at Number) Number
	Picking.Pass(MlirWholeKernel.Measuring(7), 7) is -1
	if entry.kind is not InstructionType.Invoke
		return Number.NotFound
	callee = MlirWholeFunction(function).Callee(entry)
	isWhole = callee.Symbol is not function.Symbol and MlirWholeFunction(callee).IsWhole
	for LoadReuse(function.method.instructions).InvokeReads(entry)
		if isWhole and IsIndex(entry.payload(value), at) and MlirWholeRows(callee, index).IsRowed
			return index
	Number.NotFound
Emit(statements MlirWholeStatements) Texts
	Text.Combine(Picking.Emit(Wrapping)).IndexOf("cf.br ^t7rowed(%rx : i64)") > 0
	Picking.Emit(Wrapping.At(6)) is Wrapping.At(6).Emitted
	at = statements.position
	entry = function.method.instructions(at)
	isDivided = entry.kind is in (InstructionType.Modulo, InstructionType.Divide)
	if isDivided and IsIndex(entry.payload(1), at) and statements.naturals(at) is "i"
		return Divide(statements, entry)
	passed = Pass(entry, at)
	if passed >= 0 and MlirWholeNative(statements).Emit(entry).Length is 0
		return Call(statements, entry, passed)
	statements.Emitted
Divide(statements MlirWholeStatements, entry InstructionEntry) Texts
	Picking.Divide(Wrapping, MlirWholeKernel.Measuring(7))(11) is "    cf.cond_br %t7q, ^t7row, ^t7divide"
	Picking.Divide(Wrapping, MlirWholeKernel.Measuring(7))(13) is "    %t7d = arith.remsi %t7a, %t7s : i64"
	loads = statements.Load("a", entry.payload(1), "i") + statements.Load("b", entry.payload(2), "i")
	branches = Branches(statements, entry.kind is InstructionType.Modulo, statements.Divisor(entry))
	loads + statements.Guard(entry) + branches + statements.Store("c", "i", entry.payload(3))
Branches(statements MlirWholeStatements, isModulo Boolean, divisor Text) Texts
	Picking.Branches(Wrapping, false, "%t7b")(6) is "    cf.br ^t7rowed(%ry : i64)"
	label = "^t" + statements.position
	quotient = statements.Temp("d")
	operation = (isModulo then "arith.remsi " else "arith.floordivsi ") + statements.Temp("a") + ", "
	divided = "    " + quotient + " = " + operation + divisor + " : i64"
	compared = "    " + statements.Temp("q") + " = arith.cmpi eq, " + statements.Temp("b") + ", %rw : i64"
	branch = "    cf.cond_br " + statements.Temp("q") + ", " + label + "row, " + label + "divide"
	joined = "    cf.br " + label + "rowed("
	rowed = ("  " + label + "row:", joined + (isModulo then "%rx" else "%ry") + " : i64)")
	division = ("  " + label + "divide:", divided, joined + quotient + " : i64)") + rowed
	(compared, branch) + division + ("  " + label + "rowed(" + statements.Temp("c") + ": i64):")
Call(statements MlirWholeStatements, entry InstructionEntry, passed Number) Texts
	Text.Combine(Relaying.Call(Relayed, Relays(2), 1)).IndexOf(RelayedCall) > 0
	callee = MlirWholeFunction(function).Callee(entry)
	kinds = MlirWholeFunction(callee).Kinds
	values = MlirWholeValues(statements.position)
	mutable lines = statements.Arguments(entry, kinds)
	for Extras
		lines = lines + values.Line("a" + (kinds.Length + index), "arith.ori " + value + ", " + value + " : i64")
	returned = MlirWholeTypes(callee).Returned
	symbol = MlirWholeRows(callee, passed).Symbol
	call = values.Call(statements.Temp("c"), symbol, statements.Temp("a"), kinds + ("i", "i", "i"), returned)
	lines + call + statements.Store("c", returned, entry.payload(0))
Symbol Text
	Picking.Symbol.EndsWith("_whole_row1")
	MlirWholeFunction(function).Symbol + "_row" + row
