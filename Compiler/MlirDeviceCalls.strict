has function MlirFunction
has at Number
has callee MlirFunction
constant Twice = MlirDeviceCalls(MlirParallel.Doubling.function, 4, MlirDevice.Twice.function)
constant Twicing = Twice.function.method.instructions(4)
constant Flooring = MlirDeviceCalls(MlirGpuCheck.Floored, 1, MlirGpuCheck.Floored)
constant Making = InstructionEntry.Invoke(1, ("Strict/Degrees", "from", "Strict/Degrees", "number"), List(Number) + 0, -1)
constant Heads = MlirDeviceCalls(MlirGpuCheck.Heading.function, 4, MlirDeviceMembers.Head)
constant Natives = ("Floor", "Logarithm", "from")
constant Summing = MlirDeviceCalls(MlirGpu.Layering.function, 5, MlirDeviceStatements.Summed)
Temp(suffix Text) Text
	Twice.Temp("i") is "%d4i"
	"%d" + at + suffix
Parameters Texts
	Twice.Parameters.Last is "%p1: f64"
	let exact = MlirExact(function, at)
	mutable parameters = ("%failed: !llvm.ptr", "%lane: i64", "%lanes: i64") + exact.Parameters("%p0")
	for callee.method.parameters
		let name = "%p" + (index + 1)
		let parts = (name + "d: !llvm.ptr", name + "n: i64", name + "b: i64")
		parameters = IsList(index) then parameters + parts else parameters + exact.Parameters(name)
	parameters
IsList(parameter Number) Boolean
	Summing.IsList(0)
	Twice.IsList(0) is false
	TypeEntry.ShortName(callee.method.parameters(parameter).typeName) is in ("List(Number)", "Numbers")
Arguments(entry InstructionEntry) Texts
	Twice.Arguments(Twicing) is ("%failed", "%lane", "%lanes", "%d4i", "%d4p0")
	Heads.Arguments(GpuSamples.Heading.instructions(4)).Last is "%d4m1b"
	let exact = MlirExact(function, at)
	mutable names = ("%failed", "%lane", "%lanes") + exact.Names(Temp("i"))
	for entry.payload(5 + entry.payload(3))
		let parts = (Temp("p" + index + "d"), Temp("p" + index + "n"), Temp("p" + index + "b"))
		names = IsList(index) then names + parts else names + exact.Names(Temp("p" + index))
	names + MemberArguments
MemberArguments Texts
	Heads.MemberArguments is ("%d4m0", "%d4m1d", "%d4m1n", "%d4m1b")
	MlirDeviceMembers(callee).Arguments(Temp("m"), false)
Types Text
	Twice.Types is "!llvm.ptr, i64, i64, f64, f64"
	Summing.Types is "!llvm.ptr, i64, i64, f64, !llvm.ptr, i64, i64, !llvm.ptr, i64, i64"
	let numbers = MlirExact(function, at).Types
	mutable types = ("!llvm.ptr", "i64", "i64") + numbers
	for callee.method.parameters
		types = IsList(index) then types + MlirTyped.Types else types + numbers
	Text.Combine(types + MlirDeviceMembers(callee).Types(function.Float), ", ")
Loaded(entry InstructionEntry) Texts
	Twice.Loaded(Twicing).Last is "    %d4p0 = llvm.load %r1 : !llvm.ptr -> f64"
	let countPosition = 5 + entry.payload(3)
	mutable lines = Instance(entry, Temp("i"))
	for entry.payload(countPosition)
		lines = lines + Argument(index, "%r" + entry.payload(countPosition + 1 + index))
	lines + MemberLoads
MemberLoads Texts
	Heads.MemberLoads.First is "    %d4m0 = llvm.load %v_heads : !llvm.ptr -> f64"
	MlirDeviceMembers(callee).Loads(Temp("m"), function.Float)
Instance(entry InstructionEntry, name Text) Texts
	Twice.Instance(Twicing, "%h") is ("    %h = arith.constant 0.0 : f64")
	let register = Register(entry)
	let exact = MlirExact(function, at)
	if register < 0
		return (List(Text) + MlirTyped(function.Float).Constant(name, "0.0")) + exact.Whole(name, "0")
	(List(Text) + function.Load(name, "%r" + register)) + exact.Loaded(name, "%r" + register)
Register(entry InstructionEntry) Number
	Twice.Register(Twicing) is -1
	Flooring.Register(MlirGpuCheck.Flooring) is 0
	let countPosition = 5 + entry.payload(3)
	let flagPosition = countPosition + 1 + entry.payload(countPosition)
	entry.payload(flagPosition) is 1 then entry.payload(flagPosition + 1) else -1
IsNative(entry InstructionEntry) Boolean
	Flooring.IsNative(MlirGpuCheck.Flooring)
	Twice.IsNative(Twicing) is false
	let loop = function.method.LoopBeginOf(at)
	(entry.texts(1) is in Natives) or ((loop >= 0) then MlirTokens(function, loop).Call is at else false)
Native(entry InstructionEntry) Texts
	Flooring.Native(MlirGpuCheck.Flooring)(1).IndexOf("llvm.intr.floor") > 0
	Flooring.Native(Making).Last is "    llvm.store %d1, %r1 : f64, !llvm.ptr"
	if entry.texts(1) is not in Natives
		return MlirTokenLaunch(function, function.method.LoopBeginOf(at)).Read(at)
	if entry.texts(1) is "Logarithm"
		return Logarithmic(entry)
	let target = "%r" + entry.payload(0)
	if entry.texts(1) is "from"
		let source = "%r" + entry.payload(6 + entry.payload(3))
		return function.Copied(source, target, Temp("")) + MlirExact(function, at).Copied(source, target)
	let exact = MlirRational(MlirExact(function, at)).Floored("%r" + Register(entry), target)
	(Loaded(entry) + MlirTyped(function.Float).Floored(Temp(""), Temp("i")) + function.Store(Temp(""), target)) + exact
Logarithmic(entry InstructionEntry) Texts
	Text.Combine(Flooring.Logarithmic(MlirGpuCheck.Flooring)).IndexOf("@strict_device_logarithm(%failed, %d1i)") > 0
	let typed = MlirTyped(function.Float)
	let call = " = func.call @strict_device_logarithm" + typed.Suffix + "(%failed, " + Temp("i") + ")"
	let logarithm = "    " + Temp("") + call + " : (!llvm.ptr, " + typed.type + ") -> " + typed.type
	Loaded(entry) + logarithm + function.Store(Temp(""), "%r" + entry.payload(0))
Argument(parameter Number, register Text) Texts
	Twice.Argument(0, "%r1") is ("    %d4p0 = llvm.load %r1 : !llvm.ptr -> f64")
	Summing.Argument(0, "%r1").Last is "    %d5p0b = llvm.load %r1b : !llvm.ptr -> i64"
	if IsList(parameter) is false
		let exact = MlirExact(function, at).Loaded(Temp("p" + parameter), register)
		return (List(Text) + function.Load(Temp("p" + parameter), register)) + exact
	for MlirTyped.Parts
		MlirTyped(MlirTyped.Types(index)).Load(Temp("p" + parameter + value), register + value)