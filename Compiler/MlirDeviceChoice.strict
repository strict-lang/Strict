has function MlirFunction
has at Number
constant Choosing = MlirFunction(List(TypeEntry) + GpuChoiceSamples.Chosen, GpuChoiceSamples.Chosen, GpuChoiceSamples.Largest)
constant Maximum = MlirDeviceChoice(Choosing, 4)
constant Owned = MlirDeviceChoice(MlirFunction((GpuChoiceSamples.Maximizing, GpuChoiceSamples.Numbered), GpuChoiceSamples.Maximizing, GpuChoiceSamples.Maximized), 4)
constant Maximal = MlirFunction(Owned.function.types, GpuChoiceSamples.Numbered, GpuChoiceSamples.Maximum)
constant Unchosen = MlirFunction(Choosing.types, GpuChoiceSamples.Chosen, GpuChoiceSamples.Largest)
constant Chooser = MlirFunction(Choosing.types, GpuChoiceSamples.Chosen, GpuChoiceSamples.Larger)
constant Summing = MlirDeviceChoice(MlirDeviceStatements.Summed, 2)
constant AllowedMoves = (InstructionType.LoadConstantToRegister, InstructionType.LoadVariableToRegister, InstructionType.StoreRegisterToVariable)
constant AllowedJumps = (InstructionType.Return, InstructionType.JumpEnd, InstructionType.JumpToIdIfFalse, InstructionType.JumpToIdIfTrue)
constant Allowed = AllowedMoves + (InstructionType.Equal, InstructionType.LessThan, InstructionType.GreaterThan) + AllowedJumps
constant Offsets = (16, 8, 4, 2, 1)
constant Moves = (InstructionType.LoadVariableToRegister, InstructionType.StoreRegisterToVariable)
constant Rounded = Maximum.Round(MlirDeviceCalls(Choosing, 10, Chooser), "%d12", 0, 4)
IsChoice Boolean
	Maximum.IsChoice and Owned.IsChoice
	Summing.IsChoice is false
	names = Chosen
	mutable loads = 0
	for Range(at + 1, function.method.LoopEndOf(at))
		entry = function.method.instructions(value)
		if entry.kind is InstructionType.LoopBegin or entry.kind is InstructionType.InvokeWriteToList
			return false
		if entry.kind is InstructionType.LoadVariableToRegister and entry.texts(0) is in names
			loads = loads + 1
	names.Length > 0 and loads is names.Length
Chosen Texts
	Maximum.Chosen is ("largest")
	Summing.Chosen.Length is 0
	mutable names = List(Mutable(Text))
	for Range(at + 1, function.method.LoopEndOf(at))
		entry = function.method.instructions(value)
		if entry.kind is InstructionType.StoreRegisterToVariable
			if IsUpdate(value) is false
				return List(Text)
			names.Add(entry.texts(0))
	names
IsUpdate(store Number) Boolean
	Maximum.IsUpdate(11)
	Summing.IsUpdate(10) is false
	call = function.method.instructions(store - 1)
	if call.kind is not InstructionType.Invoke or call.payload(0) is not function.method.instructions(store).payload(0)
		return false
	callees = MlirModule(function.types, "").Call(function, store - 1)
	isPassed = IsPassed(store - 1, function.method.instructions(store).texts(0))
	callees.Length is 1 and isPassed and IsChoosing(callees.First)
IsPassed(call Number, name Text) Boolean
	Maximum.IsPassed(10, "largest")
	Maximum.IsPassed(10, "index") is false
	entry = function.method.instructions(call)
	instance = PayloadDecoder(entry).Instance
	for instance >= 0 then PayloadDecoder(entry).Arguments + instance else PayloadDecoder(entry).Arguments
		writer = MlirDeviceSums(function, at).Writer(call, value)
		loaded = writer >= 0 then function.method.instructions(writer) else entry
		if loaded.kind is InstructionType.LoadVariableToRegister and loaded.texts(0) is name
			return true
	false
IsChoosing(callee MlirFunction) Boolean
	Maximum.IsChoosing(Chooser)
	Maximum.IsChoosing(MlirGpuCheck.Absolute) is false
	sides = Sides(callee)
	if sides.Length is 0
		return false
	for callee.method.instructions
		if value.kind is not in Allowed or IsPlain(value, sides) is false
			return false
	IsCompared(callee, sides)
Sides(callee MlirFunction) Texts
	Maximum.Sides(Chooser) is ("left", "right")
	Maximum.Sides(Maximal) is ("value", "other")
	Maximum.Sides(MlirFunction(Maximal, type = TypeEntry(GpuChoiceSamples.Numbered, Name = "Number"))).Length is 2
	parameters = callee.method.parameters
	numbers = parameters.Length > 0 then parameters(0).typeName is "Strict/Number" else false
	if numbers and parameters.Length is 1 and TypeEntry.ShortName(callee.type.Name) is "Number"
		return ("value", parameters(0).Name)
	both = numbers and parameters.Length is 2 then parameters(1).typeName is "Strict/Number" else false
	both then (parameters(0).Name, parameters(1).Name) else List(Text)
IsPlain(entry InstructionEntry, sides Texts) Boolean
	Maximum.IsPlain(GpuChoiceSamples.Larger.instructions(0), ("left", "right"))
	Maximum.IsPlain(InstructionEntry.LoadNumber(0, 1), ("left", "right")) is false
	if entry.kind is InstructionType.LoadConstantToRegister
		return PayloadDecoder(entry).Value(1).kind is "Boolean"
	if entry.kind is not in Moves
		return true
	name = entry.texts(0)
	name.StartsWith("conditional") or name is in sides
IsCompared(callee MlirFunction, sides Texts) Boolean
	Maximum.IsCompared(Chooser, ("left", "right"))
	Maximum.IsCompared(Unchosen, ("left", "right")) is false
	mutable compared = List(Mutable(Text))
	for callee.method.instructions
		if value.kind is InstructionType.LessThan or value.kind is InstructionType.GreaterThan
			position = index
			for (value.payload(1), value.payload(2))
				writer = MlirDeviceSums(callee, -1).Writer(position, value)
				compared.Add(writer >= 0 then callee.method.instructions(writer).texts(0) else "")
	compared is sides or compared is sides.Reverse
Reduce(end Number) Texts
	Maximum.Reduce(12).First is "    %d12c0r0 = llvm.load %v_largest : !llvm.ptr -> f64"
	Text.Combine(Maximum.Reduce(12)).IndexOf("@strict_device_shuffle(%d12c0r4, %d12o0r4)") > 0
	Maximum.Reduce(12).Last is "    llvm.store %d12c0r5, %v_largest : f64, !llvm.ptr"
	mutable lines = List(Mutable(Text))
	for Range(at + 1, end)
		entry = function.method.instructions(value)
		if entry.kind is InstructionType.StoreRegisterToVariable
			lines = lines + Rounds(value - 1, "%d" + end, Chosen.Index(entry.texts(0)))
	lines
Rounds(call Number, prefix Text, number Number) Texts
	Maximum.Rounds(10, "%d12", 0).Length is 23
	Text.Combine(Owned.Rounds(10, "%d12", 0)).IndexOf("(%failed, %lane, %lanes, %d12c0r0, %d12s0r0)") > 0
	calls = MlirDeviceCalls(function, call, MlirModule(function.types, "").Call(function, call).First)
	name = "%v_" + function.method.instructions(call + 1).texts(0)
	first = function.Load(prefix + "c" + number + "r0", name)
	instance = calls.Instance(function.method.instructions(call), prefix + "h" + number)
	mutable lines = ((List(Text) + first) + instance) + calls.MemberLoads
	for Offsets
		lines = lines + Round(calls, prefix, number, index)
	lines + function.Store(prefix + "c" + number + "r" + Offsets.Length, name)
Round(calls MlirDeviceCalls, prefix Text, number Number, round Number) Texts
	Rounded(2).IndexOf("(%failed, %lane, %lanes, %d12h0, %d12c0r4, %d12s0r4)") > 0
	Rounded.Last.StartsWith("    %d12c0r5 = llvm.extractvalue %d12c0r5r[0]")
	current = prefix + "c" + number + "r" + round
	offset = prefix + "o" + number + "r" + round
	shuffled = prefix + "s" + number + "r" + round
	exact = MlirExact(function, at)
	held = calls.callee.method.parameters.Length is 1 then List(Text) else exact.Names(prefix + "h" + number)
	numbers = held + exact.Inexact(current) + exact.Inexact(shuffled)
	operands = "(" + Text.Combine(("%failed", "%lane", "%lanes") + numbers + calls.MemberArguments, ", ") + ")"
	invoked = MlirFeeding(function, at).Invoke(calls, prefix + "c" + number + "r" + (round + 1), operands)
	offsetLine = "    " + offset + " = arith.constant " + Offsets(round) + " : i32"
	(offsetLine, MlirTyped(function.Float).Shuffle(shuffled, current, offset)) + invoked
