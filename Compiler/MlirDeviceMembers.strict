has function MlirFunction
constant Head = MlirFunction(List(TypeEntry) + GpuSamples.Headed, GpuSamples.Headed, GpuSamples.Head)
constant Heading = MlirDeviceMembers(MlirGpuCheck.Heading.function)
Names Texts
	MlirDeviceMembers(Head).Names is ("heads")
	Heading.Names is ("heads")
	MlirDeviceMembers(MlirParallel.Doubling.function).Names.Length is 0
	MlirDevice(Head, 0).Function.First.EndsWith("%p1: f64, %m0: f64) -> f64 {")
	Read(function, 0)
Read(inspected MlirFunction, depth Number) Texts
	Heading.Read(Head, 3).Length is 0
	if (depth > 2) or (inspected.type.members.Length < 2)
		return List(Text)
	mutable names = Direct(inspected)
	for inspected.method.instructions
		for Inner(inspected, index, depth)
			if value is not in names
				names = names + value
	names
Direct(inspected MlirFunction) Texts
	Heading.Direct(Head) is ("heads")
	Heading.Direct(Heading.function).Length is 0
	let parameters = inspected.method.ParameterNames
	for inspected.type.members
		if (value.IsConstant is false) and (value.Name is not in parameters) and IsLoaded(inspected, value.Name)
			value.Name
Inner(inspected MlirFunction, at Number, depth Number) Texts
	Heading.Inner(Heading.function, 4, 0) is ("heads")
	Heading.Inner(Heading.function, 3, 0).Length is 0
	let owned = Owned(inspected, at)
	owned.Length is 1 then Read(owned.First, depth + 1) else List(Text)
Owned(inspected MlirFunction, at Number) List(MlirFunction)
	Heading.Owned(Heading.function, 4).First.method.Name is "Head"
	Heading.Owned(Heading.function, 3).Length is 0
	let entry = inspected.method.instructions(at)
	if (entry.kind is not InstructionType.Invoke) or (MlirDeviceCalls(inspected, at, inspected).Register(entry) >= 0)
		return List(MlirFunction)
	let callees = MlirModule(inspected.types, "").Called(inspected, at)
	(callees.Length is 1) and (callees.First.type.Name is inspected.type.Name) then callees else List(MlirFunction)
IsLoaded(inspected MlirFunction, name Text) Boolean
	Heading.IsLoaded(Head, "heads")
	Heading.IsLoaded(Head, "size") is false
	for inspected.method.instructions
		if (value.kind is in (InstructionType.LoadVariableToRegister, InstructionType.IndexCall)) and (value.texts(0) is name)
			return true
	false
IsMember(at Number, name Text) Boolean
	MlirDeviceMembers(Head).IsMember(1, "heads")
	MlirDeviceMembers(Head).IsMember(0, "position") is false
	let kind = MlirLayout(function).Represented(MlirKinds(function).VariableKind(at, name))
	(name is in Direct(function)) and (kind is in MlirGpuCheck.Values)
Passable(at Number) List(MlirFunction)
	Heading.Passable(4).Length is 1
	Heading.Passable(4).First.method.Name is "Head"
	let callees = MlirModule(function.types, "").Called(function, at)
	let isOwn = MlirDeviceCalls(function, at, function).Register(function.method.instructions(at)) < 0
	let isPlain = (callees.Length is not 1) or (MlirDeviceMembers(callees.First).Names.Length is 0)
	isOwn or isPlain then callees else List(MlirFunction)
Calling(first Number, limit Number, known Texts) Texts
	Heading.Calling(3, 7, List(Text)) is ("heads")
	Heading.Calling(3, 7, List(Text) + "heads").Length is 0
	mutable names = List(Text)
	for Range(first, limit)
		for Inner(function, value, 0)
			if (value is not in names) and (value is not in known)
				names = names + value
	names
Typed(float Text) Texts
	MlirDeviceMembers(Head).Typed("f64") is ("%m0: f64")
	for Names
		"%m" + index + ": " + float