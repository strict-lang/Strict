has function MlirFunction
has at Number
constant Doubled = MlirParallel.Doubling.function
constant Twice = MlirDevice.Twice.function
constant Singled = MlirFunction(Twice, Float = "f32")
constant Checked = MlirGpu.Checking.function
constant Layered = MlirGpu.Layering.function
constant Summed = MlirFunction(Layered.types, GpuLayerSamples.Layered, GpuLayerSamples.Summed)
constant Calling = MlirDeviceStatements(Doubled, 4)
constant Call = Doubled.method.instructions(4)
constant Multiplying = MlirDeviceStatements(Twice, 2)
constant Reading = MlirDeviceStatements(Summed, 6)
constant Lookup = Summed.method.instructions(6)
constant Absolute = MlirDeviceStatements(MlirGpuCheck.Absolute, 2)
constant Passing = MlirDeviceStatements(Layered, 5)
Emitted Texts
	MlirDeviceStatements(Doubled, 3).Emitted.First is "    %d3 = llvm.load %v_value : !llvm.ptr -> f64"
	MlirDeviceStatements(Twice, 3).Emitted.Last is "    return %d3r1 : !llvm.struct<(f64)>"
	let entry = function.method.instructions(at)
	if entry.kind < InstructionType.IndexCall
		return Moved(entry)
	if entry.kind is InstructionType.IndexCall
		return MlirDeviceRows(function, at).Emitted(entry)
	if entry.kind < InstructionType.BinaryOperatorsSeparator
		return Calculated(entry)
	if entry.kind is in (InstructionType.LoopBegin, InstructionType.LoopEnd)
		return MlirDeviceLoops(function, at).Emitted
	entry.kind is InstructionType.Invoke then MlirDeviceRows(function, at).Called(entry) else Finished(entry)
Temp(suffix Text) Text
	MlirDeviceStatements(Doubled, 5).Emitted(0) is "    %d5z = arith.constant 0 : i64"
	MlirDeviceStatements(Doubled, 5).Emitted(1) is "    %d5w = arith.cmpi eq, %lane, %d5z : i64"
	MlirDeviceStatements(Doubled, 5).Emitted(2) is "    cf.cond_br %d5w, ^d5write, ^d5skip"
	MlirDeviceStatements(Doubled, 5).Emitted(3) is "  ^d5write:"
	MlirDeviceStatements(Doubled, 5).Emitted(4) is "    %d5 = llvm.load %r2 : !llvm.ptr -> f64"
	MlirDeviceStatements(Doubled, 5).Emitted(5).StartsWith("    %d5p = llvm.getelementptr")
	MlirDeviceStatements(Doubled, 5).Emitted(17) is "    cf.br ^d5skip"
	MlirDeviceStatements(MlirGrouped.Norming.function, 13).Collected(Call)(1) is "  ^d13write:"
	MlirDeviceStatements(MlirChecks.Testing.function, 3).Labeled is ("  ^bb3:")
	MlirDeviceStatements(Absolute.function, 5).Labeled.Length is 0
	MlirDeviceStatements(Doubled, 3).Temp("a") is "%d3a"
	"%d" + at + suffix
Moved(entry InstructionEntry) Texts
	MlirDeviceStatements(Twice, 1).Moved(Twice.method.instructions(1)).First.EndsWith("0x4000000000000000 : f64")
	Text.Combine(MlirDeviceStatements(Singled, 1).Moved(Twice.method.instructions(1))).IndexOf("f64 to f32") > 0
	MlirDeviceStatements(Layered, 4).Moved(Layered.method.instructions(4)).Last.EndsWith(", %r2_b : i64, !llvm.ptr")
	if entry.kind is InstructionType.LoadVariableToRegister
		return Copied("%v_" + entry.texts(0), "%r" + entry.payload(0), entry.texts(0))
	if entry.kind is InstructionType.StoreRegisterToVariable
		return Copied("%r" + entry.payload(0), "%v_" + entry.texts(0), entry.texts(0))
	let isLoad = entry.kind is InstructionType.LoadConstantToRegister
	let number = PayloadDecoder(entry).Value(isLoad then 1 else 0).number
	let target = isLoad then "%r" + entry.payload(0) else "%v_" + entry.texts.Last
	let loaded = MlirTyped(function.Float).Number(Temp(""), MlirStatements(function, at).Hex(number))
	loaded + function.Store(Temp(""), target)
Copied(source Text, target Text, name Text) Texts
	MlirDeviceStatements(Doubled, 3).Copied("%v_value", "%r1", "value").Last is "    llvm.store %d3, %r1 : f64, !llvm.ptr"
	MlirDeviceStatements(MlirDeviceRows.Nesting, 5).Emitted.Last.EndsWith("%v_list0_b : i64, !llvm.ptr")
	if IsList(MlirKinds(function).VariableKind(at + 1, name)) is false
		let moved = (function.Load(Temp(""), source), function.Store(Temp(""), target))
		return moved + MlirExact(function, at).Copied(source, target)
	mutable lines = List(Mutable(Text))
	for MlirTyped.Parts
		lines = lines + MlirTyped(MlirTyped.Types(index)).Load(Temp(value), source + value)
		lines = lines + MlirTyped(MlirTyped.Types(index)).Store(Temp(value), target + value)
	lines
IsList(kind Text) Boolean
	MlirDeviceStatements(MlirDeviceRecords.Holding, 5).IsList("Pairs")
	MlirDeviceStatements(Summed, 0).Emitted(0) is "    %d0 = arith.constant 0x0000000000000000 : f64"
	MlirDeviceStatements(Summed, 0).Emitted.Last is "    llvm.store %d0, %v_sum : f64, !llvm.ptr"
	MlirDeviceStatements(Twice, 1).Emitted.Last is "    llvm.store %d1, %r1 : f64, !llvm.ptr"
	MlirDeviceStatements(Absolute.function, 7).Emitted(0) is "    %d7 = llvm.load %r4 : !llvm.ptr -> f64"
	MlirDeviceStatements(Singled, 0).Emitted.Last is "    llvm.store %x0c_q, %r0_q : i64, !llvm.ptr"
	MlirDeviceStatements(MlirDeviceRows.Nesting, 5).Emitted(1) is "    llvm.store %d5_d, %v_list0_d : !llvm.ptr, !llvm.ptr"
	MlirDeviceStatements(MlirDeviceRows.Nesting, 5).Emitted(2) is "    %d5_n = llvm.load %r2_n : !llvm.ptr -> i64"
	Reading.IsList("Numbers")
	Reading.IsList("Number") is false
	(MlirLayout(function).Represented(kind) is "List(Number)") or (MlirDeviceRecords(function, at).Slots(kind) > 0)
Indexed(entry InstructionEntry) Texts
	Text.Combine(Reading.Indexed(Lookup)).IndexOf("@strict_device_element(%d6d, %d6b, %d6k, %d6n)") > 0
	Reading.Indexed(Lookup)(4).StartsWith("    llvm.store %d6y, %r")
	Reading.Indexed(Lookup)(5) is "    %d6o = arith.cmpi ult, %d6k, %d6n : i64"
	let list = "%v_" + entry.texts(0)
	let position = MlirExact(function, at).Position("%r" + entry.payload(1), Temp("k"))
	let length = MlirTyped.Integer.Load(Temp("n"), list + "_n")
	let target = "%r" + entry.payload(0)
	let cleared = MlirTyped(function.Float).Number(Temp("y"), "0x0") + MlirFeeding(function, at).Stored(Temp("y"), target)
	let inside = "    " + Temp("o") + " = arith.cmpi ult, " + Temp("k") + ", " + Temp("n") + " : i64"
	let branch = "    cf.cond_br " + Temp("o") + ", ^d" + at + "read, ^d" + at + "fail"
	position + length + cleared + (inside, branch) + Failed + Read(list, target)
Failed Texts
	Reading.Failed(1) is "    %d6f = arith.constant 1 : i64"
	Reading.Failed(2) is "    llvm.store %d6f, %failed : i64, !llvm.ptr"
	Reading.Failed.Last is "    cf.br ^d6done"
	MlirDeviceStatements(MlirGuards.Shifted, 6).Emitted(32).StartsWith("    %d6 = func.call @strict_device_floats(")
	MlirDeviceStatements(MlirGuards.Shifted, 6).Emitted(32).EndsWith("(%d6d, %d6b, %d6k) : (!llvm.ptr, i64, i64) -> f32")
	MlirDeviceStatements(Summed, 9).Emitted(2) is "    %d9 = arith.addf %d9a, %d9b fastmath<contract> : f64"
	Multiplying.Emitted(0) is "    %d2a = llvm.load %r0 : !llvm.ptr -> f64"
	Multiplying.Emitted(1) is "    %d2b = llvm.load %r1 : !llvm.ptr -> f64"
	MlirDeviceStatements(Absolute.function, 6).Emitted(2) is "    %d6 = arith.subf %d6a, %d6b : f64"
	Reading.Failed.First is "  ^d6fail:"
	let one = MlirTyped.Integer.Constant(Temp("f"), "1")
	("  ^d" + at + "fail:", one, MlirTyped.Integer.Store(Temp("f"), "%failed"), "    cf.br ^d" + at + "done")
Read(list Text, target Text) Texts
	Reading.Read("%v_input", "%r4").Last is "  ^d6done:"
	MlirDeviceStatements(MlirGuards.Shifted, 6).Read("%v_numbers", "%r4")(3).IndexOf("strict_device_floats") > 0
	let data = MlirTyped.Pointer.Load(Temp("d"), list + "_d")
	let bits = MlirTyped.Integer.Load(Temp("b"), list + "_b")
	let operands = "(" + Temp("d") + ", " + Temp("b") + ", " + Temp("k") + ", " + Temp("n") + ")"
	let read = (bits, MlirTyped(function.Float).Read(Temp(""), operands))
	let guarded = " = func.call @strict_device_floats(" + Temp("d") + ", " + Temp("b") + ", " + Temp("k") + ")"
	let single = (bits, "    " + Temp("") + guarded + " : (!llvm.ptr, i64, i64) -> f32")
	let loaded = MlirGuards(function, function.Guarded).IsSingle(at) then single else read
	let done = ("    cf.br ^d" + at + "done", "  ^d" + at + "done:")
	(("  ^d" + at + "read:", data) + loaded + MlirFeeding(function, at).Stored(Temp(""), target)) + done
Calculated(entry InstructionEntry) Texts
	MlirDeviceStatements(Singled, 2).Emitted.Last is "    llvm.store %x2d, %r2_q : i64, !llvm.ptr"
	Multiplying.Calculated(Twice.method.instructions(2)).Last is "    llvm.store %d2, %r2 : f64, !llvm.ptr"
	Text.Combine(MlirDeviceStatements(Singled, 2).Calculated(Twice.method.instructions(2))).IndexOf(" : f32") > 0
	Text.Combine(Absolute.Calculated(Absolute.function.method.instructions(2))).IndexOf("arith.cmpf olt") > 0
	if entry.kind > InstructionType.ArithmeticSeparator
		return MlirStatements(function, at).Calculated(entry)
	let left = function.Load(Temp("a"), "%r" + entry.payload(1))
	let right = function.Load(Temp("b"), "%r" + entry.payload(2))
	let flags = IsContracted(entry) then " fastmath<contract>" else ""
	let calculated = MlirTyped(function.Float).Operated(Temp(""), entry.kind, Temp("a") + ", " + Temp("b") + flags)
	let stored = MlirFeeding(function, at).Stored(Temp(""), "%r" + entry.payload(3))
	((left, right, calculated) + stored) + MlirRational(MlirExact(function, at)).Operated(entry)
IsContracted(entry InstructionEntry) Boolean
	MlirDeviceStatements(Summed, 9).IsContracted(Lookup) is false
	MlirDeviceStatements(MlirDeviceRows.Nesting, 4).IsContracted(Summed.method.instructions(9)) is false
	Absolute.IsContracted(Absolute.function.method.instructions(6)) is false
	MlirDeviceStatements(Summed, 9).IsContracted(Summed.method.instructions(9))
	Multiplying.IsContracted(Twice.method.instructions(2)) is false
	let begin = function.method.LoopBeginOf(at)
	let isLooped = (begin < at) and (function.method.instructions(begin).kind is InstructionType.LoopBegin)
	let isCalculation = entry.kind is in (InstructionType.Add, InstructionType.Subtract, InstructionType.Multiply)
	isCalculation and isLooped and MlirDeviceSums(function, begin).IsSum
Called(entry InstructionEntry) Texts
	Text.Combine(Calling.Called(Call)).IndexOf("@Rows_Twice_1_device(%failed, %lane, %lanes, %d4i, %d4p0)") > 0
	Text.Combine(Passing.Called(Layered.method.instructions(5))).IndexOf("%d5p0_d, %d5p0_n, %d5p0_b") > 0
	MlirDeviceStatements(MlirGpuCheck.Floored, 1).Called(MlirGpuCheck.Flooring)(1).IndexOf("floor(%d1i)") > 0
	MlirDeviceStatements(MlirTokens.Summing.function, 15).Called(MlirTokens.Dotting)(1).IndexOf("%source") > 0
	if MlirDeviceCalls(function, at, function).IsNative(entry)
		return MlirDeviceCalls(function, at, function).Native(entry)
	let calls = MlirDeviceCalls(function, at, Callee)
	let arguments = "(" + Text.Combine(calls.Arguments, ", ") + ")"
	let feeding = MlirFeeding(function, at)
	(calls.Loaded(entry) + feeding.Invoked(calls, Temp(""), arguments)) + feeding.Called(Temp(""), "%r" + entry.payload(0))
Callee MlirFunction
	Reading.Emitted(0) is "    %d6kf = llvm.load %r3 : !llvm.ptr -> f64"
	Reading.Emitted(1) is "    %d6k = arith.fptosi %d6kf : f64 to i64"
	Reading.Emitted(2) is "    %d6n = llvm.load %v_input_n : !llvm.ptr -> i64"
	Reading.Emitted(3) is "    %d6y = arith.constant 0x0 : f64"
	Reading.Emitted(6) is "    cf.cond_br %d6o, ^d6read, ^d6fail"
	Reading.Emitted(7) is "  ^d6fail:"
	Reading.Emitted(11) is "  ^d6read:"
	Reading.Emitted(12) is "    %d6d = llvm.load %v_input_d : !llvm.ptr -> !llvm.ptr"
	Reading.Emitted(13) is "    %d6b = llvm.load %v_input_b : !llvm.ptr -> i64"
	Reading.Emitted(16) is "    cf.br ^d6done"
	Calling.Callee.Symbol is "Rows_Twice_1"
	MlirModule(function.types, "").Called(function, at).First
Finished(entry InstructionEntry) Texts
	MlirDeviceStatements(Checked, 5).Finished(Checked.method.instructions(5)).Length is 0
	MlirDeviceStatements(Absolute.function, 3).Finished(Absolute.function.method.instructions(3)).Length is 2
	if entry.kind is InstructionType.CheckError
		return List(Text)
	if entry.kind is InstructionType.FieldLoad
		return MlirDeviceRecords(function, at).Fielded(entry)
	if entry.kind is in (InstructionType.JumpToIdIfFalse, InstructionType.JumpToIdIfTrue, InstructionType.JumpEnd)
		return MlirStatements(function, at).Jumped(entry)
	entry.kind is InstructionType.Return then Returned("%r" + entry.payload(0)) else Collected(entry)
Returned(register Text) Texts
	MlirDeviceStatements(Twice, 3).Emitted(0) is "    %d3 = llvm.load %r2 : !llvm.ptr -> f64"
	MlirDeviceStatements(Twice, 3).Emitted(1) is "    %d3r0 = llvm.mlir.undef : !llvm.struct<(f64)>"
	MlirDeviceStatements(MlirDeviceRecords.Holding, 5).Emitted(2) is "    %d5c = arith.constant 1 : i64"
	MlirDeviceStatements(MlirDeviceRows.Nesting, 2).Emitted(9) is "  ^d2loop:"
	Calling.Emitted.Last is "    llvm.store %d4, %r2 : f64, !llvm.ptr"
	MlirDeviceStatements(Singled, 3).Returned("%r1").Last is "    return %d3r3 : !llvm.struct<(f32, i64, i64)>"
	MlirDeviceStatements(Singled, 3).Returned("%r1")(1) is "    %d3_e = llvm.load %r1_e : !llvm.ptr -> i64"
	let exact = MlirExact(function, at)
	let loaded = (List(Text) + function.Load(Temp(""), register)) + exact.Loaded(Temp(""), register)
	let packed = Temp("r" + exact.Names(Temp("")).Length)
	(loaded + MlirFeeding(function, at).Packed(Temp(""))) + ("    return " + packed + " : " + exact.Returned)
Labeled Texts
	MlirDeviceStatements(Absolute.function, 4).Labeled is ("  ^bb4:")
	MlirDeviceStatements(Absolute.function, 10).Labeled is ("    cf.br ^bb10", "  ^bb10:")
	if (at is 0) or (function.Label(at).Length is 0)
		return List(Text)
	let previous = function.method.instructions(at - 1).kind
	let isJump = previous is in (InstructionType.JumpToIdIfFalse, InstructionType.JumpToIdIfTrue)
	let isTerminated = isJump or (previous is InstructionType.Return)
	isTerminated then List(Text) + ("  ^bb" + at + ":") else ("    cf.br ^bb" + at, "  ^bb" + at + ":")
Collected(entry InstructionEntry) Texts
	MlirDeviceStatements(MlirGrouped.Norming.function, 13).Collected(Call).Last is "  ^d13skip:"
	MlirDeviceStatements(Doubled, 5).Collected(Doubled.method.instructions(5)).Last is "  ^d5skip:"
	MlirDeviceStatements(MlirGrouped.Norming.function, 13).Collected(Call).First is "    cf.br ^d13write"
	let stored = MlirLayout(function).Collected(Temp(""), Temp("p"), at)
	let compared = "    " + Temp("w") + " = arith.cmpi eq, %lane, " + Temp("z") + " : i64"
	let first = (MlirTyped.Integer.Constant(Temp("z"), "0"), compared)
	let branch = ("    cf.cond_br " + Temp("w") + ", ^d" + at + "write, ^d" + at + "skip", "  ^d" + at + "write:")
	let skip = ("    cf.br ^d" + at + "skip", "  ^d" + at + "skip:")
	let written = ((List(Text) + function.Load(Temp(""), "%r" + entry.payload(0))) + stored) + skip
	function.Group >= 0 then ("    cf.br ^d" + at + "write", branch.Last) + written else first + branch + written