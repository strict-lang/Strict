has function MlirFunction
has at Number
constant Summing = MlirDeviceSums(MlirDeviceStatements.Summed, 2)
constant Doubling = MlirDeviceSums(MlirGpu.Doubling.function, 2)
constant Shared = MethodEntry("Shared", GpuSamples.Summed.parameters, "Strict/Number", (MethodCodegen.StoreConstant(InstructionEntry.LoadNumber(0, 0), "sum"), InstructionEntry.Named(InstructionType.LoadVariableToRegister, 0, "row"), InstructionEntry.LoopBegin(0, -1), InstructionEntry.Named(InstructionType.LoadVariableToRegister, 1, "value"), InstructionEntry.Named(InstructionType.LoadVariableToRegister, 2, "index"), InstructionEntry(InstructionType.IndexCall, "input", (3, 2, -1)), InstructionEntry(InstructionType.CheckError, List(Text), List(Number) + 3), InstructionEntry.Binary(InstructionType.Multiply, (1, 3, 4)), InstructionEntry.Named(InstructionType.StoreRegisterToVariable, 4, "product"), InstructionEntry.Named(InstructionType.LoadVariableToRegister, 5, "sum"), InstructionEntry.Named(InstructionType.LoadVariableToRegister, 6, "product"), InstructionEntry.Binary(InstructionType.Add, (5, 6, 7)), InstructionEntry.Named(InstructionType.StoreRegisterToVariable, 7, "sum"), InstructionEntry.Jump(InstructionType.LoopEnd, 12), InstructionEntry.Named(InstructionType.LoadVariableToRegister, 0, "sum"), InstructionEntry.Return(0)))
constant Sharing = MlirDeviceSums(MlirFunction(MlirDeviceStatements.Summed.types, GpuSamples.Layered, Shared), 2)
constant Strided = MethodEntry("Strided", (MemberEntry("row", "Strict/List(Number)", List(InstructionEntry), false), MemberEntry("stride", "Strict/Number", List(InstructionEntry), false)), "Strict/Number", (MethodCodegen.StoreConstant(InstructionEntry.LoadNumber(0, 0), "sum"), InstructionEntry.Named(InstructionType.LoadVariableToRegister, 0, "stride"), InstructionEntry.LoopBegin(0, -1), InstructionEntry.Named(InstructionType.LoadVariableToRegister, 1, "sum"), InstructionEntry.Named(InstructionType.LoadVariableToRegister, 2, "index"), InstructionEntry.Named(InstructionType.LoadVariableToRegister, 3, "stride"), InstructionEntry.Binary(InstructionType.Multiply, (2, 3, 4)), InstructionEntry(InstructionType.IndexCall, "row", (5, 4, -1)), InstructionEntry(InstructionType.CheckError, List(Text), List(Number) + 5), InstructionEntry.Binary(InstructionType.Add, (1, 5, 6)), InstructionEntry.Named(InstructionType.StoreRegisterToVariable, 6, "sum"), InstructionEntry.Jump(InstructionType.LoopEnd, 9), InstructionEntry.Named(InstructionType.LoadVariableToRegister, 0, "sum"), InstructionEntry.Return(0)))
constant Striding = MlirDeviceSums(MlirFunction(MlirDeviceStatements.Summed.types, GpuSamples.Layered, Strided), 2)
constant Shifting = MlirDeviceSums(MlirFunction(MlirDeviceStatements.Summed.types, GpuSamples.Layered, MethodEntry("Shifted", Strided.parameters + MemberEntry("first", "Strict/Number", List(InstructionEntry), false), "Strict/Number", Strided.instructions.Slice(0, 5) + (InstructionEntry.Named(InstructionType.LoadVariableToRegister, 7, "first"), InstructionEntry.Binary(InstructionType.Add, (2, 7, 8)), InstructionEntry.Named(InstructionType.LoadVariableToRegister, 3, "stride"), InstructionEntry.Binary(InstructionType.Multiply, (8, 3, 4))) + Strided.instructions.Slice(7, 7))), 2)
constant Spreader = MethodEntry("Spread", List(MemberEntry) + MemberEntry("stride", "Strict/Number", List(InstructionEntry), false), "Strict/List(Number)", (MlirLoops.Emptied, InstructionEntry.Named(InstructionType.LoadVariableToRegister, 0, "weights"), InstructionEntry.LoopBegin(0, -1), InstructionEntry.Named(InstructionType.LoadVariableToRegister, 1, "value"), InstructionEntry.Named(InstructionType.LoadVariableToRegister, 2, "stride"), InstructionEntry.Invoke(3, ("Strict/Layered", "Strided", "Strict/Number", "row", "stride"), (1, 2), -1), InstructionEntry(InstructionType.CheckError, List(Text), List(Number) + 3), InstructionEntry.Named(InstructionType.InvokeWriteToList, 3, "forResult"), InstructionEntry.Jump(InstructionType.LoopEnd, 6), InstructionEntry.Named(InstructionType.LoadVariableToRegister, 0, "forResult"), InstructionEntry.Return(0)))
constant Spreads = TypeEntry("Strict/Layered", GpuSamples.Layered.members, (Spreader, Strided))
constant Spreading = MlirDeviceSums(MlirFunction(List(TypeEntry) + Spreads, Spreads, Spreader), 2)
IsSum Boolean
	Summing.IsSum
	Doubling.IsSum is false
	let names = Accumulated
	for Range(at + 1, function.method.LoopEndOf(at))
		let entry = function.method.instructions(value)
		if (entry.kind is InstructionType.LoopBegin) or (entry.kind is InstructionType.InvokeWriteToList)
			return false
		let isRead = (entry.kind is InstructionType.LoadVariableToRegister) and (entry.texts(0) is in names)
		if isRead and (IsAdded(value) is false)
			return false
	names.Length > 0
Accumulated Texts
	Summing.Accumulated is ("sum")
	Doubling.Accumulated.Length is 0
	Sharing.Accumulated is ("sum")
	mutable names = List(Mutable(Text))
	for Range(at + 1, function.method.LoopEndOf(at))
		let entry = function.method.instructions(value)
		if (entry.kind is InstructionType.StoreRegisterToVariable) and (IsLocal(value) is false)
			if IsAccumulation(value) is false
				return List(Text)
			names.Add(entry.texts(0))
	names
IsLocal(store Number) Boolean
	Sharing.IsLocal(8)
	Summing.IsLocal(10) is false
	let name = function.method.instructions(store).texts(0)
	for at
		let entry = function.method.instructions(index)
		let isStore = entry.kind is in (InstructionType.StoreConstantToVariable, InstructionType.StoreRegisterToVariable)
		if isStore and (name is in entry.texts)
			return false
	true
IsAccumulation(store Number) Boolean
	Summing.IsAccumulation(10)
	Summing.IsAccumulation(5) is false
	let entry = function.method.instructions(store)
	let previous = function.method.instructions(store - 1)
	let isSum = (previous.kind is InstructionType.Add) or (previous.kind is InstructionType.Subtract)
	if (isSum is false) or (previous.payload(3) is not entry.payload(0))
		return false
	let loaded = Writer(store - 1, previous.payload(1))
	if loaded < 0
		return false
	let writer = function.method.instructions(loaded)
	(writer.kind is InstructionType.LoadVariableToRegister) and (writer.texts(0) is entry.texts(0))
IsAdded(load Number) Boolean
	Summing.IsAdded(3)
	let register = function.method.instructions(load).payload(0)
	for Range(load + 1, function.method.LoopEndOf(at))
		let entry = function.method.instructions(value)
		if (entry.kind is InstructionType.Add) or (entry.kind is InstructionType.Subtract)
			if entry.payload(1) is register
				return IsAccumulation(value + 1)
	false
Writer(before Number, register Number) Number
	Summing.Writer(9, 1) is 3
	for before - at - 1
		let candidate = before - 1 - index
		if LoadReuse(function.method.instructions).Written(function.method.instructions(candidate)) is register
			return candidate
	-1
IsWarped Boolean
	MlirDeviceSums(MlirGpu.Layering.function, 2).IsWarped
	Doubling.IsWarped is false
	MlirDeviceSums(MlirTokens.Summing.function, 2).IsWarped is false
	Found(false)
Found(strided Boolean) Boolean
	MlirDeviceSums(MlirGpu.Layering.function, 2).Found(false)
	let end = function.method.LoopEndOf(at)
	if IsSummed(function, at + 1, end, strided)
		return true
	for MlirTokenLaunch(function, at).Devices(end)
		if IsSummed(value, 0, value.method.instructions.Length, strided)
			return true
	false
IsSummed(inspected MlirFunction, first Number, limit Number, strided Boolean) Boolean
	Summing.IsSummed(Summing.function, 0, 14, false)
	Summing.IsSummed(MlirDeviceChoice.Choosing, 0, 16, false)
	Striding.IsSummed(Striding.function, 0, 14, false)
	Striding.IsSummed(Striding.function, 0, 14, true)
	Summing.IsSummed(Summing.function, 0, 14, true) is false
	for Range(first, limit)
		if inspected.method.instructions(value).kind is InstructionType.LoopBegin
			let sums = MlirDeviceSums(inspected, value)
			let isSum = sums.IsSum and (sums.IsStrided or (strided is false))
			if isSum or ((strided is false) and MlirDeviceChoice(inspected, value).IsChoice)
				return true
	false
IsSpread Boolean
	Spreading.IsSpread
	MlirDeviceSums(MlirGpu.Layering.function, 2).IsSpread is false
	Found(true)
Lanes(target Text, count Text) Texts
	MlirDeviceSums(MlirGpu.Layering.function, 2).Lanes("%y", "%c") is List(Text) + "    %y = arith.constant 32 : i64"
	Doubling.Lanes("%y", "%c") is List(Text) + "    %y = arith.constant 1 : i64"
	Spreading.Lanes("%y", "%c").Last is "    %y = arith.select %ym, %ys, %yw : i64"
	if (IsWarped is false) or MlirWholeKernel(function, at).IsKernel
		return List(Text) + MlirTyped.Integer.Constant(target, "1")
	if IsSpread is false
		return List(Text) + MlirTyped.Integer.Constant(target, "32")
	let warp = (MlirTyped.Integer.Constant(target + "w", "32"), MlirTyped.Integer.Constant(target + "s", "1"))
	let limit = MlirTyped.Integer.Constant(target + "t", "32768")
	let many = "    " + target + "m = arith.cmpi sge, " + count + ", " + target + "t : i64"
	warp + (limit, many) + ("    " + target + " = arith.select " + target + "m, " + target + "s, " + target + "w : i64")
IsStrided Boolean
	Striding.IsStrided
	Shifting.IsStrided
	Summing.IsStrided is false
	mutable indexed = -1
	for Range(at + 1, function.method.LoopEndOf(at))
		let entry = function.method.instructions(value)
		let isIndex = (entry.kind is InstructionType.LoadVariableToRegister) and (entry.texts(0) is "index")
		let isShifted = (entry.kind is InstructionType.Add) and (indexed is in (entry.payload(1), entry.payload(2)))
		indexed = isIndex then entry.payload(0) else isShifted then entry.payload(3) else indexed
		if (entry.kind is InstructionType.Multiply) and (indexed is in (entry.payload(1), entry.payload(2)))
			return true
	false