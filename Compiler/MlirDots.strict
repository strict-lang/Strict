has function MlirFunction
has position Number
constant Layering = MlirDots(MlirGpu.Layering.function, 2)
constant Extra = MemberEntry("extra", "Strict/List(Number)", List(InstructionEntry), false)
constant ExtraRead = InstructionEntry.Named(InstructionType.LoadVariableToRegister, 7, "extra")
constant BothInstructions = (GpuLayerSamples.Summed.instructions.Slice(0, 12) + ExtraRead) + GpuLayerSamples.Summed.instructions.Slice(12, 2)
constant Both = MethodEntry("Both", GpuLayerSamples.Summed.parameters + Extra, "Strict/Number", BothInstructions)
constant MixedCall = InstructionEntry.Invoke(3, ("Strict/Layered", "Both", "Strict/Number", "row", "input", "extra"), (1, 2, 2), -1)
constant MixedInstructions = (GpuLayerSamples.Sums.instructions.Slice(0, 5) + MixedCall) + GpuLayerSamples.Sums.instructions.Slice(6, 9)
constant Mixed = MethodEntry("Mixed", GpuLayerSamples.Sums.parameters, "Strict/List(Number)", MixedInstructions)
constant MixedType = TypeEntry("Strict/Layered", GpuLayerSamples.Layered.members, (Mixed, Both))
constant Mixing = MlirDots(MlirFunction(List(TypeEntry) + MixedType, MixedType, Mixed), 2)
Mask(free Texts) Number
	Layering.Mask(("input", "biases")) is 1
	Mixing.Mask(("input", "biases")) is 0
	MlirDots(MlirTokens.Summing.function, 2).Mask(("weights", "input")) is 0
	if MlirTokens(function, position).Call >= 0
		return 0
	mutable dots = 0
	for free
		let end = function.method.LoopEndOf(position)
		dots = IsDotted(function, position + 1, end, value, true) then dots + 2 ^ index else dots
	dots
IsDotted(inspected MlirFunction, first Number, last Number, name Text, canPass Boolean) Boolean
	Layering.IsDotted(Layering.function, 3, 12, "input", true)
	Layering.IsDotted(Layering.function, 3, 12, "biases", true) is false
	Layering.IsDotted(Layering.function, 3, 12, "input", false) is false
	mutable uses = 0
	for Range(first, last)
		let use = Use(inspected, value, name, canPass)
		if use < 0
			return false
		uses = uses + use
	uses > 0
Use(inspected MlirFunction, at Number, name Text, canPass Boolean) Number
	Layering.Use(Layering.function, 4, "input", true) is 1
	Layering.Use(Layering.function, 8, "biases", true) is -1
	Layering.Use(Layering.function, 10, "biases", true) is 0
	let entry = inspected.method.instructions(at)
	let isRead = entry.kind is in (InstructionType.LoadVariableToRegister, InstructionType.IndexCall)
	if (isRead then entry.texts(0) is not name else true)
		return 0
	if entry.kind is InstructionType.IndexCall
		return MlirDeviceDot(inspected, at).IsOperand(name) then 1 else -1
	canPass and IsPassed(at) then 1 else -1
IsPassed(at Number) Boolean
	Layering.IsPassed(4)
	Layering.IsPassed(3) is false
	Mixing.IsPassed(4) is false
	let register = function.method.instructions(at).payload(0)
	mutable isPassed = false
	for Range(at + 1, function.method.LoopEndOf(position))
		let entry = function.method.instructions(value)
		let isRead = (entry.kind is InstructionType.Invoke) and (MlirKinds(function).Writer(value, register) is at)
		if isRead and (IsDottedCall(value, register) is false)
			return false
		isPassed = isPassed or (isRead and (register is in PayloadDecoder(entry).Arguments))
	isPassed
IsDottedCall(call Number, register Number) Boolean
	Layering.IsDottedCall(5, 2)
	Mixing.IsDottedCall(5, 2) is false
	let decoder = PayloadDecoder(function.method.instructions(call))
	if register is not in decoder.Arguments
		return decoder.Instance is not register
	let callees = MlirModule(function.types, "").Called(function, call)
	if (callees.Length is not 1) or (decoder.Instance is register)
		return false
	for decoder.Arguments
		if (value is register) and (IsDottedParameter(callees.First, index) is false)
			return false
	true
IsDottedParameter(callee MlirFunction, parameter Number) Boolean
	Mixing.IsDottedParameter(MlirFunction(Mixing.function, method = Both), 1)
	Mixing.IsDottedParameter(MlirFunction(Mixing.function, method = Both), 2) is false
	IsDotted(callee, 0, callee.method.instructions.Length, callee.method.parameters(parameter).Name, false)
