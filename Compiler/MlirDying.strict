has function MlirFunction
has position Number
constant SeedMoves = (InstructionEntry.Named(InstructionType.LoadVariableToRegister, 0, "start"), InstructionEntry.Named(InstructionType.StoreRegisterToVariable, 0, "moved"))
constant Seeding = MlirFunction(List(TypeEntry), MlirFunction.Shape, MethodEntry("Run", List(MemberEntry) + MemberEntry("start", "Strict/List(Number)", List(InstructionEntry), false), "None", SeedMoves + MlirOwned.Built))
constant Dropping = MlirDying(MlirOwned.Rebuilt.function, 10)
constant Dropped = InstructionEntry.Return(4)
constant Numbered = MlirDying(MlirFunction(Dropping.function, method = MethodEntry(Dropping.function.method, declaredType = "Strict/Number")), 10)
constant Guarding = ("a", "b %t#same, x", "c", "d")
constant Guard = "    %t#sv = llvm.load %v_start : !llvm.ptr -> f64"
constant Unset = ("    %t#sz = arith.cmpf oeq, %t#o, %zero : f64", "    %t#sa = arith.ori %t#same, %t#ss : i1")
constant Kept = (List(Text) + "    %t#ss = arith.cmpf oeq, %t#o, %t#sv : f64") + Unset + "    %t#sk = arith.ori %t#sa, %t#sz : i1"
Loaded(register Number) Text
	MlirDying(Seeding, 1).Loaded(0) is "start"
	MlirDying(Seeding, 4).Loaded(0) is "listResult0"
	MlirDying(Seeding, 0).Loaded(5) is "start"
	MlirDying(Dropping.function, 3).Loaded(2) is ""
	let writer = MlirKinds(function).Writer(position, register)
	let loaded = writer >= 0 then function.method.instructions(writer) else function.method.instructions(position)
	loaded.kind is InstructionType.LoadVariableToRegister then loaded.texts(0) else ""
Seed(name Text) Text
	MlirDying(Seeding, 0).Seed("moved") is "start"
	MlirDying(MlirOwned.Moving, 0).Seed("moved") is ""
	MlirDying(Seeding, 0).Seed("other") is ""
	MlirDying(Seeding, 0).Seed("start") is ""
	for function.method.instructions
		if (value.kind is InstructionType.StoreRegisterToVariable) and (value.texts(0) is name)
			let loaded = MlirDying(function, index).Loaded(value.payload(0))
			if loaded is in function.method.ParameterNames
				return loaded
	""
Guarded(lines Texts, seed Text) Texts
	Text.Combine(MlirOwned(Seeding, 4).Stored(Seeding.method.instructions(4))).IndexOf("%t4sv = llvm.load %v_start") > 0
	MlirDying(Seeding, 4).Guarded(MlirOwned.Fresh, "") is MlirOwned.Fresh
	MlirDying(Seeding, 4).Guarded(Guarding, "start") is ((List(Text) + "a" + Guard) + Kept) + ("b %t#sk, x", "c", "d")
	"    %t#sz = arith.cmpf oeq, %t#o, %zero : f64" is in MlirDying(Seeding, 4).Guarded(Guarding, "start")
	if seed is ""
		return lines
	let skipped = lines(1).Replace("%t#same,", "%t#sk,")
	((List(Text) + lines(0) + function.Load("%t#sv", "%v_" + seed)) + Kept + skipped) + lines.Slice(2, lines.Length - 2)
Mutated Texts
	Dropping.Mutated is ("moved")
	MlirDying(Seeding, 4).Mutated.Length is 0
	MlirDying(MlirOwned.Moving, 0).Mutated.Length is 0
	MlirDying(MlirOwned.Copying, 0).Mutated.Length is 0
	mutable stored = List(Text)
	for function.method.instructions
		if value.kind is InstructionType.StoreRegisterToVariable
			stored = stored + value.texts(0)
	for stored
		if ((stored.Index(value) is index) and (stored.Count(value) > 1)) and MlirOwned(function, 0).IsOwned(value)
			value
Returned(entry InstructionEntry) Texts
	Dropping.Returned(Dropped).First is "    %t10d0 = llvm.load %v_moved : !llvm.ptr -> f64"
	Dropping.Returned(Dropped).Last is "    func.call @strict_rc_dead(%t10d0, %t10) : (f64, f64) -> ()"
	Dropping.Returned(InstructionEntry.Return(7)).Length is 0
	let returned = "%t" + position
	let kept = Loaded(entry.payload(0))
	mutable lines = List(Text)
	for Mutated
		if value is not kept
			let old = returned + "d" + index
			let dead = "    func.call @strict_rc_dead(" + old + ", " + Survivor + ") : (f64, f64) -> ()"
			lines = lines + function.Load(old, "%v_" + value) + dead
	lines
Survivor Text
	Dropping.Survivor is "%t10"
	Numbered.Survivor is "%zero"
	let kind = MlirLayout(function).Represented(TypeEntry.ShortName(function.method.returnType))
	kind is in ("Number", "Boolean", "Character") then "%zero" else "%t" + position
Adder(name Text) Text
	MlirDying(MlirOwned.Moving, 0).Adder("moved") is "strict_list_add_owned"
	MlirDying(MlirCarried.Carrying.function, 0).Adder("kept") is "strict_list_add_owned"
	MlirDying(Seeding, 0).Adder("moved") is "strict_list_add"
	MlirDying(MlirOwned.Copying, 0).Adder("moved") is "strict_list_add"
	MlirDying(Seeding, 0).Adder("forResult") is "strict_list_push"
	MlirDying(Seeding, 0).Adder("listResult3") is "strict_list_push"
	if (name is "forResult") or name.StartsWith("listResult")
		return "strict_list_push"
	let isOwned = MlirOwned(function, position).IsOwned(name) or MlirCarried(function).IsCarried(name)
	isOwned then "strict_list_add_owned" else "strict_list_add"
