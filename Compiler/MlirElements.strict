has function MlirFunction
has position Number
constant Items = MemberEntry("items", "Strict/List(Strict/Math/Tripling)", List(InstructionEntry), false)
constant Remaking = InstructionEntry.Invoke(2, ("Strict/Math/Tripling", "Made", "Strict/Math/Tripling"), List(Number), 1)
constant Reading = InstructionEntry(InstructionType.IndexCall, "items", (1, 0))
constant Moving = (InstructionEntry.LoadNumber(0, 0), Reading, Remaking, InstructionEntry.Named(InstructionType.StoreRegisterToVariable, 2, "items(0)"), InstructionEntry.Return(2))
constant Keeping = (InstructionEntry.LoadNumber(0, 0), Reading, InstructionEntry.Named(InstructionType.StoreRegisterToVariable, 1, "kept"), Remaking, InstructionEntry.Named(InstructionType.StoreRegisterToVariable, 2, "items(0)"), InstructionEntry.Return(2))
constant Returning = Moving.Slice(0, 4) + Reading + InstructionEntry.Return(1)
constant Later = MlirElements(MlirFunction((MlirDestined.Maker, MlirFlats.Summing), MlirDestined.Maker, MethodEntry("Later", List(MemberEntry) + Items, "None", Returning)), 2)
constant Moved = MlirElements(MlirFunction((MlirDestined.Maker, MlirFlats.Summing), MlirDestined.Maker, MethodEntry("Moved", List(MemberEntry) + Items, "None", Moving)), 2)
constant Kept = MlirElements(MlirFunction((MlirDestined.Maker, MlirFlats.Summing), MlirDestined.Maker, MethodEntry("Kept", List(MemberEntry) + Items, "None", Keeping)), 3)
Destined(entry InstructionEntry, next InstructionEntry, compiled Texts) Texts
	Text.Combine(Moved.Destined(Remaking, Moving(3), List(Text) + "call")).IndexOf("destine_list_element(") > 0
	Kept.Destined(Remaking, Keeping(4), List(Text) + "call") is ("call")
	Moved.Destined(Remaking, Moving(4), List(Text) + "call") is ("call")
	let returned = FlatResult
	if (returned is "" then false else MlirStructs(function, position).IsTarget(entry, next, returned)) is false
		return compiled
	let parts = PayloadDecoder(next).ElementParts
	if IsKept(parts(0)) is false
		return compiled
	let temp = "%t" + position + "x"
	let destined = "    func.call @strict_flat_destine_list_element(" + temp + "l, " + temp + "i) : (f64, f64) -> ()"
	(function.Load(temp + "l", "%v_" + parts(0)), Index(parts(1), temp + "i"), destined) + compiled
IsKept(list Text) Boolean
	Moved.IsKept("items")
	Kept.IsKept("items") is false
	Later.IsKept("items")
	let steps = function.method.instructions
	for steps
		let isRead = value.kind is InstructionType.IndexCall then value.texts(0) is list else false
		let isConsumed = isRead then MlirFlats(function, index).IsConsumed(steps, index, value.payload(0)) else true
		let isLater = isRead and (index > position) then IsStored(index, value.payload(0)) is false else false
		if (isConsumed or isLater or (MlirMembered(function, position).Reader(index, value.payload(0)) is position)) is false
			return false
	true
Index(text Text, temp Text) Text
	Moved.Index("0", "%i") is "    %i = arith.constant 0.0 : f64"
	Moved.Index("at", "%i") is "    %i = llvm.load %v_at : !llvm.ptr -> f64"
	let isNumber = "0123456789".IndexOf(text.Substring(0, 1)) is not -1
	isNumber then "    " + temp + " = arith.constant " + text + ".0 : f64" else function.Load(temp, "%v_" + text)
FlatResult Text
	Moved.FlatResult is "Tripling"
	MlirElements(Moved.function, 0).FlatResult is ""
	let callees = MlirModule(function.types, "").Called(function, position)
	let isFlat = callees.Length > 0 then MlirDestined(callees.First, 0).IsDestined else false
	isFlat then TypeEntry.ShortName(callees.First.method.returnType) else ""
IsStored(at Number, register Number) Boolean
	Kept.IsStored(1, 1)
	Later.IsStored(4, 1) is false
	let steps = function.method.instructions
	let reuse = LoadReuse(steps)
	for Range(at + 1, steps.Length)
		let isKeeping = steps(value).kind is in (Inliner.Store, InstructionType.InvokeWriteToList)
		if isKeeping and (register is in reuse.Reads(steps(value)))
			return true
		if reuse.Written(steps(value)) is register
			return false
	false
