has entry MlirFunction
constant Counted = MlirEntry(MlirModule.Counters.Functions.First)
constant CollectorStart = ("    %frameLevel = arith.constant 0 : i32", "    %stackBase = llvm.call_intrinsic \"llvm.frameaddress.p0\"(%frameLevel) : (i32) -> !llvm.ptr", "    func.call @strict_gc_init(%stackBase) : (!llvm.ptr) -> ()")
Main Texts
	Counted.Main.Length is 16
	Counted.Main.Index("    func.call @strict_gc_init(%stackBase) : (!llvm.ptr) -> ()") is 3
	constant slot = "    %selfslot = llvm.alloca %one x f64 : (i64) -> !llvm.ptr"
	constant constants = ("    %one = arith.constant 1 : i64", "    %zero = arith.constant 0.0 : f64", slot)
	constant header = List(Text) + "  func.func @main(%argc: i32, %argv: !llvm.ptr) -> i32 {" + CollectorStart + constants
	constant self = "    %self = llvm.load %selfslot : !llvm.ptr -> f64"
	let returned = MlirKinds(entry).Short(entry.method.returnType) is "Number"
	let code = returned then "    %code = arith.fptosi %result : f64 to i32" else "    %code = arith.constant 0 : i32"
	let prepared = header + MlirInstances(entry, 0).Fresh(entry.type, "%selfslot", "", List(Text)) + Arguments
	prepared + (self, EntryCall, code) + ("    return %code : i32", "  }")
EntryCall Text
	Counted.EntryCall is "    %result = func.call @Counter_Run_0(%self) : (f64) -> f64"
	let count = entry.method.parameters.Length
	let names = List(Text) + "%self" + MlirCalls(entry, 0).ArgumentNames(count)
	let operands = Text.Combine(names, ", ").Replace("%t0a", "%arg")
	let signature = Text.Combine(MlirCalls(entry, 0).ArgumentTypes(count + 1), ", ")
	"    %result = func.call @" + entry.Symbol + "(" + operands + ") : (" + signature + ") -> f64"
Arguments Texts
	Counted.Arguments.Length is 0
	mutable lines = List(Mutable(Text))
	for entry.method.parameters
		lines = lines + Argument(MlirKinds(entry).Short(value.typeName), index)
	lines
Argument(kind Text, index Number) Texts
	Counted.Argument("Text", 0).Last.StartsWith("    %arg0 = func.call @strict_argument(%argc, %argv") is true
	Counted.Argument("List(Number)", 1).Length is 1
	let name = "%arg" + index
	if kind.StartsWith("List(") or (kind is in ("Numbers", "Texts"))
		return List(Text) + AllArguments(kind, name)
	let read = kind is "Number" then name + "text" else name
	let position = "    %argindex" + index + " = arith.constant " + (index + 1) + " : i32"
	constant signature = ") : (i32, !llvm.ptr, i32) -> f64"
	let argument = "    " + read + " = func.call @strict_argument(%argc, %argv, %argindex" + index + signature
	let parsed = "    " + name + " = func.call @strict_text_number(" + read + ") : (f64) -> f64"
	kind is "Number" then (position, argument, parsed) else (position, argument)
AllArguments(kind Text, name Text) Text
	Counted.AllArguments("Texts", "%arg0").IndexOf("@strict_argument_texts(") > 0 is true
	let elements = kind is in ("Texts", "List(Text)") then "texts" else "numbers"
	"    " + name + " = func.call @strict_argument_" + elements + "(%argc, %argv) : (i32, !llvm.ptr) -> f64"