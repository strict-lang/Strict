has entry MlirFunction
has others List(MlirFunction) = List(MlirFunction)
has symbol Text = "main"
constant Counted = MlirEntry(MlirModule.Counters.Functions.First)
constant Frames = MemberEntry("frames", "Strict/Number", List(InstructionEntry) + InstructionEntry.Set(List(Text), (1, 7)), false)
constant Loud = MemberEntry("loud", "Strict/Boolean", List(InstructionEntry), false)
constant Valued = MemberEntry("values", "Strict/Numbers", Frames.initial, false)
constant Both = MlirEntry(Counted.entry, List(MlirFunction) + Counted.entry)
constant Framed = MlirEntry(MlirFunction(List(TypeEntry), MlirFunction.Shape, MethodEntry("Run", List(MemberEntry) + Frames, "Strict/Number", List(InstructionEntry) + InstructionEntry.Return(0))))
constant Folders = TypeCodegen("Strict/Folders", ("Run(folder = \"Content\") Number", "\t0"), ValueCodegen.NoTypes, List(Text)).Entry
constant Foldered = MlirEntry(MlirFunction(List(TypeEntry) + Folders, Folders, Folders.methods.First))
constant Start = MethodEntry(DefaultInstance.Starter, List(MemberEntry), "Strict/Shape", List(InstructionEntry) + InstructionEntry.Return(0))
constant Starting = MlirEntry(MlirFunction(List(TypeEntry), TypeEntry(MlirFunction.Shape, methods = List(MethodEntry) + Start), MethodEntry.CountingLoop))
constant Unhandled = ("    %unhandled = func.call @strict_unhandled(%result) : (f64) -> i1", "    %failing = arith.constant 1 : i32")
constant Finished = "    func.call @strict_rc_finished() : () -> ()"
constant Exit = "    %exit = arith.select %unhandled, %failing, %code : i32"
constant CollectorStart = ("    %stackBase = llvm.call_intrinsic \"llvm.addressofreturnaddress.p0\"() : () -> !llvm.ptr", "    func.call @strict_gc_init(%stackBase) : (!llvm.ptr) -> ()", "    func.call @strict_rc_counted() : () -> ()")
constant Linked = " attributes {llvm.linkage = #llvm.linkage<internal>} {"
constant Unoptimized = " attributes {llvm.linkage = #llvm.linkage<internal>, llvm.passthrough = [\"optnone\", \"noinline\"]} {"
Main Texts
	Counted.Main.Length is 20
	Counted.Main.Index("    func.call @strict_gc_init(%stackBase) : (!llvm.ptr) -> ()") is 2
	Counted.Main(1).IndexOf("llvm.addressofreturnaddress.p0") > 0
	Starting.Main.Index("    %started = func.call @Shape_$Start_0(%fresh) : (f64) -> f64") > 0
	Both.Main.Index("    %total1 = func.call @strict_failures(%result, %result1) : (f64, f64) -> f64") > 0
	constant self = "    %self = llvm.load %selfslot : !llvm.ptr -> f64"
	let prepared = Header + Instance(entry, "") + Arguments
	let printed = entry.IsCounted then List(Text) + MlirLines.Print else List(Text)
	let called = prepared + (self, EntryCall) + Others + Code
	called + Finished + Unhandled + Exit + printed + ("    return %exit : i32", "  }")
Header Texts
	MlirEntry(Counted, symbol = "strict_main").Header.First.StartsWith("  func.func @strict_main(")
	Counted.Header.Length is 7
	Counted.Main(10) is "    llvm.store %t0of, %selfslot : f64, !llvm.ptr"
	MlirLines.Print is in MlirEntry(MlirFunction(Counted.entry, lineSlots = (1))).Main
	Framed.Main(23) is "    %arg0 = arith.select %arg0has, %arg0given, %arg0default : f64"
	constant slot = "    %selfslot = llvm.alloca %one x f64 : (i64) -> !llvm.ptr"
	constant constants = ("    %one = arith.constant 1 : i64", "    %zero = arith.constant 0.0 : f64", slot)
	let declaration = "  func.func @" + symbol + "(%argc: i32, %argv: !llvm.ptr) -> i32 {"
	List(Text) + declaration + CollectorStart + constants
Code Text
	Counted.Code is "    %code = arith.constant 0 : i32"
	Framed.Code is "    %code = arith.fptosi %result : f64 to i32"
	MlirEntry(Framed.entry, List(MlirFunction) + Framed.entry).Code is "    %code = arith.fptosi %total1 : f64 to i32"
	Framed.Arguments(0) is "    %argindex0 = arith.constant 1 : i32"
	Framed.Arguments(1).StartsWith("    %arg0giventext = func.call @strict_argument(%argc, %argv, %argindex0)")
	let total = others.Length is 0 then "%result" else "%total" + others.Length
	let returned = TypeEntry.ShortName(entry.method.returnType) is "Number"
	returned then "    %code = arith.fptosi " + total + " : f64 to i32" else "    %code = arith.constant 0 : i32"
Others Texts
	Counted.Others.Length is 0
	Both.Other(Counted.entry, 1)(0) is "    %selfslot1 = llvm.alloca %one x f64 : (i64) -> !llvm.ptr"
	Both.Other(Counted.entry, 1)(1) is "    %t0e1_oz = arith.constant 8 : i64"
	Both.Other(Counted.entry, 1)(5) is "    %self1 = llvm.load %selfslot1 : !llvm.ptr -> f64"
	mutable lines = List(Mutable(Text))
	for others
		lines = lines + Other(value, index + 1)
	lines
EntryCall Text
	Counted.EntryCall is "    %result = func.call @Counter_Run_0(%self) : (f64) -> f64"
	Framed.EntryCall is "    %result = func.call @Shape_Run_1(%self, %arg0) : (f64, f64) -> f64"
	let count = entry.method.parameters.Length
	let names = List(Text) + "%self" + MlirCalls(entry, 0).ArgumentNames(count)
	let operands = Text.Combine(names, ", ").Replace("%t0a", "%arg")
	let signature = Text.Combine(MlirCalls(entry, 0).ArgumentTypes(count + 1), ", ")
	"    %result = func.call @" + entry.Symbol + "(" + operands + ") : (" + signature + ") -> f64"
Arguments Texts
	Counted.Arguments.Length is 0
	Framed.Arguments.Last is "    %arg0 = arith.select %arg0has, %arg0given, %arg0default : f64"
	Foldered.Arguments.Last is "    %arg0 = arith.select %arg0has, %arg0given, %arg0default : f64"
	MlirEntry(MlirFunction(Framed.entry, method = MethodEntry("Run", (Loud, Valued), "Strict/Number", List(InstructionEntry)))).Arguments.Length is 4
	mutable lines = List(Mutable(Text))
	for entry.method.parameters
		let kind = TypeEntry.ShortName(value.typeName)
		let isDefaulted = (value.initial.Length > 0) and (kind is in ("Number", "Boolean", "Text"))
		let name = "%arg" + index + (isDefaulted then "given" else "")
		lines = lines + Argument(kind, index, name) + (isDefaulted then Defaulted(value, index) else List(Text))
	lines
Defaulted(parameter MemberEntry, index Number) Texts
	Framed.Defaulted(Frames, 0).First is "    %arg0slot = llvm.alloca %one x f64 : (i64) -> !llvm.ptr"
	Text.Combine(Foldered.Defaulted(Folders.methods.First.parameters.First, 0)).IndexOf(" @dp0 ") > 0
	let slot = "%arg" + index + "slot"
	let initial = Natives(entry.types).Initial(parameter)
	let named = initial.kind is "Text" then MlirDefaults(entry).ParameterName(initial.text) else ""
	let stored = MlirStatements(entry, 0).Literal(initial, slot, "d" + index, named)
	let given = "    %arg" + index + "has = arith.cmpi sgt, %argc, %argindex" + index + " : i32"
	let operands = "%arg" + index + "has, %arg" + index + "given, %arg" + index + "default : f64"
	let allocated = "    " + slot + " = llvm.alloca %one x f64 : (i64) -> !llvm.ptr"
	let chosen = "    %arg" + index + " = arith.select " + operands
	List(Text) + allocated + stored + given + entry.Load("%arg" + index + "default", slot) + chosen
Argument(kind Text, index Number, name Text) Texts
	Counted.Argument("Text", 0, "%arg0").Last.StartsWith("    %arg0 = func.call @strict_argument(%argc, %argv")
	Counted.Argument("List(Number)", 1, "%arg1").Length is 1
	Counted.Argument("Boolean", 0, "%a")(2) is "    %a = func.call @strict_text_boolean(%atext) : (f64) -> f64"
	if kind.StartsWith("List(") or (kind is in ("Numbers", "Texts"))
		return List(Text) + AllArguments(kind, name)
	let parser = kind is "Number" then "strict_text_number" else (kind is "Boolean" then "strict_text_boolean" else "")
	let read = parser is "" then name else name + "text"
	let position = "    %argindex" + index + " = arith.constant " + (index + 1) + " : i32"
	constant signature = ") : (i32, !llvm.ptr, i32) -> f64"
	let argument = "    " + read + " = func.call @strict_argument(%argc, %argv, %argindex" + index + signature
	let parsed = "    " + name + " = func.call @" + parser + "(" + read + ") : (f64) -> f64"
	parser is "" then (position, argument) else (position, argument, parsed)
AllArguments(kind Text, name Text) Text
	Counted.AllArguments("Texts", "%arg0").IndexOf("@strict_argument_texts(") > 0
	Counted.AllArguments("Numbers", "%a") is Counted.AllArguments("Texts", "%a").Replace("texts", "numbers")
	Counted.AllArguments("Texts", "%a").StartsWith("    %a = func.call @strict_argument_texts(")
	Counted.Argument("Numbers", 0, "%arg0") is (Counted.AllArguments("Numbers", "%arg0"))
	Counted.Argument("Number", 0, "%arg0")(0) is "    %argindex0 = arith.constant 1 : i32"
	Counted.Argument("Number", 0, "%a")(2) is "    %a = func.call @strict_text_number(%atext) : (f64) -> f64"
	let elements = kind is in ("Texts", "List(Text)") then "texts" else "numbers"
	"    " + name + " = func.call @strict_argument_" + elements + "(%argc, %argv) : (i32, !llvm.ptr) -> f64"
Other(function MlirFunction, number Number) Texts
	Both.Other(Counted.entry, 1).Index("    %result1 = func.call @Counter_Run_0(%self1) : (f64) -> f64") > 0
	Both.Other(Counted.entry, 2).Last is "    %total2 = func.call @strict_failures(%total1, %result2) : (f64, f64) -> f64"
	Both.Other(Starting.entry, 1).Index("    %started1 = func.call @Shape_$Start_0(%fresh1) : (f64) -> f64") > 0
	let slot = "%selfslot" + number
	let self = "%self" + number
	let previous = number is 1 then "%result" else "%total" + (number - 1)
	let call = "    %result" + number + " = func.call @" + function.Symbol + "(" + self + ") : (f64) -> f64"
	let operands = "(" + previous + ", %result" + number + ") : (f64, f64) -> f64"
	let sum = "    %total" + number + " = func.call @strict_failures" + operands
	let loaded = "    " + self + " = llvm.load " + slot + " : !llvm.ptr -> f64"
	let allocated = "    " + slot + " = llvm.alloca %one x f64 : (i64) -> !llvm.ptr"
	List(Text) + allocated + Instance(function, number to Text) + (loaded, call, sum)
Instance(function MlirFunction, suffix Text) Texts
	Counted.Instance(Counted.entry, "").Last is "    llvm.store %t0of, %selfslot : f64, !llvm.ptr"
	Starting.Instance(Starting.entry, "").Last is "    llvm.store %started, %selfslot : f64, !llvm.ptr"
	Starting.Instance(Starting.entry, "1").Index("    %fresh1 = llvm.load %selfslot1 : !llvm.ptr -> f64") > 0
	let slot = "%selfslot" + suffix
	let prefix = suffix is "" then "" else "e" + suffix + "_"
	let fresh = MlirInstances(function, 0).Fresh(function.type, slot, prefix, List(Text))
	let start = DefaultInstance.Start(function.type)
	if start.instructions.Length is 0
		return fresh
	let callee = MlirFunction(function, method = start).Symbol
	let called = "    %started" + suffix + " = func.call @" + callee + "(%fresh" + suffix + ") : (f64) -> f64"
	fresh + (function.Load("%fresh" + suffix, slot), called, function.Store("%started" + suffix, slot))
Optimized(method MethodEntry, emitted Text) Text
	MlirEntry.Optimized(MethodEntry(MethodEntry.CountingLoop, Name = TestCodegen.Runner), Linked) is Unoptimized
	MlirEntry.Optimized(MethodEntry.CountingLoop, Linked) is Linked
	Framed.Arguments(4) is "    %t0d0c = arith.constant 0x401C000000000000 : f64"
	Framed.Arguments(6) is "    %arg0has = arith.cmpi sgt, %argc, %argindex0 : i32"
	Framed.Arguments(7) is "    %arg0default = llvm.load %arg0slot : !llvm.ptr -> f64"
	method.Name is TestCodegen.Runner then emitted.Replace(Linked, Unoptimized) else emitted
