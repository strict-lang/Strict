has function MlirFunction
has position Number
constant Doubler = MlirKernel.Doubler
constant Doubling = MlirFastLoop(MlirFunction(Doubler.types, Doubler.type, Doubler.method, List(Number), 2), 2)
constant Summed = MlirKernel.Summing.function
constant Summing = MlirFastLoop(MlirFunction(Summed.types, Summed.type, Summed.method, List(Number), 1), 1)
constant Halving = MlirFastLoop(MlirFunction(Doubler.types, Doubler.type, Doubler.method, List(Number), 2, "numbers 16"), 2)
constant Quartering = MlirFastLoop(MlirFunction(Doubler.types, Doubler.type, Doubler.method, List(Number), 2, "numbers 8"), 2)
constant Squared = MlirKernel.Squaring.function
constant Squaring = MlirFastLoop(MlirFunction(Squared.types, Squared.type, Squared.method, List(Number), 2), 2)
constant Byting = MlirFastLoop(MlirFunction(MlirLayout.Bytings.types, MlirLayout.Bytings.type, MlirLayout.Bytings.method), 2)
constant Pointer = " : (!llvm.ptr, i64) -> !llvm.ptr, "
constant Iterated = "for"
constant Items = " : (f64) -> !llvm.ptr"
Temp(suffix Text) Text
	Doubling.Temp("ki") is "%t2ki"
	"%t" + position + suffix
Checked Texts
	Doubling.Checked.Last is "    %t2ok1 = arith.andi %t2ok0, %t2e_numbers : i1"
	"    %t2g_input = arith.cmpf oge, %t2n_input, %t2w_input : f64" is in Squaring.Checked
	let memory = MlirMemory(function, position)
	mutable lines = MlirLoops(function, position).CountBounds(function.method.instructions(position))
	lines = lines + ("    " + Temp("ok0") + " = arith.constant true")
	for MlirKernel(function, position).Sources
		let list = Temp("l_" + value)
		let length = memory.Called(Temp("n_" + value), "strict_list_length", List(Text) + list)
		let combined = Joined("ok" + (index + 1), Temp("ok" + index), Temp("e_" + value))
		lines = lines + function.Load(list, "%v_" + value) + length + Enough(value) + combined
	lines
Enough(source Text) Texts
	Doubling.Enough("numbers") is ("    %t2e_numbers = arith.cmpf oge, %t2n_numbers, %t2n : f64")
	Squaring.Enough("input").Last is "    %t2e_input = arith.andi %t2g_input, %t2p_input : i1"
	let shift = MlirKernel(function, position).Shift(source)
	if shift is ""
		return List(Text) + Compared("e_" + source, Temp("n_" + source), Temp("n"))
	let offset = Temp("o_" + source)
	let total = Temp("w_" + source)
	let whole = "    " + Temp("oi_" + source) + " = arith.fptosi " + offset + " : f64 to i64"
	let needed = "    " + total + " = arith.addf " + Temp("n") + ", " + offset + " : f64"
	let checks = (Compared("g_" + source, Temp("n_" + source), total), Compared("p_" + source, total, Temp("n")))
	let combined = Joined("e_" + source, Temp("g_" + source), Temp("p_" + source))
	(function.Load(offset, "%v_" + shift), whole, needed) + checks + combined
Compared(name Text, left Text, right Text) Text
	Doubling.Compared("e", "%a", "%b") is "    %t2e = arith.cmpf oge, %a, %b : f64"
	"    " + Temp(name) + " = arith.cmpf oge, " + left + ", " + right + " : f64"
Joined(name Text, left Text, right Text) Text
	Doubling.Joined("ok1", "%a", "%b") is "    %t2ok1 = arith.andi %a, %b : i1"
	"    " + Temp(name) + " = arith.andi " + left + ", " + right + " : i1"
Started Texts
	Doubling.Started.First is "  ^loop2fast:"
	Doubling.Started.Last is "    %t2ri = func.call @strict_list_items(%t2r) : (f64) -> !llvm.ptr"
	Byting.Started.Last is "    %t2ri = func.call @strict_list_data(%t2r) : (f64) -> !llvm.ptr"
	let loops = MlirLoops(function, position)
	let collected = Widths.Pointed(Temp("h"), Temp("v"), Iterated, "strict_list_items")
	let items = loops.Items.Length is 0 then loops.Items else collected + loops.Items.Last
	mutable lines = List(Text) + ("  ^loop" + position + "fast:") + items
	for MlirKernel(function, position).Sources
		lines = lines + Widths.Pointed(Temp("h_" + value), Temp("l_" + value), value, "strict_list_start")
	let saved = (function.Load(Temp("x"), "%v_index"), function.Load(Temp("y"), "%v_value"))
	let results = MlirBytes(function, position).Started(Temp("r"), Temp("ri"))
	lines + saved + loops.Outered + (loops.IsCollecting then results else List(Text))
Counted Texts
	Doubling.Counted.Last is "  ^loop2body:"
	let label = "^loop" + position
	let whole = "    " + Temp("ni") + " = arith.fptosi " + Temp("n") + " : f64 to i64"
	let start = ("    " + Temp("zi") + " = arith.constant 0 : i64", "    cf.br " + label + "(" + Temp("zi") + " : i64)")
	let check = "    " + Temp("m") + " = arith.cmpi slt, " + Temp("ki") + ", " + Temp("ni") + " : i64"
	let branch = "    cf.cond_br " + Temp("m") + ", " + label + "body, " + label + "exit"
	List(Text) + whole + start + ("  " + label + "(" + Temp("ki") + ": i64):") + check + branch + ("  " + label + "body:")
Current Texts
	Doubling.Current.Last is "    llvm.store %t2g, %v_value : f64, !llvm.ptr"
	let converted = "    " + Temp("c") + " = arith.sitofp " + Temp("ki") + " : i64 to f64"
	let index = (converted, function.Store(Temp("c"), "%v_index"))
	if MlirLoops(function, position).Collection is ""
		return index + function.Store(Temp("c"), "%v_value")
	index + Widths.Loaded(Temp("g"), Temp("gp"), Temp("h"), Iterated) + function.Store(Temp("g"), "%v_value")
Copied Texts
	Halving.Copied.First is "  ^loop2fast:"
	Halving.Copied.Index(Halving.Checked.First) is 1
	let started = Started
	List(Text) + started.First + Checked + (started - started.First) + Counted + Current + Looped + Exited
Looped Texts
	Doubling.Looped.Last is "    cf.br ^loop2(%t2next : i64)"
	mutable lines = List(Mutable(Text))
	for Range(position + 1, function.method.LoopEndOf(position))
		lines = lines + MlirLines(function).At(value, Temp("line")) + function.Emitted(value)
	let one = "    " + Temp("one") + " = arith.constant 1 : i64"
	let next = "    " + Temp("next") + " = arith.addi " + Temp("ki") + ", " + Temp("one") + " : i64"
	lines + one + next + ("    cf.br ^loop" + position + "(" + Temp("next") + " : i64)")
Exited Texts
	Doubling.Exited.First is "  ^loop2exit:"
	let loops = MlirLoops(function, function.method.LoopEndOf(position))
	let helper = MlirParallel(function, position).Filler
	let filled = MlirMemory(function, position).Called(Temp("fill"), helper, (Temp("r"), Temp("n")))
	let restored = (function.Store(Temp("x"), "%v_index"), function.Store(Temp("y"), "%v_value"))
	let collected = MlirLoops(function, position).IsCollecting then List(Text) + filled else List(Text)
	List(Text) + ("  ^loop" + position + "exit:") + collected + restored + loops.Restored(position)
Emitted(at Number) Texts
	Doubling.Emitted(4).First is "    %t4p = llvm.getelementptr %t2h_numbers[%t2ki] : (!llvm.ptr, i64) -> !llvm.ptr, f64"
	Doubling.Emitted(7).Last is "    llvm.store %t7e, %t7p : f64, !llvm.ptr"
	Halving.Emitted(4).Index("    %t4x = arith.extf %t4xn : f16 to f64") is 2
	Squaring.Emitted(7).First is "    %t2k7 = arith.addi %t2ki, %t2oi_input : i64"
	let entry = function.method.instructions(at)
	let pointer = "%t" + at + "p"
	if entry.kind is InstructionType.IndexCall
		return Widths.Read("%t" + at + "x", at) + function.Store("%t" + at + "x", "%r" + entry.payload(0))
	let element = "%t" + at + "e"
	let bytes = MlirBytes(function, position)
	let address = "    " + pointer + " = llvm.getelementptr " + Temp("ri") + "[" + Temp("ki") + "]" + Pointer + bytes.Width
	(function.Load(element, "%r" + entry.payload(0)), address) + bytes.Stored(element, pointer)
Widths MlirWidths
	Doubling.Widths.position is 2
	MlirWidths(function, position)
IsAccumulated(at Number) Boolean
	Summing.IsAccumulated(5)
	Doubling.IsAccumulated(6) is false
	let entry = function.method.instructions(at)
	let next = function.method.instructions(at + 1)
	let isSum = (entry.kind is InstructionType.Add) or (entry.kind is InstructionType.Subtract)
	if (function.FastLoop < 0) or (isSum is false) or (next.kind is not InstructionType.StoreRegisterToVariable)
		return false
	let writer = Writer(entry.payload(1), at)
	let isLoaded = (writer.kind is InstructionType.LoadVariableToRegister) and (next.texts(0) is in writer.texts)
	isLoaded and (next.payload(0) is entry.payload(3))
Writer(register Number, at Number) InstructionEntry
	Summing.Writer(3, 5).texts.First is "sum"
	for at - function.FastLoop - 1
		let earlier = function.method.instructions(at - 1 - index)
		if LoadReuse(function.method.instructions).Written(earlier) is register
			return earlier
	function.method.instructions(at)