has function MlirFunction
has at Number
constant Chained = MlirFeeding(MlirFunction(List(TypeEntry) + GpuSamples.Layered, GpuSamples.Layered, MethodEntry("Chained", List(MemberEntry) + MemberEntry("input", "Strict/List(Number)", List(InstructionEntry), false), "Strict/Number", (InstructionEntry.Named(InstructionType.LoadVariableToRegister, 0, "index"), InstructionEntry(InstructionType.IndexCall, "input", (1, 0, -1)), InstructionEntry.Named(InstructionType.StoreRegisterToVariable, 1, "offset"), InstructionEntry.Named(InstructionType.LoadVariableToRegister, 2, "offset"), InstructionEntry(InstructionType.IndexCall, "input", (3, 2, -1)), InstructionEntry.Return(3)))), 0)
constant Summing = MlirFeeding(MlirDeviceStatements.Summed, 6)
constant Singled = MlirFeeding(MlirFunction(MlirDeviceStatements.Summed, Float = "f32"), 6)
constant Passing = MlirFeeding(MlirFunction(List(TypeEntry) + GpuSamples.Headed, GpuSamples.Headed, MethodEntry("Passed", List(MemberEntry) + MemberEntry("count", "Strict/Number", List(InstructionEntry), false), "Strict/List(Number)", (MlirLoops.Emptied, InstructionEntry.Named(InstructionType.LoadVariableToRegister, 0, "count"), InstructionEntry.LoopBegin(0, -1), InstructionEntry.Named(InstructionType.LoadVariableToRegister, 1, "index"), InstructionEntry(InstructionType.IndexCall, "weights", (2, 1, -1)), InstructionEntry(InstructionType.CheckError, List(Text), List(Number) + 2), InstructionEntry.Invoke(3, ("Strict/Headed", "Head", "Strict/Number", "position"), List(Number) + 2, -1), InstructionEntry(InstructionType.CheckError, List(Text), List(Number) + 3), InstructionEntry.Named(InstructionType.InvokeWriteToList, 3, "forResult"), InstructionEntry.Jump(InstructionType.LoopEnd, 7), InstructionEntry.Named(InstructionType.LoadVariableToRegister, 0, "forResult"), InstructionEntry.Return(0)))), 4)
constant Unfloated = (InstructionType.StoreRegisterToVariable, InstructionType.CheckError, InstructionType.IndexCall, InstructionType.LoopBegin)
Stored(number Text, target Text) Texts
	Summing.Stored("%d6", "%r4") is ("    llvm.store %d6, %r4 : f64, !llvm.ptr")
	Singled.Stored("%d6", "%r4").Last is "    llvm.store %inexact, %r4_q : i64, !llvm.ptr"
	MlirFeeding(MlirDeviceStatements.Singled, 2).Stored("%d2", "%r2") is ("    llvm.store %d2, %r2 : f32, !llvm.ptr")
	let entry = function.method.instructions(at)
	if entry.kind is in MlirRational.Kinds
		return List(Text) + MlirTyped(function.Float).Store(number, target)
	if IsFeeding(at, LoadReuse(function.method.instructions).Written(entry))
		return List(Text) + function.Store(number, target)
	let inexact = MlirExact(function, at).Set("%inexact", "%inexact", target)
	(List(Text) + MlirTyped(function.Float).Store(number, target)) + inexact
Packed(name Text) Texts
	Singled.Packed("%d3").Last is "    %d3r3 = llvm.insertvalue %d3_q, %d3r2[2] : !llvm.struct<(f32, i64, i64)>"
	Summing.Packed("%d3").Length is 2
	let returned = MlirExact(function, at).Returned
	mutable lines = List(Text) + ("    " + name + "r0 = llvm.mlir.undef : " + returned)
	for MlirExact(function, at).Names(name)
		let packed = " = llvm.insertvalue " + value + ", " + name + "r" + index + "[" + index + "] : "
		lines = lines + ("    " + name + "r" + (index + 1) + packed + returned)
	lines
Unpacked(name Text) Texts
	Singled.Unpacked("%d6").First is "    %d6 = llvm.extractvalue %d6r[0] : !llvm.struct<(f32, i64, i64)>"
	Summing.Unpacked("%d6") is ("    %d6 = llvm.extractvalue %d6r[0] : !llvm.struct<(f64)>")
	let returned = MlirExact(function, at).Returned
	for MlirExact(function, at).Names(name)
		"    " + value + " = llvm.extractvalue " + name + "r[" + index + "] : " + returned
Invoked(calls MlirDeviceCalls, result Text, operands Text) Texts
	Summing.Invoked(MlirDeviceCalls.Twice, "%d6", "(%a)").First.StartsWith("    %d6r = func.call @Rows_Twice_1_device(%a)")
	Singled.Invoked(MlirDeviceCalls.Twice, "%d6", "(%a)").Last.StartsWith("    %d6_q = llvm.extractvalue %d6r[2]")
	let symbol = calls.callee.Symbol + "_device" + MlirTyped(function.Float).Suffix
	let call = "    " + result + "r = func.call @" + symbol + operands
	(List(Text) + (call + " : (" + calls.Types + ") -> " + MlirExact(function, at).Returned)) + Unpacked(result)
Called(number Text, target Text) Texts
	Singled.Called("%d6", "%r4").Last is "    llvm.store %d6_q, %r4_q : i64, !llvm.ptr"
	Summing.Called("%d6", "%r4") is ("    llvm.store %d6, %r4 : f64, !llvm.ptr")
	let exact = MlirExact(function, at).Set(number + "_e", number + "_q", target)
	(List(Text) + MlirTyped(function.Float).Store(number, target)) + exact
IsFeeding(position Number, register Number) Boolean
	Chained.IsFeeding(1, 1)
	Chained.IsFeeding(4, 3) is false
	Summing.IsFeeding(6, 4) is false
	let reuse = LoadReuse(function.method.instructions)
	for Range(position + 1, function.method.instructions.Length)
		let entry = function.method.instructions(value)
		let isRead = (register is in reuse.Reads(entry)) and IsPositional(value, entry, register)
		if isRead or IsStored(value, entry, register)
			return true
		if reuse.Written(entry) is register
			return false
	false
IsStored(position Number, entry InstructionEntry, register Number) Boolean
	Chained.IsStored(2, Chained.function.method.instructions(2), 1)
	Summing.IsStored(10, Summing.function.method.instructions(10), 6) is false
	let isStore = (entry.kind is InstructionType.StoreRegisterToVariable) and (entry.payload(0) is register)
	isStore and IsLoaded(position, entry.texts(0))
IsPositional(position Number, entry InstructionEntry, register Number) Boolean
	Chained.IsPositional(4, Chained.function.method.instructions(4), 3)
	Passing.IsPositional(6, Passing.function.method.instructions(6), 2)
	Summing.IsPositional(8, Summing.function.method.instructions(8), 5) is false
	let kind = entry.kind
	let isCompared = (kind > InstructionType.ArithmeticSeparator) and (kind < InstructionType.BinaryOperatorsSeparator)
	if (kind is InstructionType.IndexCall) or isCompared or IsPassed(position, register)
		return true
	let isCalculated = (kind > InstructionType.StoreSeparator) and (kind < InstructionType.ArithmeticSeparator)
	let written = LoadReuse(function.method.instructions).Written(entry)
	((kind is InstructionType.Invoke) or isCalculated) and IsFeeding(position, written)
IsPassed(position Number, register Number) Boolean
	Passing.IsPassed(6, 2)
	MlirFeeding(MlirParallel.Doubling.function, 4).IsPassed(4, 1) is false
	let entry = function.method.instructions(position)
	let callees = MlirModule(function.types, "").Called(function, position)
	if callees.Length is 0
		return false
	let countPosition = 5 + entry.payload(3)
	for entry.payload(countPosition)
		let name = callees.First.method.parameters(index).Name
		if (entry.payload(countPosition + 1 + index) is register) and MlirFeeding(callees.First, 0).IsLoaded(-1, name)
			return true
	false
IsLoaded(position Number, name Text) Boolean
	Chained.IsLoaded(2, "offset")
	Summing.IsLoaded(10, "sum") is false
	for Range(position + 1, function.method.instructions.Length)
		let entry = function.method.instructions(value)
		let isNamed = (entry.kind is InstructionType.LoadVariableToRegister) and (entry.texts(0) is name)
		if isNamed and IsFeeding(value, entry.payload(0))
			return true
	false
IsFloated(position Number, register Number) Boolean
	Chained.IsFloated(4, 3)
	Chained.IsFloated(1, 1) is false
	let reuse = LoadReuse(function.method.instructions)
	for Range(position + 1, function.method.instructions.Length)
		let entry = function.method.instructions(value)
		let isStored = (entry.kind is InstructionType.StoreRegisterToVariable) and (entry.payload(0) is register)
		let isRead = (register is in reuse.Reads(entry)) and IsFloating(value, entry)
		if isRead or (isStored and IsFloatedVariable(value, entry.texts(0)))
			return true
		if reuse.Written(entry) is register
			return false
	false
IsFloating(position Number, entry InstructionEntry) Boolean
	Chained.IsFloating(5, Chained.function.method.instructions(5))
	Chained.IsFloating(4, Chained.function.method.instructions(4)) is false
	let kind = entry.kind
	let isCompared = (kind > InstructionType.ArithmeticSeparator) and (kind < InstructionType.BinaryOperatorsSeparator)
	if isCompared or (kind is in Unfloated)
		return false
	let isCalculated = (kind > InstructionType.StoreSeparator) and (kind < InstructionType.ArithmeticSeparator)
	let isFloor = (kind is InstructionType.Invoke) and (entry.texts(1) is "Floor")
	(isCalculated or isFloor) then IsFloated(position, LoadReuse(function.method.instructions).Written(entry)) else true
IsFloatedVariable(position Number, name Text) Boolean
	Chained.IsFloatedVariable(2, "offset") is false
	Summing.IsFloatedVariable(10, "sum")
	for Range(position + 1, function.method.instructions.Length)
		let entry = function.method.instructions(value)
		let isNamed = (entry.kind is InstructionType.LoadVariableToRegister) and (entry.texts(0) is name)
		if isNamed and IsFloated(value, entry.payload(0))
			return true
	false
