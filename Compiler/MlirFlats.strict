has function MlirFunction
has position Number
constant Validating = MethodEntry("Validated", List(MemberEntry), "Strict/Math/Tripling", (InstructionEntry.LoadText(0, "ConstraintNotMet: numbers with Length is 3 is false for "), InstructionEntry.Return(0)))
constant Reading = InstructionEntry.Invoke(1, ("Strict/List(Number)", "Z", "Strict/Number"), List(Number), 0)
constant Zed = MethodEntry("Z", List(MemberEntry), "Strict/Number", (InstructionEntry.Named(InstructionType.LoadVariableToRegister, 0, "numbers"), Reading, InstructionEntry.Return(1)))
constant Numbers = MemberEntry("numbers", "Strict/List(Number)", List(InstructionEntry), false, 32, 3)
constant FirstNumber = MethodEntry("First", List(MemberEntry), "Strict/Number", (InstructionEntry.LoadNumber(0, 0), InstructionEntry(InstructionType.IndexCall, "numbers", (1, 0)), InstructionEntry.Return(1)))
constant Tripling = TypeEntry("Strict/Math/Tripling", List(MemberEntry) + Numbers, (Validating, Zed, FirstNumber))
constant SumInstructions = (InstructionEntry.Named(InstructionType.LoadVariableToRegister, 0, "numbers"), InstructionEntry.Invoke(1, ("Strict/List(Number)", "Sum", "Strict/Number"), List(Number), 0), InstructionEntry.Return(1))
constant Summing = TypeEntry("Strict/Math/Summing", List(MemberEntry) + Numbers, (Validating, MethodEntry("Sum", List(MemberEntry), "Strict/Number", SumInstructions)))
constant Reader = MlirFlats(MlirFunction((Tripling, Summing), Tripling, Tripling.methods.Last), 1)
constant HalvedInstructions = (InstructionEntry.Named(InstructionType.LoadVariableToRegister, 0, "numbers"), InstructionEntry.LoadNumber(1, 2), InstructionEntry.Binary(InstructionType.Divide, (0, 1, 2)), InstructionEntry.Return(2))
constant Halving = TypeEntry("Strict/Math/Halving", List(MemberEntry) + Numbers, (Validating, MethodEntry("Halved", List(MemberEntry), "Strict/List(Number)", HalvedInstructions)))
constant Accessors = ("X", "Y", "Z", "W", "Length", "Count")
constant Construction = InstructionEntry.Invoke(4, ("Strict/Math/Tripling", "from", "Strict/Math/Tripling", "numbers"), List(Number) + 3, -1)
constant FillingStart = (InstructionEntry.LoadNumber(0, 1), InstructionEntry.Named(InstructionType.InvokeWriteToList, 0, "listResult0"), InstructionEntry.LoadNumber(1, 2))
constant Filling = FillingStart + (InstructionEntry.Named(InstructionType.InvokeWriteToList, 1, "listResult0"), InstructionEntry.LoadNumber(2, 3), InstructionEntry.Named(InstructionType.InvokeWriteToList, 2, "listResult0"))
constant MadeEnding = List(InstructionEntry) + InstructionEntry.Named(InstructionType.LoadVariableToRegister, 3, "listResult0") + Construction + InstructionEntry.Return(4)
constant Making = MethodEntry("Made", List(MemberEntry), "Strict/Math/Tripling", (List(InstructionEntry) + MlirOwned.Empty) + Filling + MadeEnding)
constant Made = MlirFlats(MlirFunction((Tripling, Summing), Tripling, Making), 2)
constant Sample = MlirFlats(MlirFunction((Tripling, Summing), Tripling, Zed), 1)
constant MaximumCount = 16
constant Listed = TypeEntry(Tripling, members = List(MemberEntry) + MemberEntry(Numbers, typeName = "Strict/Numbers"))
constant Unflat = MemberEntry("", "Strict/Number", List(InstructionEntry), false)
constant Looked = MlirFlats(MlirFunction((Tripling, Summing), Tripling, Zed, typeIndex = Dictionary(("Strict/Math/Tripling", 0), ("Tripling", 0))), 1)
Count(kind Text) Number
	(Sample.Count("Tripling") is 3) and (Sample.Count("Strict/Math/Tripling") is 3)
	Sample.Count("Summing") is 0
	MlirFlats(MlirPacking.Halved.function, 0).Count("Halving") is 3
	Sample.Count("Number") is 0
	Looked.Count("Strict/Math/Tripling") is 3
	let type = function.TypeOf(kind, true)
	let member = Flat(type)
	let isListed = member.typeName.EndsWith("s") or member.typeName.EndsWith(")")
	if (isListed is false) or (TypeEntry.ShortName(member.typeName) is not in ("List(Number)", "Numbers"))
		return 0
	let count = member.Count
	(count >= 3) and (count <= MaximumCount) and IsSupported(type, member.Name) then count else 0
Flat(type TypeEntry) MemberEntry
	Sample.Flat(Tripling) is Numbers
	MlirFlats(MlirFunction(List(TypeEntry) + Listed, Listed, Zed), 1).Count("Tripling") is 3
	Sample.Flat(TypeEntry("Strict/Two", (Numbers, Numbers), List(MethodEntry))) is Unflat
	Sample.Flat(TypeEntry("Strict/Kept", (MemberEntry.SevenMember, Numbers), List(MethodEntry))) is Numbers
	Sample.Flat(TypeEntry("Strict/Wide", List(MemberEntry) + MemberEntry(Numbers, Bits = 64), List(MethodEntry))) is Unflat
	mutable only = Unflat
	for type.members
		if value.IsConstant is false
			if only.Name is not ""
				return Unflat
			only = value
	only.Bits is Number.SingleBits then only else Unflat
Constrained(type TypeEntry) Number
	Sample.IsAccessor(InstructionEntry.Invoke(1, ("Strict/List(Number)", "Z", "N", "x"), List(Number) + 5, 2), 2)
	Sample.IsAccessor(InstructionEntry.Invoke(1, ("Strict/List(Number)", "Code", "N"), List(Number), 0), 0)
	Sample.IsAccessor(InstructionEntry.Invoke(1, ("Strict/List(Number)", "to", "N"), List(Number), 0), 0) is false
	Sample.IsAccessor(InstructionEntry.Invoke(1, ("Strict/List(Number)", "Sum", "N"), List(Number), 0), 0) is false
	Sample.IsAccessor(InstructionEntry.Named(InstructionType.StoreRegisterToVariable, 0, "inline2"), 1) is false
	Sample.IsAccessor(InstructionEntry.Named(InstructionType.StoreRegisterToVariable, 0, "value"), 0) is false
	Sample.IsAccessor(InstructionEntry.Named(InstructionType.LoadVariableToRegister, 0, "inline2"), 0) is false
	MlirFlats(MlirPairs.Sample.function, 0).Count("Pairing") is 0
	Sample.Constrained(Tripling) is 3
	let changing = type.Changing
	changing.Length is 1 then changing.First.Count else 0
IsSupported(type TypeEntry, member Text) Boolean
	Sample.IsSupported(Tripling, "numbers")
	Sample.IsSupported(Summing, "numbers") is false
	for type.methods
		let steps = value.instructions
		for steps
			let name = value.texts.Length > 0 then value.texts(0) else ""
			let isNamed = (name is member) or name.StartsWith(member + "(") or name.StartsWith(member + ".")
			let isRead = value.kind is InstructionType.LoadVariableToRegister
			let isKept = isRead then IsConsumed(steps, index, value.payload(0)) else value.kind is in MlirKinds.Indexing
			if isNamed and (isKept is false)
				return false
	true
IsAccessor(step InstructionEntry, register Number) Boolean
	Sample.IsAccessor(Reading, 0) and (Sample.IsAccessor(Reading, 1) is false)
	Sample.IsAccessor(InstructionEntry.Return(0), 0) is false
	Sample.IsAccessor(InstructionEntry.Named(InstructionType.StoreRegisterToVariable, 0, "inline2_elements"), 0)
	Sample.IsAccessor(InstructionEntry.Invoke(1, ("Strict/List(Number)", "to", "Strict/Text"), List(Number), 0), 0)
	if step.kind is not InstructionType.Invoke
		let isAlias = Text.Combine(step.texts).StartsWith("inline") and (step.payload(0) is register)
		return (step.kind is InstructionType.StoreRegisterToVariable) and isAlias
	let instance = PayloadDecoder(step).Instance
	let isText = (step.texts(1) is "Code") or ((step.texts(1) is "to") and step.texts(2).EndsWith("Text"))
	(instance is register) and ((step.texts(1) is in Accessors) or isText)
Helper(entry InstructionEntry, owner Text, name Text) Text
	Sample.IsConsumed((InstructionEntry.Named(InstructionType.StoreRegisterToVariable, 0, "x")), -1, 0) is false
	Sample.Helper(Construction, "Tripling", "Z") is ""
	Sample.Helper(Reading, "Tripling", "Sum") is ""
	Sample.Helper(Reading, "Tripling", "Z") is "strict_flat_z"
	Sample.Helper(Reading, "Tripling", "Length") is "strict_flat_length"
	Sample.Helper(Reading, "Summing", "Z") is ""
	Sample.Helper(Reading, "Tripling", "Code") is "strict_flat_text"
	if (Count(owner) is 0) or (entry.texts.First.StartsWith("Strict/List(") is false)
		return ""
	if name is in ("Length", "Count", "Code")
		return name is "Code" then "strict_flat_text" else "strict_flat_length"
	name is in ("X", "Y", "Z", "W") then "strict_flat_" + name.Lower else ""
Packed(name Text) Number
	Made.Packed("listResult0") is 3
	Sample.Packed("listResult0") is 0
	let instructions = function.method.instructions
	mutable writes = 0
	mutable count = 0
	for instructions
		if (value.kind is InstructionType.InvokeWriteToList) and (value.texts(0) is name)
			writes = writes + 1
		let isLoaded = (value.kind is InstructionType.LoadVariableToRegister) and (value.texts(0) is name)
		if isLoaded and (index + 1 < instructions.Length)
			count = Constructing(instructions(index + 1), value.payload(0))
	writes is count then count else 0
Constructing(entry InstructionEntry, register Number) Number
	Made.Constructing(InstructionEntry.Return(3), 3) is 0
	Made.Constructing(InstructionEntry.Invoke(4, ("Strict/Math/Tripling", "Of", "T"), List(Number) + 3, -1), 3) is 0
	Made.Constructing(InstructionEntry.Invoke(4, ("Strict/Math/Tripling", "from", "T"), (3, 3), -1), 3) is 0
	Made.Constructing(Construction, 3) is 3
	Made.Constructing(Construction, 2) is 0
	if entry.kind is not InstructionType.Invoke
		return 0
	let arguments = PayloadDecoder(entry).Arguments
	let isOnly = (entry.texts(1) is "from") and (arguments.Length is 1)
	isOnly and (arguments.First is register) then Count(entry.texts(0)) else 0
Appended(entry InstructionEntry, fallback MlirLists) Texts
	Made.Appended(Making.instructions(2), MlirLists(Made.function, 2)).Last.IndexOf("_set(%t2f, %t2k, %t2e)") > 0
	MlirFlats(Made.function, 4).Appended(Making.instructions(4), MlirLists(Made.function, 4)).Last.IndexOf("%t4k") > 0
	let count = entry.kind is InstructionType.InvokeWriteToList then Packed(entry.texts(0)) else 0
	if count is 0
		return fallback.Appended(entry)
	let written = MlirPairs(function, position).Written(entry.texts(0))
	let temp = "%t" + position
	let index = "    " + temp + "k = arith.constant " + written + ".0 : f64"
	let set = "    func.call @strict_flat_set(" + temp + "f, " + temp + "k, " + temp + "e) : (f64, f64, f64) -> ()"
	Started(count, written, "%v_" + entry.texts(0)) + index + function.Load(temp + "e", "%r" + entry.payload(0)) + set
Started(count Number, written Number, slot Text) Texts
	Made.Appended(Making.instructions(2), MlirLists(Made.function, 2))(0) is "    %t2n = arith.constant 3.0 : f64"
	Made.Appended(Making.instructions(2), MlirLists(Made.function, 2))(3) is "    %t2k = arith.constant 0.0 : f64"
	Made.Appended(Making.instructions(2), MlirLists(Made.function, 2))(4) is "    %t2e = llvm.load %r0 : !llvm.ptr -> f64"
	Made.Appended(Making.instructions(2), MlirLists(Made.function, 2))(2).IndexOf("f, %v_listResult0 :") is 18
	Made.Started(3, 0, "%s").Last is "    llvm.store %t2f, %s : f64, !llvm.ptr"
	Made.Started(3, 1, "%s") is ("    %t2f = llvm.load %s : !llvm.ptr -> f64")
	let temp = "%t" + position
	if written > 0
		return List(Text) + function.Load(temp + "f", slot)
	let counted = "    " + temp + "n = arith.constant " + count + ".0 : f64"
	let created = MlirDestined(function, position).Started(temp, slot.Replace("%v_", ""))
	(List(Text) + counted) + created + function.Store(temp + "f", slot)
Constructed(entry InstructionEntry, typeName Text, instances MlirInstances) Texts
	MlirFlats(Made.function, 8).Constructed(Construction, "Tripling", MlirInstances(Made.function, 8)).Length is 2
	Sample.Constructed(Construction, "Tripling", MlirInstances(Sample.function, 1))(1).IndexOf("flat_from_list(") > 0
	let argument = entry.payload(6 + entry.payload(3))
	let writer = MlirKinds(function).Writer(position, argument)
	let loaded = writer >= 0 then function.method.instructions(writer) else entry
	let isBuilt = (loaded.kind is InstructionType.LoadVariableToRegister) and (Packed(loaded.texts(0)) > 0)
	if (Count(typeName) is 0) or isBuilt
		return instances.Constructed(entry, typeName)
	let temp = "%t" + position
	let converted = "    " + temp + "f = func.call @strict_flat_from_list(" + temp + "l) : (f64) -> f64"
	(function.Load(temp + "l", "%r" + argument), converted, function.Store(temp + "f", "%r" + entry.payload(0)))
Kind(kind Text) Text
	Sample.Constructed(Construction, "Tripling", MlirInstances(Sample.function, 1))(0).IndexOf("l = llvm.load %r3 ") is 7
	Sample.Constructed(Construction, "Tripling", MlirInstances(Sample.function, 1))(1).IndexOf("(%t1l) :") is 43
	Sample.Constructed(Construction, "Tripling", MlirInstances(Sample.function, 1))(1).IndexOf("1f = func") is 6
	Sample.Constructed(Construction, "Tripling", MlirInstances(Sample.function, 1))(2).IndexOf("%t1f, %r4 :") is 15
	Sample.Kind("Tripling") is "Flat"
	Sample.Kind("Summing") is ""
	MlirFlats(MlirPairs.Sample.function, 0).Kind("Pairing") is "Pair"
	MlirPairs(function, 0).IsPaired(kind) then "Pair" else (Count(kind) > 0 then "Flat" else "")
IsListed(kind Text) Boolean
	Made.Appended(Making.instructions(2), MlirLists(Made.function, 2)).Length is 6
	MlirFlats(Made.function, 4).Appended(Making.instructions(4), MlirLists(Made.function, 4))(1).EndsWith("t 1.0 : f64")
	Sample.Defaulted("Tripling", MlirPairs.Twice, "%s", "d0")(7) is "    %t1d0fl = llvm.load %s : !llvm.ptr -> f64"
	Sample.Defaulted("Tripling", MlirPairs.Twice, "%s", "d0")(8).IndexOf("f = func.call @strict_flat_from_list(") is 9
	Sample.Defaulted("Tripling", MlirPairs.Twice, "%s", "d0")(8).EndsWith("(%t1d0fl) : (f64) -> f64")
	Sample.Defaulted("Tripling", MlirPairs.Twice, "%s", "d0").Length is 10
	MlirFlats(MlirPairs.Sample.function, 0).Defaulted("Pairing", MlirPairs.Twice, "%s", "d0").Length is 4
	Sample.Defaulted("Summing", MlirPairs.Twice, "%s", "d0").Length is 7
	Sample.IsListed("Tripling")
	MlirFlats(MlirPairs.Sample.function, 0).IsListed("Pairing")
	MlirFlats(MlirCouples.Sample.function, 0).IsListed("Sizing") is false
	MlirPairs(function, 0).IsListed(kind) or (Count(kind) > 0)
Defaulted(kind Text, initial Runtime/VmValue, slot Text, suffix Text) Texts
	Sample.Defaulted("Tripling", MlirPairs.Twice, "%s", "d0").Last is "    llvm.store %t1d0f, %s : f64, !llvm.ptr"
	if Kind(kind) is "Pair"
		return MlirPairs(function, position).Defaulted(initial, slot, suffix)
	let built = MlirStatements(function, position).Literal(initial, slot, suffix)
	if Kind(kind) is not "Flat"
		return built
	let temp = "%t" + position + suffix
	let converted = "    " + temp + "f = func.call @strict_flat_from_list(" + temp + "fl) : (f64) -> f64"
	built + function.Load(temp + "fl", slot) + converted + function.Store(temp + "f", slot)
Indexed(entry InstructionEntry, fallback MlirLists) Texts
	Reader.Indexed(Tripling.methods(2).instructions(1), MlirLists(Sample.function, 1))(0).IndexOf("l = llvm.load %v_") is 7
	Reader.Indexed(Tripling.methods(2).instructions(1), MlirLists(Sample.function, 1))(1).IndexOf("i = llvm.load %r0") is 7
	Reader.Indexed(Tripling.methods(2).instructions(1), MlirLists(Sample.function, 1))(2).IndexOf("at(%t1l, %t1i) :") is 34
	Reader.Indexed(Tripling.methods.Last.instructions(1), MlirLists(Sample.function, 1))(3).IndexOf("%t1x, %r1 :") is 15
	Reader.Indexed(Tripling.methods.Last.instructions(1), MlirLists(Sample.function, 1))(2).IndexOf("flat_at(") > 0
	if MlirCouples(function, position).IsFlatRead(entry) is false
		return fallback.Indexed(entry)
	let temp = "%t" + position
	let read = "    " + temp + "x = func.call @strict_flat_at(" + temp + "l, " + temp + "i) : (f64, f64) -> f64"
	let loads = (function.Load(temp + "l", "%v_" + entry.texts(0)), function.Load(temp + "i", "%r" + entry.payload(1)))
	loads + read + function.Store(temp + "x", "%r" + entry.payload(0))
IsConsumed(steps List(InstructionEntry), at Number, register Number) Boolean
	Sample.IsConsumed(Zed.instructions, 0, 0)
	Sample.IsConsumed(Halving.methods.Last.instructions, 0, 0)
	Sample.IsConsumed(MlirAlone.Checking.Slice(0, 2) + Reading, 0, 0)
	Sample.IsConsumed((InstructionEntry.LoadNumber(0, 1), InstructionEntry.Return(0)), 0, 0) is false
	let reuse = LoadReuse(steps)
	for Range(at + 1, steps.Length)
		let kind = steps(value).kind
		let isArithmetic = (kind > InstructionType.StoreSeparator) and (kind < InstructionType.ArithmeticSeparator)
		if (register is in reuse.Reads(steps(value))) and (kind is not InstructionType.CheckError)
			return isArithmetic or (kind is in MlirEquality.Comparisons) or IsAccessor(steps(value), register)
	true
