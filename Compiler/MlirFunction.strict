has types List(TypeEntry)
has type TypeEntry
has method MethodEntry
has lineSlots Numbers = List(Number)
has FastLoop Number = -1
has Packing Text = ""
has Float Text = "f64"
has Group Number = -1
has IsRecursive Boolean = true
constant Counter = MlirFunction(List(TypeEntry), TypeEntry("Strict/Counter", List(MemberEntry), List(MethodEntry)), MethodEntry.CountingLoop)
constant Shape = TypeEntry("Strict/Shape", (MemberEntry("width", "Strict/Number", List(InstructionEntry), false), MemberEntry.LoggerMember), List(MethodEntry))
constant Named = TypeEntry("Strict/Named", (MemberEntry("name", "Strict/Text", List(InstructionEntry), false), MemberEntry.LoggerMember), List(MethodEntry))
constant Adding = MlirFunction(List(TypeEntry), Shape, MethodEntry("+", List(MemberEntry), "None", List(InstructionEntry)))
constant ListKinds = (InstructionType.IndexCall, InstructionType.InvokeWriteToList, InstructionType.CopyList, InstructionType.InvokeRemove)
constant NamedKinds = (InstructionType.LoadVariableToRegister, InstructionType.StoreRegisterToVariable, InstructionType.InvokeWriteToList, InstructionType.IndexCall)
IsCounted = lineSlots.Length > 0
Symbol Text
	Counter.Symbol is "Counter_Run_0"
	Adding.Symbol is "Shape_Plus_0"
	MlirFunction(Adding, method = MethodEntry(Adding.method, Name = "<")).Symbol is "Shape_Less_0"
	if MlirForeign(value).IsForeign
		return MlirForeign(value).Wrapper
	let name = MlirEquality(value, 0).Symbol(type.JustName)
	let conversion = method.Name is "to" then "_" + TypeEntry.ShortName(method.returnType) else ""
	constant operatorNames = ("+", "-", "*", "/", "%", "^", "<", ">", "<=", ">=")
	constant operatorWords = ("Plus", "Minus", "Times", "Divide", "Modulo", "Power", "Less", "More", "AtMost", "AtLeast")
	let plain = MlirEquality(value, 0).Symbol(method.Name)
	let spelled = method.Name is in operatorNames then operatorWords(operatorNames.Index(method.Name)) else plain
	name + "_" + spelled + "_" + method.parameters.Length + conversion + type.OverloadSuffix(method)
Parameters Texts
	Counter.Parameters is ("value")
	mutable names = List(Mutable(Text))
	names.Add("value")
	for method.parameters
		names.Add(value.Name)
	names
VariableNames Texts
	Counter.VariableNames is ("index", "value")
	mutable names = ("index", "value")
	for Parameters + MlirInstances(value, 0).StoredNames(type)
		names = value is in names then names else names + value
	for method.instructions
		if (value.kind is in NamedKinds) and value.texts(0).IndexOf("(") < 0
			names = value.texts(0) is in names then names else names + value.texts(0)
		if value.kind is InstructionType.StoreConstantToVariable
			names = value.texts.Last is in names then names else names + value.texts.Last
	names
TypeOf(name Text) TypeEntry
	Counter.TypeOf("Strict/Other").members.Length is 0
	Natives(types).TypeOf(name)
Load(target Text, slot Text) Text
	Counter.Load("%a", "%r0") is "    %a = llvm.load %r0 : !llvm.ptr -> f64"
	MlirFunction(Counter, Float = "f32").Load("%a", "%r0") is "    %a = llvm.load %r0 : !llvm.ptr -> f32"
	"    " + target + " = llvm.load " + slot + " : !llvm.ptr -> " + Float
Store(stored Text, slot Text) Text
	Counter.Store("%a", "%r0") is "    llvm.store %a, %r0 : f64, !llvm.ptr"
	MlirFunction(Counter, Float = "f32").Store("%a", "%r0").EndsWith("llvm.store %a_r0q, %r0q : i64, !llvm.ptr")
	let line = "    llvm.store " + stored + ", " + slot + " : " + Float + ", !llvm.ptr"
	let isNumber = slot.StartsWith("%r") or slot.StartsWith("%v_")
	let exact = MlirExact(value, 0).Converted(stored, Float, slot)
	isNumber and (exact.Length > 0) then outer.Text.Combine((List(Text) + line) + exact, "\n") else line
Copied(source Text, destination Text, temp Text) Texts
	Counter.Copied("%r0", "%v_a", "%t1").Length is 2
	(Load(temp, source), Store(temp, destination))
Text Text
	Counter.Text.StartsWith("  func.func private @Counter_Run_0(%p0: f64) -> f64 {")
	MlirAttention.Attending.function.Text.IndexOf(MlirAttention.Marker) > 0
	if MlirForeign(value).IsForeign
		return outer.Text.Combine(MlirForeign(value).Declaration, "\n")
	mutable signature = List(Mutable(Text))
	for Parameters
		signature.Add("%p" + index + ": f64")
	let header = "  func.func private @" + Symbol + "(" + outer.Text.Combine(signature, ", ") + ") -> f64 {"
	let outlined = MlirParallel(value, 0).Outlined + MlirCached(value).Wrapper
	outer.Text.Combine(List(Text) + header + Slots + MlirAttention(value).Prologue + Body + "  }" + outlined, "\n")
Slots Texts
	Counter.Slots.Length is 15
	outer.Text.Combine(MlirGroups.Norming.function.Slots).IndexOf("%memo11 = llvm.alloca") > 0
	mutable lines = ("    %one = arith.constant 1 : i64", "    %zero = arith.constant 0.0 : f64")
	lines = lines + "    %flag = llvm.alloca %one x i1 : (i64) -> !llvm.ptr"
	for LoadReuse(method.instructions).RegisterCount
		lines = lines + Slot("%r" + index)
	for VariableNames
		lines = lines + Slot("%v_" + value)
	for method.instructions
		lines = value.kind is InstructionType.LoopBegin then lines + Slot("%loop" + index) else lines
	lines + MlirGrouped(value, 0).Memos + MlirLines(value).Allocated + Entry
Entry Texts
	Counter.Entry.Length is 4
	"  ^stackChecked:" is in MlirGroups.Norming.function.Entry
	"  ^tailed:" is in MlirTails.Sample.function.Entry
	"    %self = llvm.load %instance : !llvm.ptr -> f64" is in MlirInstances.Looping.Entry
	let checked = IsRecursive and (method.Invoked.Length > 0) then MlirRecursion.StackChecked else List(Text)
	mutable lines = Slot("%instance") + Store("%p0", "%instance") + checked
	for Parameters
		lines = lines + Store("%p" + index, "%v_" + value)
	lines = lines + MlirDestined(value, 0).Prologue + MlirTails(value, 0).Restart
	lines + MlirParameters(value).Hoisted + MlirInstances(value, 0).Unpacked + MlirInstances(value, 0).Constants
Slot(name Text) Texts
	Counter.Slot("%r0").Length is 2
	("    " + name + " = llvm.alloca %one x f64 : (i64) -> !llvm.ptr", Store("%zero", name))
Body Texts
	Counter.Body.Last is "    return %zero : f64"
	MlirLines.Lined.Body.Length > MlirLines.Unlined.Body.Length
	outer.Text.Combine(MlirPacking.Listing.function.Body).IndexOf("@strict_two_list(") > 0
	let counter = MlirLines(value)
	mutable lines = List(Mutable(Text))
	for method.instructions
		lines = lines + Label(index) + counter.At(index, "%line") + Emitted(index)
	let isReturning = method.instructions.Length > 0 and (method.instructions.Last.kind is InstructionType.Return)
	isReturning then lines else lines + counter.End + MlirLayout(value).Returned(-2)
Label(position Number) Texts
	Counter.Label(0).Length is 0
	constant terminators = (InstructionType.Return, InstructionType.JumpToIdIfFalse, InstructionType.JumpToIdIfTrue)
	if position is 0
		return List(Text)
	let previous = method.instructions(position - 1).kind
	let afterTerminator = (previous is in terminators) or (previous is InstructionType.CheckError)
	if method.instructions(position).kind is not InstructionType.JumpEnd and (afterTerminator is false)
		return List(Text)
	let label = "  ^bb" + position + ":"
	afterTerminator then List(Text) + label else ("    cf.br ^bb" + position, label)
Emitted(position Number) Texts
	Counter.Emitted(0).Length is 18
	let kind = method.instructions(position).kind
	if kind is in (InstructionType.LoopBegin, InstructionType.LoopEnd)
		return kind is InstructionType.LoopBegin then MlirLoops(value, position).Begin else MlirLoops(value, position).End
	let statements = MlirStatements(value, position)
	if kind > InstructionType.StoreSeparator and kind < InstructionType.BinaryOperatorsSeparator
		return statements.Binary(method.instructions(position))
	let isCall = kind is in (InstructionType.Invoke, InstructionType.Print, InstructionType.FieldLoad)
	let lists = MlirLists(value, position)
	let isList = (kind is in ListKinds) or lists.IsElementStore
	let emitted = isCall then MlirCalls(value, position).Emitted else isList then lists.Emitted else statements.Emitted
	emitted + MlirPacking(value, position).Repacked