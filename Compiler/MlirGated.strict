has function MlirFunction
has position Number
constant Gated = MethodEntry("Gated", MlirTokens.Batched.parameters, "Strict/List(Number)", MlirTokens.Batched.instructions.Slice(0, 16) + (InstructionEntry.Named(InstructionType.StoreRegisterToVariable, 13, "gate"), InstructionEntry.Named(InstructionType.LoadVariableToRegister, 14, "gate"), InstructionEntry.LoadNumber(15, 1), InstructionEntry.LoadNumber(16, 0), InstructionEntry.Named(InstructionType.LoadVariableToRegister, 17, "gate"), InstructionEntry.Binary(InstructionType.Subtract, (16, 17, 18)), InstructionEntry.Invoke(19, ("Strict/Number", "Exponential", "Strict/Number"), List(Number), 18), InstructionEntry.Binary(InstructionType.Add, (15, 19, 20)), InstructionEntry.Binary(InstructionType.Divide, (14, 20, 21)), InstructionEntry.Named(InstructionType.LoadVariableToRegister, 22, "index"), InstructionEntry.Named(InstructionType.LoadVariableToRegister, 23, "rows"), InstructionEntry.Binary(InstructionType.Modulo, (22, 23, 24)), InstructionEntry.Binary(InstructionType.Add, (24, 23, 25)), InstructionEntry(InstructionType.IndexCall, "weights", (26, 25, -1)), InstructionEntry.LoadNumber(27, 0), InstructionEntry.Named(InstructionType.LoadVariableToRegister, 28, "input"), InstructionEntry.Named(InstructionType.LoadVariableToRegister, 29, "index"), InstructionEntry.Named(InstructionType.LoadVariableToRegister, 30, "rows"), InstructionEntry.Binary(InstructionType.Divide, (29, 30, 31)), InstructionEntry.Invoke(32, ("Strict/Number", "Floor", "Strict/Number"), List(Number), 31), InstructionEntry.Named(InstructionType.LoadVariableToRegister, 33, "width"), InstructionEntry.Binary(InstructionType.Multiply, (32, 33, 34)), InstructionEntry.Invoke(35, ("Strict/Tokens", "Dot", "Strict/Number", "row", "first", "input", "start"), (26, 27, 28, 34), -1), InstructionEntry.Binary(InstructionType.Multiply, (21, 35, 36)), InstructionEntry.Named(InstructionType.InvokeWriteToList, 36, "forResult"), InstructionEntry.Jump(InstructionType.LoopEnd, 39), InstructionEntry.Named(InstructionType.Load