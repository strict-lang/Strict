has functions List(MlirFunction)
constant Counted = MlirGlobals(MlirModule.Counters.Functions)
Lines Texts
	Counted.Lines.Length is 1
	mutable lines = List(Mutable(Text))
	for functions
		lines = lines + Function(value)
	lines + MlirDefaults(functions.First).Globals
Function(function MlirFunction) Texts
	Counted.Function(MlirCalls.Shapes).Length is 3
	Counted.Function(MlirCalls.Shapes).First.IndexOf("(\"Shape.Run\\00Shape.strict\\00\")") > 0 is true
	let location = function.type.Location(function.method.Name)
	let content = location.Replace(" in ", "\\00") + "\\00\")"
	let where = "  llvm.mlir.global internal constant @w" + function.Symbol + "(\"" + content
	mutable lines = List(Text) + (where + " : !llvm.array<" + (location.Length - 2) + " x i8>")
	for Positions(function)
		if IsGlobal(function, value)
			lines = lines + Global(function, value)
	lines + MlirGpu(function, 0).Globals
Positions(function MlirFunction) Numbers
	Counted.Positions(MlirCalls.Shapes).Length is 4
	mutable positions = List(Mutable(Number))
	for function.method.instructions.Length
		positions.Add(index)
	for MlirInstances(function, 0).ReferencedConstants
		positions.Add(MlirInstances.MemberBase + index)
	positions
IsGlobal(function MlirFunction, position Number) Boolean
	Counted.IsGlobal(MlirCalls.Shapes, 3) is true
	let isInstruction = position < function.method.instructions.Length
	let kind = isInstruction then function.method.instructions(position).kind else -1
	if kind is in (InstructionType.Print, InstructionType.IndexCall)
		return true
	MlirConstants(function, position).IsConstant
Global(function MlirFunction, position Number) Text
	Counted.Global(MlirCalls.Shapes, 3).IndexOf("Hi %s\\0A\\00") > 0 is true
	Counted.Global(MlirCalls.Shapes, 1) is "  llvm.mlir.global internal @lShape_Run_0_1(0.0 : f64) : f64"
	let constants = MlirConstants(function, position)
	if position >= function.method.instructions.Length
		return constants.Global
	let entry = function.method.instructions(position)
	if entry.kind is InstructionType.IndexCall
		return NameGlobal(function, position)
	if entry.kind is InstructionType.Invoke
		return "  llvm.mlir.global internal " + constants.Cache + "(0.0 : f64) : f64"
	entry.kind is InstructionType.Print then PrintGlobal(function, position, entry) else constants.Global
NameGlobal(function MlirFunction, position Number) Text
	Counted.NameGlobal(Counted.functions.First, 0).IndexOf("Run\\00") > 0 is true
	Counted.NameGlobal(Counted.functions.First, 0).IndexOf("\\00Counter.Run\\00Counter.strict\\000\\00") > 0 is true
	let name = function.method.Name
	let location = function.type.Location(name)
	let line = function.method.instructions(position).line to Text
	let content = name + "\\00" + location.Replace(" in ", "\\00") + "\\00" + line + "\\00"
	let global = "  llvm.mlir.global internal constant @s" + function.Symbol + "_" + position
	global + "(\"" + content + "\") : !llvm.array<" + (name.Length + location.Length + line.Length) + " x i8>"
PrintGlobal(function MlirFunction, position Number, entry InstructionEntry) Text
	Counted.PrintGlobal(MlirCalls.Shapes, 3, MlirCalls.Shapes.method.instructions(3)).StartsWith("  llvm") is true
	let constants = MlirConstants(function, position)
	let hasValue = entry.payload(1) is 1
	let format = hasValue then "%s" else ""
	let content = constants.Escaped(entry.texts(0), true) + format + "\\0A\\00"
	let length = constants.EscapedLength(entry.texts(0), true) + (hasValue then 4 else 2)
	let name = "@s" + function.Symbol + "_" + position
	"  llvm.mlir.global internal constant " + name + "(\"" + content + "\") : !llvm.array<" + length + " x i8>"