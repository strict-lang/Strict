has functions List(MlirFunction)
constant Counted = MlirGlobals(MlirModule.Counters.Functions)
constant Foreign = MlirGlobals(List(MlirFunction) + MlirForeign.Adder)
constant Filling = ("  func.func private @strict_places_fill() -> i64 {", "    %table = llvm.mlir.addressof @strict_places : !llvm.ptr")
constant Returning = ("    return %count : i64", "  }")
constant ShapeFunction = ("    %f2 = func.constant @Shape_Run_0 : (f64) -> f64", "    %c2 = builtin.unrealized_conversion_cast %f2 : (f64) -> f64 to !llvm.ptr")
constant ShapeStored = ("    %s2 = llvm.getelementptr %table[4] : (!llvm.ptr) -> !llvm.ptr, i64", "    llvm.store %c2, %s2 : !llvm.ptr, !llvm.ptr")
constant ShapeNamed = ("    %w2 = llvm.mlir.addressof @wShape_Run_0 : !llvm.ptr", "    %n2 = llvm.getelementptr %s2[1] : (!llvm.ptr) -> !llvm.ptr, i64", "    llvm.store %w2, %n2 : !llvm.ptr, !llvm.ptr")
constant Table = "  llvm.mlir.global internal @strict_places(dense<0> : tensor<"
Lines Texts
	Counted.Lines.Length is 14
	mutable lines = List(Mutable(Text))
	for functions
		lines = lines + Function(value)
	lines + MlirDefaults(functions.First).Globals + MlirChanged.Declarations(functions) + Places
Places Texts
	(Counted.Places.First is Table + "2xi64>) : !llvm.array<2 x i64>") and Foreign.Places.Length is 6
	(Counted.Places(1) is Filling.First) and Counted.Places(3).StartsWith("    %f0 = func.constant @")
	(Counted.Places.Last is "  }") and Counted.Places(Counted.Places.Length - 3).EndsWith(" 1 : i64")
	mutable fills = List(Mutable(Text))
	mutable count = 0
	for functions
		if MlirForeign(value).IsForeign is false
			fills = fills + Place(value, count)
			count = count + 1
	let size = (count, 1).Maximum * 2
	let table = Table + size + "xi64>) : !llvm.array<" + size + " x i64>"
	(List(Text) + table) + Filling + fills + ("    %count = arith.constant " + count + " : i64") + Returning
Place(function MlirFunction, at Number) Texts
	Counted.Place(MlirCalls.Shapes, 2) is ShapeFunction + ShapeStored + ShapeNamed
	Foreign.Place(MlirForeign.Adder, 0)(0).EndsWith("f64, f64) -> f64")
	let signature = "(" + outer.Text.Combine(Types(function), ", ") + ") -> f64"
	let pointer = "    %c" + at + " = builtin.unrealized_conversion_cast %f" + at + " : " + signature + " to !llvm.ptr"
	let slot = "    %s" + at + " = llvm.getelementptr %table[" + at * 2 + "] : (!llvm.ptr) -> !llvm.ptr, i64"
	let named = "    %n" + at + " = llvm.getelementptr %s" + at + "[1] : (!llvm.ptr) -> !llvm.ptr, i64"
	let where = "    %w" + at + " = llvm.mlir.addressof @w" + function.Symbol + " : !llvm.ptr"
	let called = "    %f" + at + " = func.constant @" + function.Symbol + " : " + signature
	let stores = ("    llvm.store %c" + at + ", %s" + at + " : !llvm.ptr, !llvm.ptr", where, named)
	(called, pointer, slot) + stores + ("    llvm.store %w" + at + ", %n" + at + " : !llvm.ptr, !llvm.ptr")
Types(function MlirFunction) Texts
	Counted.Types(MlirCalls.Shapes).First is "f64"
	for function.Parameters
		"f64"
Function(function MlirFunction) Texts
	Counted.Function(MlirCalls.Shapes).Length is 3
	Counted.Function(MlirCalls.Shapes).First.IndexOf("(\"Shape.Run\\00Shape.strict\\00\")") > 0
	let location = TypeSource(function.type).Location(function.method.Name)
	let content = location.Replace(" in ", "\\00") + "\\00\")"
	let where = "  llvm.mlir.global internal constant @w" + function.Symbol + "(\"" + content
	mutable lines = List(Text) + (where + " : !llvm.array<" + (location.Length - 2) + " x i8>")
	for Positions(function)
		if IsGlobal(function, value)
			lines = lines + Global(function, value)
	lines + MlirGpu(function, 0).Globals
Positions(function MlirFunction) Numbers
	Counted.Positions(MlirCalls.Shapes).Length is 4
	mutable positions = List(Mutable(Number))
	for function.method.instructions.Length
		positions.Add(index)
	for MlirInstances(function, 0).ReferencedConstants
		positions.Add(MlirInstances.MemberBase + index)
	positions
IsGlobal(function MlirFunction, position Number) Boolean
	Counted.IsGlobal(MlirCalls.Shapes, 3)
	let isInstruction = position < function.method.instructions.Length
	let kind = isInstruction then function.method.instructions(position).kind else -1
	if kind is in (InstructionType.Print, InstructionType.IndexCall)
		return true
	MlirConstants(function, position).IsConstant
Global(function MlirFunction, position Number) Text
	Counted.Global(MlirCalls.Shapes, 3).IndexOf("Hi %s\\0A\\00") > 0
	Counted.Global(MlirCalls.Shapes, 1) is "  llvm.mlir.global internal @lShape_Run_0_1(0.0 : f64) : f64"
	let constants = MlirConstants(function, position)
	if position >= function.method.instructions.Length
		return constants.Global
	let entry = function.method.instructions(position)
	if entry.kind is InstructionType.IndexCall
		return NameGlobal(function, position)
	if entry.kind is InstructionType.Invoke
		return "  llvm.mlir.global internal " + constants.Cache + "(0.0 : f64) : f64"
	entry.kind is InstructionType.Print then PrintGlobal(function, position, entry) else constants.Global
NameGlobal(function MlirFunction, position Number) Text
	Counted.NameGlobal(Counted.functions.First, 0).IndexOf("Run\\00") > 0
	Counted.NameGlobal(Counted.functions.First, 0).IndexOf("\\00Counter.Run\\00Counter.strict\\000\\00") > 0
	let name = function.method.Name
	let location = TypeSource(function.type).Location(name)
	let line = function.method.instructions(position).line to Text
	let content = name + "\\00" + location.Replace(" in ", "\\00") + "\\00" + line + "\\00"
	let global = "  llvm.mlir.global internal constant @s" + function.Symbol + "_" + position
	global + "(\"" + content + "\") : !llvm.array<" + (name.Length + location.Length + line.Length) + " x i8>"
PrintGlobal(function MlirFunction, position Number, entry InstructionEntry) Text
	Counted.PrintGlobal(MlirCalls.Shapes, 3, MlirCalls.Shapes.method.instructions(3)).StartsWith("  llvm")
	let constants = MlirConstants(function, position)
	let hasValue = entry.payload(1) is 1
	let format = hasValue then "%s" else ""
	let content = constants.Escaped(entry.texts(0), true) + format + "\\0A\\00"
	let length = constants.EscapedLength(entry.texts(0), true) + (hasValue then 4 else 2)
	let name = "@s" + function.Symbol + "_" + position
	"  llvm.mlir.global internal constant " + name + "(\"" + content + "\") : !llvm.array<" + length + " x i8>"