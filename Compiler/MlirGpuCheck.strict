has function MlirFunction
has position Number
constant Doubling = MlirGpuCheck(MlirGpu.Doubling.function, 2)
constant Randomizing = MlirGpuCheck(MlirGpu.Randomizing.function, 2)
constant Layering = MlirGpuCheck(MlirGpu.Layering.function, 2)
constant Summed = MlirDeviceStatements.Summed
constant Absolute = MlirFunction(List(TypeEntry) + GpuSamples.Numbered, GpuSamples.Numbered, GpuSamples.Absolute)
constant Powered = MlirFunction(List(TypeEntry) + GpuSamples.Numbered, GpuSamples.Numbered, GpuSamples.Powered)
constant Floored = MlirFunction(Powered.types, Powered.type, GpuSamples.Floored)
constant Flooring = Floored.method.instructions(1)
constant Moves = (InstructionType.LoadConstantToRegister, InstructionType.LoadVariableToRegister, InstructionType.StoreConstantToVariable, InstructionType.StoreRegisterToVariable)
constant Controls = (InstructionType.JumpToIdIfFalse, InstructionType.JumpToIdIfTrue, InstructionType.JumpEnd, InstructionType.LoopEnd, InstructionType.CheckError)
constant Values = ("Number", "Boolean")
constant Heading = MlirGpuCheck(MlirFunction(List(TypeEntry) + GpuSamples.Headed, GpuSamples.Headed, GpuSamples.Heading), 2)
constant Rows = ("", "List(Number)", "List(Numbers)", "List(List(Number))")
IsGpu Boolean
	Doubling.IsGpu
	Heading.IsGpu
	Randomizing.IsGpu is false
	MlirGpuCheck(MlirGpu.Checking.function, 2).IsGpu
	Layering.IsGpu
	MlirGpuCheck(MlirKernel.Doubler, 2).IsGpu
	MlirGpuCheck(MlirDeviceRows.Picking, 2).IsGpu
	MlirGpuCheck(MlirLoops.Ranging.function, 3).IsGpu
	let isListed = (MlirLoops(function, position).Collection is in Rows) or MlirWholeKernel(function, position).IsKernel
	if (isListed is false) or (IsPure is false) or MlirLanes(function, position).IsTouched
		return MlirWholeKernel(function, position).IsKernel
	IsDeviceBody or MlirWholeKernel(function, position).IsKernel
IsPure Boolean
	Doubling.IsPure
	MlirGpuCheck(MlirKernel.Doubler, 2).IsPure
	Randomizing.IsPure is false
	let isSimple = MlirKernel(function, position).IsSimple and MlirLoops(function, position).IsCollecting
	isSimple or MlirParallel(function, position).IsParallel
IsDeviceBody Boolean
	Doubling.IsDeviceBody
	Randomizing.IsDeviceBody is false
	MlirGpuCheck(GpuSamples.Gathering, 2).IsDeviceBody is false
	for Range(position + 1, function.method.LoopEndOf(position))
		if IsDevice(function, value, 0) is false
			return false
	true
IsDevice(inspected MlirFunction, at Number, depth Number) Boolean
	Doubling.IsDevice(Doubling.function, 4, 0)
	Randomizing.IsDevice(Randomizing.function, 4, 0) is false
	let entry = inspected.method.instructions(at)
	if entry.kind is in Moves
		return IsValued(inspected, at, depth)
	if entry.kind is InstructionType.IndexCall
		return IsList(inspected, at, entry.texts(0))
	if entry.kind is InstructionType.Invoke
		return IsCall(inspected, at, depth)
	if entry.kind < InstructionType.BinaryOperatorsSeparator
		return IsArithmetic(inspected, at)
	IsControl(inspected, at, depth)
IsValued(inspected MlirFunction, at Number, depth Number) Boolean
	Doubling.IsValued(Doubling.function, 3, 0)
	Layering.IsValued(Layering.function, 4, 0)
	let entry = inspected.method.instructions(at)
	if entry.kind is InstructionType.LoadConstantToRegister
		return IsNumbered(inspected, PayloadDecoder(entry).Value(1).kind)
	if entry.kind is InstructionType.StoreConstantToVariable
		return IsNumbered(inspected, PayloadDecoder(entry).Value(0).kind)
	let name = entry.texts(0)
	let isValue = IsNumbered(inspected, MlirKinds(inspected).VariableKind(at, name)) or IsList(inspected, at, name)
	let isFree = (depth is 0) and (name is not "forResult")
	isValue and ((entry.kind is InstructionType.StoreRegisterToVariable) or isFree or IsKnown(inspected, at, name, depth))
IsNumbered(inspected MlirFunction, kind Text) Boolean
	Doubling.IsNumbered(MlirLayout.Wrapping.function, "Angle")
	Doubling.IsNumbered(MlirLayout.Wrapping.function, "Text") is false
	MlirLayout(inspected).Represented(kind) is in Values
IsList(inspected MlirFunction, at Number, name Text) Boolean
	Layering.IsList(Layering.function, 8, "biases")
	Doubling.IsList(Doubling.function, 3, "value") is false
	let kind = MlirKinds(inspected).VariableKind(at, name)
	MlirDeviceStatements(inspected, at).IsList(kind) or MlirDeviceRows(inspected, at).IsRows(kind)
IsControl(inspected MlirFunction, at Number, depth Number) Boolean
	Doubling.IsControl(Doubling.function, 5, 0)
	Layering.IsControl(Summed, 2, 1)
	Doubling.IsControl(MlirPurity.Clamping.function, 6, 0)
	Doubling.IsControl(MlirPurity.Filtering.function, 7, 0) is false
	let entry = inspected.method.instructions(at)
	if entry.kind is InstructionType.InvokeWriteToList
		let isNumber = IsNumbered(inspected, MlirKinds(inspected).KindOf(at, entry.payload(0)))
		return (depth is 0) and isNumber and MlirPurity(inspected, position).IsCollected(at)
	if entry.kind is InstructionType.LoopBegin
		return IsInnerLoop(inspected, at)
	entry.kind is InstructionType.Return then depth > 0 else entry.kind is in Controls
IsInnerLoop(inspected MlirFunction, at Number) Boolean
	Layering.IsInnerLoop(Summed, 2)
	Layering.IsInnerLoop(Layering.function, 2) is false
	let loops = MlirLoops(inspected, at)
	let isPlain = (loops.Collection is "") or (loops.Collection is "List(Number)")
	isPlain and (loops.IsCollecting is false) and (inspected.method.instructions(at).payload(1) is not 1)
IsArithmetic(inspected MlirFunction, at Number) Boolean
	Doubling.IsArithmetic(MlirDevice.Twice.function, 2)
	Doubling.IsArithmetic(Powered, 2)
	let entry = inspected.method.instructions(at)
	let isCalculated = (entry.kind > InstructionType.StoreSeparator) and (entry.kind < InstructionType.ArithmeticSeparator)
	let isOperator = isCalculated or (entry.kind > InstructionType.ArithmeticSeparator)
	let kinds = MlirKinds(inspected)
	let isLeft = IsNumbered(inspected, kinds.KindOf(at, entry.payload(1)))
	isOperator and isLeft and IsNumbered(inspected, kinds.KindOf(at, entry.payload(2)))
IsKnown(inspected MlirFunction, at Number, name Text, depth Number) Boolean
	Doubling.IsKnown(Doubling.function, 3, "value", 0)
	Doubling.IsKnown(Doubling.function, 3, "numbers", 0) is false
	Layering.IsKnown(Summed, 3, "sum", 1)
	let first = depth is 0 then position + 1 else 0
	let given = depth is 0 then ("value", "index") else inspected.Parameters + "index"
	for Range(first, at)
		let earlier = inspected.method.instructions(value)
		let isStore = earlier.kind is in (InstructionType.StoreRegisterToVariable, InstructionType.StoreConstantToVariable)
		if isStore and (earlier.texts.Last is name)
			return true
	(name is in given) or ((depth > 0) and MlirDeviceMembers(inspected).IsMember(at, name))
IsCall(inspected MlirFunction, at Number, depth Number) Boolean
	Layering.IsCall(Layering.function, 5, 0)
	Layering.IsCall(Floored, 1, 0)
	Layering.IsCall(MlirDeviceRows.Measuring, 1, 1)
	let entry = inspected.method.instructions(at)
	let instance = Instance(inspected, at)
	if entry.texts(1) is "Length"
		return MlirDeviceStatements(inspected, at).IsList(instance)
	let callees = MlirDeviceMembers(inspected).Passable(at)
	let fits = (callees.Length is 1) and (callees.First.method.parameters.Length is entry.payload(5 + entry.payload(3)))
	let isMade = (entry.texts(1) is "from") and IsNumbered(inspected, TypeEntry.ShortName(entry.texts(0)))
	let isNative = (entry.texts(1) is in ("Floor", "Logarithm")) or isMade
	IsNumbered(inspected, instance) and (depth < 3) and (isNative or (fits and IsDeviceMethod(callees, depth + 1)))
Instance(inspected MlirFunction, at Number) Text
	Layering.Instance(Floored, 1) is "Number"
	let register = MlirDeviceCalls(inspected, at, inspected).Register(inspected.method.instructions(at))
	register < 0 then "Number" else MlirKinds(inspected).KindOf(at, register)
IsDeviceMethod(callees List(MlirFunction), depth Number) Boolean
	Doubling.IsDeviceMethod(List(MlirFunction) + MlirDevice.Twice.function, 1)
	Layering.IsDeviceMethod(List(MlirFunction) + Summed, 1)
	Layering.IsDeviceMethod(List(MlirFunction) + Absolute, 1)
	if (callees.Length is not 1) or (callees.First.method.instructions.Length is 0)
		return false
	let callee = callees.First
	if callee.method.instructions.Last.kind is not InstructionType.Return
		return false
	for callee.method.instructions
		if IsDevice(callee, index, depth) is false
			return false
	true
Free Texts
	Doubling.Free.Length is 0
	Heading.Free is ("heads", "weights")
	Layering.Free is ("input", "biases")
	let kernel = MlirWholeKernel(function, position)
	mutable names = List(Mutable(Text))
	for Range(position + 1, function.method.LoopEndOf(position))
		let entry = function.method.instructions(value)
		let isRead = entry.kind is in (InstructionType.LoadVariableToRegister, InstructionType.IndexCall)
		if isRead and (entry.texts(0) is not in names) and (IsKnown(function, value, entry.texts(0), 0) is false)
			names.Add(entry.texts(0))
	let called = MlirDeviceMembers(function).Calling(position + 1, function.method.LoopEndOf(position), names)
	kernel.IsKernel then kernel.Free else names + called