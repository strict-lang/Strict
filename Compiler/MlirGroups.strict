has function MlirFunction
has position Number
constant NormedLoop = (MlirLoops.Emptied, InstructionEntry.Named(InstructionType.LoadVariableToRegister, 0, "count"), InstructionEntry.LoopBegin(0, -1), InstructionEntry.Named(InstructionType.LoadVariableToRegister, 1, "input"))
constant GroupDivided = (InstructionEntry.Named(InstructionType.LoadVariableToRegister, 2, "index"), InstructionEntry.Named(InstructionType.LoadVariableToRegister, 3, "size"), InstructionEntry.Binary(InstructionType.Divide, (2, 3, 4)))
constant GroupFloored = (InstructionEntry.Invoke(5, ("Strict/Number", "Floor", "Strict/Number"), List(Number), 4), InstructionEntry.Named(InstructionType.LoadVariableToRegister, 6, "size"))
constant SquaredArguments = (InstructionEntry.Binary(InstructionType.Multiply, (5, 6, 7)), InstructionEntry.Named(InstructionType.LoadVariableToRegister, 8, "size"))
constant SquaredCall = (InstructionEntry.Invoke(9, ("Strict/Grouped", "Squared", "Strict/Number", "input", "start", "size"), (1, 7, 8), -1), InstructionEntry(InstructionType.CheckError, List(Text), List(Number) + 9))
constant NormedWritten = (InstructionEntry.Named(InstructionType.InvokeWriteToList, 9, "forResult"), InstructionEntry.Jump(InstructionType.LoopEnd, 12))
constant ResultReturned = (InstructionEntry.Named(InstructionType.LoadVariableToRegister, 0, "forResult"), InstructionEntry.Return(0))
constant NormedMembers = (MemberEntry("input", "Strict/List(Number)", List(InstructionEntry), false), MemberEntry("size", "Strict/Number", List(InstructionEntry), false), MemberEntry("count", "Strict/Number", List(InstructionEntry), false))
constant Normed = MethodEntry("Normed", NormedMembers, "Strict/List(Number)", NormedLoop + GroupDivided + GroupFloored + SquaredArguments + SquaredCall + NormedWritten + ResultReturned)
constant ScaledLoads = (InstructionEntry.Named(InstructionType.LoadVariableToRegister, 0, "input"), InstructionEntry.Named(InstructionType.LoadVariableToRegister, 1, "start"))
constant ScaledSquared = (InstructionEntry.Named(InstructionType.LoadVariableToRegister, 2, "size"), InstructionEntry.Invoke(3, ("Strict/Grouped", "Squared", "Strict/Number", "input", "start", "size"), (0, 1, 2), -1))
constant ScaledDoubled = (InstructionEntry.LoadNumber(4, 2), InstructionEntry.Binary(InstructionType.Multiply, (3, 4, 5)), InstructionEntry.Return(5))
constant Scaled = MethodEntry("Scaled", GpuNumberSamples.Squared.parameters, "Strict/Number", ScaledLoads + ScaledSquared + ScaledDoubled)
constant Grouped = TypeEntry("Strict/Grouped", List(MemberEntry), (Normed, GpuNumberSamples.Squared, Scaled))
constant Norming = MlirGroups(MlirFunction(List(TypeEntry) + Grouped, Grouped, Normed), 2)
constant ScaledCall = InstructionEntry.Invoke(9, ("Strict/Grouped", "Scaled", "Strict/Number", "input", "start", "size"), (1, 7, 8), -1)
constant Wrapping = MlirGroups(MlirFunction(Norming.function, method = MethodEntry(Normed, instructions = Normed.instructions.Slice(0, 11) + ScaledCall + Normed.instructions.Slice(12, 5))), 2)
constant WithinStored = (InstructionEntry.Binary(InstructionType.Modulo, (2, 3, 4)), InstructionEntry.Named(InstructionType.StoreRegisterToVariable, 4, "within"))
constant WithinSubtracted = (InstructionEntry.Named(InstructionType.LoadVariableToRegister, 6, "within"), InstructionEntry.Binary(InstructionType.Subtract, (2, 6, 7)))
constant AlignedCode = Normed.instructions.Slice(0, 6) + WithinStored + WithinSubtracted + Normed.instructions.Slice(10, 7)
constant Aligning = MlirGroups(MlirFunction(Norming.function, method = MethodEntry(Normed, instructions = AlignedCode)), 2)
constant Ranging = MlirGroups(MlirFunction(Aligning.function, method = MethodEntry(Normed, instructions = AlignedCode.Slice(0, 2) + InstructionEntry.LoopBegin(0, 1) + AlignedCode.Slice(3, 14))), 2)
constant NormedCall = InstructionEntry.Invoke(3, ("Strict/Grouped", "Normed", "Strict/List(Number)", "input", "size", "count"), (0, 1, 2), -1)
constant Delegated = MethodEntry(Scaled, instructions = Scaled.instructions.Slice(0, 3) + NormedCall + Scaled.instructions.Slice(4, 3))
constant Unsized = InstructionEntry.Invoke(10, SquaredCall(0).texts, (1, 8, 8), -1)
constant Twice = MlirGroups(MlirFunction(Norming.function, method = MethodEntry(Normed, instructions = Normed.instructions.Slice(0, 11) + Unsized + Normed.instructions.Slice(11, 6))), 2)
Call Number
	Norming.Call is 11 and Twice.Call is -1
	MlirGroups(MlirGpu.Layering.function, 2).Call is -1
	if MlirLoops(function, position).Collection is not ""
		return -1
	mutable found = -1
	for Range(position + 1, function.method.LoopEndOf(position))
		let adding = Adding(value)
		if (function.method.instructions(value).kind is InstructionType.LoopBegin) or (adding < 0)
			return -1
		if adding > 0
			found = (found is not -1) or (Size(value) is "") then -2 else value
	found < 0 then -1 else found
Adding(at Number) Number
	Norming.Adding(11) is 1
	Norming.Adding(7) is 0
	Wrapping.Adding(11) is 1
	let callees = MlirModule(function.types, "").Called(function, at)
	if callees.Length is not 1
		return 0
	let callee = callees.First
	for callee.method.instructions
		if (value.kind is InstructionType.LoopBegin) and MlirDeviceChoice(callee, index).IsChoice
			return -1
	let summed = MlirDeviceSums(callee, 0).IsSummed(callee, 0, callee.method.instructions.Length, false)
	summed then 1 else Wraps(callee) then 1 else 0
Wraps(callee MlirFunction) Boolean
	Norming.Wraps(MlirFunction(Norming.function, method = Delegated)) is false
	Wrapping.Wraps(MlirFunction(Wrapping.function, method = Scaled))
	Norming.Wraps(Norming.function) is false
	mutable sums = 0
	for callee.method.instructions
		if value.kind is InstructionType.LoopBegin
			return false
		if value.kind is InstructionType.Invoke
			for MlirModule(callee.types, "").Called(callee, index)
				sums = MlirDeviceSums(value, 0).IsSummed(value, 0, value.method.instructions.Length, false) then sums + 1 else sums
	sums is 1
Size(at Number) Text
	Ranging.Size(11) is ""
	Norming.Calculated(InstructionEntry.Binary(InstructionType.Divide, (3, 3, 4)), 6) is ""
	Norming.Calculated(InstructionEntry.Binary(InstructionType.Divide, (2, 2, 4)), 6) is "!"
	Norming.Calculated(InstructionEntry.Binary(InstructionType.Multiply, (2, 3, 4)), 6) is "!"
	Norming.Calculated(InstructionEntry.Binary(InstructionType.Divide, (2, 9, 4)), 5) is "!"
	Aligning.Call is 11 and Ranging.Call is -1
	Norming.Size(11) is "size"
	Norming.Size(7) is ""
	let size = Arguments(function.method.instructions(at), at)
	size.StartsWith("!") or size.StartsWith("?") then "" else size
Arguments(entry InstructionEntry, at Number) Text
	Norming.Arguments(Normed.instructions(11), 11) is "size"
	let countPosition = 5 + entry.payload(3)
	mutable grouping = ""
	for entry.payload(countPosition)
		grouping = Combined(grouping, Grouping(entry.payload(countPosition + 1 + index), at))
	grouping
Grouping(register Number, before Number) Text
	Norming.Grouping(7, 11) is "size"
	Norming.Grouping(4, 7) is "?size"
	Norming.Grouping(1, 11) is ""
	let writer = Writer(register, before)
	let entry = function.method.instructions(writer)
	if (writer < 0) or (entry.kind is InstructionType.LoadConstantToRegister)
		return ""
	if entry.kind is InstructionType.LoadVariableToRegister
		return Loaded(entry.texts(0), writer)
	let kind = entry.kind
	let isBinary = (kind > InstructionType.StoreSeparator) and (kind < InstructionType.BinaryOperatorsSeparator)
	kind is InstructionType.Invoke then Invoked(entry, writer) else isBinary then Calculated(entry, writer) else "!"
Invoked(entry InstructionEntry, at Number) Text
	Norming.Invoked(InstructionEntry.Invoke(5, ("Strict/Number", "Ceiling", "Strict/Number"), List(Number), 8), 11) is ""
	Norming.Invoked(Normed.instructions(7), 7) is "size"
	Norming.Invoked(Normed.instructions(11), 11) is "!"
	let register = MlirDeviceCalls(function, at, function).Register(entry)
	let instance = register < 0 then "" else Grouping(register, at)
	entry.texts(1) is "Floor" then Floored(instance) else Combined(instance, Arguments(entry, at)) is "" then "" else "!"
Writer(register Number, before Number) Number
	Aligning.Aligned(InstructionEntry.Binary(InstructionType.Subtract, (2, 4, 7)), 7) is "size"
	Ranging.Aligned(AlignedCode(9), 9) is ""
	Norming.Writer(7, 11) is 9
	Norming.Writer(0, 5) is -1
	for before - position - 1
		let candidate = before - 1 - index
		if LoadReuse(function.method.instructions).Written(function.method.instructions(candidate)) is register
			return candidate
	-1
Loaded(name Text, at Number) Text
	Aligning.Loaded("within", 9) is "!" and Aligning.Loaded("other", 9) is ""
	Norming.Grouping(9, 11) is ""
	Norming.Loaded("index", 4) is "!"
	Norming.Loaded("size", 5) is ""
	if name is in ("index", "value")
		return "!"
	for at - position - 1
		let earlier = function.method.instructions(at - 1 - index)
		if (earlier.kind is InstructionType.StoreRegisterToVariable) and (earlier.texts(0) is name)
			return Grouping(earlier.payload(0), at - 1 - index)
	""
Calculated(entry InstructionEntry, at Number) Text
	Norming.Calculated(Normed.instructions(6), 6) is "?size"
	Norming.Calculated(Normed.instructions(9), 9) is "size"
	let left = Grouping(entry.payload(1), at)
	let right = Grouping(entry.payload(2), at)
	let divisor = Writer(entry.payload(2), at)
	let named = function.method.instructions(divisor)
	let isNamed = (divisor >= 0) and (named.kind is InstructionType.LoadVariableToRegister)
	let isGrouping = (entry.kind is InstructionType.Divide) and (left is "!") and (right is "") and isNamed
	let aligned = Aligned(entry, at)
	aligned is not "" then aligned else (isGrouping then "?" + named.texts(0) else Combined(left, right))
Aligned(entry InstructionEntry, at Number) Text
	Aligning.Aligned(AlignedCode(9), 9) is "size"
	if (entry.kind is not InstructionType.Subtract) or (IsIndex(entry.payload(1), at) is false)
		return ""
	let writer = Resolved(entry.payload(2), at)
	let remainder = function.method.instructions(writer)
	if (writer < 0) or (remainder.kind is not InstructionType.Modulo) or (IsIndex(remainder.payload(1), writer) is false)
		return ""
	let divisor = Writer(remainder.payload(2), writer)
	let named = function.method.instructions(divisor)
	let isNamed = (divisor >= 0) and (named.kind is InstructionType.LoadVariableToRegister)
	isNamed and (Grouping(remainder.payload(2), writer) is "") then named.texts(0) else ""
Resolved(register Number, before Number) Number
	Aligning.Resolved(6, 9) is 6 and Aligning.Resolved(3, 9) is 5
	Aligning.Resolved(4, 7) is 6 and Aligning.Resolved(9, 9) is -1
	let writer = Writer(register, before)
	let entry = function.method.instructions(writer)
	if (writer < 0) or (entry.kind is not InstructionType.LoadVariableToRegister)
		return writer
	for writer - position - 1
		let at = writer - 1 - index
		let stored = function.method.instructions(at)
		if (stored.kind is InstructionType.StoreRegisterToVariable) and (stored.texts(0) is entry.texts(0))
			return Resolved(stored.payload(0), at)
	writer
IsIndex(register Number, before Number) Boolean
	Aligning.IsIndex(2, 9) is true and Ranging.IsIndex(2, 9) is false
	Aligning.IsIndex(3, 9) is false and Aligning.IsIndex(9, 4) is false
	Aligning.IsIndex(4, 7) is false
	Aligning.Aligned(InstructionEntry.Binary(InstructionType.Add, (2, 6, 7)), 9) is ""
	Aligning.Aligned(InstructionEntry.Binary(InstructionType.Subtract, (3, 6, 7)), 9) is ""
	Aligning.Aligned(InstructionEntry.Binary(InstructionType.Subtract, (2, 3, 7)), 9) is ""
	if function.method.instructions(position).payload(1) is 1
		return false
	let writer = Writer(register, before)
	let entry = function.method.instructions(writer)
	(writer >= 0) and (entry.kind is InstructionType.LoadVariableToRegister) and (entry.texts(0) is "index")
Combined(left Text, right Text) Text
	Norming.Combined("", "?size") is "!" and Norming.Combined("size", "size") is "size"
	Norming.Combined("size", "") is "size"
	Norming.Combined("", "size") is "size"
	Norming.Combined("size", "count") is "!"
	Norming.Combined("?size", "") is "!"
	let isOpen = left.StartsWith("!") or left.StartsWith("?") or right.StartsWith("!") or right.StartsWith("?")
	if isOpen or ((left is not "") and (right is not "") and (left is not right))
		return "!"
	left is "" then right else left
Floored(grouping Text) Text
	Norming.Floored("?size") is "size"
	Norming.Floored("!") is "!"
	grouping.StartsWith("?") then grouping.Substring(1, grouping.Length - 1) else grouping
