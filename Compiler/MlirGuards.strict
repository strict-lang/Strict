has function MlirFunction
has at Number
constant Offset = MemberEntry("offset", "Strict/Number", List(InstructionEntry), false)
constant Shifting = (MlirLoops.Emptied, InstructionEntry.Named(InstructionType.LoadVariableToRegister, 0, "numbers"), InstructionEntry.LoopBegin(0, -1), InstructionEntry.Named(InstructionType.LoadVariableToRegister, 1, "index"), InstructionEntry.Named(InstructionType.LoadVariableToRegister, 2, "offset"), InstructionEntry.Binary(InstructionType.Add, (1, 2, 3)), InstructionEntry(InstructionType.IndexCall, "numbers", (4, 3, -1)), InstructionEntry.Named(InstructionType.LoadVariableToRegister, 5, "value"), InstructionEntry.Binary(InstructionType.Add, (4, 5, 6)), InstructionEntry.Named(InstructionType.InvokeWriteToList, 6, "forResult"), InstructionEntry.Jump(InstructionType.LoopEnd, 8))
constant Shifted = MlirFunction(List(TypeEntry) + MlirFunction.Shape, MlirFunction.Shape, MethodEntry("Shifted", (MlirLists.Items, Offset), "Strict/List(Number)", Shifting), Float = "f32", Guarded = 2)
constant Shifts = MlirGuards(Shifted, 2)
constant Reading = MlirGuards(Shifted, 6)
constant Flooring = InstructionEntry.Invoke(3, ("Strict/Number", "Floor", "Strict/Number"), List(Number), 2)
constant Calculated = (InstructionType.Add, InstructionType.Subtract, InstructionType.Multiply, InstructionType.Modulo)
Origins(position Number, register Number) Texts
	Shifts.Origins(6, 3) is ("offset")
	Shifts.Origins(8, 5) is ("?")
	let writer = MlirKinds(function).Writer(position, register)
	writer <= function.Guarded then List(Text) + "?" else Written(writer)
Written(writer Number) Texts
	Shifts.Written(5) is ("offset")
	Shifts.Written(6) is ("?")
	let entry = function.method.instructions(writer)
	if entry.kind is InstructionType.LoadVariableToRegister
		return Variable(writer, entry.texts(0))
	if entry.kind is InstructionType.LoadConstantToRegister
		return MlirWholeValues(writer).IsWhole(PayloadDecoder(entry).Value(1)) then List(Text) else List(Text) + "?"
	if entry.kind is InstructionType.Divide
		return Origins(writer, entry.payload(1)) + Origins(writer, entry.payload(2)) + "/"
	if entry.kind is in Calculated
		return Origins(writer, entry.payload(1)) + Origins(writer, entry.payload(2))
	entry.kind is InstructionType.Invoke then Called(writer, entry) else List(Text) + "?"
Called(writer Number, entry InstructionEntry) Texts
	Shifts.Called(5, Flooring) is ("offset")
	let name = PayloadDecoder(entry).Text(2)
	if name is "Floor"
		return Floored(writer, entry)
	name is "Length" then List(Text) else List(Text) + "?"
Variable(position Number, name Text) Texts
	Shifts.Variable(4, "offset") is ("offset")
	Shifts.Variable(4, "index").Length is 0
	Shifts.Variable(7, "value") is ("?")
	let stored = MlirKinds(function).Stored(position, name)
	if stored > function.Guarded
		return Origins(stored, function.method.instructions(stored).payload(0))
	if name is "index"
		return List(Text)
	MlirKinds(function).VariableKind(function.Guarded, name) is "Number" then List(Text) + name else List(Text) + "?"
Sited(position Number) Texts
	Shifts.Sited(6) is ("offset")
	Shifts.Sited(5) is ("?")
	let entry = function.method.instructions(position)
	let kind = entry.kind
	if (kind > InstructionType.ArithmeticSeparator) and (kind < InstructionType.BinaryOperatorsSeparator)
		return Origins(position, entry.payload(1)) + Origins(position, entry.payload(2))
	if kind is InstructionType.IndexCall
		return Origins(position, entry.payload(1))
	if (kind is InstructionType.LoopBegin) and (position > function.Guarded)
		return Origins(position, entry.payload(0))
	let isFloor = (kind is InstructionType.Invoke) and (PayloadDecoder(entry).Text(2) is "Floor")
	isFloor then Floored(position, entry) else List(Text) + "?"
Floored(position Number, entry InstructionEntry) Texts
	Shifts.Floored(5, Flooring) is ("offset")
	Whole(Origins(position, MlirDeviceCalls(function, position, function).Register(entry)))
Whole(origins Texts) Texts
	Shifts.Whole(("offset", "/")) is ("offset")
	for origins
		if value is not "/"
			value
IsKnown(slots Texts) Boolean
	Reading.IsKnown(List(Text) + "%r3")
	Reading.IsKnown(List(Text) + "%r5") is false
	MlirGuards(MlirFunction(Shifted, Guarded = -1), 6).IsKnown(List(Text) + "%r3") is false
	if function.Guarded < 0
		return false
	for slots
		if (value.StartsWith("%r") is false) or ("?" is in Origins(at, value.Substring(2, value.Length - 2) to Number))
			return false
	true
IsWhole(slot Text) Boolean
	Reading.IsWhole("%r3")
	Reading.IsWhole("%r5") is false
	IsKnown(List(Text) + slot) and ("/" is not in Origins(at, slot.Substring(2, slot.Length - 2) to Number))
Parameters Texts
	Shifts.Parameters is ("offset")
	mutable names = List(Mutable(Text))
	for Range(at + 1, function.method.LoopEndOf(at))
		let origins = Sited(value)
		if "?" is not in origins
			names = names + Whole(origins)
	names.Unique
IsUseful Boolean
	Shifts.IsUseful
	MlirGuards(MlirFunction(Shifted, Float = "f64"), 2).IsUseful is false
	MlirGuards(MlirFunction(MlirGroups.Norming.function, Float = "f32", Group = 11), 2).IsUseful
	if function.Float is not "f32"
		return false
	for Range(at + 1, function.method.LoopEndOf(at))
		if "?" is not in Sited(value)
			return true
	false
Reads Texts
	Shifts.Reads is ("numbers")
	mutable names = List(Mutable(Text))
	for Range(at + 1, function.method.LoopEndOf(at))
		if IsSingle(value)
			names = names + function.method.instructions(value).texts(0)
	names.Unique
IsSingle(position Number) Boolean
	Shifts.IsSingle(6)
	Shifts.IsSingle(5) is false
	let entry = function.method.instructions(position)
	if (function.Guarded < 0) or (entry.kind is not InstructionType.IndexCall)
		return false
	let name = entry.texts(0)
	let isRows = MlirDeviceRows(function, position).IsRows(MlirKinds(function).VariableKind(position, name))
	(isRows is false) and (MlirKinds(function).Stored(position, name) < function.Guarded)
Mask Number
	Shifts.Mask > 0
	MlirGuards(MlirFunction(Shifted, Float = "f64"), 2).Mask is 0
	MlirGuards(MlirPassed.Wrapped, 2).Mask is 2 ^ 32 + 3
	if IsUseful is false
		return 0
	mutable mask = 0
	let divisors = MlirPassed(MlirFunction(function, Guarded = at), at).Divisors
	for MlirGpuCheck(function, at).Free
		mask = (value is in Parameters) or (value is in Reads) then mask + 2 ^ index else mask
		mask = (index < 20) and (value is in divisors) then mask + 2 ^ (32 + index) else mask
	mask
Kernel Texts
	Text.Combine(Shifts.Kernel).IndexOf("_gpu2sx(") > 0
	MlirGuards(MlirFunction(Shifted, Float = "f64"), 2).Kernel.Length is 0
	IsUseful then MlirDevice(function, at).Kernel else List(Text)
Named Texts
	Shifts.Named.Last.EndsWith("(dense<0> : tensor<3xi64>) : !llvm.array<3 x i64>")
	MlirGuards(MlirFunction(Shifted, Float = "f64"), 2).Named.Last.EndsWith("!llvm.array<2 x i64>")
	let name = MlirDevice(MlirFunction(function, Float = "f64", Guarded = -1), at).Name
	let isExact = Mask > 0
	let names = name + "\00" + name + "s\00" + (isExact then name + "sx\00" else "")
	let size = isExact then name.Length * 3 + 6 else name.Length * 2 + 3
	let kernels = isExact then 3 else 2
	let cache = "(dense<0> : tensor<" + kernels + "xi64>) : !llvm.array<" + kernels + " x i64>"
	let text = "  llvm.mlir.global internal constant @k" + name + "(\"" + names + "\") : !llvm.array<" + size + " x i8>"
	(text, "  llvm.mlir.global internal @f" + name + cache)
