has function MlirFunction
has at Number
constant Offset = MemberEntry("offset", "Strict/Number", List(InstructionEntry), false)
constant NumbersLoop = (MlirLoops.Emptied, InstructionEntry.Named(InstructionType.LoadVariableToRegister, 0, "numbers"), InstructionEntry.LoopBegin(0, -1))
constant ShiftOffset = (InstructionEntry.Named(InstructionType.LoadVariableToRegister, 1, "index"), InstructionEntry.Named(InstructionType.LoadVariableToRegister, 2, "offset"), InstructionEntry.Binary(InstructionType.Add, (1, 2, 3)))
constant ShiftRead = (InstructionEntry(InstructionType.IndexCall, "numbers", (4, 3, -1)), InstructionEntry.Named(InstructionType.LoadVariableToRegister, 5, "value"), InstructionEntry.Binary(InstructionType.Add, (4, 5, 6)))
constant ShiftWritten = (InstructionEntry.Named(InstructionType.InvokeWriteToList, 6, "forResult"), InstructionEntry.Jump(InstructionType.LoopEnd, 8))
constant Shifting = NumbersLoop + ShiftOffset + ShiftRead + ShiftWritten
constant Shifted = MlirFunction(List(TypeEntry) + MlirFunction.Shape, MlirFunction.Shape, MethodEntry("Shifted", (MlirLists.Items, Offset), "Strict/List(Number)", Shifting), Float = "f32", Guarded = 2)
constant Shifts = MlirGuards(Shifted, 2)
constant Reading = MlirGuards(Shifted, 6)
constant Flooring = InstructionEntry.Invoke(3, ("Strict/Number", "Floor", "Strict/Number"), List(Number), 2)
constant Calculated = (InstructionType.Add, InstructionType.Subtract, InstructionType.Multiply, InstructionType.Modulo)
constant ExactSlots = "(dense<0> : tensor<9xi64>) : !llvm.array<9 x i64>"
constant PlainSlots = "(dense<0> : tensor<2xi64>) : !llvm.array<2 x i64>"
constant SlotsGlobal = "  llvm.mlir.global internal @fShape_Shifted_2_gpu2"
constant ExactKernel = "  llvm.mlir.global internal constant @kShape_Shifted_2_gpu2(\"Shape_Shifted_2_gpu2\00Shape_Shifted_2_gpu2s\00Shape_Shifted_2_gpu2sx\00Shape_Shifted_2_gpu2sxf0\00Shape_Shifted_2_gpu2sxf1\00\") : !llvm.array<116 x i8>"
constant ExactNamed = (ExactKernel, SlotsGlobal + ExactSlots)
constant PlainNamed = ("  llvm.mlir.global internal constant @kShape_Shifted_2_gpu2(\"Shape_Shifted_2_gpu2\00Shape_Shifted_2_gpu2s\00\") : !llvm.array<43 x i8>", SlotsGlobal + PlainSlots)
constant StepStored = (InstructionEntry.Named(InstructionType.LoadVariableToRegister, 1, "offset"), InstructionEntry.Named(InstructionType.StoreRegisterToVariable, 1, "step"))
constant StepLoads = (InstructionEntry.Named(InstructionType.LoadVariableToRegister, 2, "step"), InstructionEntry.LoadNumber(3, 2), InstructionEntry.LoadNumber(4, 1.5))
constant StepCompared = (InstructionEntry.Binary(InstructionType.LessThan, (2, 1, 5)), InstructionEntry.Binary(InstructionType.Divide, (2, 1, 6)), InstructionEntry.LoopBegin(2, -1))
constant StepCalls = (InstructionEntry.Invoke(7, ("Strict/Number", "Floor", "Strict/Number"), List(Number), 2), InstructionEntry.Invoke(8, ("Strict/Number", "Length", "Strict/Number"), List(Number), 2))
constant NestedEnds = (InstructionEntry.Jump(InstructionType.LoopEnd, 3), InstructionEntry.Jump(InstructionType.LoopEnd, 12))
constant Nesting = NumbersLoop + StepStored + StepLoads + StepCompared + StepCalls + NestedEnds
constant Nested = MlirFunction(List(TypeEntry) + MlirFunction.Shape, MlirFunction.Shape, MethodEntry("Nested", (MlirLists.Items, Offset), "Strict/List(Number)", Nesting), Float = "f32", Guarded = 2)
constant MaximumDivisors = 20
constant DivisorShift = 32
Origins(position Number, register Number, seen = List(Text)) Texts
	Shifts.Origins(6, 3) is ("offset")
	Shifts.Origins(8, 5) is ("?")
	MlirGuards(MlirFunction(Shifted, Guarded = 5), 2).Origins(6, 3) is ("?")
	MlirGuards(MlirPassed.Wrapped, 2).Written(8) is ("?", "offset", "/")
	MlirGuards(Nested, 2).Written(5) is ("offset")
	MlirGuards(Nested, 2).Written(9) is ("offset", "offset", "/")
	writer = MlirKinds(function).Writer(position, register)
	writer <= function.Guarded then List(Text) + "?" else Written(writer, seen)
Written(writer Number, seen = List(Text)) Texts
	Shifts.Written(5) is ("offset")
	Shifts.Written(6) is ("?")
	entry = function.method.instructions(writer)
	if entry.kind is InstructionType.LoadVariableToRegister
		return Variable(writer, entry.texts(0), seen)
	if entry.kind is InstructionType.LoadConstantToRegister
		return MlirWholeValues(writer).IsWhole(PayloadDecoder(entry).Value(1)) then List(Text) else List(Text) + "?"
	if entry.kind is InstructionType.Divide
		return Origins(writer, entry.payload(1), seen) + Origins(writer, entry.payload(2), seen) + "/"
	if entry.kind is in Calculated
		return Origins(writer, entry.payload(1), seen) + Origins(writer, entry.payload(2), seen)
	entry.kind is InstructionType.Invoke then Called(writer, entry) else List(Text) + "?"
Called(writer Number, entry InstructionEntry) Texts
	Shifts.Called(5, Flooring) is ("offset")
	Shifts.Called(5, InstructionEntry.Invoke(3, ("Strict/Number", "Length", "Strict/Number"), List(Number), 2)).Length is 0
	Shifts.Called(5, InstructionEntry.Invoke(3, ("Strict/Number", "Round", "Strict/Number"), List(Number), 2)) is ("?")
	MlirGuards(Nested, 2).Written(6).Length is 0
	MlirGuards(Nested, 2).Written(7) is ("?")
	MlirGuards(Nested, 2).Written(11) is ("offset")
	MlirGuards(Nested, 2).Written(12).Length is 0
	name = PayloadDecoder(entry).Text(2)
	name is "Floor" then Floored(writer, entry) else name is "Length" then List(Text) else List(Text) + "?"
Variable(position Number, name Text, seen = List(Text)) Texts
	Shifts.Variable(4, "offset") is ("offset")
	Shifts.Variable(4, "index").Length is 0 and Shifts.Variable(7, "value") is ("?")
	if name is in seen
		return List(Text)
	callees = MlirCalleeGuards(function, position)
	if name.StartsWith("conditional")
		return callees.StoreOrigins(function.Guarded + 1, position, name, seen + name)
	stored = MlirKinds(function).Stored(position, name)
	found = stored > function.Guarded then callees.StoredOrigin(stored, seen + name) else Initial(name)
	found + LoopOrigins(position, name, seen + name)
LoopOrigins(position Number, name Text, seen Texts) Texts
	Shifts.LoopOrigins(4, "offset", List(Text)).Length is 0
	loop = function.method.LoopBeginOf(position)
	loopEnd = loop >= function.Guarded and loop < position then function.method.LoopEndOf(loop) else -1
	loopEnd < 0 then List(Text) else MlirCalleeGuards(function, position).StoreOrigins(position + 1, loopEnd, name, seen)
Initial(name Text) Texts
	Shifts.Initial("index").Length is 0
	if name is "index"
		return List(Text)
	if function.Whole.Length > 0
		return name is in function.Whole then List(Text) + name else List(Text) + "?"
	MlirKinds(function).VariableKind(function.Guarded, name) is "Number" then List(Text) + name else List(Text) + "?"
Sited(position Number) Texts
	Shifts.Sited(6) is ("offset")
	Shifts.Sited(5) is ("?")
	entry = function.method.instructions(position)
	kind = entry.kind
	if kind > InstructionType.ArithmeticSeparator and kind < InstructionType.BinaryOperatorsSeparator
		return Origins(position, entry.payload(1)) + Origins(position, entry.payload(2))
	if kind is InstructionType.IndexCall
		return Origins(position, entry.payload(1))
	if kind is InstructionType.LoopBegin
		return Origins(position, entry.payload(0))
	isFloor = kind is InstructionType.Invoke and PayloadDecoder(entry).Text(2) is "Floor"
	isFloor then Floored(position, entry) else List(Text) + "?"
Floored(position Number, entry InstructionEntry) Texts
	Shifts.Named is ExactNamed
	MlirGuards(MlirFunction(Shifted, Float = "f64"), 2).Named is PlainNamed
	Shifts.Floored(5, Flooring) is ("offset")
	MlirGuards(Nested, 2).Sited(8) is ("offset", "offset")
	MlirGuards(Nested, 2).Sited(10) is ("offset")
	MlirGuards(Nested, 2).Sited(11) is ("offset")
	MlirGuards(Nested, 2).Sited(12) is ("?")
	Whole(Origins(position, MlirDeviceCalls(function, position, function).Register(entry)))
Whole(origins Texts) Texts
	Shifts.Mask is 3
	Shifts.Whole(("offset", "/")) is ("offset")
	for origins
		if value is not "/"
			value
IsKnown(slots Texts) Boolean
	Reading.IsKnown(List(Text) + "%r3")
	Reading.IsKnown(List(Text) + "%r5") is false
	MlirGuards(MlirFunction(Shifted, Guarded = -1), 6).IsKnown(List(Text) + "%r3") is false
	if function.Guarded < 0 and function.Whole.Length is 0
		return false
	for slots
		if value.StartsWith("%r") is false or "?" is in Origins(at, value.Substring(2) to Number)
			return false
	true
IsWhole(slot Text) Boolean
	Reading.IsWhole("%r3")
	Reading.IsWhole("%r5") is false
	MlirGuards(Nested, 10).IsWhole("%r6") is false
	MlirGuards(Nested, 10).IsKnown(List(Text) + "ab6") is false
	IsKnown(List(Text) + slot) and "/" is not in Origins(at, slot.Substring(2) to Number)
Parameters Texts
	Shifts.Parameters is ("offset")
	mutable names = List(Mutable(Text))
	candidates = MlirCalleeGuards(function, at).FreeNumbers
	for Range(at + 1, function.method.LoopEndOf(at))
		origins = Sited(value)
		if "?" is not in origins
			names = names + Whole(origins)
		if function.method.instructions(value).kind is InstructionType.Invoke
			names = names + MlirCalleeGuards(function, value).Sites(candidates, 0)
	for names.Unique
		if value is in candidates
			value
IsUseful Boolean
	Shifts.IsUseful
	MlirGuards(MlirFunction(Shifted, Float = "f64"), 2).IsUseful is false
	MlirGuards(MlirFunction(MlirGroups.Norming.function, Float = "f32", Group = 11), 2).IsUseful
	MlirGuards(MlirFunction(MlirLoops.Collecting.function, Float = "f32"), 1).IsUseful is false
	if function.Float is not "f32"
		return false
	for Range(at + 1, function.method.LoopEndOf(at))
		if "?" is not in Sited(value)
			return true
	false
Reads Texts
	Shifts.Reads is ("numbers")
	mutable names = List(Mutable(Text))
	for Range(at + 1, function.method.LoopEndOf(at))
		if IsSingle(value)
			names = names + function.method.instructions(value).texts(0)
	names.Unique
IsSingle(position Number) Boolean
	Shifts.IsSingle(6)
	Shifts.IsSingle(5) is false
	entry = function.method.instructions(position)
	if function.Guarded < 0 or entry.kind is not InstructionType.IndexCall
		return false
	name = entry.texts(0)
	isRows = MlirDeviceRows(function, position).IsRows(MlirKinds(function).VariableKind(position, name))
	isRows is false and MlirKinds(function).Stored(position, name) < function.Guarded
Mask Number
	Shifts.Mask > 0
	MlirGuards(MlirFunction(Shifted, Float = "f64"), 2).Mask is 0
	MlirGuards(MlirPassed.Wrapped, 2).Mask is 2 ^ 32 + 3
	if IsUseful is false
		return 0
	mutable mask = 0
	divisors = MlirPassed(MlirFunction(function, Guarded = at), at).Divisors
	for MlirGpuCheck(function, at).Free
		mask = value is in Parameters or value is in Reads then mask + 2 ^ index else mask
		mask = index < MaximumDivisors and value is in divisors then mask + 2 ^ (DivisorShift + index) else mask
	mask
Kernel Texts
	Text.Combine(Shifts.Kernel).IndexOf("_gpu2sx(") > 0
	Text.Combine(Shifts.Kernel).IndexOf("%format_numbers = arith.constant 17 : i64") > 0
	MlirGuards(MlirFunction(Shifted, Float = "f64"), 2).Kernel.Length is 0
	IsUseful then MlirDevice(function, at).Kernel + MlirFormats(function, at).Kernels else List(Text)
Named Texts
	Shifts.Named.Last.EndsWith("(dense<0> : tensor<9xi64>) : !llvm.array<9 x i64>")
	MlirGuards(MlirFunction(Shifted, Float = "f64"), 2).Named.Last.EndsWith("!llvm.array<2 x i64>")
	name = MlirDevice(MlirFunction(function, Float = "f64", Guarded = -1), at).Name
	isExact = Mask > 0
	formats = MlirFormats(function, at)
	first = MlirDoubles(function, at).Failing then "" else name
	names = first + "\00" + name + "s\00" + (isExact then name + "sx\00" + formats.Names(name) else "")
	size = first.Length + name.Length + 3 + (isExact then name.Length + 3 + formats.Count * (name.Length + 5) else 0)
	text = "  llvm.mlir.global internal constant @k" + name + "(\"" + names + "\") : !llvm.array<" + size + " x i8>"
	(text, "  llvm.mlir.global internal @f" + name + (isExact then ExactSlots else PlainSlots))
