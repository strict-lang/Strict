has function MlirFunction
has position Number
constant Built = InstructionEntry.Invoke(1, ("Strict/Shape", "from", "Strict/Shape", "width"), 0, -1)
constant Width = InstructionEntry(InstructionType.FieldLoad, "width", (2, 1, -1))
constant Shapes = MlirFunction(List(TypeEntry) + MlirFunction.Shape, MlirFunction.Shape, MethodEntry("Run", List(MemberEntry), "None", (InstructionEntry.LoadNumber(0, 3), Built, Width)))
constant MemberBase = 100000
constant Looping = MlirFunction(List(TypeEntry), MlirFunction.Shape, MethodEntry.CountingLoop)
constant Outer = TypeEntry("Strict/Outer", (MemberEntry("shape", "Strict/Shape", List(InstructionEntry), false), MemberEntry("size", "Strict/Number", List(InstructionEntry), false)), List(MethodEntry))
constant Widened = MlirFunction(List(TypeEntry) + MlirFunction.Shape, MlirFunction.Shape, MethodEntry("Run", List(MemberEntry) + MemberEntry("width", "Strict/Number", List(InstructionEntry), false), "None", List(InstructionEntry)))
constant Sizing = MlirFunction(List(TypeEntry) + MlirFunction.Shape + Outer, Outer, MethodEntry("Run", List(MemberEntry) + MemberEntry("size", "Strict/Number", List(InstructionEntry), false), "None", List(InstructionEntry)))
constant SelfGuard = ("    %hasSelf = arith.cmpf une, %self, %zero : f64", "    cf.cond_br %hasSelf, ^unpack, ^unpacked", "  ^unpack:")
constant Named = InstructionEntry(InstructionType.FieldLoad, ("Name", "Error"), (2, 1, -1))
constant Nesting = MlirFunction(List(TypeEntry) + MlirFunction.Shape + Outer, Outer, MethodEntry.CountingLoop)
constant Written = "    func.call @strict_gc_written(%s) : (!llvm.ptr) -> ()"
Stored(owner TypeEntry) List(MemberEntry)
	MlirInstances(Shapes, 0).Stored(MlirFunction.Shape).Length is 1
	for owner.members
		if (value.IsConstant is false) and TypeEntry.ShortName(value.typeName) is not "Logger"
			value
StoredNames(owner TypeEntry) Texts
	MlirInstances(Shapes, 0).StoredNames(MlirFunction.Shape) is ("width")
	for Stored(owner)
		value.Name
Constructed(entry InstructionEntry, typeName Text) Texts
	MlirInstances(Shapes, 1).Constructed(Built, "Strict/Shape").Last is "    llvm.store %t1of, %r1 : f64, !llvm.ptr"
	MlirInstances(Shapes, 1).Constructed(Built, "Strict/Character").Length is 2
	Text.Combine(MlirInstances(Shapes, 1).Constructed(Built, "Strict/Error")).IndexOf("@strict_error_bits(") > 0
	if (TypeEntry.ShortName(typeName) is "File") or (MlirLayout(function).IsStruct(typeName) is false)
		return function.Copied("%r" + entry.payload(5 + entry.payload(3) + 1), "%r" + entry.payload(0), Temp("o"))
	let owner = function.TypeOf(typeName)
	let members = Stored(owner)
	let memory = MlirMemory(function, position)
	mutable lines = memory.Allocated(members.Length, "o")
	for members
		lines = lines + MemberValue(entry, owner, value, index)
	lines + memory.Boxed(Temp("op"), "o", typeName) + function.Store(Temp("of"), "%r" + entry.payload(0))
MemberValue(entry InstructionEntry, owner TypeEntry, member MemberEntry, slot Number) Texts
	MlirInstances(Shapes, 1).MemberValue(Built, MlirFunction.Shape, MlirFunction.Shape.members.First, 0).Length is 3
	let names = Invocation(entry, List(VmValue), VmValue.None).ParameterNames
	let argument = names.Index(member.Name)
	let chosen = argument < 0 then slot else argument
	let countPosition = 5 + entry.payload(3)
	let target = MlirMemory(function, position).Slot(Temp("op"), slot, "s" + slot)
	if chosen < entry.payload(countPosition)
		let source = function.Load(Temp("a" + slot), "%r" + entry.payload(countPosition + 1 + chosen))
		return (target, source, function.Store(Temp("a" + slot), Temp("s" + slot)))
	let written = MlirTyped.Pointer.Written(Temp("s" + slot))
	List(Text) + target + Default(owner, member, Temp("s" + slot), "d" + slot) + written
Default(owner TypeEntry, member MemberEntry, slot Text, suffix Text) Texts
	MlirInstances(Shapes, 1).Default(MlirFunction.Shape, MlirFunction.Shape.members.First, "%s", "d0").Length is 2
	let named = MlirDefaults(function).Name(owner, member)
	let initial = Natives(function.types).Initial(member)
	if MlirPairs(function, position).IsPaired(member.typeName)
		return MlirPairs(function, position).Defaulted(initial, slot)
	MlirStatements(function, position).Literal(initial, slot, suffix, named)
Fresh(type TypeEntry, target Text, prefix Text, creating Texts) Texts
	MlirInstances(Shapes, 0).Fresh(MlirFunction.Shape, "%self", "", List(Text)).Length is 8
	MlirInstances(MlirLayout.Wrapping.function, 0).Fresh(MlirLayout.Degrees, "%self", "", List(Text)).Length is 2
	let stored = Stored(type)
	let unset = List(Text) + function.Store("%zero", target)
	if MlirLayout(function).IsStruct(type.Name) is false
		return stored.Length is 0 then unset else Default(type, stored.First, target, prefix + "d")
	let memory = MlirMemory(function, position)
	mutable lines = memory.Allocated(stored.Length, prefix + "o")
	for stored
		let initialized = Initialized(type, value, Temp(prefix + "s" + index), prefix + index, creating + type.Name)
		lines = lines + memory.Slot(Temp(prefix + "op"), index, prefix + "s" + index) + initialized
	lines + memory.Bits(Temp(prefix + "op"), prefix + "o") + function.Store(Temp(prefix + "of"), target)
Initialized(owner TypeEntry, member MemberEntry, slot Text, prefix Text, creating Texts) Texts
	MlirInstances(Nesting, 0).Initialized(Outer, Outer.members.First, "%s", "0", List(Text)).Length is 9
	MlirInstances(Nesting, 0).Initialized(Outer, Outer.members.First, "%s", "0", ("Strict/Shape")).Last is Written
	let memberType = function.TypeOf(member.typeName)
	let isNested = MlirLayout(function).IsStruct(member.typeName) and (memberType.members.Length > 0)
	let isFresh = isNested and (member.initial.Length is 0) and (memberType.Name is not in creating)
	let fresh = isFresh then Fresh(memberType, slot, prefix + "_", creating) else List(Text)
	(isFresh then fresh else Default(owner, member, slot, prefix + "d")) + MlirTyped.Pointer.Written(slot)
Field(entry InstructionEntry) Texts
	MlirInstances(Shapes, 2).Field(Width).Length is 5
	if entry.texts is ("Name", "Error")
		return ErrorName(entry)
	let kind = MlirKinds(function).KindOf(position, entry.payload(1))
	if MlirLayout(function).IsAliased(entry, position)
		return function.Copied("%r" + entry.payload(1), "%r" + entry.payload(0), Temp("a"))
	let slot = StoredNames(function.TypeOf(kind)).Index(entry.texts(0))
	if slot < 0
		return List(Text) + MlirStatements(function, position).Unsupported("member " + kind + "." + entry.texts(0))
	let memory = MlirMemory(function, position)
	let loaded = List(Text) + function.Load(Temp("i"), "%r" + entry.payload(1)) + memory.Pointer(Temp("i"), "i")
	loaded + memory.Loaded(Temp("ip"), slot, "m") + function.Store(Temp("mv"), "%r" + entry.payload(0))
Unpacked Texts
	MlirInstances(Looping, 0).Unpacked.Length is 10
	MlirInstances(Looping, 0).Unpacked.Last is "  ^unpacked:"
	MlirInstances(Sizing, 0).Unpacked.Length < MlirInstances(Nesting, 0).Unpacked.Length
	if (MlirLayout(function).IsStruct(function.type.Name) is false) or (Stored(function.type).Length is 0)
		return Aliased
	let memory = MlirMemory(function, -1)
	mutable lines = List(Text) + function.Load("%self", "%instance") + SelfGuard + memory.Pointer("%self", "self")
	for Stored(function.type)
		if value.Name is not in function.method.ParameterNames
			let loaded = memory.Loaded(memory.Temp("selfp"), index, "u" + index)
			lines = lines + loaded + function.Store(memory.Temp("u" + index + "v"), "%v_" + value.Name)
	lines + ("    cf.br ^unpacked", "  ^unpacked:")
ErrorName(entry InstructionEntry) Texts
	MlirInstances(Shapes, 2).ErrorName(Named).Index("    %t2n = func.call @strict_error_name(%t2e) : (f64) -> f64") is 1
	let named = "    " + Temp("n") + " = func.call @strict_error_name(" + Temp("e") + ") : (f64) -> f64"
	(function.Load(Temp("e"), "%r" + entry.payload(1)), named, function.Store(Temp("n"), "%r" + entry.payload(0)))
Aliased Texts
	MlirInstances(MlirLayout.Wrapping.function, 0).Aliased.Length is 2
	MlirInstances(MlirLayout.Wrapping.function, 0).Aliased.First is "    %talias0 = llvm.load %instance : !llvm.ptr -> f64"
	MlirInstances(Widened, 0).Aliased.Length is 0
	mutable lines = List(Mutable(Text))
	for Stored(function.type)
		if value.Name is not in function.method.ParameterNames
			lines = lines + function.Copied("%instance", "%v_" + value.Name, "%talias" + index)
	lines
ReferencedConstants List(MemberEntry)
	MlirInstances(Shapes, 0).ReferencedConstants.Length is 0
	for function.type.members
		if value.IsConstant and IsReferenced(value.Name)
			value
IsReferenced(name Text) Boolean
	MlirInstances(Shapes, 0).IsReferenced("width") is false
	for function.method.instructions
		if (value.kind is in (InstructionType.IndexCall, InstructionType.LoadVariableToRegister)) and (value.texts(0) is name)
			return true
	false
Constants Texts
	MlirInstances(Shapes, 0).Constants.Length is 0
	mutable lines = List(Mutable(Text))
	for ReferencedConstants
		let initial = Natives(function.types).Initial(value)
		lines = lines + MlirStatements(function, MemberBase + index).Literal(initial, "%v_" + value.Name, "")
	lines
Temp(suffix Text) Text
	MlirInstances(Shapes, 1).Temp("o") is "%t1o"
	"%t" + position + suffix