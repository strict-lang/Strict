has function MlirFunction
has position Number
constant NumbersLoop = (InstructionEntry.Named(InstructionType.LoadVariableToRegister, 0, "numbers"), InstructionEntry.LoopBegin(0, -1))
constant ElementRead = (InstructionEntry.Named(InstructionType.LoadVariableToRegister, 1, "index"), InstructionEntry(InstructionType.IndexCall, "numbers", (2, 1, -1)))
constant ValueAdded = (InstructionEntry.Named(InstructionType.LoadVariableToRegister, 3, "value"), InstructionEntry.Binary(InstructionType.Add, (3, 2, 4)))
constant AddedWritten = (InstructionEntry.Named(InstructionType.InvokeWriteToList, 4, "forResult"), InstructionEntry.Jump(InstructionType.LoopEnd, 6))
constant Looped = NumbersLoop + ElementRead + ValueAdded + AddedWritten
constant Body = List(InstructionEntry) + MlirLoops.Emptied + Looped
constant Doubler = MlirFunction(List(TypeEntry) + MlirFunction.Shape, MlirFunction.Shape, MethodEntry("Doubled", List(MemberEntry) + MlirLists.Items, "Strict/List(Number)", Body))
constant Doubling = MlirKernel(Doubler, 2)
constant Uncollected = MlirKernel(MlirFunction(List(TypeEntry) + MlirFunction.Shape, MlirFunction.Shape, MethodEntry("Doubled", List(MemberEntry) + MlirLists.Items, "Strict/List(Number)", Looped)), 1)
constant SumAdded = (InstructionEntry.Named(InstructionType.LoadVariableToRegister, 3, "sum"), InstructionEntry.Binary(InstructionType.Add, (3, 2, 4)))
constant SumStored = (InstructionEntry.Named(InstructionType.StoreRegisterToVariable, 4, "sum"), InstructionEntry.Jump(InstructionType.LoopEnd, 6))
constant Summed = NumbersLoop + ElementRead + SumAdded + SumStored
constant Summing = MlirKernel(MlirFunction(List(TypeEntry) + MlirFunction.Shape, MlirFunction.Shape, MethodEntry("Sum", List(MemberEntry) + MlirLists.Items, "Strict/Number", Summed)), 1)
constant Squaring = MlirKernel(MlirDeviceDot.Squaring.function, 2)
constant Calling = MlirKernel(MlirFunction(List(TypeEntry), MlirFunction.Shape, MethodEntry("Run", List(MemberEntry) + MlirLists.Items, "None", NumbersLoop + MethodEntry.GoCall + InstructionEntry.Jump(InstructionType.LoopEnd, 1))), 1)
constant FarIndex = (InstructionEntry.Named(InstructionType.LoadVariableToRegister, 3, "index"), InstructionEntry.LoadNumber(4, 397), InstructionEntry.Binary(InstructionType.Add, (3, 4, 5)))
constant FarRead = FarIndex + InstructionEntry(InstructionType.IndexCall, "numbers", (6, 5, -1))
constant NextIndex = (InstructionEntry.Named(InstructionType.LoadVariableToRegister, 7, "index"), InstructionEntry.LoadNumber(8, 1), InstructionEntry.Binary(InstructionType.Add, (7, 8, 9)))
constant NextRead = NextIndex + InstructionEntry.Binary(InstructionType.Add, (9, 4, 9)) + InstructionEntry(InstructionType.IndexCall, "numbers", (10, 9, -1))
constant ReadsCombined = (InstructionEntry.Binary(InstructionType.Multiply, (2, 10, 11)), InstructionEntry.Binary(InstructionType.Add, (6, 11, 12)))
constant ReadsWritten = (InstructionEntry.Named(InstructionType.InvokeWriteToList, 12, "forResult"), InstructionEntry.Jump(InstructionType.LoopEnd, 15))
constant OffsetReads = List(InstructionEntry) + MlirLoops.Emptied + NumbersLoop + ElementRead + FarRead + NextRead + ReadsCombined + ReadsWritten
constant Offsetting = MlirKernel(MlirFunction(Doubler.types, Doubler.type, MethodEntry("Offsets", List(MemberEntry) + MlirLists.Items, "Strict/List(Number)", OffsetReads)), 2)
constant TwiceIndex = (InstructionEntry.Named(InstructionType.LoadVariableToRegister, 1, "index"), InstructionEntry.Named(InstructionType.LoadVariableToRegister, 2, "index"), InstructionEntry.Binary(InstructionType.Add, (1, 2, 3)))
constant TwiceRead = TwiceIndex + InstructionEntry(InstructionType.IndexCall, "numbers", (4, 3, -1))
constant StoredRead = (InstructionEntry.Named(InstructionType.LoadVariableToRegister, 5, "sum"), InstructionEntry.Binary(InstructionType.Add, (5, 1, 6)), InstructionEntry(InstructionType.IndexCall, "numbers", (7, 6, -1)))
constant BackRead = (InstructionEntry.Named(InstructionType.LoadVariableToRegister, 8, "start"), InstructionEntry.Binary(InstructionType.Subtract, (8, 1, 9)), InstructionEntry(InstructionType.IndexCall, "numbers", (10, 9, -1)))
constant SumKept = (InstructionEntry.Named(InstructionType.StoreRegisterToVariable, 10, "sum"), InstructionEntry.Jump(InstructionType.LoopEnd, 12))
constant Rejecting = MlirKernel(MlirFunction(Doubler.types, Doubler.type, MethodEntry("Sum", List(MemberEntry) + MlirLists.Items, "Strict/Number", NumbersLoop + TwiceRead + StoredRead + BackRead + SumKept)), 1)
IsSimple Boolean
	Doubling.IsSimple
	Calling.IsSimple is false
	MlirKernel(MlirLoops.Counting.function, 0).IsSimple is false
	let entry = function.method.instructions(position)
	let isCounted = (entry.kind is InstructionType.LoopBegin) and (entry.payload(1) is not 1)
	if (isCounted is false) or (function.FastLoop >= 0) or (MlirLoops(function, position).Collection is "Text")
		return false
	let end = function.method.LoopEndOf(position)
	for Range(position + 1, end)
		if IsAllowed(value) is false
			return false
	(-1 is not in function.method.instructions(end).payload) and IsUseful
IsUseful Boolean
	Doubling.IsUseful
	Uncollected.IsUseful is false
	Offsetting.IsSimple
	let loops = MlirLoops(function, position)
	mutable collected = 0
	for Range(position + 1, function.method.LoopEndOf(position))
		if function.method.instructions(value).kind is InstructionType.InvokeWriteToList
			collected = collected + 1
	let isRead = (Sources.Length > 0) or (loops.Collection is not "")
	loops.IsCollecting then collected is 1 else (collected is 0) and isRead
IsAllowed(at Number) Boolean
	Doubling.IsAllowed(4)
	Calling.IsAllowed(2) is false
	let entry = function.method.instructions(at)
	let kind = entry.kind
	if kind is InstructionType.LoadConstantToRegister
		return PayloadDecoder(entry).Value(1).kind is in ("Number", "Boolean")
	if kind is InstructionType.StoreRegisterToVariable
		return (entry.texts(0).IndexOf("(") < 0) and (entry.texts(0) is not in Sources)
	if kind is in (InstructionType.IndexCall, InstructionType.InvokeWriteToList, InstructionType.CheckError)
		return IsAccessAllowed(at)
	let isBinary = kind > InstructionType.StoreSeparator and kind < InstructionType.BinaryOperatorsSeparator
	(kind is InstructionType.LoadVariableToRegister) or (isBinary and IsCalculated(at))
IsAccessAllowed(at Number) Boolean
	Doubling.IsAccessAllowed(4)
	Doubling.IsAccessAllowed(7)
	let entry = function.method.instructions(at)
	let previous = function.method.instructions(at - 1)
	if entry.kind is InstructionType.CheckError
		return (previous.kind is InstructionType.IndexCall) and (previous.payload(0) is entry.payload(0))
	entry.kind is InstructionType.IndexCall then IsIndexedByLoop(at) else entry.texts(0) is "forResult"
IsCalculated(at Number) Boolean
	Doubling.IsCalculated(6)
	let isText = MlirTexts(function, at).IsSum
	let isList = MlirListOperators(function, at).IsOperation
	let isCompared = MlirEquality(function, at).Handles(function.method.instructions(at))
	(isText is false) and (isList is false) and (isCompared is false)
IsIndexedByLoop(at Number) Boolean
	Doubling.IsIndexedByLoop(4)
	MlirKernel(MlirLists.Listed, 0).IsIndexedByLoop(2) is false
	Squaring.IsIndexedByLoop(7)
	(Offsetting.IsIndexedByLoop(4), Offsetting.IsIndexedByLoop(8), Offsetting.IsIndexedByLoop(13)) is (true, true, true)
	(Rejecting.IsIndexedByLoop(5), Rejecting.IsIndexedByLoop(8), Rejecting.IsIndexedByLoop(11)) is (false, false, false)
	let entry = function.method.instructions(at)
	let kind = MlirLayout(function).Represented(MlirKinds(function).VariableKind(at, entry.texts(0)))
	let terms = Terms(entry.payload(1), at)
	kind.StartsWith("List(") and ("" is not in terms) and (terms.Count("index") is 1)
Terms(register Number, before Number) Texts
	Offsetting.Terms(5, 8) is ("index", "0x4078D00000000000")
	Rejecting.Terms(8, 10) is ("start")
	Rejecting.Terms(6, 8) is ("", "index")
	Rejecting.Terms(9, 11) is ("")
	for before - position - 1
		let at = before - 1 - index
		if LoadReuse(function.method.instructions).Written(function.method.instructions(at)) is register
			return Termed(at)
	List(Text) + ""
Termed(at Number) Texts
	Offsetting.Termed(6) is ("0x4078D00000000000")
	Offsetting.Termed(3) is ("index")
	Doubling.Termed(5) is ("")
	let entry = function.method.instructions(at)
	if entry.kind is InstructionType.Add
		return Terms(entry.payload(1), at) + Terms(entry.payload(2), at)
	if entry.kind is InstructionType.LoadConstantToRegister
		return List(Text) + MlirStatements(function, at).Hex(PayloadDecoder(entry).Value(1).number)
	if entry.kind is not InstructionType.LoadVariableToRegister
		return List(Text) + ""
	List(Text) + (entry.texts(0) is in (MlirSingle(function, position).Carried + "value") then "" else entry.texts(0))
Offsets(at Number) Texts
	Squaring.Offsets(7) is ("start")
	Doubling.Offsets(4).Length is 0
	Squaring.Offsets(16).Length is 0
	Offsetting.Offsets(13) is ("0x3FF0000000000000", "0x4078D00000000000")
	let entry = function.method.instructions(at)
	entry.kind is InstructionType.IndexCall then Terms(entry.payload(1), at) - "index" else List(Text)
Shifted(source Text) Numbers
	Squaring.Shifted("input") is (7, 12)
	Doubling.Shifted("numbers").Length is 0
	Offsetting.Shifted("numbers") is (8, 13)
	Offsetting.Shifted("other").Length is 0
	mutable reads = List(Mutable(Number))
	for Range(position + 1, function.method.LoopEndOf(position))
		if (Offsets(value).Length > 0) and (function.method.instructions(value).texts(0) is source)
			reads.Add(value)
	reads
Sources Texts
	Doubling.Sources is ("numbers")
	mutable names = List(Mutable(Text))
	for Range(position + 1, function.method.LoopEndOf(position))
		let entry = function.method.instructions(value)
		if (entry.kind is InstructionType.IndexCall) and (entry.texts(0) is not in names)
			names.Add(entry.texts(0))
	names
Versioned Texts
	Text.Combine(Doubling.Versioned).IndexOf("cf.cond_br %f2fast, ^floop2packed, ^loop2generic") > 0
	Doubling.Versioned.Last is "  ^loop2generic:"
	Calling.Versioned.Length is 0
	Text.Combine(Summing.Versioned).IndexOf("cf.cond_br %f1ok1, ^floop1packed, ^loop1generic") > 0
	if IsSimple is false
		return List(Text)
	let fast = MlirFunction(function.types, function.type, function.method, function.lineSlots, position)
	let loop = MlirFastLoop(fast, position)
	let packed = MlirPacked(function, position)
	let copy = Renamed(loop.Started + loop.Counted + loop.Current + loop.Looped + loop.Exited, "")
	let joined = ("    cf.br ^loop" + position + "joined", "  ^loop" + position + "generic:")
	Renamed(loop.Checked, "") + packed.Branch + packed.Dispatched + copy + joined
Joined Texts
	Doubling.Joined is ("    cf.br ^loop2joined", "  ^loop2joined:")
	Calling.Joined.Length is 0
	IsSimple then ("    cf.br ^loop" + position + "joined", "  ^loop" + position + "joined:") else List(Text)
Renamed(lines Texts, letter Text) Texts
	Doubling.Renamed(("    %t2k = x", "  ^loop2:"), "") is ("    %f2k = x", "  ^floop2:")
	Doubling.Renamed(List(Text) + "  ^loop2:", "a") is List(Text) + "  ^faloop2:"
	for lines
		value.Replace("%t", "%f" + letter).Replace("^", "^f" + letter)