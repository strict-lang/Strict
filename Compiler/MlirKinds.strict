has function MlirFunction
constant Passed = InstructionEntry.Invoke(2, ("Strict/Shape", "Passed", "Strict/Boolean"), List(Number), -1)
constant NewShape = InstructionEntry.Invoke(6, ("Strict/Shape", "from", "Strict/Shape", "width"), 4, -1)
constant Width = InstructionEntry(InstructionType.FieldLoad, "width", (5, 6, -1))
constant Characters = InstructionEntry(InstructionType.FieldLoad, "characters", (5, 0, -1))
constant Indexed = InstructionEntry(InstructionType.IndexCall, "letters", (7, 4, -1))
constant Looped = (InstructionEntry.LoopBegin(4, -1), InstructionEntry.Named(InstructionType.LoadVariableToRegister, 8, "value"), InstructionEntry(InstructionType.LoopEnd, List(Text), (1)))
constant Graded = MlirKinds(MlirFunction(List(TypeEntry) + MlirFunction.Shape, MlirFunction.Shape, MethodEntry("Run", List(MemberEntry), "None", (InstructionEntry.LoadText(0, "A"), InstructionEntry.Named(InstructionType.StoreRegisterToVariable, 0, "letter"), InstructionEntry.Named(InstructionType.LoadVariableToRegister, 1, "letter"), Passed, InstructionEntry.Binary(InstructionType.Add, (1, 0, 3)), InstructionEntry.Named(InstructionType.LoadVariableToRegister, 4, "width"), NewShape, Width, Indexed) + Looped)))
KindOf(position Number, register Number) Text
	Graded.KindOf(1, 0) is "Text"
	Graded.KindOf(6, 4) is "Number"
	Graded.KindOf(0, 7) is "Number"
	let writer = Writer(position, register)
	writer < 0 then "Number" else WrittenKind(writer)
WrittenKind(writer Number) Text
	Graded.WrittenKind(3) is "Boolean"
	Graded.WrittenKind(6) is "Shape"
	Graded.WrittenKind(7) is "Number"
	let entry = function.method.instructions(writer)
	if entry.kind is InstructionType.LoadConstantToRegister
		return ConstantKind(PayloadDecoder(entry).Value(1), entry.texts)
	if entry.kind is in (InstructionType.LoadVariableToRegister, InstructionType.IndexCall)
		let variable = VariableKind(writer, entry.texts(0))
		return entry.kind is InstructionType.IndexCall then ElementKind(variable) else variable
	if entry.kind is InstructionType.Invoke
		return Short(PayloadDecoder(entry).Text(4 + entry.payload(3)))
	entry.kind is InstructionType.FieldLoad then FieldKind(writer, entry) else Calculated(writer, entry)
Calculated(writer Number, entry InstructionEntry) Text
	Graded.Calculated(4, InstructionEntry.Binary(InstructionType.Add, (1, 0, 3))) is "Text"
	Graded.Calculated(4, InstructionEntry.Binary(InstructionType.Equal, (1, 0, 3))) is "Boolean"
	if entry.kind > InstructionType.ArithmeticSeparator and entry.kind < InstructionType.BinaryOperatorsSeparator
		return "Boolean"
	if entry.kind < InstructionType.StoreSeparator or entry.kind > InstructionType.ArithmeticSeparator
		return "Number"
	let left = MlirLayout(function).Represented(KindOf(writer, entry.payload(1)))
	if left.StartsWith("List(")
		return left
	let isText = (left is "Text") or IsText(writer, entry.payload(2))
	(entry.kind is InstructionType.Add) and isText then "Text" else "Number"
IsText(position Number, register Number) Boolean
	Graded.IsText(4, 1) is true
	Graded.IsText(4, 2) is false
	MlirLayout(function).Represented(KindOf(position, register)) is "Text"
Writer(position Number, register Number) Number
	Graded.Writer(5, 1) is 2
	Graded.Writer(1, 7) is -1
	let reuse = LoadReuse(function.method.instructions)
	mutable found = -1
	for position
		found = reuse.Written(function.method.instructions(index)) is register then index else found
	found
VariableKind(position Number, name Text) Text
	Graded.VariableKind(2, "letter") is "Text"
	Graded.VariableKind(2, "width") is "Number"
	let found = Stored(position, name)
	if found < 0
		return DeclaredKind(position, name)
	let store = function.method.instructions(found)
	if store.kind is InstructionType.StoreConstantToVariable
		return ConstantKind(PayloadDecoder(store).Value(0), store.texts)
	KindOf(found, store.payload(0))
Stored(position Number, name Text) Number
	Graded.Stored(2, "letter") is 1
	Graded.Stored(2, "width") is -1
	mutable found = -1
	for position
		let entry = function.method.instructions(index)
		let isStore = (entry.kind is InstructionType.StoreRegisterToVariable) and (entry.texts(0) is name)
		let isConstant = (entry.kind is InstructionType.StoreConstantToVariable) and (entry.texts.Last is name)
		found = isStore or isConstant then index else found
	found
DeclaredKind(position Number, name Text) Text
	Graded.DeclaredKind(0, "width") is "Number"
	Graded.DeclaredKind(0, "value") is "Shape"
	Graded.DeclaredKind(11, "value") is "Number"
	let parameter = MembersKind(function.method.parameters, name)
	if parameter is not ""
		return parameter
	if name is in ("value", "characters", "elements")
		return OwnValueKind(position, name)
	let member = MembersKind(function.type.members, name)
	member is "" then "Number" else member
OwnValueKind(position Number, name Text) Text
	Graded.OwnValueKind(0, "value") is "Shape"
	Graded.OwnValueKind(11, "value") is "Number"
	let own = Short(function.type.Name)
	if name is "value"
		let looped = LoopValueKind(position)
		return looped is "" then own else looped
	if (own is "Text") or own.StartsWith("List(")
		return own
	let member = MembersKind(function.type.members, name)
	member is "" then "Number" else member
LoopValueKind(position Number) Text
	Graded.LoopValueKind(11) is "Number"
	Graded.LoopValueKind(3) is ""
	let begin = function.method.LoopBeginOf(position)
	let entry = function.method.instructions(begin)
	if entry.kind is not InstructionType.LoopBegin or function.method.LoopEndOf(begin) < position
		return ""
	entry.payload(1) is 1 then "Number" else ElementKind(KindOf(begin, entry.payload(0)))
FieldKind(writer Number, entry InstructionEntry) Text
	Graded.FieldKind(7, Width) is "Number"
	Graded.FieldKind(1, Characters) is "Text"
	let kind = KindOf(writer, entry.payload(1))
	let layout = MlirLayout(function)
	let wrapped = layout.Wrapped(kind)
	if wrapped is not ""
		return wrapped
	if layout.IsStruct(kind) is false
		return kind
	let member = MembersKind(function.TypeOf(kind).members, entry.texts(0))
	member is "" then "Number" else member
MembersKind(members List(MemberEntry), name Text) Text
	Graded.MembersKind(MlirFunction.Shape.members, "width") is "Number"
	Graded.MembersKind(MlirFunction.Shape.members, "other") is ""
	for members
		if value.Name is name
			return Short(value.typeName)
	""
ElementKind(container Text) Text
	Graded.ElementKind("List(TypeEntry)") is "TypeEntry"
	Graded.ElementKind("Text") is "Character"
	Graded.ElementKind("Number") is "Number"
	let represented = MlirLayout(function).Represented(container)
	if represented is "Text"
		return "Character"
	represented.StartsWith("List(") then represented.Substring(5, represented.Length - 6) else "Number"
ConstantKind(literal Runtime/VmValue, texts Texts) Text
	Graded.ConstantKind(VmValue.OfList(VmValue.OfText("a"), VmValue.OfText("b")), ("a", "b")) is "List(Text)"
	Graded.ConstantKind(VmValue.OfNumber(1), List(Text)) is "Number"
	Graded.ConstantKind(VmValue.OfList(List(VmValue)), ("Strict/List(Mutable(Text))")) is "List(Text)"
	if literal.kind is not "List"
		return literal.kind
	if literal.items.Length is 0
		return texts.Length is 0 then "List(Number)" else Short(texts(0))
	"List(" + ConstantKind(literal.items.First, List(Text)) + ")"
Short(name Text) Text
	Graded.Short("Strict/Bytecode/TypeEntry") is "TypeEntry"
	Graded.Short("Strict/List(TypeEntry)") is "List(TypeEntry)"
	Graded.Short("Number") is "Number"
	Graded.Short("Strict/List(Mutable(Text))") is "List(Text)"
	if name.IndexOf("Mutable(") is not -1
		return Short(name.Replace("Mutable(", "").Substring(0, name.Length - 9))
	let open = name.IndexOf("(")
	let head = open < 0 then name else name.Substring(0, open)
	let slash = head.LastIndexOf("/")
	slash < 0 then name else name.Substring(slash + 1, name.Length - slash - 1)