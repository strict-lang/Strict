has function MlirFunction
constant Degrees = TypeEntry("Strict/Degrees", (MemberEntry("number", "Strict/Number", List(InstructionEntry), false, 32)), List(MethodEntry))
constant Angle = TypeEntry("Strict/Angle", (MemberEntry("degrees", "Strict/Degrees", List(InstructionEntry), false)), List(MethodEntry))
constant Wrapping = MlirLayout(MlirFunction(List(TypeEntry) + MlirFunction.Shape + Degrees + Angle, Degrees, MethodEntry.CountingLoop))
constant Widened = (InstructionEntry.LoadNumber(0, 2), InstructionEntry.Named(InstructionType.StoreRegisterToVariable, 0, "width"), InstructionEntry.Return(0))
constant Packing = MlirLayout(MlirFunction(List(TypeEntry) + MlirFunction.Shape, MlirFunction.Shape, MethodEntry("from", List(MemberEntry), "Strict/Shape", Widened)))
constant LoggerField = InstructionEntry(InstructionType.FieldLoad, "logger", (2, 1, -1))
constant Logged = MlirFunction(List(TypeEntry) + MlirFunction.Shape, MlirFunction.Shape, MethodEntry("Run", List(MemberEntry), "None", (InstructionEntry.LoadNumber(0, 3), MlirInstances.Built, LoggerField)))
constant Eights = MlirFunction(List(TypeEntry) + MlirFunction.Shape, MlirFunction.Shape, MethodEntry("Packed", List(MemberEntry) + MemberEntry("numbers", "Strict/List(Number)", List(InstructionEntry), false), "Strict/Float8s", (MethodCodegen.StoreConstant(InstructionEntry(InstructionType.LoadConstantToRegister, "Strict/Float8s", (0, 6, -1, 0)), "forResult"), InstructionEntry.Named(InstructionType.LoadVariableToRegister, 0, "numbers"), InstructionEntry.LoopBegin(0, -1), InstructionEntry.Named(InstructionType.LoadVariableToRegister, 1, "value"), InstructionEntry.Named(InstructionType.InvokeWriteToList, 1, "forResult"), InstructionEntry.Jump(InstructionType.LoopEnd, 3), InstructionEntry.Named(InstructionType.LoadVariableToRegister, 0, "forResult"), InstructionEntry.Return(0))), List(Number), -1, "", "f32")
IsAliased(entry InstructionEntry, position Number) Boolean
	MlirLayout(MlirInstances.Shapes).IsAliased(MlirInstances.Width, 2) is false
	MlirLayout(Logged).IsAliased(LoggerField, 2)
	MlirLayout(MlirKinds.Graded.function).IsAliased(MlirKinds.Characters, 1)
	let kinds = MlirKinds(function)
	let isValue = (entry.texts(0) is "value") or (IsStruct(kinds.KindOf(position, entry.payload(1))) is false)
	isValue or (TypeEntry.ShortName(kinds.WrittenKind(position)) is "Logger")
IsStruct(typeName Text) Boolean
	Wrapping.IsStruct("Shape")
	Wrapping.IsStruct("Strict/Degrees") is false
	Wrapping.IsStruct("List(Number)") is false
	let isStruct = function.TypeOf(TypeEntry.ShortName(typeName)).IsStruct
	isStruct and (MlirCouples(function, 0).IsCoupled(typeName) is false)
Constructed(entry InstructionEntry, typeName Text, temp Text) Texts
	Wrapping.Constructed(MlirInstances.Built, "Strict/Angle", "%t1o").Length is 2
	Wrapping.Constructed(MlirInstances.Built, "Strict/Degrees", "%t1o")(1) is "    %t1on = arith.truncf %t1o : f64 to f32"
	let source = "%r" + entry.payload(5 + entry.payload(3) + 1)
	let type = function.TypeOf(typeName)
	let isSingle = type.Wrapped is "Number" then type.Changing.First.Bits is 32 else false
	if isSingle is false
		return function.Copied(source, "%r" + entry.payload(0), temp)
	let narrowed = "    " + temp + "n = arith.truncf " + temp + " : f64 to f32"
	let widened = "    " + temp + "w = arith.extf " + temp + "n : f32 to f64"
	(function.Load(temp, source), narrowed, widened, function.Store(temp + "w", "%r" + entry.payload(0)))
Represented(kind Text) Text
	Wrapping.Represented("Angle") is "Number"
	Wrapping.Represented("Shape") is "Shape"
	Wrapping.Represented("Texts") is "List(Text)"
	Wrapping.Represented("Dictionary(Text, Number)") is "List(List(Text, Number))"
	if kind is in ("Texts", "Numbers", "Booleans")
		return "List(" + kind.Substring(0, kind.Length - 1) + ")"
	if kind.StartsWith("Dictionary(")
		return "List(" + Represented(MethodBodies.Item(kind.Substring(11, kind.Length - 12))) + ")"
	let packed = MlirFlats(function, 0).Kind(kind)
	if packed is not ""
		return packed
	Wrapped(kind) is "" then kind else Represented(Wrapped(kind))
Wrapped(typeName Text) Text
	Wrapping.Wrapped("Angle") is "Degrees"
	Wrapping.Wrapped("Shape") is ""
	Wrapping.Wrapped("Number") is ""
	function.TypeOf(TypeEntry.ShortName(typeName)).Wrapped
IsInitializer Boolean
	Wrapping.IsInitializer is false
	Packing.IsInitializer
	IsStruct(function.type.Name) and function.method.IsInitializer(MlirInstances(function, 0).Stored(function.type))
Returned(position Number) Texts
	Wrapping.Returned(-2) is ("    return %zero : f64")
	Packing.Returned(2).Last is "    return %t2nf : f64"
	if IsInitializer is false
		return List(Text) + "    return %zero : f64"
	let memory = MlirMemory(function, position)
	mutable lines = memory.Allocated(MlirInstances(function, 0).Stored(function.type).Length, "n")
	for MlirInstances(function, 0).Stored(function.type)
		let temp = memory.Temp("v" + index)
		let copied = (function.Load(temp, "%v_" + value.Name), function.Store(temp, memory.Temp("n" + index)))
		lines = lines + memory.Slot(memory.Temp("np"), index, "n" + index) + copied
	lines = lines + MlirMemory.Counted.Replace("%p", memory.Temp("np")).Replace("%z", memory.Temp("nz"))
	lines + memory.Bits(memory.Temp("np"), "n") + ("    return " + memory.Temp("nf") + " : f64")
Paired(kind Text) Texts
	Wrapping.Paired("List(Text, Number)") is ("Text", "Number")
	Wrapping.Paired("Dictionary(Text, Shape)") is ("Text", "Shape")
	Wrapping.Paired("Texts").Length is 0
	Wrapping.Paired("Dictionary(Number, Number)") is ("Number", "Number")
	if kind.StartsWith("Dictionary(")
		return MethodBodies.Pair("List(" + kind.Substring(11, kind.Length - 12) + ")")
	let represented = Represented(kind)
	let pair = MethodBodies.Pair(represented)
	pair.Length > 0 then pair else MethodBodies.Pair(MlirKinds(function).ElementKind(represented))
Packed(position Number) Number
	MlirLayout(Eights).Packed(2) is 7
	Wrapping.Packed(0) is 0
	let kind = MlirKinds(function).VariableKind(position, "forResult")
	kind is in ("Float8s", "List(Float8)") then 7 else 0
Collected(register Text, pointer Text, at Number) Texts
	MlirLayout(Eights).Collected("%d", "%p", 4)(1) is "    %db = func.call @strict_device_float8(%d) : (f32) -> i8"
	MlirLayout(MlirDeviceStatements.Doubled).Collected("%d", "%p", 5)(5) is "    llvm.store %d, %p : f64, !llvm.ptr"
	MlirLayout(MlirDeviceStatements.Doubled).Collected("%d", "%p", 5).Last is "  ^d5stored:"
	function.Float is "f64" then Narrowed(register, pointer, at) else Stored(register, pointer, at)
Stored(register Text, pointer Text, at Number) Texts
	MlirLayout(Eights).Stored("%d", "%p", 4).Last is "    llvm.store %db, %p : i8, !llvm.ptr"
	let address = "    " + pointer + " = llvm.getelementptr %result[%at]" + MlirFastLoop.Pointer
	if Packed(function.method.LoopBeginOf(at)) is 0
		return (address + "f32", "    llvm.store " + register + ", " + pointer + " : f32, !llvm.ptr")
	let encoded = "    " + register + "b = func.call @strict_device_float8(" + register + ") : (f32) -> i8"
	(address + "i8", encoded, "    llvm.store " + register + "b, " + pointer + " : i8, !llvm.ptr")
Narrowed(register Text, pointer Text, at Number) Texts
	MlirLayout(MlirDeviceStatements.Doubled).Narrowed("%d", "%p", 5)(3) is "    cf.cond_br %pv, ^d5wide, ^d5narrow"
	let address = "    " + pointer + " = llvm.getelementptr %result[%at]" + MlirFastLoop.Pointer + "f64"
	let compared = "    " + pointer + "v = arith.cmpi eq, %results, " + pointer + "w : i64"
	let branch = "    cf.cond_br " + pointer + "v, ^d" + at + "wide, ^d" + at + "narrow"
	let wide = (address, MlirTyped.Integer.Constant(pointer + "w", "64"), compared, branch, "  ^d" + at + "wide:")
	let truncated = "    " + register + "n = arith.truncf " + register + " : f64 to f32"
	let narrow = ("    cf.br ^d" + at + "stored", "  ^d" + at + "narrow:", truncated)
	let stored = Stored(register + "n", pointer + "n", at) + ("    cf.br ^d" + at + "stored", "  ^d" + at + "stored:")
	(wide + function.Store(register, pointer)) + narrow + stored
