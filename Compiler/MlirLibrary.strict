has types List(TypeEntry)
constant Mode = MemberEntry("mode", "Strict/Text", List(InstructionEntry), false)
constant Enabled = MemberEntry("enabled", "Strict/Boolean", List(InstructionEntry), false)
constant Start = MethodEntry("Start", (Mode, Enabled), "Strict/Text", (InstructionEntry.LoadText(0, "x"), InstructionEntry.Return(0)))
constant Policy = MlirLibrary(List(TypeEntry) + TypeEntry("Strict/Policy", List(MemberEntry), (Start, MethodEntry.CountingLoop)))
constant Entered = ("    %frameLevel = arith.constant 0 : i32", "    %stackBase = llvm.call_intrinsic \"llvm.frameaddress.p0\"(%frameLevel) : (i32) -> !llvm.ptr", "    func.call @strict_library_enter(%stackBase) : (!llvm.ptr) -> ()", "    %self = arith.constant 0.0 : f64")
constant Checked = ("    %failed = func.call @strict_is_failure(%value) : (f64) -> i1", "    cf.cond_br %failed, ^failed, ^done", "  ^failed:", "    %code = func.call @strict_library_failed(%value) : (f64) -> i32", "    return %code : i32", "  ^done:")
constant TextResult = "    %text = func.call @strict_library_text(%value) : (f64) -> !llvm.ptr"
constant Finished = ("    %ok = arith.constant 0 : i32", "    return %ok : i32", "  }")
Text Text
	Policy.Text.StartsWith("module {") is true
	Policy.Text.IndexOf("  func.func @Policy_Start(") > 0 is true
	let module = MlirModule(types, Exported.First.Name)
	mutable roots = List(Mutable(MlirFunction))
	mutable wrappers = List(Mutable(Text))
	for Exported
		roots.Add(MlirFunction(types, types.First, value))
		wrappers = wrappers + Wrapper(value)
	let functions = module.Reachable(roots, roots)
	Text.Combine(module.Declared(functions, functions) + MlirGlobals(functions).Lines + wrappers + "}", "\n")
Exported List(MethodEntry)
	Policy.Exported is List(MethodEntry) + Start
	for types.First.methods
		if IsExported(value)
			value
IsExported(method MethodEntry) Boolean
	Policy.IsExported(Start) is true
	Policy.IsExported(MethodEntry.CountingLoop) is false
	let first = method.Name.Substring(0, 1)
	let isNamed = (first.Upper is first) and (first.Lower is not first)
	let isPublic = isNamed and (method.Name is not in ("Run", TestCodegen.Runner))
	mutable isSupported = Kind(method.returnType) is not ""
	for method.parameters
		isSupported = isSupported and (Kind(value.typeName) is not "")
	let isPlain = MlirInstances(MlirFunction(types, types.First, method), 0).Stored(types.First).Length is 0
	isPublic and isSupported and isPlain
Kind(typeName Text) Text
	Policy.Kind("Strict/Text") is "!llvm.ptr"
	Policy.Kind("Strict/Numbers") is ""
	let name = TypeEntry.ShortName(typeName)
	name is "Number" then "f64" else name is "Text" then "!llvm.ptr" else name is "Boolean" then "i32" else ""
Wrapper(method MethodEntry) Texts
	Policy.Wrapper(Start).First is "  func.func @Policy_Start(%a0: !llvm.ptr, %a1: i32, %result: !llvm.ptr) -> i32 {"
	Policy.Wrapper(Start).Index("    %v1 = arith.sitofp %a1 : i32 to f64") > 0 is true
	mutable parameters = List(Mutable(Text))
	mutable arguments = List(Mutable(Text))
	for method.parameters
		parameters.Add("%a" + index + ": " + Kind(value.typeName))
		arguments.Add(Argument(value.typeName, index))
	let name = TypeEntry.ShortName(types.First.Name) + "_" + method.Name
	let header = "  func.func @" + name + "(" + Text.Combine(parameters + "%result: !llvm.ptr", ", ") + ") -> i32 {"
	List(Text) + header + Entered + arguments + Call(method) + Checked + Stored(method.returnType) + Finished
Call(method MethodEntry) Text
	Policy.Call(Start) is "    %value = func.call @Policy_Start_2(%self, %v0, %v1) : (f64, f64, f64) -> f64"
	let function = MlirFunction(types, types.First, method)
	mutable operands = List(Text) + "%self"
	for method.parameters
		operands = operands + ("%v" + index)
	let signature = Text.Combine(MlirCalls(function, 0).ArgumentTypes(operands.Length), ", ")
	"    %value = func.call @" + function.Symbol + "(" + Text.Combine(operands, ", ") + ") : (" + signature + ") -> f64"
Argument(typeName Text, position Number) Text
	Policy.Argument("Strict/Text", 0).EndsWith("@strict_bits(%a0) : (!llvm.ptr) -> f64") is true
	let target = "    %v" + position + " = "
	let kind = Kind(typeName)
	if kind is "f64"
		return target + "arith.addf %a" + position + ", %self : f64"
	if kind is "i32"
		return target + "arith.sitofp %a" + position + " : i32 to f64"
	target + "func.call @strict_bits(%a" + position + ") : (!llvm.ptr) -> f64"
Stored(returnType Text) Texts
	Policy.Stored("Strict/Number").First.StartsWith("    llvm.store %value") is true
	let kind = Kind(returnType)
	if kind is "f64"
		return List(Text) + "    llvm.store %value, %result : f64, !llvm.ptr"
	if kind is "i32"
		return ("    %flag = arith.fptosi %value : f64 to i32", "    llvm.store %flag, %result : i32, !llvm.ptr")
	(TextResult, "    llvm.store %text, %result : !llvm.ptr, !llvm.ptr")
