has function MlirFunction
has mainName Text = ""
has mainFile Text = ""
constant Twice = MethodEntry("Twice", List(MemberEntry), "Strict/Number", (InstructionEntry(InstructionType.LoadConstantToRegister, List(Text), (0, 1, 7), 2), InstructionEntry(InstructionType.LoadConstantToRegister, List(Text), (1, 1, 8), 2), InstructionEntry(InstructionType.Return, List(Text), List(Number) + 0, 3)))
constant Lined = MlirFunction(List(TypeEntry), MlirFunction.Shape, Twice, (4, 5))
constant Jumped = MlirFunction(List(TypeEntry), MlirFunction.Shape, MethodEntry("Jump", List(MemberEntry), "None", (InstructionEntry(InstructionType.LoadConstantToRegister, List(Text), (0, 1, 7), 2), InstructionEntry(InstructionType.LoadConstantToRegister, List(Text), (1, 1, 8), 3), InstructionEntry(InstructionType.JumpEnd, List(Text), List(Number) + 0, 2))), (0, 1))
constant Unlined = MlirFunction(List(TypeEntry), MlirFunction.Shape, Twice)
constant State = ("    %linetable = llvm.mlir.addressof @strict_lines : !llvm.ptr", "    %linecount = arith.constant 2 : i64", "    %linestate = llvm.alloca %linecount x f64 : (i64) -> !llvm.ptr", "    %linenone = arith.constant -1.0 : f64", "    llvm.store %linenone, %linestate : f64, !llvm.ptr")
constant Stop = "    func.call @strict_line_stop(%linetable, %linestate) : (!llvm.ptr, !llvm.ptr) -> ()"
constant Signature = " : (!llvm.ptr, i64, !llvm.ptr) -> ()"
constant Shaped = TypeEntry("Strict/Shape", List(MemberEntry), (Twice, MethodEntry.CountingLoop))
constant Shapes = List(MlirFunction) + Unlined
constant Printer = ("  func.func private @strict_lines_print() {", "    %linetable = llvm.mlir.addressof @strict_lines : !llvm.ptr")
constant Print = "    func.call @strict_lines_print() : () -> ()"
constant Module = MlirModule(List(TypeEntry) + TypeEntry("Strict/Lined", List(MemberEntry), List(MethodEntry) + Twice), "Twice", "Lined.strict")
Numbers Numbers
	MlirLines(Lined).Numbers is (2, 3)
	mutable numbers = List(Mutable(Number))
	for function.method.instructions
		if (value.line > 0) and (value.line is not in numbers)
			numbers.Add(value.line)
	numbers
Allocated Texts
	MlirLines(Lined).Allocated is State
	MlirLines(Unlined).Allocated.Length is 0
	function.IsCounted then State else List(Text)
At(position Number) Texts
	MlirLines(Lined).At(0).Length is 2
	MlirLines(Lined).At(1).Length is 0
	MlirLines(Lined).At(2).Length is 3
	MlirLines(Unlined).At(0).Length is 0
	MlirLines(Jumped).At(2).Length is 0
	if function.IsCounted is false
		return List(Text)
	let entry = function.method.instructions(position)
	let previous = position > 0 then function.method.instructions(position - 1).line else 0
	let isStart = (entry.line > 0) and (entry.kind is not InstructionType.JumpEnd) and (entry.line is not previous)
	let started = isStart then Started(position, entry.line) else List(Text)
	entry.kind is InstructionType.Return then started + Stop else started
Started(position Number, line Number) Texts
	MlirLines(Lined).Started(2, 3).First is "    %line2 = arith.constant 5 : i64"
	let slot = function.lineSlots(Numbers.Index(line))
	let call = "    func.call @strict_line(%linetable, %line" + position + ", %linestate)" + Signature
	("    %line" + position + " = arith.constant " + slot + " : i64", call)
End Texts
	MlirLines(Lined).End is List(Text) + Stop
	MlirLines(Unlined).End.Length is 0
	function.IsCounted then List(Text) + Stop else List(Text)
Placed Texts
	MlirLines(Lined).Placed is ("Shape.strict:2", "Shape.strict:3")
	MlirLines(Lined, "Strict/Shape", "Examples/Shape.strict").Placed.First is "Examples/Shape.strict:2"
	let file = function.type.Name is mainName then mainFile else function.type.File
	for Numbers
		file + ":" + value
Indexes(places Texts) Numbers
	MlirLines(Unlined).Indexes(("Other.strict:1", "Shape.strict:3", "Shape.strict:2")) is (2, 1)
	for Placed
		places.Index(value)
Places(functions List(MlirFunction), main TypeEntry, file Text) Texts
	MlirLines.Places((Lined, Unlined), MlirFunction.Shape, "Shape.strict") is ("Shape.strict:2", "Shape.strict:3")
	mutable places = List(Mutable(Text))
	for functions
		for MlirLines(value, main.Name, file).Placed
			if value is not in places
				places.Add(value)
	places
Uncompiled(functions List(MlirFunction), main TypeEntry) List(MlirFunction)
	MlirLines.Uncompiled(List(MlirFunction) + Lined, Shaped).Length is 1
	let symbols = MlirModule.Counters.Symbols(functions)
	mutable uncompiled = List(Mutable(MlirFunction))
	for main.methods
		let candidate = MlirFunction(functions.First.types, main, value)
		if candidate.Symbol is not in symbols
			uncompiled.Add(candidate)
	uncompiled
Counted(functions List(MlirFunction), main TypeEntry, file Text) List(MlirFunction)
	MlirLines.Counted(Shapes, MlirFunction.Shape, "Shape.strict").First.lineSlots is (0, 1)
	Module.Text.IndexOf(Print) > 0 is true
	let places = Places(functions + Uncompiled(functions, main), main, file)
	for functions
		MlirFunction(value.types, value.type, value.method, MlirLines(value, main.Name, file).Indexes(places))
Table(functions List(MlirFunction), main TypeEntry, file Text) Texts
	MlirLines.Table(Shapes, MlirFunction.Shape, "Shape.strict").First.IndexOf("tensor<4xf64>") > 0 is true
	let places = Places(functions + Uncompiled(functions, main), main, file)
	let size = places.Length * 2
	let table = "  llvm.mlir.global internal @strict_lines(dense<0.0> : tensor<" + size + "xf64>)"
	mutable lines = List(Text) + (table + " : !llvm.array<" + size + " x f64>")
	mutable printer = Printer
	for places
		lines = lines + MlirLines(functions.First).Named(value, index)
		printer = printer + Printed(index)
	lines + printer + ("    return", "  }")
Named(place Text, index Number) Text
	MlirLines(Lined).Named("A.strict:2", 0).EndsWith("place0(\"A.strict:2\\00\") : !llvm.array<11 x i8>") is true
	let constants = MlirConstants(function, 0)
	let length = constants.EscapedLength(place, false) + 1
	let escaped = "(\"" + constants.Escaped(place, false) + "\\00\") : !llvm.array<" + length
	"  llvm.mlir.global internal constant @strict_line_place" + index + escaped + " x i8>"
Printed(index Number) Texts
	MlirLines(Lined).Printed(3).Last.IndexOf("@strict_line_print(%linetable, %lineindex3, %lineplace3)") > 0 is true
	let place = "    %lineplace" + index + " = llvm.mlir.addressof @strict_line_place" + index + " : !llvm.ptr"
	let position = "    %lineindex" + index + " = arith.constant " + index + " : i64"
	let call = "    func.call @strict_line_print(%linetable, %lineindex" + index + ", %lineplace" + index + ")"
	(place, position, call + Signature)