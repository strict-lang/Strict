has function MlirFunction
has position Number
constant Operators = (InstructionType.Add, InstructionType.Subtract, InstructionType.Multiply, InstructionType.Divide, InstructionType.Modulo)
constant Steps = MlirLists.Listed.method.instructions
constant WordSteps = (InstructionEntry.Named(InstructionType.LoadVariableToRegister, 0, "words"), InstructionEntry.LoadNumber(1, 3), InstructionEntry.Binary(InstructionType.Add, (0, 1, 2)))
constant Worded = MlirFunction(List(TypeEntry) + MlirFunction.Shape, MlirFunction.Shape, MethodEntry("Run", List(MemberEntry) + MlirLists.Words, "None", WordSteps))
constant NumbersSubtracted = (InstructionEntry.Named(InstructionType.LoadVariableToRegister, 0, "numbers"), InstructionEntry.LoadNumber(1, 2), InstructionEntry.Binary(InstructionType.Subtract, (0, 1, 2)))
constant ResultsCombined = (InstructionEntry.Binary(InstructionType.Multiply, (0, 0, 3)), InstructionEntry.Binary(InstructionType.Divide, (0, 1, 4)), InstructionEntry.Binary(InstructionType.Add, (1, 0, 5)))
constant Arithmetic = NumbersSubtracted + ResultsCombined
constant Remainder = InstructionEntry.Binary(InstructionType.Modulo, (0, 1, 2))
constant ModuloSteps = NumbersSubtracted.Slice(0, 2) + Remainder
constant WordsAdded = (InstructionEntry.Named(InstructionType.LoadVariableToRegister, 0, "numbers"), InstructionEntry.Named(InstructionType.LoadVariableToRegister, 1, "words"), InstructionEntry.Binary(InstructionType.Add, (0, 1, 2)))
constant Downcast = MlirFunction(List(TypeEntry) + MlirFunction.Shape, MlirFunction.Shape, MethodEntry("Run", (MlirLists.Items, MlirLists.Words), "None", WordsAdded))
constant Moduled = MlirFunction(List(TypeEntry) + MlirFunction.Shape, MlirFunction.Shape, MethodEntry("Run", List(MemberEntry) + MlirLists.Items, "None", ModuloSteps))
constant Mixed = MlirFunction(List(TypeEntry) + MlirFunction.Shape, MlirFunction.Shape, MethodEntry("Run", List(MemberEntry) + MlirLists.Items, "None", Arithmetic))
IsOperation Boolean
	MlirListOperators(MlirLists.Listed, 4).IsOperation
	MlirListOperators(MlirLists.Listed, 1).IsOperation is false
	MlirListOperators(Mixed, 5).IsOperation
	MlirListOperators(Moduled, 2).IsOperation
	entry = function.method.instructions(position)
	if entry.kind is not in Operators
		return false
	IsList(entry.payload(1)) or entry.kind is InstructionType.Add and IsList(entry.payload(2))
IsList(register Number) Boolean
	MlirListOperators(Mixed, 2).IsList(0)
	MlirListOperators(Mixed, 2).IsList(1) is false
	MlirLayout(function).Represented(MlirKinds(function).KindOf(position, register)).StartsWith("List(")
ElementSuffix(register Number) Text
	MlirListOperators(Mixed, 2).ElementSuffix(0) is "number"
	MlirListOperators(Worded, 2).ElementSuffix(0) is "text"
	MlirKinds(function).ElementKind(MlirKinds(function).KindOf(position, register)) is "Text" then "text" else "number"
Helper(entry InstructionEntry) Text
	MlirListOperators(Mixed, 2).Helper(Arithmetic(2)) is "strict_list_removed"
	MlirListOperators(Mixed, 3).Helper(Arithmetic(3)) is "strict_list_times"
	MlirListOperators(Mixed, 4).Helper(Arithmetic(4)) is "strict_list_divided_number"
	MlirListOperators(Mixed, 2).Helper(Remainder) is "strict_list_modulo_number"
	MlirListOperators(Mixed, 5).Helper(Arithmetic(5)) is "strict_list_prepend"
	isList = IsList(entry.payload(2))
	if entry.kind is InstructionType.Subtract
		return isList then "strict_list_without" else "strict_list_removed"
	if entry.kind is InstructionType.Add
		return Added(entry, isList)
	division = entry.kind is InstructionType.Modulo then "strict_list_modulo" else "strict_list_divided"
	operation = entry.kind is InstructionType.Multiply then "strict_list_times" else division
	isList then operation else operation + "_number"
Added(entry InstructionEntry, isList Boolean) Text
	MlirListOperators(Mixed, 5).Added(Arithmetic(5), false) is "strict_list_prepend"
	MlirListOperators(Downcast, 2).Added(Downcast.method.instructions(2), true) is "strict_list_downcast"
	if IsList(entry.payload(1)) is false
		return "strict_list_prepend"
	isNumbers = ElementSuffix(entry.payload(1)) is "number"
	isDowncast = isList and isNumbers and ElementSuffix(entry.payload(2)) is "text"
	isDowncast then "strict_list_downcast" else (isList then "strict_list_concat" else Adder)
Adder Text
	MlirListOperators(MlirAppended.Filling.function, 4).Adder is "strict_list_add_seeded"
	MlirListOperators(MlirLists.Listed, 4).Adder is "strict_list_add"
	appended = MlirAppended(function, position)
	if appended.IsOwned is false
		return "strict_list_add"
	appended.Seed is "" then "strict_list_add_owned" else "strict_list_add_seeded"
Operands(entry InstructionEntry) Texts
	MlirListOperators(MlirAppended.Filling.function, 4).Operands(MlirAppended.Added(0)).Length is 3
	MlirListOperators(MlirLists.Listed, 4).Operands(Steps(4)).Length is 2
	names = MlirLists(function, position)
	plain = (names.Temp("a"), names.Temp("b"))
	Helper(entry) is "strict_list_add_seeded" then plain + names.Temp("s") else plain
Seeding(entry InstructionEntry) Texts
	MlirListOperators(MlirAppended.Filling.function, 4).Seeding(MlirAppended.Added(0)).First.IndexOf("%v_numbers") > 0
	MlirListOperators(MlirLists.Listed, 4).Seeding(Steps(4)).Length is 0
	if Helper(entry) is not "strict_list_add_seeded"
		return List(Text)
	seed = MlirLists(function, position).Temp("s")
	List(Text) + function.Load(seed, "%v_" + MlirAppended(function, position).Seed)
Operated(entry InstructionEntry) Texts
	MlirListOperators(MlirLists.Listed, 4).Operated(Steps(4)).Length is 4
	Text.Combine(MlirListOperators(MlirLists.Listed, 5).Operated(Steps(5)), "").IndexOf("strict_list_concat") > 0
	MlirListOperators(MlirAppended.Filling.function, 4).Operated(MlirAppended.Added(0))(3).IndexOf("_seeded(") > 0
	names = MlirLists(function, position)
	result = names.Temp("c")
	kinds = MlirKinds(function)
	element = MlirLayout(function).Represented(kinds.ElementKind(kinds.KindOf(position, entry.payload(1))))
	call = MlirMemory(function, position).Passed(result, Helper(entry), Operands(entry), element)
	left = function.Load(names.Temp("a"), "%r" + entry.payload(1))
	right = RightOperand(entry, IsList(entry.payload(2)))
	(List(Text) + left + right) + Seeding(entry) + call + function.Store(result, "%r" + entry.payload(3))
RightOperand(entry InstructionEntry, isList Boolean) Texts
	Text.Combine(MlirListOperators(Worded, 2).RightOperand(WordSteps(2), false)).IndexOf("strict_number_text") > 0
	MlirListOperators(MlirLists.Listed, 4).RightOperand(Steps(4), false).Length is 1
	kinds = MlirKinds(function)
	right = kinds.KindOf(position, entry.payload(2))
	isNumbers = (isList then kinds.ElementKind(right) else right) is "Number"
	needsTexts = isNumbers and kinds.ElementKind(kinds.KindOf(position, entry.payload(1))) is "Text"
	helper = isList then "strict_list_texts" else "strict_number_text"
	names = MlirLists(function, position)
	raw = function.Load(names.Temp(needsTexts then "br" else "b"), "%r" + entry.payload(2))
	converted = MlirMemory(function, position).Called(names.Temp("b"), helper, List(Text) + names.Temp("br"))
	needsTexts then (raw, converted) else List(Text) + raw