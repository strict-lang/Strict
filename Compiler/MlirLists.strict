has function MlirFunction
has position Number
has named Text = ""
constant Items = MemberEntry("numbers", "Strict/List(Number)", List(InstructionEntry), false)
constant Steps = (InstructionEntry.Named(InstructionType.LoadVariableToRegister, 0, "numbers"), InstructionEntry.LoadNumber(1, 0), InstructionEntry(InstructionType.IndexCall, "numbers", (2, 1, -1)), InstructionEntry.Named(InstructionType.InvokeWriteToList, 1, "numbers"), InstructionEntry.Binary(InstructionType.Add, (0, 1, 3)), InstructionEntry.Binary(InstructionType.Add, (0, 0, 3)))
constant Listed = MlirFunction(List(TypeEntry) + MlirFunction.Shape, MlirFunction.Shape, MethodEntry("Run", List(MemberEntry) + Items, "None", Steps))
constant Written = MlirFunction(List(TypeEntry) + MlirFunction.Shape, MlirFunction.Shape, MethodEntry("Run", List(MemberEntry) + Items, "None", (InstructionEntry.LoadNumber(0, 7), InstructionEntry.Named(InstructionType.StoreRegisterToVariable, 0, "numbers(1)"), InstructionEntry(InstructionType.CopyList, "numbers", -1))))
constant Pair = VmValue.OfList(VmValue.OfNumber(1), VmValue.OfText("a"))
constant Removal = InstructionEntry.Named(InstructionType.InvokeRemove, 1, "numbers")
constant Hoisting = MlirLists(MlirParameters.Reading.function, 1)
constant MemberCopy = InstructionEntry(InstructionType.CopyList, "numbers.width", -1)
constant Pushing = InstructionEntry.Named(InstructionType.InvokeWriteToList, 1, "forResult")
constant Versioning = InstructionEntry(InstructionType.StoreRegisterToVariable, "numbers(1)", (0, -1, 1))
constant Words = MemberEntry("words", "Strict/List(Text)", List(InstructionEntry), false)
constant Literals = MlirFunction(List(TypeEntry) + MlirFunction.Shape, MlirFunction.Shape, MethodEntry("Run", List(MemberEntry), "None", List(InstructionEntry) + InstructionEntry(InstructionType.LoadConstantToRegister, "Strict/List(Number)", (0, 6, -1, 2, 1, 1, 1, 2))))
Temp(suffix Text) Text
	MlirLists(Listed, 2).Temp("l") is "%t2l"
	"%t" + position + suffix
Emitted Texts
	MlirLists(Listed, 3).Emitted.Length is 4
	MlirLists(Written, 2).Emitted.Length is 3
	if function.FastLoop >= 0
		return MlirFastLoop(function, function.FastLoop).Emitted(position)
	let entry = function.method.instructions(position)
	if entry.kind is InstructionType.CopyList
		return Copied(entry)
	if IsElementStore
		return ElementStored(entry)
	entry.kind is InstructionType.IndexCall then Indexed(entry) else Appended(entry)
Literal(literal Runtime/VmValue, slot Text, suffix Text) Texts
	MlirLists(Listed, 0).Literal(Pair, "%v_a", "").Last is "    llvm.store %t0e1l, %v_a : f64, !llvm.ptr"
	MlirLists(Listed, 0).Literal(VmValue.OfList(List(VmValue)), "%v_a", "").Length is 2
	MlirLists(Literals, 0).Literal(Pair, "%r0", "").First is "    %t0g = llvm.mlir.addressof @lShape_Run_0_0 : !llvm.ptr"
	MlirLists(Literals, 0).Literal(Pair, "%r0", "").Last is "    llvm.store %t0r, %r0 : f64, !llvm.ptr"
	let count = literal.items.Length
	let result = count is 0 then Temp(suffix + "l") else Temp(suffix + "e" + (count - 1) + "l")
	if (suffix is not "") or (count is 0) or (MlirConstants(function, position).IsConstant is false)
		return Built(literal, suffix) + function.Store(result, slot)
	Cached(Built(literal, suffix), result, "strict_list_pin") + function.Store(Temp("r"), slot)
Built(literal Runtime/VmValue, suffix Text) Texts
	MlirLists(Listed, 0).Built(Pair, "").Last.IndexOf("%t0e1l = func.call @strict_list_add(%t0e0l, %t0e1xf)") > 0
	let memory = MlirMemory(function, position)
	mutable lines = Created(literal.items.Length, suffix)
	mutable current = Temp(suffix + "l")
	for literal.items
		let element = suffix + "e" + index
		let added = memory.Called(Temp(element + "l"), "strict_list_add", (current, ElementName(value, element)))
		lines = lines + Element(value, index, element) + added
		current = Temp(element + "l")
	lines
Cached(built Texts, result Text, pin Text) Texts
	MlirLists(Literals, 0).Cached(List(Text), "%x", "pin").Index("    cf.cond_br %t0u, ^l0, ^m0(%t0v : f64)") is 3
	MlirLists(Literals, 0).Cached(List(Text), "%x", "pin").Index("    func.call @pin(%x) : (f64) -> ()") is 5
	let address = "    " + Temp("g") + " = llvm.mlir.addressof " + MlirConstants(function, position).Cache + " : !llvm.ptr"
	let unset = "    " + Temp("u") + " = arith.cmpf oeq, " + Temp("v") + ", %zero : f64"
	let branch = "    cf.cond_br " + Temp("u") + ", ^l" + position + ", ^m" + position + "(" + Temp("v") + " : f64)"
	let starts = (address, function.Load(Temp("v"), Temp("g")), unset, branch, "  ^l" + position + ":")
	let pinned = "    func.call @" + pin + "(" + result + ") : (f64) -> ()"
	let joined = ("    cf.br ^m" + position + "(" + result + " : f64)", "  ^m" + position + "(" + Temp("r") + ": f64):")
	starts + built + pinned + function.Store(result, Temp("g")) + joined
Created(count Number, suffix Text) Texts
	MlirLists(Listed, 0).Created(0, "").First is "    %t0l = func.call @strict_list_empty() : () -> f64"
	let memory = MlirMemory(function, position)
	if count is 0
		return List(Text) + memory.Called(Temp(suffix + "l"), "strict_list_empty", List(Text))
	let size = MlirStatements(function, position).Hex(count + 4)
	let capacity = "    " + Temp(suffix + "q") + " = arith.constant " + size + " : f64"
	(capacity, memory.Called(Temp(suffix + "l"), "strict_list_new", (Temp(suffix + "q"), "%zero")))
Element(item Runtime/VmValue, index Number, element Text) Texts
	MlirLists(Listed, 0).Element(VmValue.OfNumber(2), 0, "e0") is ("    %t0e0c = arith.constant 0x4000000000000000 : f64")
	MlirLists(Listed, 0, "@dA_b").Element(VmValue.OfText("a"), 0, "e0").First.IndexOf(" @dA_b_0 ") > 0
	if item.kind is "Text"
		return MlirConstants(function, position, named).Address(item.text, "_" + index, element)
	if item.kind is not in ("Number", "Boolean")
		let unsupported = MlirStatements(function, position).Unsupported("nested " + item.kind + " constant")
		return List(Text) + unsupported
	let number = MlirStatements(function, position).Hex(item.number)
	List(Text) + ("    " + Temp(element + "c") + " = arith.constant " + number + " : f64")
ElementName(item Runtime/VmValue, element Text) Text
	MlirLists(Listed, 0).ElementName(VmValue.OfText("a"), "e1") is "%t0e1xf"
	item.kind is "Text" then Temp(element + "xf") else Temp(element + "c")
Appended(entry InstructionEntry) Texts
	MlirLists(Listed, 3).Appended(Steps(3)).Last is "    llvm.store %t3n, %v_numbers : f64, !llvm.ptr"
	Text.Combine(MlirLists(Listed, 3).Appended(Removal)).IndexOf("@strict_list_remove(") > 0
	Text.Combine(MlirLists(Listed, 3).Appended(Pushing)).IndexOf("@strict_list_push(") > 0
	let name = "%v_" + entry.texts(0)
	let kinds = MlirKinds(function)
	let elements = MlirLayout(function).Represented(kinds.ElementKind(kinds.VariableKind(position, entry.texts(0))))
	let adder = entry.texts(0) is "forResult" then "strict_list_push" else "strict_list_add"
	let helper = entry.kind is InstructionType.InvokeRemove then "strict_list_remove" else adder
	let added = MlirMemory(function, position).Passed(Temp("n"), helper, (Temp("l"), Temp("e")), elements)
	let element = function.Load(Temp("e"), "%r" + entry.payload(0))
	(function.Load(Temp("l"), name), element) + added + function.Store(Temp("n"), name)
Indexed(entry InstructionEntry) Texts
	MlirLists(Listed, 2).Indexed(Steps(2)).Last is "    llvm.store %t2x, %r2 : f64, !llvm.ptr"
	Text.Combine(Hoisting.Indexed(Hoisting.function.method.instructions(1))).IndexOf("@strict_hoisted_read(") > 0
	let isText = MlirLayout(function).Represented(MlirKinds(function).VariableKind(position, entry.texts(0))) is "Text"
	let memory = MlirMemory(function, position)
	let arguments = isText then (Temp("l"), Temp("i")) else (Temp("l"), Temp("i"), Temp("nb"))
	let access = memory.Called(Temp("x"), isText then "strict_text_at" else "strict_list_read", arguments)
	let loads = (function.Load(Temp("l"), "%v_" + entry.texts(0)), function.Load(Temp("i"), "%r" + entry.payload(1)))
	let stored = function.Store(Temp("x"), "%r" + entry.payload(0))
	let parameters = MlirParameters(function)
	if entry.texts(0) is in parameters.FixedLists
		return loads + NameBits + parameters.Read(entry.texts(0), Temp("l"), Temp("i"), Temp("nb"), Temp("x")) + stored
	(isText then loads else loads + NameBits) + access + stored
NameBits Texts
	MlirLists(Listed, 2).NameBits.Last.IndexOf("strict_bits") > 0
	let address = "    " + Temp("n") + " = llvm.mlir.addressof @s" + function.Symbol + "_" + position + " : !llvm.ptr"
	(address, "    " + Temp("nb") + " = func.call @strict_bits(" + Temp("n") + ") : (!llvm.ptr) -> f64")
IsElementStore Boolean
	MlirLists(Written, 1).IsElementStore
	MlirLists(Written, 0).IsElementStore is false
	let entry = function.method.instructions(position)
	if entry.kind is not InstructionType.StoreRegisterToVariable
		return false
	entry.texts(0).IndexOf("(") > 0
ElementStored(entry InstructionEntry) Texts
	MlirLists(Written, 1).ElementStored(Written.method.instructions(1)).Last.IndexOf("strict_list_set") > 0
	MlirLists(Written, 1).ElementStored(Versioning).Last is "    llvm.store %t1s, %v_numbers : f64, !llvm.ptr"
	let parts = PayloadDecoder(entry).ElementParts
	let index = parts(1)
	let isNumber = "0123456789".IndexOf(index.Substring(0, 1)) is not -1
	constant prefix = "    " + Temp("i") + " = arith.constant "
	let indexed = isNumber then prefix + index + ".0 : f64" else function.Load(Temp("i"), "%v_" + index)
	let loads = Target(parts(0)) + indexed + function.Load(Temp("e"), "%r" + entry.payload(0))
	let isVersioned = entry.payload.Length > 2
	let helper = isVersioned then "strict_list_write" else "strict_list_set"
	let call = MlirMemory(function, position).Called(Temp("s"), helper, (Temp("l"), Temp("i"), Temp("e")))
	isVersioned then loads + call + function.Store(Temp("s"), "%v_" + parts(0)) else loads + call
Target(path Text) Texts
	MlirLists(Written, 1).Target("numbers") is ("    %t1l = llvm.load %v_numbers : !llvm.ptr -> f64")
	MlirLists(Written, 1).Target("numbers.width").Last is "    %t1l = llvm.load %t1ls : !llvm.ptr -> f64"
	let memory = MlirMemory(function, position)
	let target = memory.Unwrapped(path)
	let dot = target.IndexOf(".")
	if dot < 0
		return List(Text) + function.Load(Temp("l"), "%v_" + target)
	let slot = memory.Slot(Temp("op"), memory.Member(target).First, "ls")
	let owner = function.Load(Temp("o"), "%v_" + target.Substring(0, dot))
	let pointer = List(Text) + owner + memory.Pointer(Temp("o"), "o")
	pointer + slot + function.Load(Temp("l"), Temp("ls"))
Copied(entry InstructionEntry) Texts
	MlirLists(Written, 2).Copied(Written.method.instructions(2)).Length is 3
	MlirLists(Written, 2).Copied(MemberCopy).Last is "    llvm.store %t2oc, %v_numbers : f64, !llvm.ptr"
	let path = MlirMemory(function, position).Unwrapped(entry.texts(0))
	let copy = MlirMemory(function, position).Called(Temp("c"), "strict_list_copy", (Temp("l"), "%zero"))
	if path.IndexOf(".") < 0
		return (function.Load(Temp("l"), "%v_" + path), copy, function.Store(Temp("c"), "%v_" + path))
	let changed = MlirMemory(function, position).Changed(path, Temp("c"), Temp("oc"))
	Target(path) + copy + changed + function.Store(Temp("oc"), "%v_" + path.Substring(0, path.IndexOf(".")))
