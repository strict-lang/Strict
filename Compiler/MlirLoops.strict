has function MlirFunction
has position Number
constant Counting = MlirLoops(MlirFunction(List(TypeEntry), MlirFunction.Shape, MethodEntry.CountingLoop), 0)
constant OuterLoop = MethodEntry("Run", List(MemberEntry), "None", (InstructionEntry.LoopBegin(0, -1), InstructionEntry.Named(InstructionType.LoadVariableToRegister, 1, "outer"), InstructionEntry.Jump(InstructionType.LoopEnd, 1)))
constant Nested = MlirLoops(MlirFunction(List(TypeEntry), MlirFunction.Shape, OuterLoop), 0)
constant ListLoop = MethodEntry("Run", List(MemberEntry) + MlirLists.Items, "None", (InstructionEntry.Named(InstructionType.LoadVariableToRegister, 0, "numbers"), InstructionEntry.LoopBegin(0, -1), InstructionEntry.Jump(InstructionType.LoopEnd, 1)))
constant Listing = MlirLoops(MlirFunction(List(TypeEntry) + MlirFunction.Shape, MlirFunction.Shape, ListLoop), 1)
constant Emptied = MethodCodegen.StoreConstant(InstructionEntry(InstructionType.LoadConstantToRegister, "Strict/List(Number)", (0, 6, -1, 0)), "forResult")
constant Collecting = MlirLoops(MlirFunction(List(TypeEntry), MlirFunction.Shape, MethodEntry("Run", List(MemberEntry), "None", (Emptied, InstructionEntry.LoopBegin(0, -1), InstructionEntry.Jump(InstructionType.LoopEnd, 1)))), 1)
Temp(suffix Text) Text
	Counting.Temp("k") is "%t0k"
	"%t" + position + suffix
Begin Texts
	Counting.Begin.Length is 18
	let entry = function.method.instructions(position)
	let bounds = entry.payload(1) is 1 then RangeBounds(entry) else CountBounds(entry)
	let saved = (function.Load(Temp("x"), "%v_index"), function.Load(Temp("y"), "%v_value"))
	let label = "^loop" + position
	let header = (function.Store("%zero", "%loop" + position), "    cf.br " + label, "  " + label + ":")
	constant check = "    " + Temp("m") + " = arith.cmpf olt, " + Temp("k") + ", " + Temp("n") + " : f64"
	let branch = "    cf.cond_br " + Temp("m") + ", " + label + "body, " + label + "exit"
	let iteration = (function.Load(Temp("k"), "%loop" + position), check, branch, "  " + label + "body:")
	bounds + Items + saved + Outered + Presized + header + iteration + Current
Current Texts
	Counting.Current.Length is 4
	Text.Combine(Listing.Current).IndexOf("llvm.store %t1g, %v_value") > 0 is true
	constant offset = "    " + Temp("o") + " = arith.mulf " + Temp("k") + ", " + Temp("s") + " : f64"
	constant current = "    " + Temp("c") + " = arith.addf " + Temp("b") + ", " + Temp("o") + " : f64"
	let indexed = (offset, current, function.Store(Temp("c"), "%v_index"))
	constant collection = Collection
	if collection is ""
		return indexed + function.Store(Temp("c"), "%v_value")
	let character = MlirMemory(function, position).Called(Temp("g"), "strict_text_at", (Temp("v"), Temp("c")))
	indexed + (collection is "Text" then character else Element) + function.Store(Temp("g"), "%v_value")
Element Text
	Listing.Element.StartsWith("    %t1g = func.call @strict_hoisted_item(%t1h, %t1c, %t1hv, %t1v)") is true
	constant operands = "(" + Temp("h") + ", " + Temp("c") + ", " + Temp("hv") + ", " + Temp("v") + ")"
	"    " + Temp("g") + " = func.call @strict_hoisted_item" + operands + " : (!llvm.ptr, f64, i64, f64) -> f64"
Collection Text
	Counting.Collection is ""
	let entry = function.method.instructions(position)
	if entry.payload(1) is 1
		return ""
	let kind = MlirLayout(function).Represented(MlirKinds(function).KindOf(position, entry.payload(0)))
	(kind is "Text") or kind.StartsWith("List(") then kind else ""
RangeBounds(entry InstructionEntry) Texts
	Counting.RangeBounds(InstructionEntry.LoopBegin(0, 1)).Length is 9
	let start = function.Load(Temp("b"), "%r" + entry.payload(0))
	let end = function.Load(Temp("e"), "%r" + entry.payload(2))
	constant isDown = "    " + Temp("d") + " = arith.cmpf olt, " + Temp("e") + ", " + Temp("b") + " : f64"
	constant up = "    " + Temp("u") + " = arith.subf " + Temp("e") + ", " + Temp("b") + " : f64"
	constant down = "    " + Temp("w") + " = arith.subf " + Temp("b") + ", " + Temp("e") + " : f64"
	constant count = "    " + Temp("n") + " = arith.select " + Temp("d") + ", " + Temp("w") + ", " + Temp("u") + " : f64"
	constant one = "    " + Temp("p") + " = arith.constant 1.0 : f64"
	constant minusOne = "    " + Temp("q") + " = arith.constant -1.0 : f64"
	constant step = "    " + Temp("s") + " = arith.select " + Temp("d") + ", " + Temp("q") + ", " + Temp("p") + " : f64"
	(start, end, isDown, up, down, count, one, minusOne, step)
CountBounds(entry InstructionEntry) Texts
	Counting.CountBounds(InstructionEntry.LoopBegin(0, -1)).Length is 5
	constant start = "    " + Temp("b") + " = arith.constant 0.0 : f64"
	constant whole = "    " + Temp("i") + " = arith.fptosi " + Temp("v") + " : f64 to i64"
	constant count = "    " + Temp("n") + " = arith.sitofp " + Temp("i") + " : i64 to f64"
	constant step = "    " + Temp("s") + " = arith.constant 1.0 : f64"
	constant collection = Collection
	let loaded = function.Load(Temp("v"), "%r" + entry.payload(0))
	if collection is ""
		return (start, loaded, whole, count, step)
	constant counter = collection is "Text" then "strict_text_length" else "strict_list_length"
	(start, loaded, MlirMemory(function, position).Called(Temp("n"), counter, List(Text) + Temp("v")), step)
Items Texts
	Listing.Items.First.IndexOf("@strict_list_items(%t1v)") > 0 is true
	Listing.Items.Last is "    %t1hv = func.call @strict_list_version() : () -> i64"
	constant collection = Collection
	if (collection is "") or (collection is "Text")
		return List(Text)
	let items = "    " + Temp("h") + " = func.call @strict_list_items(" + Temp("v") + ") : (f64) -> !llvm.ptr"
	(items, "    " + Temp("hv") + " = func.call @strict_list_version() : () -> i64")
Outered Texts
	Counting.Outered.Length is 0
	Nested.Outered.Last is "    llvm.store %t0y, %v_outer : f64, !llvm.ptr"
	let names = function.VariableNames
	mutable lines = List(Mutable(Text))
	if "outer" is in names
		lines = lines + function.Load(Temp("z"), "%v_outer") + function.Store(Temp("y"), "%v_outer")
	if "outer.index" is in names
		lines = lines + function.Load(Temp("j"), "%v_outer.index") + function.Store(Temp("x"), "%v_outer.index")
	lines
IsCollecting Boolean
	Collecting.IsCollecting is true
	Counting.IsCollecting is false
	for position
		let entry = function.method.instructions(position - 1 - index)
		if entry.kind is in (InstructionType.LoopBegin, InstructionType.LoopEnd)
			return false
		if (entry.kind is InstructionType.StoreConstantToVariable) and (entry.texts.Last is "forResult")
			return entry.payload(0) is 6
	false
Presized Texts
	Counting.Presized.Length is 0
	Collecting.Presized.Last is "    llvm.store %t1r, %v_forResult : f64, !llvm.ptr"
	if IsCollecting is false
		return List(Text)
	constant capacity = "    " + Temp("a") + " = arith.maximumf " + Temp("n") + ", %zero : f64"
	let created = MlirMemory(function, position).Called(Temp("r"), "strict_list_new", (Temp("a"), "%zero"))
	(capacity, created, function.Store(Temp("r"), "%v_forResult"))
Restored(begin Number) Texts
	MlirLoops(Nested.function, 2).Restored(0) is List(Text) + "    llvm.store %t0z, %v_outer : f64, !llvm.ptr"
	let names = function.VariableNames
	mutable lines = List(Mutable(Text))
	if "outer" is in names
		lines = lines + function.Store("%t" + begin + "z", "%v_outer")
	if "outer.index" is in names
		lines = lines + function.Store("%t" + begin + "j", "%v_outer.index")
	lines
End Texts
	MlirLoops(Counting.function, 1).End.Length is 8
	let begin = function.method.LoopBeginOf(position)
	let counter = "%loop" + begin
	constant next = "    " + Temp("w") + " = arith.addf " + Temp("k") + ", " + Temp("u") + " : f64"
	let increment = (function.Load(Temp("k"), counter), "    " + Temp("u") + " = arith.constant 1.0 : f64", next)
	let exit = ("    cf.br ^loop" + begin, "  ^loop" + begin + "exit:")
	let restore = (function.Store("%t" + begin + "x", "%v_index"), function.Store("%t" + begin + "y", "%v_value"))
	increment + function.Store(Temp("w"), counter) + exit + restore + Restored(begin)