has function MlirFunction
has position Number
constant Doubler = MlirKernel.Doubler
constant Doubling = MlirFastLoop(MlirFunction(Doubler.types, Doubler.type, Doubler.method, List(Number), 2), 2)
constant Summed = MlirKernel.Summing.function
constant Summing = MlirFastLoop(MlirFunction(Summed.types, Summed.type, Summed.method, List(Number), 1), 1)
constant Halving = MlirFastLoop(MlirFunction(Doubler.types, Doubler.type, Doubler.method, List(Number), 2, "numbers 16"), 2)
constant Quartering = MlirFastLoop(MlirFunction(Doubler.types, Doubler.type, Doubler.method, List(Number), 2, "numbers 8"), 2)
constant Squared = MlirKernel.Squaring.function
constant Squaring = MlirFastLoop(MlirFunction(Squared.types, Squared.type, Squared.method, List(Number), 2), 2)
constant Shifted = MlirKernel.Offsetting.function
constant Shifting = MlirFastLoop(MlirFunction(Shifted.types, Shifted.type, Shifted.method, List(Number), 2), 2)
constant Guarded = MlirKernel.Guarding.function
constant Guarding = MlirFastLoop(MlirFunction(Guarded.types, Guarded.type, Guarded.method, List(Number), 1), 1)
constant Byting = MlirFastLoop(MlirFunction(MlirLayout.Bytings.types, MlirLayout.Bytings.type, MlirLayout.Bytings.method), 2)
constant Pointer = " : (!llvm.ptr, i64) -> !llvm.ptr, "
constant Iterated = "for"
constant Items = " : (f64) -> !llvm.ptr"
Temp(suffix Text) Text
	Doubling.Temp("ki") is "%t2ki"
	Doubling.Checked(3) is "    %t2s = arith.constant 1.0 : f64"
	Doubling.Checked(4) is "    %t2ok0 = arith.constant true"
	Doubling.Checked(5) is "    %t2l_numbers = llvm.load %v_numbers : !llvm.ptr -> f64"
	Doubling.Checked(6) is "    %t2n_numbers = func.call @strict_list_length(%t2l_numbers) : (f64) -> f64"
	Doubling.Checked(7) is "    %t2e_numbers = arith.cmpf oge, %t2n_numbers, %t2n : f64"
	Doubling.Counted(4) is "    %t2m = arith.cmpi slt, %t2ki, %t2ni : i64"
	Doubling.Counted(5) is "    cf.cond_br %t2m, ^loop2body, ^loop2exit"
	"%t" + position + suffix
Checked Texts
	Doubling.Checked.Last is "    %t2ok1 = arith.andi %t2ok0, %t2e_numbers : i1"
	"    %t2g_input = arith.cmpf oge, %t2n_input, %t2w_input : f64" is in Squaring.Checked
	memory = MlirMemory(function, position)
	mutable lines = MlirLoops(function, position).CountBounds(function.method.instructions(position))
	lines = lines + ("    " + Temp("ok0") + " = arith.constant true")
	for MlirKernel(function, position).Sources
		length = memory.Call(Temp("n_" + value), "strict_list_length", List(Text) + Temp("l_" + value))
		combined = Join("ok" + (index + 1), Temp("ok" + index), Temp("e_" + value))
		lines = lines + EmitList(value) + length + Enough(value) + combined
	lines
EmitList(source Text) Texts
	Doubling.EmitList("numbers") is ("    %t2l_numbers = llvm.load %v_numbers : !llvm.ptr -> f64")
	Guarding.EmitList("numbers").Last is "    %t1l_numbers = arith.select %t1lf_numbers, %zero, %t1lu_numbers : f64"
	Guarding.EmitList("numbers")(1) is "    %t1lf_numbers = func.call @strict_is_failure(%t1lu_numbers) : (f64) -> i1"
	list = Temp("l_" + source)
	if source is not in MlirKernel(function, position).Checked
		return List(Text) + function.Load(list, "%v_" + source)
	loaded = Temp("lu_" + source)
	failed = "    " + Temp("lf_" + source) + " = func.call @strict_is_failure(" + loaded + ") : (f64) -> i1"
	chosen = "    " + list + " = arith.select " + Temp("lf_" + source) + ", %zero, " + loaded + " : f64"
	(function.Load(loaded, "%v_" + source), failed, chosen)
Enough(source Text) Texts
	Doubling.Enough("numbers") is ("    %t2e_numbers = arith.cmpf oge, %t2n_numbers, %t2n : f64")
	Squaring.Enough("input").Last is "    %t2e_input = arith.andi %t2g_input, %t2p_input : i1"
	reads = MlirKernel(function, position).Shift(source)
	if reads.Length is 0
		return List(Text) + Compare("e_" + source, Temp("n_" + source), Temp("n"))
	mutable lines = List(Mutable(Text))
	for reads
		lines = lines + Offset(value) + Span(value, reads)
	needed = "    " + Temp("w_" + source) + " = arith.addf " + Temp("n") + ", " + Temp("hi_" + reads.Last) + " : f64"
	fits = Compare("g_" + source, Temp("n_" + source), Temp("w_" + source))
	checks = (needed, fits, Compare("p_" + source, Temp("lo_" + reads.Last), "%zero"))
	lines + checks + Join("e_" + source, Temp("g_" + source), Temp("p_" + source))
Offset(at Number) Texts
	Squaring.Offset(7).First is "    %t2v0_7 = llvm.load %v_start : !llvm.ptr -> f64"
	Shifting.Offset(13)(1) is "    %t2o1_13 = arith.addf %zero, %t2v0_13 : f64"
	Shifting.Offset(13)(3) is "    %t2o0_13 = arith.addf %t2o1_13, %t2v1_13 : f64"
	terms = MlirKernel(function, position).Offsets(at)
	mutable lines = List(Mutable(Text))
	for terms
		term = Temp("v" + index + "_" + at)
		sum = index is 0 then "%zero" else Temp("o" + (terms.Length - index) + "_" + at)
		read = value.StartsWith("0x") then MlirTyped.Double.Constant(term, value) else function.Load(term, "%v_" + value)
		added = Temp("o" + (terms.Length - 1 - index) + "_" + at) + " = arith.addf " + sum + ", " + term
		lines = lines + read + ("    " + added + " : f64")
	lines + ("    " + Temp("oi_" + at) + " = arith.fptosi " + Temp("o0_" + at) + " : f64 to i64")
Span(at Number, reads Numbers) Texts
	Squaring.Span(7, (7, 12)).First is "    %t2lo_7 = arith.minimumf %zero, %t2o0_7 : f64"
	Squaring.Span(7, (7, 12)).Last is "    %t2hi_7 = arith.maximumf %zero, %t2o0_7 : f64"
	Squaring.Span(12, (7, 12)).First is "    %t2lo_12 = arith.minimumf %t2lo_7, %t2o0_12 : f64"
	Squaring.Span(12, (7, 12)).Last is "    %t2hi_12 = arith.maximumf %t2hi_7, %t2o0_12 : f64"
	Shifting.Offset(8).First is "    %t2v0_8 = arith.constant 0x4078D00000000000 : f64"
	Shifting.Enough("numbers").Length is 16
	order = reads.Index(at)
	low = order is 0 then "%zero" else Temp("lo_" + reads(order - 1))
	high = order is 0 then "%zero" else Temp("hi_" + reads(order - 1))
	sum = ", " + Temp("o0_" + at) + " : f64"
	lowest = "    " + Temp("lo_" + at) + " = arith.minimumf " + low + sum
	(lowest, "    " + Temp("hi_" + at) + " = arith.maximumf " + high + sum)
Compare(name Text, left Text, right Text) Text
	Doubling.Compare("e", "%a", "%b") is "    %t2e = arith.cmpf oge, %a, %b : f64"
	Squaring.Enough("input").First is "    %t2v0_7 = llvm.load %v_start : !llvm.ptr -> f64"
	Squaring.Enough("input").Index("    %t2oi_7 = arith.fptosi %t2o0_7 : f64 to i64") is 2
	Squaring.Enough("input").Index("    %t2w_input = arith.addf %t2n, %t2hi_12 : f64") is 10
	Squaring.Enough("input").Index("    %t2g_input = arith.cmpf oge, %t2n_input, %t2w_input : f64") is 11
	Squaring.Enough("input").Index("    %t2p_input = arith.cmpf oge, %t2lo_12, %zero : f64") is 12
	"    " + Temp(name) + " = arith.cmpf oge, " + left + ", " + right + " : f64"
Join(name Text, left Text, right Text) Text
	Doubling.Join("ok1", "%a", "%b") is "    %t2ok1 = arith.andi %a, %b : i1"
	Doubling.Emit(4).Last is "    llvm.store %t4x, %r2 : f64, !llvm.ptr"
	Doubling.Emit(7).First is "    %t7e = llvm.load %r4 : !llvm.ptr -> f64"
	Doubling.Emit(7).Index("    %t7p = llvm.getelementptr %t2ri[%t2ki] : (!llvm.ptr, i64) -> !llvm.ptr, f64") is 1
	"    " + Temp(name) + " = arith.andi " + left + ", " + right + " : i1"
Started Texts
	Doubling.Started.First is "  ^loop2fast:"
	Doubling.Started.Last is "    %t2ri = func.call @strict_list_items(%t2r) : (f64) -> !llvm.ptr"
	Byting.Started.Last is "    %t2ri = func.call @strict_list_data(%t2r) : (f64) -> !llvm.ptr"
	loops = MlirLoops(function, position)
	collected = Widths.Point(Temp("h"), Temp("v"), Iterated, "strict_list_items")
	items = loops.Items.Length is 0 then loops.Items else collected + loops.Items.Last
	mutable lines = List(Text) + ("  ^loop" + position + "fast:") + items
	for MlirKernel(function, position).Sources
		lines = lines + Widths.Point(Temp("h_" + value), Temp("l_" + value), value, "strict_list_start")
	saved = (function.Load(Temp("x"), "%v_index"), function.Load(Temp("y"), "%v_value"))
	results = MlirBytes(function, position).Start(Temp("r"), Temp("ri"))
	lines + saved + loops.Outered + (loops.IsCollecting then results else List(Text))
Counted Texts
	Doubling.Counted.Last is "  ^loop2body:"
	Doubling.Counted(0) is "    %t2ni = arith.fptosi %t2n : f64 to i64"
	Doubling.Counted(1) is "    %t2zi = arith.constant 0 : i64"
	Doubling.Counted(2) is "    cf.br ^loop2(%t2zi : i64)"
	Doubling.Counted(3) is "  ^loop2(%t2ki: i64):"
	label = "^loop" + position
	whole = "    " + Temp("ni") + " = arith.fptosi " + Temp("n") + " : f64 to i64"
	mutable start = List(Text) + ("    " + Temp("zi") + " = arith.constant 0 : i64")
	start = start + MlirCounter(function, position).Started + ("    cf.br " + label + "(" + Temp("zi") + " : i64)")
	check = "    " + Temp("m") + " = arith.cmpi slt, " + Temp("ki") + ", " + Temp("ni") + " : i64"
	branch = "    cf.cond_br " + Temp("m") + ", " + label + "body, " + label + "exit"
	List(Text) + whole + start + ("  " + label + "(" + Temp("ki") + ": i64):") + check + branch + ("  " + label + "body:")
Current Texts
	Doubling.Current.Last is "    llvm.store %t2g, %v_value : f64, !llvm.ptr"
	Doubling.Current(0) is "    %t2c = arith.sitofp %t2ki : i64 to f64"
	Doubling.Current(1) is "    llvm.store %t2c, %v_index : f64, !llvm.ptr"
	Doubling.Current(2) is "    %t2gp = llvm.getelementptr %t2h[%t2ki] : (!llvm.ptr, i64) -> !llvm.ptr, f64"
	Doubling.Current(3) is "    %t2g = llvm.load %t2gp : !llvm.ptr -> f64"
	converted = "    " + Temp("c") + " = arith.sitofp " + Temp("ki") + " : i64 to f64"
	index = (converted, function.Store(Temp("c"), "%v_index"))
	if MlirLoops(function, position).Collection is ""
		return index + function.Store(Temp("c"), "%v_value")
	index + Widths.Load(Temp("g"), Temp("gp"), Temp("h"), Iterated) + function.Store(Temp("g"), "%v_value")
Copied Texts
	Halving.Copied.First is "  ^loop2fast:"
	Halving.Copied.Index(Halving.Checked.First) is 1
	Doubling.Copied(10) is Doubling.Started(1) and Doubling.Copied(20) is Doubling.Counted.First
	Doubling.Copied(27) is Doubling.Current.First and Doubling.Copied(32) is Doubling.Looped.First
	Doubling.Copied(49) is "  ^loop2exit:" and Doubling.Copied.Length is 53
	started = Started
	List(Text) + started.First + Checked + (started - started.First) + Counted + Current + Looped + Exited
Looped Texts
	Doubling.Looped.Last is "    cf.br ^loop2(%t2next : i64)"
	Doubling.Looped(0) is "    %t3 = llvm.load %v_index : !llvm.ptr -> f64"
	Doubling.Looped(14) is "    %t2one = arith.constant 1 : i64"
	Doubling.Looped(15) is "    %t2next = arith.addi %t2ki, %t2one : i64"
	mutable lines = List(Mutable(Text))
	for Range(position + 1, function.method.LoopEndOf(position))
		lines = lines + MlirLines(function).At(value, Temp("line")) + function.Emit(value)
	one = "    " + Temp("one") + " = arith.constant 1 : i64"
	next = "    " + Temp("next") + " = arith.addi " + Temp("ki") + ", " + Temp("one") + " : i64"
	lines + one + next + MlirCounter(function, position).Branch("^loop" + position + "(" + Temp("next") + " : i64)")
Exited Texts
	Doubling.Exited.First is "  ^loop2exit:"
	Doubling.Exited(1) is "    %t2fill = func.call @strict_list_filled_numbers(%t2r, %t2n) : (f64, f64) -> f64"
	Doubling.Exited(2) is "    llvm.store %t2x, %v_index : f64, !llvm.ptr"
	Doubling.Exited(3) is "    llvm.store %t2y, %v_value : f64, !llvm.ptr"
	MlirFastLoop(MlirBytes.Flattening.function, 2).Exited(1) is MlirBytes.Flattening.Unbuffer("%t2r").First
	loops = MlirLoops(function, function.method.LoopEndOf(position))
	helper = MlirParallel(function, position).Filler
	filled = MlirMemory(function, position).Call(Temp("fill"), helper, (Temp("r"), Temp("n")))
	restored = (function.Store(Temp("x"), "%v_index"), function.Store(Temp("y"), "%v_value"))
	isFilled = MlirLoops(function, position).IsCollecting and MlirBytes(function, position).Flattened is 0
	collected = isFilled then List(Text) + filled else MlirBytes(function, position).Unbuffer(Temp("r"))
	List(Text) + ("  ^loop" + position + "exit:") + collected + restored + loops.Restore(position)
Emit(at Number) Texts
	Doubling.Emit(4).First is "    %t4p = llvm.getelementptr %t2h_numbers[%t2ki] : (!llvm.ptr, i64) -> !llvm.ptr, f64"
	Doubling.Emit(7).Last is "    llvm.store %t7e, %t7p : f64, !llvm.ptr"
	Halving.Emit(4).Index("    %t4xw = arith.extf %t4xn : f16 to f64") is 2
	Squaring.Emit(7).First is "    %t2k7 = arith.addi %t2ki, %t2oi_7 : i64"
	entry = function.method.instructions(at)
	pointer = "%t" + at + "p"
	if entry.kind is InstructionType.IndexCall
		return Widths.Read("%t" + at + "x", at) + function.Store("%t" + at + "x", "%r" + entry.payload(0))
	element = "%t" + at + "e"
	bytes = MlirBytes(function, position)
	address = "    " + pointer + " = llvm.getelementptr " + Temp("ri") + "[" + Temp("ki") + "]" + Pointer + bytes.Width
	(function.Load(element, "%r" + entry.payload(0)), address) + bytes.Store(element, pointer)
Widths MlirWidths
	Doubling.Widths.position is 2
	Doubling.Started(1) is "    %t2h = func.call @strict_list_items(%t2v) : (f64) -> !llvm.ptr"
	Doubling.Started(3) is "    %t2h_numbers = func.call @strict_list_start(%t2l_numbers) : (f64) -> !llvm.ptr"
	Doubling.Started(4) is "    %t2x = llvm.load %v_index : !llvm.ptr -> f64"
	Doubling.Started(5) is "    %t2y = llvm.load %v_value : !llvm.ptr -> f64"
	Doubling.Started(6) is "    %t2a = arith.maximumf %t2n, %zero : f64"
	Summing.Started.Last is "    %t1y = llvm.load %v_value : !llvm.ptr -> f64"
	Summing.Exited(1) is "    llvm.store %t1x, %v_index : f64, !llvm.ptr"
	MlirWidths(function, position)
IsAccumulated(at Number) Boolean
	Summing.IsAccumulated(5)
	Doubling.IsAccumulated(6) is false
	entry = function.method.instructions(at)
	next = function.method.instructions(at + 1)
	isSum = entry.kind is InstructionType.Add or entry.kind is InstructionType.Subtract
	if function.FastLoop < 0 or isSum is false or next.kind is not InstructionType.StoreRegisterToVariable
		return false
	writer = Writer(entry.payload(1), at)
	isLoaded = writer.kind is InstructionType.LoadVariableToRegister and next.texts(0) is in writer.texts
	isLoaded and next.payload(0) is entry.payload(3)
Writer(register Number, at Number) InstructionEntry
	Summing.Writer(3, 5).texts.First is "sum"
	Summing.Writer(0, 5).kind is InstructionType.Add
	writer = LoadReuse(function.method.instructions).Writer(register, at, function.FastLoop)
	function.method.instructions(writer < 0 then at else writer)