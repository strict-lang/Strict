has function MlirFunction
has position Number
constant KeptLoop = (MethodCodegen.StoreConstant(InstructionEntry(InstructionType.LoadConstantToRegister, "Strict/List(Text)", (0, 6, -1, 0)), "forResult"), InstructionEntry.Named(InstructionType.LoadVariableToRegister, 0, "names"))
constant KeptCheck = (InstructionEntry.LoopBegin(0, -1), InstructionEntry.Named(InstructionType.LoadVariableToRegister, 1, "value"), InstructionEntry.LoadText(2, ""), InstructionEntry.Binary(InstructionType.NotEqual, (1, 2)))
constant KeptWrite = (InstructionEntry.Jump(InstructionType.JumpToIdIfFalse, 0), InstructionEntry.Named(InstructionType.InvokeWriteToList, 1, "forResult"), InstructionEntry.Jump(InstructionType.JumpEnd, 0))
constant KeptInstructions = KeptLoop + KeptCheck + KeptWrite + InstructionEntry.Jump(InstructionType.LoopEnd, 7)
constant Kept = MethodEntry("Kept", List(MemberEntry) + MemberEntry("names", "Strict/List(Text)", List(InstructionEntry), false), "Strict/List(Text)", KeptInstructions)
constant Keeping = MlirFiltering(MlirFunction(List(TypeEntry) + MlirParallel.Rows, MlirParallel.Rows, Kept), 2)
constant Filtering = MlirFiltering(MlirFunction(List(TypeEntry) + MlirParallel.Rows, MlirParallel.Rows, MlirParallel.Filtered), 2)
constant Doubling = MlirFiltering(MlirParallel.Doubling.function, 2)
constant HoleBits = "9222527611924643840"
constant Plain = "0x7FF8000000000000 : f64"
IsFiltering Boolean
	Keeping.IsFiltering
	Filtering.IsFiltering
	Doubling.IsFiltering is false
	for Range(position + 1, function.method.LoopEndOf(position))
		entry = function.method.instructions(value)
		isResult = entry.kind is InstructionType.InvokeWriteToList and entry.texts(0) is "forResult"
		if isResult and MlirPurity(function, position).IsCollected(value) is false
			return true
	false
IsFilteringValues Boolean
	Filtering.IsFilteringValues is false
	Keeping.IsFilteringValues is false
	Doubling.IsFilteringValues is false
	MlirParallel(Keeping.function, 2).IsParallel
	kinds = MlirKinds(function)
	flats = MlirFlats(function, position).Count(kinds.ElementKind(kinds.VariableKind(position, "forResult")))
	IsFiltering and (flats > 0 or MlirBytes(function, position).IsCollected)
Unhole(at Number) Texts
	Filtering.Unhole(7).Length is 7 and Filtering.Unhole(7).Last.StartsWith("    llvm.store %t7hc, %r1")
	Keeping.Unhole(7).Length is 0
	if IsFiltering is false or MlirParallel(function, position).Filler is not "strict_list_filled_numbers"
		return List(Text)
	register = "%r" + function.method.instructions(at).payload(0)
	named = "    %t" + at
	kept = "%t" + at + "hv"
	bits = named + "hb = arith.bitcast " + kept + " : f64 to i64"
	holes = named + "hh = arith.constant " + HoleBits + " : i64"
	plain = named + "hn = arith.constant " + Plain
	isHole = named + "hs = arith.cmpi eq, %t" + at + "hb, %t" + at + "hh : i64"
	chosen = named + "hc = arith.select %t" + at + "hs, %t" + at + "hn, " + kept + " : f64"
	stored = function.Store("%t" + at + "hc", register)
	(List(Text) + function.Load(kept, register) + bits + holes + plain) + (isHole, chosen, stored)
Holed Texts
	Keeping.Holed.Last is "    func.call @strict_list_holes(%t2ph, %t2n) : (f64, f64) -> ()"
	Doubling.Holed.Length is 0
	if IsFiltering is false
		return List(Text)
	parallel = MlirParallel(function, position)
	list = parallel.Temp("ph")
	holes = "    func.call @strict_list_holes(" + list + ", " + parallel.Temp("n") + ") : (f64, f64) -> ()"
	given = MlirGiven(function, position)
	filled = given.Member is "" then List(Text) + holes else given.Prefill(list, parallel.Temp("n"))
	(List(Text) + function.Load(list, "%v_forResult")) + filled
Fill(filler Text) Texts
	Doubling.Fill("strict_list_filled_numbers").Last.EndsWith("_numbers(%t2pl, %t2n) : (f64, f64) -> f64")
	Keeping.Fill("strict_list_filled").Last.EndsWith("@strict_list_filtered(%t2pl, %t2n) : (f64, f64) -> f64")
	parallel = MlirParallel(function, position)
	finisher = IsFiltering then "strict_list_filtered" else filler
	arguments = (parallel.Temp("pl"), parallel.Temp("n"))
	List(Text) + MlirMemory(function, position).Call(parallel.Temp("pz"), finisher, arguments)
