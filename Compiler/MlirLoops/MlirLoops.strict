has function MlirFunction
has position Number
has isChunk Boolean = false
constant Counting = MlirLoops(MlirFunction(List(TypeEntry), MlirFunction.Shape, MethodEntry.CountingLoop), 0)
constant OuterLoop = MethodEntry("Run", List(MemberEntry), "None", (InstructionEntry.LoopBegin(0, -1), InstructionEntry.Named(InstructionType.LoadVariableToRegister, 1, "outer"), InstructionEntry.Jump(InstructionType.LoopEnd, 1)))
constant Nested = MlirLoops(MlirFunction(List(TypeEntry), MlirFunction.Shape, OuterLoop), 0)
constant ListLoop = MethodEntry("Run", List(MemberEntry) + MlirLists.Items, "None", MlirBytes.Looped + InstructionEntry.Jump(InstructionType.LoopEnd, 1))
constant Listing = MlirLoops(MlirFunction(List(TypeEntry) + MlirFunction.Shape, MlirFunction.Shape, ListLoop), 1)
constant ByteNumbers = MemberEntry("numbers", "Strict/Bytes", List(InstructionEntry), false)
constant Bytewise = MlirLoops(MlirFunction(List(TypeEntry) + MlirFunction.Shape + MlirLayout.Byting, MlirFunction.Shape, MethodEntry("Run", List(MemberEntry) + ByteNumbers, "None", ListLoop.instructions)), 1)
constant Emptied = MethodCodegen.StoreConstant(InstructionEntry(InstructionType.LoadConstantToRegister, "Strict/List(Number)", (0, 6, -1, 0)), "forResult")
constant Collected = (Emptied, InstructionEntry.LoopBegin(0, -1), InstructionEntry.Named(InstructionType.InvokeWriteToList, 0, "forResult"), InstructionEntry.Jump(InstructionType.LoopEnd, 2))
constant Collecting = MlirLoops(MlirFunction(List(TypeEntry), MlirFunction.Shape, MethodEntry("Run", List(MemberEntry), "None", Collected)), 1)
constant Doubling = MlirLoops(MlirKernel.Doubler, 2)
constant Ranging = MlirLoops(MlirFunction(List(TypeEntry) + MlirParallel.Rows, MlirParallel.Rows, GpuNumberSamples.Ranged), 3)
constant IndexAssigned = (InstructionEntry.LoadNumber(1, 2), InstructionEntry.Named(InstructionType.StoreRegisterToVariable, 1, "numbers(index)"), InstructionEntry.Jump(InstructionType.LoopEnd, 2))
constant Assigning = MlirLoops(MlirFunction(List(TypeEntry) + MlirFunction.Shape, MlirFunction.Shape, MethodEntry("Run", List(MemberEntry) + MlirLists.Items, "None", MlirBytes.Looped + IndexAssigned)), 1)
constant Repeated = MlirFunction(List(TypeEntry), MlirFunction.Shape, MethodEntry("Run", List(MemberEntry), "None", (InstructionEntry.LoopBegin(0, -1), InstructionEntry(InstructionType.LoopEnd, List(Text), (1, -1)))))
constant ReturningLoop = (InstructionEntry.LoopBegin(0, -1), InstructionEntry.Return(0), InstructionEntry.Jump(InstructionType.LoopEnd, 1))
constant Returned = MlirFunction(List(TypeEntry), MlirFunction.Shape, MethodEntry("Run", List(MemberEntry), "Strict/Number", ReturningLoop))
constant TextStarted = (InstructionEntry.LoadText(0, ""), InstructionEntry.Named(InstructionType.StoreRegisterToVariable, 0, "forResult"), InstructionEntry.LoadText(0, "ab"))
constant Lettered = (InstructionEntry.Named(InstructionType.LoadVariableToRegister, 1, "value"), InstructionEntry.Invoke(2, ("Strict/Character", "from", "Strict/Character", "text"), 1, -1))
constant LetterAdded = (InstructionEntry.Named(InstructionType.LoadVariableToRegister, 3, "forResult"), InstructionEntry.Binary(InstructionType.Add, (3, 2, 4)))
constant Spelled = TextStarted + InstructionEntry.LoopBegin(0, -1) + Lettered + LetterAdded + InstructionEntry.Named(InstructionType.StoreRegisterToVariable, 4, "forResult")
constant TextCreated = ("    %t3a = arith.maximumf %t3n, %zero : f64", "    %t3r = func.call @strict_text_new(%t3a) : (f64) -> f64", "    llvm.store %zero, %spelled3 : f64, !llvm.ptr", "    llvm.store %t3r, %v_forResult : f64, !llvm.ptr")
constant Spelling = MlirLoops(MlirFunction(List(TypeEntry) + TypeEntry.CharacterEntry, MlirFunction.Shape, MethodEntry("Run", List(MemberEntry), "Strict/Text", Spelled + InstructionEntry.Jump(InstructionType.LoopEnd, 6))), 3)
Temp(suffix Text) Text
	Counting.Temp("k") is "%t0k"
	"%t" + position + suffix
Begin Texts
	Counting.Begin.Length is 19
	Text.Combine(Doubling.Begin).IndexOf("@strict_gpu_run(") < Text.Combine(Doubling.Begin).IndexOf("^floop2fast:")
	"    llvm.store %memo11n, %memo11k : f64, !llvm.ptr" is in MlirLoops(MlirGroups.Norming.function, 2).Begin
	entry = function.method.instructions(position)
	isRange = entry.payload(1) is 1
	bounds = MlirChecks(function, position).Counted + (isRange then RangeBounds(entry) else CountBounds(entry))
	indexes = (function.Load(Temp("x"), "%v_index"), function.Load(Temp("y"), "%v_value"))
	saved = bounds + MlirGrouped(function, position).Unset + indexes + Outered
	begun = saved + MlirGpu(function, position).Launched + MlirKernel(function, position).Versioned + Presized
	tail = MlirRangeLoop(function, position).Open("^loop" + position)
	looped = isRange then MlirRangeLoop(function, position).Value else Current
	begun + MlirParallel(function, position).Forked + Items + MlirWholeLoop(function, position).Versioned + tail + looped
Current Texts
	Counting.Current.Length is 4
	Text.Combine(MlirLoops(MlirBytes.Valuing.function, 1).Current).IndexOf("llvm.store %t1g, %v_value") > 0
	constant offset = "    " + Temp("o") + " = arith.mulf " + Temp("k") + ", " + Temp("s") + " : f64"
	constant current = "    " + Temp("c") + " = arith.addf " + Temp("b") + ", " + Temp("o") + " : f64"
	indexed = (offset, current, function.Store(Temp("c"), "%v_index"))
	constant collection = Collection
	if collection is ""
		return indexed + function.Store(Temp("c"), "%v_value")
	if MlirBytes(function, position).IsValued is false
		return indexed
	character = MlirMemory(function, position).Call(Temp("g"), "strict_text_at", (Temp("v"), Temp("c")))
	indexed + (collection is "Text" then List(Text) + character else Read) + function.Store(Temp("g"), "%v_value")
Read Texts
	Listing.Read.Last is "    %t1g = func.call @strict_steady_item(%t1h, %t1ea, %t1v) : (!llvm.ptr, i64, f64) -> f64"
	MlirLoops(Listing.function, 1, true).Read.First.IndexOf("%t1h[%t1ki]") > 0
	MlirLoops(Listing.function, 1, true).Read.Last.IndexOf("%t1ep {alias_scopes") > 0
	MlirLoops(MlirKernel.Calling.function, 1).Read.Length is 1
	MlirLoops(MlirFunction(Listing.function, Packing = "for 32"), 1, true).Read.Last.EndsWith("extf %t1gn : f32 to f64")
	if MlirBytes(function, position).IsIterated or (isChunk or MlirPurity(function, position).IsSteady) is false
		return List(Text) + Element
	at = "    " + Temp("ea") + " = arith.fptosi " + Temp("c") + " : f64 to i64"
	call = "    " + Temp("g") + " = func.call @strict_steady_item(" + Temp("h") + ", " + Temp("ea") + ", " + Temp("v")
	widths = MlirWidths(function, position, "f64", "ki", MlirParameters.ReadScope)
	loaded = widths.Load(Temp("g"), Temp("ep"), Temp("h"), MlirFastLoop.Iterated)
	MlirDeferred(function, position).IsItemized(isChunk) then loaded else (at, call + ") : (!llvm.ptr, i64, f64) -> f64")
Element Text
	Listing.Element.StartsWith("    %t1g = func.call @strict_hoisted_item(%t1h, %t1c, %t1hv, %t1v)")
	Bytewise.Element.StartsWith("    %t1g = func.call @strict_hoisted_byte_item(%t1hb, %t1h, %t1c, %t1hv, %t1v)")
	Bytewise.Read.Length is 1
	constant operands = Temp("h") + ", " + Temp("c") + ", " + Temp("hv") + ", " + Temp("v") + ")"
	bytes = MlirBytes(function, position)
	if bytes.IsIterated
		constant types = " : (!llvm.ptr, !llvm.ptr, f64, i64, f64) -> f64"
		call = " = func.call @strict_hoisted_" + bytes.Item + "_item(" + Temp("hb") + ", "
		return "    " + Temp("g") + call + operands + types
	"    " + Temp("g") + " = func.call @strict_hoisted_item(" + operands + " : (!llvm.ptr, f64, i64, f64) -> f64"
Collection Text
	Counting.Collection is ""
	entry = function.method.instructions(position)
	if entry.payload(1) is 1
		return ""
	kind = MlirLayout(function).Represent(MlirKinds(function).KindOf(position, entry.payload(0)))
	kind is "Text" or kind.StartsWith("List(") then kind else ""
Wanted Texts
	Doubling.Wanted is ("    %t2gd = func.call @strict_gpu_wanted(%t2gc) : (i64) -> i1")
	Ranging.Wanted.Last is "    %t3gd = arith.andi %t3gu, %t3ge : i1"
	wanted = " = func.call @strict_gpu_wanted(" + Temp("gc") + ") : (i64) -> i1"
	if function.method.instructions(position).payload(1) is not 1
		return List(Text) + ("    " + Temp("gd") + wanted)
	flipped = "    " + Temp("ge") + " = arith.xori " + Temp("d") + ", " + Temp("gt") + " : i1"
	ascending = ("    " + Temp("gu") + wanted, "    " + Temp("gt") + " = arith.constant true", flipped)
	ascending + ("    " + Temp("gd") + " = arith.andi " + Temp("gu") + ", " + Temp("ge") + " : i1")
RangeBounds(entry InstructionEntry) Texts
	Counting.RangeBounds(InstructionEntry.LoopBegin(0, 1)).Length is 9
	start = function.Load(Temp("b"), "%r" + entry.payload(0))
	end = function.Load(Temp("e"), "%r" + entry.payload(2))
	constant isDown = "    " + Temp("d") + " = arith.cmpf olt, " + Temp("e") + ", " + Temp("b") + " : f64"
	constant up = "    " + Temp("u") + " = arith.subf " + Temp("e") + ", " + Temp("b") + " : f64"
	constant down = "    " + Temp("w") + " = arith.subf " + Temp("b") + ", " + Temp("e") + " : f64"
	constant count = "    " + Temp("n") + " = arith.select " + Temp("d") + ", " + Temp("w") + ", " + Temp("u") + " : f64"
	constant one = "    " + Temp("p") + " = arith.constant 1.0 : f64"
	constant minusOne = "    " + Temp("q") + " = arith.constant -1.0 : f64"
	constant step = "    " + Temp("s") + " = arith.select " + Temp("d") + ", " + Temp("q") + ", " + Temp("p") + " : f64"
	(start, end, isDown, up, down, count, one, minusOne, step)
CountBounds(entry InstructionEntry) Texts
	Counting.CountBounds(InstructionEntry.LoopBegin(0, -1)).Length is 6
	Counting.CountBounds(InstructionEntry.LoopBegin(0, -1))(4) is "    %t0n = arith.maximumf %t0ns, %t0b : f64"
	constant start = "    " + Temp("b") + " = arith.constant 0.0 : f64"
	constant whole = "    " + Temp("i") + " = arith.fptosi " + Temp("v") + " : f64 to i64"
	constant signed = "    " + Temp("ns") + " = arith.sitofp " + Temp("i") + " : i64 to f64"
	constant count = "    " + Temp("n") + " = arith.maximumf " + Temp("ns") + ", " + Temp("b") + " : f64"
	constant step = "    " + Temp("s") + " = arith.constant 1.0 : f64"
	loaded = function.Load(Temp("v"), "%r" + entry.payload(0))
	if Collection is ""
		return (start, loaded, whole, signed, count, step)
	constant counter = Collection is "Text" then "strict_text_length" else "strict_list_length"
	(start, loaded, MlirMemory(function, position).Call(Temp("n"), counter, List(Text) + Temp("v")), step)
Items Texts
	Listing.Items.First.IndexOf("@strict_list_hoisted(%t1v)") > 0
	MlirLoops(Listing.function, 1, true).Items.First.IndexOf("@strict_list_items(%t1v)") > 0
	Listing.Items.Last is "    %t1hv = func.call @strict_list_version() : () -> i64"
	Bytewise.Items.First is "    %t1hb = func.call @strict_list_bytes(%t1v) : (f64) -> !llvm.ptr"
	Bytewise.Items(1).IndexOf("@strict_list_byte_items(%t1v)") > 0
	Text.Combine(Doubling.Begin).IndexOf("hoisted(%t2v)") > Text.Combine(Doubling.Begin).IndexOf("^loop2serial:")
	constant collection = Collection
	if collection is "" or collection is "Text"
		return List(Text)
	version = "    " + Temp("hv") + " = func.call @strict_list_version() : () -> i64"
	itemizer = MlirDeferred(function, position).IsItemized(isChunk) then "items" else "hoisted"
	MlirBytes(function, position).Hoist(Temp("h"), Temp("v"), itemizer) + version
Outered Texts
	Counting.Outered.Length is 0
	Nested.Outered.Last is "    llvm.store %t0y, %v_outer : f64, !llvm.ptr"
	names = function.Named
	mutable lines = List(Mutable(Text))
	if "outer" is in names
		lines = lines + function.Load(Temp("z"), "%v_outer") + function.Store(Temp("y"), "%v_outer")
	if "outer.index" is in names
		lines = lines + function.Load(Temp("j"), "%v_outer.index") + function.Store(Temp("x"), "%v_outer.index")
	lines
IsCollecting Boolean
	Collecting.IsCollecting
	Counting.IsCollecting is false
	for position
		entry = function.method.instructions(position - 1 - index)
		if entry.kind is in (InstructionType.LoopBegin, InstructionType.LoopEnd)
			return false
		if entry.kind is InstructionType.StoreConstantToVariable and entry.texts.Last is "forResult"
			return entry.payload(0) is 6 and function.method.IsWritingResult(position)
	false
IsSpelling Boolean
	Spelling.IsSpelling
	method = function.method
	stored = MlirKinds(function).Store(position, "forResult")
	start = stored > 0 then method.instructions(stored - 1) else method.instructions(position)
	isEmptied = start.kind is InstructionType.LoadConstantToRegister and Text.Combine(start.texts) is ""
	isText = isEmptied and MlirKinds(function).VariableKind(position, "forResult") is "Text"
	if isText is false or method.LoopBeginOf(stored) is not method.LoopBeginOf(position)
		return false
	for Range(position + 1, method.LoopEndOf(position))
		if MlirTexts(function, value).IsMisspelled(position)
			return false
	-1 is not in method.instructions(method.LoopEndOf(position)).payload
Presized Texts
	Counting.Presized.Length is 0
	Text.Combine(MlirLoops(MlirGiven.Given.function, 2).Presized).IndexOf("@strict_record_list_given(%t2a, ") > 0
	Collecting.Presized.Last is "    llvm.store %t1r, %v_forResult : f64, !llvm.ptr"
	MlirLoops(MlirParallel.Byting.function, 2).Presized.Length is 0
	Spelling.Presized is TextCreated
	isForked = MlirBytes(function, position).IsCollected and MlirParallel(function, position).IsParallel
	if (IsCollecting or IsSpelling) is false or isForked
		return List(Text)
	constant capacity = "    " + Temp("a") + " = arith.maximumf " + Temp("n") + ", %zero : f64"
	reset = function.Store("%zero", "%spelled" + position)
	text = (MlirMemory(function, position).Call(Temp("r"), "strict_text_new", List(Text) + Temp("a")), reset)
	given = MlirGiven(function, position)
	fresh = MlirListDestined(function, position)
	listed = given.Member is "" then fresh.Creat(Temp("r"), Temp("a")) else given.Creat(Temp("r"), Temp("a"))
	(List(Text) + capacity) + (IsSpelling then text else listed) + function.Store(Temp("r"), "%v_forResult")
Restore(begin Number) Texts
	MlirLoops(Nested.function, 2).Restore(0) is List(Text) + "    llvm.store %t0z, %v_outer : f64, !llvm.ptr"
	names = function.Named
	mutable lines = List(Mutable(Text))
	if "outer" is in names
		lines = lines + function.Store("%t" + begin + "z", "%v_outer")
	if "outer.index" is in names
		lines = lines + function.Store("%t" + begin + "j", "%v_outer.index")
	lines
End Texts
	MlirLoops(Counting.function, 1).End.Length is 8
	begin = function.method.LoopBeginOf(position)
	if function.method.instructions(begin).payload(1) is 1
		ranged = MlirRangeLoop(function, position)
		return ranged.Close(begin) + ranged.Finish(begin)
	load = "    " + Temp("k") + " = llvm.load %loop" + begin + " : !llvm.ptr -> f64"
	one = "    " + Temp("u") + " = arith.constant 1.0 : f64"
	next = "    " + Temp("w") + " = arith.addf " + Temp("k") + ", " + Temp("u") + " : f64"
	store = "    llvm.store " + Temp("w") + ", %loop" + begin + " : f64, !llvm.ptr"
	restore = (function.Store("%t" + begin + "x", "%v_index"), function.Store("%t" + begin + "y", "%v_value"))
	tail = Step((load, one, next, store), begin) + ("  ^loop" + begin + "exit:")
	tail + restore + Restore(begin) + MlirKernel(function, begin).Joined
Step(steps Texts, begin Number) Texts
	MlirLoops(Returned, 2).End.First is "  ^loop0exit:"
	MlirLoops(Counting.function, 1).Step(List(Text) + "a", 0) is ("a", "    cf.br ^loop0")
	function.method.instructions(position - 1).kind is InstructionType.Return then List(Text) else steps + Back(begin)
Back(begin Number) Texts
	MlirLoops(Counting.function, 1).Back(0).Length is 1
	MlirLoops(Repeated, 1).Back(0).Last is "    cf.cond_br %t1f, ^loop0, ^loop0exit"
	if -1 is not in function.method.instructions(position).payload
		return List(Text) + ("    cf.br ^loop" + begin)
	flag = "    " + Temp("f") + " = llvm.load %flag : !llvm.ptr -> i1"
	(flag, "    cf.cond_br " + Temp("f") + ", ^loop" + begin + ", ^loop" + begin + "exit")