has function MlirFunction
has position Number
constant Shape = "(!llvm.ptr, i64, i64) -> f64"
constant Signature = "(%context: !llvm.ptr, %from: i64, %to: i64) -> f64 {"
constant Slot = " : (!llvm.ptr) -> !llvm.ptr, f64"
constant NumberParameter = List(MemberEntry) + MemberEntry("number", "Strict/Number", List(InstructionEntry), false)
constant TwiceInstructions = (InstructionEntry.Named(InstructionType.LoadVariableToRegister, 0, "number"), InstructionEntry.LoadNumber(1, 2), InstructionEntry.Binary(InstructionType.Multiply, (0, 1, 2)), InstructionEntry.Return(2))
constant Twice = MethodEntry("Twice", NumberParameter, "Strict/Number", TwiceInstructions)
constant ValueLoop = (MlirLoops.Emptied, InstructionEntry.Named(InstructionType.LoadVariableToRegister, 0, "numbers"), InstructionEntry.LoopBegin(0, -1), InstructionEntry.Named(InstructionType.LoadVariableToRegister, 1, "value"))
constant WrittenLoopEnd = (InstructionEntry.Named(InstructionType.InvokeWriteToList, 2, "forResult"), InstructionEntry.Jump(InstructionType.LoopEnd, 4))
constant TwiceCall = InstructionEntry.Invoke(2, ("Strict/Rows", "Twice", "Strict/Number", "number"), List(Number) + 1, -1)
constant Doubled = MethodEntry("Doubled", List(MemberEntry) + MlirLists.Items, "Strict/List(Number)", ValueLoop + TwiceCall + WrittenLoopEnd)
constant RandomCall = InstructionEntry.Invoke(2, ("Strict/Number", "Random", "Strict/Number"), List(Number), 1)
constant NowCall = InstructionEntry.Invoke(2, ("Strict/Time", "Now", "Strict/Number"), List(Number), -1)
constant Timed = MethodEntry("Timed", List(MemberEntry) + MlirLists.Items, "Strict/List(Number)", ValueLoop + NowCall + WrittenLoopEnd)
constant PositiveCheck = (InstructionEntry.LoadNumber(2, 0), InstructionEntry.Binary(InstructionType.GreaterThan, (1, 2)), InstructionEntry.Jump(InstructionType.JumpToIdIfFalse, 0))
constant PositiveWritten = (InstructionEntry.Named(InstructionType.InvokeWriteToList, 1, "forResult"), InstructionEntry.Jump(InstructionType.JumpEnd, 0), InstructionEntry.Jump(InstructionType.LoopEnd, 7))
constant Filtered = MethodEntry("Filtered", List(MemberEntry) + MlirLists.Items, "Strict/List(Number)", ValueLoop + PositiveCheck + PositiveWritten)
constant Rows = TypeEntry("Strict/Rows", List(MemberEntry), (Twice, Doubled, Timed, Filtered))
constant Trailing = MlirParallel(MlirFunction(List(TypeEntry) + Rows, Rows, GpuLayerSamples.Trailing), 2)
constant Byted = MethodEntry("Byted", Doubled.parameters, "Strict/Bytes", (List(InstructionEntry) + MlirLayout.Bytings.method.instructions(0)) + Doubled.instructions.Slice(1, 5))
constant Byting = MlirParallel(MlirFunction(List(TypeEntry) + Rows, Rows, Byted), 2)
constant Doubling = MlirParallel(MlirFunction(List(TypeEntry) + Rows, Rows, Doubled), 2)
constant Timing = MlirParallel(MlirFunction(List(TypeEntry) + Rows, Rows, Timed), 2)
constant Randomizing = MlirParallel(MlirFunction(Timing.function, method = MethodEntry(Timed, instructions = ValueLoop + RandomCall + WrittenLoopEnd)), 2)
constant Effects = MlirPurity.Caching.function.method.instructions + InstructionEntry.Print("value") + InstructionEntry.Invoke(3, ("Strict/Runtime/Hosted", "Result", "Strict/Number"), List(Number), -1)
constant Held = MlirParallel(MlirFunction(Doubling.function, safeCalls = Dictionary(("Rows_Twice_1", 2))), 2)
constant Compiling = MlirParallel(MlirFunction(Held.function, types = List(TypeEntry) + TypeEntry("Strict", List(MemberEntry), List(MethodEntry)) + Rows), 2)
constant Logging = MlirParallel(MlirFunction(List(TypeEntry) + Rows + MlirPurity.Hosting, Rows, MethodEntry(Timed, instructions = Timed.instructions.Slice(0, 4) + Effects + Timed.instructions.Slice(5, 2))), 2)
IsParallel Boolean
	Doubling.IsParallel and Logging.IsParallel and Randomizing.IsParallel and Timing.IsParallel is false
	MlirParallel(MlirFunction(List(TypeEntry) + Rows, Rows, Filtered), 2).IsParallel
	MlirParallel(MlirKernel.Doubling.function, 2).IsParallel
	MlirParallel(MlirFunction(Logging.function, method = MlirPurity.Written), 2).IsParallel is false
	isBegin = function.method.instructions(position).kind is InstructionType.LoopBegin
	isSpecial = function.IsCounted or MlirLayout(function).IsInitializer
	if isBegin is false or isSpecial or MlirLoops(function, position).IsCollecting is false
		return false
	for Range(position + 1, function.method.LoopEndOf(position))
		if MlirPurity(function, position).IsSafe(function, value, 0) is false
			return false
	MlirFiltering(function, position).IsFilteringValues is false
Snapshot Texts
	Text.Combine(Doubling.Snapshot, " ") is "%p0 %p1 %r0 %r1 %r2 %r3 %r4 %v_index %v_value %v_numbers %v_forResult"
	mutable names = List(Mutable(Text))
	for function.Parameters
		names.Add("%p" + index)
	for LoadReuse(function.method.instructions).RegisterCount
		names.Add("%r" + index)
	for function.VariableNames
		names.Add("%v_" + value)
	names
Temp(suffix Text) Text
	Doubling.Temp("pn") is "%t2pn"
	"%t" + position + suffix
Forked Texts
	Text.Combine(Doubling.Forked).IndexOf("func.call @strict_parallel(%t2pf, %t2pc, %t2pn)") > 0
	Timing.Forked.Length is 0
	Text.Combine(Byting.Forked).IndexOf("@strict_packed_new(%t2pkelements, %t2pkformat)") > 0
	if IsParallel is false
		return List(Text)
	count = "    " + Temp("pn") + " = arith.fptosi " + Temp("n") + " : f64 to i64"
	threshold = "    " + Temp("pt") + " = arith.constant " + MlirCost(function, position).Threshold + " : i64"
	label = "^loop" + position
	branch = "    cf.cond_br " + Temp("pb") + ", " + label + "parallel, " + label + "serial"
	packed = MlirBytes(function, position).Creat(Temp("pk")) + MlirFiltering(function, position).Holed
	checked = (List(Text) + count + threshold) + Enough + branch
	given = MlirGiven(function, position)
	serial = given.Member is "" then List(Text) else given.Serial
	checked + ("  " + label + "parallel:") + packed + Context + Joined + ("  " + label + "serial:") + serial
Enough Texts
	Doubling.Enough(2) is "    %t2pww = func.call @strict_parallel_worth(%t2pwf, %t2pn) : (" + Shape + ", i64) -> i1"
	Doubling.Enough.Last is "    %t2pb = arith.andi %t2pwc, %t2pww : i1"
	Held.Enough(1) is "    %t2pwr = func.call @strict_parallel_forkable() : () -> i1"
	Text.Combine(Held.Forked).IndexOf("forkable") > 0 and Text.Combine(Doubling.Forked).IndexOf("forkable") < 0
	Text.Combine(Compiling.Forked).IndexOf("forkable") < 0
	compared = "    " + Temp("pwc") + " = arith.cmpi sge, " + Temp("pn") + ", " + Temp("pt") + " : i64"
	isGpu = MlirCost(function, position).IsCompiler then false else MlirPurity(function, position).IsReachingGpu
	flag = Temp(isGpu then "pwr" else "pww")
	body = "    " + Temp("pwf") + " = func.constant @" + Symbol + " : " + Shape
	called = "(" + Temp("pwf") + ", " + Temp("pn") + ") : (" + Shape + ", i64) -> i1"
	worth = (body, "    " + flag + " = func.call @strict_parallel_worth" + called)
	chosen = isGpu then List(Text) + ("    " + flag + " = func.call @strict_parallel_forkable() : () -> i1") else worth
	(List(Text) + compared) + chosen + ("    " + Temp("pb") + " = arith.andi " + Temp("pwc") + ", " + flag + " : i1")
Symbol Text
	Doubling.Symbol is "Rows_Doubled_1_loop2"
	child = MlirWholeChild(function, position)
	child.IsWhole then child.Symbol else function.Symbol + "_loop" + position
Context Texts
	Doubling.Context.Last is "    func.call @strict_rc_object(%t2pc, %t2ps) : (!llvm.ptr, i64) -> ()"
	names = Snapshot
	size = "    " + Temp("ps") + " = arith.constant " + names.Length * 8 + " : i64"
	mutable lines = (size, "    " + Temp("pc") + " = func.call @strict_alloc(" + Temp("ps") + ") : (i64) -> !llvm.ptr")
	for names
		address = "    " + Temp("pa" + index) + " = llvm.getelementptr " + Temp("pc") + "[" + index + "]"
		stored = value.StartsWith("%p") then value else Temp("pv" + index)
		loaded = value.StartsWith("%p") then List(Text) else List(Text) + function.Load(stored, value)
		store = "    llvm.store " + stored + ", " + Temp("pa" + index) + " : f64, !llvm.ptr"
		lines = lines + loaded + (address + Slot) + store
	lines + MlirMemory.Counted.Replace("%p", Temp("pc")).Replace("%z", Temp("ps"))
Filler Text
	Doubling.Filler is "strict_list_filled_numbers"
	Byting.Filler is "strict_list_filled_numbers"
	kind = MlirLayout(function).Represent(MlirKinds(function).VariableKind(position, "forResult"))
	isPlain = kind is "List(Number)" or MlirBytes(function, position).IsCollected
	isPlain then "strict_list_filled_numbers" else "strict_list_filled"
Joined Texts
	Doubling.Joined.Slice(Doubling.Joined.Length - 2, 2) is (Doubling.Released, "    cf.br ^loop2exit")
	body = "    " + Temp("pf") + " = func.constant @" + Symbol + " : " + Shape
	operands = "(" + Temp("pf") + ", " + Temp("pc") + ", " + Temp("pn") + ") : (" + Shape + ", !llvm.ptr, i64) -> f64"
	failed = "    " + Temp("pe") + " = func.call @strict_is_failure(" + Temp("pr") + ") : (f64) -> i1"
	branch = "    cf.cond_br " + Temp("pe") + ", ^loop" + position + "failed, ^loop" + position + "filled"
	label = "  ^loop" + position
	returned = (label + "failed:", "    return " + Temp("pr") + " : f64", label + "filled:")
	called = (List(Text) + body) + MlirKernelLaunch(function, position).EmitLaunch(operands) + (failed, branch)
	filled = MlirFiltering(function, position).Fill(Filler) + Released
	called + returned + function.Load(Temp("pl"), "%v_forResult") + filled + ("    cf.br ^loop" + position + "exit")
Released Text
	Doubling.Released is "    func.call @strict_rc_unobject(%t2pc, %t2ps) : (!llvm.ptr, i64) -> ()"
	MlirMemory.Counted.Replace("_object(%p, %z)", "_unobject(" + Temp("pc") + ", " + Temp("ps") + ")")
Outlined Texts
	Doubling.Outlined.First is "  func.func private @Rows_Doubled_1_loop2" + Signature
	Timing.Outlined.Length is 0
	mutable lines = List(Mutable(Text))
	for function.method.instructions
		if value.kind is InstructionType.LoopBegin and MlirParallel(function, index).IsParallel
			lines = lines + MlirParallel(function, index).Child + MlirWholeChild(function, index).Lines
	lines
Child Texts
	Doubling.Child.Last is "  }"
	header = "  func.func private @" + function.Symbol + "_loop" + position + Signature
	count = function.Parameters.Length
	List(Text) + header + Restore(0, count) + function.Slots + Restore(count, Snapshot.Length) + Iterated + "  }"
Restore(first Number, limit Number) Texts
	Doubling.Restore(0, 1).Last is "    %p0 = llvm.load %t2qa0 : !llvm.ptr -> f64"
	Doubling.Restore(2, 3).Last is "    llvm.store %t2qv2, %r0 : f64, !llvm.ptr"
	names = Snapshot
	mutable lines = List(Mutable(Text))
	for Range(first, limit)
		name = names(value)
		target = name.StartsWith("%p") then name else Temp("qv" + value)
		address = "    " + Temp("qa" + value) + " = llvm.getelementptr %context[" + value + "]" + Slot
		stored = name.StartsWith("%p") then List(Text) else List(Text) + function.Store(target, name)
		lines = lines + address + ("    " + target + " = llvm.load " + Temp("qa" + value) + " : !llvm.ptr -> f64") + stored
	lines
Iterated Texts
	Text.Combine(Doubling.Iterated).IndexOf("cf.br ^loop2child(%from : i64)") > 0
	Text.Combine(Byting.Iterated).IndexOf("@strict_list_data(%t2rv)") > 0
	Text.Combine(Doubling.Iterated).IndexOf("%t2g = llvm.load %t2ep") > 0
	Text.Combine(Doubling.Iterated).IndexOf("  ^fhloop2packed:") > 0
	loops = MlirLoops(function, position, true)
	entry = function.method.instructions(position)
	bounds = entry.payload(1) is 1 then loops.RangeBounds(entry) else loops.CountBounds(entry)
	itemizer = MlirBytes(function, position).Itemizer
	items = "    " + Temp("ri") + " = func.call " + itemizer + "(" + Temp("rv") + ") : (f64) -> !llvm.ptr"
	started = (function.Load(Temp("rv"), "%v_forResult"), items, "    cf.br ^loop" + position + "child(%from : i64)")
	prefix = bounds + loops.Items + started + Checked + loops.Current
	MlirDeferred(function, position).Pack(MlirDeferred(function, position).Version(prefix, prefix + Body + Next))
Checked Texts
	Doubling.Checked.First is "  ^loop2child(%t2ki: i64):"
	label = "^loop" + position + "child"
	compared = "    " + Temp("km") + " = arith.cmpi slt, " + Temp("ki") + ", %to : i64"
	branch = "    cf.cond_br " + Temp("km") + ", " + label + "body, " + label + "exit"
	counter = "    " + Temp("k") + " = arith.sitofp " + Temp("ki") + " : i64 to f64"
	("  " + label + "(" + Temp("ki") + ": i64):", compared, branch, "  " + label + "body:", counter)
Next Texts
	Doubling.Next.Last is "    return %zero : f64"
	label = "^loop" + position + "child"
	next = "    " + Temp("kn") + " = arith.addi " + Temp("ki") + ", %one : i64"
	(next, "    cf.br " + label + "(" + Temp("kn") + " : i64)", "  " + label + "exit:", "    return %zero : f64")
Body Texts
	Text.Combine(MlirParallel(MlirGiven.Given.function, 2).Body).IndexOf("@strict_item_holed(%t2ri, %t2ki, %t2hg)") > 0
	Doubling.Body.Last.StartsWith("    llvm.store %t5e, %t5p")
	Trailing.Body.Last is "  ^bb7:"
	given = MlirGiven(function, position)
	mutable lines = given.Member is "" then List(Text) else given.Holing
	for Range(position + 1, function.method.LoopEndOf(position))
		entry = function.method.instructions(value)
		isCollect = entry.kind is InstructionType.InvokeWriteToList and entry.texts(0) is "forResult"
		emitted = isCollect then Collect(value) else function.Emit(value)
		lines = lines + function.Label(value) + emitted
	end = function.method.LoopEndOf(position)
	end < function.method.instructions.Length then lines + function.Label(end) else lines
Collect(at Number) Texts
	MlirParallel(MlirFiltering.Keeping.function, 2).Collect(7).Last.IndexOf("@strict_rc_written(%t7p)") > 0
	Doubling.Collect(5).Length is 3
	emitted = MlirFastLoop(function, position).Emit(at)
	unholed = MlirFiltering(function, position).Unhole(at) + emitted
	stored = function.IsDeferred then MlirDeferred(function, position).EmitScope(unholed) else unholed
	written = "    func.call @strict_rc_written(%t" + at + "p) : (!llvm.ptr) -> ()"
	Filler is "strict_list_filled" then stored + written else stored