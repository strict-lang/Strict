has function MlirFunction
has position Number
constant Mover = TypeEntry("Strict/Mover", (MemberEntry("position", "Strict/Math/Tripling", List(InstructionEntry), false), MemberEntry("velocity", "Strict/Math/Tripling", List(InstructionEntry), false)), List(MethodEntry))
constant Building = InstructionEntry.Invoke(0, ("Strict/Mover", "from", "Mover", "position", "velocity"), (10, 11), -1)
constant EntityStored = (Building, InstructionEntry.Named(InstructionType.StoreRegisterToVariable, 0, "entity"), InstructionEntry.Named(InstructionType.LoadVariableToRegister, 1, "entity"))
constant PositionTripled = (InstructionEntry(InstructionType.FieldLoad, "position", (2, 1, -1)), InstructionEntry.Invoke(3, ("Strict/Math/Tripling", "Made", "Strict/Math/Tripling"), List(Number), 2))
constant VelocityLoaded = (InstructionEntry.Named(InstructionType.LoadVariableToRegister, 4, "entity"), InstructionEntry(InstructionType.FieldLoad, "velocity", (5, 4, -1)))
constant MoverRebuilt = (InstructionEntry.Invoke(6, ("Strict/Mover", "from", "Mover", "position", "velocity"), (3, 5), -1), InstructionEntry.Named(InstructionType.StoreRegisterToVariable, 6, "entity"))
constant EntityReturned = (InstructionEntry.Named(InstructionType.LoadVariableToRegister, 7, "entity"), InstructionEntry.Return(7))
constant Moving = EntityStored + PositionTripled + VelocityLoaded + MoverRebuilt + EntityReturned
constant Moved = MlirMembered(MlirFunction((MlirDestined.Maker, MlirFlats.Summing, Mover), Mover, MethodEntry("Run", List(MemberEntry), "None", Moving)), 4)
constant Defaulted = MlirMembered(MlirFunction(Moved.function.types, Mover, MethodEntry("Run", List(MemberEntry), "None", List(InstructionEntry) + InstructionEntry.Invoke(0, ("Strict/Mover", "from", "Mover"), List(Number), -1))), 0)
Destine(entry InstructionEntry, compiled Texts) Texts
	Moved.Destine(Moving(4), List(Text) + "call")(2).IndexOf("@strict_flat_destine_member(%t4mo, %t4ms)") > 0
	MlirMembered(Moved.function, 7).Destine(Moving(7), List(Text) + "call") is ("call")
	at = MlirDestined(function, position).Hand(entry) is "strict_flat_destine" then Rebuilding(entry.payload(0)) else -1
	slot = at < 0 then -1 else Slot(at, entry.payload(0))
	name = slot < 0 then "" else Target(at, slot)
	if name is ""
		return MlirStructs(function, position).Aim(entry, MlirDestined(function, position).Next(entry), compiled)
	temp = "%t" + position + "m"
	counted = "    " + temp + "s = arith.constant " + slot + ".0 : f64"
	destined = "    func.call @strict_flat_destine_member(" + temp + "o, " + temp + "s) : (f64, f64) -> ()"
	(function.Load(temp + "o", "%v_" + name), counted, destined) + compiled
Rebuilding(register Number) Number
	Moved.Rebuilding(3) is 7
	Moved.Rebuilding(9) is -1
	steps = function.method.instructions
	reuse = LoadReuse(steps)
	for Range(position + 1, steps.Length)
		step = steps(value)
		if (step.kind is InstructionType.Invoke then step.texts(1) is "from" else false) and register is in reuse.Reads(step)
			return value
		if reuse.Write(step) is register
			return Number.NotFound
	Number.NotFound
Slot(at Number, register Number) Number
	Moved.Slot(7, 3) is 0
	Moved.Slot(7, 5) is 1
	Defaulted.Slot(0, 0) is -1
	entry = function.method.instructions(at)
	arguments = PayloadDecoder(entry).Arguments
	names = Invocation(entry, List(VmValue), VmValue.None).ParameterNames
	for MlirInstances(function, 0).Store(function.TypeOf(entry.texts(0), true))
		chosen = names.Index(value.Name) < 0 then index else names.Index(value.Name)
		if chosen < arguments.Length then arguments(chosen) is register else false
			return index
	Number.NotFound
Target(at Number, slot Number) Text
	Moved.Target(7, 0) is "entity"
	Moved.Target(7, 1) is ""
	entry = function.method.instructions(at)
	owner = function.TypeOf(entry.texts(0), true)
	name = MlirOwned(function, at).Target(entry, owner)
	if name is "" or MlirAlone(function).IsAlone(name) is false
		return ""
	IsKept(MlirInstances(function, 0).Store(owner)(slot).Name) then name else ""
IsKept(member Text) Boolean
	Moved.IsKept("position")
	MlirMembered(Moved.function, 7).IsKept("position") is false
	steps = function.method.instructions
	for steps
		isField = value.kind is InstructionType.FieldLoad then value.texts(0) is member else false
		isConsumed = isField then MlirFlats(function, index).IsConsumed(steps, index, value.payload(0)) else true
		if (isConsumed or Reader(index, value.payload(0)) is position) is false
			return false
	true
Reader(at Number, register Number) Number
	Moved.Reader(3, 2) is 4
	Moved.Reader(4, 3) is 7
	steps = function.method.instructions
	reuse = LoadReuse(steps)
	for Range(at + 1, steps.Length)
		if register is in reuse.Reads(steps(value)) and steps(value).kind is not InstructionType.CheckError
			return value
	Number.NotFound
