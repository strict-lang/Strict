has function MlirFunction
has position Number
constant Sample = MlirMemory(MlirFunction.Counter, 3)
constant Pair = TypeEntry("Strict/Pair", (MemberEntry("first", "Strict/Number", List(InstructionEntry), false), MemberEntry("rest", "Strict/List(Number)", List(InstructionEntry), false)), List(MethodEntry))
constant Pairing = MlirMemory(MlirFunction(List(TypeEntry) + Pair, Pair, MethodEntry("Run", List(MemberEntry) + MemberEntry("pair", "Strict/Pair", List(InstructionEntry), false), "None", List(InstructionEntry))), 0)
Temp(suffix Text) Text
	Sample.Temp("p") is "%t3p"
	"%t" + position + suffix
Pointer(bits Text, suffix Text) Texts
	Sample.Pointer("%v", "a") is ("    %t3ap = func.call @strict_ptr(%v) : (f64) -> !llvm.ptr")
	List(Text) + ("    " + Temp(suffix + "p") + " = func.call @strict_ptr(" + bits + ") : (f64) -> !llvm.ptr")
Bits(pointer Text, suffix Text) Texts
	Sample.Bits("%p", "a") is ("    %t3af = func.call @strict_bits(%p) : (!llvm.ptr) -> f64")
	Boxed(pointer, suffix, "")
Boxed(pointer Text, suffix Text, typeName Text) Texts
	Sample.Boxed("%p", "a", "Strict/Error").First is "    %t3afe = func.call @strict_error_bits(%p) : (!llvm.ptr) -> f64"
	Sample.Boxed("%p", "a", "Strict/Error").Last.StartsWith("    %t3af = func.call @strict_trace(%t3afe,") is true
	let short = TypeEntry.ShortName(typeName)
	if short is "Error"
		let tagged = "    " + Temp(suffix + "fe") + " = func.call @strict_error_bits(" + pointer + ") : (!llvm.ptr) -> f64"
		return List(Text) + tagged + Traced(Temp(suffix + "fe"), Temp(suffix + "f"))
	let helper = short is "ErrorWithValue" then "strict_error_value_bits" else "strict_bits"
	List(Text) + ("    " + Temp(suffix + "f") + " = func.call @" + helper + "(" + pointer + ") : (!llvm.ptr) -> f64")
Allocated(slots Number, suffix Text) Texts
	Sample.Allocated(2, "o").First is "    %t3oz = arith.constant 16 : i64"
	Sample.Allocated(2, "o").Last is "    %t3op = func.call @strict_alloc(%t3oz) : (i64) -> !llvm.ptr"
	let size = "    " + Temp(suffix + "z") + " = arith.constant " + (slots < 1 then 8 else slots * 8) + " : i64"
	(size, "    " + Temp(suffix + "p") + " = func.call @strict_alloc(" + Temp(suffix + "z") + ") : (i64) -> !llvm.ptr")
Slot(base Text, index Number, suffix Text) Text
	Sample.Slot("%b", 2, "s") is "    %t3s = llvm.getelementptr %b[2] : (!llvm.ptr) -> !llvm.ptr, f64"
	"    " + Temp(suffix) + " = llvm.getelementptr " + base + "[" + index + "] : (!llvm.ptr) -> !llvm.ptr, f64"
Loaded(base Text, index Number, suffix Text) Texts
	Sample.Loaded("%b", 0, "m").Last is "    %t3mv = llvm.load %t3m : !llvm.ptr -> f64"
	(Slot(base, index, suffix), function.Load(Temp(suffix + "v"), Temp(suffix)))
Called(result Text, name Text, operands Texts) Text
	Sample.Called("%r", "add", ("%a", "%b")) is "    %r = func.call @add(%a, %b) : (f64, f64) -> f64"
	let types = Text.Combine(MlirCalls(function, position).ArgumentTypes(operands.Length), ", ")
	"    " + result + " = func.call @" + name + "(" + Text.Combine(operands, ", ") + ") : (" + types + ") -> f64"
Traced(operand Text, result Text) Texts
	Sample.Traced("%r", "%x").Last is "    %x = func.call @strict_trace(%r, %t3tw, %t3twl) : (f64, !llvm.ptr, i64) -> f64"
	let instructions = function.method.instructions
	let line = position < instructions.Length then instructions(position).line else 0
	let address = "    " + Temp("tw") + " = llvm.mlir.addressof @w" + function.Symbol + " : !llvm.ptr"
	let call = " = func.call @strict_trace(" + operand + ", " + Temp("tw") + ", " + Temp("twl") + ")"
	let number = "    " + Temp("twl") + " = arith.constant " + line + " : i64"
	(address, number, "    " + result + call + " : (f64, !llvm.ptr, i64) -> f64")
Member(path Text) Numbers
	Pairing.Member("pair.rest") is (1, 2)
	let dot = path.IndexOf(".")
	let ownerType = function.TypeOf(MlirKinds(function).VariableKind(position, path.Substring(0, dot)))
	let names = MlirInstances(function, position).StoredNames(ownerType)
	(names.Index(path.Substring(dot + 1, path.Length - dot - 1)), names.Length)
Changed(path Text, element Text, result Text) Texts
	Pairing.Changed("pair.rest", "%c", "%r").Last.IndexOf("@strict_instance_with(%t0o, %t0ms, %c, %t0mc)") > 0 is true
	let member = Member(path)
	let slot = "    " + Temp("ms") + " = arith.constant " + member.First + ".0 : f64"
	let count = "    " + Temp("mc") + " = arith.constant " + member.Last + ".0 : f64"
	(slot, count, Called(result, "strict_instance_with", (Temp("o"), Temp("ms"), element, Temp("mc"))))
