has function MlirFunction
has position Number
constant Sample = MlirMemory(MlirFunction.Counter, 3)
Temp(suffix Text) Text
	Sample.Temp("p") is "%t3p"
	"%t" + position + suffix
Pointer(bits Text, suffix Text) Texts
	Sample.Pointer("%v", "a") is ("    %t3ap = func.call @strict_ptr(%v) : (f64) -> !llvm.ptr")
	List(Text) + ("    " + Temp(suffix + "p") + " = func.call @strict_ptr(" + bits + ") : (f64) -> !llvm.ptr")
Bits(pointer Text, suffix Text) Texts
	Sample.Bits("%p", "a") is ("    %t3af = func.call @strict_bits(%p) : (!llvm.ptr) -> f64")
	Boxed(pointer, suffix, "")
Boxed(pointer Text, suffix Text, typeName Text) Texts
	Sample.Boxed("%p", "a", "Strict/Error") is ("    %t3af = func.call @strict_error_bits(%p) : (!llvm.ptr) -> f64")
	let short = TypeEntry.ShortName(typeName)
	let tagged = short is "ErrorWithValue" then "strict_error_value_bits" else "strict_bits"
	let helper = short is "Error" then "strict_error_bits" else tagged
	List(Text) + ("    " + Temp(suffix + "f") + " = func.call @" + helper + "(" + pointer + ") : (!llvm.ptr) -> f64")
Allocated(slots Number, suffix Text) Texts
	Sample.Allocated(2, "o").First is "    %t3oz = arith.constant 16 : i64"
	Sample.Allocated(2, "o").Last is "    %t3op = func.call @strict_alloc(%t3oz) : (i64) -> !llvm.ptr"
	let size = "    " + Temp(suffix + "z") + " = arith.constant " + (slots < 1 then 8 else slots * 8) + " : i64"
	(size, "    " + Temp(suffix + "p") + " = func.call @strict_alloc(" + Temp(suffix + "z") + ") : (i64) -> !llvm.ptr")
Slot(base Text, index Number, suffix Text) Text
	Sample.Slot("%b", 2, "s") is "    %t3s = llvm.getelementptr %b[2] : (!llvm.ptr) -> !llvm.ptr, f64"
	"    " + Temp(suffix) + " = llvm.getelementptr " + base + "[" + index + "] : (!llvm.ptr) -> !llvm.ptr, f64"
Loaded(base Text, index Number, suffix Text) Texts
	Sample.Loaded("%b", 0, "m").Last is "    %t3mv = llvm.load %t3m : !llvm.ptr -> f64"
	(Slot(base, index, suffix), function.Load(Temp(suffix + "v"), Temp(suffix)))
Called(result Text, name Text, operands Texts) Text
	Sample.Called("%r", "add", ("%a", "%b")) is "    %r = func.call @add(%a, %b) : (f64, f64) -> f64"
	let types = Text.Combine(MlirCalls(function, position).ArgumentTypes(operands.Length), ", ")
	"    " + result + " = func.call @" + name + "(" + Text.Combine(operands, ", ") + ") : (" + types + ") -> f64"