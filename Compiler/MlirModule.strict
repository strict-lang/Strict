has types List(TypeEntry)
has entryName Text
has countedFiles Texts = List(Text)
has entries = 1
constant Counters = MlirModule(List(TypeEntry) + TypeEntry("Strict/Counter", List(MemberEntry), List(MethodEntry) + MethodEntry.CountingLoop), "Run")
constant Pair = MlirModule(Counters.types + TypeEntry("Strict/Other", List(MemberEntry), List(MethodEntry) + MethodEntry.CountingLoop), "Run", List(Text), 2)
constant NoFunctions = List(MlirFunction)
constant NoRun = MlirModule(List(TypeEntry) + TypeEntry("Strict/Empty", List(MemberEntry), List(MethodEntry)), "Tests")
Text Text
	Counters.Text.StartsWith("module {")
	NoRun.Text.StartsWith("unsupported:")
	let functions = Functions
	if functions.First.method.instructions.Length is 0
		return "unsupported: no " + entryName + " method without parameters in " + types.First.Name
	let counted = countedFiles.Length is 0 then functions else MlirLines.Counted(functions, Mains, countedFiles)
	Combined(Declared(counted, functions), functions, counted)
Declared(texts List(MlirFunction), functions List(MlirFunction)) Texts
	Counters.Declared(Counters.Functions, Counters.Functions).First is "module {"
	MlirRecursion.Looped.Text.IndexOf("^stackChecked") > MlirRecursion.Looped.Text.IndexOf("@Looped_Again_0(")
	let recursive = MlirRecursion(functions, entries).Recursive
	mutable lines = ("module {", "  llvm.func @printf(!llvm.ptr, ...) -> i32") + MlirTexts.Declarations
	for texts
		lines = lines + MlirFunction(value, IsRecursive = value.Symbol is in recursive).Text
	lines + MlirEquality(functions.First, 0).Functions + MlirAutomatic(functions.First).Functions
Combined(lines Texts, functions List(MlirFunction), counted List(MlirFunction)) Text
	Counters.Combined(List(Text), Counters.Functions, Counters.Functions).EndsWith("}")
	let table = countedFiles.Length is 0 then List(Text) else MlirLines.Table(functions, Mains, countedFiles)
	let main = MlirEntry(counted.First, Others(counted)).Main
	let host = outer.Text.Combine(lines + MlirGlobals(functions).Lines + table + main + "}", "\n")
	let device = MlirGpu.Module(functions)
	device is "" then host else host + "\n" + device
Functions List(MlirFunction)
	Counters.Functions.Length is 1
	Pair.Functions.Length is 2
	Pair.Text.IndexOf("@Other_Run_0(%self1)") > 0
	Reachable(Entries, Entries)
Entries List(MlirFunction)
	Pair.Entries.Last.Symbol is "Other_Run_0"
	for Range(0, entries)
		MlirFunction(types, types(value), RunMethod(types(value)))
Mains List(TypeEntry)
	Pair.Mains.Last.Name is "Strict/Other"
	for Range(0, entries)
		types(value)
Others(counted List(MlirFunction)) List(MlirFunction)
	Pair.Others(Pair.Functions).First.Symbol is "Other_Run_0"
	for Range(1, entries)
		counted(value)
RunMethod(main TypeEntry) MethodEntry
	Counters.RunMethod(TypeEntry("Strict/Empty", List(MemberEntry), List(MethodEntry))).instructions.Length is 0
	for main.methods
		if value.Name is entryName
			return value
	MethodEntry(entryName, List(MemberEntry), "None", List(InstructionEntry))
Reachable(known List(MlirFunction), fresh List(MlirFunction)) List(MlirFunction)
	Counters.Reachable(Counters.Functions, Counters.Functions).Length is 1
	mutable symbols = Symbols(known)
	mutable found = List(Mutable(MlirFunction))
	for fresh
		for Callees(value)
			let symbol = value.Symbol
			if symbol is not in symbols
				found.Add(value)
				symbols = symbols + symbol
	found.Length is 0 then known else Reachable(known + found, found)
Symbols(functions List(MlirFunction)) Texts
	Counters.Symbols(Counters.Functions) is ("Counter_Run_0")
	for functions
		value.Symbol
Callees(function MlirFunction) List(MlirFunction)
	Counters.Callees(Counters.Functions.First).Length is 0
	mutable callees = List(Mutable(MlirFunction))
	for function.method.instructions
		callees = callees + Called(function, index)
	callees
Called(function MlirFunction, position Number) List(MlirFunction)
	Counters.Called(Counters.Functions.First, 0).Length is 0
	let entry = function.method.instructions(position)
	if entry.kind is not InstructionType.Invoke
		return List(MlirFunction)
	let decoder = PayloadDecoder(entry)
	if MlirCalls(function, position).NativeHelper(entry, decoder) is not ""
		return List(MlirFunction)
	let type = Natives(types).TypeOf(decoder.Text(1))
	let callee = decoder.Callee(type)
	let called = MlirFunction(types, type, callee)
	(callee.instructions.Length > 0) or MlirForeign(called).IsForeign then NoFunctions + called else NoFunctions