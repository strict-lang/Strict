has types List(TypeEntry)
has entryName Text
has countedFiles Texts = List(Text)
has entries = 1
has entrySymbol Text = "main"
constant Counters = MlirModule(List(TypeEntry) + TypeEntry("Strict/Counter", List(MemberEntry), List(MethodEntry) + MethodEntry.CountingLoop), "Run")
constant Pair = MlirModule(Counters.types + TypeEntry("Strict/Other", List(MemberEntry), List(MethodEntry) + MethodEntry.CountingLoop), "Run", List(Text), 2)
constant NoFunctions = List(MlirFunction)
constant Floor = MethodEntry("Floor", List(MemberEntry), "Strict/Number", List(InstructionEntry) + InstructionEntry.Return(0))
constant FloorCall = InstructionEntry.Invoke(0, ("Strict/Degrees", "Floor", "Strict/Number"), List(Number), -1)
constant Caller = TypeEntry("Strict/Caller", List(MemberEntry), MethodEntry("Run", List(MemberEntry), "None", FloorCall))
constant Floored = MlirModule((Caller, MlirLayout.Degrees, TypeEntry("Strict/Number", List(MemberEntry), List(MethodEntry) + Floor)), "Run")
constant NoRun = MlirModule(List(TypeEntry) + TypeEntry("Strict/Empty", List(MemberEntry), List(MethodEntry)), "Tests")
Text Text
	Counters.Text.StartsWith("module {")
	NoRun.Text.StartsWith("unsupported:")
	let started = Process.Elapsed
	let reachable = Functions
	BuildProfile(Logger).Reported("Emission / reachability (" + reachable.Length + " functions)", started)
	let edges = MlirRecursion(reachable, entries).Edges
	let functions = Safe(reachable, edges)
	if functions.First.method.instructions.Length is 0
		return "unsupported: no " + entryName + " method without parameters in " + types.First.Name
	let counted = countedFiles.Length is 0 then functions else MlirLines.Counted(functions, Mains, countedFiles)
	Combined(Declared(counted, functions, edges), functions, counted)
Safe(reachable List(MlirFunction), edges List(Numbers)) List(MlirFunction)
	Counters.Safe(Counters.Functions, List(Numbers) + List(Number)).Length is 1
	let started = Process.Elapsed
	let functions = MlirSafety(reachable, edges).Marked
	BuildProfile(Logger).Reported("Emission / safety", started)
	functions
Declared(texts List(MlirFunction), functions List(MlirFunction), edges List(Numbers)) Texts
	Counters.Declared(Counters.Functions, Counters.Functions, List(Numbers) + List(Number)).First is "module {"
	MlirRecursion.Looped.Text.IndexOf("^stackChecked") > MlirRecursion.Looped.Text.IndexOf("@Looped_Again_0(")
	let started = Process.Elapsed
	let recursive = MlirRecursion(functions, entries).Recursive(edges)
	BuildProfile(Logger).Reported("Emission / recursion", started)
	let lines = ("module {", "  llvm.func @printf(!llvm.ptr, ...) -> i32") + MlirTexts.Declarations
	let emitted = BuildProfile(Logger).Emitted(value, texts, functions, recursive)
	let before = Process.Elapsed
	let result = lines + emitted + MlirEquality(functions.First, 0).Functions + MlirAutomatic(functions.First).Functions
	BuildProfile(Logger).Reported("Emission / helpers", before)
	result
Emitted(texts List(MlirFunction), functions List(MlirFunction), recursive Texts) Texts
	Counters.Emitted(Counters.Functions, Counters.Functions, List(Text)).First.IndexOf("@Counter_Run_0(") > 0
	mutable emitted = List(Text)
	for texts
		emitted = emitted + Emission(value, functions, recursive)
	emitted
Emission(function MlirFunction, functions List(MlirFunction), recursive Texts) Text
	Counters.Emission(MlirWhole.Row.function, NoFunctions, List(Text)).IndexOf("alwaysinline") > 0
	let emitted = MlirFunction(function, IsRecursive = function.Symbol is in recursive).Text
	let whole = MlirWholeBody(function, functions).Lines
	whole.Length is 0 then emitted else emitted + "\n" + outer.Text.Combine(whole, "\n")
Combined(lines Texts, functions List(MlirFunction), counted List(MlirFunction)) Text
	Counters.Combined(List(Text), Counters.Functions, Counters.Functions).EndsWith("}")
	let table = countedFiles.Length is 0 then List(Text) else MlirLines.Table(functions, Mains, countedFiles)
	let started = Process.Elapsed
	let device = MlirGpu.Module(functions)
	BuildProfile(Logger).Reported("Emission / GPU kernels", started)
	let before = Process.Elapsed
	let main = MlirEntry(counted.First, Others(counted), entrySymbol).Main
	let host = outer.Text.Combine(lines + MlirGlobals(functions).Lines + table + main + "}", "\n")
	BuildProfile(Logger).Reported("Emission / globals and assembly", before)
	device is "" then host else host + "\n" + device
Functions List(MlirFunction)
	Counters.Functions.Length is 1
	Pair.Functions.Length is 2
	Pair.Text.IndexOf("@Other_Run_0(%self1)") > 0
	Floored.Functions.Last.Symbol is "Number_Floor_0"
	Reachable(Entries, Entries)
Entries List(MlirFunction)
	Pair.Entries.Last.Symbol is "Other_Run_0"
	for Range(0, entries)
		MlirFunction(types, types(value), RunMethod(types(value)), typeIndex = TypeIndex)
TypeIndex Dictionary(Text, Number)
	Counters.TypeIndex("Counter") is 0
	Counters.TypeIndex("Strict/Counter") is 0
	mutable indexed = Dictionary(Text, Number)
	for types
		if value.Name is not in indexed
			indexed(value.Name) = index
	for types
		let short = Path(value.Name).FileName.text
		if short is not in indexed
			indexed(short) = index
	indexed
Mains List(TypeEntry)
	Pair.Mains.Last.Name is "Strict/Other"
	for Range(0, entries)
		types(value)
Others(counted List(MlirFunction)) List(MlirFunction)
	Pair.Others(Pair.Functions).First.Symbol is "Other_Run_0"
	for Range(1, entries)
		counted(value)
RunMethod(main TypeEntry) MethodEntry
	Counters.RunMethod(TypeEntry("Strict/Empty", List(MemberEntry), List(MethodEntry))).instructions.Length is 0
	for main.methods
		if value.Name is entryName
			return value
	MethodEntry(entryName, List(MemberEntry), "None", List(InstructionEntry))
Reachable(known List(MlirFunction), fresh List(MlirFunction)) List(MlirFunction)
	Counters.Reachable(Counters.Functions, Counters.Functions).Length is 1
	mutable symbols = Symbols(known)
	mutable found = List(Mutable(MlirFunction))
	for fresh
		for Callees(value)
			let symbol = value.Symbol
			if symbol is not in symbols
				found.Add(value)
				symbols = symbols + symbol
	found.Length is 0 then known else Reachable(known + found, found)
Symbols(functions List(MlirFunction)) Texts
	Counters.Symbols(Counters.Functions) is ("Counter_Run_0")
	for functions
		value.Symbol
Callees(function MlirFunction) List(MlirFunction)
	Counters.Callees(Counters.Functions.First).Length is 0
	mutable callees = List(Mutable(MlirFunction))
	for function.method.instructions
		callees = callees + Called(function, index)
	callees
Called(function MlirFunction, position Number) List(MlirFunction)
	Counters.Called(Counters.Functions.First, 0).Length is 0
	let entry = function.method.instructions(position)
	if entry.kind is not InstructionType.Invoke
		return List(MlirFunction)
	let decoder = PayloadDecoder(entry)
	if MlirCalls(function, position).NativeHelper(entry, decoder) is not ""
		return List(MlirFunction)
	let type = MlirLayout(function).Owner(function.TypeOf(decoder.Text(1)), decoder.Text(2))
	let callee = decoder.Callee(type)
	let called = MlirFunction(types, type, callee, typeIndex = function.typeIndex)
	(callee.instructions.Length > 0) or MlirForeign(called).IsForeign then NoFunctions + called else NoFunctions