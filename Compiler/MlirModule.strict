has types List(TypeEntry)
has entryName Text
has countedFiles Texts = List(Text)
has entries = 1
has entrySymbol Text = "main"
has platform = -1
has Cached = ""
constant Counters = MlirModule(List(TypeEntry) + TypeEntry("Strict/Counter", List(MemberEntry), List(MethodEntry) + MethodEntry.CountingLoop), "Run")
constant Pair = MlirModule(Counters.types + TypeEntry("Strict/Other", List(MemberEntry), List(MethodEntry) + MethodEntry.CountingLoop), "Run", List(Text), 2)
constant NoFunctions = List(MlirFunction)
constant Scaled = MlirModule(List(TypeEntry) + WgslShader.Scaling, "Scaled")
constant Shaded = MlirModule(Scaled.types, "Scaled", platform = Platform.Web)
constant Started = MlirModule(List(TypeEntry) + TypeEntry(Counters.types.First, methods = (MethodEntry.CountingLoop, MlirEntry.Start)), "Run")
constant Floor = MethodEntry("Floor", List(MemberEntry), "Strict/Number", List(InstructionEntry) + InstructionEntry.Return(0))
constant FloorCall = InstructionEntry.Invoke(0, ("Strict/Degrees", "Floor", "Strict/Number"), List(Number), -1)
constant Caller = TypeEntry("Strict/Caller", List(MemberEntry), MethodEntry("Run", List(MemberEntry), "None", FloorCall))
constant Floored = MlirModule((Caller, MlirLayout.Degrees, TypeEntry("Strict/Number", List(MemberEntry), List(MethodEntry) + Floor)), "Run")
constant NoRun = MlirModule(List(TypeEntry) + TypeEntry("Strict/Empty", List(MemberEntry), List(MethodEntry)), "Tests")
Text Text
	Counters.Text.StartsWith("module {")
	NoRun.Text.StartsWith("unsupported:")
	started = Process.Elapsed
	reachable = Linked
	BuildProfile.Report("Emission / reachability (" + reachable.functions.Length + " functions)", started)
	edges = reachable.Edges
	functions = Safe(reachable.functions, edges)
	problem = Problem(functions)
	if problem is not ""
		return problem
	counted = countedFiles.Length is 0 then functions else MlirLines.Instrument(functions, Mains, countedFiles)
	Combine(Declare(counted, functions, edges), functions, counted)
Problem(functions List(MlirFunction)) Text
	Counters.Problem(Counters.Functions) is ""
	NoRun.Problem(NoRun.Functions).StartsWith("unsupported: no Tests method")
	if functions.First.method.instructions.Length is 0
		return "unsupported: no " + entryName + " method without parameters in " + types.First.Name
	MlirNarrowing.Problem(functions)
Safe(reachable List(MlirFunction), edges List(Numbers)) List(MlirFunction)
	Counters.Safe(Counters.Functions, List(Numbers) + List(Number)).Length is 1
	started = Process.Elapsed
	functions = MlirSafety(reachable, edges).Marked
	BuildProfile.Report("Emission / safety", started)
	functions
Declare(texts List(MlirFunction), functions List(MlirFunction), edges List(Numbers)) Texts
	Counters.Declare(Counters.Functions, Counters.Functions, List(Numbers) + List(Number)).First is "module {"
	MlirRecursion.Looped.Text.IndexOf("^stackChecked") > MlirRecursion.Looped.Text.IndexOf("@Looped_Again_0(")
	started = Process.Elapsed
	recursive = MlirRecursion(functions, entries + Starts(functions).Length).Recursive(edges)
	BuildProfile.Report("Emission / recursion", started)
	lines = ("module {", "  llvm.func @printf(!llvm.ptr, ...) -> i32") + MlirTexts.Declarations
	emitted = BuildProfile.Emit(value, texts, functions, recursive)
	before = Process.Elapsed
	result = lines + emitted + MlirEquality(functions.First, 0).Functions + MlirAutomatic(functions.First).Functions
	BuildProfile.Report("Emission / helpers", before)
	result
Emit(texts List(MlirFunction), functions List(MlirFunction), recursive Texts) Texts
	Counters.Emit(Counters.Functions, Counters.Functions, List(Text)).First.IndexOf("@Counter_Run_0(") > 0
	EmissionCache(value, functions, recursive).Emit(texts)
Emission(function MlirFunction, functions List(MlirFunction), recursive Texts) Text
	Counters.Emission(MlirWhole.Row.function, NoFunctions, List(Text)).IndexOf("alwaysinline") > 0
	text = MlirFunction(function, IsRecursive = function.Symbol is in recursive).Text
	emitted = MlirEntry.Optimize(function.method, text)
	whole = MlirWholeBody(function, functions).Lines
	whole.Length is 0 then emitted else emitted + "\n" + outer.Text.Combine(whole, "\n")
Combine(lines Texts, functions List(MlirFunction), counted List(MlirFunction)) Text
	Counters.Combine(List(Text), Counters.Functions, Counters.Functions).EndsWith("}")
	Scaled.Text.IndexOf(WgslShader.Marker) < Shaded.Text.IndexOf(WgslShader.Marker)
	table = countedFiles.Length is 0 then List(Text) else MlirLines.Table(functions, Mains, countedFiles)
	started = Process.Elapsed
	device = MlirGpu.Module(functions)
	BuildProfile.Report("Emission / GPU kernels", started)
	before = Process.Elapsed
	main = MlirEntry(counted.First, Others(counted), entrySymbol).Main
	host = outer.Text.Combine(lines + MlirGlobals(functions).Lines + table + main + "}", "\n")
	BuildProfile.Report("Emission / globals and assembly", before)
	outer.Text.Combine((host, device, platform is Platform.Web then WgslShader.Scripts(functions) else "") - "", "\n")
Functions List(MlirFunction)
	Counters.Functions.Length is 1
	Pair.Functions.Length is 2
	Pair.Text.IndexOf("@Other_Run_0(%self1)") > 0
	Floored.Functions.Last.Symbol is "Number_Floor_0"
	Started.Functions.Last.Symbol is "Counter_$Start_0"
	Linked.functions
Linked MlirRecursion
	Started.Linked.calls.Length is 2
	mains = Entries
	roots = mains + Starts(mains)
	Reachable(roots, roots, List(Numbers))
Starts(mains List(MlirFunction)) List(MlirFunction)
	Counters.Starts(Counters.Functions).Length is 0
	Started.Starts(Started.Functions).First.Symbol is "Counter_$Start_0"
	Started.Starts(Started.Functions).Length is 1
	for mains
		start = DefaultInstance.Start(value.type)
		if index < entries and start.instructions.Length > 0
			MlirFunction(value, method = start)
Entries List(MlirFunction)
	Pair.Entries.Last.Symbol is "Other_Run_0"
	typeIndex = TypeIndex
	for Range(0, entries)
		MlirFunction(types, types(value), RunMethod(types(value)), typeIndex = typeIndex)
TypeIndex Dictionary(Text, Number)
	Counters.TypeIndex("Counter") is 0
	Counters.TypeIndex("Strict/Counter") is 0
	mutable indexed = Dictionary(Text, Number)
	for types
		if value.Name is not in indexed
			indexed(value.Name) = index
	for types
		short = Path(value.Name).FileName.text
		if short is not in indexed
			indexed(short) = index
	indexed
Mains List(TypeEntry)
	Pair.Mains.Last.Name is "Strict/Other"
	for Range(0, entries)
		types(value)
Others(counted List(MlirFunction)) List(MlirFunction)
	Pair.Others(Pair.Functions).First.Symbol is "Other_Run_0"
	for Range(1, entries)
		counted(value)
RunMethod(main TypeEntry) MethodEntry
	Counters.RunMethod(TypeEntry("Strict/Empty", List(MemberEntry), List(MethodEntry))).instructions.Length is 0
	for main.methods
		if value.Name is entryName
			return value
	MethodEntry(entryName, List(MemberEntry), "None", List(InstructionEntry))
Reachable(known List(MlirFunction), fresh List(MlirFunction), prior List(Numbers)) MlirRecursion
	Counters.Reachable(Counters.Functions, Counters.Functions, List(Numbers)).functions.Length is 1
	mutable symbols = MlirRecursion.Symbols(known)
	mutable found = List(Mutable(MlirFunction))
	mutable calls = List(Mutable(Numbers))
	for fresh
		called = Callees(value)
		unseen = MlirUnseen(symbols).Of(called)
		found = found + unseen
		symbols = symbols + MlirRecursion.Symbols(unseen)
		calls.Add(MlirRecursion.Indexes(called, symbols))
	found.Length is 0 then MlirRecursion(known, entries, prior + calls) else Reachable(known + found, found, prior + calls)
Callees(function MlirFunction) List(MlirFunction)
	Counters.Callees(Counters.Functions.First).Length is 0
	mutable callees = List(Mutable(MlirFunction))
	for function.method.instructions
		callees = callees + Call(function, index)
	callees
Call(function MlirFunction, position Number) List(MlirFunction)
	Counters.Call(Counters.Functions.First, 0).Length is 0
	MlirModule(List(TypeEntry) + MlirTexts.Joined.type, "Run").Call(MlirTexts.Joined, 2).Length is 0
	entry = function.method.instructions(position)
	if entry.kind is not InstructionType.Invoke
		return MlirAutomatic(function).Conversions(position)
	decoder = PayloadDecoder(entry)
	if MlirCalls(function, position).NativeHelper(entry, decoder) is not ""
		return List(MlirFunction)
	type = MlirLayout(function).Owner(function.TypeOf(decoder.Text(1)), decoder.Text(2))
	callee = decoder.Callee(type)
	called = MlirFunction(types, type, callee, typeIndex = function.typeIndex)
	callee.instructions.Length > 0 or MlirForeign(called).IsForeign then NoFunctions + called else NoFunctions