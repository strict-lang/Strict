has types List(TypeEntry)
constant Counters = MlirModule(List(TypeEntry) + TypeEntry("Strict/Counter", List(MemberEntry), List(MethodEntry) + MethodEntry.CountingLoop))
constant NoRun = MlirModule(List(TypeEntry) + TypeEntry("Strict/Empty", List(MemberEntry), List(MethodEntry)))
Text Text
	Counters.Text.StartsWith("module {") is true
	NoRun.Text.StartsWith("unsupported:") is true
	constant functions = Functions
	if functions.First.method.instructions.Length is 0
		return "unsupported: no Run method without parameters in " + types.First.Name
	mutable lines = ("module {", "  llvm.func @printf(!llvm.ptr, ...) -> i32") + MlirTexts.Declarations
	for functions
		lines = lines + value.Text
	Text.Combine(lines + Globals(functions) + Main(functions.First) + "}", "\n")
Functions List(MlirFunction)
	Counters.Functions.Length is 1
	let main = types.First
	let first = List(MlirFunction) + MlirFunction(types, main, RunMethod(main))
	Reachable(first, first)
RunMethod(main TypeEntry) MethodEntry
	Counters.RunMethod(TypeEntry("Strict/Empty", List(MemberEntry), List(MethodEntry))).instructions.Length is 0
	for main.methods
		if value.Name is "Run"
			return value
	MethodEntry("Run", List(MemberEntry), "None", List(InstructionEntry))
Reachable(known List(MlirFunction), fresh List(MlirFunction)) List(MlirFunction)
	Counters.Reachable(Counters.Functions, Counters.Functions).Length is 1
	mutable found = List(Mutable(MlirFunction))
	for fresh
		found = found + Unknown(known + found, Callees(value))
	found.Length is 0 then known else Reachable(known + found, found)
Unknown(known List(MlirFunction), candidates List(MlirFunction)) List(MlirFunction)
	Counters.Unknown(Counters.Functions, Counters.Functions).Length is 0
	mutable result = List(Mutable(MlirFunction))
	for candidates
		result = Symbols(known + result).Index(value.Symbol) < 0 then result + value else result
	result
Symbols(functions List(MlirFunction)) Texts
	Counters.Symbols(Counters.Functions) is ("Counter_Run_0")
	for functions
		value.Symbol
Callees(function MlirFunction) List(MlirFunction)
	Counters.Callees(Counters.Functions.First).Length is 0
	mutable callees = List(Mutable(MlirFunction))
	for function.method.instructions
		callees = callees + Called(function, index)
	callees
Called(function MlirFunction, position Number) List(MlirFunction)
	Counters.Called(Counters.Functions.First, 0).Length is 0
	let entry = function.method.instructions(position)
	if entry.kind is not InstructionType.Invoke
		return List(MlirFunction)
	let decoder = PayloadDecoder(entry)
	if (decoder.Text(2) is "from") or MlirCalls(function, position).NativeHelper(entry, decoder) is not ""
		return List(MlirFunction)
	let type = Natives(types).TypeOf(decoder.Text(1))
	let returned = decoder.Text(4 + entry.payload(3))
	let callee = MlirCalls(function, position).Callee(type, decoder.Text(2), entry.payload(5 + entry.payload(3)), returned)
	constant none = List(MlirFunction)
	callee.instructions.Length is 0 then none else none + MlirFunction(types, type, callee)
Globals(functions List(MlirFunction)) Texts
	Counters.Globals(Counters.Functions).Length is 0
	mutable lines = List(Mutable(Text))
	for functions
		lines = lines + FunctionGlobals(value)
	lines
FunctionGlobals(function MlirFunction) Texts
	Counters.FunctionGlobals(MlirCalls.Shapes).Length is 1
	for function.method.instructions
		if (value.kind is InstructionType.Print) or MlirConstants(function, index).IsConstant
			Global(function, index)
Global(function MlirFunction, position Number) Text
	Counters.Global(MlirCalls.Shapes, 3).IndexOf("Hi %s\\0A\\00") > 0 is true
	let entry = function.method.instructions(position)
	let constants = MlirConstants(function, position)
	if entry.kind is not InstructionType.Print
		return constants.Global
	let hasValue = entry.payload(1) is 1
	let format = hasValue then "%s" else ""
	let content = constants.Escaped(entry.texts(0), true) + format + "\\0A\\00"
	let length = constants.EscapedLength(entry.texts(0), true) + (hasValue then 4 else 2)
	let name = "@s" + function.Symbol + "_" + position
	"  llvm.mlir.global internal constant " + name + "(\"" + content + "\") : !llvm.array<" + length + " x i8>"
Main(entry MlirFunction) Texts
	Counters.Main(Counters.Functions.First).Length is 14
	constant slot = "    %selfslot = llvm.alloca %one x f64 : (i64) -> !llvm.ptr"
	constant constants = ("    %one = arith.constant 1 : i64", "    %zero = arith.constant 0.0 : f64", slot)
	constant header = List(Text) + "  func.func @main(%argc: i32, %argv: !llvm.ptr) -> i32 {" + constants
	constant self = "    %self = llvm.load %selfslot : !llvm.ptr -> f64"
	let returned = MlirKinds(entry).Short(entry.method.returnType) is "Number"
	let code = returned then "    %code = arith.fptosi %result : f64 to i32" else "    %code = arith.constant 0 : i32"
	let prepared = header + MlirInstances(entry, 0).Fresh(entry.type, "%selfslot") + Arguments(entry)
	prepared + (self, EntryCall(entry), code) + ("    return %code : i32", "  }")
EntryCall(entry MlirFunction) Text
	Counters.EntryCall(Counters.Functions.First) is "    %result = func.call @Counter_Run_0(%self) : (f64) -> f64"
	let count = entry.method.parameters.Length
	let names = List(Text) + "%self" + MlirCalls(entry, 0).ArgumentNames(count)
	let operands = Text.Combine(names, ", ").Replace("%t0a", "%arg")
	let signature = Text.Combine(MlirCalls(entry, 0).ArgumentTypes(count + 1), ", ")
	"    %result = func.call @" + entry.Symbol + "(" + operands + ") : (" + signature + ") -> f64"
Arguments(entry MlirFunction) Texts
	Counters.Arguments(Counters.Functions.First).Length is 0
	mutable lines = List(Mutable(Text))
	for entry.method.parameters
		lines = lines + Argument(MlirKinds(entry).Short(value.typeName), index)
	lines
Argument(kind Text, index Number) Texts
	Counters.Argument("Text", 0).Last.StartsWith("    %arg0 = func.call @strict_argument(%argc, %argv") is true
	Counters.Argument("List(Number)", 1).Length is 1
	let name = "%arg" + index
	if kind.StartsWith("List(") or (kind is "Numbers")
		return List(Text) + ("    " + name + " = func.call @strict_argument_numbers(%argc, %argv) : (i32, !llvm.ptr) -> f64")
	let read = kind is "Number" then name + "text" else name
	let position = "    %argindex" + index + " = arith.constant " + (index + 1) + " : i32"
	constant signature = ") : (i32, !llvm.ptr, i32) -> f64"
	let argument = "    " + read + " = func.call @strict_argument(%argc, %argv, %argindex" + index + signature
	let parsed = "    " + name + " = func.call @strict_text_number(" + read + ") : (f64) -> f64"
	kind is "Number" then (position, argument, parsed) else (position, argument)