has function MlirFunction
has position Number
constant Length = InstructionEntry.Invoke(1, ("Strict/Text", "Length", "Strict/Number"), List(Number), 0)
constant Search = InstructionEntry.Invoke(2, ("Strict/Text", "IndexOf", "Strict/Number", "text"), 1, 0)
constant TextType = TypeEntry("Strict/Text", List(MemberEntry), List(MethodEntry))
constant TextNames = ("StartsWith", "IndexOf", "LastIndexOf", "Substring", "Upper", "Lower", "Capitalize", "Trim", "TrimStart", "TrimEnd", "Combine")
constant TextHelpers = ("strict_text_starts", "strict_text_index", "strict_text_last_index", "strict_text_substring", "strict_text_upper", "strict_text_lower", "strict_text_capitalize", "strict_text_trim", "strict_text_trim_start", "strict_text_trim_end", "strict_text_combine")
constant SystemNames = ("File.ReadLines", "File.Exists", "File.Write", "Directory.Files", "Directory.Exists", "Directory.Create", "Process.Find", "Process.RunTool", "Process.OperatingSystem")
constant DefaultedLast = ("strict_text_index", "strict_text_starts", "strict_directory_files", "strict_text_combine")
constant Texts = MlirFunction(List(TypeEntry), MlirFunction.Named, MethodEntry("Run", List(MemberEntry), "None", (InstructionEntry.LoadText(0, "ab"), Length, Search)))
Helper(typeName Text, name Text, count Number) Text
	MlirNatives(Texts, 1).Helper("Strict/Text", "Length", 0) is "strict_text_length"
	MlirNatives(Texts, 1).Helper("Strict/List(Number)", "Count", 0) is "strict_list_length"
	MlirNatives(Texts, 1).Helper("Strict/Number", "Floor", 0) is "strict_floor"
	MlirNatives(Texts, 1).Helper("Strict/Other", "Floor", 0) is ""
	let kind = MlirKinds(function).Short(typeName)
	if (name is in ("Length", "Count")) and (count is 0)
		return kind is "Text" then "strict_text_length" else kind.StartsWith("List(") then "strict_list_length" else ""
	if kind.StartsWith("List(")
		return CollectionHelper(kind, name, count)
	ValueHelper(kind, name)
ValueHelper(kind Text, name Text) Text
	MlirNatives(Texts, 1).ValueHelper("Boolean", "not") is "strict_not"
	if (kind is "Number") and (name is "Floor")
		return "strict_floor"
	if (kind is "Boolean") and (name is in ("not", "and", "or", "xor"))
		return "strict_" + name
	if kind is in ("File", "Directory", "Process")
		return SystemHelper(kind, name)
	kind is "Text" then TextHelper(name) else ""
CollectionHelper(kind Text, name Text, count Number) Text
	MlirNatives(Texts, 1).CollectionHelper("List(Text)", "in", 1) is "strict_list_has_text"
	MlirNatives(Texts, 1).CollectionHelper("List(Text)", "Remove", 1) is ""
	MlirNatives(Texts, 1).CollectionHelper("List(Number)", "Count", 1) is "strict_list_count_number"
	if name is not in ("in", "Index", "Count") or count is not 1
		return ""
	let operation = name is "in" then "has" else name.Lower
	Finder(MlirKinds(function).ElementKind(kind), operation)
Finder(element Text, operation Text) Text
	MlirNatives(Texts, 1).Finder("Text", "has") is "strict_list_has_text"
	MlirNatives(Texts, 1).Finder("Shape", "index") is ""
	if element is "Text"
		return "strict_list_" + operation + "_text"
	element is in ("Number", "Boolean", "Character") then "strict_list_" + operation + "_number" else ""
SystemHelper(kind Text, name Text) Text
	MlirNatives(Texts, 1).SystemHelper("File", "ReadLines") is "strict_file_read_lines"
	MlirNatives(Texts, 1).SystemHelper("Directory", "Files") is "strict_directory_files"
	MlirNatives(Texts, 1).SystemHelper("File", "Delete") is ""
	MlirNatives(Texts, 1).SystemHelper("Process", "RunTool") is "strict_process_runtool"
	if kind + "." + name is not in SystemNames
		return ""
	let suffix = name is "ReadLines" then "read_lines" else name.Lower
	"strict_" + kind.Lower + "_" + suffix
TextHelper(name Text) Text
	MlirNatives(Texts, 1).TextHelper("Upper") is "strict_text_upper"
	MlirNatives(Texts, 1).TextHelper("Split") is ""
	MlirNatives(Texts, 1).TextHelper("Combine") is "strict_text_combine"
	let found = TextNames.Index(name)
	found < 0 then "" else TextHelpers(found)
Emitted(entry InstructionEntry, type TypeEntry, helper Text) Texts
	MlirNatives(Texts, 2).Emitted(Search, TextType, "strict_text_index").Length is 4
	let calls = MlirCalls(function, position)
	let count = entry.payload(5 + entry.payload(3))
	let operands = List(Text) + calls.Temp("m") + calls.ArgumentNames(count)
	let hasStart = helper is in DefaultedLast
	let completed = hasStart and (count is 1) then operands + "%zero" else operands
	let call = MlirMemory(function, position).Called(calls.Temp("r"), helper, completed)
	calls.Loads(entry, type) + call + function.Store(calls.Temp("r"), "%r" + entry.payload(0))