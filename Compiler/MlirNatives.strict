has function MlirFunction
has position Number
constant LengthCall = InstructionEntry.Invoke(1, ("Strict/Text", "Length", "Strict/Number"), List(Number), 0)
constant Search = InstructionEntry.Invoke(2, ("Strict/Text", "IndexOf", "Strict/Number", "text"), 1, 0)
constant TextType = TypeEntry("Strict/Text", List(MemberEntry), List(MethodEntry))
constant TextNames = ("StartsWith", "IndexOf", "LastIndexOf", "Substring", "Upper", "Lower", "Capitalize", "Trim", "TrimStart", "TrimEnd", "Combine")
constant TextSearchHelpers = ("strict_text_starts", "strict_text_index", "strict_text_last_index", "strict_text_substring")
constant TextChangeHelpers = ("strict_text_upper", "strict_text_lower", "strict_text_capitalize", "strict_text_trim", "strict_text_trim_start", "strict_text_trim_end", "strict_text_combine")
constant TextHelpers = TextSearchHelpers + TextChangeHelpers
constant Destining = List(Text) + "strict_list_swap_removed"
constant DefaultedLast = ("strict_text_index", "strict_text_starts", "strict_directory_files", "strict_text_combine")
constant Named = TypeEntry("Strict/Named", (MemberEntry("name", "Strict/Text", List(InstructionEntry), false), MemberEntry.LoggerMember), List(MethodEntry))
constant Texts = MlirFunction(List(TypeEntry), Named, MethodEntry("Run", List(MemberEntry), "None", (InstructionEntry.LoadText(0, "ab"), LengthCall, Search)))
constant Getting = InstructionEntry.Invoke(2, ("Strict/Dictionary(Text, Number)", "get", "Strict/Number", "key"), 1, -1)
constant Counted = TypeEntry("Strict/Dictionary(Text, Number)", List(MemberEntry), List(MethodEntry))
constant ArgumentLoad = "    %t2a0 = llvm.load %r1 : !llvm.ptr -> f64"
constant ResultStore = "    llvm.store %t2r, %r2 : f64, !llvm.ptr"
constant SearchLines = ("    %t2m = llvm.load %r0 : !llvm.ptr -> f64", ArgumentLoad, "    %t2r = func.call @strict_text_index(%t2m, %t2a0, %zero) : (f64, f64, f64) -> f64", ResultStore)
constant KeyFunctions = ("    %t2m = arith.constant 0.0 : f64", ArgumentLoad, "    %t2h = func.constant @strict_hash_text : (f64) -> i64", "    %t2e = func.constant @strict_text_equal : (f64, f64) -> f64")
constant DictionaryGet = "    %t2k = func.call @strict_dictionary_get(%t2m, %t2a0, %t2h, %t2e) : (f64, f64, (f64) -> i64, (f64, f64) -> f64) -> f64"
constant ValueTraced = ("    %t2tw = llvm.mlir.addressof @wNamed_Run_0 : !llvm.ptr", "    %t2twl = arith.constant 0 : i64", "    %t2r = func.call @strict_trace(%t2k, %t2tw, %t2twl) : (f64, !llvm.ptr, i64) -> f64", ResultStore)
constant GettingLines = KeyFunctions + DictionaryGet + ValueTraced
Helper(typeName Text, name Text, count Number) Text
	MlirNatives(Texts, 1).Helper("Strict/Text", "Length", 0) is "strict_text_length"
	MlirNatives(Texts, 1).Helper("Strict/List(Number)", "Count", 0) is "strict_list_length"
	MlirNatives(Texts, 1).Helper("Strict/Dictionary(Text, Number)", "Length", 0) is "strict_list_length"
	MlirNatives(Texts, 1).Helper("Strict/Number", "Floor", 0) is "strict_floor"
	MlirNatives(Texts, 1).Helper("Strict/Other", "Floor", 0) is ""
	MlirNatives(Texts, 1).Helper("Strict/Directory", "Directories", 1) is "strict_directory_directories"
	MlirNatives(Texts, 1).Helper("Strict/Compiler/BuildProfile", "Detailed", 0) is "strict_buildprofile_detailed"
	let kind = TypeEntry.ShortName(typeName)
	let isList = kind.StartsWith("List(") or kind.StartsWith("Dictionary(")
	if (name is in ("Length", "Count")) and (count is 0) and ((kind is "Text") or isList)
		return kind is "Text" then "strict_text_length" else "strict_list_length"
	isList then CollectionHelper(kind, name, count) else ValueHelper(kind, name, count)
ValueHelper(kind Text, name Text, count Number) Text
	MlirNatives(Texts, 1).ValueHelper("Boolean", "not", 0) is "strict_not"
	MlirNatives(Texts, 1).ValueHelper("Number", "Increment", 0) is "strict_increment_one"
	MlirNatives(Texts, 1).ValueHelper("Number", "Decrement", 1) is "strict_decrement"
	MlirNatives(Texts, 1).ValueHelper("Number", "xor", 1) is "strict_number_xor"
	MlirNatives(Texts, 1).ValueHelper("Number", "Logarithm", 0) is "strict_number_logarithm"
	if (kind is "Number") and (name is "Floor")
		return "strict_floor"
	if (kind is "Number") and (name is in ("Increment", "Decrement"))
		return "strict_" + name.Lower + (count is 0 then "_one" else "")
	if (kind is in ("Boolean", "Number")) and (name is in ("not", "and", "or", "xor"))
		return "strict_" + (kind is "Number" then "number_" else "") + name
	kind is "Text" then TextHelper(name) else TypeHelper(kind, name)
CollectionHelper(kind Text, name Text, count Number) Text
	MlirNatives(Texts, 1).CollectionHelper("List(Text)", "in", 1) is "strict_list_has"
	MlirNatives(Texts, 1).CollectionHelper("List(Text)", "Remove", 1) is ""
	MlirNatives(Texts, 1).CollectionHelper("List(Number)", "Count", 1) is "strict_list_count"
	MlirNatives(Texts, 1).CollectionHelper("List(Range)", "Index", 1) is "strict_list_find"
	MlirNatives(Texts, 1).CollectionHelper("Dictionary(Text, Number)", "Add", 2) is "strict_dictionary_add"
	MlirNatives(Texts, 1).CollectionHelper("List(Number)", "SwapRemoved", 1) is "strict_list_swap_removed"
	if kind.StartsWith("Dictionary(")
		return DictionaryHelper(name)
	if name is not in ("in", "Index", "Count", "SwapRemoved") or count is not 1
		return ""
	let operation = name is "in" then "has" else (name is "SwapRemoved" then "swap_removed" else name.Lower)
	"strict_list_" + (operation is "index" then "find" else operation)
DictionaryHelper(name Text) Text
	MlirNatives(Texts, 1).Helper("Strict/Text", "Upper", 0) is "strict_text_upper"
	MlirNatives(Texts, 1).Helper("Strict/List(Text)", "in", 1) is "strict_list_has"
	MlirNatives(Texts, 1).Helper("Strict/Text", "Count", 0) is "strict_text_length"
	MlirNatives(Texts, 1).Helper("Strict/Text", "Length", 1) is ""
	MlirNatives(Texts, 1).DictionaryHelper("in") is "strict_dictionary_has"
	MlirNatives(Texts, 1).DictionaryHelper("to") is ""
	MlirNatives(Texts, 1).DictionaryHelper("set") is "strict_dictionary_set"
	let isKeyed = name is in ("in", "get", "set", "Add", "Remove")
	isKeyed then "strict_dictionary_" + (name is "in" then "has" else name.Lower) else ""
Keyed(kind Text) Texts
	MlirNatives(Texts, 1).Keyed("Strict/Dictionary(Text, Number)") is ("strict_hash_text", "strict_text_equal")
	MlirNatives(Texts, 1).Keyed("Dictionary(Text, Text)") is ("strict_hash_text", "strict_text_equal")
	MlirNatives(MlirEquality.Same, 0).Keyed("Dictionary(Shape, Text)") is ("strict_hash_Shape", "strict_equal_Shape")
	let key = Key(kind)
	if key is "Text"
		return ("strict_hash_text", "strict_text_equal")
	let equality = MlirEquality(function, position)
	if equality.IsKnown(key) is false
		return ("strict_hash_number", "strict_equal_number")
	("strict_hash_" + equality.Symbol(key), equality.Helper(key))
Key(kind Text) Text
	MlirNatives(Texts, 1).Key("List(List(Number))") is "Number"
	MlirNatives(Texts, 1).CollectionHelper("List(Number)", "Count", 2) is ""
	MlirNatives(Texts, 1).CollectionHelper("List(Text)", "Upper", 1) is ""
	MlirNatives(Texts, 1).Key("List(List(Text, Number))") is "Text"
	MlirNatives(Texts, 1).Key("Dictionary(Number, Number)") is "Number"
	let short = TypeEntry.ShortName(kind)
	let pair = MlirLayout(function).Paired(short)
	let kinds = MlirKinds(function)
	MlirLayout(function).Represented(pair.Length > 0 then pair(0) else kinds.ElementKind(kinds.ElementKind(short)))
Keying(helper Text, operands Texts, kind Text) Texts
	MlirNatives(Texts, 2).Keying("f", ("%m", "%k"), "Dictionary(Text, Text)").Last.IndexOf("trace(%t2k") > 0
	let memory = MlirMemory(function, position)
	let functions = Keyed(kind)
	let hash = memory.Constant(memory.Temp("h"), functions(0), "(f64) -> i64")
	let equal = memory.Constant(memory.Temp("e"), functions(1), "(f64, f64) -> f64")
	let arguments = Text.Combine(operands + memory.Temp("h") + memory.Temp("e"), ", ")
	let types = Text.Combine(MlirCalls(function, position).ArgumentTypes(operands.Length), ", ")
	let call = "    " + memory.Temp("k") + " = func.call @" + helper + "(" + arguments + ") : (" + types
	let traced = memory.Traced(memory.Temp("k"), memory.Temp("r"), "strict_trace")
	(hash, equal, call + ", (f64) -> i64, (f64, f64) -> f64) -> f64") + traced
Element(kind Text) Text
	MlirNatives(Texts, 2).Emitted(Search, TextType, "strict_text_index") is SearchLines
	MlirNatives(Texts, 2).Emitted(Getting, Counted, "strict_dictionary_get") is GettingLines
	MlirNatives(Texts, 2).Emitted(Search, TextType, "strict_text_last_index")(2).EndsWith("%t2a0) : (f64, f64) -> f64")
	MlirNatives(Texts, 1).Emitted(LengthCall, TextType, "strict_text_index")(1).EndsWith("(%t1m) : (f64) -> f64")
	MlirNatives(Texts, 1).ValueHelper("Boolean", "Floor", 0) is ""
	MlirNatives(Texts, 1).ValueHelper("Boolean", "Increment", 0) is ""
	MlirNatives(Texts, 1).ValueHelper("Text", "Upper", 0) is "strict_text_upper"
	MlirNatives(Texts, 1).Element("List(Text)") is "Text"
	MlirNatives(Texts, 1).Element("Strict/List(Text)") is "Text"
	MlirLayout(function).Represented(MlirKinds(function).ElementKind(TypeEntry.ShortName(kind)))
TypeHelper(kind Text, name Text) Text
	MlirNatives(Texts, 1).TypeHelper("File", "ReadLines") is "strict_file_read_lines"
	MlirNatives(Texts, 1).TypeHelper("Directory", "Files") is "strict_directory_files"
	MlirNatives(Texts, 1).TypeHelper("File", "Rename") is "strict_file_rename"
	MlirNatives(Texts, 1).TypeHelper("Process", "RunTool") is "strict_process_runtool"
	MlirNatives(Texts, 1).TypeHelper("Degrees", "Sin") is "strict_degrees_sin"
	MlirNatives(Texts, 1).TypeHelper("Memo", "Kept") is "strict_memo_kept"
	if (kind is "ConstantCache") and (name is in ("At", "Stored"))
		return name is "At" then "strict_list_get" else "strict_list_set"
	let isHosted = kind is in Hosted.Kinds then kind + "." + name is in Hosted.Methods else false
	if (isHosted is false) and ((kind is not "Memo") or name.StartsWith(TestCodegen.Runner))
		return kind is "GpuMemory" then GpuHelper(name) else Validated(name)
	"strict_" + kind.Lower + "_" + (name is "ReadLines" then "read_lines" else name.Lower)
GpuHelper(name Text) Text
	MlirNatives(Texts, 1).TypeHelper("File", "ReadBytes") is "strict_file_readbytes"
	MlirNatives(Texts, 1).TypeHelper("ConstantCache", "At") is "strict_list_get"
	MlirNatives(Texts, 1).TypeHelper("ConstantCache", "Stored") is "strict_list_set"
	MlirNatives(Texts, 1).TypeHelper("Degrees", "At") is ""
	MlirNatives(Texts, 1).TypeHelper("ConstantCache", "Other") is ""
	MlirNatives(Texts, 1).TypeHelper("Memo", "$TestsTook") is ""
	MlirNatives(Texts, 1).TypeHelper("GpuMemory", "$TestsGot0") is ""
	MlirNatives(Texts, 1).GpuHelper("Tuned") is "strict_gpu_tuned"
	if name.StartsWith(TestCodegen.Runner)
		return ""
	"strict_gpu_" + (name is "Released" then "trim_unused" else (name is "Evicted" then "evict_all" else name.Lower))
Validated(name Text) Text
	MlirNatives(MlirValidated.Kept.function, 2).Validated("Validated") is "strict_validated"
	MlirNatives(MlirValidated.Changed.function, 2).Validated("Validated") is ""
	MlirNatives(Texts, 1).Validated("Floor") is ""
	name is not "Validated" then "" else MlirValidated(function, position).IsKnown then "strict_validated" else ""
TextHelper(name Text) Text
	MlirNatives(Texts, 1).TypeHelper("File", "WriteLines") is "strict_file_writelines"
	MlirNatives(Texts, 1).TypeHelper("File", "Modified") is "strict_file_modified"
	MlirNatives(Texts, 1).TypeHelper("GpuMemory", "Released") is "strict_gpu_trim_unused"
	MlirNatives(Texts, 1).TypeHelper("GpuMemory", "Evicted") is "strict_gpu_evict_all"
	MlirNatives(Texts, 1).TypeHelper("Process", "Collected") is "strict_process_collected"
	MlirNatives(Texts, 1).Helper("Strict/File", "Length", 0) is "strict_file_length"
	MlirNatives(Texts, 1).TextHelper("Upper") is "strict_text_upper"
	MlirNatives(Texts, 1).TextHelper("Split") is ""
	MlirNatives(Texts, 1).TextHelper("Combine") is "strict_text_combine"
	let found = TextNames.Index(name)
	found < 0 then "" else TextHelpers(found)
Emitted(entry InstructionEntry, type TypeEntry, helper Text) Texts
	MlirNatives(Texts, 2).Emitted(Search, TextType, "strict_text_index").Length is 4
	let calls = MlirCalls(function, position)
	let count = entry.payload(5 + entry.payload(3))
	let owner = calls.Owner(entry, type)
	let textual = Textual(entry, Element(owner), count)
	let arguments = textual.Length > 0 then List(Text) + calls.Temp("ct") else calls.ArgumentNames(count)
	let operands = List(Text) + calls.Temp("m") + arguments
	let completed = (helper is in DefaultedLast) and (count is 1) then operands + "%zero" else operands
	let plain = MlirMemory(function, position).Passed(calls.Temp("r"), helper, completed, Element(owner))
	let call = helper.StartsWith("strict_dictionary_") then Keying(helper, completed, owner) else plain
	calls.Loads(entry, type) + textual + call + function.Store(calls.Temp("r"), "%r" + entry.payload(0))
Textual(entry InstructionEntry, element Text, count Number) Texts
	MlirNatives(MlirKinds.Lettered.function, 2).Textual(Search, "Text", 1)(0).IndexOf("ct = func.call @strict_char") > 0
	MlirNatives(MlirKinds.Lettered.function, 2).Textual(Search, "Number", 1).Length is 0
	MlirNatives(MlirKinds.Lettered.function, 2).Textual(Search, "Text", 2).Length is 0
	MlirNatives(Texts, 2).Textual(Search, "Text", 1).Length is 0
	let register = entry.payload(6 + entry.payload(3))
	let isCharacter = MlirLayout(function).Represented(MlirKinds(function).KindOf(position, register)) is "Character"
	if (element is not "Text") or (count is not 1) or (isCharacter is false)
		return List(Text)
	let calls = MlirCalls(function, position)
	List(Text) + MlirMemory(function, position).Called(calls.Temp("ct"), "strict_character_text", calls.ArgumentNames(1))