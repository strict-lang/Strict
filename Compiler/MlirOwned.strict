has function MlirFunction
has position Number
constant Empty = MethodCodegen.StoreConstant(InstructionEntry(InstructionType.LoadConstantToRegister, "Strict/List(Number)", (0, 6, -1, 0)), "listResult0")
constant Built = (Empty, InstructionEntry.Named(InstructionType.LoadVariableToRegister, 0, "listResult0"), InstructionEntry.Named(InstructionType.StoreRegisterToVariable, 0, "moved"))
constant Reloaded = Built + InstructionEntry.Named(InstructionType.LoadVariableToRegister, 1, "moved")
constant LoadList = InstructionEntry.Named(InstructionType.LoadVariableToRegister, 0, "listResult0")
constant StoreHeld = InstructionEntry.Named(InstructionType.StoreRegisterToVariable, 0, "held")
constant LoadHeld = InstructionEntry.Named(InstructionType.LoadVariableToRegister, 1, "held")
constant HeldAgain = InstructionEntry.Named(InstructionType.LoadVariableToRegister, 3, "held")
constant HeldCall = InstructionEntry.Invoke(2, ("Strict/MutationCache", "Released", "Strict/Boolean", "locks"), 1, -1)
constant HeldLoads = (Empty, LoadList, StoreHeld, LoadHeld, HeldCall, HeldAgain)
constant HeldRun = MethodEntry("Run", List(MemberEntry), "None", HeldLoads)
constant Holding = MlirOwned(MlirFunction(List(TypeEntry), MlirFunction.Shape, HeldRun), 3)
constant HeldBetween = (InstructionEntry.LoadNumber(5, 1), InstructionEntry.Named(InstructionType.StoreRegisterToVariable, 5, "other"))
constant HeldLater = MethodEntry("Run", List(MemberEntry), "None", (Empty, LoadList, StoreHeld, LoadHeld, HeldCall) + HeldBetween + HeldAgain)
constant Delaying = MlirOwned(MlirFunction(List(TypeEntry), MlirFunction.Shape, HeldLater), 3)
constant StoreMoved = InstructionEntry.Named(InstructionType.StoreRegisterToVariable, 1, "moved")
constant LoadMoved = InstructionEntry.Named(InstructionType.LoadVariableToRegister, 2, "moved")
constant RewrittenLoads = Reloaded + (StoreMoved, LoadMoved)
constant RewrittenRun = MethodEntry("Run", List(MemberEntry), "None", RewrittenLoads)
constant Rewriting = MlirOwned(MlirFunction(List(TypeEntry), MlirFunction.Shape, RewrittenRun), 3)
constant MovedInstructions = Reloaded + InstructionEntry.Named(InstructionType.StoreRegisterToVariable, 1, "inline3_elements") + InstructionEntry.Return(1)
constant Moving = MlirFunction(List(TypeEntry), MlirFunction.Shape, MethodEntry("Run", List(MemberEntry), "None", MovedInstructions))
constant Copying = MlirFunction(List(TypeEntry), MlirFunction.Shape, MethodEntry("Run", List(MemberEntry), "None", Reloaded + InstructionEntry.Named(InstructionType.StoreRegisterToVariable, 1, "kept")))
constant ReturnedInstructions = Reloaded + InstructionEntry(InstructionType.CheckError, List(Text), List(Number) + 1) + InstructionEntry.Return(1)
constant Returning = MlirFunction(List(TypeEntry), MlirFunction.Shape, MethodEntry("Run", List(MemberEntry), "None", ReturnedInstructions))
constant Owner = MlirOwned(Moving, 2)
constant Temporaries = ("index", "value", "outer", "forResult", "changed_instance", "#this")
constant OuterFrom = ("Strict/Outer", "from", "Strict/Outer", "shape", "size")
constant Making = InstructionEntry.Invoke(2, OuterFrom, (0, 1), -1)
constant Remaking = InstructionEntry.Invoke(6, OuterFrom, (4, 5), -1)
constant OuterMade = (InstructionEntry.LoadNumber(0, 1), InstructionEntry.LoadNumber(1, 2), Making, InstructionEntry.Named(InstructionType.StoreRegisterToVariable, 2, "moved"))
constant OuterRemade = (InstructionEntry.Named(InstructionType.LoadVariableToRegister, 3, "moved"), InstructionEntry(InstructionType.FieldLoad, "shape", (4, 3, -1)), InstructionEntry.LoadNumber(5, 7), Remaking)
constant RemadeReturned = (InstructionEntry.Named(InstructionType.StoreRegisterToVariable, 6, "moved"), InstructionEntry.Named(InstructionType.LoadVariableToRegister, 7, "moved"), InstructionEntry.Return(7))
constant Rebuilding = OuterMade + OuterRemade + RemadeReturned
constant Fresh = List(Text) + "fresh"
constant UnsharedReuse = ("    %t#re = func.call @strict_rc_unshared(%t#old) : (f64) -> i1", "    cf.cond_br %t#re, ^t#reuse, ^t#fresh", "  ^t#reuse:", "    %t#rp = func.call @strict_ptr(%t#old) : (f64) -> !llvm.ptr", "    cf.br ^t#join")
constant FreshJoined = ("  ^t#fresh:", "    cf.br ^t#join", "  ^t#join:", "    %t#same = arith.cmpf oeq, %t#o, %t# : f64", "    cf.cond_br %t#same, ^t#kept, ^t#dead")
constant DeadReleased = ("  ^t#dead:", "    func.call @strict_rc_dead(%t#o, %t#) : (f64, f64) -> ()", "    cf.br ^t#kept", "  ^t#kept:")
constant Reusing = UnsharedReuse + FreshJoined + DeadReleased
constant Putting = ("    %t#r$ = llvm.getelementptr %t#rp[$] : (!llvm.ptr) -> !llvm.ptr, f64", "    %t#ra$ = llvm.load %r& : !llvm.ptr -> f64", "    func.call @strict_rc_put(%t#r$, %t#ra$) : (!llvm.ptr, f64) -> ()")
constant Rebuilt = MlirOwned(MlirFunction((MlirFunction.Shape, MlirInstances.Outer), MlirInstances.Outer, MethodEntry("Run", List(MemberEntry), "None", Rebuilding)), 7)
IsOwned(name Text, depth = 0, seed = "") Boolean
	Owner.IsOwned("moved")
	MlirOwned(Copying, 2).IsOwned("moved") is false
	Holding.IsOwned("held") is false
	Delaying.IsReread(3, "held")
	Rewriting.IsSafeRead(3, "moved")
	MlirOwned(MlirMembered.Moved.function, 0).IsSafeRead(2, "entity")
	Owner.IsOwned("listResult0") is false
	(Rebuilt.IsKept(4, "size", "moved") is false) and (Rebuilt.IsKept(4, "shape", "kept") is false)
	Rebuilt.IsKept(9, "shape", "moved") is false
	let isTemporary = (name is in Temporaries) or name.StartsWith("listResult") or name.StartsWith("conditional")
	let isOuter = (name is in function.Parameters) or (name is in MlirInstances(function, 0).StoredNames(function.type))
	(isTemporary is false) and (isOuter is false) and IsReference(name) and IsContained(name, depth, seed)
IsReference(name Text) Boolean
	Owner.IsReference("moved")
	Text.Combine(Rebuilt.Reconstructed(Rebuilding(7), MlirInstances.Outer, Fresh)).Length is 516
	Rebuilt.Rewritten(Rebuilding(7), MlirInstances.Outer, "moved")(1) is "    %t7ra1 = llvm.load %r5 : !llvm.ptr -> f64"
	Rebuilt.Reconstructed(Rebuilding(7), MlirInstances.Outer, Fresh)(0).StartsWith("    %t7old = llvm.load %v_moved")
	IsHeap(MlirKinds(function).VariableKind(function.method.instructions.Length, name))
IsHeap(kind Text) Boolean
	Owner.IsHeap("List(Number)")
	Owner.IsHeap("Number") is false
	let represented = MlirLayout(function).Represented(kind)
	let isHeap = represented.StartsWith("List(") or (represented is "Flat") or MlirLayout(function).IsStruct(kind)
	isHeap and (MlirPairs(function, 0).IsPaired(kind) is false)
IsContained(name Text, depth = 0, seed = "") Boolean
	Owner.IsContained("moved")
	Rebuilt.IsFresh(Rebuilt.function, 3, 2, 0)
	for function.method.instructions
		if (value.kind is in MlirAlone.Named) and (value.texts(0) is name)
			let isLoad = value.kind is InstructionType.LoadVariableToRegister
			let isSeed = (seed is not "") and (MlirDying(function, index).Loaded(value.payload(0)) is seed)
			if (isLoad then IsSafeRead(index, name) else isSeed or IsFresh(function, index, value.payload(0), depth)) is false
				return false
	true
IsFresh(inspected MlirFunction, at Number, register Number, depth Number) Boolean
	Owner.IsFresh(MlirInstances.Shapes, 2, 0, 0)
	Owner.IsFresh(Moving, 2, 0, 0)
	Owner.IsFresh(Moving, 4, 1, 0) is false
	let writer = MlirKinds(inspected).Writer(at, register)
	if writer < 0
		return false
	let entry = inspected.method.instructions(writer)
	if entry.kind is InstructionType.LoadVariableToRegister
		return (entry.texts(0) is "forResult") or entry.texts(0).StartsWith("listResult")
	if entry.kind is InstructionType.LoadConstantToRegister
		return true
	(entry.kind is InstructionType.Invoke) and MlirFresh(inspected).IsCall(writer, depth)
IsReread(at Number, name Text) Boolean
	Holding.IsReread(3, "held")
	Owner.IsReread(3, "moved") is false
	Rewriting.IsReread(3, "moved") is false
	let register = function.method.instructions(at).payload(0)
	let reuse = LoadReuse(function.method.instructions)
	mutable isPassed = false
	for Range(at + 1, function.method.instructions.Length)
		let entry = function.method.instructions(value)
		if (entry.kind is in MlirAlone.Named) and (entry.texts(0) is name)
			return isPassed and (entry.kind is InstructionType.LoadVariableToRegister)
		isPassed = isPassed or (entry.kind is not InstructionType.FieldLoad) and (register is in reuse.Reads(entry))
	false
IsSafeRead(at Number, name Text) Boolean
	Owner.IsSafeRead(3, "moved")
	MlirOwned(Copying, 2).IsSafeRead(3, "moved") is false
	if IsReread(at, name)
		return false
	let register = function.method.instructions(at).payload(0)
	let reuse = LoadReuse(function.method.instructions)
	for Range(at + 1, function.method.instructions.Length)
		if IsEscaped(value, register, name)
			return false
		if reuse.Written(function.method.instructions(value)) is register
			return true
	true
IsEscaped(at Number, register Number, name Text) Boolean
	MlirOwned(Copying, 2).IsEscaped(4, 1, "moved")
	Owner.IsEscaped(4, 1, "moved") is false
	MlirOwned(Copying, 2).IsEscaped(4, 0, "moved") is false
	Owner.IsEscaped(2, 0, "moved") is false
	Rebuilt.IsLeaked(2, 0) is false
	let entry = function.method.instructions(at)
	let isStored = (entry.kind is InstructionType.StoreRegisterToVariable) and (entry.payload(0) is register)
	let isLooped = (entry.kind is InstructionType.LoopBegin) and (entry.payload(0) is register)
	let isAlias = isStored then (entry.texts(0) is name) or entry.texts(0).StartsWith("inline") else false
	(isStored and (isAlias is false)) or isLooped or IsLeaked(at, register)
IsLeaked(at Number, register Number) Boolean
	Owner.IsLeaked(4, 1) is false
	let entry = function.method.instructions(at)
	if entry.kind is not InstructionType.Invoke
		return false
	mutable isTaken = false
	for LoadReuse(function.method.instructions).InvokeReads(entry)
		if entry.payload(value) is register
			isTaken = true
	let returned = MlirLayout(function).Represented(TypeEntry.ShortName(entry.texts(2)))
	isTaken and (returned is not in MlirFresh.Scalars) and (MlirFresh(function).IsCall(at, 0) is false)
Stored(entry InstructionEntry) Texts
	Owner.Stored(Built(2)).Index("    func.call @strict_rc_dead(%t2o, %t2) : (f64, f64) -> ()") is 6
	MlirOwned(Copying, 4).Stored(Copying.method.instructions(4)).Length is 2
	MlirOwned(MlirCarried.Carrying.function, 6).Stored(MlirCarried.Stored).Length > 2
	Text.Combine(Owner.Stored(Built(2))).Length is 332
	Text.Combine(Owner.Stored(InstructionEntry.Named(InstructionType.StoreRegisterToVariable, 0, "#this"))).Length is 90
	let slot = entry.texts(0) is "#this" then "%instance" else "%v_" + entry.texts(0)
	let copied = function.Copied("%r" + entry.payload(0), slot, "%t" + position)
	let seed = MlirDying(function, position).Seed(entry.texts(0))
	if (IsOwned(entry.texts(0), 0, seed) or MlirCarried(function).IsCarried(entry.texts(0))) is false
		return copied
	let dying = Placed(MlirDying(function, position).Guarded(Reusing.Slice(8, 6), seed), 0, 0)
	(List(Text) + function.Load("%t" + position + "o", slot)) + copied + dying
Reconstructed(entry InstructionEntry, owner TypeEntry, fresh Texts) Texts
	Text.Combine(Rebuilt.Reconstructed(Rebuilding(7), MlirInstances.Outer, Fresh)).IndexOf("@strict_rc_unshared(") > 0
	Text.Combine(Rebuilt.Reconstructed(Rebuilding(7), MlirInstances.Outer, Fresh)).IndexOf("%t7rp[1]") > 0
	Text.Combine(Rebuilt.Reconstructed(Rebuilding(7), MlirInstances.Outer, Fresh)).IndexOf("%t7rp[0]") is -1
	MlirOwned(Rebuilt.function, 4).Reconstructed(Making, MlirInstances.Outer, Fresh) is Fresh
	let name = Target(entry, owner)
	if name is ""
		return fresh
	let old = "%t" + position + "old"
	let checked = (function.Load(old, "%v_" + name), MlirAlone(function).Check(name, position))
	let opened = checked + Placed(Reusing.Slice(1, 3), 0, 0)
	let reused = Rewritten(entry, owner, name) + function.Store(old, "%r" + entry.payload(0))
	opened + reused + Placed(Reusing.Slice(4, 2), 0, 0) + fresh + Placed(Reusing.Slice(6, 2), 0, 0)
Target(entry InstructionEntry, owner TypeEntry) Text
	Rebuilt.Target(Rebuilding(7), MlirInstances.Outer) is "moved"
	MlirOwned(Rebuilt.function, 4).Target(Making, MlirInstances.Outer) is ""
	MlirOwned(Rebuilt.function, 2).Target(Making, MlirInstances.Outer) is ""
	let steps = function.method.instructions
	let next = position + 1 < steps.Length then steps(position + 1) else entry
	let isStored = (next.kind is Inliner.Store) and (next.payload(0) is entry.payload(0))
	let isFull = PayloadDecoder(entry).ArgumentCount >= MlirInstances(function, 0).Stored(owner).Length
	let isBuilt = isFull and (MlirConstants(function, position).IsConstant is false)
	(isStored and isBuilt then IsOwned(next.texts(0)) else false) then next.texts(0) else ""
Rewritten(entry InstructionEntry, owner TypeEntry, name Text) Texts
	Rebuilt.Rewritten(Rebuilding(7), MlirInstances.Outer, "moved").Last is "    llvm.store %t7ra1, %t7r1 : f64, !llvm.ptr"
	let arguments = PayloadDecoder(entry).Arguments
	let names = Invocation(entry, List(VmValue), VmValue.None).ParameterNames
	mutable lines = List(Text)
	for MlirInstances(function, 0).Stored(owner)
		let chosen = names.Index(value.Name) < 0 then index else names.Index(value.Name)
		let register = arguments(chosen)
		if IsKept(register, value.Name, name) is false
			lines = lines + Put(owner, value, register)
	lines
Put(owner TypeEntry, member MemberEntry, register Number) Texts
	Rebuilt.Put(MlirInstances.Outer, MlirInstances.Outer.members.Last, 5).Last.StartsWith("    llvm.store %t7ra1, %t7r1")
	Rebuilt.Put(MlirFunction.Shape, MlirFunction.Shape.members.First, 5).Last.StartsWith("    llvm.store %t7ra0, %t7r0")
	let offset = MlirEmbedded(function).Offset(owner, member.Name)
	if MlirEmbedded(function).IsNumbers(owner.Name) is false
		return Placed(Putting, offset, register)
	if MlirEmbedded(function).IsInline(owner, member) is false
		return Placed(Putting.Slice(0, 2) + "    llvm.store %t#ra$, %t#r$ : f64, !llvm.ptr", offset, register)
	let source = "%t" + position + "ra" + offset
	let target = "%t" + position + "r" + offset
	Placed(Putting.Slice(0, 2), offset, register) + MlirEmbedded(function).Copied(source, target, member.typeName)
Placed(lines Texts, slot Number, register Number) Texts
	Rebuilt.Placed(Putting, 1, 5)(1) is "    %t7ra1 = llvm.load %r5 : !llvm.ptr -> f64"
	Text.Combine(Rebuilt.Put(MlirInstances.Outer, MlirInstances.Outer.members.First, 4)).Length is 323
	Rebuilt.Put(MlirInstances.Outer, MlirInstances.Outer.members.First, 4).Last.StartsWith("    %t7ra0m = llvm.call")
	Text.Combine(Rebuilt.Put(MlirFunction.Shape, MlirFunction.Shape.members.First, 5)).Length is 165
	Text.Combine(Rebuilt.Put(MlirInstances.Outer, MlirInstances.Outer.members.First, 4)).IndexOf("(%t7r0, %t7ra0p,") > 0
	for lines
		value.Replace("#", position to Text).Replace("$", slot to Text).Replace("&", register to Text)
IsKept(register Number, member Text, name Text) Boolean
	Rebuilt.IsKept(4, "shape", "moved")
	Rebuilt.IsKept(5, "size", "moved") is false
	let kinds = MlirKinds(function)
	let writer = kinds.Writer(position, register)
	let field = writer >= 0 then function.method.instructions(writer) else InstructionEntry.Return(0)
	if (field.kind is not InstructionType.FieldLoad) or (field.texts(0) is not member)
		return false
	let source = kinds.Writer(writer, field.payload(1))
	let loaded = source >= 0 then function.method.instructions(source) else field
	(loaded.kind is InstructionType.LoadVariableToRegister) and (loaded.texts(0) is name)
