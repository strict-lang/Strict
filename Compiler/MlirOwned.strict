has function MlirFunction
has position Number
constant Empty = MethodCodegen.StoreConstant(InstructionEntry(InstructionType.LoadConstantToRegister, "Strict/List(Number)", (0, 6, -1, 0)), "listResult0")
constant Built = (Empty, InstructionEntry.Named(InstructionType.LoadVariableToRegister, 0, "listResult0"), InstructionEntry.Named(InstructionType.StoreRegisterToVariable, 0, "moved"))
constant Moving = MlirFunction(List(TypeEntry), MlirFunction.Shape, MethodEntry("Run", List(MemberEntry), "None", Built + InstructionEntry.Named(InstructionType.LoadVariableToRegister, 1, "moved") + InstructionEntry.Return(1)))
constant Copying = MlirFunction(List(TypeEntry), MlirFunction.Shape, MethodEntry("Run", List(MemberEntry), "None", Built + InstructionEntry.Named(InstructionType.LoadVariableToRegister, 1, "moved") + InstructionEntry.Named(InstructionType.StoreRegisterToVariable, 1, "kept")))
constant Owner = MlirOwned(Moving, 2)
constant Temporaries = ("index", "value", "outer", "forResult")
constant Named = (InstructionType.LoadVariableToRegister, InstructionType.StoreRegisterToVariable)
IsOwned(name Text) Boolean
	Owner.IsOwned("moved")
	MlirOwned(Copying, 2).IsOwned("moved") is false
	Owner.IsOwned("listResult0") is false
	let isTemporary = (name is in Temporaries) or name.StartsWith("listResult") or name.StartsWith("conditional")
	let isOuter = (name is in function.Parameters) or (name is in MlirInstances(function, 0).StoredNames(function.type))
	(isTemporary is false) and (isOuter is false) and IsReference(name) and IsContained(name)
IsReference(name Text) Boolean
	Owner.IsReference("moved")
	let kind = MlirKinds(function).VariableKind(function.method.instructions.Length, name)
	let represented = MlirLayout(function).Represented(kind)
	let isHeap = represented.StartsWith("List(") or MlirLayout(function).IsStruct(kind)
	isHeap and (MlirPairs(function, 0).IsPaired(kind) is false)
IsContained(name Text) Boolean
	Owner.IsContained("moved")
	for function.method.instructions
		let isNamed = (value.kind is in Named) and (value.texts(0) is name)
		let isLoad = value.kind is InstructionType.LoadVariableToRegister
		let isKept = isLoad then IsSafeRead(index, name) else IsFresh(function, index, value.payload(0), 0)
		if isNamed and (isKept is false)
			return false
	true
IsFresh(inspected MlirFunction, at Number, register Number, depth Number) Boolean
	Owner.IsFresh(MlirInstances.Shapes, 2, 0, 0)
	Owner.IsFresh(Moving, 2, 0, 0)
	Owner.IsFresh(Moving, 4, 1, 0) is false
	let writer = MlirKinds(inspected).Writer(at, register)
	if writer < 0
		return false
	let entry = inspected.method.instructions(writer)
	if entry.kind is InstructionType.LoadVariableToRegister
		return (entry.texts(0) is "forResult") or entry.texts(0).StartsWith("listResult")
	if entry.kind is InstructionType.LoadConstantToRegister
		return true
	(entry.kind is InstructionType.Invoke) and IsFreshCall(inspected, writer, depth)
IsFreshCall(inspected MlirFunction, at Number, depth Number) Boolean
	let entry = inspected.method.instructions(at)
	let arguments = entry.payload(5 + entry.payload(3))
	let first = 6 + entry.payload(3)
	if entry.texts(1) is "Validated"
		return IsFresh(inspected, at, entry.payload(first + arguments + 1), depth)
	if entry.texts(1) is "from"
		let isBuilt = (arguments > 0) and IsFresh(inspected, at, entry.payload(first), depth)
		return MlirLayout(inspected).IsStruct(entry.texts(0)) or isBuilt
	let callees = MlirModule(inspected.types, "").Called(inspected, at)
	(depth < 3) and (callees.Length > 0) and IsFreshMethod(callees.First, depth + 1)
IsFreshMethod(callee MlirFunction, depth Number) Boolean
	Owner.IsFreshMethod(Moving, 0) is false
	for callee.method.instructions
		if (value.kind is InstructionType.Return) and (IsFresh(callee, index, value.payload(0), depth) is false)
			return false
	true
IsSafeRead(at Number, name Text) Boolean
	Owner.IsSafeRead(3, "moved")
	MlirOwned(Copying, 2).IsSafeRead(3, "moved") is false
	let instructions = function.method.instructions
	let register = instructions(at).payload(0)
	let reuse = LoadReuse(instructions)
	for Range(at + 1, instructions.Length)
		if IsEscaped(value, register, name)
			return false
		if reuse.Written(instructions(value)) is register
			return true
	true
IsEscaped(at Number, register Number, name Text) Boolean
	MlirOwned(Copying, 2).IsEscaped(4, 1, "moved")
	Owner.IsEscaped(4, 1, "moved") is false
	let entry = function.method.instructions(at)
	let isStored = (entry.kind is InstructionType.StoreRegisterToVariable) and (entry.payload(0) is register)
	let isLooped = (entry.kind is InstructionType.LoopBegin) and (entry.payload(0) is register)
	(isStored and (entry.texts(0) is not name)) or isLooped or IsLeaked(at, register)
IsLeaked(at Number, register Number) Boolean
	Owner.IsLeaked(4, 1) is false
	let entry = function.method.instructions(at)
	if (entry.kind is not InstructionType.Invoke) or (Takes(entry, register) is false)
		return false
	let returned = MlirLayout(function).Represented(TypeEntry.ShortName(entry.texts(2)))
	(returned is not in ("Number", "Boolean", "None", "Text")) and (IsFreshCall(function, at, 0) is false)
Takes(entry InstructionEntry, register Number) Boolean
	Owner.Takes(InstructionEntry.Invoke(2, ("T", "Add", "N", "x"), 0, 1), 1)
	Owner.Takes(InstructionEntry.Invoke(2, ("T", "Add", "N", "x"), 0, 1), 0)
	Owner.Takes(InstructionEntry.Invoke(2, ("T", "Add", "N", "x"), 0, 1), 2) is false
	let first = 6 + entry.payload(3)
	let arguments = entry.payload(5 + entry.payload(3))
	let hasInstance = entry.payload(first + arguments) is 1
	if hasInstance and (entry.payload(first + arguments + 1) is register)
		return true
	for arguments
		if entry.payload(first + index) is register
			return true
	false
Stored(entry InstructionEntry) Texts
	Owner.Stored(Built(2)).Last is "    func.call @strict_rc_dead(%t2o, %t2) : (f64, f64) -> ()"
	MlirOwned(Copying, 4).Stored(Copying.method.instructions(4)).Length is 2
	let slot = "%v_" + entry.texts(0)
	let copied = function.Copied("%r" + entry.payload(0), slot, "%t" + position)
	if IsOwned(entry.texts(0)) is false
		return copied
	let released = "    func.call @strict_rc_dead(%t" + position + "o, %t" + position + ") : (f64, f64) -> ()"
	(List(Text) + function.Load("%t" + position + "o", slot)) + copied + released
