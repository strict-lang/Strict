has function MlirFunction
has position Number
constant Letters = "abcdefghijklmnopqr"
constant Widths = (16, 32, 8, 6, 4)
constant SharedWidths = (16, 32, 8)
constant Summing = MlirPacked(MlirKernel.Summing.function, 1)
constant Doubling = MlirPacked(MlirKernel.Doubling.function, 2)
constant SecondCases = ("1024: ^ffloop1fast", "2048: ^fgloop1fast", "512: ^fhloop1fast", "384: ^filoop1fast", "256: ^fjloop1fast")
Branch Text
	Summing.Branch is "    cf.cond_br %f1ok1, ^floop1packed, ^loop1generic"
	Doubling.Branch is "    cf.cond_br %f2ok1, ^floop2packed, ^loop2generic"
	let kind = Packable.Length > 0 then "packed, ^loop" else "fast, ^loop"
	let flag = "%f" + position + "ok" + MlirKernel(function, position).Sources.Length
	"    cf.cond_br " + flag + ", ^floop" + position + kind + position + "generic"
Packable Texts
	Summing.Packable is (MlirFastLoop.Iterated, "numbers")
	Doubling.Packable is (MlirFastLoop.Iterated, "numbers")
	let loops = MlirLoops(function, position)
	mutable names = loops.Collection is "List(Number)" then List(Text) + MlirFastLoop.Iterated else List(Text)
	for MlirKernel(function, position).Sources
		if MlirLayout(function).Represented(MlirKinds(function).VariableKind(position, value)) is "List(Number)"
			names = names + value
	names.Length > 3 then List(Text) else names
Keyed(name Text, index Number) Texts
	Summing.Keyed("numbers", 1).Last is "    %f1s2 = arith.addi %f1s1, %f1w1 : i64"
	Summing.Keyed("for", 0).First is "    %f1k_for = func.call @strict_list_holder(%f1v) : (f64) -> !llvm.ptr"
	let prefix = "%f" + position
	let list = name is MlirFastLoop.Iterated then prefix + "v" else prefix + "l_" + name
	let holder = prefix + "k_" + name
	let held = "    " + holder + " = func.call @strict_list_holder(" + list + ") : (f64) -> !llvm.ptr"
	let packed = "    " + prefix + "q" + index + " = func.call @strict_holder_packed(" + holder + ") : (!llvm.ptr) -> i64"
	let shift = "    " + prefix + "m" + index + " = arith.constant " + 6 * index + " : i64"
	let shifted = " = arith.shli " + prefix + "q" + index + ", " + prefix + "m" + index + " : i64"
	let sum = " = arith.addi " + prefix + "s" + index + ", " + prefix + "w" + index + " : i64"
	(held, packed, shift, "    " + prefix + "w" + index + shifted, "    " + prefix + "s" + (index + 1) + sum)
Case(source Number) Texts
	Summing.Case(1) is SecondCases
	for Widths
		let letter = Letters.Substring(Widths.Length * source + index, 1)
		((value * 64 ^ source) to Text) + ": ^f" + letter + "loop" + position + "fast"
Shared(count Number) Texts
	Summing.Shared(2) is ("1040: ^fkloop1fast", "2080: ^flloop1fast", "520: ^fmloop1fast")
	Summing.Shared(1).Length is 0
	if count < 2
		return List(Text)
	for SharedWidths
		let letter = Letters.Substring(Widths.Length * count + index, 1)
		((value * (64 ^ count - 1) / 63) to Text) + ": ^f" + letter + "loop" + position + "fast"
Dispatched Texts
	Text.Combine(Summing.Dispatched).IndexOf("[default: ^loop1generic, 0: ^floop1fast, 1040: ^fkloop1fast") > 0
	Text.Combine(Summing.Dispatched).IndexOf("520: ^fmloop1fast, 16: ^faloop1fast") > 0
	let names = Packable
	if names.Length is 0
		return List(Text)
	mutable lines = List(Text) + ("  ^floop" + position + "packed:", "    %f" + position + "s0 = arith.constant 0 : i64")
	mutable cases = Shared(names.Length)
	for names
		lines = lines + Keyed(value, index)
		cases = cases + Case(index)
	let targets = "[default: ^loop" + position + "generic, 0: ^floop" + position + "fast, " + Text.Combine(cases, ", ")
	lines + ("    cf.switch %f" + position + "s" + names.Length + " : i64, " + targets + "]") + Variants
Variants Texts
	Summing.Variants.First is "  ^faloop1fast:"
	Text.Combine(Summing.Variants).IndexOf("arith.extf %fa1gsn : f16 to f32") > 0
	let names = Packable
	mutable lines = List(Mutable(Text))
	for names.Length * Widths.Length
		lines = lines + Variant(names((index / Widths.Length).Floor) + " " + Widths(index % Widths.Length), index)
	if names.Length > 1
		for SharedWidths
			let packing = Text.Combine(Pairs(names, value), " ")
			lines = lines + Variant(packing, names.Length * Widths.Length + index)
	lines
Variant(packing Text, number Number) Texts
	Summing.Variant("for 16", 0).First is "  ^faloop1fast:"
	let packed = MlirFunction(function.types, function.type, function.method, function.lineSlots, position, packing)
	let single = MlirSingle(packed, position)
	let copied = single.IsSingle then single.Copied else MlirFastLoop(packed, position).Copied
	let renamed = MlirKernel(function, position).Renamed(copied, Letters.Substring(number, 1))
	renamed + ("    cf.br ^loop" + position + "joined")
Pairs(names Texts, width Number) Texts
	Summing.Pairs(("for", "numbers"), 16) is ("for 16", "numbers 16")
	for names
		value + " " + width