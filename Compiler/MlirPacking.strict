has function MlirFunction
has position Number
constant ListParameter = List(MemberEntry) + MemberEntry("list", "Strict/List(Number)", List(InstructionEntry), false)
constant SummedMethod = MethodEntry("Summed", ListParameter, "Strict/Number", List(InstructionEntry))
constant OtherParameter = List(MemberEntry) + MemberEntry("other", "Strict/Math/Pairing", List(InstructionEntry), false)
constant MovedMethod = MethodEntry("Moved", OtherParameter, "Strict/Number", List(InstructionEntry))
constant Adder = TypeEntry("Strict/Math/Adder", List(MemberEntry), (SummedMethod, MovedMethod))
constant SummedCall = ("Strict/Math/Adder", "Summed", "Strict/Number", "list")
constant ListSum = InstructionEntry.Invoke(1, ("Strict/List(Number)", "Sum", "Strict/Number"), List(Number), 0)
constant Totals = (InstructionEntry.Named(InstructionType.LoadVariableToRegister, 0, "numbers"), ListSum, InstructionEntry.Invoke(2, SummedCall, List(Number) + 0, -1), InstructionEntry.Return(1))
constant Listing = MlirPacking(MlirFunction((MlirPairs.Pairing, Adder), MlirPairs.Pairing, MethodEntry("Total", List(MemberEntry), "Strict/Number", Totals)), 0)
constant MovedCall = InstructionEntry.Invoke(1, ("Strict/Math/Adder", "Moved", "Strict/Number", "other"), List(Number) + 0, -1)
constant Moves = (InstructionEntry.Named(InstructionType.LoadVariableToRegister, 0, "list"), MovedCall, InstructionEntry.Named(InstructionType.LoadVariableToRegister, 2, "list"), InstructionEntry.Return(2))
constant Packed = MlirPacking(MlirFunction((MlirPairs.Pairing, Adder), MlirPairs.Pairing, MethodEntry("Moved", ListParameter, "Strict/Math/Pairing", Moves)), 0)
constant Fetching = InstructionEntry(InstructionType.IndexCall, "numbers", (7, 1, -1))
constant Halved = MlirPacking(MlirFunction((MlirFlats.Halving, MlirFlats.Summing), MlirFlats.Halving, MlirFlats.Halving.methods.Last), 0)
constant Plain = MlirPacking(MlirLists.Listed, 2)
constant Repacking = ("    %t0c = llvm.load %r0 : !llvm.ptr -> f64", "    %t0cl = func.call @strict_two_list(%t0c) : (f64) -> f64", "    llvm.store %t0cl, %r0 : f64, !llvm.ptr")
constant Twice = InstructionEntry.Invoke(1, SummedCall, (3, 0), -1)
constant Instanced = InstructionEntry.Invoke(1, SummedCall, (0), 3)
constant FlattenedLoads = ("    %t2l = llvm.load %v_numbers : !llvm.ptr -> f64", "    %t2i = llvm.load %r1 : !llvm.ptr -> f64")
constant ShapeBits = ("    %t2n = llvm.mlir.addressof @sShape_Run_1_2 : !llvm.ptr", "    %t2nb = func.call @strict_bits(%t2n) : (!llvm.ptr) -> f64")
constant ListRead = ("    %t2x = func.call @strict_list_read(%t2l, %t2i, %t2nb) : (f64, f64, f64) -> f64", "    llvm.store %t2x, %r2 : f64, !llvm.ptr")
constant Flattening = FlattenedLoads + ShapeBits + ListRead
constant Indexing = ("    %t0l = llvm.load %v_numbers : !llvm.ptr -> f64", "    %t0i = llvm.load %r1 : !llvm.ptr -> f64", "    %t0x = func.call @strict_two_at(%t0l, %t0i) : (f64, f64) -> f64", "    llvm.store %t0x, %r7 : f64, !llvm.ptr")
Kind(written Text) Text
	Listing.Kind("Pairing") is "List(Number)" and (Listing.Kind("Number") is "Number")
	MlirPacking(Packed.function, 2).Kind("List(Number)") is "Pairing" and (Packed.Kind("Numbers") is "Pairing")
	let reuse = LoadReuse(function.method.instructions)
	let register = reuse.Written(function.method.instructions(position))
	if (register < 0) or (written is not in ("List(Number)", "Numbers")) and (IsPacked(written) is false)
		return written
	for Range(position + 1, function.method.instructions.Length)
		let reader = function.method.instructions(value)
		let expected = register is in reuse.Reads(reader) then Expected(reader, register, written) else ""
		if (expected is not "") or (reuse.Written(reader) is register)
			return expected is "" then written else expected
	written
Expected(reader InstructionEntry, register Number, written Text) Text
	Listing.Expected(InstructionEntry.LoopBegin(0, -1), 0, "Pairing") is "List(Number)"
	Listing.Expected(InstructionEntry.Binary(InstructionType.Add, (1, 0, 2)), 0, "Pairing") is "List(Number)"
	Listing.Expected(InstructionEntry.Binary(InstructionType.Equal, (1, 0)), 0, "Pairing") is ""
	Listing.Expected(MlirPairs.Reading, 0, "Pairing") is ""
	Listing.Expected(MlirPairs.Constructing, 0, "Pairing") is ""
	Packed.Expected(InstructionEntry.Return(2), 2, "List(Number)") is "Pairing"
	if reader.kind is InstructionType.Invoke
		return PayloadDecoder(reader).Text(2) is "from" then "" else Argument(PayloadDecoder(reader), register, written)
	let isArithmetic = reader.kind > InstructionType.StoreSeparator and reader.kind < InstructionType.ArithmeticSeparator
	let isListed = isArithmetic or (reader.kind is InstructionType.LoopBegin)
	let declared = reader.kind is InstructionType.Return then function.method.returnType else "List(Number)"
	isListed or (reader.kind is InstructionType.Return) then Converted(written, declared) else ""
Argument(decoder PayloadDecoder, register Number, written Text) Text
	Listing.Argument(PayloadDecoder(Listing.function.method.instructions(1)), 0, "Pairing") is "List(Number)"
	Packed.Argument(PayloadDecoder(Packed.function.method.instructions(1)), 0, "List(Number)") is "Pairing"
	let count = decoder.entry.payload(5 + decoder.entry.payload(3))
	let instance = 6 + decoder.entry.payload(3) + count
	if (decoder.entry.payload(instance) is 1) and (decoder.entry.payload(instance + 1) is register)
		let helper = MlirPairs(function, position).Helper(decoder.entry, written, decoder.Text(2))
		return helper is "" then Converted(written, decoder.entry.texts.First) else ""
	let parameters = decoder.Callee(function.TypeOf(decoder.Text(1))).parameters
	for count
		if (decoder.entry.payload(instance - count + index) is register) and (index < parameters.Length)
			return Converted(written, parameters(index).typeName)
	""
Converted(written Text, declared Text) Text
	Listing.Converted("Pairing", "Strict/List(Number)") is "List(Number)"
	Listing.Converted("List(Number)", "Strict/Math/Pairing") is "Pairing"
	Listing.Converted("Pairing", "Strict/Math/Pairing") is ""
	Listing.Converted("Text", "Strict/List(Number)") is ""
	Halved.Converted("List(Number)", "Strict/Math/Halving") is "Halving"
	Listing.Converted("Numbers", "Strict/Math/Pairing") is "Pairing"
	Listing.Converted("Text", "Strict/Math/Pairing") is "" and (Listing.Converted("Numbers", "Strict/List(Number)") is "")
	let target = TypeEntry.ShortName(declared)
	if IsPacked(written)
		return MlirLayout(function).Represented(target).StartsWith("List(") then "List(Number)" else ""
	(written is in ("List(Number)", "Numbers")) and IsPacked(target) then target else ""
IsPair(kind Text) Boolean
	Listing.IsPair("Pairing")
	Listing.IsPair("List(Number)") is false
	Listing.Expected(InstructionEntry.Named(InstructionType.LoadVariableToRegister, 1, "x"), 0, "Pairing") is ""
	(TypeEntry.IsBaseName(kind) is false) and MlirPairs(function, position).IsListed(kind)
Repacked Texts
	Listing.Repacked(1) is "    %t0cl = func.call @strict_two_list(%t0c) : (f64) -> f64"
	Packed.Repacked(1) is "    %t0cl = func.call @strict_two_from_list(%t0c) : (f64) -> f64"
	Halved.Repacked(1) is "    %t0cl = func.call @strict_flat_list(%t0c) : (f64) -> f64"
	let register = LoadReuse(function.method.instructions).Written(function.method.instructions(position))
	let written = register < 0 then "" else MlirKinds(function).WrittenKind(position)
	let converted = register < 0 then "" else Kind(written)
	if converted is written
		return List(Text)
	let helper = Helper(written, converted)
	let temp = "%t" + position + "c"
	let call = "    " + temp + "l = func.call @" + helper + "(" + temp + ") : (f64) -> f64"
	(function.Load(temp, "%r" + register), call, function.Store(temp + "l", "%r" + register))
Indexed(entry InstructionEntry, fallback MlirLists) Texts
	Listing.Indexed(Fetching, MlirLists(Listing.function, 0)) is Indexing
	Plain.Indexed(MlirLists.Steps(2), MlirLists(MlirLists.Listed, 2)) is Flattening
	Text.Combine(Listing.Indexed(Fetching, MlirLists(Listing.function, 0))).IndexOf("@strict_two_at(%t0l, %t0i)") > 0
	Plain.Indexed(MlirLists.Steps(2), MlirLists(MlirLists.Listed, 2)).Last.EndsWith("%r2 : f64, !llvm.ptr")
	if IsPair(MlirKinds(function).VariableKind(position, entry.texts(0))) is false
		return MlirFlats(function, position).Indexed(entry, fallback)
	let temp = "%t" + position
	let loads = (function.Load(temp + "l", "%v_" + entry.texts(0)), function.Load(temp + "i", "%r" + entry.payload(1)))
	let call = MlirMemory(function, position).Called(temp + "x", "strict_two_at", (temp + "l", temp + "i"))
	loads + call + function.Store(temp + "x", "%r" + entry.payload(0))
IsPacked(kind Text) Boolean
	Halved.IsPacked("Halving")
	Listing.IsPacked("Pairing")
	Listing.IsPacked("List(Number)") is false
	Listing.Argument(PayloadDecoder(Twice), 0, "Pairing") is ""
	Listing.Argument(PayloadDecoder(Instanced), 0, "Pairing") is "List(Number)"
	Listing.Expected(MlirPairs.Constructing, 0, "List(Number)") is ""
	IsPair(kind) or (MlirFlats(function, position).Count(kind) > 0)
Helper(written Text, converted Text) Text
	Listing.Helper("Pairing", "List(Number)") is "strict_two_list"
	Halved.Helper("Halving", "List(Number)") is "strict_flat_list"
	Halved.Helper("List(Number)", "Halving") is "strict_flat_from_list"
	Listing.Repacked is Repacking and (MlirPacking(Listing.function, 1).Repacked is List(Text))
	MlirPacking(Listing.function, 3).Kind("Pairing") is "Pairing"
	let isListed = converted is "List(Number)"
	let isFlat = MlirFlats(function, position).Count(isListed then written else converted) > 0
	"strict_" + (isFlat then "flat_" else "two_") + (isListed then "list" else "from_list")
