has function MlirFunction
constant Writers = (InstructionType.StoreRegisterToVariable, InstructionType.StoreConstantToVariable, InstructionType.InvokeWriteToList, InstructionType.InvokeRemove, InstructionType.CopyList)
constant Reading = MlirParameters(MlirFunction(List(TypeEntry) + MlirFunction.Shape, MlirFunction.Shape, MethodEntry("Run", List(MemberEntry) + MlirLists.Items, "None", (InstructionEntry.LoadNumber(1, 0), InstructionEntry(InstructionType.IndexCall, "numbers", (2, 1, -1))))))
FixedLists Texts
	Reading.FixedLists is ("numbers")
	MlirParameters(MlirLists.Listed).FixedLists.Length is 0
	for function.method.parameters
		if value.typeName.StartsWith("Strict/List(") and IsFixed(value.Name)
			value.Name
IsFixed(name Text) Boolean
	Reading.IsFixed("numbers")
	for function.method.instructions
		if value.kind is in Writers
			let target = value.kind is InstructionType.StoreConstantToVariable then value.texts.Last else value.texts.First
			if (target is name) or target.StartsWith(name + "(")
				return false
	true
Hoisted Texts
	Reading.Hoisted.Length is 3
	let fixed = FixedLists
	mutable lines = List(Mutable(Text))
	for function.method.parameters
		if value.Name is in fixed
			lines = lines + Started(value.Name, "%p" + (index + 1))
	lines
Started(name Text, parameter Text) Texts
	Reading.Started("numbers", "%p1").First is "    %h_numbers = func.call @strict_list_hoisted(%p1) : (f64) -> !llvm.ptr"
	Reading.Started("numbers", "%p1").Last is "    %k_numbers = func.call @strict_list_version() : () -> i64"
	let items = "    %h_" + name + " = func.call @strict_list_hoisted(" + parameter + ") : (f64) -> !llvm.ptr"
	let length = "    %n_" + name + " = func.call @strict_list_length(" + parameter + ") : (f64) -> f64"
	(items, length, "    %k_" + name + " = func.call @strict_list_version() : () -> i64")
Read(name Text, list Text, position Text, nameBits Text, result Text) Text
	Reading.Read("a", "%l", "%i", "%nb", "%x").IndexOf("@strict_hoisted_read(%h_a, %n_a, %i, %nb, %k_a, %l)") > 0
	let hoisted = "(%h_" + name + ", %n_" + name + ", " + position + ", " + nameBits
	let operands = hoisted + ", %k_" + name + ", " + list + ")"
	"    " + result + " = func.call @strict_hoisted_read" + operands + " : (!llvm.ptr, f64, f64, f64, i64, f64) -> f64"
