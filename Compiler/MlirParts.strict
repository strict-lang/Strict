has split MlirSplit
has starts Numbers = List(Number)
has declarations Texts = List(Text)
has owners Numbers = List(Number)
has shared Texts = List(Text)
has placed Numbers = List(Number)
constant Sample = MlirParts(MlirSplit.Sample).Laid
constant Swapped = MlirParts(Sample, owners = (1, 0))
constant Second = Swapped.Part(1, List(Text) + MlirSplit.Tricky, Sample.split.Own(Sample.starts, (1, 0), 1))
constant Ends = (" ", "(", ")", ",", ":", "\"", "\\", ">", "]", "}")
Laid MlirParts
	Sample.starts is (3, 7)
	Sample.declarations.Length is 2
	Sample.owners is (MlirSplit.Sample.Owner(MlirSplit.Sample.lines(3)), MlirSplit.Sample.Owner(MlirSplit.Sample.lines(7)))
	Sample.shared.Length is 2
	Sample.placed.Length is 2
	lines = split.Starts
	common = split.Shared
	laid = MlirParts(split, lines, split.Declarations(lines), Owners(lines))
	MlirParts(laid, shared = common, placed = split.Place(common))
Owners(lines Numbers) Numbers
	MlirParts(MlirSplit.Sample).Owners(3) is (MlirSplit.Sample.Owner(MlirSplit.Sample.lines(3)))
	for lines
		split.Owner(split.lines(value))
Part(index Number, data Texts, owned Texts) Text
	Second.IndexOf("  func.func private @B(f64) -> f64\n") > 0
	Second.IndexOf("  func.func @A() -> f64 {\n") > 0
	Second.IndexOf("  llvm.func @printf(!llvm.ptr, ...) -> i32\n") > 0
	Second.StartsWith("module {\n")
	Second.EndsWith("\n}")
	Second.IndexOf("module {\n" + MlirSplit.Tricky + "\n") is 0
	used = Used(data + owned)
	declared = split.Externals(index, shared, placed, used) + split.Others(declarations, owners, index, used)
	Text.Combine((List(Text) + "module {") + data + declared + owned + "}", "\n")
Used(texts Texts) Dictionary(Text, Number)
	"x_1" is in Sample.Used(("    %a = llvm.mlir.addressof @x_10 : !llvm.ptr", "  call @x_1(%a)"))
	"x_1" is not in Sample.Used(("    %a = llvm.mlir.addressof @x_10 : !llvm.ptr", "  }"))
	mutable used = Dictionary(Text, Number)
	for line, piece in texts, line.Split("@")
		used(Token(piece)) = 0
	used
Token(piece Text) Text
	Sample.Token("x_1 : !llvm.ptr") is "x_1"
	Sample.Token("B() : () -> f64") is "B"
	Sample.Token("d") is "d"
	for Range(0, piece.Length)
		if piece(value) is in Ends
			return piece.Substring(0, value)
	piece
Change(base Text, flags Text) Numbers
	PtxCache("Compiler/output/Unsplit-0").Save("", "stale") is not Error
	Sample.Change("Compiler/output/Unsplit", "a").Length > 0
	File("Compiler/output/Unsplit-0").Exists is false
	mutable changed = List(Mutable(Number))
	for Range(0, Toolchain.Parts)
		part = base + "-" + value
		File(part).Delete
		if IsRefreshed(part, flags, value)
			changed.Add(value)
	changed
IsRefreshed(part Text, flags Text, index Number) Boolean
	Sample.IsRefreshed("Compiler/output/Refreshed", "a", Sample.owners.First)
	File("Compiler/output/Refreshed.mlir").ReadLines.Length > 4
	data = split.Data(index, shared, placed)
	owned = split.Own(starts, owners, index)
	if IsWritten(part, flags, Text.Combine(data + owned, "\n")) is false
		return false
	File(part + ".mlir").Write(Part(index, data, owned))
	true
IsCurrent(part Text, key Text) Boolean
	PtxCache("Compiler/output/Current").Save((".o", ".owned"), ("compiled", "a")) is not Error
	Sample.IsCurrent("Compiler/output/Current", "a")
	Sample.IsCurrent("Compiler/output/Current", "b") is false
	Sample.IsCurrent("Compiler/output/Absent", "a") is false
	File(part + ".o").Exists and File(part + ".owned").Exists and PtxCache(part).Read(".owned") is key
IsWritten(part Text, flags Text, owned Text) Boolean
	PtxCache("Compiler/output/Keyed").Save(".o", "compiled") is not Error
	Sample.IsWritten("Compiler/output/Keyed", "f", "") is false
	File("Compiler/output/Keyed.o").Exists is false
	Sample.IsWritten("Compiler/output/Keyed", "f", "a")
	if owned is ""
		File(part + ".o").Delete
		return false
	if IsCurrent(part, flags + owned)
		return false
	File(part + ".o").Delete
	PtxCache(part).Save(".owned", flags + owned)
	true
Lower(base Text, tools Toolchain) Text
	Sample.Lower("Compiler/output/missing", Toolchain.OnWindows).StartsWith("mlir-opt failed")
	mutable optimizing = List(Text)
	mutable translating = List(Text)
	for Change(base, MlirSplit.Single + tools.Bitcode(""))
		part = base + "-" + value
		optimizing = optimizing + ("\"" + part + ".mlir\"" + MlirSplit.Single + part + ".llvm.mlir\"")
		translating = translating + (MlirSplit.Translating + "\"" + part + ".llvm.mlir\" -o \"" + part + "\"")
	File(base + ".ll").Delete
	lowered = RunTool("mlir-opt", optimizing, tools)
	lowered is "" then RunTool("mlir-translate", translating, tools) else lowered
RunTool(tool Text, arguments Texts, tools Toolchain) Text
	Sample.RunTool("noSuchStrictTool", List(Text) + "", Toolchain.OnWindows).StartsWith("noSuchStrictTool failed")
	Sample.RunTool("noSuchStrictTool", List(Text), Toolchain.OnWindows) is ""
	if arguments.Length is 0
		return ""
	for ToolRunner(tools.Locate(tool)).ExecuteAll(arguments, tool)
		if value.HasFailed
			return tool + " failed: " + value.error
	""
