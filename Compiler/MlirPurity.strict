has function MlirFunction
has position Number
constant UnsafeTypes = ("File", "Directory", "Process", "Time", "Library", "Logger", "TextReader", "TextWriter", "BytesReader", "BytesWriter")
constant Branches = (InstructionType.Jump, InstructionType.JumpIfTrue, InstructionType.JumpIfFalse, InstructionType.JumpIfNotZero)
constant Unsafe = (InstructionType.Set, InstructionType.InvokeWriteToTable, InstructionType.InvokeRemove, InstructionType.Print, InstructionType.ConstructValueType, InstructionType.CopyList)
constant Doubling = MlirPurity(MlirParallel.Doubling.function, 2)
constant Randomizing = MlirPurity(MlirParallel.Randomizing.function, 2)
constant Clamped = MethodEntry("Clamped", List(MemberEntry) + MlirLists.Items, "Strict/List(Number)", (MlirLoops.Emptied, InstructionEntry.Named(InstructionType.LoadVariableToRegister, 0, "numbers"), InstructionEntry.LoopBegin(0, -1), InstructionEntry.Named(InstructionType.LoadVariableToRegister, 1, "value"), InstructionEntry.LoadNumber(2, 0), InstructionEntry.Binary(InstructionType.GreaterThan, (1, 2)), InstructionEntry.Jump(InstructionType.JumpToIdIfFalse, 0), InstructionEntry.Named(InstructionType.LoadVariableToRegister, 3, "value"), InstructionEntry.Named(InstructionType.StoreRegisterToVariable, 3, "conditional0"), InstructionEntry.LoadBoolean(4, true), InstructionEntry.Binary(InstructionType.Equal, (4, 4)), InstructionEntry.Jump(InstructionType.JumpEnd, 0), InstructionEntry.Jump(InstructionType.JumpToIdIfTrue, 1), InstructionEntry.LoadNumber(5, 0), InstructionEntry.Named(InstructionType.StoreRegisterToVariable, 5, "conditional0"), InstructionEntry.Jump(InstructionType.JumpEnd, 1), InstructionEntry.Named(InstructionType.LoadVariableToRegister, 6, "conditional0"), InstructionEntry.Named(InstructionType.InvokeWriteToList, 6, "forResult"), InstructionEntry.Jump(InstructionType.LoopEnd, 16)))
constant Clamping = MlirPurity(MlirFunction(List(TypeEntry) + MlirParallel.Rows, MlirParallel.Rows, Clamped), 2)
constant Making = MlirFunction(MlirLayout.Wrapping.function.types, MlirLayout.Degrees, MethodEntry("Made", List(MemberEntry), "Strict/Degrees", (InstructionEntry.LoadNumber(0, 1), MlirDeviceCalls.Making, InstructionEntry.Return(1))))
constant Checking = MethodEntry("Validated", List(MemberEntry), "Strict/Math/Pairing", (InstructionEntry.LoadText(0, "a"), InstructionEntry.Named(InstructionType.LoadVariableToRegister, 1, "number"), InstructionEntry.Binary(InstructionType.Add, (0, 1, 2)), InstructionEntry.Return(2)))
constant Filtering = MlirPurity(MlirFunction(List(TypeEntry) + MlirParallel.Rows, MlirParallel.Rows, MlirParallel.Filtered), 2)
IsSafe(inspected MlirFunction, at Number, depth Number) Boolean
	Doubling.IsSafe(Doubling.function, 4, 0)
	Randomizing.IsSafe(Randomizing.function, 4, 0) is false
	Clamping.IsSafe(Clamping.function, 6, 0)
	Filtering.IsSafe(Filtering.function, 7, 0) is false
	let entry = inspected.method.instructions(at)
	if entry.kind is InstructionType.Invoke
		return IsPureCall(inspected, at, depth)
	if entry.kind is InstructionType.InvokeWriteToList
		return (depth is 0) and IsCollected(at)
	let isLeaving = (depth is 0) and ((entry.kind is InstructionType.Return) or (entry.kind is in Branches))
	(isLeaving is false) and IsPlain(inspected, at) and ((depth > 0) or IsLocal(entry))
IsCollected(at Number) Boolean
	Clamping.IsCollected(17)
	Filtering.IsCollected(7) is false
	mutable open = 0
	for Range(position + 1, at)
		let kind = function.method.instructions(value).kind
		if kind is in (InstructionType.JumpToIdIfFalse, InstructionType.JumpToIdIfTrue)
			open = open + 1
		if kind is InstructionType.JumpEnd
			open = open - 1
	(open is 0) and (function.method.instructions(at).texts(0) is "forResult")
IsPlain(inspected MlirFunction, at Number) Boolean
	Doubling.IsPlain(Doubling.function, 3)
	let entry = inspected.method.instructions(at)
	let kind = entry.kind
	if kind is in Unsafe
		return false
	if kind is InstructionType.LoopBegin
		return MlirLoops(inspected, at).IsCollecting is false
	if kind is InstructionType.LoadConstantToRegister
		return PayloadDecoder(entry).Value(1).kind is not "List"
	let isBinary = (kind > InstructionType.StoreSeparator) and (kind < InstructionType.BinaryOperatorsSeparator)
	let isList = isBinary and MlirListOperators(inspected, at).IsOperation
	(isList is false) and ((isBinary is false) or (MlirTexts(inspected, at).IsSum is false))
IsLocal(entry InstructionEntry) Boolean
	Doubling.IsLocal(InstructionEntry.Named(InstructionType.StoreRegisterToVariable, 0, "numbers")) is false
	Doubling.IsLocal(InstructionEntry.Named(InstructionType.StoreRegisterToVariable, 0, "twice"))
	if entry.kind is not in (InstructionType.StoreRegisterToVariable, InstructionType.StoreConstantToVariable)
		return true
	let name = entry.kind is InstructionType.StoreConstantToVariable then entry.texts.Last else entry.texts.First
	let end = function.method.LoopEndOf(position)
	for function.method.instructions
		if ((index <= position) or (index >= end)) and (name is in value.texts)
			return false
	name is not in function.Parameters
IsPureCall(inspected MlirFunction, at Number, depth Number) Boolean
	Doubling.IsPureCall(Doubling.function, 4, 0)
	Randomizing.IsPureCall(Randomizing.function, 4, 0) is false
	Doubling.IsPureCall(Making, 1, 0)
	let entry = inspected.method.instructions(at)
	let decoder = PayloadDecoder(entry)
	if (TypeEntry.ShortName(decoder.Text(1)) is in UnsafeTypes) or (decoder.Text(2) is "Random")
		return false
	let callees = MlirModule(inspected.types, "").Called(inspected, at)
	if callees.Length is 0
		let returned = MlirLayout(inspected).Represented(TypeEntry.ShortName(decoder.Text(4 + entry.payload(3))))
		return returned is in ("Number", "Boolean")
	(depth < 3) and (MlirForeign(callees.First).IsForeign is false) and IsPureMethod(callees.First, depth + 1)
IsPureMethod(callee MlirFunction, depth Number) Boolean
	Doubling.IsPureMethod(MlirFunction(Doubling.function.types, MlirParallel.Rows, MlirParallel.Twice), 1)
	Doubling.IsPureMethod(MlirFunction(Doubling.function.types, MlirParallel.Rows, Checking), 1)
	if callee.method.Name is "Validated"
		return true
	for callee.method.instructions
		if IsSafe(callee, index, depth) is false
			return false
	true