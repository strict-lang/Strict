has function MlirFunction
has position Number
constant UnsafeTypes = ("File", "Directory", "Process", "Library", "Logger", "TextReader", "TextWriter", "BytesReader", "BytesWriter")
constant Branches = (InstructionType.Jump, InstructionType.JumpIfTrue, InstructionType.JumpIfFalse, InstructionType.JumpIfNotZero, InstructionType.JumpToIdIfFalse, InstructionType.JumpToIdIfTrue)
constant Unsafe = (InstructionType.Set, InstructionType.InvokeWriteToTable, InstructionType.InvokeRemove, InstructionType.Print, InstructionType.ConstructValueType, InstructionType.CopyList)
constant Doubling = MlirPurity(MlirParallel.Doubling.function, 2)
constant Randomizing = MlirPurity(MlirParallel.Randomizing.function, 2)
IsSafe(inspected MlirFunction, at Number, depth Number) Boolean
	Doubling.IsSafe(Doubling.function, 4, 0) is true
	Randomizing.IsSafe(Randomizing.function, 4, 0) is false
	let entry = inspected.method.instructions(at)
	if entry.kind is InstructionType.Invoke
		return IsPureCall(inspected, at, depth)
	if entry.kind is InstructionType.InvokeWriteToList
		return (depth is 0) and (entry.texts(0) is "forResult")
	let isLeaving = (depth is 0) and ((entry.kind is InstructionType.Return) or (entry.kind is in Branches))
	(isLeaving is false) and IsPlain(inspected, at) and ((depth > 0) or IsLocal(entry))
IsPlain(inspected MlirFunction, at Number) Boolean
	Doubling.IsPlain(Doubling.function, 3) is true
	let entry = inspected.method.instructions(at)
	let kind = entry.kind
	if kind is in Unsafe
		return false
	if kind is InstructionType.LoopBegin
		return MlirLoops(inspected, at).IsCollecting is false
	if kind is InstructionType.LoadConstantToRegister
		return PayloadDecoder(entry).Value(1).kind is not "List"
	let isBinary = (kind > InstructionType.StoreSeparator) and (kind < InstructionType.BinaryOperatorsSeparator)
	let isList = isBinary and MlirListOperators(inspected, at).IsOperation
	(isList is false) and ((isBinary is false) or (MlirTexts(inspected, at).IsSum is false))
IsLocal(entry InstructionEntry) Boolean
	Doubling.IsLocal(InstructionEntry.Named(InstructionType.StoreRegisterToVariable, 0, "numbers")) is false
	Doubling.IsLocal(InstructionEntry.Named(InstructionType.StoreRegisterToVariable, 0, "twice")) is true
	if entry.kind is not in (InstructionType.StoreRegisterToVariable, InstructionType.StoreConstantToVariable)
		return true
	let name = entry.kind is InstructionType.StoreConstantToVariable then entry.texts.Last else entry.texts.First
	let end = function.method.LoopEndOf(position)
	for function.method.instructions
		if ((index <= position) or (index >= end)) and (name is in value.texts)
			return false
	name is not in function.Parameters
IsPureCall(inspected MlirFunction, at Number, depth Number) Boolean
	Doubling.IsPureCall(Doubling.function, 4, 0) is true
	Randomizing.IsPureCall(Randomizing.function, 4, 0) is false
	let entry = inspected.method.instructions(at)
	let decoder = PayloadDecoder(entry)
	if (TypeEntry.ShortName(decoder.Text(1)) is in UnsafeTypes) or (decoder.Text(2) is "Random")
		return false
	let callees = MlirModule(inspected.types, "").Called(inspected, at)
	if callees.Length is 0
		let returned = decoder.Text(4 + entry.payload(3))
		return returned.EndsWith("Number") or returned.EndsWith("Boolean")
	(depth < 3) and (MlirForeign(callees.First).IsForeign is false) and IsPureMethod(callees.First, depth + 1)
IsPureMethod(callee MlirFunction, depth Number) Boolean
	Doubling.IsPureMethod(MlirFunction(Doubling.function.types, MlirParallel.Rows, MlirParallel.Twice), 1) is true
	for callee.method.instructions
		if IsSafe(callee, index, depth) is false
			return false
	true