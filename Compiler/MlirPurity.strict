has function MlirFunction
has position Number
constant Branches = (InstructionType.Jump, InstructionType.JumpIfTrue, InstructionType.JumpIfFalse, InstructionType.JumpIfNotZero)
constant Writes = (InstructionType.InvokeWriteToList, InstructionType.InvokeWriteToTable, InstructionType.InvokeRemove)
constant Doubling = MlirPurity(MlirParallel.Doubling.function, 2)
constant Timing = MlirPurity(MlirParallel.Timing.function, 2)
constant ValueKept = (InstructionEntry.Named(InstructionType.LoadVariableToRegister, 3, "value"), InstructionEntry.Named(InstructionType.StoreRegisterToVariable, 3, "conditional0"))
constant ElseJumped = (InstructionEntry.LoadBoolean(4, true), InstructionEntry.Binary(InstructionType.Equal, (4, 4)), InstructionEntry.Jump(InstructionType.JumpEnd, 0), InstructionEntry.Jump(InstructionType.JumpToIdIfTrue, 1))
constant ZeroKept = (InstructionEntry.LoadNumber(5, 0), InstructionEntry.Named(InstructionType.StoreRegisterToVariable, 5, "conditional0"), InstructionEntry.Jump(InstructionType.JumpEnd, 1))
constant ConditionalWritten = (InstructionEntry.Named(InstructionType.LoadVariableToRegister, 6, "conditional0"), InstructionEntry.Named(InstructionType.InvokeWriteToList, 6, "forResult"), InstructionEntry.Jump(InstructionType.LoopEnd, 16))
constant ClampedInstructions = MlirParallel.ValueLoop + MlirParallel.PositiveCheck + ValueKept + ElseJumped + ZeroKept + ConditionalWritten
constant Clamping = MlirPurity(MlirFunction(List(TypeEntry) + MlirParallel.Rows, MlirParallel.Rows, MethodEntry("Clamped", List(MemberEntry) + MlirLists.Items, "Strict/List(Number)", ClampedInstructions)), 2)
constant Making = MlirFunction(MlirLayout.Wrapping.function.types, MlirLayout.Degrees, MethodEntry("Made", List(MemberEntry), "Strict/Degrees", (InstructionEntry.LoadNumber(0, 1), MlirDeviceCalls.Making, InstructionEntry.Return(1))))
constant TextAdded = (InstructionEntry.LoadText(0, "a"), InstructionEntry.Named(InstructionType.LoadVariableToRegister, 1, "number"), InstructionEntry.Binary(InstructionType.Add, (0, 1, 2)), InstructionEntry.Return(2))
constant Checking = MethodEntry("Validated", List(MemberEntry), "Strict/Math/Pairing", TextAdded)
constant Reading = MlirPurity(MlirFunction(List(TypeEntry) + MlirParallel.Rows, MlirParallel.Rows, MlirCost.Reading), 2)
constant Filtering = MlirPurity(MlirFunction(List(TypeEntry) + MlirParallel.Rows, MlirParallel.Rows, MlirParallel.Filtered), 2)
constant Caching = MlirPurity(MlirFunction(Reading.function, method = MethodEntry("Cached", List(MemberEntry), "Strict/Number", InstructionEntry.Invoke(0, ("Strict/Runtime/ConstantCache", "Stored", "Strict/Number"), (1, 2), 0))), 0)
constant Writing = MlirFunction(Reading.function, method = MethodEntry("Writing", List(MemberEntry), "None", InstructionEntry.Invoke(0, ("Strict/File", "Write", "None", "text"), (1), 0)))
constant InnerList = MethodCodegen.StoreConstant(InstructionEntry(InstructionType.LoadConstantToRegister, "Strict/List(Number)", (0, 6, -1, 0)), "listResult1")
constant InnerListLoop = (MlirLoops.Emptied, InstructionEntry.Named(InstructionType.LoadVariableToRegister, 0, "numbers"), InstructionEntry.LoopBegin(0, -1), InnerList)
constant ValueListed = (InstructionEntry.Named(InstructionType.LoadVariableToRegister, 1, "value"), InstructionEntry.Named(InstructionType.InvokeWriteToList, 1, "listResult1"))
constant InnerListWritten = (InstructionEntry.Named(InstructionType.LoadVariableToRegister, 2, "listResult1"), InstructionEntry.Named(InstructionType.InvokeWriteToList, 2, "forResult"), InstructionEntry.Jump(InstructionType.LoopEnd, 6))
constant Pairing = MlirPurity(MlirFunction(List(TypeEntry) + MlirParallel.Rows, MlirParallel.Rows, MethodEntry("Paired", List(MemberEntry) + MlirLists.Items, "Strict/List(List(Number))", InnerListLoop + ValueListed + InnerListWritten)), 2)
constant Hosting = TypeEntry("Strict/Runtime/Hosted", List(MemberEntry), List(MethodEntry) + MethodEntry(Writing.method, Name = "Result"))
constant Written = MethodEntry(MlirParallel.Timed, instructions = MlirParallel.Timed.instructions.Slice(0, 4) + MlirParallel.Effects + Writing.method.instructions + MlirParallel.Timed.instructions.Slice(5, 2))
constant Setting = MlirFunction(Doubling.function, method = MethodEntry(Checking, instructions = List(InstructionEntry) + InstructionEntry.Set(List(Text), (1, 7))))
constant Gate = TypeEntry("Strict/Runtime/Foreign", List(MemberEntry), List(MethodEntry) + MethodEntry(Writing.method, Name = "Called"))
constant ProcessReads = ("from", "Elapsed", "MemoryUsed", "OperatingSystem", "Find", "Current", "FilesRead", "Expired", "Entered", "Left")
IsGateway Boolean
	MlirPurity(MlirFunction(List(TypeEntry) + Hosting, Hosting, Hosting.methods.First), 0).IsGateway
	MlirPurity(MlirFunction(List(TypeEntry) + Gate, Gate, Gate.methods.First), 0).IsGateway
	MlirPurity(MlirFunction(List(TypeEntry) + Hosting, Hosting, Writing.method), 0).IsGateway is false
	MlirPurity(MlirFunction(Writing, method = Hosting.methods.First), 0).IsGateway is false
	function.type.Name + "." + function.method.Name is in ("Strict/Runtime/Hosted.Result", "Strict/Runtime/Foreign.Called")
IsSafe(inspected MlirFunction, at Number, depth Number) Boolean
	Doubling.IsSafe(Doubling.function, 4, 0)
	Pairing.IsSafe(Pairing.function, 5, 0)
	Timing.IsSafe(Timing.function, 4, 0) is false
	Clamping.IsSafe(Clamping.function, 6, 0)
	Filtering.IsSafe(Filtering.function, 7, 0)
	let entry = inspected.method.instructions(at)
	if entry.kind is InstructionType.Invoke
		return IsPureCall(inspected, at, depth)
	if entry.kind is in Writes
		return depth > 0 then IsOwned(inspected, entry) else IsWritable(entry.texts(0))
	let isLeaving = (depth is 0) and ((entry.kind is InstructionType.Return) or (entry.kind is in Branches))
	(isLeaving is false) and IsPlain(inspected, at, depth) and ((depth > 0) or IsLocal(entry))
IsCollected(at Number) Boolean
	Clamping.IsCollected(17)
	Filtering.IsCollected(7) is false
	Doubling.IsCollected(5) and (Clamping.IsCollected(3) is false)
	mutable open = 0
	for Range(position + 1, at)
		let kind = function.method.instructions(value).kind
		if kind is in (InstructionType.JumpToIdIfFalse, InstructionType.JumpToIdIfTrue)
			open = open + 1
		if kind is InstructionType.JumpEnd
			open = open - 1
	(open is 0) and (function.method.instructions(at).texts(0) is "forResult")
IsPlain(inspected MlirFunction, at Number, depth Number) Boolean
	Doubling.IsPlain(Doubling.function, 3, 0)
	Doubling.IsPlain(MlirKernel.Doubling.function, 2, 1)
	Doubling.IsPlain(MlirFunction(Doubling.function.types, MlirParallel.Rows, Checking), 2, 0)
	Doubling.IsPlain(Doubling.function, 2, 1) and (Doubling.IsPlain(Doubling.function, 2, 0) is false)
	Doubling.IsPlain(MlirTexts.Joined, 3, 0)
	Doubling.IsPlain(Setting, 0, 0) is false
	Doubling.IsPlain(MlirKinds.Paired.function, 1, 0)
	let kind = inspected.method.instructions(at).kind
	if kind is not InstructionType.LoopBegin
		return kind is not InstructionType.Set
	(depth > 0) or (MlirLoops(inspected, at).IsCollecting is false)
IsOwned(inspected MlirFunction, entry InstructionEntry) Boolean
	Doubling.IsOwned(Doubling.function, InstructionEntry.Named(InstructionType.InvokeWriteToList, 1, "forResult"))
	Doubling.IsOwned(Doubling.function, InstructionEntry.Named(InstructionType.InvokeWriteToList, 1, "numbers")) is false
	Doubling.IsOwned(Doubling.function, InstructionEntry.Return(0)) is false
	Doubling.IsOwned(MlirForeign.Counting, InstructionEntry.Named(InstructionType.InvokeWriteToList, 1, "handle")) is false
	Doubling.IsOwned(MlirForeign.Counting, InstructionEntry.Named(InstructionType.InvokeWriteToList, 1, "forResult"))
	if (entry.texts.Length is 0) or (entry.texts(0) is in inspected.Parameters)
		return false
	for inspected.type.members
		if value.Name is entry.texts(0)
			return false
	true
IsLocal(entry InstructionEntry) Boolean
	Doubling.IsLocal(InstructionEntry.Named(InstructionType.StoreRegisterToVariable, 0, "numbers")) is false
	Doubling.IsLocal(InstructionEntry.Named(InstructionType.StoreRegisterToVariable, 0, "twice"))
	Doubling.IsLocal(InstructionEntry.Named(InstructionType.StoreRegisterToVariable, 0, "numbers(index)")) is false
	Clamping.IsLocal(InstructionEntry.Named(InstructionType.StoreRegisterToVariable, 0, "conditional0"))
	if entry.kind is not in (InstructionType.StoreRegisterToVariable, InstructionType.StoreConstantToVariable)
		return true
	let name = entry.texts.Last.Split("(").First
	let end = function.method.LoopEndOf(position)
	for function.method.instructions
		if ((index <= position) or (index >= end)) and (name is in value.texts)
			return false
	name is not in function.Parameters
IsWritable(name Text) Boolean
	Pairing.IsWritable("listResult1")
	Pairing.IsWritable("numbers") is false
	Doubling.IsSafe(Making, 2, 1) and (Doubling.IsSafe(Making, 2, 0) is false)
	Doubling.IsSafe(Doubling.function, 0, 1) and (Doubling.IsSafe(Doubling.function, 0, 0) is false)
	Doubling.IsSafe(Doubling.function, 2, 1) and (Doubling.IsSafe(Doubling.function, 2, 0) is false)
	Doubling.IsSafe(MlirTexts.Joined, 3, 1)
	Doubling.IsLocal(InstructionEntry.Return(0))
	Clamping.IsLocal(MethodCodegen.StoreConstant(InstructionEntry.Print("conditional0"), "forResult")) is false
	Doubling.IsIntrinsic(Doubling.function, 4) is false
	(name is "forResult") or IsLocal(InstructionEntry.Named(InstructionType.StoreRegisterToVariable, 0, name))
IsPureCall(inspected MlirFunction, at Number, depth Number) Boolean
	Doubling.IsPureCall(Doubling.function, 4, 0)
	Timing.IsPureCall(Timing.function, 4, 0) is false
	Reading.IsPureCall(Reading.function, 4, 0)
	Doubling.IsPureCall(Making, 1, 0)
	Doubling.IsPureCall(MlirFunction(Doubling.function, safeCalls = Dictionary(("Rows_Twice_1", 0))), 4, 0) is false
	let callees = MlirModule(inspected.types, "").Called(inspected, at)
	if IsAllowed(inspected, at, callees) is false
		return false
	if callees.Length is 0
		return IsIntrinsic(inspected, at)
	IsKnown(callees.First, inspected, depth)
IsAllowed(inspected MlirFunction, at Number, callees List(MlirFunction)) Boolean
	Caching.IsAllowed(Caching.function, 0, List(MlirFunction))
	Timing.IsAllowed(Timing.function, 4, List(MlirFunction)) is false
	Reading.IsAllowed(Reading.function, 4, List(MlirFunction))
	Reading.IsAllowed(Writing, 0, List(MlirFunction)) is false
	Doubling.IsExternalSafe("File", "Write") is false
	Doubling.IsExternalSafe("Directory", "Delete") is false
	Doubling.IsExternalSafe("Process", "RunTools") is false
	Doubling.IsExternalSafe("TestBudget", "Expired")
	Doubling.IsExternalSafe("TestBudget", "Started") is false
	let decoder = PayloadDecoder(inspected.method.instructions(at))
	let isNever = IsExternalSafe(TypeEntry.ShortName(decoder.Text(1)), decoder.Text(2)) is false
	(isNever is false) and ((callees.Length is 0) or (MlirForeign(callees.First).IsForeign is false))
IsExternalSafe(kind Text, method Text) Boolean
	Doubling.IsExternalSafe("File", "ReadLines") and Doubling.IsExternalSafe("TestBudget", "Entered")
	Doubling.IsExternalSafe("File", "from") and Doubling.IsExternalSafe("Number", "Random")
	if kind is "File"
		return method is in ("from", "Exists", "Modified", "Length", "ReadLines", "ReadBytes")
	if kind is "Directory"
		return method is in ("from", "Files", "Directories", "Exists", "Current", "Modified")
	if kind is in ("Process", "TestBudget")
		return method is in ProcessReads
	if kind is in Hosted.Kinds then kind + "." + method is in Hosted.Methods else false
		return kind is in ("Number", "Degrees", "Ratio", "Vector2", "ConstantCache", "TestBudget")
	constant Never = ("Library", "TextReader", "TextWriter", "BytesReader", "BytesWriter", "GpuMemory")
	(kind is not in Never) and (method is not "Random")
IsIntrinsic(inspected MlirFunction, at Number) Boolean
	Doubling.IsIntrinsic(Making, 1)
	Reading.IsIntrinsic(Reading.function, 4)
	Doubling.IsIntrinsic(MlirTexts.Joined, 7)
	let entry = inspected.method.instructions(at)
	let decoder = PayloadDecoder(entry)
	let type = inspected.TypeOf(decoder.Text(1))
	let isConstructor = (decoder.Text(2) is "from") and (type.members.Length > 0)
	let helper = MlirCalls(inspected, at).NativeHelper(entry, decoder)
	if MlirTexts(inspected, at).IsConversion
		return true
	isConstructor or (helper is not "")
IsKnown(callee MlirFunction, inspected MlirFunction, depth Number) Boolean
	Doubling.IsKnown(MlirFunction(Doubling.function.types, MlirParallel.Rows, MlirParallel.Twice), Doubling.function, 0)
	Doubling.IsKnown(Timing.function, Doubling.function, 0) is false
	Doubling.IsKnown(Making, Doubling.function, 2) and (Doubling.IsKnown(Making, Doubling.function, 3) is false)
	Doubling.IsKnown(Making, MlirFunction(Making, safeCalls = Dictionary(("Degrees_Made_0", 0))), 0) is false
	Doubling.IsKnown(Timing.function, MlirFunction(Making, safeCalls = Dictionary(("Rows_Timed_1", 1))), 0)
	Doubling.IsKnown(MlirFunction(List(TypeEntry) + Hosting, Hosting, Hosting.methods.First), Doubling.function, 0)
	Doubling.IsAllowed(Doubling.function, 4, List(MlirFunction) + MlirForeign.Adder) is false
	Doubling.IsAllowed(Doubling.function, 4, List(MlirFunction) + Making)
	Doubling.IsExternalSafe("Number", "Logarithm") and (Doubling.IsExternalSafe("Time", "Now") is false)
	if callee.Symbol is in inspected.safeCalls
		return inspected.safeCalls(callee.Symbol) is 1
	MlirPurity(callee, 0).IsGateway or ((depth < 3) and IsPureMethod(callee, depth + 1))
IsPureMethod(callee MlirFunction, depth Number) Boolean
	Doubling.IsPureMethod(MlirFunction(Doubling.function.types, MlirParallel.Rows, MlirParallel.Twice), 1)
	Doubling.IsPureMethod(MlirFunction(Doubling.function.types, MlirParallel.Rows, Checking), 1)
	Doubling.IsPureMethod(MlirFunction(Doubling.function.types, MlirParallel.Rows, MlirParallel.Doubled), 1)
	Reading.IsPureMethod(MlirFunction(Writing, method = MethodEntry(Writing.method, Name = "Validated")), 1) is false
	Doubling.IsExternalSafe("Process", "Elapsed") and (Doubling.IsExternalSafe("Library", "Load") is false)
	Doubling.IsExternalSafe("Text", "Length") and (Doubling.IsExternalSafe("Text", "Random") is false)
	for callee.method.instructions
		if IsSafe(callee, index, depth) is false
			return false
	true
IsSteady Boolean
	MlirPurity(MlirLoops.Listing.function, 1).IsSteady
	MlirPurity(MlirKernel.Calling.function, 1).IsSteady is false
	MlirPurity(MlirLoops.Collecting.function, 1).IsSteady
	MlirPurity(MlirKernel.Calling.function, 1).IsChanging(3) is false
	MlirPurity(MlirLoops.Assigning.function, 1).IsSteady is false
	MlirPurity(MlirLoops.Assigning.function, 1).IsChanging(3)
	for Range(position + 1, function.method.LoopEndOf(position))
		if IsChanging(value)
			return false
	true
IsChanging(at Number) Boolean
	MlirPurity(MlirLoops.Collecting.function, 1).IsChanging(2) is false
	MlirPurity(MlirKernel.Calling.function, 1).IsChanging(2)
	let entry = function.method.instructions(at)
	if entry.kind is InstructionType.StoreRegisterToVariable
		return entry.texts(0).IndexOf("(") > 0
	if entry.kind is in Writes
		return (entry.texts.Length is 0) or (entry.texts(0) is not "forResult")
	if entry.kind is not in MlirListOperators.Operators
		return entry.kind is in (InstructionType.Invoke, InstructionType.Set)
	MlirListOperators(function, at).IsOperation
