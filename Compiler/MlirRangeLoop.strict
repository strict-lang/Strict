has function MlirFunction
has position Number
constant Ranging = MlirRangeLoop(MlirLoops.Ranging.function, 3)
constant Flags = " fastmath<reassoc,nsz,contract>"
Slots Texts
	MlirRangeLoop(MlirFunction.Counter, 0).Slots is MlirFunction.Counter.Slot("%loop0")
	Ranging.Slots.First.IndexOf("x i32") > 0
	MlirRangeLoop(MlirLoops.Spelling.function, 3).Slots.Last is "    llvm.store %zero, %spelled3 : f64, !llvm.ptr"
	MlirRangeLoop(MlirBytes.Flattening.function, 2).Slots.Last is MlirBytes.Flattening.Buffer.First
	name = "%loop" + position
	spelled = MlirLoops(function, position).IsSpelling then function.Slot("%spelled" + position) else List(Text)
	if function.method.instructions(position).payload(1) is not 1
		return function.Slot(name) + spelled + MlirBytes(function, position).Buffer
	inner = "    " + name + " = llvm.alloca %one x i32 : (i64) -> !llvm.ptr"
	left = "    %left" + position + " = llvm.alloca %one x i64 : (i64) -> !llvm.ptr"
	base = "    %base" + position + " = llvm.alloca %one x f64 : (i64) -> !llvm.ptr"
	(inner, left, base, "    %chunk" + position + " = llvm.alloca %one x i32 : (i64) -> !llvm.ptr") + spelled
IsRanged Boolean
	MlirRangeLoop(MlirStatements.Copy.function, 0).IsRanged is false
	MlirRangeLoop(Ranging.function, 4).IsRanged
	begin = function.method.LoopBeginOf(position)
	opened = function.method.instructions(begin)
	covers = function.method.LoopEndOf(begin) >= position
	opened.kind is InstructionType.LoopBegin and covers and opened.payload(1) is 1
Open(label Text) Texts
	Text.Combine(MlirRangeLoop(MlirLoops.Counting.function, 0).Open("^loop0")).IndexOf("cmpf olt") > 0
	Text.Combine(Ranging.Open("^loop3")).IndexOf("i32") > 0
	function.method.instructions(position).payload(1) is 1 then Chunk(label) else Head(label, false, "f64")
Chunk(label Text) Texts
	Text.Combine(Ranging.Chunk("^loop3")).IndexOf("2147483647") > 0
	cap = "    " + Temp("mx") + " = arith.constant 2147483647 : i64"
	zero = "    " + Temp("iz") + " = arith.constant 0 : i32"
	raw = "    " + Temp("bi") + " = arith.fptosi " + Temp("b") + " : f64 to i64"
	whole = "    " + Temp("bf") + " = arith.sitofp " + Temp("bi") + " : i64 to f64"
	trip = "    llvm.store " + Temp("ni") + ", %left" + position + " : i64, !llvm.ptr"
	base = "    llvm.store " + Temp("bf") + ", %base" + position + " : f64, !llvm.ptr"
	(Limit, cap, zero, raw, whole, trip, base) + Outer(label)
Outer(label Text) Texts
	zero = "    " + Temp("z6") + " = arith.constant 0 : i64"
	left = "    " + Temp("lf") + " = llvm.load %left" + position + " : !llvm.ptr -> i64"
	more = "    " + Temp("mo") + " = arith.cmpi sgt, " + Temp("lf") + ", " + Temp("z6") + " : i64"
	branch = "    cf.cond_br " + Temp("mo") + ", " + label + "pre, " + label + "exit"
	open = ("    cf.br " + label + "outer", "  " + label + "outer:", zero, left, more, branch)
	open + ("  " + label + "pre:") + Slice(label)
Slice(label Text) Texts
	fit = "    " + Temp("ft") + " = arith.cmpi slt, " + Temp("lf") + ", " + Temp("mx") + " : i64"
	wide = "    " + Temp("c6") + " = arith.select " + Temp("ft") + ", " + Temp("lf") + ", " + Temp("mx") + " : i64"
	narrow = "    " + Temp("ch") + " = arith.trunci " + Temp("c6") + " : i64 to i32"
	kept = "    llvm.store " + Temp("ch") + ", %chunk" + position + " : i32, !llvm.ptr"
	reset = "    llvm.store " + Temp("iz") + ", %loop" + position + " : i32, !llvm.ptr"
	enter = "    cf.br " + label
	load = "    " + Temp("k") + " = llvm.load %loop" + position + " : !llvm.ptr -> i32"
	step = "    " + Temp("ck") + " = llvm.load %chunk" + position + " : !llvm.ptr -> i32"
	check = "    " + Temp("m") + " = arith.cmpi slt, " + Temp("k") + ", " + Temp("ck") + " : i32"
	branch = "    cf.cond_br " + Temp("m") + ", " + label + "body, " + label + "lat"
	(fit, wide, narrow, kept, reset, enter, "  " + label + ":", load, step, check, branch, "  " + label + "body:")
Head(label Text, isRange Boolean, kind Text) Texts
	Ranging.Head("^a", true, "i64").Length is 7
	Ranging.Head("^a", false, "f64")(4) is "    %t3m = arith.cmpf olt, %t3k, %t3n : f64"
	zero = isRange then Temp("iz") else "%zero"
	limit = isRange then Temp("ni") else Temp("n")
	math = isRange then "cmpi slt" else "cmpf olt"
	stored = "    llvm.store " + zero + ", %loop" + position + " : " + kind + ", !llvm.ptr"
	load = "    " + Temp("k") + " = llvm.load %loop" + position + " : !llvm.ptr -> " + kind
	check = "    " + Temp("m") + " = arith." + math + ", " + Temp("k") + ", " + limit + " : " + kind
	branch = "    cf.cond_br " + Temp("m") + ", " + label + "body, " + label + "exit"
	(stored, "    cf.br " + label, "  " + label + ":") + (load, check, branch, "  " + label + "body:")
Value Texts
	Text.Combine(Ranging.Value).IndexOf("arith.sitofp") > 0
	cast = "    " + Temp("kf") + " = arith.sitofp " + Temp("k") + " : i32 to f64"
	base = "    " + Temp("bv") + " = llvm.load %base" + position + " : !llvm.ptr -> f64"
	off = "    " + Temp("of") + " = arith.mulf " + Temp("kf") + ", " + Temp("s") + Flags + " : f64"
	sum = "    " + Temp("c") + " = arith.addf " + Temp("bv") + ", " + Temp("of") + Flags + " : f64"
	(cast, base, off, sum, function.Store(Temp("c"), "%v_index")) + function.Store(Temp("c"), "%v_value")
Close(begin Number) Texts
	loop = "%loop" + begin
	load = "    " + Temp("k") + " = llvm.load " + loop + " : !llvm.ptr -> i32"
	one = "    " + Temp("u") + " = arith.constant 1 : i32"
	next = "    " + Temp("w") + " = arith.addi " + Temp("k") + ", " + Temp("u") + " : i32"
	store = "    llvm.store " + Temp("w") + ", " + loop + " : i32, !llvm.ptr"
	MlirLoops(function, position).Step((load, one, next, store), begin) + Latch(begin)
Latch(begin Number) Texts
	label = "^loop" + begin
	moved = Advance(begin)
	back = List(Text) + ("    cf.br " + label + "outer")
	(List(Text) + ("  " + label + "lat:")) + moved + back
Advance(begin Number) Texts
	chunk = "    " + Temp("ch") + " = llvm.load %chunk" + begin + " : !llvm.ptr -> i32"
	cast = "    " + Temp("cf") + " = arith.sitofp " + Temp("ch") + " : i32 to f64"
	adv = "    " + Temp("ad") + " = arith.mulf " + Temp("cf") + ", %t" + begin + "s" + Flags + " : f64"
	base = "    " + Temp("bs") + " = llvm.load %base" + begin + " : !llvm.ptr -> f64"
	sum = "    " + Temp("nb") + " = arith.addf " + Temp("bs") + ", " + Temp("ad") + Flags + " : f64"
	save = "    llvm.store " + Temp("nb") + ", %base" + begin + " : f64, !llvm.ptr"
	wide = "    " + Temp("cz") + " = arith.extsi " + Temp("ch") + " : i32 to i64"
	left = "    " + Temp("lf") + " = llvm.load %left" + begin + " : !llvm.ptr -> i64"
	sub = "    " + Temp("nl") + " = arith.subi " + Temp("lf") + ", " + Temp("cz") + " : i64"
	keep = "    llvm.store " + Temp("nl") + ", %left" + begin + " : i64, !llvm.ptr"
	(chunk, cast, adv, base, sum, save, wide, left, sub, keep)
Limit Text
	Ranging.Limit is "    %t3ni = arith.fptosi %t3n : f64 to i64"
	"    " + Temp("ni") + " = arith.fptosi " + Temp("n") + " : f64 to i64"
Temp(suffix Text) Text
	Ranging.Temp("k") is "%t3k"
	"%t" + position + suffix
Finish(begin Number) Texts
	exit = List(Text) + ("  ^loop" + begin + "exit:")
	restore = (function.Store("%t" + begin + "x", "%v_index"), function.Store("%t" + begin + "y", "%v_value"))
	exit + restore + MlirLoops(function, begin).Restore(begin) + MlirKernel(function, begin).Joined
