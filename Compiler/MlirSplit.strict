has lines Texts
constant Internal = "llvm.linkage = #llvm.linkage<internal>"
constant Hidden = "  llvm.mlir.global internal "
constant Visible = "  llvm.mlir.global "
constant Tricky = "  llvm.mlir.global internal @k(\" constant thread_local \") : f64"
constant Passes = " --symbol-dce --convert-scf-to-cf --convert-arith-to-llvm --convert-func-to-llvm --convert-cf-to-llvm --reconcile-unrealized-casts"
constant Translating = " --mlir-disable-threading --mlir-to-llvmir "
constant Single = Passes + " --mlir-disable-threading -o \""
constant SampleHeader = ("module {", "  llvm.func @printf(!llvm.ptr, ...) -> i32", "  llvm.mlir.global internal constant @t(\"a\\00\") : !llvm.array<2 x i8>")
constant CallingFunction = ("  func.func private @A() -> f64 attributes {llvm.linkage = #llvm.linkage<internal>} {", "    %r = func.call @B() : () -> f64", "    return %r : f64", "  }")
constant CalledFunction = ("  func.func private @B(%p0: f64) -> f64 {", "    return %p0 : f64", "  }", "}")
constant Sample = MlirSplit(SampleHeader + CallingFunction + CalledFunction)
constant Linking = MlirSplit(("  llvm.linker_options [\"a\"]"))
constant RuntimeParts = 8
constant Common = Sample.Shared
constant Placing = Sample.Placed(Common)
constant LinkerOptions = "  llvm.linker_options"
constant Nowhere = -1
Starts Numbers
	Sample.Starts is (3, 7)
	MlirSplit(("  llvm.func @a() {")).Starts is (0)
	for lines
		if (value.EndsWith("{") and (value.StartsWith("  func.func ") or value.StartsWith("  llvm.func ")))
			index
Declarations(starts Numbers) Texts
	Sample.Declarations(Sample.Starts) is ("  func.func private @A() -> f64", "  func.func private @B(f64) -> f64")
	for starts
		Declared(lines(value))
Name(line Text) Text
	Sample.Name(Tricky) is "k"
	Sample.Name(Sample.lines(3)) is "A"
	let at = line.IndexOf("@")
	line.Substring(at + 1, line.IndexOf("(", at) - at - 1)
Typed(name Text) Text
	Sample.Typed("Xor_Run_0") is "Xor"
	Sample.Typed("lXor_Run_0_1") is "Xor"
	Sample.Typed("List_Number__First_0") is "List"
	Sample.Typed("dp0") is "p0"
	Sample.Typed("__stack_low") is "__stack_low"
	Sample.Typed("t") is "t"
	let type = name.Split("_").First
	if type.Length < 2
		return name
	type(0).Lower is type(0) then type.Substring(1, type.Length - 1) else type
Owner(line Text) Number
	Sample.Owner("  func.func @strict_new() {") < RuntimeParts
	Sample.Owner("  llvm.func @strict_new(%a: i64) {") is Sample.Owner("  func.func @strict_new() {")
	Sample.Owner("  func.func @Xor_Run_0() {") is RuntimeParts + HashCode("Xor").number % (Toolchain.Parts - RuntimeParts)
	Sample.Owner("  func.func @Xor_Run_0() {") is Sample.Owner("  llvm.mlir.global constant @lXor_Run_0_1(\"a\") : x")
	let name = Name(line)
	if name.StartsWith("strict_")
		return HashCode(name).number % RuntimeParts
	RuntimeParts + HashCode(Typed(name)).number % (Toolchain.Parts - RuntimeParts)
Shared Texts
	Sample.Shared.Length is 2
	Sample.Shared.First is "  llvm.func @printf(!llvm.ptr, ...) -> i32"
	Linking.Shared is Linking.lines
	MlirSplit(("  func.func private @x()")).Shared.Length is 1
	for lines
		if value.StartsWith(Visible) or value.StartsWith(LinkerOptions)
			value
		else if (value.StartsWith("  llvm.func ") or value.StartsWith("  func.func ")) and (value.EndsWith("{") is false)
			value
Placed(shared Texts) Numbers
	Placing is (Nowhere, Sample.Owner(Sample.lines(2)))
	Linking.Placed(Linking.lines) is (0)
	for shared
		value.StartsWith(Visible) then Owner(value) else value.StartsWith(LinkerOptions) then 0 else Nowhere
Data(part Number, shared Texts, placed Numbers) Texts
	Sample.Data(Placing.Last, Common, Placing) is ("  llvm.mlir.global constant @t(\"a\\00\") : !llvm.array<2 x i8>")
	Linking.Data(0, Linking.lines, (0)) is Linking.lines
	Linking.Data(1, Linking.lines, (0)).Length is 0
	for shared
		if placed(index) is part
			Global(value, true)
Externals(part Number, shared Texts, placed Numbers) Texts
	Sample.Externals(Placing.Last, Common, Placing) is ("  llvm.func @printf(!llvm.ptr, ...) -> i32")
	Sample.Externals(Placing.Last + 1, Common, Placing).Last.EndsWith(" external constant @t() : !llvm.array<2 x i8>")
	Linking.Externals(1, Linking.lines, (0)).Length is 0
	for shared
		if placed(index) is Nowhere
			value
		else if value.StartsWith(Visible) and (placed(index) is not part)
			Global(value, false)
Others(declarations Texts, owners Numbers, part Number) Texts
	Sample.Others(Sample.Declarations(Sample.Starts), (0, 1), 0) is ("  func.func private @B(f64) -> f64")
	for declarations
		if owners(index) is not part
			value
Owned(starts Numbers, owners Numbers, part Number) Texts
	Sample.Owned(Sample.Starts, (0, 1), 0).First is "  func.func @A() -> f64 {"
	Sample.Owned(Sample.Starts, (0, 1), 0).Last is "  }"
	Sample.Owned(Sample.Starts, (0, 1), 0).Length is 4
	mutable owned = List(Text)
	for starts
		if owners(index) is part
			owned = owned + Public(lines(value)) + Body(value + 1)
	owned
Body(start Number) Texts
	Sample.Body(4) is ("    %r = func.call @B() : () -> f64", "    return %r : f64", "  }")
	mutable body = List(Text)
	for Range(start, lines.Length)
		body = body + lines(value)
		if lines(value) is "  }"
			return body
	body
Public(header Text) Text
	Sample.Public(Sample.lines(3)) is "  func.func @A() -> f64 {"
	Sample.Public("  func.func @B() attributes {" + Internal + ", a} {") is "  func.func @B() attributes {a} {"
	Sample.Public("  func.func @B() attributes {a, " + Internal + "} {") is "  func.func @B() attributes {a} {"
	Sample.Public("  llvm.func internal @l() {") is "  llvm.func @l() {"
	let unlinked = header.Replace(" attributes {" + Internal + "}", "").Replace(Internal + ", ", "")
	let plain = unlinked.Replace(", " + Internal, "")
	plain.Replace("  func.func private @", "  func.func @").Replace("  llvm.func internal @", "  llvm.func @")
Declared(header Text) Text
	Sample.Declared("  llvm.func @l(%s: !llvm.ptr, %n: i64) attributes {a} {") is "  llvm.func @l(!llvm.ptr, i64)"
	Sample.Declared("  func.func private @F(%f: (i64) -> f64) -> (f64, i1) {").EndsWith("@F((i64) -> f64) -> (f64, i1)")
	let open = header.IndexOf("(")
	let close = Closing(header, open)
	let kind = header.StartsWith("  func.func ") then "  func.func private " else "  llvm.func "
	let name = header.Substring(header.IndexOf("@"), open - header.IndexOf("@"))
	let arguments = Text.Combine(Types(header.Substring(open + 1, close - open - 1)), ", ")
	kind + name + "(" + arguments + ")" + Results(header.Substring(close + 1, header.Length - close - 1))
Closing(text Text, open Number) Number
	Sample.Closing("f((a) b) c", 1) is 7
	mutable depth = 0
	for Range(open, text.Length)
		depth = text(value) is "(" then depth + 1 else text(value) is ")" then depth - 1 else depth
		if depth is 0
			return value
	text.Length
Types(arguments Text) Texts
	Sample.Types("%a: f64, %b: !llvm.struct<(f64, i64)>") is ("f64", "!llvm.struct<(f64, i64)>")
	Sample.Types("") is List(Text)
	for (arguments is "" then List(Text) else arguments.Split(", %"))
		value.Substring(value.IndexOf(": ") + 2, value.Length - value.IndexOf(": ") - 2)
Results(rest Text) Text
	Sample.Results(" -> f64 attributes {a} {") is " -> f64"
	Sample.Results(" {") is ""
	Sample.Results(" attributes {a} {") is ""
	let ending = rest.IndexOf(" attributes {") >= 0 then rest.IndexOf(" attributes {") else rest.Length - 2
	rest.Substring(0, ending)
Global(line Text, isOwned Boolean) Text
	Sample.Global(Tricky, false).EndsWith("external @k() : f64")
	Sample.Global("  llvm.mlir.global constant @t(0) : x", true) is "  llvm.mlir.global constant @t(0) : x"
	Sample.Global("  llvm.mlir.global internal @k(\" internal \")", true) is "  llvm.mlir.global @k(\" internal \")"
	Sample.Global("  llvm.mlir.global internal thread_local @d(0 : i64) : i64", false).EndsWith(" thread_local @d() : i64")
	if isOwned
		return line.StartsWith(Hidden) then Visible + line.Substring(Hidden.Length, line.Length - Hidden.Length) else line
	let flags = line.Substring(0, line.IndexOf("@"))
	let name = line.Substring(flags.Length, line.IndexOf("(", flags.Length) - flags.Length)
	let fixed = flags.IndexOf(" constant ") > 0 then "constant " else ""
	let local = flags.IndexOf(" thread_local ") > 0 then "thread_local " else ""
	let type = line.Substring(line.LastIndexOf(" : ") + 3, line.Length - line.LastIndexOf(" : ") - 3)
	"  llvm.mlir.global external " + fixed + local + name + "() : " + type
