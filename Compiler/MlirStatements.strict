has function MlirFunction
has position Number
constant CopyInstructions = (InstructionEntry.LoadNumber(0, 7), InstructionEntry.Named(InstructionType.StoreRegisterToVariable, 0, "a"), InstructionEntry.Return(0))
constant Copy = MlirStatements(MlirFunction(List(TypeEntry), MlirFunction.Shape, MethodEntry("Run", List(MemberEntry), "None", CopyInstructions)), 0)
constant Summing = MlirStatements(MlirFastLoop.Summing.function, 5)
constant Reassociated = " fastmath<reassoc,contract>"
constant ListKinds = (InstructionType.IndexCall, InstructionType.InvokeWriteToList, InstructionType.CopyList, InstructionType.InvokeRemove)
constant Exact = "    %t0c = arith.select %x0v, %x0i, %t0f : i1"
constant LoadingBranch = (InstructionEntry.Named(InstructionType.LoadVariableToRegister, 1, "a"), InstructionEntry.Jump(InstructionType.JumpToIdIfTrue, 1))
constant LoadingEnds = (InstructionEntry.Jump(InstructionType.JumpEnd, 0), InstructionEntry.Jump(InstructionType.JumpEnd, 1), InstructionEntry.Return(1))
constant Loading = MlirStatements(MlirFunction(List(TypeEntry), MlirFunction.Shape, MethodEntry("Run", List(MemberEntry), "None", LoadingBranch + LoadingEnds)), 0)
constant Branched = ("    %t1 = llvm.load %flag : !llvm.ptr -> i1", "    cf.cond_br %t1, ^bb3, ^bb2")
constant Returning = ("    %t0 = llvm.load %r1 : !llvm.ptr -> f64", "    return %t0 : f64")
constant Operands = ("    %t0a = llvm.load %r0 : !llvm.ptr -> f64", "    %t0b = llvm.load %r1 : !llvm.ptr -> f64")
constant Added = Operands + ("    %t0c = arith.addf %t0a, %t0b : f64", "    llvm.store %t0c, %r2 : f64, !llvm.ptr")
constant Equaled = Operands + ("    %t0c = arith.cmpf oeq, %t0a, %t0b : f64", "    llvm.store %t0c, %flag : i1, !llvm.ptr", "    %t0d = arith.uitofp %t0c : i1 to f64", "    llvm.store %t0d, %r2 : f64, !llvm.ptr")
Emitted Texts
	Copy.Emitted.Last is "    llvm.store %t0c, %r0 : f64, !llvm.ptr"
	let entry = function.method.instructions(position)
	let kind = entry.kind
	if kind is InstructionType.LoadConstantToRegister
		return Literal(PayloadDecoder(entry).Value(1), "%r" + entry.payload(0), "")
	if kind is InstructionType.StoreConstantToVariable
		return Literal(PayloadDecoder(entry).Value(0), "%v_" + entry.texts.Last, "")
	if kind is InstructionType.LoadVariableToRegister
		return function.Copied("%v_" + entry.texts(0), "%r" + entry.payload(0), Temp(""))
	if kind is InstructionType.StoreRegisterToVariable
		return MlirOwned(function, position).Stored(entry)
	kind is InstructionType.Return then Returned(entry) else Jumped(entry)
Binary(entry InstructionEntry) Texts
	Copy.Binary(InstructionEntry.Binary(InstructionType.Add, (0, 1, 2))).Length is 4
	if MlirTexts(function, position).IsSum
		return MlirTexts(function, position).Concatenated(entry)
	let operators = MlirListOperators(function, position)
	operators.IsOperation then operators.Operated(entry) else Calculated(entry)
Temp(suffix Text) Text
	Copy.Temp("c") is "%t0c"
	Loading.Emitted is ("    %t0 = llvm.load %v_a : !llvm.ptr -> f64", "    llvm.store %t0, %r1 : f64, !llvm.ptr")
	MlirStatements(Loading.function, 1).Emitted is Branched
	MlirStatements(Copy.function, 2).Emitted.Last is "    return %t2 : f64"
	"%t" + position + suffix
Literal(literal Runtime/VmValue, slot Text, suffix Text, named = "") Texts
	Copy.Literal(VmValue.OfNumber(1), "%r0", "").First is "    %t0c = arith.constant 0x3FF0000000000000 : f64"
	Copy.Literal(VmValue.OfText("b"), "%s", "d0", "@dA_b").First.IndexOf(" @dA_b ") > 0
	if literal.kind is "Text"
		return MlirConstants(function, position, named).Literal(literal.text, slot, suffix)
	if literal.kind is "List"
		return MlirLists(function, position, named).Literal(literal, slot, suffix)
	if literal.kind is not in ("Number", "Boolean", "None")
		return List(Text) + Unsupported(literal.kind + " constant")
	let number = "    " + Temp(suffix + "c") + " = arith.constant " + Hex(literal.number) + " : f64"
	(number, function.Store(Temp(suffix + "c"), slot))
Hex(number Number) Text
	Copy.Hex(-2) is "0xC000000000000000"
	let bytes = ByteEncoder.Empty.Double(number).bytes
	mutable result = "0x"
	for 8
		result = result + MetalValue("").Hex(bytes(7 - index), 2)
	result
Returned(entry InstructionEntry) Texts
	MlirStatements(Copy.function, 2).Returned(InstructionEntry.Return(0)).Last is "    return %t2 : f64"
	Text.Combine(MlirStatements(MlirChecks.Presenting, 2).Returned(InstructionEntry.Return(0))).IndexOf("frame_ended") > 0
	Text.Combine(MlirStatements(MlirDying.Dropping.function, 10).Returned(MlirDying.Dropped)).IndexOf("rc_dead(%t10d0") > 0
	Copy.Returned(InstructionEntry.Return(1)) is Returning
	if MlirLayout(function).IsInitializer
		return MlirChanged(function, position).Kept + MlirLayout(function).Returned(position)
	let dying = MlirDying(function, position).Returned(entry)
	let loaded = (List(Text) + function.Load(Temp(""), "%r" + entry.payload(0))) + dying
	MlirChanged(function, position).Kept + loaded + MlirLines(function).Framed + ("    return " + Temp("") + " : f64")
Jumped(entry InstructionEntry) Texts
	Copy.Jumped(InstructionEntry.Jump(InstructionType.JumpEnd, 0)).Length is 0
	if entry.kind is InstructionType.JumpEnd
		return List(Text)
	if entry.kind is InstructionType.CheckError
		return MlirChecks(function, position).Emitted
	if entry.kind is not in (InstructionType.JumpToIdIfFalse, InstructionType.JumpToIdIfTrue)
		return List(Text) + Unsupported("instruction kind " + entry.kind)
	let target = "^bb" + JumpEnd(PayloadDecoder(entry).SevenBit(0))
	let next = "^bb" + (position + 1)
	let branches = entry.kind is InstructionType.JumpToIdIfTrue then target + ", " + next else next + ", " + target
	("    " + Temp("") + " = llvm.load %flag : !llvm.ptr -> i1", "    cf.cond_br " + Temp("") + ", " + branches)
JumpEnd(id Number) Number
	Copy.JumpEnd(5) is 3
	Loading.JumpEnd(1) is 3
	Loading.JumpEnd(0) is 2
	for function.method.instructions
		if (value.kind is InstructionType.JumpEnd) and (PayloadDecoder(value).SevenBit(0) is id)
			return index
	function.method.instructions.Length
Unsupported(what Text) Text
	Copy.Unsupported("List") is "unsupported: List in Shape_Run_0"
	Copy.Jumped(InstructionEntry.Return(0)).First is Copy.Unsupported("instruction kind " + InstructionType.Return)
	Copy.Jumped(InstructionEntry.Jump(InstructionType.JumpToIdIfFalse, 1)).Last is "    cf.cond_br %t0, ^bb1, ^bb3"
	"unsupported: " + what + " in " + function.Symbol
Calculated(entry InstructionEntry) Texts
	Copy.Calculated(InstructionEntry.Binary(InstructionType.Add, (0, 1, 2))).Length is 4
	Copy.Calculated(InstructionEntry.Binary(InstructionType.Add, (0, 1, 2))) is Added
	Copy.Calculated(InstructionEntry.Binary(InstructionType.Equal, (0, 1, 2))) is Equaled
	constant left = Temp("a")
	constant right = Temp("b")
	let loads = (function.Load(left, "%r" + entry.payload(1)), function.Load(right, "%r" + entry.payload(2)))
	if MlirEquality(function, position).Handles(entry)
		return MlirEquality(function, position).Compared(entry)
	if entry.kind > InstructionType.ArithmeticSeparator
		return loads + Compared(entry, left + ", " + right)
	loads + Operated(entry.kind, left, right) + function.Store(Temp("c"), "%r" + entry.payload(3))
Operated(kind Number, left Text, right Text) Text
	Copy.Operated(InstructionType.Modulo, "%a", "%b").IndexOf("@strict_remainder(%a, %b)") > 0
	Copy.Operated(InstructionType.Add, "%a", "%b") is "    %t0c = arith.addf %a, %b : f64"
	Summing.Operated(InstructionType.Add, "%a", "%b") is "    %t5c = arith.addf %a, %b fastmath<reassoc,contract> : f64"
	MlirStatements(MlirFastLoop.Doubling.function, 6).Operated(InstructionType.Add, "%a", "%b").IndexOf("fastmath") is -1
	Copy.Operated(InstructionType.Power, "%a", "%b").IndexOf("@strict_power(%a, %b)") > 0
	MlirStatements(MlirFastLoop.Doubling.function, 6).Operated(InstructionType.Power, "%a", "%b").IndexOf("intr.pow(") > 0
	let result = "    " + Temp("c") + " = "
	if kind is in (InstructionType.Power, InstructionType.Modulo)
		return result + Called(kind) + "(" + left + ", " + right + ") : (f64, f64) -> f64"
	let isSum = MlirFastLoop(function, function.FastLoop).IsAccumulated(position)
	let flags = isSum then Reassociated else (MlirRangeLoop(function, position).IsRanged then MlirRangeLoop.Flags else "")
	result + "arith." + Operation(kind) + " " + left + ", " + right + flags + " : f64"
Called(kind Number) Text
	Copy.Called(InstructionType.Modulo) is "func.call @strict_remainder"
	if kind is InstructionType.Modulo
		return "func.call @strict_remainder"
	function.FastLoop >= 0 then "llvm.intr.pow" else "func.call @strict_power"
Operation(kind Number) Text
	Copy.Operation(InstructionType.Divide) is "divf"
	Copy.Operation(InstructionType.Add) is "addf"
	Copy.Operation(InstructionType.Subtract) is "subf"
	Copy.Operation(InstructionType.Multiply) is "mulf"
	Copy.Operated(InstructionType.Power, "%a", "%b") is "    %t0c = func.call @strict_power(%a, %b) : (f64, f64) -> f64"
	if kind is InstructionType.Add
		return "addf"
	kind is InstructionType.Subtract then "subf" else kind is InstructionType.Multiply then "mulf" else "divf"
Predicate(kind Number) Text
	Copy.Predicate(InstructionType.NotEqual) is "une"
	Copy.Predicate(InstructionType.Equal) is "oeq"
	Copy.Predicate(InstructionType.LessThan) is "olt"
	Copy.Predicate(InstructionType.GreaterThan) is "ogt"
	if kind is InstructionType.Equal
		return "oeq"
	kind is InstructionType.NotEqual then "une" else kind is InstructionType.LessThan then "olt" else "ogt"
Compared(entry InstructionEntry, operands Text) Texts
	Copy.Compared(InstructionEntry.Binary(InstructionType.Equal, (0, 1)), "%a, %b").Length is 2
	constant single = MlirStatements(MlirFunction(Copy.function, Float = "f32"), 0)
	Exact is in single.Compared(InstructionEntry.Binary(InstructionType.LessThan, (0, 1)), "%a, %b")
	let exact = MlirRational(MlirExact(function, position)).Compared(entry, Temp("f"), Temp("") + "c")
	let compared = Temp("") + (exact.Length is 0 then "c" else "f")
	let compare = "    " + compared + " = arith.cmpf " + Predicate(entry.kind) + ", " + operands + " : " + function.Float
	let flagged = (List(Text) + compare) + exact + ("    llvm.store " + Temp("") + "c, %flag : i1, !llvm.ptr")
	entry.payload(0) is not 3 then flagged else flagged + Numbered(Temp("c"), entry)
Numbered(flag Text, entry InstructionEntry) Texts
	Copy.Numbered("%f", InstructionEntry.Binary(InstructionType.Equal, (0, 1, 2))).Length is 2
	let number = "    " + Temp("d") + " = arith.uitofp " + flag + " : i1 to " + function.Float
	(number, function.Store(Temp("d"), "%r" + entry.payload(3)))