has function MlirFunction
has position Number
constant Sizing = MemberEntry("size", "Strict/Number", List(InstructionEntry), false)
constant SizeLoad = InstructionEntry.Named(InstructionType.LoadVariableToRegister, 0, "size")
constant Making = MethodEntry("Made", List(MemberEntry) + Sizing, "Strict/Shape", (SizeLoad, InstructionEntry.Invoke(1, ("Strict/Shape", "from", "Strict/Shape", "width"), 0, -1), InstructionEntry.Return(1)))
constant Maker = TypeEntry("Strict/Shape", MlirFunction.Shape.members, List(MethodEntry) + Making)
constant Made = MlirStructs(MlirFunction(List(TypeEntry) + Maker, Maker, Making), 1)
constant Validating = InstructionEntry.Invoke(2, ("Strict/Shape", "Validated", "Strict/Shape"), List(Number), 1)
constant Checker = MlirStructs(MlirFunction(List(TypeEntry) + Maker, Maker, MethodEntry("Checked", List(MemberEntry) + Sizing, "Strict/Shape", Making.instructions.Slice(0, 2) + Validating + InstructionEntry.Return(2))), 1)
constant Calling = InstructionEntry.Invoke(1, ("Strict/Shape", "Made", "Strict/Shape", "size"), 0, -1)
constant Forwarding = MethodEntry("Forwarded", List(MemberEntry) + Sizing, "Strict/Shape", (SizeLoad, Calling, InstructionEntry.Return(1)))
constant Forwarder = MlirStructs(MlirFunction(List(TypeEntry) + Maker, Maker, Forwarding), 1)
constant ShapeItems = MemberEntry("items", "Strict/List(Strict/Shape)", List(InstructionEntry), false)
constant Filling = MethodEntry("Filled", (ShapeItems, Sizing), "None", (SizeLoad, Calling, InstructionEntry.Named(InstructionType.StoreRegisterToVariable, 1, "items(0)"), InstructionEntry.Return(1)))
constant Filler = MlirStructs(MlirFunction(List(TypeEntry) + Maker, Maker, Filling), 1)
constant ShapesEmptied = MethodCodegen.StoreConstant(InstructionEntry(InstructionType.LoadConstantToRegister, "Strict/List(Strict/Shape)", (0, 6, -1, 0)), "forResult")
constant MakingLoop = (ShapesEmptied, SizeLoad, InstructionEntry.LoopBegin(0, -1), SizeLoad, Calling, InstructionEntry.Named(InstructionType.StoreRegisterToVariable, 1, "made"))
constant MadeAdding = (InstructionEntry.Named(InstructionType.LoadVariableToRegister, 2, "made"), InstructionEntry.Named(InstructionType.InvokeWriteToList, 2, "forResult"))
constant Collecting = MethodEntry("Collected", List(MemberEntry) + Sizing, "Strict/List(Strict/Shape)", MakingLoop + MadeAdding + InstructionEntry.Jump(InstructionType.LoopEnd, 6))
constant Collector = MlirStructs(MlirFunction(List(TypeEntry) + Maker, Maker, Collecting), 4)
constant Probe = TypeEntry("Strict/Probe", (MemberEntry.LoggerMember, MlirFunction.Shape.members.First, MemberEntry("y", "Strict/Number", List(InstructionEntry), false)), List(MethodEntry))
constant ProbeMade = InstructionEntry.Invoke(2, ("Strict/Probe", "from", "Strict/Probe", "logger", "width", "y"), (0, 1), -1)
constant ProbeLoads = (InstructionEntry.Named(InstructionType.LoadVariableToRegister, 0, "logger"), InstructionEntry.Named(InstructionType.LoadVariableToRegister, 1, "width"))
constant Probing = MlirStructs(MlirFunction(List(TypeEntry) + Probe, Probe, MethodEntry("Moved", MlirFunction.Shape.members, "Strict/Probe", ProbeLoads + ProbeMade + InstructionEntry.Return(2))), 2)
constant DestinationRead = ("    %structDestinationGlobal = llvm.mlir.addressof @strict_struct_destination : !llvm.ptr", "    %structDestinationValue = llvm.load %structDestinationGlobal : !llvm.ptr -> f64")
constant DestinationCopied = ("    %structDestination = llvm.alloca %one x f64 : (i64) -> !llvm.ptr", "    llvm.store %structDestinationValue, %structDestination : f64, !llvm.ptr")
constant Taking = DestinationRead + "    llvm.store %zero, %structDestinationGlobal : f64, !llvm.ptr" + DestinationCopied
Consumes(depth Number) Boolean
	Made.Consumes(0)
	Forwarder.Consumes(0)
	Checker.Consumes(0)
	MlirStructs(MlirInstances.Shapes, 0).Consumes(0) is false
	let returned = TypeEntry.ShortName(function.method.returnType)
	let isStruct = MlirLayout(function).IsStruct(returned) and (MlirFlats(function, 0).Kind(returned) is "")
	if (depth > 2) or (isStruct is false)
		return false
	for function.method.instructions
		if (value.kind is InstructionType.Return) and IsSource(index, value.payload(0), depth)
			return true
	false
IsSource(at Number, register Number, depth Number) Boolean
	Made.IsSource(2, 1, 0)
	Made.IsSource(2, 0, 0) is false
	let writer = MlirKinds(function).Writer(at, register)
	let entry = writer >= 0 then function.method.instructions(writer) else InstructionEntry.Return(0)
	if entry.kind is not InstructionType.Invoke
		return false
	if entry.texts(1) is "from"
		return (entry.texts(0) is function.method.returnType) and (MlirConstants(function, writer).IsConstant is false)
	if entry.texts(1) is "Validated"
		return IsSource(writer, entry.payload.Last, depth)
	let callees = MlirModule(function.types, "").Called(function, writer)
	callees.Length > 0 then MlirStructs(callees.First, 0).Consumes(depth + 1) else false
Prologue Texts
	Filler.Consumes(0) is false
	Made.Consumes(3) is false
	Collector.Collected(Calling, List(Text) + "call", "Text") is ("call")
	Text.Combine(Collector.Collected(Calling, ("call"), "Shape")).Length is 237
	Text.Combine(Forwarder.Destined(Calling, Forwarding.instructions(2), ("call"))).Length is 124
	Made.Constructed(Making.instructions(1), MlirInstances.Outer, MlirOwned.Fresh) is MlirOwned.Fresh
	Text.Combine(Made.Constructed(Making.instructions(1), Maker, MlirOwned.Fresh)).Length is 510
	Made.Prologue is Taking
	Probing.IsRebuilt(ProbeMade, Probe) is false
	MlirStructs(MlirInstances.Shapes, 0).Prologue.Length is 0
	Consumes(0) then Taking else List(Text)
IsRebuilt(entry InstructionEntry, owner TypeEntry) Boolean
	Made.IsRebuilt(Making.instructions(1), Maker)
	Checker.IsRebuilt(Checker.function.method.instructions(1), Maker)
	MlirStructs(Made.function, 0).IsRebuilt(Making.instructions(0), Maker) is false
	Made.IsRebuilt(Making.instructions(1), MlirInstances.Outer) is false
	if entry.kind is not InstructionType.Invoke
		return false
	let checkedAt = MlirDestined(function, position).CheckedAt
	let checked = function.method.instructions(checkedAt)
	let next = MlirDestined(function, checkedAt).Next(checked)
	let isFull = MlirOwned(function, position).IsArgued(entry, owner)
	let isReturned = (next.kind is InstructionType.Return) and (next.payload(0) is checked.payload(0))
	isReturned and isFull and (MlirConstants(function, position).IsConstant is false)
Constructed(entry InstructionEntry, owner TypeEntry, built Texts) Texts
	Text.Combine(Made.Constructed(Making.instructions(1), Maker, MlirOwned.Fresh)).IndexOf("%structDestination") > 0
	MlirStructs(MlirInstances.Shapes, 1).Constructed(MlirInstances.Built, Maker, MlirOwned.Fresh) is MlirOwned.Fresh
	let owned = MlirOwned(function, position)
	if (owned.Target(entry, owner) is not "") or (IsRebuilt(entry, owner) is false) or (Consumes(0) is false)
		return owned.Reconstructed(entry, owner, built)
	let old = "%t" + position + "old"
	let compared = "    %t" + position + "re = arith.cmpf une, " + old + ", %zero : f64"
	let opened = (function.Load(old, "%structDestination"), compared) + owned.Placed(MlirOwned.Reusing.Slice(1, 3), 0, 0)
	let reused = owned.Rewritten(entry, owner, "") + function.Store(old, "%r" + entry.payload(0))
	let fresh = owned.Placed(MlirOwned.Reusing.Slice(4, 2), 0, 0) + built
	opened + reused + fresh + owned.Placed(MlirOwned.Reusing.Slice(6, 2), 0, 0)
Destined(entry InstructionEntry, next InstructionEntry, compiled Texts) Texts
	Forwarder.Destined(Calling, Forwarding.instructions(2), List(Text) + "call")(1) is Forwarder.Destine("sd")
	Text.Combine(Filler.Destined(Calling, Filling.instructions(2), List(Text) + "call")).IndexOf("_destine_element(") > 0
	Made.Destined(Calling, Making.instructions(2), List(Text) + "call") is ("call")
	Text.Combine(MlirDestined(Filler.function, 1).Destined(Calling, List(Text) + "call")).IndexOf("_destine_element(") > 0
	Text.Combine(MlirDestined(Forwarder.function, 1).Destined(Calling, List(Text) + "call")).IndexOf("struct_destine(") > 0
	let callees = MlirModule(function.types, "").Called(function, position)
	if (callees.Length is 0 then true else MlirStructs(callees.First, 0).Consumes(1) is false)
		return MlirElements(function, position).Destined(entry, next, compiled)
	if ((next.kind is InstructionType.Return) and (next.payload(0) is entry.payload(0))) and Consumes(0)
		return (function.Load("%t" + position + "sd", "%structDestination"), Destine("sd")) + compiled
	Element(entry, next, compiled, TypeEntry.ShortName(callees.First.method.returnType))
Element(entry InstructionEntry, next InstructionEntry, compiled Texts, returned Text) Texts
	Made.Element(Calling, Making.instructions(2), List(Text) + "call", "Shape") is ("call")
	if IsTarget(entry, next, returned) is false
		return Collected(entry, compiled, returned)
	let parts = PayloadDecoder(next).ElementParts
	let temp = "%t" + position + "s"
	let index = MlirElements(function, position).Index(parts(1), temp + "i")
	let destined = "    func.call @strict_struct_destine_element(" + temp + "l, " + temp + "i) : (f64, f64) -> ()"
	(function.Load(temp + "l", "%v_" + parts(0)), index, destined) + compiled
Collected(entry InstructionEntry, compiled Texts, returned Text) Texts
	Text.Combine(Collector.Collected(Calling, List(Text) + "call", "Shape")).IndexOf("_block(%t4kl, %t4ki, %t4kn)") > 0
	Made.Collected(Calling, List(Text) + "call", "Shape") is ("call")
	let embedded = MlirEmbedded(function)
	if embedded.IsNumbers(returned) is false
		return compiled
	if IsKept(entry) is false
		return embedded.Stacked(position, compiled)
	let temp = "%t" + position + "k"
	let size = "    " + temp + "n = arith.constant " + embedded.Slots(returned) + ".0 : f64"
	let arguments = temp + "l, " + temp + "i, " + temp + "n) : (f64, f64, f64) -> ()"
	let destined = "    func.call @strict_struct_destine_block(" + arguments
	(function.Load(temp + "l", "%v_forResult"), function.Load(temp + "i", "%v_index"), size, destined) + compiled
IsKept(entry InstructionEntry) Boolean
	Collector.IsKept(Calling)
	Made.IsKept(Calling) is false
	let steps = function.method.instructions
	let next = MlirDestined(function, position).Next(entry)
	let isStored = (next.kind is InstructionType.StoreRegisterToVariable) and (next.payload(0) is entry.payload(0))
	let stored = isStored then next.texts(0) else ""
	for Range(position + 1, steps.Length)
		if steps(value).kind is in (InstructionType.LoopBegin, InstructionType.LoopEnd)
			return false
		if (steps(value).kind is InstructionType.InvokeWriteToList) and (steps(value).texts(0) is "forResult")
			return IsWritten(value, stored)
	false
IsWritten(at Number, stored Text) Boolean
	Filler.IsTarget(Calling, InstructionEntry(Inliner.Store, "size(0)", (1, -1)), "Number") is false
	Filler.IsTarget(Calling, InstructionEntry.Named(Inliner.Store, 1, "items"), "Shape") is false
	Collector.IsWritten(5, "") and (MlirStructs(Collector.function, 0).IsWritten(5, "Strict/Shape") is false)
	Collector.IsWritten(7, "made")
	Collector.IsWritten(7, "other") is false
	let writer = MlirKinds(function).Writer(at, function.method.instructions(at).payload(0))
	if writer < 0
		return false
	let step = function.method.instructions(writer)
	(writer is position) or ((step.kind is InstructionType.LoadVariableToRegister) and (step.texts(0) is stored))
Destine(suffix Text) Text
	Forwarder.IsSource(2, 1, 1) and (Forwarder.IsSource(2, 1, 2) is false)
	Filler.IsTarget(Calling, InstructionEntry(InstructionType.Return, "items(0)", (1, -1)), "Shape") is false
	Filler.IsTarget(Calling, InstructionEntry.Named(Inliner.Store, 0, "items(0)"), "Shape") is false
	Filler.IsTarget(Calling, InstructionEntry(Inliner.Store, "items(0)", (1)), "Shape") is false
	Forwarder.Destined(Calling, InstructionEntry.Return(0), ("call")) is ("call")
	Forwarder.Destined(Calling, Calling, ("call")) is ("call")
	Text.Combine(Filler.Element(Calling, InstructionEntry(Inliner.Store, "items(a)", (1, 0)), (""), "Shape")).Length is 177
	Text.Combine(Filler.Element(Calling, Filling.instructions(2), List(Text), "Shape")).Length is 166
	Made.Destine("sd") is "    func.call @strict_struct_destine(%t1sd) : (f64) -> ()"
	"    func.call @strict_struct_destine(%t" + position + suffix + ") : (f64) -> ()"
IsTarget(entry InstructionEntry, next InstructionEntry, returned Text) Boolean
	Filler.IsTarget(Calling, Filling.instructions(2), "Shape")
	Filler.IsTarget(Calling, Filling.instructions(2), "Number") is false
	Made.IsTarget(Calling, Making.instructions(2), "Shape") is false
	let isStored = (next.kind is Inliner.Store) and (next.payload.Length is 2) and (next.payload(0) is entry.payload(0))
	if (isStored then next.texts(0).IndexOf("(") > 0 else false) is false
		return false
	let kinds = MlirKinds(function)
	let list = PayloadDecoder(next).ElementParts(0)
	let element = function.TypeOf(kinds.ElementKind(kinds.VariableKind(position, list)), true)
	(element.members.Length > 0) and (element.Name is function.TypeOf(returned, true).Name)
