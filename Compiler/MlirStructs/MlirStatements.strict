has function MlirFunction
has position Number
constant CopyInstructions = (InstructionEntry.LoadNumber(0, 7), InstructionEntry.Named(InstructionType.StoreRegisterToVariable, 0, "a"), InstructionEntry.Return(0))
constant Copy = MlirStatements(MlirFunction(List(TypeEntry), MlirFunction.Shape, MethodEntry("Run", List(MemberEntry), "None", CopyInstructions)), 0)
constant Summing = MlirStatements(MlirFastLoop.Summing.function, 5)
constant Reassociated = " fastmath<reassoc,contract>"
constant AnyError = " = func.call @strict_any_error() : () -> f64"
constant ListKinds = (InstructionType.IndexCall, InstructionType.InvokeWriteToList, InstructionType.CopyList, InstructionType.InvokeRemove)
constant Exact = "    %t0c = arith.select %x0v, %x0i, %t0f : i1"
constant Flagged = ("    %t0d = arith.uitofp %f : i1 to f32", "    llvm.store %t0d, %r2 : f32, !llvm.ptr", "    %t0w = arith.extui %f : i1 to i64") + MlirExact.Single.Set("%t0w", "%one", "%r2")
constant Singled = MlirStatements(MlirFunction(Copy.function, Float = "f32"), 0)
constant LoadingBranch = (InstructionEntry.Named(InstructionType.LoadVariableToRegister, 1, "a"), InstructionEntry.Jump(InstructionType.JumpToIdIfTrue, 1))
constant LoadingEnds = (InstructionEntry.Jump(InstructionType.JumpEnd, 0), InstructionEntry.Jump(InstructionType.JumpEnd, 1), InstructionEntry.Return(1))
constant Loading = MlirStatements(MlirFunction(List(TypeEntry), MlirFunction.Shape, MethodEntry("Run", List(MemberEntry), "None", LoadingBranch + LoadingEnds)), 0)
constant Branched = ("    %t1 = llvm.load %flag : !llvm.ptr -> i1", "    cf.cond_br %t1, ^bb3, ^bb2")
constant Returning = ("    %t0 = llvm.load %r1 : !llvm.ptr -> f64", "    return %t0 : f64")
constant Operands = ("    %t0a = llvm.load %r0 : !llvm.ptr -> f64", "    %t0b = llvm.load %r1 : !llvm.ptr -> f64")
constant Added = Operands + ("    %t0c = arith.addf %t0a, %t0b : f64", "    llvm.store %t0c, %r2 : f64, !llvm.ptr")
constant Equaled = Operands + ("    %t0c = arith.cmpf oeq, %t0a, %t0b : f64", "    llvm.store %t0c, %flag : i1, !llvm.ptr", "    %t0d = arith.uitofp %t0c : i1 to f64", "    llvm.store %t0d, %r2 : f64, !llvm.ptr")
Emitted Texts
	Copy.Emitted.Last is "    llvm.store %t0c, %r0 : f64, !llvm.ptr"
	entry = function.method.instructions(position)
	kind = entry.kind
	if kind is InstructionType.LoadConstantToRegister
		return Literal(PayloadDecoder(entry).Value(1), "%r" + entry.payload(0), "")
	if kind is InstructionType.StoreConstantToVariable
		return Literal(PayloadDecoder(entry).Value(0), "%v_" + entry.texts.Last, "")
	if kind is InstructionType.LoadVariableToRegister
		return function.Copy("%v_" + entry.texts(0), "%r" + entry.payload(0), Temp(""))
	if kind is InstructionType.StoreRegisterToVariable
		return MlirOwned(function, position).Store(entry)
	kind is InstructionType.Return then Leave(entry) else Jump(entry)
Binary(entry InstructionEntry) Texts
	Copy.Binary(InstructionEntry.Binary(InstructionType.Add, (0, 1, 2))).Length is 4
	if MlirTexts(function, position).IsSum
		return MlirTexts(function, position).Concatenate(entry)
	operators = MlirListOperators(function, position)
	operators.IsOperation then operators.Operate(entry) else Calculate(entry)
Temp(suffix Text) Text
	Copy.Temp("c") is "%t0c"
	Loading.Emitted is ("    %t0 = llvm.load %v_a : !llvm.ptr -> f64", "    llvm.store %t0, %r1 : f64, !llvm.ptr")
	MlirStatements(Loading.function, 1).Emitted is Branched
	MlirStatements(Copy.function, 2).Emitted.Last is "    return %t2 : f64"
	"%t" + position + suffix
Literal(literal Runtime/Core/VmValue, slot Text, suffix Text, named = "") Texts
	Copy.Literal(VmValue.OfNumber(1), "%r0", "").First is "    %t0c = arith.constant 0x3FF0000000000000 : f64"
	Copy.Literal(VmValue.OfText("b"), "%s", "d0", "@dA_b").First.IndexOf(" @dA_b ") > 0
	Copy.Literal(VmValue.AnyError, "%r0", "").First is "    %t0c = func.call @strict_any_error() : () -> f64"
	if literal.kind is "Text"
		return MlirConstants(function, position, named).Literal(literal.text, slot, suffix)
	if literal.kind is "List"
		return MlirLists(function, position, named).Literal(literal, slot, suffix)
	if literal.kind is not in ("Number", "Boolean", "None", "Strict/Error")
		return List(Text) + Unsupport(literal.kind + " constant")
	loaded = literal.kind is "Strict/Error" then AnyError else " = arith.constant " + Hex(literal.number) + " : f64"
	("    " + Temp(suffix + "c") + loaded, function.Store(Temp(suffix + "c"), slot))
Hex(number Number) Text
	Copy.Hex(-2) is "0xC000000000000000"
	bytes = ByteEncoder.Empty.Double(number).bytes
	mutable result = "0x"
	for 8
		result = result + MetalValue("").Hex(bytes(7 - index), 2)
	result
Leave(entry InstructionEntry) Texts
	MlirStatements(Copy.function, 2).Leave(InstructionEntry.Return(0)).Last is "    return %t2 : f64"
	Text.Combine(MlirStatements(MlirChecks.Presenting, 2).Leave(InstructionEntry.Return(0))).IndexOf("frame_ended") > 0
	Text.Combine(MlirStatements(MlirDying.Dropping.function, 10).Leave(MlirDying.Dropped)).IndexOf("rc_dead(%t10d0") > 0
	Copy.Leave(InstructionEntry.Return(1)) is Returning
	kept = MlirChanged(function, position).Keep(false)
	if MlirLayout(function).IsInitializer
		return kept + MlirLayout(function).EmitReturn(position)
	dying = MlirDying(function, position).EmitReturn(entry) + MlirGiving(function, position).Released
	loaded = (List(Text) + function.Load(Temp(""), "%r" + entry.payload(0))) + dying
	kept + loaded + MlirLines(function).Framed + ("    return " + Temp("") + " : f64")
Jump(entry InstructionEntry) Texts
	Copy.Jump(InstructionEntry.Jump(InstructionType.JumpEnd, 0)).Length is 0
	if entry.kind is InstructionType.JumpEnd
		return List(Text)
	if entry.kind is InstructionType.CheckError
		return MlirChecks(function, position).Emitted
	if entry.kind is not in (InstructionType.JumpToIdIfFalse, InstructionType.JumpToIdIfTrue)
		return List(Text) + Unsupport("instruction kind " + entry.kind)
	target = "^bb" + JumpEnd(PayloadDecoder(entry).SevenBit(0))
	next = "^bb" + (position + 1)
	branches = entry.kind is InstructionType.JumpToIdIfTrue then target + ", " + next else next + ", " + target
	("    " + Temp("") + " = llvm.load %flag : !llvm.ptr -> i1", "    cf.cond_br " + Temp("") + ", " + branches)
JumpEnd(id Number) Number
	Copy.JumpEnd(5) is 3
	Loading.JumpEnd(1) is 3
	Loading.JumpEnd(0) is 2
	for function.method.instructions
		if value.kind is InstructionType.JumpEnd and PayloadDecoder(value).SevenBit(0) is id
			return index
	function.method.instructions.Length
Unsupport(what Text) Text
	Copy.Unsupport("List") is "unsupported: List in Shape_Run_0"
	Copy.Jump(InstructionEntry.Return(0)).First is Copy.Unsupport("instruction kind " + InstructionType.Return)
	Copy.Jump(InstructionEntry.Jump(InstructionType.JumpToIdIfFalse, 1)).Last is "    cf.cond_br %t0, ^bb1, ^bb3"
	"unsupported: " + what + " in " + function.Symbol
Calculate(entry InstructionEntry) Texts
	Copy.Calculate(InstructionEntry.Binary(InstructionType.Add, (0, 1, 2))).Length is 4
	Copy.Calculate(InstructionEntry.Binary(InstructionType.Add, (0, 1, 2))) is Added
	Copy.Calculate(InstructionEntry.Binary(InstructionType.Equal, (0, 1, 2))) is Equaled
	Copy.Calculate(MlirKindTests.TextTest).Last.EndsWith("%flag : i1, !llvm.ptr")
	constant left = Temp("a")
	constant right = Temp("b")
	loads = (function.Load(left, "%r" + entry.payload(1)), function.Load(right, "%r" + entry.payload(2)))
	if entry.kind is InstructionType.OfType
		return MlirKindTests(function, position).EmitTest(entry)
	if MlirEquality(function, position).Handles(entry)
		return MlirEquality(function, position).Compare(entry)
	if entry.kind > InstructionType.ArithmeticSeparator
		return loads + Compare(entry, left + ", " + right)
	lines = loads + Operate(entry.kind, left, right) + MlirRounded(function, position).Store(entry)
	entry.kind is InstructionType.Modulo then MlirCounter(function, position).Remainder(entry, lines) else lines
Operate(kind Number, left Text, right Text) Text
	Copy.Operate(InstructionType.Modulo, "%a", "%b").IndexOf("@strict_remainder(%a, %b)") > 0
	Copy.Operate(InstructionType.Add, "%a", "%b") is "    %t0c = arith.addf %a, %b : f64"
	Summing.Operate(InstructionType.Add, "%a", "%b") is "    %t5c = arith.addf %a, %b fastmath<reassoc,contract> : f64"
	MlirStatements(MlirFastLoop.Doubling.function, 6).Operate(InstructionType.Add, "%a", "%b").IndexOf("fastmath") is -1
	Copy.Operate(InstructionType.Power, "%a", "%b").IndexOf("@strict_power(%a, %b)") > 0
	MlirStatements(MlirFastLoop.Doubling.function, 6).Operate(InstructionType.Power, "%a", "%b").IndexOf("intr.pow(") > 0
	result = "    " + Temp("c") + " = "
	if kind is in (InstructionType.Power, InstructionType.Modulo)
		return result + Call(kind) + "(" + left + ", " + right + ") : (f64, f64) -> f64"
	isSum = MlirFastLoop(function, function.FastLoop).IsAccumulated(position)
	flags = isSum then Reassociated else (MlirRangeLoop(function, position).IsRanged then MlirRangeLoop.Flags else "")
	result + "arith." + Operation(kind) + " " + left + ", " + right + flags + " : f64"
Call(kind Number) Text
	Copy.Call(InstructionType.Modulo) is "func.call @strict_remainder"
	if kind is InstructionType.Modulo
		return "func.call @strict_remainder"
	function.FastLoop >= 0 then "llvm.intr.pow" else "func.call @strict_power"
Operation(kind Number) Text
	Copy.Operation(InstructionType.Divide) is "divf"
	Copy.Operation(InstructionType.Add) is "addf"
	Copy.Operation(InstructionType.Subtract) is "subf"
	Copy.Operation(InstructionType.Multiply) is "mulf"
	Copy.Operate(InstructionType.Power, "%a", "%b") is "    %t0c = func.call @strict_power(%a, %b) : (f64, f64) -> f64"
	if kind is InstructionType.Add
		return "addf"
	kind is InstructionType.Subtract then "subf" else kind is InstructionType.Multiply then "mulf" else "divf"
Predicate(kind Number) Text
	Copy.Predicate(InstructionType.NotEqual) is "une"
	Copy.Predicate(InstructionType.Equal) is "oeq"
	Copy.Predicate(InstructionType.LessThan) is "olt"
	Copy.Predicate(InstructionType.GreaterThan) is "ogt"
	if kind is InstructionType.Equal
		return "oeq"
	kind is InstructionType.NotEqual then "une" else kind is InstructionType.LessThan then "olt" else "ogt"
Compare(entry InstructionEntry, operands Text) Texts
	Copy.Compare(InstructionEntry.Binary(InstructionType.Equal, (0, 1)), "%a, %b").Length is 2
	Exact is in Singled.Compare(InstructionEntry.Binary(InstructionType.LessThan, (0, 1)), "%a, %b")
	exact = MlirRational(MlirExact(function, position)).Compare(entry, Temp("f"), Temp("") + "c")
	compared = Temp("") + (exact.Length is 0 then "c" else "f")
	compare = "    " + compared + " = arith.cmpf " + Predicate(entry.kind) + ", " + operands + " : " + function.Float
	prefix = exact.Length is 3 then List(Text) else List(Text) + compare
	flagged = prefix + exact + ("    llvm.store " + Temp("") + "c, %flag : i1, !llvm.ptr")
	entry.payload(0) is not 3 then flagged else flagged + EmitNumber(Temp("c"), entry)
EmitNumber(flag Text, entry InstructionEntry) Texts
	Copy.EmitNumber("%f", InstructionEntry.Binary(InstructionType.Equal, (0, 1, 2))).Length is 2
	Singled.EmitNumber("%f", InstructionEntry.Binary(InstructionType.Equal, (0, 1, 2))) is Flagged
	number = "    " + Temp("d") + " = arith.uitofp " + flag + " : i1 to " + function.Float
	slot = "%r" + entry.payload(3)
	exact = MlirExact(function, position)
	if exact.Parts.Length is 0
		return (number, function.Store(Temp("d"), slot))
	whole = "    " + Temp("w") + " = arith.extui " + flag + " : i1 to i64"
	(number, MlirTyped(function.Float).Store(Temp("d"), slot), whole) + exact.Set(Temp("w"), "%one", slot)