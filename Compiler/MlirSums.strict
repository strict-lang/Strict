has function MlirFunction
has position Number
constant Summing = MlirSums(MlirSingle.Summing.function, 2)
constant Adding = MlirSingle.Layered.method.instructions(9)
constant Multiplied = (GpuSamples.Summed.instructions.Slice(0, 9) + InstructionEntry.Binary(InstructionType.Multiply, (1, 5, 6))) + GpuSamples.Summed.instructions.Slice(10, 4)
constant Multiplying = MlirSums(MlirFunction(Summing.function.types, Summing.function.type, MethodEntry("Summed", GpuSamples.Summed.parameters, "Strict/Number", Multiplied), List(Number), 2, "for 4"), 2)
IsSummed(name Text) Boolean
	Summing.IsSummed("sum")
	Multiplying.IsSummed("sum") is false
	mutable loads = 0
	mutable sums = 0
	for Range(position + 1, function.method.LoopEndOf(position))
		let entry = function.method.instructions(value)
		let isLoad = (entry.kind is InstructionType.LoadVariableToRegister) and (entry.texts(0) is name)
		loads = isLoad then loads + 1 else loads
		sums = AddedTo(value) is name then sums + 1 else sums
	(sums > 0) and (sums is loads)
AddedTo(at Number) Text
	Summing.AddedTo(9) is "sum"
	Summing.AddedTo(8) is ""
	MlirFastLoop(function, position).IsAccumulated(at) then function.method.instructions(at + 1).texts(0) else ""
Type(name Text) Text
	Summing.Type("sum") is "f64"
	Multiplying.Type("sum") is "f32"
	IsSummed(name) then "f64" else "f32"
Loaded(name Text, result Text) Texts
	Summing.Loaded("sum", "%a") is ("    %a = llvm.load %v_sum : !llvm.ptr -> f64")
	Multiplying.Loaded("sum", "%a").Last is "    %a = arith.truncf %ad : f64 to f32"
	let loaded = "llvm.load %v_" + name + " : !llvm.ptr -> f64"
	let narrowed = MlirSingle(function, position).Narrowed(result, loaded)
	IsSummed(name) then List(Text) + ("    " + result + " = " + loaded) else narrowed
Added(entry InstructionEntry, at Number, left Text, right Text) Texts
	Summing.Added(Adding, 9, "%a", "%b").First is "    %t9w = arith.extf %b : f32 to f64"
	Summing.Added(Adding, 9, "%a", "%b").Last is "    %t9s = arith.addf %a, %t9w" + MlirSingle.Summed
	let widened = "%t" + at + "w"
	let operation = "    %t" + at + "s = arith." + MlirStatements(function, at).Operation(entry.kind) + " "
	("    " + widened + " = arith.extf " + right + " : f32 to f64", operation + left + ", " + widened + MlirSingle.Summed)
Stored(name Text, index Number) Texts
	Summing.Stored("sum", 0) is ("    llvm.store %t2u0, %v_sum : f64, !llvm.ptr")
	Multiplying.Stored("sum", 0).First is "    %t2e0 = arith.extf %t2u0 : f32 to f64"
	let carried = "%t" + position + "u" + index
	if IsSummed(name)
		return List(Text) + function.Store(carried, "%v_" + name)
	let widened = "%t" + position + "e" + index
	("    " + widened + " = arith.extf " + carried + " : f32 to f64", function.Store(widened, "%v_" + name))
Typed(letter Text, separator Text) Text
	Summing.Typed("u", ": ") is ", %t2u0: f64"
	Multiplying.Typed("", "") is ", f32"
	for MlirSingle(function, position).Carried
		", " + (letter is "" then "" else "%t" + position + letter + index) + separator + Type(value)
Initials Texts
	Summing.Initials is ("    %t2i0 = llvm.load %v_sum : !llvm.ptr -> f64")
	mutable lines = List(Mutable(Text))
	for MlirSingle(function, position).Carried
		lines = lines + Loaded(value, "%t" + position + "i" + index)
	lines
