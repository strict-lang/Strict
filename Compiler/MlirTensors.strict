has function MlirFunction
constant Kinds = ("Attention", "Products", "Hadamard", "Convolution", "Sylvester")
constant Attentions = ("queries", "keys", "values", "heads", "groups", "size", "sequences", "causal", "valueOffset", "valueStride", "quantized", "routing", "exact")
constant Productions = ("left", "right", "shape", "strides")
constant Hadamards = ("values", "group")
constant Sylvesters = ("values", "flips", "size")
constant Convolutions = ("values", "affine", "weights", "shape")
constant ValueCollected = (InstructionEntry.Named(InstructionType.LoadVariableToRegister, 1, "value"), InstructionEntry.Named(InstructionType.InvokeWriteToList, 1, "forResult"), InstructionEntry.Jump(InstructionType.LoopEnd, 3))
constant SoftmaxCalls = (InstructionEntry.Invoke(0, ("Strict/Softmax", "Shares", "Strict/List(Number)"), List(Number), -1), InstructionEntry.Invoke(1, ("Strict/Softmax", "Weighted", "Strict/Number"), List(Number), -1))
constant QueriesLoop = (MlirLoops.Emptied, InstructionEntry.Named(InstructionType.LoadVariableToRegister, 0, "queries"), InstructionEntry.LoopBegin(0, -1))
constant Merging = MethodEntry("Merged", List(MemberEntry), "Strict/List(Number)", SoftmaxCalls + QueriesLoop + ValueCollected)
constant QueryKeys = (MemberEntry("queries", "Strict/List(Number)", List(InstructionEntry), false), MemberEntry("keys", "Strict/List(Number)", List(InstructionEntry), false))
constant ValueHeads = (MemberEntry("values", "Strict/List(Number)", List(InstructionEntry), false), MemberEntry("heads", "Strict/Number", List(InstructionEntry), false), MemberEntry("groups", "Strict/Number", List(InstructionEntry), false))
constant Sequencing = (MemberEntry("size", "Strict/Number", List(InstructionEntry), false), MemberEntry("sequences", "Strict/Number", List(InstructionEntry), false), MemberEntry("causal", "Strict/Boolean", List(InstructionEntry), false))
constant ValueOffsets = (MemberEntry("valueOffset", "Strict/Number", List(InstructionEntry), false), MemberEntry("valueStride", "Strict/Number", List(InstructionEntry), false))
constant Quantizing = (MemberEntry("quantized", "Strict/Boolean", List(InstructionEntry), false), MemberEntry("routing", "Strict/Number", List(InstructionEntry), false), MemberEntry("exact", "Strict/Number", List(InstructionEntry), false))
constant Attended = TypeEntry("Strict/Attention", QueryKeys + ValueHeads + Sequencing + ValueOffsets + Quantizing, List(MethodEntry) + Merging)
constant Ending = ("    %isTensored = arith.cmpf une, %tensored, %zero : f64", "    cf.cond_br %isTensored, ^tensored, ^computed", "  ^tensored:", "    return %tensored : f64", "  ^computed:")
constant Attending = MlirTensors(MlirFunction(List(TypeEntry) + Attended, Attended, Merging))
constant Rotating = MlirTensors(MlirFunction(List(TypeEntry) + Attended, Attended, MethodEntry("Rotated", List(MemberEntry), "Strict/List(Number)", Merging.instructions(1))))
constant Factors = (MemberEntry("left", "Strict/List(Number)", List(InstructionEntry), false), MemberEntry("right", "Strict/List(Number)", List(InstructionEntry), false))
constant ProductShape = (MemberEntry("shape", "Strict/List(Number)", List(InstructionEntry), false), MemberEntry("strides", "Strict/List(Number)", List(InstructionEntry), false))
constant LeftLoop = (MlirLoops.Emptied, InstructionEntry.Named(InstructionType.LoadVariableToRegister, 0, "left"), InstructionEntry.LoopBegin(0, -1))
constant Multiplied = TypeEntry("Strict/Products", Factors + ProductShape, List(MethodEntry) + MethodEntry("Multiplied", List(MemberEntry), "Strict/List(Number)", LeftLoop + ValueCollected))
constant Multiplying = MlirTensors(MlirFunction(List(TypeEntry) + Multiplied, Multiplied, Multiplied.methods.First))
constant SoftmaxShares = TypeCodegen("Strict/Softmax", ("Shares(scores Numbers, width Number) Numbers", "\tfor scores.Length", "\t\tscores(index) / width"), ValueCodegen.NoTypes, List(Text)).Entry
constant Softmaxing = MlirTensors(MlirFunction(List(TypeEntry), TypeEntry("Strict/Softmax", List(MemberEntry), List(MethodEntry)), SoftmaxShares.methods.First))
Kind Text
	Attending.Kind is "Attention"
	Multiplying.Kind is "Products"
	MlirTensors(MlirGpu.Layering.function).Kind is ""
	Softmaxing.Kind is "Softmax"
	MlirTensors(MlirFunction(List(TypeEntry) + Attended, Attended, Multiplying.function.method)).Kind is ""
	MlirTensors(MlirFunction(List(TypeEntry) + Multiplied, Multiplied, Merging)).Kind is "" and (Rotating.Kind is "")
	let stored = MlirInstances(function, 0).StoredNames(function.type)
	if function.method.parameters.Length > 0
		return IsSoftmax then "Softmax" else ""
	if (stored is Attentions) and IsInvoked("Softmax.Shares") and IsInvoked("Softmax.Weighted")
		return "Attention"
	Named(stored)
Named(stored Texts) Text
	Multiplying.Named(Productions) is "Products"
	Multiplying.Named(Convolutions) is ""
	Rotating.Named(Hadamards) is "Hadamard" and (Rotating.Named(Sylvesters) is "Sylvester")
	Rotating.Named(Convolutions) is "" and (Rotating.Named(Productions) is "") and (Multiplying.Named(Hadamards) is "")
	if (stored is Hadamards) and (function.method.Name is "Rotated")
		return "Hadamard"
	if (stored is Sylvesters) and (function.method.Name is "Rotated")
		return "Sylvester"
	if (stored is Convolutions) and (function.method.Name is "Summed")
		return "Convolution"
	(stored is Productions) and (function.method.Name is "Multiplied") then "Products" else ""
IsSoftmax Boolean
	Softmaxing.IsSoftmax
	Multiplying.IsSoftmax is false
	MlirTensors(MlirFunction(List(TypeEntry), Multiplied, Softmaxing.function.method)).IsSoftmax is false
	MlirTensors(MlirFunction(List(TypeEntry), Softmaxing.function.type, TypeEntry.ToNumber)).IsSoftmax is false
	let isShares = (function.type.JustName is "Softmax") and (function.method.Name is "Shares")
	isShares and (function.Parameters is ("value", "scores", "width"))
IsInvoked(name Text) Boolean
	Attending.IsInvoked("Softmax.Shares")
	Attending.IsInvoked("Softmax.Largests") is false
	Attending.IsInvoked("max.Shares") is false
	for function.method.Invoked
		if value.EndsWith("/" + name)
			return true
	false
IsComputed Boolean
	Attending.IsComputed
	MlirTensors(MlirFunction.Counter).IsComputed is false
	for function.method.instructions
		if (value.kind is InstructionType.LoopBegin) and MlirGpuCheck(function, index).IsGpu
			return true
	false
Prologue Texts
	Attending.Prologue.Length is 20
	"    cf.cond_br %isTensored, ^tensored, ^computed" is in Multiplying.Prologue
	MlirTensors(MlirGpu.Layering.function).Prologue.Length is 0
	Softmaxing.Prologue(3).EndsWith("@strict_gpu_softmax(%tensorPtx, %tensor0, %tensor1) : (!llvm.ptr, f64, f64) -> f64")
	let kind = Kind
	(kind is "") or (IsComputed is false) then List(Text) else Loads(kind) + Called(kind)
Loads(kind Text) Texts
	Attending.Loads("Attention").First is "    %tensor0 = llvm.load %v_queries : !llvm.ptr -> f64"
	for Members(kind)
		function.Load("%tensor" + index, "%v_" + value)
Called(kind Text) Texts
	Multiplying.Called("Products")(1).EndsWith("%tensor3) : (!llvm.ptr, f64, f64, f64, f64) -> f64")
	Multiplying.Called("Softmax")(0) is "    %tensorPtx = llvm.mlir.addressof @strict_gpu_ptx : !llvm.ptr"
	Multiplying.Called("Hadamard")(1).StartsWith("    %tensored = func.call @strict_gpu_hadamard(%tensorPtx, %tensor0, ")
	let count = Members(kind).Length
	mutable arguments = "%tensorPtx"
	mutable types = "!llvm.ptr"
	for count
		arguments = arguments + ", %tensor" + index
		types = types + ", f64"
	let call = "    %tensored = func.call " + Marker(kind) + arguments + ") : (" + types + ") -> f64"
	("    %tensorPtx = llvm.mlir.addressof @strict_gpu_ptx : !llvm.ptr", call) + Ending
Members(kind Text) Texts
	Attending.Members("Hadamard") is ("values", "group")
	Attending.Members("Products").Length is 4
	Attending.Members("Convolution").Last is "shape"
	Attending.Members("Sylvester") is Sylvesters
	Attending.Members("Attention").Last is "exact"
	if kind is "Softmax"
		return ("scores", "width")
	if kind is in ("Convolution", "Sylvester")
		return kind is "Convolution" then Convolutions else Sylvesters
	kind is "Attention" then Attentions else (kind is "Products" then Productions else Hadamards)
Marker(kind Text) Text
	Attending.Marker("Products") is "@strict_gpu_products("
	Attending.Members("Softmax") is ("scores", "width") and (Multiplying.Named(Sylvesters) is "")
	MlirTensors(MlirFunction(List(TypeEntry), Multiplied, GpuLayerSamples.Summed)).Named(Convolutions) is "Convolution"
	MlirTensors(MlirFunction(List(TypeEntry), Multiplied, GpuLayerSamples.Summed)).Named(Productions) is ""
	"@strict_gpu_" + kind.Lower + "("
Used(program Text) Texts
	Attending.Used("x @strict_gpu_products(y") is ("Products")
	Attending.Used("x @strict_gpu_hadamard(y") is ("Hadamard")
	Attending.Used("x @strict_gpu_sylvester(y") is ("Sylvester")
	Attending.Used("x @strict_gpu_convolution(y") is ("Products", "Convolution")
	let convolving = program.IndexOf(Marker("Convolution")) >= 0
	for Kinds
		if program.IndexOf(Marker(value)) >= 0 or (convolving and value is "Products")
			value
