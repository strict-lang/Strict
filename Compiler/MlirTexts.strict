has function MlirFunction
has position Number
constant Allocating = ("  llvm.func @snprintf(!llvm.ptr, i64, !llvm.ptr, ...) -> i32", "  llvm.func @malloc(i64) -> !llvm.ptr", "  llvm.func @realloc(!llvm.ptr, i64) -> !llvm.ptr")
constant Comparing = ("  llvm.func @memcpy(!llvm.ptr, !llvm.ptr, i64) -> !llvm.ptr", "  llvm.func @strlen(!llvm.ptr) -> i64", "  llvm.func @strcmp(!llvm.ptr, !llvm.ptr) -> i32", "  llvm.func @strncmp(!llvm.ptr, !llvm.ptr, i64) -> i32")
constant Searching = ("  llvm.func @strstr(!llvm.ptr, !llvm.ptr) -> !llvm.ptr", "  llvm.func @toupper(i32) -> i32", "  llvm.func @tolower(i32) -> i32", "  llvm.func @strtod(!llvm.ptr, !llvm.ptr) -> f64")
constant Opening = ("  llvm.func @strchr(!llvm.ptr, i32) -> !llvm.ptr", "  llvm.func @strtol(!llvm.ptr, !llvm.ptr, i32) -> i64", "  llvm.func @fopen(!llvm.ptr, !llvm.ptr) -> !llvm.ptr", "  llvm.func @fclose(!llvm.ptr) -> i32")
constant FileAccess = ("  llvm.func @fseek(!llvm.ptr, i64, i32) -> i32", "  llvm.func @ftell(!llvm.ptr) -> i64", "  llvm.func @fread(!llvm.ptr, i64, i64, !llvm.ptr) -> i64", "  llvm.func @fwrite(!llvm.ptr, i64, i64, !llvm.ptr) -> i64")
constant BooleanTexts = ("  llvm.mlir.global internal constant @strict_true(\"true\\00\") : !llvm.array<5 x i8>", "  llvm.mlir.global internal constant @strict_false(\"false\\00\") : !llvm.array<6 x i8>")
constant Formats = ("  llvm.mlir.global internal constant @strict_number(\"%g\\00\") : !llvm.array<3 x i8>", "  llvm.mlir.global internal constant @strict_pair(\"%s%s\\00\") : !llvm.array<5 x i8>")
constant EmptyText = ("  llvm.mlir.global internal constant @strict_empty(\"\\00\") : !llvm.array<1 x i8>")
constant Declarations = Allocating + Comparing + Searching + Opening + FileAccess + BooleanTexts + Formats + EmptyText
constant TextAdding = (InstructionEntry.LoadText(0, "a%"), InstructionEntry.LoadNumber(1, 7), InstructionEntry.Binary(InstructionType.Add, (0, 1, 2)))
constant Printing = (InstructionEntry.PrintValue("x: ", 2, true), MlirKinds.Passed, InstructionEntry.PrintValue("y: ", 2, false), InstructionEntry.PrintValue("z: ", 1, false))
constant NumberConverting = (InstructionEntry.Invoke(3, ("Strict/Number", "to", "Strict/Text"), List(Number), 1))
constant Joined = MlirFunction(List(TypeEntry) + MlirFunction.Shape, MlirFunction.Shape, MethodEntry("Run", List(MemberEntry), "None", TextAdding + Printing + NumberConverting))
constant ToNumbers = InstructionEntry.Invoke(1, ("Strict/List(Text)", "to", "Strict/List(Number)"), List(Number), 0)
constant Listing = MlirFunction(List(TypeEntry), MlirFunction.Shape, MethodEntry("Run", List(MemberEntry) + MlirLists.Words, "None", (InstructionEntry.Named(InstructionType.LoadVariableToRegister, 0, "words"), ToNumbers)))
constant NumberTextLoad = ("    %t7v = llvm.load %r1 : !llvm.ptr -> f64", "    %t7vxc = func.constant @strict_number_text : (f64) -> f64")
constant NumberTextStore = ("    %t7vx = func.call @strict_converted(%t7v, %t7vxc) : (f64, (f64) -> f64) -> f64", "    llvm.store %t7vx, %r3 : f64, !llvm.ptr")
constant NumberText = NumberTextLoad + NumberTextStore
constant ElementLines = ("    %t1w = llvm.load %r0 : !llvm.ptr -> f64", "    %t1wc = func.call @strict_list_numbers(%t1w) : (f64) -> f64", "    llvm.store %t1wc, %r1 : f64, !llvm.ptr")
constant NumberedLines = ("    %t1n = llvm.load %r0 : !llvm.ptr -> f64", "    %t1nv = func.call @strict_text_number(%t1n) : (f64) -> f64", "    llvm.store %t1nv, %r1 : f64, !llvm.ptr")
constant ConcatenatedLoads = ("    %t2lx = llvm.load %r0 : !llvm.ptr -> f64", "    %t2r = llvm.load %r1 : !llvm.ptr -> f64", "    %t2rxc = func.constant @strict_number_text : (f64) -> f64")
constant ConcatenatedCalls = ("    %t2rx = func.call @strict_converted(%t2r, %t2rxc) : (f64, (f64) -> f64) -> f64", "    %t2c = func.call @strict_text_concat(%t2lx, %t2rx) : (f64, f64) -> f64", "    llvm.store %t2c, %r2 : f64, !llvm.ptr")
constant ConcatenatedLines = ConcatenatedLoads + ConcatenatedCalls
constant ShapeConverter = "    %t1dxc = func.constant @strict_automatic_Shape : (f64) -> f64"
constant QuotedNumber = MethodEntry("to", List(MemberEntry), "Strict/Number", (InstructionEntry.LoadNumber(0, 1), InstructionEntry.Return(0)))
constant Quoted = TypeEntry("Strict/Quoted", List(MemberEntry) + MemberEntry("text", "Strict/Text", List(InstructionEntry), false), List(MethodEntry) + QuotedNumber)
constant Unquoting = (InstructionEntry.Named(InstructionType.LoadVariableToRegister, 0, "quoted"), InstructionEntry.Invoke(1, ("Strict/Quoted", "to", "Strict/Number"), List(Number), 0))
constant SpelledLoads = ("    %t7lx = llvm.load %r3 : !llvm.ptr -> f64", "    %t7r = llvm.load %r2 : !llvm.ptr -> f64", "    %t7sa = llvm.load %spelled3 : !llvm.ptr -> f64")
constant SpelledWrites = ("    %t7sn = func.call @strict_text_written(%t7lx, %t7sa, %t7r) : (f64, f64, f64) -> f64", "    llvm.store %t7sn, %spelled3 : f64, !llvm.ptr", "    llvm.store %t7lx, %r4 : f64, !llvm.ptr")
constant Quoting = MlirFunction(List(TypeEntry) + Quoted, Quoted, MethodEntry("Run", List(MemberEntry) + MemberEntry("quoted", "Strict/Quoted", List(InstructionEntry), false), "None", Unquoting))
Temp(suffix Text) Text
	MlirTexts(Joined, 2).Temp("l") is "%t2l"
	MlirTexts(Joined, 7).IsNativeConversion(Joined.method.instructions(7), "Boolean") is false
	MlirTexts(Listing, 1).Elements(0, "List(Text)", "%r1").Length is 2
	MlirTexts(Listing, 1).Elements(0, "List(Boolean)", "%r1").Length is 2
	MlirTexts(Joined, 1).Described("", "d", "List(Text, Number)").Length is 4
	MlirTexts(Joined, 1).Described("", "d", "List(Text, Number)")(3).IndexOf("%t1dx = func.call @strict_pair_text(") > 0
	MlirStatements(function, position).Temp(suffix)
IsSum Boolean
	MlirTexts(Joined, 2).IsSum
	MlirTexts(Joined, 1).IsSum is false
	let entry = function.method.instructions(position)
	(entry.kind is InstructionType.Add) and MlirKinds(function).IsText(position + 1, entry.payload(3))
IsConversion Boolean
	MlirTexts(Joined, 7).IsConversion
	MlirTexts(Joined, 6).IsConversion is false
	MlirTexts(Listing, 1).IsConversion
	let entry = function.method.instructions(position)
	if entry.kind is not InstructionType.Invoke
		return false
	let decoder = PayloadDecoder(entry)
	let target = TypeEntry.ShortName(decoder.Text(4 + entry.payload(3)))
	let isTo = decoder.Text(2) is "to"
	let isPairCode = MlirCodes(function, position).IsPairCode(entry)
	isPairCode or (isTo and (target.StartsWith("List(") or IsNativeConversion(entry, target)))
IsNativeConversion(entry InstructionEntry, target Text) Boolean
	MlirTexts(Joined, 7).IsNativeConversion(Joined.method.instructions(7), "Number")
	MlirTexts(Joined, 7).IsNativeConversion(Joined.method.instructions(7), "Shape") is false
	MlirTexts(Joined, 7).IsNativeConversion(Joined.method.instructions(7), "Text")
	MlirTexts(Joined, 7).IsNativeConversion(Joined.method.instructions(7), "Character")
	MlirTexts(Quoting, 1).IsNativeConversion(Unquoting(1), "Number") is false
	let source = MlirKinds(function).KindOf(position, Instance(entry))
	let own = function.TypeOf(source).Callee("to", 0, target, List(Text))
	let isOwn = (source is not "Text") and (own.instructions.Length > 0)
	let isSame = MlirLayout(function).Represented(source) is MlirLayout(function).Represented(target)
	(target is "Text") or (isOwn is false) and ((target is in ("Number", "Character")) or isSame)
Instance(entry InstructionEntry) Number
	MlirTexts(Joined, 7).Instance(Joined.method.instructions(7)) is 1
	MlirTexts(Listing, 1).Instance(ToNumbers) is 0
	MlirTexts(Joined, 7).Converted(Joined.method.instructions(7)) is NumberText
	let countPosition = 5 + entry.payload(3)
	entry.payload(countPosition + 2 + entry.payload(countPosition))
Converted(entry InstructionEntry) Texts
	MlirTexts(Joined, 7).Converted(Joined.method.instructions(7)).Length is 4
	let instance = Instance(entry)
	let result = "%r" + entry.payload(0)
	let target = TypeEntry.ShortName(PayloadDecoder(entry).Text(4 + entry.payload(3)))
	if PayloadDecoder(entry).Text(2) is "Code"
		return MlirCodes(function, position).Coded(instance, result)
	if target is "Number"
		return Numbered(instance, result)
	if target.StartsWith("List(")
		return Elements(instance, target, result)
	let copied = function.Copied("%r" + instance, result, Temp("y"))
	target is in ("Text", "Character") then Textual(instance, target, result) else copied
Textual(instance Number, target Text, result Text) Texts
	MlirTexts(Joined, 7).Textual(1, "Text", "%r3").Length is 4
	Text.Combine(MlirTexts(Joined, 7).Textual(0, "Text", "%r3")).IndexOf("@strict_converted(%t7v, %t7vxc)") > 0
	MlirTexts(Joined, 7).Textual(0, "Text", "%r3")(1) is "    %t7vxc = func.constant @strict_text_itself : (f64) -> f64"
	MlirTexts(Joined, 7).Textual(0, "Text", "%r3")(0) is "    %t7v = llvm.load %r0 : !llvm.ptr -> f64"
	MlirTexts(Joined, 7).Textual(1, "Character", "%r3")(3).IndexOf("%t7vc = func.call @strict_text_at(%t7vx, %zero)") > 0
	MlirTexts(Joined, 7).Textual(1, "Character", "%r3").Last is "    llvm.store %t7vc, %r3 : f64, !llvm.ptr"
	let isText = Printable(MlirKinds(function).KindOf(position, instance)) is "Text"
	let loaded = function.Load(Temp("v"), "%r" + instance)
	let checked = MlirMemory(function, position).Converting(Temp("vx"), "strict_text_itself", Temp("v"))
	let text = isText then List(Text) + loaded + checked else TextBits(instance, "v")
	let first = MlirMemory(function, position).Called(Temp("vc"), "strict_text_at", (Temp("vx"), "%zero"))
	target is "Text" then text + function.Store(Temp("vx"), result) else text + first + function.Store(Temp("vc"), result)
Elements(instance Number, target Text, result Text) Texts
	Text.Combine(MlirTexts(Listing, 1).Elements(0, "List(Number)", "%r1")).IndexOf("@strict_list_numbers(") > 0
	MlirTexts(Listing, 1).Elements(0, "List(Number)", "%r1") is ElementLines
	let kinds = MlirKinds(function)
	let source = kinds.ElementKind(kinds.KindOf(position, instance))
	let element = kinds.ElementKind(target)
	let loaded = function.Load(Temp("w"), "%r" + instance)
	if (source is element) or (element is not in ("Number", "Text")) or (source is not in ("Number", "Text"))
		return (loaded, function.Store(Temp("w"), result))
	let helper = element is "Number" then "strict_list_numbers" else "strict_list_texts"
	let converted = MlirMemory(function, position).Called(Temp("wc"), helper, List(Text) + Temp("w"))
	(loaded, converted, function.Store(Temp("wc"), result))
Numbered(instance Number, target Text) Texts
	MlirTexts(Joined, 1).Numbered(0, "%r1").Length is 3
	MlirTexts(Joined, 1).Numbered(0, "%r1") is NumberedLines
	MlirTexts(Joined, 2).Numbered(1, "%r2").Length is 2
	MlirTexts(MlirKinds.Lettered.function, 2).Numbered(1, "%r2")(2).IndexOf("@strict_text_number(%t2nt)") > 0
	let loaded = function.Load(Temp("n"), "%r" + instance)
	let isCharacter = MlirKinds(function).KindOf(position, instance) is "Character"
	if (MlirKinds(function).IsText(position, instance) or isCharacter) is false
		return (loaded, function.Store(Temp("n"), target))
	let shown = MlirMemory(function, position).Called(Temp("nt"), "strict_character_text", List(Text) + Temp("n"))
	let text = isCharacter then Temp("nt") else Temp("n")
	let parsed = MlirMemory(function, position).Called(Temp("nv"), "strict_text_number", List(Text) + text)
	(isCharacter then (loaded, shown) else List(Text) + loaded) + parsed + function.Store(Temp("nv"), target)
TextBits(register Number, suffix Text) Texts
	MlirTexts(Joined, 3).TextBits(2, "b") is ("    %t3bx = llvm.load %r2 : !llvm.ptr -> f64")
	MlirTexts(Joined, 5).TextBits(2, "b").Last.IndexOf("@strict_converted(%t5b, %t5bxc)") > 0
	MlirTexts(Joined, 6).TextBits(1, "b").Length is 3
	let kind = Printable(MlirKinds(function).KindOf(position, register))
	if kind is "Text"
		return List(Text) + function.Load(Temp(suffix + "x"), "%r" + register)
	let loaded = function.Load(Temp(suffix), "%r" + register)
	let helper = Helper(kind)
	if helper is ""
		return Described(loaded, suffix, kind)
	List(Text) + loaded + MlirMemory(function, position).Converting(Temp(suffix + "x"), helper, Temp(suffix))
Printable(kind Text) Text
	MlirTexts(Joined, 0).Printable("Number") is "Number"
	MlirTexts(MlirLanes.Sample.function, 0).Printable("Rgb") is "Lanes3"
	MlirTexts(Joined, 0).Helper("Pair") is "strict_two_text"
	MlirTexts(Joined, 0).Helper("Flat") is "strict_flat_text"
	MlirTexts(Joined, 0).Helper("Lanes3") is "strict_lanes3_text"
	let own = function.TypeOf(kind).Callee("to", 0, "Text", List(Text))
	if (own.instructions.Length is 0) and MlirLanes(function, 0).IsPacked(kind)
		return "Lanes" + MlirLanes(function, 0).Members(kind).Length
	own.instructions.Length > 0 then kind else MlirLayout(function).Represented(kind)
Helper(kind Text) Text
	MlirTexts(Joined, 0).Helper("Boolean") is "strict_boolean_text"
	MlirTexts(Joined, 0).Helper("Error") is "strict_error_report"
	MlirTexts(Joined, 0).Helper("List(Text)") is "strict_list_text_text"
	MlirTexts(Joined, 0).Helper("Shape") is ""
	if kind is in ("Number", "Character", "Boolean")
		return "strict_" + kind.Lower + "_text"
	if kind is "Error"
		return "strict_error_report"
	if (kind is in ("Pair", "Flat")) or kind.StartsWith("Lanes")
		return kind is "Pair" then "strict_two_text" else "strict_" + kind.Lower + "_text"
	let suffix = kind.StartsWith("List(") then MlirKinds(function).ElementSuffix(kind) else ""
	suffix is "" then "" else "strict_list_text_" + suffix
Described(loaded Text, suffix Text, kind Text) Texts
	MlirTexts(Joined, 1).Described("", "d", "Shape").Index(ShapeConverter) is 1
	MlirTexts(Joined, 1).Described("", "d", "Logger").First.StartsWith("unsupported")
	MlirTexts(Joined, 1).Described("", "d", "List(Text, Number)").Last.IndexOf("@strict_pair_text(") > 0
	let type = function.TypeOf(kind)
	let method = type.Callee("to", 0, "Text", List(Text))
	let automatic = MlirAutomatic(function).Conversion(kind)
	if (method.instructions.Length is 0) and (MlirLayout(function).Paired(kind).Length > 0)
		return List(Text) + loaded + MlirAutomatic(function).Pairs(Temp(suffix + "x"), kind, Temp(suffix))
	if (method.instructions.Length is 0) and (automatic is "skip")
		return List(Text) + MlirStatements(function, position).Unsupported("text of " + kind)
	let symbol = method.instructions.Length is 0 then automatic else MlirFunction(function.types, type, method).Symbol
	List(Text) + loaded + MlirMemory(function, position).Converting(Temp(suffix + "x"), symbol, Temp(suffix))
Pointer(register Number, suffix Text) Texts
	MlirTexts(Joined, 3).Pointer(2, "b").Last is "    %t3bp = func.call @strict_ptr(%t3bs) : (f64) -> !llvm.ptr"
	MlirTexts(Joined, 3).Pointer(2, "b")(1) is "    %t3bs = func.call @strict_shown(%t3bx) : (f64) -> f64"
	MlirTexts(Joined, 3).Pointer(2, "b").Length is 3
	MlirTexts(Listing, 1).Converted(ToNumbers) is ElementLines
	MlirTexts(MlirKinds.Lettered.function, 2).Numbered(1, "%r2")(1).IndexOf("@strict_character_text(%t2n)") > 0
	let shown = MlirMemory(function, position).Called(Temp(suffix + "s"), "strict_shown", List(Text) + Temp(suffix + "x"))
	TextBits(register, suffix) + shown + MlirMemory(function, position).Pointer(Temp(suffix + "s"), suffix)
Concatenated(entry InstructionEntry) Texts
	MlirTexts(Joined, 2).Concatenated(Joined.method.instructions(2)).Length is 6
	MlirTexts(Joined, 2).Concatenated(Joined.method.instructions(2)) is ConcatenatedLines
	Text.Combine(MlirTexts(MlirLoops.Spelling.function, 7).Concatenated(MlirLoops.Spelled(7))).IndexOf("_concat") is -1
	if IsLetter and MlirLoops(function, function.method.LoopBeginOf(position)).IsSpelling
		return Spelled(entry)
	let operands = TextBits(entry.payload(1), "l") + TextBits(entry.payload(2), "r")
	let joined = MlirMemory(function, position).Called(Temp("c"), "strict_text_concat", (Temp("lx"), Temp("rx")))
	operands + joined + function.Store(Temp("c"), "%r" + entry.payload(3))
IsLetter Boolean
	MlirTexts(MlirLoops.Spelling.function, 7).IsLetter
	MlirTexts(MlirLoops.Spelling.function, 4).IsLetter is false
	MlirTexts(Joined, 2).IsLetter is false
	let steps = function.method.instructions
	let entry = steps(position)
	if (entry.kind is not InstructionType.Add) or (position + 1 >= steps.Length)
		return false
	let loaded = steps(position - 1)
	let stored = steps(position + 1)
	let isLoaded = (Text.Combine(loaded.texts) is "forResult") and (loaded.payload(0) is entry.payload(1))
	let isStored = (stored.kind is InstructionType.StoreRegisterToVariable) and (Text.Combine(stored.texts) is "forResult")
	isLoaded and isStored and (MlirKinds(function).KindOf(position, entry.payload(2)) is "Character")
IsMisspelled(begin Number) Boolean
	MlirTexts(MlirLoops.Spelling.function, 8).IsMisspelled(3) is false
	MlirTexts(MlirLoops.Spelling.function, 8).IsMisspelled(0)
	MlirTexts(MlirLoops.Spelling.function, 7).IsMisspelled(0) is false
	let entry = function.method.instructions(position)
	if (entry.kind is not InstructionType.StoreRegisterToVariable) or (Text.Combine(entry.texts) is not "forResult")
		return false
	(function.method.LoopBeginOf(position) is not begin) or (MlirTexts(function, position - 1).IsLetter is false)
Spelled(entry InstructionEntry) Texts
	MlirTexts(MlirLoops.Spelling.function, 7).Spelled(MlirLoops.Spelled(7)) is SpelledLoads + SpelledWrites
	let slot = "%spelled" + function.method.LoopBeginOf(position)
	let letter = function.Load(Temp("r"), "%r" + entry.payload(2))
	let loads = TextBits(entry.payload(1), "l") + letter + function.Load(Temp("sa"), slot)
	let operands = (Temp("lx"), Temp("sa"), Temp("r"))
	let written = MlirMemory(function, position).Called(Temp("sn"), "strict_text_written", operands)
	loads + written + function.Store(Temp("sn"), slot) + function.Store(Temp("lx"), "%r" + entry.payload(3))