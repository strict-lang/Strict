has function MlirFunction
has position Number
constant DotRow = (MemberEntry("row", "Strict/List(Number)", List(InstructionEntry), false), MemberEntry("first", "Strict/Number", List(InstructionEntry), false))
constant DotInput = (MemberEntry("input", "Strict/List(Number)", List(InstructionEntry), false), MemberEntry("start", "Strict/Number", List(InstructionEntry), false))
constant DotStart = (MethodCodegen.StoreConstant(InstructionEntry.LoadNumber(0, 0), "sum"), InstructionEntry.Named(InstructionType.LoadVariableToRegister, 0, "row"))
constant RowLoop = (InstructionEntry.Invoke(1, ("Strict/List(Number)", "Length", "Strict/Number"), List(Number), 0), InstructionEntry(InstructionType.CheckError, List(Text), List(Number) + 1), InstructionEntry.LoopBegin(1, -1))
constant DotOperands = (InstructionEntry.Named(InstructionType.LoadVariableToRegister, 2, "sum"), InstructionEntry.Named(InstructionType.LoadVariableToRegister, 3, "first"))
constant RowElement = (InstructionEntry.Named(InstructionType.LoadVariableToRegister, 4, "index"), InstructionEntry.Binary(InstructionType.Add, (3, 4, 5)), InstructionEntry(InstructionType.IndexCall, "row", (6, 5, -1)))
constant RowChecked = (InstructionEntry(InstructionType.CheckError, List(Text), List(Number) + 6), InstructionEntry.Named(InstructionType.LoadVariableToRegister, 7, "start"))
constant InputElement = (InstructionEntry.Named(InstructionType.LoadVariableToRegister, 8, "index"), InstructionEntry.Binary(InstructionType.Add, (7, 8, 9)), InstructionEntry(InstructionType.IndexCall, "input", (10, 9, -1)))
constant Accumulated = (InstructionEntry(InstructionType.CheckError, List(Text), List(Number) + 10), InstructionEntry.Binary(InstructionType.Multiply, (6, 10, 11)), InstructionEntry.Binary(InstructionType.Add, (2, 11, 12)))
constant SumStored = (InstructionEntry.Named(InstructionType.StoreRegisterToVariable, 12, "sum"), InstructionEntry.Jump(InstructionType.LoopEnd, 15))
constant SumReturned = (InstructionEntry.Named(InstructionType.LoadVariableToRegister, 0, "sum"), InstructionEntry.Return(0))
constant DotInstructions = DotStart + RowLoop + DotOperands + RowElement + RowChecked + InputElement + Accumulated + SumStored + SumReturned
constant Dotted = MethodEntry("Dot", DotRow + DotInput, "Strict/Number", DotInstructions)
constant BatchInputs = (MemberEntry("input", "Strict/List(Number)", List(InstructionEntry), false), MemberEntry("rows", "Strict/Number", List(InstructionEntry), false))
constant BatchSizes = (MemberEntry("width", "Strict/Number", List(InstructionEntry), false), MemberEntry("count", "Strict/Number", List(InstructionEntry), false))
constant CountLoop = (MlirLoops.Emptied, InstructionEntry.Named(InstructionType.LoadVariableToRegister, 0, "count"), InstructionEntry.LoopBegin(0, -1), InstructionEntry.Named(InstructionType.LoadVariableToRegister, 1, "index"))
constant WeightRow = (InstructionEntry.Named(InstructionType.LoadVariableToRegister, 2, "rows"), InstructionEntry.Binary(InstructionType.Modulo, (1, 2, 3)), InstructionEntry(InstructionType.IndexCall, "weights", (4, 3, -1)))
constant DotArguments = (InstructionEntry.LoadNumber(5, 0), InstructionEntry.Named(InstructionType.LoadVariableToRegister, 6, "input"), InstructionEntry.Named(InstructionType.LoadVariableToRegister, 7, "index"))
constant RowDivided = (InstructionEntry.Named(InstructionType.LoadVariableToRegister, 8, "rows"), InstructionEntry.Binary(InstructionType.Divide, (7, 8, 9)))
constant RowFloored = (InstructionEntry.Invoke(10, ("Strict/Number", "Floor", "Strict/Number"), List(Number), 9), InstructionEntry.Named(InstructionType.LoadVariableToRegister, 11, "width"))
constant DotCalled = (InstructionEntry.Binary(InstructionType.Multiply, (10, 11, 12)), InstructionEntry.Invoke(13, ("Strict/Tokens", "Dot", "Strict/Number", "row", "first", "input", "start"), (4, 5, 6, 12), -1))
constant ResultWritten = (InstructionEntry.Named(InstructionType.InvokeWriteToList, 13, "forResult"), InstructionEntry.Jump(InstructionType.LoopEnd, 15))
constant ResultReturned = (InstructionEntry.Named(InstructionType.LoadVariableToRegister, 0, "forResult"), InstructionEntry.Return(0))
constant BatchInstructions = CountLoop + WeightRow + DotArguments + RowDivided + RowFloored + DotCalled + ResultWritten + ResultReturned
constant Batched = MethodEntry("Sums", BatchInputs + BatchSizes, "Strict/List(Number)", BatchInstructions)
constant Tokens = TypeEntry("Strict/Tokens", List(MemberEntry) + MemberEntry("weights", "Strict/List(Numbers)", List(InstructionEntry), false), (Batched, Dotted))
constant Summing = MlirTokens(MlirFunction(List(TypeEntry) + Tokens, Tokens, Batched), 2)
constant GroupRow = (InstructionEntry.Named(InstructionType.LoadVariableToRegister, 20, "index"), InstructionEntry.Named(InstructionType.LoadVariableToRegister, 21, "rows"), InstructionEntry.Binary(InstructionType.Divide, (20, 21, 22)))
constant TileFloored = (InstructionEntry.LoadNumber(26, 64), InstructionEntry.Binary(InstructionType.Divide, (22, 26, 27)), InstructionEntry.Invoke(23, ("Strict/Number", "Floor", "Strict/Number"), List(Number), 27))
constant BaseWeight = (InstructionEntry(InstructionType.IndexCall, "bases", (24, 23, -1)), InstructionEntry.Binary(InstructionType.Add, (24, 3, 25)), InstructionEntry(InstructionType.IndexCall, "weights", (4, 25, -1)))
constant BaseRows = GroupRow + TileFloored + BaseWeight
constant Bases = MemberEntry("bases", "Strict/List(Number)", List(InstructionEntry), false)
constant Grouped = MlirTokens(MlirFunction(List(TypeEntry) + Tokens, Tokens, MethodEntry("Grouped", Batched.parameters + Bases, "Strict/List(Number)", Batched.instructions.Slice(0, 6) + BaseRows + Batched.instructions.Slice(7, 13))), 2)
constant Dotting = Batched.instructions(15)
constant GroupCode = Grouped.function.method.instructions
constant WrongOffsets = (InstructionEntry.Binary(InstructionType.Subtract, (24, 3, 25)), InstructionEntry.Binary(InstructionType.Add, (4, 3, 30)), InstructionEntry.Binary(InstructionType.Add, (4, 2, 30)), InstructionEntry.LoadNumber(5, 1))
constant WrongLoads = (Dotting, Batched.instructions(7), InstructionEntry.LoadNumber(6, 0), Dotting, Batched.instructions(8), InstructionEntry.Binary(InstructionType.Multiply, (10, 5, 12)), Dotting)
constant WrongProducts = (InstructionEntry.Binary(InstructionType.Multiply, (9, 11, 12)), InstructionEntry.Binary(InstructionType.Add, (10, 11, 12)), Batched.instructions(14), InstructionEntry.Binary(InstructionType.Add, (3, 3, 4)))
constant WrongModulo = (Dotting, InstructionEntry.Binary(InstructionType.Modulo, (1, 11, 3)), Batched.instructions(6), Dotting)
constant WrongTiles = (InstructionEntry.LoadNumber(26, 32), GroupCode(10), GroupCode(11), GroupCode(9), InstructionEntry.Binary(InstructionType.Multiply, (22, 26, 27)), GroupCode(11))
constant Varied = MlirTokens(MlirFunction(Grouped.function, method = MethodEntry(Grouped.function.method, instructions = GroupCode + WrongOffsets + WrongLoads + WrongProducts + WrongModulo + WrongTiles)), 2)
constant DotCode = Dotted.instructions
constant Overlong = MlirFunction(Summing.function, method = MethodEntry(Dotted, instructions = DotCode + DotCode(21)))
constant Ends = (InstructionType.LoadVariableToRegister, InstructionType.Invoke, InstructionType.LoadVariableToRegister, InstructionType.Return)
constant Tile = 64
constant StartLoad = 11
constant SumLoad = 20
constant Returned = 21
constant Marker = "    // reads the dot products of strict_device_tokens"
Call Number
	Summing.Call is 15
	MlirTokens(MlirGpu.Layering.function, 2).Call is -1
	MlirTokens(Summing.function, -1).Call is -1
	if position < 0
		return -1
	if MlirLoops(function, position).Collection is not ""
		return -1
	for Range(position + 1, function.method.LoopEndOf(position))
		if Names(value).Length >= 4
			return value
	-1
Names(at Number) Texts
	Summing.Names(15) is ("weights", "input", "width", "rows")
	Summing.Names(12).Length is 0
	if IsDotted(at) is false
		return List(Text)
	let entry = function.method.instructions(at)
	let first = 6 + entry.payload(3)
	let row = Row(entry.payload(first), at)
	let start = Start(entry.payload(first + 3), at)
	let input = Variable(entry.payload(first + 2), at)
	let isShared = (row.Length >= 2) and (start.Length is 2) and (input is not "")
	let isMatched = isShared and (row(1) is start.First) and IsConstant(entry.payload(first + 1), at, 0)
	isMatched then (row.First, input, start.Last) + row.Slice(1, row.Length - 1) else List(Text)
IsDotted(at Number) Boolean
	Summing.IsDotted(15)
	Summing.IsDotted(12) is false
	Summing.IsRowDot(Overlong) is false
	if function.method.instructions(at).kind is not InstructionType.Invoke
		return false
	let callees = MlirModule(function.types, "").Called(function, at)
	callees.Length is 1 then IsRowDot(callees.First) else false
IsRowDot(callee MlirFunction) Boolean
	Summing.IsRowDot(MlirFunction(Summing.function.types, Tokens, Dotted))
	Summing.IsRowDot(Summing.function) is false
	let names = callee.Parameters
	let code = callee.method.instructions
	if (names.Length is not 5) or (code.Length is not DotCode.Length)
		return false
	let dot = MlirDeviceDot(MlirFunction(callee, Float = "f32"), 4)
	if ((code(1).kind, code(2).kind, code(SumLoad).kind, code(Returned).kind) is not Ends) or (dot.IsDot is false)
		return false
	let loads = (code(1).texts(0), code(2).texts(1), code(6).texts(0), code(StartLoad).texts(0), code(SumLoad).texts(0))
	let expected = (names(1), "Length", names(2), names(4), code(5).texts(0))
	(code(4).payload(0) is code(2).payload(0)) and (loads is expected) and (dot.Operands is (names(1), names(3)))
Row(register Number, before Number) Texts
	Summing.Row(4, 15) is ("weights", "rows")
	Summing.Row(12, 15).Length is 0
	(Grouped.Row(24, 13).Length is 0) and (Varied.Row(4, 43).Length is 0)
	let groups = MlirGroups(function, position)
	let writer = groups.Writer(register, before)
	let read = function.method.instructions(writer < 0 then before else writer)
	if (writer < 0) or (read.kind is not InstructionType.IndexCall)
		return List(Text)
	let rows = Ranged(groups.Writer(read.payload(1), writer))
	rows.Length is 0 then rows else (List(Text) + read.texts(0)) + rows
Ranged(at Number) Texts
	Summing.Ranged(5) is List(Text) + "rows"
	Grouped.Ranged(13) is ("rows", "bases")
	Summing.Ranged(11).Length is 0
	let rows = Indexed(at, InstructionType.Modulo)
	if rows is not ""
		return List(Text) + rows
	let sum = function.method.instructions(at < 0 then position else at)
	if (at < 0) or (sum.kind is not InstructionType.Add)
		return List(Text)
	let modulo = Indexed(MlirGroups(function, position).Writer(sum.payload(2), at), InstructionType.Modulo)
	let bases = Based(sum.payload(1), at, modulo)
	(modulo is "") or (bases is "") then List(Text) else (modulo, bases)
Based(register Number, before Number, rows Text) Text
	Grouped.Based(24, 13, "rows") is "bases"
	Grouped.Based(24, 13, "width") is ""
	Grouped.Based(99, 12, "") is ""
	Grouped.Based(23, 12, "") is ""
	let groups = MlirGroups(function, position)
	let writer = groups.Writer(register, before)
	let read = function.method.instructions(writer < 0 then before else writer)
	if (writer < 0) or (read.kind is not InstructionType.IndexCall)
		return ""
	Tiled(groups.Writer(read.payload(1), writer)) is rows then read.texts(0) else ""
Start(register Number, before Number) Texts
	Summing.Start(12, 15) is ("rows", "width")
	Summing.Start(4, 15).Length is 0
	(Varied.Start(12, 38).Length is 0) and (Varied.Start(12, 40).Length is 0)
	Varied.Start(12, 41).Length is 0
	let groups = MlirGroups(function, position)
	let writer = groups.Writer(register, before)
	let product = function.method.instructions(writer < 0 then before else writer)
	if (writer < 0) or (product.kind is not InstructionType.Multiply)
		return List(Text)
	let rows = Floored(groups.Writer(product.payload(1), writer))
	let width = Variable(product.payload(2), writer)
	(rows is "") or (width is "") then List(Text) else (rows, width)
Floor(at Number) Number
	Summing.Floor(12) is 11
	Summing.Floor(11) is -1
	Summing.Floor(15) is -1
	let floor = function.method.instructions(at < 0 then position else at)
	if (at < 0) or (floor.kind is not InstructionType.Invoke)
		return -1
	if floor.texts(1) is not "Floor"
		return -1
	MlirGroups(function, position).Writer(MlirDeviceCalls(function, at, function).Register(floor), at)
Floored(at Number) Text
	Summing.Floored(12) is "rows"
	Summing.Floored(11) is ""
	Grouped.Names(23) is ("weights", "input", "width", "rows", "bases")
	(Varied.Names(32).Length is 0) and (Varied.Names(35).Length is 0)
	(Varied.Names(38).Length is 0) and (Varied.Names(43).Length is 0)
	Varied.Names(46).Length is 0
	Indexed(Floor(at), InstructionType.Divide)
Tiled(at Number) Text
	Grouped.Tiled(11) is "rows"
	Summing.Tiled(12) is ""
	(Varied.Tiled(49) is "") and (Varied.Tiled(52) is "")
	let quotient = Floor(at)
	let divide = function.method.instructions(quotient < 0 then position else quotient)
	if (quotient < 0) or (divide.kind is not InstructionType.Divide)
		return ""
	let groups = MlirGroups(function, position)
	let tile = groups.Writer(divide.payload(2), quotient)
	let tiles = function.method.instructions(tile < 0 then position else tile)
	let isTile = (tile >= 0) and (tiles.payload is (divide.payload(2), 1, Tile))
	isTile then Indexed(groups.Writer(divide.payload(1), quotient), InstructionType.Divide) else ""
Indexed(at Number, kind Number) Text
	Summing.Indexed(5, InstructionType.Modulo) is "rows"
	Summing.Indexed(11, InstructionType.Modulo) is ""
	Summing.Indexed(14, InstructionType.Multiply) is ""
	Varied.Ranged(28).Length is 0
	(Varied.Ranged(29).Length is 0) and (Varied.Ranged(30).Length is 0)
	let entry = function.method.instructions(at < 0 then position else at)
	if (at < 0) or (entry.kind is not kind)
		return ""
	Variable(entry.payload(1), at) is "index" then Variable(entry.payload(2), at) else ""
Variable(register Number, before Number) Text
	Summing.Variable(6, 15) is "input"
	Summing.Variable(12, 15) is ""
	Summing.Variable(99, 4) is ""
	Summing.Variable(4, 15) is ""
	let writer = MlirGroups(function, position).Writer(register, before)
	let entry = function.method.instructions(writer < 0 then before else writer)
	(writer >= 0) and (entry.kind is InstructionType.LoadVariableToRegister) then entry.texts(0) else ""
IsConstant(register Number, before Number, number Number) Boolean
	Summing.IsConstant(5, 15, 0)
	Summing.IsConstant(4, 15, 0) is false
	Summing.IsConstant(5, 7, 0) is false
	Summing.IsConstant(5, 15, 1) is false
	let writer = MlirGroups(function, position).Writer(register, before)
	let entry = function.method.instructions(writer < 0 then before else writer)
	let isLoad = (writer >= 0) and (entry.kind is InstructionType.LoadConstantToRegister)
	isLoad and (entry.payload is InstructionEntry.LoadNumber(register, number).payload)
