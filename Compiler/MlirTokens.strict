has function MlirFunction
has position Number
constant Dotted = MethodEntry("Dot", (MemberEntry("row", "Strict/List(Number)", List(InstructionEntry), false), MemberEntry("first", "Strict/Number", List(InstructionEntry), false), MemberEntry("input", "Strict/List(Number)", List(InstructionEntry), false), MemberEntry("start", "Strict/Number", List(InstructionEntry), false)), "Strict/Number", (MethodCodegen.StoreConstant(InstructionEntry.LoadNumber(0, 0), "sum"), InstructionEntry.Named(InstructionType.LoadVariableToRegister, 0, "row"), InstructionEntry.Invoke(1, ("Strict/List(Number)", "Length", "Strict/Number"), List(Number), 0), InstructionEntry(InstructionType.CheckError, List(Text), List(Number) + 1), InstructionEntry.LoopBegin(1, -1), InstructionEntry.Named(InstructionType.LoadVariableToRegister, 2, "sum"), InstructionEntry.Named(InstructionType.LoadVariableToRegister, 3, "first"), InstructionEntry.Named(InstructionType.LoadVariableToRegister, 4, "index"), InstructionEntry.Binary(InstructionType.Add, (3, 4, 5)), InstructionEntry(InstructionType.IndexCall, "row", (6, 5, -1)), InstructionEntry(InstructionType.CheckError, List(Text), List(Number) + 6), InstructionEntry.Named(InstructionType.LoadVariableToRegister, 7, "start"), InstructionEntry.Named(InstructionType.LoadVariableToRegister, 8, "index"), InstructionEntry.Binary(InstructionType.Add, (7, 8, 9)), InstructionEntry(InstructionType.IndexCall, "input", (10, 9, -1)), InstructionEntry(InstructionType.CheckError, List(Text), List(Number) + 10), InstructionEntry.Binary(InstructionType.Multiply, (6, 10, 11)), InstructionEntry.Binary(InstructionType.Add, (2, 11, 12)), InstructionEntry.Named(InstructionType.StoreRegisterToVariable, 12, "sum"), InstructionEntry.Jump(InstructionType.LoopEnd, 15), InstructionEntry.Named(InstructionType.LoadVariableToRegister, 0, "sum"), InstructionEntry.Return(0)))
constant Batched = MethodEntry("Sums", (MemberEntry("input", "Strict/List(Number)", List(InstructionEntry), false), MemberEntry("rows", "Strict/Number", List(InstructionEntry), false), MemberEntry("width", "Strict/Number", List(InstructionEntry), false), MemberEntry("count", "Strict/Number", List(InstructionEntry), false)), "Strict/List(Number)", (MlirLoops.Emptied, InstructionEntry.Named(InstructionType.LoadVariableToRegister, 0, "count"), InstructionEntry.LoopBegin(0, -1), InstructionEntry.Named(InstructionType.LoadVariableToRegister, 1, "index"), InstructionEntry.Named(InstructionType.LoadVariableToRegister, 2, "rows"), InstructionEntry.Binary(InstructionType.Modulo, (1, 2, 3)), InstructionEntry(InstructionType.IndexCall, "weights", (4, 3, -1)), InstructionEntry.LoadNumber(5, 0), InstructionEntry.Named(InstructionType.LoadVariableToRegister, 6, "input"), InstructionEntry.Named(InstructionType.LoadVariableToRegister, 7, "index"), InstructionEntry.Named(InstructionType.LoadVariableToRegister, 8, "rows"), InstructionEntry.Binary(InstructionType.Divide, (7, 8, 9)), InstructionEntry.Invoke(10, ("Strict/Number", "Floor", "Strict/Number"), List(Number), 9), InstructionEntry.Named(InstructionType.LoadVariableToRegister, 11, "width"), InstructionEntry.Binary(InstructionType.Multiply, (10, 11, 12)), InstructionEntry.Invoke(13, ("Strict/Tokens", "Dot", "Strict/Number", "row", "first", "input", "start"), (4, 5, 6, 12), -1), InstructionEntry.Named(InstructionType.InvokeWriteToList, 13, "forResult"), InstructionEntry.Jump(InstructionType.LoopEnd, 15), InstructionEntry.Named(InstructionType.LoadVariableToRegister, 0, "forResult"), InstructionEntry.Return(0)))
constant Tokens = TypeEntry("Strict/Tokens", List(MemberEntry) + MemberEntry("weights", "Strict/List(Numbers)", List(InstructionEntry), false), (Batched, Dotted))
constant Summing = MlirTokens(MlirFunction(List(TypeEntry) + Tokens, Tokens, Batched), 2)
constant Dotting = Batched.instructions(15)
constant Ends = (InstructionType.LoadVariableToRegister, InstructionType.Invoke, InstructionType.LoadVariableToRegister, InstructionType.Return)
constant Signature = " : (!llvm.ptr, i64, f64, f64, f64, f64, f64) -> f64"
constant Marker = "    // reads the dot products of strict_device_tokens"
Call Number
	Summing.Call is 15
	MlirTokens(MlirGpu.Layering.function, 2).Call is -1
	if position < 0
		return -1
	if MlirLoops(function, position).Collection is not ""
		return -1
	for Range(position + 1, function.method.LoopEndOf(position))
		if Names(value).Length is 4
			return value
	-1
Names(at Number) Texts
	Summing.Names(15) is ("weights", "input", "width", "rows")
	Summing.Names(12).Length is 0
	if IsDotted(at) is false
		return List(Text)
	let entry = function.method.instructions(at)
	let first = 6 + entry.payload(3)
	let row = Row(entry.payload(first), at)
	let start = Start(entry.payload(first + 3), at)
	let input = Variable(entry.payload(first + 2), at)
	let isShared = (row.Length is 2) and (start.Length is 2) and (input is not "")
	let isMatched = isShared and (row.Last is start.First) and IsZero(entry.payload(first + 1), at)
	isMatched then (row.First, input, start.Last, row.Last) else List(Text)
IsDotted(at Number) Boolean
	Summing.IsDotted(15)
	Summing.IsDotted(12) is false
	if function.method.instructions(at).kind is not InstructionType.Invoke
		return false
	let callees = MlirModule(function.types, "").Called(function, at)
	callees.Length is 1 then IsRowDot(callees.First) else false
IsRowDot(callee MlirFunction) Boolean
	Summing.IsRowDot(MlirFunction(Summing.function.types, Tokens, Dotted))
	Summing.IsRowDot(Summing.function) is false
	let names = callee.Parameters
	let code = callee.method.instructions
	if (names.Length is not 5) or (code.Length is not 22)
		return false
	let dot = MlirDeviceDot(MlirFunction(callee, Float = "f32"), 4)
	if ((code(1).kind, code(2).kind, code(20).kind, code(21).kind) is not Ends) or (dot.IsDot is false)
		return false
	let loads = (code(1).texts(0), code(2).texts(1), code(6).texts(0), code(11).texts(0), code(20).texts(0))
	let expected = (names(1), "Length", names(2), names(4), code(5).texts(0))
	(code(4).payload(0) is code(2).payload(0)) and (loads is expected) and (dot.Operands is (names(1), names(3)))
Row(register Number, before Number) Texts
	Summing.Row(4, 15) is ("weights", "rows")
	Summing.Row(12, 15).Length is 0
	let groups = MlirGroups(function, position)
	let writer = groups.Writer(register, before)
	let read = function.method.instructions(writer < 0 then before else writer)
	if (writer < 0) or (read.kind is not InstructionType.IndexCall)
		return List(Text)
	let rows = Indexed(groups.Writer(read.payload(1), writer), InstructionType.Modulo)
	rows is "" then List(Text) else (read.texts(0), rows)
Start(register Number, before Number) Texts
	Summing.Start(12, 15) is ("rows", "width")
	Summing.Start(4, 15).Length is 0
	let groups = MlirGroups(function, position)
	let writer = groups.Writer(register, before)
	let product = function.method.instructions(writer < 0 then before else writer)
	if (writer < 0) or (product.kind is not InstructionType.Multiply)
		return List(Text)
	let rows = Floored(groups.Writer(product.payload(1), writer))
	let width = Variable(product.payload(2), writer)
	(rows is "") or (width is "") then List(Text) else (rows, width)
Floored(at Number) Text
	Summing.Floored(12) is "rows"
	Summing.Floored(11) is ""
	let floor = function.method.instructions(at < 0 then position else at)
	if (at < 0) or (floor.kind is not InstructionType.Invoke)
		return ""
	if floor.texts(1) is not "Floor"
		return ""
	let instance = MlirDeviceCalls(function, at, function).Register(floor)
	Indexed(MlirGroups(function, position).Writer(instance, at), InstructionType.Divide)
Indexed(at Number, kind Number) Text
	Summing.Indexed(5, InstructionType.Modulo) is "rows"
	Summing.Indexed(11, InstructionType.Modulo) is ""
	let entry = function.method.instructions(at < 0 then position else at)
	if (at < 0) or (entry.kind is not kind)
		return ""
	Variable(entry.payload(1), at) is "index" then Variable(entry.payload(2), at) else ""
Variable(register Number, before Number) Text
	Summing.Variable(6, 15) is "input"
	Summing.Variable(12, 15) is ""
	let writer = MlirGroups(function, position).Writer(register, before)
	let entry = function.method.instructions(writer < 0 then before else writer)
	(writer >= 0) and (entry.kind is InstructionType.LoadVariableToRegister) then entry.texts(0) else ""
IsZero(register Number, before Number) Boolean
	Summing.IsZero(5, 15)
	Summing.IsZero(4, 15) is false
	let writer = MlirGroups(function, position).Writer(register, before)
	let entry = function.method.instructions(writer < 0 then before else writer)
	(writer >= 0) and (entry.kind is InstructionType.LoadConstantToRegister) and (entry.payload is (register, 1, 0))
Devices(end Number) List(MlirFunction)
	Summing.Devices(17).Length is 0
	let call = Call
	let before = MlirGpu.Devices(function, position + 1, call < 0 then end else call, 0)
	call < 0 then before else before + MlirGpu.Devices(function, call + 1, end, 0)
Sourced Texts
	MlirTokens(MlirGpu.Doubling.function, 2).Sourced is ("%t2v", "1")
	Summing.Sourced is ("%t2gb", "1")
	let gpu = MlirGpu(function, position)
	if Call >= 0
		return (gpu.Temp("gb"), "1")
	let collection = MlirLoops(function, position).Collection
	let number = collection is "" then "0" else collection is "List(Number)" then "1" else "2"
	(collection is "" then gpu.Temp("b") else gpu.Temp("v"), number)
Launched Texts
	Summing.Launched.Last is "  ^loop2kernel:"
	if Call < 0
		return List(Text)
	let gpu = MlirGpu(function, position)
	let biased = MlirBiased(function, position)
	mutable lines = List(Mutable(Text))
	mutable operands = gpu.Temp("gp") + ", " + gpu.Temp("gc")
	for Names(Call)
		lines = lines + function.Load(gpu.Temp("gh" + index), "%v_" + value)
		operands = operands + ", " + gpu.Temp("gh" + index)
	let call = "    " + gpu.Temp("gb") + " = func.call @strict_gpu_tokens(" + operands + ", " + biased.Operand + ")"
	(lines + biased.Loaded + (call + Signature) + Checked) + biased.Fused
Checked Texts
	Summing.Checked.First is "    %t2gn = arith.cmpf une, %t2gb, %zero : f64"
	let gpu = MlirGpu(function, position)
	let check = "    " + gpu.Temp("gn") + " = arith.cmpf une, " + gpu.Temp("gb") + ", %zero : f64"
	let branch = "    cf.cond_br " + gpu.Temp("gn") + ", ^loop" + position + "tokens, ^loop" + position + "host"
	(check, branch, "  ^loop" + position + "tokens:")
Read(at Number) Texts
	Summing.Read(15).First is Marker
	Summing.Read(15)(1).StartsWith("    %d15t = func.call @strict_device_element(%source, %bits, %at, %count)")
	let read = MlirTyped(function.Float).Read("%d" + at + "t", "(%source, %bits, %at, %count)")
	(Marker, read, function.Store("%d" + at + "t", "%r" + function.method.instructions(at).payload(0)))
