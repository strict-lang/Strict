has type Text
constant Integer = MlirTyped("i64")
constant Pointer = MlirTyped("!llvm.ptr")
constant Double = MlirTyped("f64")
constant Single = MlirTyped("f32")
constant Parts = ("d", "n", "b")
constant Types = ("!llvm.ptr", "i64", "i64")
constant PowerCall = "@strict_device_powers(%failed, %a, %b) : (!llvm.ptr, f32, f32) -> f32"
constant Elements = " : (!llvm.ptr, i64, i64, i64) -> "
Load(target Text, slot Text) Text
	Integer.Load("%a", "%s") is "    %a = llvm.load %s : !llvm.ptr -> i64"
	"    " + target + " = llvm.load " + slot + " : !llvm.ptr -> " + type
Store(stored Text, slot Text) Text
	Integer.Store("%a", "%s") is "    llvm.store %a, %s : i64, !llvm.ptr"
	"    llvm.store " + stored + ", " + slot + " : " + type + ", !llvm.ptr"
Constant(target Text, literal Text) Text
	Integer.Constant("%a", "0") is "    %a = arith.constant 0 : i64"
	"    " + target + " = arith.constant " + literal + " : " + type
Suffix Text
	Single.Suffix is "s"
	Double.Suffix is ""
	type is "f32" then "s" else ""
Read(result Text, operands Text) Text
	Single.Read("%e", "(%d)").EndsWith("@strict_device_elements(%d) : (!llvm.ptr, i64, i64, i64) -> f32")
	"    " + result + " = func.call @strict_device_element" + Suffix + operands + Elements + type
Summed(result Text, sum Text) Text
	Single.Summed("%y", "%x") is "    %y = func.call @strict_device_sums(%x) : (f32) -> f32"
	"    " + result + " = func.call @strict_device_sum" + Suffix + "(" + sum + ") : (" + type + ") -> " + type
Shuffled(result Text, source Text, offset Text) Text
	Single.Shuffled("%y", "%x", "%o") is "    %y = func.call @strict_device_shuffles(%x, %o) : (f32, i32) -> f32"
	let call = "    " + result + " = func.call @strict_device_shuffle" + Suffix + "(" + source + ", " + offset + ")"
	call + " : (" + type + ", i32) -> " + type
Number(target Text, hex Text) Texts
	Double.Number("%c", "0x0") is ("    %c = arith.constant 0x0 : f64")
	Single.Number("%c", "0x0").Last is "    %c = arith.truncf %cw : f64 to f32"
	if type is "f64"
		return List(Text) + Constant(target, hex)
	(Double.Constant(target + "w", hex), "    " + target + " = arith.truncf " + target + "w : f64 to " + type)
Operated(result Text, kind Number, operands Text) Text
	Single.Operated("%c", InstructionType.Power, "%a, %b").EndsWith(PowerCall)
	Double.Operated("%c", InstructionType.Modulo, "%a, %b") is "    %c = arith.remf %a, %b : f64"
	Double.Operated("%c", InstructionType.Add, "%a, %b") is "    %c = arith.addf %a, %b : f64"
	let power = " = func.call @strict_device_power" + Suffix + "(%failed, " + operands + ") : (!llvm.ptr, "
	if kind is InstructionType.Power
		return "    " + result + power + type + ", " + type + ") -> " + type
	let operation = kind is InstructionType.Modulo then "remf" else MlirStatements.Copy.Operation(kind)
	"    " + result + " = arith." + operation + " " + operands + " : " + type
Floored(result Text, number Text) Text
	Single.Floored("%f", "%x") is "    %f = llvm.intr.floor(%x) : (f32) -> f32"
	"    " + result + " = llvm.intr.floor(" + number + ") : (" + type + ") -> " + type
Given(source Text, slot Text) Texts
	Double.Given("%f", "%s") is ("    llvm.store %f, %s : f64, !llvm.ptr")
	Single.Given("%f", "%s").First is "    %fs = arith.truncf %f : f64 to f32"
	if type is "f64"
		return List(Text) + Store(source, slot)
	("    " + source + "s = arith.truncf " + source + " : f64 to " + type, Store(source + "s", slot))