has function MlirFunction
has position Number
constant Validating = MethodEntry("Validated", List(MemberEntry), "Strict/Shape", (InstructionEntry.Named(InstructionType.LoadVariableToRegister, 0, "width"), InstructionEntry.Return(0)))
constant WidthMade = (InstructionEntry.Named(InstructionType.LoadVariableToRegister, 0, "width"), InstructionEntry.Invoke(1, ("Strict/Shape", "from", "Strict/Shape", "width"), 0, -1))
constant Keeping = MethodEntry("Kept", List(MemberEntry), "Strict/Shape", WidthMade + MlirStructs.Validating + InstructionEntry.Return(2))
constant Validator = TypeEntry("Strict/Shape", MlirFunction.Shape.members, (Validating, Keeping))
constant Kept = MlirValidated(MlirFunction(List(TypeEntry) + Validator, Validator, Keeping), 2)
constant Changed = MlirValidated(MlirFunction(List(TypeEntry) + Validator, Validator, MlirStructs.Checker.function.method), 2)
constant Sixteens = (MlirLoops.Emptied, InstructionEntry.LoadNumber(0, 16), InstructionEntry.LoopBegin(0, -1))
constant Pushed = (MlirCounter.IndexLoad, InstructionEntry.Named(InstructionType.InvokeWriteToList, 1, "forResult"))
constant ForResult = InstructionEntry.Named(InstructionType.LoadVariableToRegister, 0, "forResult")
constant Counted = Sixteens + Pushed + InstructionEntry.Jump(InstructionType.LoopEnd, 3) + ForResult
constant Counting = MethodEntry("Counted", List(MemberEntry), "Strict/List(Number)", Counted + InstructionEntry.Return(0))
constant SixteenMember = MemberEntry("numbers", "Strict/List(Number)", List(InstructionEntry), false, 32, 16)
constant CountCall = InstructionEntry.Invoke(0, ("Strict/Sized", "Counted", "Strict/List(Number)"), List(Number), -1)
constant FromCall = InstructionEntry.Invoke(1, ("Strict/Sized", "from", "Strict/Sized", "numbers"), 0, -1)
constant SizedCheck = InstructionEntry.Invoke(2, ("Strict/Sized", "Validated", "Strict/Sized"), List(Number), 1)
constant Sizing = MethodEntry("Sized", List(MemberEntry), "Strict/Sized", (CountCall, FromCall, SizedCheck))
constant NumbersRead = InstructionEntry.Named(InstructionType.LoadVariableToRegister, 0, "numbers")
constant SizedValidated = MethodEntry("Validated", List(MemberEntry), "Strict/Sized", (NumbersRead, InstructionEntry.Return(0)))
constant Sized = TypeEntry("Strict/Sized", List(MemberEntry) + SixteenMember, (SizedValidated, Counting, Sizing))
constant Sizes = MlirValidated(MlirFunction(List(TypeEntry) + Sized, Sized, Sizing), 2)
IsKnown Boolean
	Kept.IsKnown
	Changed.IsKnown is false
	Sizes.IsKnown
	let entry = function.method.instructions(position)
	let isOwn = (entry.kind is InstructionType.Invoke) and (entry.texts(1) is "Validated")
	if (isOwn is false) or (entry.texts(0) is not function.type.Name)
		return false
	let writer = MlirKinds(function).Writer(position, entry.payload.Last)
	let made = writer >= 0 then function.method.instructions(writer) else entry
	(made.kind is InstructionType.Invoke) and (made.texts(1) is "from") and IsUnchanged(made, writer)
IsUnchanged(made InstructionEntry, at Number) Boolean
	Kept.IsUnchanged(Keeping.instructions(1), 1)
	Changed.IsUnchanged(MlirStructs.Checker.function.method.instructions(1), 1) is false
	for Checked(function.type)
		if IsKept(made, at, value) is false
			return false
	true
Checked(owner TypeEntry) Texts
	Kept.Checked(Validator) is ("width")
	let names = MlirInstances(function, 0).StoredNames(owner)
	for owner.methods
		if value.Name is "Validated"
			return Read(value, names)
	List(Text)
Read(validation MethodEntry, names Texts) Texts
	Kept.Read(Validating, ("width", "height")) is ("width")
	Kept.Read(Keeping, ("width")) is ("width", "?", "?")
	Kept.Read(MethodEntry(Keeping, declaredType = "Strict/Text"), ("width")) is ("width")
	for validation.instructions
		if (value.kind is InstructionType.LoadVariableToRegister) and (value.texts(0) is in names)
			value.texts(0)
		else if (value.kind is InstructionType.Invoke) and (value.texts(0) is validation.declaredType)
			"?"
IsKept(made InstructionEntry, at Number, name Text) Boolean
	Kept.IsKept(Keeping.instructions(1), 1, "width")
	Changed.IsKept(MlirStructs.Checker.function.method.instructions(1), 1, "width") is false
	let named = Invocation(made, List(VmValue), VmValue.None).ParameterNames.Index(name)
	let index = named < 0 then MlirInstances(function, 0).StoredNames(function.type).Index(name) else named
	if (index < 0) or (index >= PayloadDecoder(made).ArgumentCount)
		return false
	let source = MlirKinds(function).Writer(at, PayloadDecoder(made).Arguments(index))
	let loaded = source >= 0 then function.method.instructions(source) else made
	let isMember = (loaded.kind is InstructionType.LoadVariableToRegister) and (loaded.texts(0) is name)
	let isCopied = isMember and (name is not in function.method.ParameterNames) and MlirParameters(function).IsFixed(name)
	isCopied or ((Count(name) > 0) and (MlirValidated(function, source).Gathered is Count(name)))
Count(name Text) Number
	Sizes.Count("numbers") is 16
	Kept.Count("width") is 0
	for function.type.members
		if value.Name is name
			return value.Count
	0
Returned(call InstructionEntry) Number
	Sizes.Returned(CountCall) is 16
	Sizes.Returned(FromCall) is 0
	let name = call.kind is InstructionType.Invoke then call.texts(1) else "from"
	if name is "from"
		return 0
	let decoder = PayloadDecoder(call)
	let type = MlirLayout(function).Owner(function.TypeOf(decoder.Text(1)), name)
	MlirValidated(MlirFunction(function.types, type, decoder.Callee(type)), 0).Collected
Gathered Number
	MlirValidated(MlirBytes.Flattening.function, 6).Gathered is 3
	MlirValidated(MlirBytes.Flattening.function, 5).Gathered is 0
	MlirValidated(Sizes.function, 0).Gathered is 16
	if position < 0
		return 0
	let steps = function.method.instructions
	let isLoaded = (position > 0) and (steps(position).kind is InstructionType.LoadVariableToRegister)
	let isGathered = isLoaded and (steps(position - 1).kind is InstructionType.LoopEnd)
	isGathered then MlirBytes(function, function.method.LoopBeginOf(position - 1)).Flattened else Returned(steps(position))
Collected Number
	MlirValidated(MlirFunction(List(TypeEntry) + Sized, Sized, Counting), 0).Collected is 16
	Sizes.Collected is 0
	let steps = function.method.instructions
	let end = steps.Length - 3
	let ending = end > 0 then steps(end) else steps.Last
	let isRead = (end > 0) and ("forResult" is in steps(steps.Length - 2).texts)
	if (ending.kind is not InstructionType.LoopEnd) or (isRead is false) or (steps.Last.kind is not InstructionType.Return)
		return 0
	let begin = function.method.LoopBeginOf(end)
	let isRaw = MlirKernel(function, begin).IsSimple and MlirLoops(function, begin).IsCollecting
	isRaw then MlirCounter(function, begin).Constant(steps(begin).payload(0), -1) else 0
