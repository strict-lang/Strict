has function MlirFunction
constant Add = ForeignMethod.Add
constant Adder = MlirFunction(List(TypeEntry), TypeEntry("Strict/Examples/NativeAdd/Adder", List(MemberEntry), List(MethodEntry) + Add), Add)
constant Adding = "%p0: f64, %p1: f64, %p2: f64"
constant Doubles = MethodEntry("Doubled", List(MemberEntry) + MemberEntry("numbers", "Strict/List(Number)", List(InstructionEntry), false), "Strict/List(Number)", List(InstructionEntry))
constant Names = MethodEntry("Named", List(MemberEntry) + MemberEntry("name", "Strict/Text", List(InstructionEntry), false), "Strict/Number", List(InstructionEntry))
constant Namer = MlirFunction(List(TypeEntry), TypeEntry("Strict/Examples/NativeAdd/Adder", List(MemberEntry), List(MethodEntry) + Names), Names)
constant Doubler = MlirFunction(List(TypeEntry), TypeEntry("Strict/Examples/NativeAdd/Adder", List(MemberEntry), List(MethodEntry) + Doubles), Doubles)
constant Next = ForeignMethod.Next
constant Counter = ForeignMethod.Counter
constant Counting = MlirFunction(List(TypeEntry), Counter, Next)
constant Splits = MethodEntry("Split", Doubles.parameters, "Strict/List(Numbers)", List(InstructionEntry))
constant Splitter = MlirFunction(List(TypeEntry), Doubler.type, Splits)
constant Started = ForeignMethod.Started
constant Closed = MethodEntry("Close", List(MemberEntry), "None", List(InstructionEntry))
constant Closing = MlirFunction(List(TypeEntry), Adder.type, Closed)
IsForeign Boolean
	MlirForeign(Adder).IsForeign and MlirForeign(Counting).IsForeign
	ForeignMethod(function.type, function.method).IsForeign
Symbol Text
	MlirForeign(Adder).Symbol is "Adder_Add"
	function.type.JustName + "_" + function.method.Name
Wrapper Text
	MlirForeign(Adder).Wrapper is "Adder_Add_foreign"
	Symbol + "_foreign"
Declaration Texts
	MlirForeign(Adder).Declaration.First is "  func.func private @Adder_Add(f64, f64, f64) -> f64"
	MlirForeign(Adder).Declaration.Index("  func.func private @Adder_Add_foreign(" + Adding + ") -> f64 {") is 1
	MlirForeign(Doubler).Declaration.Length is 7
	if MlirTraits(function.types).Implementers(function).Length > 0
		return MlirTraits(function.types).Dispatch(function)
	types = Text.Combine(MlirCalls(function, 0).ArgumentTypes(function.Parameters.Length), ", ")
	header = "  func.func private @" + Wrapper + "(" + Parameters + ") -> f64 {"
	call = "    %result = func.call @" + Symbol + "(" + Arguments + ") : (" + types + ") -> f64"
	declaration = "  func.func private @" + Symbol + "(" + types + ") -> f64"
	(List(Text) + declaration + header) + Converted + call + Returned + "  }"
Parameters Text
	MlirForeign(Adder).Parameters is Adding
	mutable parameters = List(Mutable(Text))
	for function.Parameters
		parameters.Add("%p" + index + ": f64")
	Text.Combine(parameters, ", ")
Converted Texts
	MlirForeign(Doubler).Converted is List(Text) + "    %c1 = func.call @strict_list_ready(%p1) : (f64) -> f64"
	MlirForeign(Namer).Converted is List(Text) + "    %c1 = func.call @strict_text_flat(%p1) : (f64) -> f64"
	mutable lines = List(Mutable(Text))
	for function.method.parameters
		call = " = func.call @" + Converter(value.typeName) + "(%p" + (index + 1) + ") : (f64) -> f64"
		if Converter(value.typeName) is not ""
			lines.Add("    %c" + (index + 1) + call)
	lines
Converter(typeName Text) Text
	MlirForeign(Adder).Converter("Strict/Text") is "strict_text_flat"
	MlirForeign(Adder).Converter("Strict/Number") is ""
	MlirForeign(Adder).Converter("Strict/Numbers") is "strict_list_ready"
	if ForeignMethod.IsNumbers(typeName)
		return "strict_list_ready"
	typeName.EndsWith("/Text") then "strict_text_flat" else ""
Arguments Text
	MlirForeign(Adder).Arguments is "%p0, %p1, %p2"
	MlirForeign(Doubler).Arguments is "%p0, %c1"
	mutable arguments = List(Text) + "%p0"
	for function.method.parameters
		arguments = arguments + ((Converter(value.typeName) is "" then "%p" else "%c") + (index + 1))
	Text.Combine(arguments, ", ")
Returned Texts
	MlirForeign(Adder).Returned.First is "    %converted = func.call @strict_foreign_number(%result) : (f64) -> f64"
	MlirForeign(Doubler).Returned.First.IndexOf("@strict_foreign_numbers(") > 0
	MlirForeign(Splitter).Returned.First.IndexOf("@strict_foreign_rows(") > 0
	MlirForeign(Closing).Returned.First.IndexOf("@strict_foreign_none(") > 0
	returned = function.method.returnType
	single = returned is "None" then "none" else (returned.EndsWith("Text") then "text" else "number")
	kind = ForeignMethod.IsNumbers(returned) then "numbers" else ForeignMethod.IsRows(returned) then "rows" else single
	("    %converted = func.call @strict_foreign_" + kind + "(%result) : (f64) -> f64", "    return %converted : f64")