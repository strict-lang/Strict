has function MlirFunction
has position Number
constant Sample = MlirFormats(MlirFunction(MlirBiased.Biasing.function, Float = "f32", Guarded = 2), 2)
Inputs Texts
	Sample.Inputs is ("weights", "input", "biases")
	for MlirGpuCheck(function, position).Free
		if MlirDevice(function, position).IsList(value)
			value
Count Number
	MlirFormats(MlirGuards.Shifted, 2).Count is 2
	Variants(Inputs.Length)
Bits(name Text, format Number) Number
	Sample.Bits("biases", 3) is 17
	Sample.Bits("input", 4) is 17 and Sample.Bits("biases", 4) is 32
	inputs = Inputs
	Format(inputs.Index(name), inputs.Length, format)
Variants(total Number) Number
	Sample.Variants(3) is 5
	Sample.Variants(4) is 6
	total is 0 then 0 else (total is 1 then 2 else (total is 2 then 4 else (total is 3 then 5 else 6)))
Format(at Number, total Number, format Number) Number
	Sample.Format(1, 4, 5) is 17
	Sample.Format(2, 4, 5) is 32
	leading = format is 2 and at is 0 or format is 4 and at < total - 1 or format is 5 and at < 2
	format is 1 or leading or format is 3 and at is total - 1 then MlirDoubles.BFloat16Format else Number.SingleBits
Given(name Text, format Number) Texts
	Sample.Given("input", -1).Length is 3 and Sample.Given("input", 0)(2) is "    %format_input = arith.constant 32 : i64"
	source = "%f_" + name
	target = "%v_" + name
	if format < 0
		return MlirDevice(function, position).Stores(source, target)
	bits = Bits(name, format)
	fixed = "%format_" + name
	data = MlirTyped.Pointer.Store(source + "_d", target + "_d")
	count = MlirTyped.Integer.Store(source + "_n", target + "_n")
	(data, count, MlirTyped.Integer.Constant(fixed, bits to Text), MlirTyped.Integer.Store(fixed, target + "_b"))
Kernels Texts native
	Sample.Kernels.First.StartsWith("  llvm.func @Tokens_Sums_4_gpu2sxf0(")
	mutable lines = List(Mutable(Text))
	for Count
		lines = lines + MlirDevice(function, position, index).Kernel
	lines
Names(name Text) Text
	Sample.Names("K").EndsWith("Ksxf4\00")
	mutable text = ""
	for Count
		text = text + name + "sxf" + index + "\00"
	text