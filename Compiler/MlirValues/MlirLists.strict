has function MlirFunction
has position Number
has named Text = ""
constant Items = MemberEntry("numbers", "Strict/List(Number)", List(InstructionEntry), false)
constant IndexReads = (InstructionEntry.Named(InstructionType.LoadVariableToRegister, 0, "numbers"), InstructionEntry.LoadNumber(1, 0), InstructionEntry(InstructionType.IndexCall, "numbers", (2, 1, -1)))
constant AppendSums = (InstructionEntry.Named(InstructionType.InvokeWriteToList, 1, "numbers"), InstructionEntry.Binary(InstructionType.Add, (0, 1, 3)), InstructionEntry.Binary(InstructionType.Add, (0, 0, 3)))
constant Steps = IndexReads + AppendSums
constant Listed = MlirFunction(List(TypeEntry) + MlirFunction.Shape, MlirFunction.Shape, MethodEntry("Run", List(MemberEntry) + Items, "None", Steps))
constant ElementWrites = (InstructionEntry.LoadNumber(0, 7), InstructionEntry.Named(InstructionType.StoreRegisterToVariable, 0, "numbers(1)"), InstructionEntry(InstructionType.CopyList, "numbers", -1))
constant Written = MlirFunction(List(TypeEntry) + MlirFunction.Shape, MlirFunction.Shape, MethodEntry("Run", List(MemberEntry) + Items, "None", ElementWrites))
constant Pair = VmValue.OfList(VmValue.OfNumber(1), VmValue.OfText("a"))
constant Removal = InstructionEntry.Named(InstructionType.InvokeRemove, 1, "numbers")
constant Hoisting = MlirLists(MlirParameters.Reading.function, 1)
constant MemberCopy = InstructionEntry(InstructionType.CopyList, "numbers.width", -1)
constant Pushing = InstructionEntry.Named(InstructionType.InvokeWriteToList, 1, "forResult")
constant Versioning = InstructionEntry(InstructionType.StoreRegisterToVariable, "numbers(1)", (0, -1, 1))
constant Words = MemberEntry("words", "Strict/List(Text)", List(InstructionEntry), false)
constant LettersStored = (InstructionEntry.LoadText(0, "ab"), InstructionEntry.Named(InstructionType.StoreRegisterToVariable, 0, "letters"))
constant LetterRead = (InstructionEntry.LoadNumber(1, 1), InstructionEntry(InstructionType.IndexCall, "letters", (2, 1, -1)), InstructionEntry.Return(2))
constant Lettered = MlirLists(MlirFunction(List(TypeEntry), MlirFunction.Shape, MethodEntry("Letter", List(MemberEntry), "Strict/Text", LettersStored + LetterRead)), 3)
constant LiteralLoad = InstructionEntry(InstructionType.LoadConstantToRegister, "Strict/List(Number)", (0, 6, -1, 2, 1, 1, 1, 2))
constant Literals = MlirFunction(List(TypeEntry) + MlirFunction.Shape, MlirFunction.Shape, MethodEntry("Run", List(MemberEntry), "None", List(InstructionEntry) + LiteralLoad))
Temp(suffix Text) Text
	MlirLists(Listed, 2).Temp("l") is "%t2l"
	Text.Combine(MlirLists(Listed, 2).EmitIndex(Steps(2))).Length is 345
	Text.Combine(Hoisting.EmitIndex(Hoisting.function.method.instructions(1))).Length is 405
	Text.Combine(MlirLists(Literals, 0).Cache(List(Text), "%x", "pin")).Length is 400
	Text.Combine(MlirLists(Written, 1).ElementStore(Versioning)).Length is 266
	Text.Combine(MlirLists(Written, 1).ElementStore(Written.method.instructions(1))).Length is 594
	Hoisting.ElementStore(InstructionEntry(InstructionType.StoreRegisterToVariable, "x(i)", 0))(1).Length is 44
	Text.Combine(MlirLists(Listed, 3).Append(Steps(3))).Length is 216
	MlirLists(Listed, 2).Emitted is MlirLists(Listed, 2).EmitIndex(Steps(2))
	MlirLists(Written, 2).Emitted.Length is 3
	"%t" + position + suffix
Emitted Texts
	MlirLists(Listed, 3).Emitted.Length is 4
	entry = function.method.instructions(position)
	isFlat = entry.kind is InstructionType.IndexCall and MlirCouples(function, position).IsFlatRead(entry)
	if function.FastLoop >= 0 and isFlat is false
		return MlirFastLoop(function, function.FastLoop).Emit(position)
	if entry.kind is InstructionType.CopyList
		return Copy(entry)
	if IsElementStore
		return ElementStore(entry)
	if entry.kind is InstructionType.IndexCall
		return MlirPacking(function, position).EmitIndex(entry, value)
	MlirPairs(function, position).Append(entry, value)
Literal(literal Runtime/Core/VmValue, slot Text, suffix Text) Texts
	MlirLists(Listed, 0).Literal(Pair, "%v_a", "").Last is "    llvm.store %t0e1l, %v_a : f64, !llvm.ptr"
	MlirLists(Listed, 0).Literal(VmValue.OfList(List(VmValue)), "%v_a", "").Length is 2
	MlirLists(Literals, 0).Literal(Pair, "%r0", "").First is "    %t0g = llvm.mlir.addressof @lShape_Run_0_0 : !llvm.ptr"
	MlirLists(Literals, 0).Literal(Pair, "%r0", "").Last is "    llvm.store %t0r, %r0 : f64, !llvm.ptr"
	Text.Combine(MlirLists(Literals, 0).Literal(Pair, "%r0", "")).Length is 938
	count = literal.items.Length
	if count is 0
		return MlirPairs(function, position).Start(slot, suffix)
	result = Temp(suffix + "e" + (count - 1) + "l")
	if suffix is not "" or MlirConstants(function, position).IsConstant is false
		return Build(literal, suffix) + function.Store(result, slot)
	Cache(Build(literal, suffix), result, "strict_list_pin") + function.Store(Temp("r"), slot)
Build(literal Runtime/Core/VmValue, suffix Text) Texts
	MlirLists(Literals, 0).Cache(List(Text), "%x", "pin").Index("    func.call @pin(%x) : (f64) -> ()") is 7
	MlirLists(Listed, 0).Build(Pair, "").Last.IndexOf("%t0e1l = func.call @strict_list_add(%t0e0l, %t0e1xf)") > 0
	Text.Combine(MlirLists(Listed, 0).Build(Pair, "")).Length is 469
	memory = MlirMemory(function, position)
	mutable lines = Creat(literal.items.Length, suffix)
	mutable current = Temp(suffix + "l")
	for literal.items
		element = suffix + "e" + index
		added = memory.Call(Temp(element + "l"), "strict_list_add", (current, ElementName(value, element)))
		lines = lines + Element(value, index, element) + added
		current = Temp(element + "l")
	lines
Cache(built Texts, result Text, pin Text) Texts
	Text.Combine(MlirLists(Literals, 0).Cache(List(Text), "%x", "pin")).IndexOf("@strict_cache_claim") > 0
	MlirLists(Literals, 0).Cache(List(Text), "%x", "pin").Index("    cf.cond_br %t0u, ^l0, ^q0") is 2
	address = "    " + Temp("g") + " = llvm.mlir.addressof " + MlirConstants(function, position).Cache + " : !llvm.ptr"
	claimed = "    " + Temp("u") + " = func.call @strict_cache_claim(" + Temp("g") + ") : (!llvm.ptr) -> i1"
	branch = "    cf.cond_br " + Temp("u") + ", ^l" + position + ", ^q" + position
	read = ("  ^q" + position + ":", function.Load(Temp("v"), Temp("g")))
	ready = "    cf.br ^m" + position + "(" + Temp("v") + " : f64)"
	starts = (address, claimed, branch) + read + ready + ("  ^l" + position + ":")
	pinned = "    func.call @" + pin + "(" + result + ") : (f64) -> ()"
	stored = "    func.call @strict_cache_publish(" + Temp("g") + ", " + result + ") : (!llvm.ptr, f64) -> ()"
	joined = ("    cf.br ^m" + position + "(" + result + " : f64)", "  ^m" + position + "(" + Temp("r") + ": f64):")
	starts + built + pinned + stored + joined
Creat(count Number, suffix Text) Texts
	MlirLists(Listed, 0).Creat(0, "").First is "    %t0l = func.call @strict_list_empty() : () -> f64"
	MlirLists(Listed, 0).Creat(2, "").First is "    %t0q = arith.constant 0x4018000000000000 : f64"
	MlirLists(Listed, 0).Creat(2, "").Last is "    %t0l = func.call @strict_list_new(%t0q, %zero) : (f64, f64) -> f64"
	Text.Combine(MlirLists(Listed, 0).Literal(VmValue.OfList(List(VmValue)), "%v_a", "")).Length is 97
	MlirLists(MlirPairs.Built.function, 0).Literal(VmValue.OfList(List(VmValue)), "%v_listResult0", "")(0).Length is 53
	MlirLists(MlirPairs.Built.function, 0).Literal(VmValue.OfList(List(VmValue)), "%v_listResult0", "").Length is 1
	memory = MlirMemory(function, position)
	if count is 0
		return List(Text) + memory.Call(Temp(suffix + "l"), "strict_list_empty", List(Text))
	size = MlirStatements(function, position).Hex(count + 4)
	capacity = "    " + Temp(suffix + "q") + " = arith.constant " + size + " : f64"
	(capacity, memory.Call(Temp(suffix + "l"), "strict_list_new", (Temp(suffix + "q"), "%zero")))
Element(item Runtime/Core/VmValue, index Number, element Text) Texts
	MlirLists(Listed, 0).Element(VmValue.OfNumber(2), 0, "e0") is ("    %t0e0c = arith.constant 0x4000000000000000 : f64")
	MlirLists(Listed, 0, "@dA_b").Element(VmValue.OfText("a"), 0, "e0").First.IndexOf(" @dA_b_0 ") > 0
	Hoisting.Element(VmValue.OfList(List(VmValue)), 0, "e") is ("unsupported: nested List constant in Shape_Run_1")
	if item.kind is "Text"
		return MlirConstants(function, position, named).Address(item.text, "_" + index, element)
	if item.kind is not in ("Number", "Boolean")
		unsupported = MlirStatements(function, position).Unsupport("nested " + item.kind + " constant")
		return List(Text) + unsupported
	number = MlirStatements(function, position).Hex(item.number)
	List(Text) + ("    " + Temp(element + "c") + " = arith.constant " + number + " : f64")
ElementName(item Runtime/Core/VmValue, element Text) Text
	MlirLists(Listed, 0).ElementName(VmValue.OfText("a"), "e1") is "%t0e1xf"
	MlirLists(Listed, 0).ElementName(VmValue.OfNumber(1), "e1") is "%t0e1c"
	MlirLists(Literals, 0).Literal(VmValue.OfList(List(VmValue)), "%r0", "").Length is 2
	Text.Combine(MlirLists(Literals, 0).Literal(Pair, "%r0", "x")).Length is 528
	item.kind is "Text" then Temp(element + "xf") else Temp(element + "c")
Append(entry InstructionEntry) Texts
	MlirLists(Listed, 3).Append(Steps(3)).Last is "    llvm.store %t3n, %v_numbers : f64, !llvm.ptr"
	Text.Combine(MlirLists(Listed, 3).Append(Removal)).IndexOf("@strict_list_remove(") > 0
	Text.Combine(MlirLists(Listed, 3).Append(Pushing)).IndexOf("@strict_list_push(") > 0
	Text.Combine(MlirLists(Listed, 3).Append(MlirPairs.Building.instructions(2))).IndexOf("@strict_list_push(") > 0
	name = "%v_" + entry.texts(0)
	kinds = MlirKinds(function)
	elements = MlirLayout(function).Represent(kinds.ElementKind(kinds.VariableKind(position, entry.texts(0))))
	adder = MlirDying(function, position).Adder(entry.texts(0))
	helper = entry.kind is InstructionType.InvokeRemove then "strict_list_remove" else adder
	added = MlirMemory(function, position).Pass(Temp("n"), helper, (Temp("l"), Temp("e")), elements)
	element = function.Load(Temp("e"), "%r" + entry.payload(0))
	(function.Load(Temp("l"), name), element) + added + function.Store(Temp("n"), name)
EmitIndex(entry InstructionEntry) Texts
	MlirLists(Listed, 2).EmitIndex(Steps(2)).Last is "    llvm.store %t2x, %r2 : f64, !llvm.ptr"
	Text.Combine(Hoisting.EmitIndex(Hoisting.function.method.instructions(1))).IndexOf("@strict_hoisted_read(") > 0
	Text.Combine(Lettered.EmitIndex(LetterRead(1))).IndexOf("text_read(") > 0
	isText = MlirLayout(function).Represent(MlirKinds(function).VariableKind(position, entry.texts(0))) is "Text"
	helper = isText then "strict_text_read" else "strict_list_read"
	access = MlirMemory(function, position).Call(Temp("x"), helper, (Temp("l"), Temp("i"), Temp("nb")))
	loads = (function.Load(Temp("l"), "%v_" + entry.texts(0)), function.Load(Temp("i"), "%r" + entry.payload(1)))
	stored = function.Store(Temp("x"), "%r" + entry.payload(0))
	list = MlirParameters(function).Fix(entry.texts(0))
	if list is not ""
		return loads + Tag + MlirParameters(function).Fetch(list, Temp("l"), Temp("i"), Temp("nb"), Temp("x")) + stored
	loads + Tag + access + stored
Tag Texts
	MlirLists(Listed, 2).Tag.Last.IndexOf("strict_bits") > 0
	Text.Combine(MlirLists(MlirParameters.Aliasing.function, 3).Emitted).IndexOf("@strict_hoisted_read(%h_numbers") > 0
	MlirLists(Listed, 2).Tag.First is "    %t2n = llvm.mlir.addressof @sShape_Run_1_2 : !llvm.ptr"
	MlirLists(Listed, 2).Tag(1) is "    %t2nb = func.call @strict_bits(%t2n) : (!llvm.ptr) -> f64"
	Text.Combine(MlirLists(MlirPairs.Built.function, 0).Literal(Pair, "%v_listResult0", "")).Length is 531
	address = "    " + Temp("n") + " = llvm.mlir.addressof @s" + function.Symbol + "_" + position + " : !llvm.ptr"
	(address, "    " + Temp("nb") + " = func.call @strict_bits(" + Temp("n") + ") : (!llvm.ptr) -> f64")
IsElementStore Boolean
	MlirLists(Written, 1).IsElementStore
	MlirLists(Written, 0).IsElementStore is false
	MlirLists(MlirKinds.Graded.function, 1).IsElementStore is false
	MlirLists(MlirFastLoop.Doubling.function, 2).Emitted is MlirFastLoop.Doubling.Emit(2)
	MlirLists(Written, 1).Emitted is MlirLists(Written, 1).ElementStore(Written.method.instructions(1))
	MlirLists(Written, 2).Emitted is MlirLists(Written, 2).Copy(Written.method.instructions(2))
	entry = function.method.instructions(position)
	entry.kind is not InstructionType.StoreRegisterToVariable then false else entry.texts(0).IndexOf("(") > 0
ElementStore(entry InstructionEntry) Texts
	Text.Combine(MlirLists(Written, 1).ElementStore(Written.method.instructions(1))).IndexOf("strict_is_failure") > 0
	MlirLists(Written, 1).ElementStore(Versioning).Last is "    llvm.store %t1s, %v_numbers : f64, !llvm.ptr"
	parts = PayloadDecoder(entry).ElementParts
	indexed = MlirElements(function, position).Index(parts(1), Temp("i"))
	loads = Target(parts(0)) + indexed + function.Load(Temp("e"), "%r" + entry.payload(0))
	isVersioned = entry.payload.Length > 2
	helper = isVersioned then "strict_list_write" else "strict_list_set"
	call = MlirMemory(function, position).Call(Temp("s"), helper, (Temp("l"), Temp("i"), Temp("e")))
	isVersioned then loads + call + function.Store(Temp("s"), "%v_" + parts(0)) else loads + call + Failed
Failed Texts
	MlirLists(Written, 1).Failed.First is "    %t1f = func.call @strict_is_failure(%t1s) : (f64) -> i1"
	MlirLists(Written, 1).Failed(2) is "  ^bb1w:"
	MlirLists(Written, 1).Failed.Last is "  ^bb1c:"
	failed = "    " + Temp("f") + " = func.call @strict_is_failure(" + Temp("s") + ") : (f64) -> i1"
	branch = "    cf.cond_br " + Temp("f") + ", ^bb" + position + "w, ^bb" + position + "c"
	traced = MlirMemory(function, position).Trace(Temp("s"), Temp("tr"), "strict_trace_checked")
	returned = MlirLines(function).End + ("    return " + Temp("tr") + " : f64", "  ^bb" + position + "c:")
	(failed, branch, "  ^bb" + position + "w:") + traced + returned
Target(path Text) Texts
	MlirLists(Written, 1).Target("numbers") is ("    %t1l = llvm.load %v_numbers : !llvm.ptr -> f64")
	MlirLists(Written, 1).Target("numbers.width").Last is "    %t1l = llvm.load %t1ls : !llvm.ptr -> f64"
	Text.Combine(MlirLists(Written, 1).Target("numbers.width")).Length is 233
	memory = MlirMemory(function, position)
	target = memory.Unwrap(path)
	dot = target.IndexOf(".")
	if dot < 0
		return List(Text) + function.Load(Temp("l"), "%v_" + target)
	slot = memory.Slot(Temp("op"), memory.Member(target).First, "ls")
	owner = function.Load(Temp("o"), "%v_" + target.Substring(0, dot))
	(List(Text) + owner + memory.Pointer(Temp("o"), "o")) + slot + function.Load(Temp("l"), Temp("ls"))
Copy(entry InstructionEntry) Texts
	MlirLists(Written, 2).Copy(Written.method.instructions(2)).Length is 3
	MlirLists(Written, 2).Copy(MemberCopy).Last is "    llvm.store %t2oc, %v_numbers : f64, !llvm.ptr"
	Text.Combine(MlirLists(Written, 2).Copy(MemberCopy)).Length is 535
	Text.Combine(MlirLists(Written, 2).Copy(Written.method.instructions(2))).Length is 173
	path = MlirMemory(function, position).Unwrap(entry.texts(0))
	copy = MlirMemory(function, position).Call(Temp("c"), "strict_list_copy", (Temp("l"), "%zero"))
	if path.IndexOf(".") < 0
		return (function.Load(Temp("l"), "%v_" + path), copy, function.Store(Temp("c"), "%v_" + path))
	changed = MlirMemory(function, position).Change(path, Temp("c"), Temp("oc"))
	Target(path) + copy + changed + function.Store(Temp("oc"), "%v_" + path.Substring(0, path.IndexOf(".")))
