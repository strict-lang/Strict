has function MlirFunction
has position Number
constant Sample = MlirMemory(MlirFunction.Counter, 3)
constant Equated = ("strict_list_find", "strict_list_has", "strict_list_count", "strict_list_remove", "strict_list_removed", "strict_list_without")
constant Counted = "    func.call @strict_rc_object(%p, %z) : (!llvm.ptr, i64) -> ()"
constant Comparing = "(f64, f64) -> f64"
constant Pair = TypeEntry("Strict/Pair", (MemberEntry("first", "Strict/Number", List(InstructionEntry), false), MemberEntry("rest", "Strict/List(Number)", List(InstructionEntry), false)), List(MethodEntry))
constant Box = TypeEntry("Strict/Box", List(MemberEntry) + MemberEntry("values", "Strict/List(Number)", List(InstructionEntry), false), List(MethodEntry))
constant Boxing = MlirMemory(MlirFunction(List(TypeEntry) + Box, Box, MethodEntry("Run", List(MemberEntry) + MemberEntry("box", "Strict/Box", List(InstructionEntry), false), "None", List(InstructionEntry))), 0)
constant Pairing = MlirMemory(MlirFunction(List(TypeEntry) + Pair, Pair, MethodEntry("Run", List(MemberEntry) + MemberEntry("pair", "Strict/Pair", List(InstructionEntry), false), "None", List(InstructionEntry))), 0)
Temp(suffix Text) Text
	Sample.Temp("p") is "%t3p"
	"%t" + position + suffix
Pointer(bits Text, suffix Text) Texts
	Sample.Pointer("%v", "a") is ("    %t3ap = func.call @strict_ptr(%v) : (f64) -> !llvm.ptr")
	List(Text) + ("    " + Temp(suffix + "p") + " = func.call @strict_ptr(" + bits + ") : (f64) -> !llvm.ptr")
Bits(pointer Text, suffix Text) Texts
	Sample.Bits("%p", "a") is ("    %t3af = func.call @strict_bits(%p) : (!llvm.ptr) -> f64")
	EmitBox(pointer, suffix, "")
EmitBox(pointer Text, suffix Text, typeName Text) Texts
	Sample.EmitBox("%p", "a", "Strict/Error").First is "    %t3afe = func.call @strict_error_bits(%p) : (!llvm.ptr) -> f64"
	Sample.EmitBox("%p", "a", "Strict/Error").Last.StartsWith("    %t3af = func.call @strict_trace(%t3afe,")
	short = TypeEntry.ShortName(typeName)
	if short is "Error"
		tagged = "    " + Temp(suffix + "fe") + " = func.call @strict_error_bits(" + pointer + ") : (!llvm.ptr) -> f64"
		return List(Text) + tagged + Trace(Temp(suffix + "fe"), Temp(suffix + "f"), "strict_trace")
	helper = short is "ErrorWithValue" then "strict_error_value_bits" else "strict_bits"
	List(Text) + ("    " + Temp(suffix + "f") + " = func.call @" + helper + "(" + pointer + ") : (!llvm.ptr) -> f64")
Allocate(slots Number, suffix Text) Texts
	Sample.Allocate(2, "o").First is "    %t3oz = arith.constant 16 : i64"
	Sample.Allocate(2, "o").Last is "    %t3op = func.call @strict_alloc(%t3oz) : (i64) -> !llvm.ptr"
	size = "    " + Temp(suffix + "z") + " = arith.constant " + (slots < 1 then 8 else slots * 8) + " : i64"
	(size, "    " + Temp(suffix + "p") + " = func.call @strict_alloc(" + Temp(suffix + "z") + ") : (i64) -> !llvm.ptr")
Slot(base Text, index Number, suffix Text) Text
	Sample.Slot("%b", 2, "s") is "    %t3s = llvm.getelementptr %b[2] : (!llvm.ptr) -> !llvm.ptr, f64"
	"    " + Temp(suffix) + " = llvm.getelementptr " + base + "[" + index + "] : (!llvm.ptr) -> !llvm.ptr, f64"
Load(base Text, index Number, suffix Text) Texts
	Sample.Load("%b", 0, "m").Last is "    %t3mv = llvm.load %t3m : !llvm.ptr -> f64"
	(Slot(base, index, suffix), function.Load(Temp(suffix + "v"), Temp(suffix)))
Address(base Text, index Number, suffix Text) Texts
	Sample.Address("%b", 1, "m").Last is "    %t3mv = func.call @strict_bits(%t3m) : (!llvm.ptr) -> f64"
	bits = " = func.call @strict_bits(" + Temp(suffix) + ") : (!llvm.ptr) -> f64"
	(Slot(base, index, suffix), "    " + Temp(suffix + "v") + bits)
Call(result Text, name Text, operands Texts) Text
	Sample.Call("%r", "add", ("%a", "%b")) is "    %r = func.call @add(%a, %b) : (f64, f64) -> f64"
	types = Text.Combine(MlirCalls(function, position).ArgumentTypes(operands.Length), ", ")
	"    " + result + " = func.call @" + name + "(" + Text.Combine(operands, ", ") + ") : (" + types + ") -> f64"
Pass(result Text, helper Text, operands Texts, element Text) Texts
	Sample.Pass("%r", "f", ("%a", "%b"), "Number") is List(Text) + "    %r = func.call @f(%a, %b) : (f64, f64) -> f64"
	Sample.Pass("%r", "strict_list_has", ("%a", "%b"), "Text").First.IndexOf("@strict_text_equal") > 0
	Sample.Pass("%r", "strict_list_has", List(Text) + "%a", "Number").Last.EndsWith(Comparing + ") -> f64")
	if helper is not in Equated
		return List(Text) + Call(result, helper, operands)
	equal = Constant(Temp("q"), MlirEquality(function, position).Helper(element), Comparing)
	types = Text.Combine(MlirCalls(function, position).ArgumentTypes(operands.Length) + Comparing, ", ")
	arguments = Text.Combine(operands + Temp("q"), ", ")
	(equal, "    " + result + " = func.call @" + helper + "(" + arguments + ") : (" + types + ") -> f64")
Trace(operand Text, result Text, helper Text) Texts
	Sample.Trace("%r", "%x", "f").Last is "    %x = func.call @f(%r, %t3tw, %t3twl)" + MlirChecks.Tracing
	instructions = function.method.instructions
	line = position < instructions.Length then instructions(position).line else 0
	address = "    " + Temp("tw") + " = llvm.mlir.addressof @w" + function.Symbol + " : !llvm.ptr"
	valued = MlirValued(function)
	operands = operand + ", " + Temp("tw") + ", " + Temp("twl") + valued.Operands
	call = "    " + result + " = func.call @" + valued.Helper(helper) + "(" + operands + ")"
	(List(Text) + address) + Line(line) + (call + " : (f64, !llvm.ptr, i64" + valued.Types + ") -> f64")
Line(line Number) Texts
	Sample.Line(0) is ("    %t3twl = arith.constant 0 : i64")
	Sample.Line(9).Last is "    %t3twl = arith.addi %t3twb, %t3twr : i64"
	Sample.Line(9).First is "    %t3twa = llvm.mlir.addressof @l" + Sample.function.Symbol + " : !llvm.ptr"
	if line is 0
		return List(Text) + ("    " + Temp("twl") + " = arith.constant 0 : i64")
	base = "    " + Temp("twa") + " = llvm.mlir.addressof @l" + function.Symbol + " : !llvm.ptr"
	loaded = "    " + Temp("twb") + " = llvm.load " + Temp("twa") + " : !llvm.ptr -> i64"
	relative = "    " + Temp("twr") + " = arith.constant " + (line - MlirGlobals.Base(function)) + " : i64"
	(base, loaded, relative, "    " + Temp("twl") + " = arith.addi " + Temp("twb") + ", " + Temp("twr") + " : i64")
Member(path Text) Numbers
	Pairing.Member("pair.rest") is (1, 2)
	dot = path.IndexOf(".")
	ownerType = function.TypeOf(MlirKinds(function).VariableKind(position, path.Substring(0, dot)))
	names = MlirInstances(function, position).StoredNames(ownerType)
	(names.Index(path.Substring(dot + 1, path.Length - dot - 1)), names.Length)
Change(path Text, element Text, result Text) Texts
	Pairing.Change("pair.rest", "%c", "%r").Last.IndexOf("@strict_instance_with(%t0o, %t0ms, %c, %t0mc)") > 0
	member = Member(path)
	slot = "    " + Temp("ms") + " = arith.constant " + member.First + ".0 : f64"
	count = "    " + Temp("mc") + " = arith.constant " + member.Last + ".0 : f64"
	(slot, count, Call(result, "strict_instance_with", (Temp("o"), Temp("ms"), element, Temp("mc"))))
Unwrap(path Text) Text
	Pairing.Unwrap("pair.rest") is "pair.rest"
	Boxing.Unwrap("box.values") is "box"
	Pairing.Unwrap("numbers") is "numbers"
	dot = path.IndexOf(".")
	dot < 0 then path else Member(path).Last is 1 then path.Substring(0, dot) else path
Constant(target Text, symbol Text, signature Text) Text
	Sample.Constant("%e", "f", "(f64) -> f64") is "    %e = func.constant @f : (f64) -> f64"
	"    " + target + " = func.constant @" + symbol + " : " + signature
Converting(result Text, converter Text, operand Text) Texts
	Sample.Converting("%x", "f", "%v").Last.IndexOf("@strict_converted(%v, %xc)") > 0
	call = "    " + result + " = func.call @strict_converted(" + operand + ", " + result + "c)"
	(Constant(result + "c", converter, "(f64) -> f64"), call + " : (f64, (f64) -> f64) -> f64")