has function MlirFunction
has position Number
constant Letters = "abcdefghijklmnopqrstuvwxyzABCDEFGHI"
constant Widths = (16, 32, 8, 6, 4)
constant SharedWidths = (16, 32, 8)
constant WidthBase = 64
constant Numbered = " = arith.constant "
constant Summing = MlirPacked(MlirKernel.Summing.function, 1)
constant Doubling = MlirPacked(MlirKernel.Doubling.function, 2)
constant SecondCases = ("1024: ^ffloop1fast", "2048: ^fgloop1fast", "512: ^fhloop1fast", "384: ^filoop1fast", "256: ^fjloop1fast")
Branch Texts
	Summing.Branch is ("    cf.cond_br %f1ok1, ^floop1packed, ^loop1generic")
	Doubling.Branch.Last is "    cf.cond_br %f2fast, ^floop2packed, ^loop2generic"
	kind = Packable.Length > 0 then "packed, ^loop" else "fast, ^loop"
	flag = "%f" + position + "ok" + MlirKernel(function, position).Sources.Length
	targets = ", ^floop" + position + kind + position + "generic"
	isParallel = MlirParallel(function, position).IsParallel
	chosen = isParallel then "%f" + position + "fast" else flag
	(isParallel then Limit(flag) else List(Text)) + ("    cf.cond_br " + chosen + targets)
Limit(flag Text) Texts
	Doubling.Limit("%f2ok1")(1) is "    %f2few = arith.cmpf olt, %f2n, %f2pt : f64"
	Doubling.Limit("%f2ok1").Last is "    %f2fast = arith.andi %f2ok1, %f2few : i1"
	prefix = "%f" + position
	threshold = "    " + prefix + "pt = arith.constant " + MlirCost(function, position).Threshold + ".0 : f64"
	few = "    " + prefix + "few = arith.cmpf olt, " + prefix + "n, " + prefix + "pt : f64"
	(threshold, few, "    " + prefix + "fast = arith.andi " + flag + ", " + prefix + "few : i1")
Packable Texts
	Summing.Packable is (MlirFastLoop.Iterated, "numbers")
	Doubling.Packable is (MlirFastLoop.Iterated, "numbers")
	loops = MlirLoops(function, position)
	mutable names = loops.Collection is "List(Number)" then List(Text) + MlirFastLoop.Iterated else List(Text)
	for MlirKernel(function, position).Sources
		if MlirLayout(function).Represent(MlirKinds(function).VariableKind(position, value)) is "List(Number)"
			names = names + value
	names.Length > 3 then List(Text) else names
Key(name Text, index Number) Texts
	Summing.Key("numbers", 1).Last is "    %f1s2 = arith.addi %f1s1, %f1w1 : i64"
	Summing.Key("for", 0).First is "    %f1k_for = func.call @strict_list_holder(%f1v) : (f64) -> !llvm.ptr"
	prefix = "%f" + position
	list = name is MlirFastLoop.Iterated then prefix + "v" else prefix + "l_" + name
	holder = prefix + "k_" + name
	held = "    " + holder + " = func.call @strict_list_holder(" + list + ") : (f64) -> !llvm.ptr"
	at = "    " + prefix
	packed = at + "packed" + index + " = func.call @strict_holder_packed(" + holder + ") : (!llvm.ptr) -> i64"
	shift = at + "m" + index + " = arith.constant " + 6 * index + " : i64"
	shifted = at + "w" + index + " = arith.shli " + prefix + "q" + index + ", " + prefix + "m" + index + " : i64"
	sum = at + "s" + (index + 1) + " = arith.addi " + prefix + "s" + index + ", " + prefix + "w" + index + " : i64"
	(held, packed) + Brain(name, index) + (shift, shifted, sum)
Brain(name Text, index Number) Texts
	Summing.Brain("numbers", 1)(1) is "    %f1brain_numbers = arith.cmpi eq, %f1packed1, %f1brainformat1 : i64"
	prefix = "%f" + position
	flag = prefix + "brain_" + name
	formats = (prefix + "brainformat" + index, prefix + "halfformat" + index)
	packed = prefix + "packed" + index
	compared = "    " + flag + " = arith.cmpi eq, " + packed + ", " + formats(0) + " : i64"
	chosen = "    " + prefix + "q" + index + " = arith.select " + flag + ", " + formats(1) + ", " + packed + " : i64"
	("    " + formats(0) + Numbered + "17 : i64", compared, "    " + formats(1) + Numbered + "16 : i64", chosen)
Case(source Number) Texts
	Summing.Case(1) is SecondCases
	scale = WidthBase ^ source
	first = Widths.Length * source
	for Widths
		Target(value * scale, first + index)
Share(count Number) Texts
	Summing.Share(2) is ("1040: ^fkloop1fast", "2080: ^flloop1fast", "520: ^fmloop1fast")
	Summing.Share(1).Length is 0
	if count < 2
		return List(Text)
	scale = (WidthBase ^ count - 1) / (WidthBase - 1)
	first = Widths.Length * count
	for SharedWidths
		Target(value * scale, first + index)
Target(key Number, number Number) Text
	Summing.Target(1040, 10) is "1040: ^fkloop1fast"
	(key to Text) + ": ^f" + Letters(number) + "loop" + position + "fast"
Cases(count Number) Texts
	Summing.Cases(2).Length is 35
	"2052: ^fuloop1fast" is in Summing.Cases(2)
	mutable cases = Share(count)
	for count
		cases = cases + Case(index)
	first = Widths.Length * count + SharedWidths.Length
	for Mix(count)
		cases = cases + Target(value, first + index)
	cases
Mix(count Number) Numbers
	Summing.Mix(2).Length is 22
	Summing.Mix(3).Length is 0
	if count is not 2
		return List(Number)
	for Widths.Length * Widths.Length
		first = Widths(index % Widths.Length)
		second = Widths((index / Widths.Length).Floor)
		if first is not second or first is not in SharedWidths
			first + WidthBase * second
Dispatched Texts
	Text.Combine(Summing.Dispatched).IndexOf("[default: ^loop1generic, 0: ^floop1fast, 1040: ^fkloop1fast") > 0
	Text.Combine(Summing.Dispatched).IndexOf("520: ^fmloop1fast, 16: ^faloop1fast") > 0
	names = Packable
	if names.Length is 0
		return List(Text)
	mutable lines = List(Text) + ("  ^floop" + position + "packed:", "    %f" + position + "s0 = arith.constant 0 : i64")
	for names
		lines = lines + Key(value, index)
	cases = Text.Combine(Cases(names.Length), ", ")
	targets = "[default: ^loop" + position + "generic, 0: ^floop" + position + "fast, " + cases
	lines + ("    cf.switch %f" + position + "s" + names.Length + " : i64, " + targets + "]") + Variants
Variants Texts
	Summing.Variants.First is "  ^faloop1fast:"
	Text.Combine(Summing.Variants).IndexOf("arith.extf %fa1gsn : f16 to f32") > 0
	mutable lines = List(Mutable(Text))
	for Packings(Packable)
		lines = lines + Variant(value, index)
	lines
Packings(names Texts) Texts
	Summing.Packings(Summing.Packable)(10) is "for 16 numbers 16"
	Summing.Packings(Summing.Packable).Index("for 4 numbers 32") is 20
	mutable packings = List(Mutable(Text))
	for names.Length * Widths.Length
		packings = packings + (names((index / Widths.Length).Floor) + " " + Widths(index % Widths.Length))
	if names.Length > 1
		for SharedWidths
			packings = packings + Text.Combine(Pairs(names, value), " ")
	for Mix(names.Length)
		packings = packings + (names(0) + " " + value % WidthBase + " " + names(1) + " " + (value / WidthBase).Floor)
	packings
Variant(packing Text, number Number) Texts
	Summing.Variant("for 16", 0).First is "  ^faloop1fast:"
	packed = MlirFunction(function.types, function.type, function.method, function.lineSlots, position, packing)
	single = MlirSingle(packed, position)
	copied = single.IsSingle then single.Copied else MlirFastLoop(packed, position).Copied
	finished = MlirCounter(function, position).Finish(Letters(number))
	MlirKernel(function, position).Rename(copied, Letters(number)) + finished
Pairs(names Texts, width Number) Texts
	Summing.Pairs(("for", "numbers"), 16) is ("for 16", "numbers 16")
	for names
		value + " " + width