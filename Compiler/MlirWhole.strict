		if LoadReuse(function.method.instructions).Written(function.method.instructions(earlier)) is register
			return earlier
	-1
Magnitude(number Number) Number
	Row.Magnitude(4) is 3
	Row.Magnitude(0) is 0
	Row.Magnitude(0.5) is -1
	if number.Floor is not number
		return -1
	mutable limit = 1
	for 54
		if number.Absolute < limit
