has function MlirFunction
has position Number
constant Rows = (MethodCodegen.StoreConstant(InstructionEntry.LoadNumber(0, 0), "sum"), InstructionEntry.Named(InstructionType.LoadVariableToRegister, 0, "radius"), InstructionEntry.LoadNumber(1, 2), InstructionEntry.Binary(InstructionType.Multiply, (0, 1, 2)), InstructionEntry.LoadNumber(3, 1), InstructionEntry.Binary(InstructionType.Add, (2, 3, 4)), InstructionEntry.LoopBegin(4, -1), InstructionEntry.Named(InstructionType.LoadVariableToRegister, 5, "sum"), InstructionEntry.Named(InstructionType.LoadVariableToRegister, 6, "middle"), InstructionEntry.Named(InstructionType.LoadVariableToRegister, 7, "value"), InstructionEntry.Named(InstructionType.LoadVariableToRegister, 8, "radius"), InstructionEntry.Binary(InstructionType.Subtract, (7, 8, 9)), InstructionEntry.LoadNumber(10, 4), InstructionEntry.Binary(InstructionType.Multiply, (9, 10, 11)), InstructionEntry.Binary(InstructionType.Add, (6, 11, 12)), InstructionEntry(InstructionType.IndexCall, "pixels", (13, 12)), InstructionEntry(InstructionType.CheckError, List(Text), List(Number) + 13), InstructionEntry.Binary(InstructionType.Add, (5, 13, 14)), InstructionEntry.Named(InstructionType.StoreRegisterToVariable, 14, "sum"), InstructionEntry.Jump(InstructionType.LoopEnd, 13), InstructionEntry.Named(InstructionType.LoadVariableToRegister, 0, "sum"), InstructionEntry.Return(0))
constant Parameters = (MemberEntry("pixels", "Strict/List(Byte)", List(InstructionEntry), false), MemberEntry("middle", "Strict/Number", List(InstructionEntry), false), MemberEntry("radius", "Strict/Number", List(InstructionEntry), false))
constant Row = MlirWhole(MlirFunction(List(TypeEntry) + MlirFunction.Shape + MlirLayout.Byting, MlirFunction.Shape, MethodEntry("Row", Parameters, "Strict/Number", Rows)), 6)
constant Counting = MlirWhole(MlirLoops.Counting.function, 0)
IsWhole Boolean
	Row.IsWhole
	Counting.IsWhole is false
	let entry = function.method.instructions(position)
	if (entry.kind is not InstructionType.LoopBegin) or (entry.payload(1) is 1) or (function.FastLoop >= 0)
		return false
	if MlirLoops(function, position).Collection is not ""
		return false
	for Range(position + 1, function.method.LoopEndOf(position))
		if IsAllowed(value) is false
			return false
	MlirSingle(function, position).Carried.Length > 0
IsAllowed(at Number) Boolean
	Row.IsAllowed(13)
	Row.IsAllowed(17)
	let entry = function.method.instructions(at)
	if entry.kind is InstructionType.LoadVariableToRegister
		return MlirLayout(function).Represented(MlirKinds(function).VariableKind(at, entry.texts(0))) is "Number"
	if entry.kind is in (InstructionType.StoreRegisterToVariable, InstructionType.IndexCall, InstructionType.CheckError)
		return entry.kind is InstructionType.StoreRegisterToVariable then IsStored(at) else IsRead(at)
	let next = function.method.instructions(at + 1)
	let written = LoadReuse(function.method.instructions).Written(entry)
	let bits = written < 0 then -1 else Bits(written, at + 1)
	((next.kind is InstructionType.StoreRegisterToVariable) and IsStored(at + 1)) or ((bits >= 0) and (bits <= 53))
IsStored(at Number) Boolean
	Row.IsStored(18)
	Row.IsStored(17) is false
	let added = function.method.instructions(at - 1)
	if MlirDeviceSums(function, position).IsAccumulation(at) is false
