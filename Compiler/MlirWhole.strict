Bits(register Number, at Number) Number
	Row.Bits(13, 17) is 8
	Row.Bits(12, 15) is 36
	let writer = Writer(register, at)
	if writer < 0
		return -1
	let entry = function.method.instructions(writer)
	if entry.kind is InstructionType.LoadConstantToRegister
		return Magnitude(PayloadDecoder(entry).Value(1).number)
	if entry.kind is InstructionType.LoadVariableToRegister
		return entry.texts(0) is in MlirSingle(function, position).Carried then 60 else 31
	entry.kind is InstructionType.IndexCall then 8 else Grown(entry, writer)
Grown(entry InstructionEntry, at Number) Number
	Row.Grown(Row.function.method.instructions(13), 13) is 35
	Row.Grown(Row.function.method.instructions(15), 15) is -1
	let left = entry.payload.Length > 3 then Bits(entry.payload(1), at) else -1
	let right = entry.payload.Length > 3 then Bits(entry.payload(2), at) else -1
	let isOperator = entry.kind is in (InstructionType.Add, InstructionType.Subtract, InstructionType.Multiply)
	if (left < 0) or (right < 0) or (isOperator is false)
		return -1
	entry.kind is InstructionType.Multiply then left + right else (left > right then left else right) + 1
Writer(register Number, at Number) Number
	Row.Writer(13, 17) is 15
	Row.Writer(4, 8) is -1
	for at - position - 1
