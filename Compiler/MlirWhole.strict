	let bits = Bits(added.payload(2), at - 1)
	(bits >= 0) and (bits <= 20)
IsRead(at Number) Boolean
	Row.IsRead(15)
	Row.IsRead(16)
	let entry = function.method.instructions(at)
	if entry.kind is InstructionType.CheckError
		return (entry.texts.Length is 0) and IsRead(at - 1)
	let next = function.method.instructions(at + 1)
	let isChecked = (next.kind is InstructionType.CheckError) and (next.payload(0) is entry.payload(0))
	let parameters = MlirParameters(function)
	let bits = Bits(entry.payload(1), at)
