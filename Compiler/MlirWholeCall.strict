has function MlirFunction
has position Number
constant NumberParameter = MemberEntry("number", "Strict/Number", List(InstructionEntry), false)
constant TwiceCalls = (InstructionEntry.Named(InstructionType.LoadVariableToRegister, 0, "number"), InstructionEntry.Invoke(1, ("Strict/Halves", "Halved", "Strict/Number", "number"), List(Number) + 0, -1), InstructionEntry.Return(1))
constant Twice = MethodEntry("Twice", List(MemberEntry) + NumberParameter, "Strict/Number", TwiceCalls)
constant Halves = TypeEntry("Strict/Halves", List(MemberEntry), (MlirWholeTypes.Halved, Twice))
constant SizeCalls = (InstructionEntry.Named(InstructionType.LoadVariableToRegister, 0, "grid"), InstructionEntry.Invoke(1, ("Strict/Grid", "Sized", "Strict/Number", "grid"), List(Number) + 0, -1), InstructionEntry.Return(1))
constant Sizing = MlirWholeCall(MlirFunction(MlirWholeInstance.Types, MlirWholeInstance.Grid, MethodEntry("Run", List(MemberEntry) + MemberEntry("grid", "Strict/Grid", List(InstructionEntry), false), "Strict/Number", SizeCalls)), 1)
constant Pointed = ") : (f64) -> !llvm.ptr"
constant GuardStart = ("    %t1whlimit = arith.constant 4503599627370496.0 : f64", "    %t1whz = arith.constant 0 : i64", "    %t1wl0 = llvm.load %r0 : !llvm.ptr -> f64")
constant NumberTruncated = ("    %t1wh0t = llvm.intr.trunc(%t1wl0) : (f64) -> f64", "    %t1wh0e = arith.cmpf oeq, %t1wh0t, %t1wl0 : f64")
constant NumberBounded = ("    %t1wh0a = llvm.intr.fabs(%t1wl0) : (f64) -> f64", "    %t1wh0s = arith.cmpf olt, %t1wh0a, %t1whlimit : f64", "    %t1wh0o = arith.andi %t1wh0e, %t1wh0s : i1")
constant GuardEnd = ("    %t1whj = arith.constant true", "    %t1whok = arith.andi %t1whj, %t1wh0o : i1")
constant WholeCalled = ("    cf.cond_br %t1whok, ^bb1wholecall, ^bb1slowcall", "  ^bb1wholecall:", "    %t1wa0 = arith.fptosi %t1wl0 : f64 to i64", "    %t1wr = func.call @Halves_Halved_1_whole(%t1wa0) : (i64) -> i64")
constant SlowJoined = ("    %t1wf = arith.sitofp %t1wr : i64 to f64", "    llvm.store %t1wf, %r1 : f64, !llvm.ptr", "    cf.br ^bb1called", "  ^bb1slowcall:", "slow", "    cf.br ^bb1called", "  ^bb1called:")
constant Dispatching = GuardStart + NumberTruncated + NumberBounded + GuardEnd + WholeCalled + SlowJoined
constant InstanceLoaded = ("    %t1wa0 = func.call @strict_ptr(%t1wl0) : (f64) -> !llvm.ptr", "    %t1wh0c0 = arith.constant true")
constant ListLoaded = ("    %t1wh0m0 = llvm.getelementptr %t1wa0[1] : (!llvm.ptr) -> !llvm.ptr, f64", "    %t1wh0m0v = llvm.load %t1wh0m0 : !llvm.ptr -> f64", "    %t1wh0m0k = func.call @strict_list_packed(%t1wh0m0v) : (f64) -> i64")
constant ListCompared = ("    %t1wh0m0l = arith.constant 33 : i64", "    %t1wh0m0o = arith.cmpi eq, %t1wh0m0k, %t1wh0m0l : i64", "    %t1wh0c1 = arith.andi %t1wh0c0, %t1wh0m0o : i1")
constant MemberLoaded = ("    %t1wh0m1 = llvm.getelementptr %t1wa0[0] : (!llvm.ptr) -> !llvm.ptr, f64", "    %t1wh0m1v = llvm.load %t1wh0m1 : !llvm.ptr -> f64")
constant MemberTruncated = ("    %t1wh0m1t = llvm.intr.trunc(%t1wh0m1v) : (f64) -> f64", "    %t1wh0m1e = arith.cmpf oeq, %t1wh0m1t, %t1wh0m1v : f64")
constant MemberBounded = ("    %t1wh0m1a = llvm.intr.fabs(%t1wh0m1v) : (f64) -> f64", "    %t1wh0m1s = arith.cmpf olt, %t1wh0m1a, %t1whlimit : f64", "    %t1wh0m1o = arith.andi %t1wh0m1e, %t1wh0m1s : i1")
constant MemberCombined = ("    %t1wh0c2 = arith.andi %t1wh0c1, %t1wh0m1o : i1", "    %t1wh0o = arith.andi %t1wh0c2, %t1wh0c0 : i1")
constant Guarding = GuardStart + InstanceLoaded + ListLoaded + ListCompared + MemberLoaded + MemberTruncated + MemberBounded + MemberCombined + GuardEnd
constant Calling = MlirWholeCall(MlirFunction(List(TypeEntry) + MlirFunction.Shape + Halves, Halves, Twice), 1)
constant DefaultNumber = MemberEntry("number", "Strict/Number", InstructionEntry.Set(List(Text), InstructionEntry.NumberValue(2)), false)
constant Defaulted = TypeEntry("Strict/Halves", List(MemberEntry), List(MethodEntry) + MethodEntry("Halved", DefaultNumber, "Strict/Number", MlirWholeTypes.Halved.instructions))
constant DefaultCalls = (Twice.instructions(0), InstructionEntry.Invoke(1, ("Strict/Halves", "Halved", "Strict/Number"), List(Number), 0), Twice.instructions(2))
constant Defaulting = MlirWholeCall(MlirFunction(List(TypeEntry) + MlirFunction.Shape + Defaulted, Defaulted, MethodEntry("Run", Twice.parameters, "Strict/Number", DefaultCalls)), 1)
IsDispatched Boolean
	Calling.IsDispatched
	MlirWholeCall(MlirWholeTypes.Halving.function, 3).IsDispatched is false
	let entry = function.method.instructions(position)
	if entry.kind is not InstructionType.Invoke
		return false
	let decoder = PayloadDecoder(entry)
	let isFloor = (decoder.Text(1) is "Strict/Number") and (decoder.Text(2) is "Floor")
	if isFloor or (MlirCalls(function, position).NativeHelper(entry, decoder) is not "")
		return false
	IsMatched(entry, MlirWholeFunction(MlirWholeFunction(function).Callee(entry)))
IsMatched(entry InstructionEntry, callee MlirWholeFunction) Boolean
	Defaulting.IsDispatched is false
	let isComplete = entry.payload(5 + entry.payload(3)) is callee.function.method.parameters.Length
	let isRead = LoadReuse(function.method.instructions).InvokeReads(entry).Length is callee.Kinds.Length
	isComplete and isRead and callee.IsWhole
Dispatched(compiled Texts) Texts
	Calling.Dispatched(List(Text) + "slow")(Calling.Dispatched(List(Text) + "slow").Index("  ^bb1slowcall:") + 1) is "slow"
	Calling.Dispatched(List(Text) + "slow").Last is "  ^bb1called:"
	MlirWholeCall(MlirWholeTypes.Halving.function, 3).Dispatched(List(Text) + "slow") is ("slow")
	Calling.Dispatched(List(Text) + "slow") is Dispatching
	if IsDispatched is false
		return compiled
	let label = "^bb" + position
	let branch = "    cf.cond_br " + Temp("whok") + ", " + label + "wholecall, " + label + "slowcall"
	let called = ("    cf.br " + label + "called", "  " + label + "slowcall:")
	let slow = called + compiled + ("    cf.br " + label + "called", "  " + label + "called:")
	Guarded + branch + ("  " + label + "wholecall:") + Direct + slow
Guarded Texts
	Text.Combine(Calling.Guarded).IndexOf("%t1wh0t = llvm.intr.trunc(%t1wl0)") > 0
	Calling.Guarded.Last.StartsWith("    %t1whok = arith.andi")
	let guard = MlirWholeGuard(function, position)
	let entry = function.method.instructions(position)
	let kinds = MlirWholeFunction(MlirWholeFunction(function).Callee(entry)).Kinds
	mutable lines = guard.Started
	for LoadReuse(function.method.instructions).InvokeReads(entry)
		let loaded = Temp("wl" + index)
		let checked = Checked(index, kinds(index))
		lines = lines + function.Load(loaded, "%r" + entry.payload(value)) + checked
	let span = MlirWholeSpan(MlirWholeFunction(function).Callee(entry), position)
	lines + span.Lines + guard.Joined(Conditions(kinds.Length) + span.Checks)
Checked(number Number, kind Text) Texts
	Calling.Checked(0, "i").First is "    %t1wh0t = llvm.intr.trunc(%t1wl0) : (f64) -> f64"
	Calling.Checked(0, "p").First is "    %t1wa0 = func.call @strict_list_bytes(%t1wl0) : (f64) -> !llvm.ptr"
	if kind is "o"
		return Members(number)
	if kind is in ("p", "d")
		return Present(number, kind)
	MlirWholeGuard(function, position).Checked(Temp("wl" + number), Temp("wh" + number), Temp("whlimit"))
Members(number Number) Texts
	Text.Combine(Sizing.Members(0)).IndexOf("@strict_list_packed(%t1wh0m0v)") > 0
	Sizing.Members(0).First is "    %t1wa0 = func.call @strict_ptr(%t1wl0) : (f64) -> !llvm.ptr"
	let callee = MlirWholeFunction(function).Callee(function.method.instructions(position))
	let instance = MlirWholeInstance(callee)
	let pointer = "    " + Temp("wa" + number) + " = func.call @strict_ptr(" + Temp("wl" + number) + Pointed
	mutable lines = List(Text) + pointer + MlirWholeValues(position).Line("wh" + number + "c0", "arith.constant true")
	for instance.Members(number)
		let slot = MlirWholeFields(callee).SlotOf(Owner(number, callee), value)
		let read = MlirWholeFields(callee).Read(Temp("wa" + number), slot, Temp("wh" + number + "m" + index))
		lines = lines + read + Member(number, index, instance.MemberKind(Owner(number, callee), value))
	let last = Temp("wh" + number + "c" + instance.Members(number).Length)
	lines + ("    " + Temp("wh" + number + "o") + " = arith.andi " + last + ", " + Temp("wh" + number + "c0") + " : i1")
Owner(number Number, callee MlirFunction) Text
	Sizing.Owner(1, MlirWholeInstance.Fits.function) is "Strict/Grid"
	Sizing.Owner(0, MlirWholeInstance.Fits.function) is "Strict/Number"
	number < callee.method.parameters.Length then callee.method.parameters(number).typeName else callee.type.Name
Member(number Number, member Number, kind Text) Texts
	Calling.Member(0, 1, "i").Last is "    %t1wh0c2 = arith.andi %t1wh0c1, %t1wh0m1o : i1"
	Calling.Member(0, 1, "d").First is "    %t1wh0m1k = func.call @strict_list_packed(%t1wh0m1v) : (f64) -> i64"
	Calling.Member(0, 1, "d")(2) is "    %t1wh0m1o = arith.cmpi eq, %t1wh0m1k, %t1wh0m1l : i64"
	let prefix = Temp("wh" + number + "m" + member)
	let whole = MlirWholeGuard(function, position).Checked(prefix + "v", prefix, Temp("whlimit"))
	let checked = kind is "i" then whole else Usable(prefix, kind)
	let previous = Temp("wh" + number + "c" + member)
	checked + ("    " + Temp("wh" + number + "c" + (member + 1)) + " = arith.andi " + previous + ", " + prefix + "o : i1")
Usable(prefix Text, kind Text) Texts
	Calling.Usable("%a", "p").Last is "    %ao = arith.cmpi ne, %ai, %t1whz : i64"
	Calling.Usable("%a", "c").Last is "    %ao = arith.andi %axo, %ayo : i1"
	if kind is "c"
		return Coupled(prefix)
	if kind is "d"
		let packed = "    " + prefix + "k = func.call @strict_list_packed(" + prefix + "v) : (f64) -> i64"
		let lanes = "    " + prefix + "l = arith.constant " + MlirDoubles.LanesFormat + " : i64"
		return (packed, lanes, "    " + prefix + "o = arith.cmpi eq, " + prefix + "k, " + prefix + "l : i64")
	let address = "    " + prefix + "i = llvm.ptrtoint " + prefix + "p : !llvm.ptr to i64"
	let present = (address, "    " + prefix + "o = arith.cmpi ne, " + prefix + "i, " + Temp("whz") + " : i64")
	MlirWholeFields(function).Converted(prefix + "v", kind, prefix + "p") + present
Coupled(prefix Text) Texts
	Calling.Coupled("%a").First is "    %axv = func.call @strict_two_x(%av) : (f64) -> f64"
	Calling.Coupled("%a")(1) is "    %axt = llvm.intr.trunc(%axv) : (f64) -> f64"
	Calling.Coupled("%a")(4) is "    %axs = arith.cmpf olt, %axa, %t1whlimit : f64"
	let guard = MlirWholeGuard(function, position)
	mutable lines = List(Mutable(Text))
	for ("x", "y")
		let half = "    " + prefix + value + "v = func.call @strict_two_" + value + "(" + prefix + "v) : (f64) -> f64"
		lines = lines + half + guard.Checked(prefix + value + "v", prefix + value, Temp("whlimit"))
	lines + ("    " + prefix + "o = arith.andi " + prefix + "xo, " + prefix + "yo : i1")
Conditions(count Number) Texts
	Calling.Conditions(1) is ("%t1wh0o")
	Sizing.Guarded is Guarding
	Sizing.IsDispatched and MlirWholeCall(MlirWholeInstance.Sized.function, 5).IsDispatched
	MlirWholeCall(MlirCalls.Shapes, 2).IsDispatched is false
	MlirWholeCall(MlirCalls.Hashes, 1).IsDispatched is false
	MlirWholeCall(MlirArguments.Halfway.functions.First, 2).IsDispatched is false
	for count
		Temp("wh" + index + "o")
Present(number Number, kind Text) Texts
	Calling.Present(0, "p").Last is "    %t1wh0o = arith.cmpi ne, %t1wh0i, %t1whz : i64"
	Calling.Present(0, "d").First is "    %t1wa0 = func.call @strict_list_lanes(%t1wl0) : (f64) -> !llvm.ptr"
	Text.Combine(MlirCalls(Calling.function, 1).Emitted).IndexOf("^bb1wholecall") > 0
	Calling.Usable("%a", "d")(1) is "    %al = arith.constant 33 : i64"
	Calling.Usable("%a", "p")(1) is "    %ai = llvm.ptrtoint %ap : !llvm.ptr to i64"
	Calling.Usable("%a", "p").First is "    %ap = func.call @strict_list_bytes(%av) : (f64) -> !llvm.ptr"
	let pointer = Temp("wa" + number)
	let listed = kind is "d" then "strict_list_lanes" else "strict_list_bytes"
	let bytes = "    " + pointer + " = func.call @" + listed + "(" + Temp("wl" + number) + ") : (f64) -> !llvm.ptr"
	List(Text) + bytes + MlirWholeGuard(function, position).Present(pointer, number)
Direct Texts
	Text.Combine(Calling.Direct).IndexOf("func.call @Halves_Halved_1_whole(%t1wa0) : (i64) -> i64") > 0
	Calling.Direct.Last is "    llvm.store %t1wf, %r1 : f64, !llvm.ptr"
	let callee = MlirWholeFunction(function).Callee(function.method.instructions(position))
	let kinds = MlirWholeFunction(callee).Kinds
	mutable lines = List(Mutable(Text))
	for kinds
		let converted = MlirWholeValues(position).Converted(Temp("wl" + index), "f", "i", Temp("wa" + index))
		lines = value is in ("p", "d", "o") then lines else lines + converted
	let returned = MlirWholeTypes(callee).Returned
	let result = Temp(returned is "f" then "wf" else "wr")
	let call = MlirWholeValues(position).Called(result, MlirWholeFunction(callee).Symbol, Temp("wa"), kinds, returned)
	lines + call + Returned(returned)
Returned(returned Text) Texts
	Calling.Returned("i").Last is "    llvm.store %t1wf, %r1 : f64, !llvm.ptr"
	Calling.Returned("f") is ("    llvm.store %t1wf, %r1 : f64, !llvm.ptr")
	let target = "%r" + function.method.instructions(position).payload(0)
	if returned is "f"
		return List(Text) + function.Store(Temp("wf"), target)
	(MlirWholeValues(position).Converted(Temp("wr"), "i", "f", Temp("wf")), function.Store(Temp("wf"), target))
Temp(suffix Text) Text
	Calling.Temp("wr") is "%t1wr"
	"%t" + position + suffix
