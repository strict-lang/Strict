has statements MlirWholeStatements
constant Begin = MlirWholeCounted(MlirWholeStatements.Row.At(6))
constant End = MlirWholeCounted(MlirWholeStatements.Row.At(19))
constant Types = MlirWholeTypes(MlirWholeFunction.Nesting)
constant Inner = MlirWholeCounted(MlirWholeStatements(MlirWholeFunction.Nesting, 6, Types.Part(0), Types.Part(1), Types.Part(2)))
constant Closing = MlirWholeCounted(Inner.statements.At(13))
constant Counting = ("    %t6n = llvm.load %r4 : !llvm.ptr -> i64", "    %t6b = arith.constant 0 : i64", "    %t6s = arith.constant 1 : i64", "    %t6x = llvm.load %v_index : !llvm.ptr -> i64", "    %t6y = llvm.load %v_value : !llvm.ptr -> i64", "    %t6a = arith.constant 0 : i64", "    llvm.store %t6a, %loop6 : i64, !llvm.ptr", "    cf.br ^loop6", "  ^loop6:", "    %t6k = llvm.load %loop6 : !llvm.ptr -> i64", "    %t6m = arith.cmpi slt, %t6k, %t6n : i64", "    cf.cond_br %t6m, ^loop6body, ^loop6exit", "  ^loop6body:", "    %t6o = arith.muli %t6k, %t6s : i64", "    %t6c = arith.addi %t6b, %t6o : i64", "    llvm.store %t6c, %v_value : i64, !llvm.ptr", "    llvm.store %t6c, %v_index : i64, !llvm.ptr")
constant Ranging = ("    %t6b = llvm.load %r2 : !llvm.ptr -> i64", "    %t6e = llvm.load %r3 : !llvm.ptr -> i64", "    %t6u = arith.subi %t6e, %t6b : i64", "    %t6w = arith.subi %t6b, %t6e : i64", "    %t6d = arith.cmpi slt, %t6e, %t6b : i64", "    %t6p = arith.constant 1 : i64", "    %t6q = arith.constant -1 : i64", "    %t6n = arith.select %t6d, %t6w, %t6u : i64", "    %t6s = arith.select %t6d, %t6q, %t6p : i64", "    %t6x = llvm.load %v_index : !llvm.ptr -> i64", "    %t6y = llvm.load %v_value : !llvm.ptr -> i64", "    %t6z = llvm.load %v_outer : !llvm.ptr -> i64", "    llvm.store %t6y, %v_outer : i64, !llvm.ptr", "    %t6a = arith.constant 0 : i64", "    llvm.store %t6a, %loop6 : i64, !llvm.ptr", "    cf.br ^loop6", "  ^loop6:", "    %t6k = llvm.load %loop6 : !llvm.ptr -> i64", "    %t6m = arith.cmpi slt, %t6k, %t6n : i64", "    cf.cond_br %t6m, ^loop6body, ^loop6exit", "  ^loop6body:", "    %t6o = arith.muli %t6k, %t6s : i64", "    %t6c = arith.addi %t6b, %t6o : i64", "    llvm.store %t6c, %v_value : i64, !llvm.ptr", "    llvm.store %t6c, %v_index : i64, !llvm.ptr")
constant Exiting = ("    %t19k = llvm.load %loop6 : !llvm.ptr -> i64", "    %t19o = arith.constant 1 : i64", "    %t19w = arith.addi %t19k, %t19o : i64", "    llvm.store %t19w, %loop6 : i64, !llvm.ptr", "    cf.br ^loop6", "  ^loop6exit:", "    llvm.store %t6x, %v_index : i64, !llvm.ptr", "    llvm.store %t6y, %v_value : i64, !llvm.ptr")
constant Closed = ("    %t13k = llvm.load %loop6 : !llvm.ptr -> i64", "    %t13o = arith.constant 1 : i64", "    %t13w = arith.addi %t13k, %t13o : i64", "    llvm.store %t13w, %loop6 : i64, !llvm.ptr", "    cf.br ^loop6", "  ^loop6exit:", "    llvm.store %t6x, %v_index : i64, !llvm.ptr", "    llvm.store %t6y, %v_value : i64, !llvm.ptr", "    llvm.store %t6z, %v_outer : i64, !llvm.ptr")
Emitted(entry InstructionEntry) Texts
	Begin.Emitted(MlirWhole.Rows(6)).Length is 17
	MlirWholeCounted(MlirWholeStatements.Row.At(16)).Emitted(MlirWhole.Rows(16)) is ("    cf.br ^bb17")
	End.Emitted(MlirWhole.Rows(19)) is Exiting
	Begin.Emitted(InstructionEntry.Jump(InstructionType.JumpEnd, 0)).Length is 0
	if entry.kind is InstructionType.LoopBegin
		return Begun(entry)
	if entry.kind is InstructionType.LoopEnd
		return Ended
	if entry.kind is InstructionType.CheckError
		return List(Text) + ("    cf.br ^bb" + (statements.position + 1))
	MlirStatements(statements.function, statements.position).Jumped(entry)
Begun(entry InstructionEntry) Texts
	Begin.Begun(MlirWhole.Rows(6))(8) is "  ^loop6:"
	Text.Combine(Inner.Begun(MlirWholeFunction.Pairing(6))).IndexOf("llvm.store %t6y, %v_outer : i64, !llvm.ptr") > 0
	Begin.Begun(MlirWhole.Rows(6)) is Counting
	Inner.Begun(MlirWholeFunction.Pairing(6)) is Ranging
	let label = "^loop" + statements.position
	let zero = MlirWholeValues(statements.position).Line("a", "arith.constant 0 : i64")
	let stored = "    llvm.store " + statements.Temp("a") + ", %loop" + statements.position + " : i64, !llvm.ptr"
	Bounds(entry) + Saved + zero + stored + ("    cf.br " + label, "  " + label + ":") + Checked
Bounds(entry InstructionEntry) Texts
	Begin.Bounds(MlirWhole.Rows(6)).Last is "    %t6s = arith.constant 1 : i64"
	Inner.Bounds(MlirWholeFunction.Pairing(6)).Last is "    %t6s = arith.select %t6d, %t6q, %t6p : i64"
	let values = MlirWholeValues(statements.position)
	if entry.payload(1) is not 1
		let first = values.Line("b", "arith.constant 0 : i64")
		return statements.Load("n", entry.payload(0), "i") + first + values.Line("s", "arith.constant 1 : i64")
	let start = statements.Load("b", entry.payload(0), "i") + statements.Load("e", entry.payload(2), "i")
	let counts = (statements.Operation("u", "arith.subi", "e", "b"), statements.Operation("w", "arith.subi", "b", "e"))
	let select = "arith.select " + statements.Temp("d") + ","
	let signs = (values.Line("p", "arith.constant 1 : i64"), values.Line("q", "arith.constant -1 : i64"))
	let chosen = (statements.Operation("n", select, "w", "u"), statements.Operation("s", select, "q", "p"))
	start + counts + statements.Operation("d", "arith.cmpi slt,", "e", "b") + signs + chosen
Saved Texts
	Inner.Saved.Last is "    llvm.store %t6y, %v_outer : i64, !llvm.ptr"
	Begin.Saved.Length is 2
	let names = statements.function.VariableNames
	let values = MlirWholeValues(statements.position)
	mutable lines = List(Mutable(Text))
	for ("index", "value", "outer")
		if value is in names
			lines = lines + values.Loaded(statements.Temp(Kept(value)), "%v_" + value, statements.Variable(value), "i")
	let isOuter = ("outer" is in names) and ("value" is in names)
	isOuter then lines + values.Stored(statements.Temp("y"), "i", "%v_outer", statements.Variable("outer")) else lines
Kept(name Text) Text
	Begin.Kept("outer") is "z"
	name is "index" then "x" else (name is "value" then "y" else "z")
Checked Texts
	Begin.Checked.Last is "    llvm.store %t6c, %v_index : i64, !llvm.ptr"
	let values = MlirWholeValues(statements.position)
	let label = "^loop" + statements.position
	let loaded = values.Line("k", "llvm.load %loop" + statements.position + " : !llvm.ptr -> i64")
	let compared = statements.Operation("m", "arith.cmpi slt,", "k", "n")
	let branch = "    cf.cond_br " + statements.Temp("m") + ", " + label + "body, " + label + "exit"
	let current = (statements.Operation("o", "arith.muli", "k", "s"), statements.Operation("c", "arith.addi", "b", "o"))
	let valued = values.Stored(statements.Temp("c"), "i", "%v_value", statements.Variable("value"))
	let indexed = values.Stored(statements.Temp("c"), "i", "%v_index", statements.Variable("index"))
	(loaded, compared, branch, "  " + label + "body:") + current + valued + indexed
Ended Texts
	"  ^loop6exit:" is in End.Ended
	Closing.Ended.Last is "    llvm.store %t6z, %v_outer : i64, !llvm.ptr"
	let values = MlirWholeValues(statements.position)
	let begin = statements.function.method.LoopBeginOf(statements.position)
	let counter = "%loop" + begin
	let loaded = values.Line("k", "llvm.load " + counter + " : !llvm.ptr -> i64")
	let added = statements.Operation("w", "arith.addi", "k", "o")
	let stored = "    llvm.store " + statements.Temp("w") + ", " + counter + " : i64, !llvm.ptr"
	let jumped = MlirLoops(statements.function, statements.position).Back(begin) + ("  ^loop" + begin + "exit:")
	(loaded, values.Line("o", "arith.constant 1 : i64"), added, stored) + jumped + Restored(begin)
Restored(begin Number) Texts
	End.Restored(6).Length is 2
	Closing.Ended is Closed
	let names = statements.function.VariableNames
	let values = MlirWholeValues(statements.position)
	mutable lines = List(Mutable(Text))
	for ("index", "value", "outer")
		if value is in names
			lines = lines + values.Stored("%t" + begin + Kept(value), "i", "%v_" + value, statements.Variable(value))
	lines
