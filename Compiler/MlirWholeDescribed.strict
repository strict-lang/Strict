has at Number
has order Number
Measure(text Text) Texts
	MlirWholeDescribed(4, 1).Measure("%v").First is "    %t4wt1d = func.call @strict_text_data(%v) : (f64) -> !llvm.ptr"
	MlirWholeDescribed(4, 1).Measure("%v")(1) is "    %t4wt1a = llvm.ptrtoint %t4wt1d : !llvm.ptr to i64"
	MlirWholeDescribed(4, 1).Measure("%v").Last is "    %t4wt1n = func.call @strict_text_size(%v) : (f64) -> i64"
	name = "wt" + order
	values = MlirWholeValues(at)
	data = values.Line(name + "d", "func.call @strict_text_data(" + text + ") : (f64) -> !llvm.ptr")
	address = values.Line(name + "a", "llvm.ptrtoint %t" + at + name + "d : !llvm.ptr to i64")
	(data, address, values.Line(name + "n", "func.call @strict_text_size(" + text + ") : (f64) -> i64"))
Place(name Text, offset Number) Text
	MlirWholeDescribed(4, 1).Place("wa1", 1).StartsWith("    %t4wa1 = llvm.getelementptr %wfailed[3] :")
	slot = "llvm.getelementptr %wfailed[" + (order * 2 + offset) + "]"
	MlirWholeValues(at).Line(name, slot + " : (!llvm.ptr) -> !llvm.ptr, i64")
Lines(text Text) Texts
	MlirWholeDescribed(4, 1).Lines("%v")(5) is "    llvm.store %t4wt1a, %t4wa1 : i64, !llvm.ptr"
	MlirWholeDescribed(4, 1).Lines("%v")(3).StartsWith("    %t4wa1 = ")
	MlirWholeDescribed(4, 1).Lines("%v")(4).StartsWith("    %t4wt1s = llvm.getelementptr %wfailed[4] :")
	MlirWholeDescribed(4, 1).Lines("%v")(6) is "    llvm.store %t4wt1n, %t4wt1s : i64, !llvm.ptr"
	MlirWholeDescribed(4, 1).Lines("%v").Last is "    %t4wh1o = arith.cmpi eq, %t4wt1c, %t4wt1n : i64"
	prefix = "%t" + at + "wt" + order
	first = "    llvm.store " + prefix + "a, %t" + at + "wa" + order + " : i64, !llvm.ptr"
	stores = (first, "    llvm.store " + prefix + "n, " + prefix + "s : i64, !llvm.ptr")
	places = (Place("wa" + order, 1), Place("wt" + order + "s", 2))
	count = MlirWholeValues(at).Line("wt" + order + "c", "func.call @strict_text_count(" + text + ") : (f64) -> i64")
	ascii = MlirWholeValues(at).Line("wh" + order + "o", "arith.cmpi eq, " + prefix + "c, " + prefix + "n : i64")
	Measure(text) + places + stores + count + ascii
