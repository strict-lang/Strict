has statements MlirWholeStatements
has entry InstructionEntry
constant Remaining = MlirWholeDivision(MlirWholeStatements.Remaining, MlirWholeFunction.Remainder(2))
constant Halving = MlirWholeDivision(MlirWholeStatements.Halving.At(2), MlirWholeTypes.Halves(2))
constant Floating = MlirWholeDivision(MlirWholeStatements.FloatRemaining, MlirWholeFunction.Remainder(2))
constant Adding = MlirWholeDivision(MlirWholeStatements.Remaining, InstructionEntry.Binary(InstructionType.Add, (0, 1, 2)))
constant Checked = ("    %t2z = arith.constant 0 : i64", "    %t2o = arith.constant 1 : i64", "    %t2e = arith.cmpi eq, %t2b, %t2z : i64", "    %t2s = arith.select %t2e, %t2o, %t2b : i64")
constant Flagging = ("    %t2f = llvm.load %failed : !llvm.ptr -> i64", "    %t2x = arith.extui %t2e : i1 to i64", "    %t2n = arith.ori %t2f, %t2x : i64", "    llvm.store %t2n, %failed : i64, !llvm.ptr")
Lines Texts
	Halving.Lines.Length is 0
	Floating.Lines.Length is 0
	Remaining.Lines is Checked + Flagging
	Adding.Lines.Length is 0
	let isDivided = entry.kind is in (InstructionType.Divide, InstructionType.Modulo)
	let isChecked = isDivided and (statements.naturals(statements.position) is "i")
	if (isChecked is false) or MlirWholeFunction(statements.function).IsSafeDivisor(entry.payload(2), statements.position)
		return List(Text)
	let values = MlirWholeValues(statements.position)
	let constants = (values.Line("z", "arith.constant 0 : i64"), values.Line("o", "arith.constant 1 : i64"))
	let safe = values.Line("s", "arith.select " + Temp("e") + ", " + Temp("o") + ", " + Temp("b") + " : i64")
	constants + (statements.Operation("e", "arith.cmpi eq,", "b", "z"), safe) + Flagged
Flagged Texts
	Remaining.Flagged is Flagging
	let values = MlirWholeValues(statements.position)
	let widened = values.Line("x", "arith.extui " + Temp("e") + " : i1 to i64")
	let loaded = values.Line("f", "llvm.load %failed : !llvm.ptr -> i64")
	let stored = "    llvm.store " + Temp("n") + ", %failed : i64, !llvm.ptr"
	(loaded, widened, statements.Operation("n", "arith.ori", "f", "x"), stored)
Temp(suffix Text) Text
	Remaining.Temp("s") is "%t2s"
	statements.Temp(suffix)
