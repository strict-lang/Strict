has function MlirFunction
constant Row = MlirWholeFunction(MlirWhole.Row.function)
constant Halving = MlirWholeFunction(MlirWholeTypes.Halving.function)
constant Empty = MlirWholeFunction(MlirFunction(List(TypeEntry), MlirFunction.Shape, MethodEntry("Empty", List(MemberEntry), "Strict/Number", List(InstructionEntry))))
constant Pairing = (MethodCodegen.StoreConstant(InstructionEntry.LoadNumber(0, 0), "sum"), InstructionEntry.LoadNumber(0, 0), InstructionEntry.LoadNumber(1, 3), InstructionEntry.LoopBegin(0, 1), InstructionEntry.LoadNumber(2, 0), InstructionEntry.LoadNumber(3, 3), InstructionEntry.LoopBegin(2, 3), InstructionEntry.Named(InstructionType.LoadVariableToRegister, 4, "sum"), InstructionEntry.Named(InstructionType.LoadVariableToRegister, 5, "value"), InstructionEntry.Named(InstructionType.LoadVariableToRegister, 6, "outer"), InstructionEntry.Binary(InstructionType.Multiply, (5, 6, 7)), InstructionEntry.Binary(InstructionType.Add, (4, 7, 8)), InstructionEntry.Named(InstructionType.StoreRegisterToVariable, 8, "sum"), InstructionEntry.Jump(InstructionType.LoopEnd, 7), InstructionEntry.Jump(InstructionType.LoopEnd, 11), InstructionEntry.Named(InstructionType.LoadVariableToRegister, 9, "sum"), InstructionEntry.Return(9))
constant Nesting = MlirFunction(List(TypeEntry) + MlirFunction.Shape, MlirFunction.Shape, MethodEntry("Pairs", List(MemberEntry), "Strict/Number", Pairing))
constant Painted = MlirFunction(MlirLanes.Sample.function.types, MlirLanes.Rgb, MethodEntry("Painted", List(MemberEntry) + MemberEntry("colors", "Strict/List(Rgb)", List(InstructionEntry), false), "Strict/Rgb", List(InstructionEntry)))
constant Nested = MlirWholeFunction(MlirFunction(List(TypeEntry), TypeEntry("Strict/Nested", List(MemberEntry) + MemberEntry("position", "Strict/Text", List(InstructionEntry), false), List(MethodEntry)), MethodEntry("Read", List(MemberEntry), "Strict/Number", (InstructionEntry.Named(InstructionType.LoadVariableToRegister, 0, "position"), InstructionEntry.Return(0)))))
constant Allowed = (InstructionType.FieldLoad, InstructionType.LoadConstantToRegister, InstructionType.LoadVariableToRegister, InstructionType.StoreConstantToVariable, InstructionType.StoreRegisterToVariable, InstructionType.IndexCall, InstructionType.Add, InstructionType.Subtract, InstructionType.Multiply, InstructionType.Divide, InstructionType.Modulo, InstructionType.Equal, InstructionType.NotEqual, InstructionType.LessThan, InstructionType.GreaterThan, InstructionType.Invoke, InstructionType.Return, InstructionType.LoopBegin, InstructionType.LoopEnd, InstructionType.JumpEnd, InstructionType.JumpToIdIfFalse, InstructionType.JumpToIdIfTrue, InstructionType.CheckError)
Symbol Text
	Row.Symbol.EndsWith("_whole")
	function.Symbol + "_whole"
IsWhole Boolean
	Row.IsWhole
	Halving.IsWhole
	MlirWholeFunction(MlirLoops.Counting.function).IsWhole is false
	Empty.IsWhole is false
	MlirWholeFunction(MlirArguments.Halfway.functions.First).IsWhole is false
	MlirWholeFunction(Nesting).IsWhole
	IsCallable(0) and MlirWholeTypes(function).IsExact
IsCallable(depth Number) Boolean
	Row.IsCallable(0)
	Row.IsCallable(4) is false
	let returned = function.method.returnType
	let isReturned = (returned is in ("Strict/Number", "Strict/Boolean")) or MlirLanes(function, 0).IsPacked(returned)
	let instructions = function.method.instructions
	let isEnded = (instructions.Length > 0) and (instructions.Last.kind is InstructionType.Return)
	if (depth > 3) or (isReturned is false) or (isEnded is false) or (HasWholeParameters is false)
		return false
	for function.method.instructions
		if IsAllowed(index, depth) is false
			return false
	true
HasWholeParameters Boolean
	Nested.HasWholeParameters is false
	Row.HasWholeParameters
	for MlirInstances(function, 0).Stored(function.type)
		if (value.Name is in function.VariableNames) and (MlirWholeInstance(function).Kind(value.typeName) is "")
			return false
	for function.method.parameters
		if (value.typeName is not "Strict/Number") and (MlirWholeInstance(function).ParameterKind(value) is "i")
			return false
	true
IsByteList(name Text) Boolean
	Row.IsByteList("pixels")
	Row.IsByteList("middle") is false
	MlirParameters(function).IsBytes(name) and (name is in MlirParameters(function).FixedLists)
IsListed(name Text) Boolean
	Row.IsListed("pixels")
	Row.IsListed("middle") is false
	MlirWholeFunction(Painted).IsListed("colors")
	let parameters = MlirParameters(function)
	mutable isLanes = false
	for function.method.parameters
		if value.Name is name
			isLanes = MlirLanes(function, 0).IsPacked(MlirKinds(function).ElementKind(TypeEntry.ShortName(value.typeName)))
	let isParameter = (parameters.IsBytes(name) or isLanes) and (name is in parameters.FixedLists)
	isParameter or MlirWholeInstance(function).IsMemberList(name)
IsAllowed(at Number, depth Number) Boolean
	Row.IsAllowed(15, 0)
	Row.IsAllowed(7, 0)
	let entry = function.method.instructions(at)
	if entry.kind is not in Allowed
		return false
	if entry.kind is InstructionType.LoadVariableToRegister
		return IsLocal(entry.texts(0), at)
	if entry.kind is InstructionType.IndexCall
		return IsListed(entry.texts(0))
	if entry.kind is in (InstructionType.Invoke, InstructionType.FieldLoad)
		return IsCalled(at, depth)
	entry.kind is InstructionType.LoopBegin then IsCounted(at) else IsPlain(entry)
IsPlain(entry InstructionEntry) Boolean
	Row.IsPlain(MlirWhole.Rows(18))
	Row.IsPlain(MlirWhole.Rows(1))
	let isPlain = (entry.texts.Length is 0) or (entry.texts.Last.IndexOf(".") < 0)
	if entry.kind is not in (InstructionType.LoadConstantToRegister, InstructionType.StoreConstantToVariable)
		return isPlain
	let literal = PayloadDecoder(entry).Value(entry.kind is InstructionType.LoadConstantToRegister then 1 else 0)
	isPlain and (literal.kind is in ("Number", "Boolean"))
IsCounted(at Number) Boolean
	Row.IsCounted(6)
	MlirLoops(function, at).Collection is ""
IsLocal(name Text, at Number) Boolean
	Row.IsLocal("sum", 7)
	Row.IsLocal("value", 9)
	Row.IsLocal("value", 1) is false
	let isCounter = (name is in ("value", "index", "outer")) and IsInsideLoop(at)
	if (name is in function.method.ParameterNames) or isCounter or (MlirWholeInstance(function).OwnKind(name) is not "-")
		return true
	for function.method.instructions
		let isStore = value.kind is in (InstructionType.StoreConstantToVariable, InstructionType.StoreRegisterToVariable)
		if isStore and (value.texts.Last is name)
			return true
	false
IsInsideLoop(at Number) Boolean
	Row.IsInsideLoop(9)
	Row.IsInsideLoop(20) is false
	for at
		let isBegin = function.method.instructions(index).kind is InstructionType.LoopBegin
		if isBegin and (function.method.LoopEndOf(index) > at)
			return true
	false
IsCalled(at Number, depth Number) Boolean
	Halving.IsCalled(3, 0)
	let entry = function.method.instructions(at)
	if (entry.kind is InstructionType.FieldLoad) or IsBuilt(entry, at)
		return IsBuilt(entry, at)
	let decoder = PayloadDecoder(entry)
	if (decoder.Text(1) is "Strict/Number") and (decoder.Text(2) is "Floor")
		return true
	if MlirCalls(function, at).NativeHelper(entry, decoder) is not ""
		return false
	let callee = MlirWholeFunction(Callee(entry))
	let isMatched = LoadReuse(function.method.instructions).InvokeReads(entry).Length is callee.Kinds.Length
	isMatched and (callee.function.method.instructions.Length > 0) and callee.IsCallable(depth + 1)
IsBuilt(entry InstructionEntry, at Number) Boolean
	MlirWholeFunction(MlirLanes.Sample.function).IsBuilt(MlirLanes.Made, 3)
	MlirWholeFunction(MlirLanes.Sample.function).IsBuilt(MlirLanes.Greens, 4)
	Halving.IsBuilt(MlirWholeTypes.Halves(3), 3) is false
	let lanes = MlirLanes(function, at)
	if entry.kind is InstructionType.FieldLoad
		return MlirWholeInstance(function).IsReadable(entry)
	let decoder = PayloadDecoder(entry)
	let isByte = MlirLayout(function).IsByte(decoder.Text(1))
	let isBuilt = (decoder.Text(2) is "from") and (isByte or lanes.IsPacked(decoder.Text(1)))
	isBuilt or ((decoder.Text(2) is "Validated") and isByte)
Callee(entry InstructionEntry) MlirFunction
	Halving.Callee(MlirWholeTypes.Halves(3)).method.Name is "Floor"
	let decoder = PayloadDecoder(entry)
	let type = function.TypeOf(decoder.Text(1))
	MlirFunction(function.types, type, decoder.Callee(type))
Kinds Texts
	Halving.Kinds is ("i")
	Row.Kinds is ("p", "i", "i")
	mutable kinds = List(Mutable(Text))
	for function.method.parameters
		kinds.Add(MlirWholeInstance(function).ParameterKind(value))
	MlirWholeInstance(function).UsesSelf then kinds + "o" else kinds
