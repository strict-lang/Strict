has function MlirFunction
has position Number
has registers Text
has variables Text
has naturals Text
has isFlat Boolean = false
constant Row = MlirWholeStatements(MlirWhole.Row.function, 0, MlirWholeTypes.Row.Part(0), MlirWholeTypes.Row.Part(1), MlirWholeTypes.Row.Part(2))
constant Halving = MlirWholeStatements(MlirWholeTypes.Halving.function, 0, MlirWholeTypes.Halving.Part(0), MlirWholeTypes.Halving.Part(1), MlirWholeTypes.Halving.Part(2))
constant Mixed = MlirWholeStatements(MlirWholeTypes.Reused.function, 3, MlirWholeTypes.Reused.Part(0), MlirWholeTypes.Reused.Part(1), MlirWholeTypes.Reused.Part(2))
constant Copies = (InstructionType.LoadConstantToRegister, InstructionType.StoreConstantToVariable, InstructionType.LoadVariableToRegister, InstructionType.StoreRegisterToVariable)
constant Less = InstructionEntry.Binary(InstructionType.LessThan, (0, 1, 2))
constant Bytes = " : (!llvm.ptr, i64) -> !llvm.ptr, i8"
constant Lanes = MlirWholeStatements(MlirWholeFunction.Painted, 0, "ii", "iidiii", "i")
constant Reading = InstructionEntry(InstructionType.IndexCall, "colors", (1, 0, -1))
constant Narrowing = MlirWholeStatements(MlirWholeNarrow.Summing, 6, "iiiiii", "ii", "iiiiiii")
constant Reassociating = "    %t0c = arith.addf %t0a, %t0b" + MlirStatements.Reassociated + " : f64"
constant Remainder = "    %t0c = func.call @strict_remainder(%t0a, %t0b) : (f64, f64) -> f64"
Emitted Texts
	Row.At(13).Emitted.Last is "    llvm.store %t13c, %r11 : i64, !llvm.ptr"
	Row.At(16).Emitted is ("    cf.br ^bb17")
	let entry = function.method.instructions(position)
	if entry.kind is in Copies
		return Moved(entry)
	if entry.kind > InstructionType.StoreSeparator and entry.kind < InstructionType.BinaryOperatorsSeparator
		return entry.kind > InstructionType.ArithmeticSeparator then Compared(entry) else Calculated(entry)
	if entry.kind is InstructionType.Invoke
		return isFlat then MlirFlatCall(At(position), entry).Called else Called(entry)
	if entry.kind is in (InstructionType.IndexCall, InstructionType.FieldLoad)
		return entry.kind is InstructionType.IndexCall then Read(entry) else MlirWholeNative(At(position)).Read(entry)
	entry.kind is InstructionType.Return then Returned(entry) else MlirWholeCounted(At(position)).Emitted(entry)
Moved(entry InstructionEntry) Texts
	Row.At(0).Moved(MlirWhole.Rows(0)).Last is "    llvm.store %t0k, %v_sum : i64, !llvm.ptr"
	Row.At(8).Moved(MlirWhole.Rows(8)).Last is "    llvm.store %t8, %r6 : i64, !llvm.ptr"
	let values = MlirWholeValues(position)
	let name = entry.texts.Length is 0 then "" else entry.texts.Last
	if entry.kind is InstructionType.LoadConstantToRegister
		return MlirWholeNative(At(position)).Constant(entry)
	if entry.kind is InstructionType.StoreConstantToVariable
		return values.Constant(PayloadDecoder(entry).Value(0), "%v_" + name, Variable(name))
	if entry.kind is InstructionType.LoadVariableToRegister
		let target = Variable(name) is "-" then "i" else Variable(name)
		return values.Loaded(Temp(""), "%v_" + name, Variable(name), target) + Store("", target, entry.payload(0))
	Load("", entry.payload(0), Variable(name)) + values.Stored(Temp(""), Variable(name), "%v_" + name, Variable(name))
Calculated(entry InstructionEntry) Texts
	Narrowing.Calculated(MlirWholeNarrow.Lanes(6)).Last is "    llvm.store %t6c, %r4 : i64, !llvm.ptr"
	Mixed.At(4).Emitted(1) is "    %t4a = arith.sitofp %t4al : i64 to f64"
	Mixed.At(4).Emitted(3) is "    %t4b = arith.sitofp %t4bl : i64 to f64"
	Mixed.At(4).Emitted(4) is "    %t4c = arith.divf %t4a, %t4b : f64"
	Halving.At(2).Calculated(MlirWholeTypes.Halves(2))(2) is "    %t2c = arith.floordivsi %t2a, %t2b : i64"
	Text.Combine(Narrowing.Calculated(MlirWholeNarrow.Lanes(6))).IndexOf(" : i32") > 0
	let isWhole = naturals.Substring(position, 1) is "i"
	let type = isWhole then "i" else "f"
	let loads = Load("a", entry.payload(1), type) + Load("b", entry.payload(2), type)
	if isWhole and MlirWholeNarrow(function, position).IsNarrow
		return loads + MlirWholeNarrow(function, position).Emitted + Store("c", type, entry.payload(3))
	loads + Operation(entry.kind, isWhole) + Store("c", type, entry.payload(3))
Operation(kind Number, isWhole Boolean) Text
	Row.Operation(InstructionType.Add, false) is Reassociating
	Row.Operation(InstructionType.Modulo, true) is "    %t0c = arith.remsi %t0a, %t0b : i64"
	Row.Operation(InstructionType.Modulo, false) is Remainder
	let operands = Temp("a") + ", " + Temp("b")
	if (kind is InstructionType.Modulo) and (isWhole is false)
		return "    " + Temp("c") + " = func.call @strict_remainder(" + operands + ") : (f64, f64) -> f64"
	let generic = MlirStatements.Copy.Operation(kind)
	let divided = kind is InstructionType.Divide then "floordivsi" else generic.Substring(0, 3) + "i"
	let whole = kind is InstructionType.Modulo then "remsi" else divided
	let isSum = (isWhole is false) and (kind is in (InstructionType.Add, InstructionType.Subtract))
	let typed = (isSum then MlirStatements.Reassociated else "") + " : " + (isWhole then "i64" else "f64")
	"    " + Temp("c") + " = arith." + (isWhole then whole else generic) + " " + operands + typed
Compared(entry InstructionEntry) Texts
	Row.At(6).Compared(Less)(2) is "    %t6c = arith.cmpi slt, %t6a, %t6b : i64"
	let type = MlirWholeTypes(function).Operands(entry, position, registers, naturals)
	let predicate = MlirStatements.Copy.Predicate(entry.kind)
	let whole = MlirRational.Single.Predicate(entry.kind)
	let operands = (type is "i" then "i " + whole else "f " + predicate) + ", " + Temp("a") + ", " + Temp("b")
	let compare = "    " + Temp("c") + " = arith.cmp" + operands + " : " + MlirWholeValues(position).Typed(type)
	let loads = Load("a", entry.payload(1), type) + Load("b", entry.payload(2), type)
	let flagged = loads + compare + ("    llvm.store " + Temp("c") + ", %flag : i1, !llvm.ptr")
	if entry.payload(0) is not 3
		return flagged
	flagged + ("    " + Temp("d") + " = arith.extui " + Temp("c") + " : i1 to i64") + Store("d", "i", entry.payload(3))
Called(entry InstructionEntry) Texts
	Halving.At(3).Emitted(0) is "    %t3a = llvm.load %r2 : !llvm.ptr -> i64"
	Mixed.Emitted(1) is "    %t3c = func.call @Halves_Halved_1_whole(%t3a0) : (i64) -> i64"
	Mixed.Emitted(2) is "    llvm.store %t3c, %r3 : i64, !llvm.ptr"
	Halving.At(3).Called(MlirWholeTypes.Halves(3)).Last is "    llvm.store %t3a, %r3 : i64, !llvm.ptr"
	let native = MlirWholeNative(At(position)).Emitted(entry)
	if native.Length > 0
		return native
	let callee = MlirWholeFunction(function).Callee(entry)
	let kinds = MlirWholeFunction(callee).Kinds
	let returned = MlirWholeTypes(callee).Returned
	let call = MlirWholeValues(position).Called(Temp("c"), MlirWholeFunction(callee).Symbol, Temp("a"), kinds, returned)
	Arguments(entry, kinds) + call + Store("c", returned, entry.payload(0))
Arguments(entry InstructionEntry, kinds Texts) Texts
	Halving.At(3).Arguments(MlirWholeTypes.Halves(3), ("i")) is ("    %t3a0 = llvm.load %r2 : !llvm.ptr -> i64")
	mutable lines = List(Mutable(Text))
	for LoadReuse(function.method.instructions).InvokeReads(entry)
		lines = lines + Load("a" + index, entry.payload(value), kinds(index))
	lines
Read(entry InstructionEntry) Texts
	Row.At(15).Emitted(2) is "    %t15s = llvm.getelementptr %t15p[%t15i] : (!llvm.ptr, i64) -> !llvm.ptr, i8"
	Row.At(15).Emitted(5) is "    llvm.store %t15c, %r13 : i64, !llvm.ptr"
	Row.At(15).Read(MlirWhole.Rows(15))(2).EndsWith("[%t15i]" + Bytes)
	Lanes.Read(Reading)(4) is "    %t0c = arith.extui %t0b : i32 to i64"
	let kind = Variable(entry.texts(0))
	let pointer = MlirWholeValues(position).Loaded(Temp("p"), "%v_" + entry.texts(0), kind, kind)
	let element = kind is "d" then "i32" else "i8"
	let indexed = Temp("p") + "[" + Temp("i") + "]"
	let slot = "    " + Temp("s") + " = llvm.getelementptr " + indexed + Bytes.Replace("i8", element)
	let read = "    " + Temp("b") + " = llvm.load " + Temp("s") + " : !llvm.ptr -> " + element
	let widened = "    " + Temp("c") + " = arith.extui " + Temp("b") + " : " + element + " to i64"
	pointer + Load("i", entry.payload(1), "i") + slot + read + widened + Store("c", "i", entry.payload(0))
Returned(entry InstructionEntry) Texts
	Halving.At(4).Emitted(1) is "    return %t4 : i64"
	Halving.At(4).Returned(MlirWholeTypes.Halves(4)).Last is "    return %t4 : i64"
	let returned = MlirWholeTypes(function).Returned
	Load("", entry.payload(0), returned) + ("    return " + Temp("") + " : " + MlirWholeValues(position).Typed(returned))
Load(suffix Text, register Number, wanted Text) Texts
	Mixed.Load("a", 2, "f")(0) is "    %t3al = llvm.load %r2i : !llvm.ptr -> i64"
	Mixed.At(5).Load("a", 2, "f") is ("    %t5a = llvm.load %r2 : !llvm.ptr -> f64")
	Halving.At(2).Load("a", 2, "f").Last is "    %t2a = arith.sitofp %t2al : i64 to f64"
	Halving.At(2).Load("a", 2, "o") is ("    %t2a = llvm.load %r2p : !llvm.ptr -> !llvm.ptr")
	Mixed.Load("a", 2, "i") is ("    %t3a = llvm.load %r2i : !llvm.ptr -> i64")
	if MlirWholeValues(position).IsPointer(wanted)
		return MlirWholeValues(position).Loaded(Temp(suffix), "%r" + register + "p", wanted, wanted)
	let reaching = MlirWholeTypes(function).Reaching(register, position, registers, naturals)
	if (Register(register) is "f") and (reaching is "i")
		return MlirWholeValues(position).Loaded(Temp(suffix), "%r" + register + "i", "i", wanted)
	MlirWholeValues(position).Loaded(Temp(suffix), "%r" + register, Register(register), wanted)
Store(suffix Text, given Text, register Number) Texts
	Mixed.At(2).Emitted(3) is "    llvm.store %t2c, %r2i : i64, !llvm.ptr"
	Mixed.Store("c", "i", 0) is ("    llvm.store %t3c, %r0 : i64, !llvm.ptr")
	Mixed.Store("c", "f", 2) is ("    llvm.store %t3c, %r2 : f64, !llvm.ptr")
	Halving.At(2).Store("c", "f", 2).First is "    %t2cs = arith.fptosi %t2c : f64 to i64"
	Halving.At(2).Store("c", "d", 2) is ("    llvm.store %t2c, %r2p : !llvm.ptr, !llvm.ptr")
	Mixed.Store("c", "i", 2).First is "    llvm.store %t3c, %r2i : i64, !llvm.ptr"
	if MlirWholeValues(position).IsPointer(given)
		return MlirWholeValues(position).Stored(Temp(suffix), given, "%r" + register + "p", given)
	let stored = MlirWholeValues(position).Stored(Temp(suffix), given, "%r" + register, Register(register))
	if (Register(register) is "f") and (given is "i")
		return MlirWholeValues(position).Stored(Temp(suffix), "i", "%r" + register + "i", "i") + stored
	stored
Register(register Number) Text
	Mixed.At(2).Emitted(4) is "    %t2cs = arith.sitofp %t2c : i64 to f64"
	Halving.Register(2) is "i"
	registers.Substring(register, 1)
Variable(name Text) Text
	Lanes.Read(Reading)(2).EndsWith("[%t0i]" + Bytes.Replace("i8", "i32"))
	Row.Variable("pixels") is "p"
	variables.Substring(function.VariableNames.Index(name), 1)
At(at Number) MlirWholeStatements
	Row.At(8).Emitted(0) is "    %t8 = llvm.load %v_middle : !llvm.ptr -> i64"
	Row.At(11).Emitted(2) is "    %t11c = arith.subi %t11a, %t11b : i64"
	Row.At(12).Emitted(0) is "    %t12c = arith.constant 0x4010000000000000 : f64"
	Row.At(15).Emitted(0) is "    %t15p = llvm.load %v_pixels : !llvm.ptr -> !llvm.ptr"
	Row.At(15).Emitted(1) is "    %t15i = llvm.load %r12 : !llvm.ptr -> i64"
	Row.At(15).Emitted(3) is "    %t15b = llvm.load %t15s : !llvm.ptr -> i8"
	Row.At(18).Emitted(0) is "    %t18 = llvm.load %r14 : !llvm.ptr -> i64"
	Row.At(18).Emitted(1) is "    llvm.store %t18, %v_sum : i64, !llvm.ptr"
	Halving.At(0).Emitted(1) is "    llvm.store %t0, %r0 : i64, !llvm.ptr"
	Row.At(5).position is 5
	MlirWholeStatements(function, at, registers, variables, naturals, isFlat)
Operation(suffix Text, operation Text, left Text, right Text) Text
	constant Floating = MlirWholeStatements(MlirWhole.Row.function, 6, "fff", "", "fffffff")
	Floating.Compared(Less)(2) is "    %t6c = arith.cmpf olt, %t6a, %t6b : f64"
	Floating.Compared(Less)(5) is "    llvm.store %t6d, %r2i : i64, !llvm.ptr"
	Row.At(6).Compared(Less)(0) is "    %t6a = llvm.load %r0 : !llvm.ptr -> i64"
	Row.At(6).Compared(Less)(1) is "    %t6b = llvm.load %r1 : !llvm.ptr -> i64"
	Row.At(6).Compared(Less)(3) is "    llvm.store %t6c, %flag : i1, !llvm.ptr"
	Row.At(6).Compared(Less)(4) is "    %t6d = arith.extui %t6c : i1 to i64"
	Row.At(6).Compared(Less)(5) is "    llvm.store %t6d, %r2 : i64, !llvm.ptr"
	Row.At(6).Compared(InstructionEntry.Binary(InstructionType.LessThan, (0, 1))).Length is 4
	Row.At(6).Operation("u", "arith.subi", "e", "b") is "    %t6u = arith.subi %t6e, %t6b : i64"
	MlirWholeValues(position).Line(suffix, operation + " " + Temp(left) + ", " + Temp(right) + " : i64")
Temp(suffix Text) Text
	Row.Temp("c") is "%t0c"
	"%t" + position + suffix
