has function MlirFunction
has position Number
has float = "f64"
constant Doubler = MlirKernel.Doubler
constant Doubling = MlirWidths(MlirFastLoop.Doubling.function, 2)
constant Halving = MlirWidths(MlirFastLoop.Halving.function, 2)
constant Quartering = MlirWidths(MlirFastLoop.Quartering.function, 2)
constant Sixes = MlirWidths(MlirFunction(Doubler.types, Doubler.type, Doubler.method, List(Number), 2, "numbers 6"), 2)
constant Fours = MlirWidths(MlirFunction(Doubler.types, Doubler.type, Doubler.method, List(Number), 2, "numbers 4"), 2)
constant Singles = MlirWidths(MlirFastLoop.Halving.function, 2, "f32")
constant Narrowing = MlirWidths(MlirFastLoop.Doubling.function, 2, "f32")
constant Scaling = MlirWidths(MlirFastLoop.Quartering.function, 2, "f32")
constant Pointer = " : (!llvm.ptr, i64) -> !llvm.ptr, "
Width(source Text) Text
	Halving.Width("numbers") is "16"
	Doubling.Width("numbers") is ""
	let parts = function.Packing.Split(" ")
	parts.First is source then parts.Last else ""
Element(source Text) Text
	Halving.Element("numbers") is "f16"
	(Quartering.Element("numbers"), Fours.Element("numbers"), Sixes.Element("numbers")) is ("i8", "f32", "f32")
	Doubling.Element("numbers") is "f64"
	let width = Width(source)
	width is "" then "f64" else width is "16" then "f16" else width is in ("32", "6", "4") then "f32" else "i8"
Loaded(result Text, address Text, items Text, source Text) Texts
	Doubling.Loaded("%x", "%p", "%h", "numbers").Last is "    %x = llvm.load %p : !llvm.ptr -> f64"
	Quartering.Loaded("%x", "%p", "%h", "numbers").Last is "    %x = arith.mulf %xq, %xw : f64"
	Fours.Loaded("%x", "%p", "%h", "numbers").Last is "    %x = arith.extf %xn : f32 to f64"
	MlirWidths(Fours.function, 2, "f32").Loaded("%x", "%p", "%h", "numbers").Last.EndsWith("-> f32")
	let type = Element(source)
	let pointer = "    " + address + " = llvm.getelementptr " + items + "[" + Temp("ki") + "]" + Pointer + type
	let loaded = "    " + result + (type is float then "" else "n") + " = llvm.load " + address + " : !llvm.ptr -> " + type
	(pointer, loaded) + Widened(result, items, source)
Widened(result Text, items Text, source Text) Texts
	Halving.Widened("%x", "%h", "numbers") is ("    %x = arith.extf %xn : f16 to f64")
	Sixes.Widened("%x", "%h", "numbers") is ("    %x = arith.extf %xn : f32 to f64")
	Doubling.Widened("%x", "%h", "numbers").Length is 0
	Singles.Widened("%x", "%h", "numbers") is ("    %x = arith.extf %xn : f16 to f32")
	Narrowing.Widened("%x", "%h", "numbers") is ("    %x = arith.truncf %xn : f64 to f32")
	let type = Element(source)
	if type is float
		return List(Text)
	let operation = type is "f64" then " = arith.truncf " else " = arith.extf "
	let converted = "    " + result + operation + result + "n : " + type + " to " + float
	type is "i8" then Scaled(result, items) else List(Text) + converted
Scaled(result Text, items Text) Texts
	Quartering.Scaled("%x", "%h").First is "    %xf = arith.constant 5 : i64"
	Scaling.Scaled("%x", "%h").Last is "    %x = arith.mulf %xq, %xs : f32"
	let block = "    " + result + "b = arith.shrui " + Temp("ki") + ", " + result + "f : i64"
	let address = "    " + result + "a = llvm.getelementptr " + items + "s[" + result + "b]" + Pointer + "f32"
	let scale = "    " + result + "s = llvm.load " + result + "a : !llvm.ptr -> f32"
	let widened = "    " + result + "w = arith.extf " + result + "s : f32 to f64"
	let byte = "    " + result + "q = arith.sitofp " + result + "n : i8 to " + float
	let factor = result + (float is "f32" then "s" else "w")
	let product = "    " + result + " = arith.mulf " + result + "q, " + factor + " : " + float
	let first = (MlirTyped.Integer.Constant(result + "f", "5"), block, address, scale)
	(float is "f32" then first else first + widened) + (byte, product)
Pointed(result Text, list Text, source Text, plain Text) Texts
	Halving.Pointed("%h", "%l", "numbers", "strict_list_start").First.IndexOf("@strict_list_data(%l)") > 0
	Quartering.Pointed("%h", "%l", "numbers", "strict_list_start").Last.IndexOf("@strict_list_scales(%l)") > 0
	Doubling.Pointed("%h", "%l", "numbers", "strict_list_start").First.IndexOf("@strict_list_start(%l)") > 0
	Fours.Pointed("%h", "%l", "numbers", "strict_list_start").Last.IndexOf("@strict_list_floats(%l)") > 0
	Sixes.Pointed("%h", "%l", "numbers", "strict_list_start").Last.IndexOf("@strict_list_floats(%l)") > 0
	let packed = Width(source) is in ("6", "4") then "strict_list_floats" else "strict_list_data"
	let called = Element(source) is "f64" then plain else packed
	let pointed = "    " + result + " = func.call @" + called + "(" + list + ")" + MlirFastLoop.Items
	let scales = "    " + result + "s = func.call @strict_list_scales(" + list + ")" + MlirFastLoop.Items
	Element(source) is "i8" then (pointed, scales) else List(Text) + pointed
Temp(suffix Text) Text
	Doubling.Temp("ki") is "%t2ki"
	MlirFastLoop(function, position).Temp(suffix)