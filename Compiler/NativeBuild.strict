has logger
has isCrossing Boolean = true
has level Text = Fast
has isWeb Boolean = false
constant Fast = " -O2"
constant Small = " -Os"
constant Intermediates = (".llvm.mlir", ".ll", ".res", ".gpu.mlir", ".gpu.llvm.mlir", ".gpu.ll", ".sm_75.ptx", ".sm_80.ptx", ".amd.mlir", ".amd.llvm.mlir", ".amd.ll", ".amd.bc", ".linux.mlir", ".linux.llvm.mlir", ".linux.ll", ".linux.o", ".pre.js", ".o", ".gpu.opt.ll")
IsProgram(path Text) Boolean
	NativeBuild.IsProgram("Examples/Sum.strict")
	NativeBuild.IsProgram("Character.strict") is false
	"Run" is in TypeShape(File(path).ReadLines).MethodScope.names
Compile(path Text, root Text, isCounting = false, isGating = false) Number
	let isTesting = isCounting or isGating
	let isProgram = (isTesting is false) and IsProgram(path)
	let module = NativeFolder(logger).Module(path, root, isCounting, isProgram)
	if module.types.Length is 0
		return 1
	let base = Output(path, isProgram)
	let program = Device(module.Text, base, root)
	if program is ""
		return 1
	let natives = NativeFolder(logger).Natives(path, root, module.types)
	let built = Build(base, program, Toolchain(Platform.Current, root, natives, isWeb), isCounting)
	isTesting and (built is 0) then Ran(base, Toolchain(Platform.Current, root), path, isCounting) else built
Device(program Text, base Text, root Text) Text
	NativeBuild.Device("module {\n}", "A", ".") is "module {\n}"
	let at = Unsupported(program)
	if at is not -1
		return Failed("Native compilation failed, " + program.Substring(at, program.Length - at).Lines.First)
	let marker = program.IndexOf("\n" + MlirGpu.Marker)
	if marker < 0
		return program
	let gpu = DeviceBuild(Toolchain(Platform.Current, root))
	let device = program.Substring(marker + 1, program.Length - marker - 1)
	let kernels = gpu.Built(base, device, MlirTensors.Attending.Used(program))
	let embedded = gpu.Embedded(program.Substring(0, marker), kernels, base)
	embedded.StartsWith("GPU kernels failed") then Failed(embedded) else embedded
Failed(message Text) Text
	logger.Log(message)
	""
Natives(path Text, root Text, types List(TypeEntry)) Texts
	NativeBuild.Natives("Examples/NativeAdd/NativeAdd.strict", ".", List(TypeEntry)).Length is 0
	constant imported = NativeBuild.Natives("Examples/HelloLogger.strict", "Compiler", List(TypeEntry) + Foreign.Adder)
	imported is List(Text) + ("Examples/NativeAdd" + "/native")
	mutable folders = List(Mutable(Text))
	for types
		let folder = TypeSource(value).NativeFolder(path, root)
		if Directory.Exists(folder) and (folder is not in folders)
			folders.Add(folder)
	folders
Build(base Text, program Text, tools Toolchain, isCounting = false) Number
	let missing = tools.Missing(tools.isWeb then Toolchain.Needed + "emcc" else Toolchain.Needed)
	if missing.Length > 0
		logger.Log(tools.Installing(missing))
		return 1
	File(base + ".mlir").Write(Mlir(program, tools.root, tools.isWeb then Platform.Web else Platform.Current))
	let built = Linked(base, tools)
	logger.Log(built)
	if built.StartsWith("Built ") is false
		return 1
	let crossed = CrossBuild(base, program, tools, isCounting)
	Removed(base)
	Release(logger, base).Packaged(program, crossed, tools.isWeb, isCrossing)
Ran(base Text, tools Toolchain, path Text, isCounting Boolean) Number
	let executable = tools.Executable(base)
	let result = ToolRunner(executable).Execute("")
	logger.Log(result.Output.Trim)
	if ToolRunner.IsCrash(result.exitCode) is false
		logger.Log(Execute.Summary(result.exitCode, path))
	if isCounting
		File(executable).Delete
		File(base + ".mlir").Delete
	result.exitCode
Linked(base Text, tools Toolchain) Text
	NativeBuild.Linked("Compiler/output/missing", Toolchain.OnWindows).StartsWith("mlir-opt failed")
	let executable = tools.Executable(base)
	let isSwapped = (Platform.Current is Platform.Windows) and (tools.isWeb is false) and File(executable).Exists
	let target = isSwapped then executable.Replace(".exe", ".new.exe") else executable
	let built = tools.isWeb then WebBuild(tools).Linked(base, target, level) else tools.Built(base, target, level)
	if isSwapped and built.StartsWith("Built ")
		let old = executable.Replace(".exe", ".old.exe")
		File(executable).Rename(old)
		File(target).Rename(executable)
		File(old).Delete
	let failed = "Could not replace " + executable + " (still running?), the new build is " + target
	isSwapped and File(target).Exists then failed else built.Replace(target, executable)
CrossBuild(base Text, program Text, tools Toolchain, isCounting Boolean) Number
	NativeBuild(Logger).CrossBuild("Compiler/output/missing", "module {}", Toolchain.OnWindows, true) is 0
	NativeBuild(Logger, false).CrossBuild("Compiler/output/missing", "module {}", Toolchain.OnWindows, false) is 0
	if (Platform.Current is not Platform.Windows) or isCounting or (isCrossing is false) or tools.isWeb
		return 0
	File(base + ".linux.mlir").Write(Mlir(program, tools.root, Platform.Linux))
	let crossed = tools.CrossBuilt(base, level)
	logger.Log(crossed)
	crossed.StartsWith("Built ") or crossed.StartsWith("Linux build skipped") then 0 else 1
Removed(base Text)
	for Intermediates
		File(base + value).Delete
	for Toolchain.Parts
		File(base + "-" + value).Delete
Output(path Text, isProgram Boolean) Text
	NativeBuild.Output("Character.strict", false) is "./Character.test"
	NativeBuild.Output("C:/s/A.strict", true) is "C:/s/A"
	NativeBuild.Output("Math", false) is "./Math/Tests.test"
	let source = FileCompiler.Normalized(path)
	if Directory.Exists(path)
		return source + "/Tests.test"
	source.Substring(0, source.Length - 7) + (isProgram then "" else ".test")
Mlir(program Text, root Text, platform Number) Text
	NativeBuild.Mlir("module {\n}", ".", Platform.Linux).Length > 100000
	NativeBuild.Mlir("module {\n}", ".", Platform.MacOS).IndexOf("llvm.func @strict_opendir(") > 0
	NativeBuild.Mlir("module {\n}", ".", Platform.Web).IndexOf("@strict_web(") > 0
	NativeBuild.Mlir("module {\n}", ".", Platform.Web).IndexOf("@memset(!llvm.ptr, i32, i64)") is -1
	let runtime = Text.Combine(File(root + "/Compiler/NativeRuntime.mlir").ReadLines, "\n")
	let system = Platform.Runtime(platform, root)
	let shared = program.Substring(0, program.Length - 1) + runtime
	(platform is Platform.Web then WebBuild.Sized(shared) else shared) + "\n" + Text.Combine(system, "\n") + "\n}"
Unsupported(mlir Text) Number
	NativeBuild.Unsupported("a\nunsupported: x") is 2
	NativeBuild.Unsupported("unsupported: x") is 0
	NativeBuild.Unsupported("@c(\"unsupported: x\")") is -1
	("\n" + mlir).IndexOf("\nunsupported:")
