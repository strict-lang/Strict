has asmPath Text
has platform Number
WriteAsm(asmText Text) Text
	NativeBuild("Compiler/output/write.asm", Platform.Linux).WriteAsm("nop") is "Compiler/output/write.asm"
	File(asmPath).Write(asmText)
	asmPath
ObjectPath Text
	NativeBuild("add.asm", Platform.Windows).ObjectPath is "add.asm.obj"
	asmPath + NasmFormat(platform).ObjectExtension
Assemble ProcessResult
	NativeBuild("Compiler/output/missing.asm", Platform.Linux).Assemble.Failed is true
	ToolRunner("nasm").Execute("-f " + NasmFormat(platform).Format + " " + asmPath + " -o " + ObjectPath)
Link(exePath Text) ProcessResult
	NativeBuild("Compiler/output/missing.asm", Platform.Linux).Link("missing").Failed is true
	ToolRunner(ToolInfo(platform).LinkerName).Execute(ObjectPath + " -o " + exePath + " -s")
SimpleAdd(outputDir Text, target Number) Text
	NativeBuild.SimpleAdd("Compiler/output", Platform.Linux) is "Compiler/output/add.asm"
	NativeBuild(outputDir + "/add.asm", target).WriteAsm(InstructionsToNasm.SimpleAdd(target).Compile)
to Text
	"native-build"