has logger
constant Intermediates = (".llvm.mlir", ".ll", ".res", ".linux.mlir", ".linux.llvm.mlir", ".linux.ll", ".linux.o")
Built(path Text, root Text) Number
	let failed = Execute(logger).Test(path, root)
	failed > 0 then failed else Compile(path, root)
IsProgram(path Text) Boolean
	NativeBuild.IsProgram("Examples/Sum.strict") is true
	NativeBuild.IsProgram("Character.strict") is false
	"Run" is in TypeShape(File(path).ReadLines).MethodScope.names
Compile(path Text, root Text, isCounting = false) Number
	let isProgram = IsProgram(path) and (isCounting is false)
	let types = isCounting then FileCompiler(logger).Compiled(path, root, true) else Execute(logger).Loaded(path, root)
	if types.Length is 0
		return 1
	let program = MlirModule(types, isProgram then "Run" else TestCodegen.Runner, CountedFile(path, root, isCounting)).Text
	let unsupported = Unsupported(program)
	if unsupported is not -1
		logger.Log("Native compilation failed, " + program.Substring(unsupported, program.Length - unsupported).Lines.First)
		return 1
	let base = Output(path, isProgram)
	let built = Build(base, program, Toolchain(Platform.Current, root, Natives(path, root, types)), isCounting)
	isCounting and (built is 0) then Ran(base, Toolchain(Platform.Current, root), path) else built
Natives(path Text, root Text, types List(TypeEntry)) Texts
	NativeBuild.Natives("Examples/NativeAdd/NativeAdd.strict", ".", List(TypeEntry)).Length is 0
	constant imported = NativeBuild.Natives("Examples/HelloLogger.strict", "Compiler", List(TypeEntry) + Foreign.Adder)
	imported is List(Text) + ("Examples/NativeAdd" + "/native")
	mutable folders = List(Mutable(Text))
	for types
		let source = File(value.File).Exists then value.File else root + "/" + value.File
		let file = value.Name.IndexOf("/") < 0 then path else source
		let folder = Path(file).PathOnly.text
		if Directory.Exists(folder + "/native") and (folder + "/native" is not in folders)
			folders.Add(folder + "/native")
	folders
CountedFile(path Text, root Text, isCounting Boolean) Text
	NativeBuild.CountedFile("./Examples/Sum.strict", ".", true) is "Examples/Sum.strict"
	NativeBuild.CountedFile("./Examples/Sum.strict", ".", false) is ""
	isCounting then TypeEntry(FileCompiler.FullName(path, root), List(MemberEntry), List(MethodEntry)).File else ""
Build(base Text, program Text, tools Toolchain, isCounting = false) Number
	let missing = tools.Missing(Toolchain.Needed)
	if missing.Length > 0
		logger.Log(tools.Installing(missing))
		return 1
	File(base + ".mlir").Write(Mlir(program, tools.root, Platform.Current))
	let built = Linked(base, tools)
	logger.Log(built)
	if built.StartsWith("Built ") is false
		return 1
	CrossBuild(base, program, tools, isCounting)
	Removed(base)
	0
Ran(base Text, tools Toolchain, path Text) Number
	let executable = tools.Executable(base)
	let result = ToolRunner(executable).Execute("")
	logger.Log(result.Output.Trim)
	if (result.exitCode >= 0) and (result.exitCode < 128)
		logger.Log(Execute.Summary(result.exitCode, path))
	File(executable).Delete
	File(base + ".mlir").Delete
	result.exitCode
Linked(base Text, tools Toolchain) Text
	NativeBuild.Linked("Compiler/output/missing", Toolchain.OnWindows).StartsWith("mlir-opt failed") is true
	let executable = tools.Executable(base)
	let isSwapped = (Platform.Current is Platform.Windows) and File(executable).Exists
	let target = isSwapped then executable.Replace(".exe", ".new.exe") else executable
	let built = tools.Built(base, target)
	if isSwapped and built.StartsWith("Built ")
		let old = executable.Replace(".exe", ".old.exe")
		File(executable).Rename(old)
		File(target).Rename(executable)
		File(old).Delete
	built.Replace(target, executable)
CrossBuild(base Text, program Text, tools Toolchain, isCounting Boolean)
	if (Platform.Current is Platform.Windows) and (isCounting is false)
		File(base + ".linux.mlir").Write(Mlir(program, tools.root, Platform.Linux))
		logger.Log(tools.CrossBuilt(base))
Removed(base Text)
	for Intermediates
		File(base + value).Delete
Output(path Text, isProgram Boolean) Text
	NativeBuild.Output("Character.strict", false) is "./Character.test"
	NativeBuild.Output("C:/s/A.strict", true) is "C:/s/A"
	let source = FileCompiler.Normalized(path)
	source.Substring(0, source.Length - 7) + (isProgram then "" else ".test")
Mlir(program Text, root Text, platform Number) Text
	NativeBuild.Mlir("module {\n}", ".", Platform.Linux).Length > 100000 is true
	let runtime = Text.Combine(File(root + "/Compiler/NativeRuntime.mlir").ReadLines, "\n")
	let system = File(root + "/Compiler/NativeRuntime" + Platform.NameOf(platform) + ".mlir").ReadLines
	program.Substring(0, program.Length - 1) + runtime + "\n" + Text.Combine(system, "\n") + "\n}"
Unsupported(mlir Text) Number
	NativeBuild.Unsupported("a\nunsupported: x") is 2
	NativeBuild.Unsupported("unsupported: x") is 0
	NativeBuild.Unsupported("@c(\"unsupported: x\")") is -1
	("\n" + mlir).IndexOf("\nunsupported:")