has logger
has isCrossing Boolean = true
has isWeb Boolean = false
has isAndroid Boolean = false
has isIOS Boolean = false
has isSimulator Boolean = false
has selection Text = ""
has isRecursive Boolean = true
has isReleased Boolean = false
has isFast Boolean = false
has gated List(TypeEntry) = List(TypeEntry)
constant Logged = List(TypeEntry) + TypeEntry.HelloLogger
constant Broken = "module {\n  func.func private @A() -> f64 {\n    return %missing : f64\n  }\n}"
constant Unbuilt = NativeBuild(Logger, false, isReleased = true)
constant Watching = "llvm.mlir.global internal @strict_gc_watching(0 : i64)"
constant CpuNotice = "llvm.mlir.global internal @strict_gpu_cpu_notice(1 : i64)"
Folder NativeFolder
	NativeBuild(Logger, gated = Logged).Folder.gated is Logged
	NativeBuild(Logger, selection = "A").Folder.selection is "A"
	NativeBuild(Logger, isRecursive = false).Folder.isRecursive is false
	NativeFolder(logger, selection, isRecursive, gated)
IsProgram(path Text) Boolean
	NativeBuild.IsProgram("Examples/Sum.strict")
	NativeBuild.IsProgram("Character.strict") is false
	"Run" is in TypeShape(File(path).ReadLines).MethodScope.names
Compile(path Text, root Text, isTesting = false, isCounting = false, sources Texts = List(Text))
	let isProgram = (isTesting is false) and IsProgram(path)
	let module = Folder.Module(path, root, isCounting, isProgram, Target, sources)
	if module.types.Length is 0
		return Error("NoTypesCompiled")
	let base = Output(path, isProgram)
	let program = BuildProfile(logger).Program(module, base, root, value)
	if program is ""
		return Error("NoProgramEmitted")
	let natives = NativeFolder(logger, isRecursive = isRecursive).Natives(path, root, module.types)
	Build(base, program, Toolchain(Platform.Current, root, natives, isWeb), isCounting)
Tested(path Text, root Text, isCounting Boolean, sources Texts) Number
	Compile(path, root, true, isCounting, sources)
	Ran(Output(path, false), Toolchain(Platform.Current, root), path, isCounting)
Device(program Text, base Text, root Text) Text
	NativeBuild.Device("module {\n}", "A", ".") is "module {\n" + PtxCache.Empty
	NativeBuild(Logger, isWeb = true).Device("module {\n" + MlirGpu.Marker + "\n  x\n}", "Web", ".").Length > 0
	let failure = Failure(program)
	if failure is not ""
		return Checked("Native compilation failed, " + failure)
	let marker = program.IndexOf("\n" + MlirGpu.Marker)
	if (marker < 0) or isFast
		return PtxCache(base).Unlaunched(program)
	let gpu = DeviceBuild(Toolchain(Platform.Current, root), base.EndsWith(".test") is false)
	let device = program.Substring(marker + 1, program.Length - marker - 1)
	let ptx = Target is Platform.Current then gpu.Built(base, device, MlirTensors.Attending.Used(program)) else List(Text)
	Checked(gpu.Embedded(program.Substring(0, marker), ptx, base))
Checked(built Text) Text
	NativeBuild(Logger).Checked("module") is "module"
	NativeBuild(Logger).Checked("GPU kernels failed: x") is ""
	if (built.StartsWith("GPU kernels failed") or built.StartsWith("Native compilation failed")) is false
		return built
	logger.Log(built)
	""
Natives(path Text, root Text, types List(TypeEntry)) Texts
	NativeBuild.Natives("Examples/NativeAdd/NativeAdd.strict", ".", List(TypeEntry)).Length is 0
	NativeBuild.Natives("Examples/NativeAdd/NativeAdd.strict", ".", List(TypeEntry) + Foreign.Shorter).Length is 0
	constant imported = NativeBuild.Natives("Examples/HelloLogger.strict", "Compiler", List(TypeEntry) + Foreign.Adder)
	imported is List(Text) + ("Examples/NativeAdd" + "/native")
	mutable folders = List(Mutable(Text))
	for types
		if NativeFolder.IsNative(value, types)
			let folder = TypeSource(value).NativeFolder(path, root)
			if Directory.Exists(folder) and (folder is not in folders)
				folders.Add(folder)
	folders
Build(base Text, program Text, tools Toolchain, isCounting = false)
	Unbuilt.Build("Compiler/output/Unbuilt/App", Broken, Toolchain.OnWindows) is Error("NotBuilt")
	Directory.Exists("Compiler/output/Unbuilt/Release") is false
	let built = Rebuilt(base, BuildProfile(logger).Runtime(value, program, tools.root), tools)
	logger.Log(built)
	if built.StartsWith("Built ") is false
		return Error("NotBuilt")
	CrossBuild(base, program, tools, isCounting)
	Intermediates(logger).Removed(base)
	BuildProfile(logger).Packaged(value, base, program, tools)
Target Number
	NativeBuild(Logger, isIOS = true).Target is Platform.IOS
	NativeBuild(Logger, isIOS = true, isSimulator = true).Target is Platform.IOSSimulator
	if isIOS
		return isSimulator then Platform.IOSSimulator else Platform.IOS
	isAndroid then Platform.Android else (isWeb then Platform.Web else Platform.Current)
IsUnchanged(base Text, mlir Text, tools Toolchain) Boolean
	NativeBuild(Logger).IsUnchanged("Compiler/output/missing", "module {\n}", Toolchain.OnWindows) is false
	let sources = NativeSources(tools.natives)
	let headers = tools.natives.Length is 0 then List(Text) else sources.Inputs(Platform.Current, tools.root)
	let inputs = (base + ".mlir", Process.Current.executable, Release(logger, base).Icon) + sources.Files + headers
	let previous = File(base + ".mlir")
	let isCross = isAndroid or isIOS or tools.isWeb or (tools.cpu is not "native")
	if isCross or (previous.Exists is false) or (sources.IsCurrent(tools.Executable(base), inputs) is false)
		return false
	previous.Length is not mlir.Length then false else Text.Combine(previous.ReadLines, "\n") is mlir
Rebuilt(base Text, mlir Text, tools Toolchain) Slow(Text)
	NativeBuild(Logger).Rebuilt("Compiler/output/Written", Broken, Toolchain.OnWindows).StartsWith("mlir-opt failed")
	let missing = tools.Missing(tools.isWeb then Toolchain.Needed + "emcc" else Toolchain.Needed)
	if missing.Length > 0
		return tools.Installing(missing)
	let tuned =Toolchain(tools, cpu = isReleased then "x86-64-v3" else "native")
	if IsUnchanged(base, mlir, tuned)
		return "Built " + tuned.Executable(base) + ", unchanged"
	File(base + ".mlir").Write(mlir)
	if isIOS
		return IOSBuild(tuned, isSimulator).Linked(base)
	isAndroid then AndroidBuild(tuned).Linked(base) else Linked(base, tuned)
Ran(base Text, tools Toolchain, path Text, isCounting Boolean) Number
	let executable = tools.Executable(base)
	let result = ToolRunner(executable).Cleaned(Process.RunTool(executable, ""))
	logger.Log(result.Output.Trim)
	if ToolRunner.IsCrash(result.exitCode) is false
		logger.Log(Execute.Summary(result.exitCode, path))
	if isCounting
		File(executable).Delete
		File(base + ".mlir").Delete
	result.exitCode
Linked(base Text, tools Toolchain) Slow(Text)
	NativeBuild.Linked("Compiler/output/missing", Toolchain.OnWindows).StartsWith("mlir-opt failed")
	let executable = tools.Executable(base)
	let isSwapped = (Platform.Current is Platform.Windows) and (tools.isWeb is false) and File(executable).Exists
	let target = isSwapped then executable.Replace(".exe", ".new.exe") else executable
	let built = tools.isWeb then WebBuild(tools).Linked(base, target) else tools.Built(base, target)
	let replaced = isSwapped and built.StartsWith("Built ") then NativeCompiler.Replaced(executable, target) else true
	let failed = "Could not replace " + executable + " (still running?), the new build is " + target
	replaced then built.Replace(target, executable) else failed
CrossBuild(base Text, program Text, tools Toolchain, isCounting Boolean)
	NativeBuild(Logger).CrossBuild("Compiler/output/missing", "module {}", Toolchain.OnWindows, true) is not Error
	NativeBuild(Logger, false).CrossBuild("Compiler/output/missing", "module {}", Toolchain.OnWindows, false) is not Error
	if (Target is not Platform.Windows) or isCounting or (isCrossing is false)
		return
	File(base + ".linux.mlir").Write(Mlir(program, tools.root, Platform.Linux))
	let crossed = LinuxBuild(tools).Built(base)
	logger.Log(crossed)
	if crossed.StartsWith("Built ") is false
		return Error("CrossBuildFailed")
Output(path Text, isProgram Boolean) Text
	NativeBuild.Output("Character.strict", false) is "./obj/Character.test"
	NativeBuild.Output("C:/s/A.strict", true) is "C:/s/obj/A"
	NativeBuild.Output("Math", false) is "./Math/obj/Tests.test"
	if Directory.Exists(path)
		return FileCompiler.Normalized(path) + "/obj/Tests.test"
	let intermediate = BuildOutput.Intermediate(path)
	intermediate.Substring(0, intermediate.Length - 7) + (isProgram then "" else ".test")
Mlir(program Text, root Text, platform Number) Slow(Text)
	NativeBuild.Mlir("module {\n}", ".", Platform.Linux).Length > 100000
	NativeBuild.Mlir("module {\n}", ".", Platform.MacOS).IndexOf("llvm.func @strict_opendir(") > 0
	NativeBuild.Mlir("module {\n}", ".", Platform.Web).IndexOf("@strict_web(") > 0
	NativeBuild.Mlir("module {\n}", ".", Platform.Web).IndexOf("@memset(!llvm.ptr, i32, i64)") is -1
	NativeBuild(Logger, false).Mlir("module {\n" + Watching + "\n}", ".", Platform.Linux).Split(Watching).Length is 2
	let runtime = Released(Text.Combine(File(root + "/Compiler/NativeRuntime.mlir").ReadLines, "\n"))
	let system = Text.Combine(Platform.Runtime(platform, root), "\n")
	let body = program.Substring(0, program.Length - 1)
	if platform is Platform.Web
		return WebBuild.Sized(body + runtime) + "\n" + system + "\n}"
	Text.Combine((body, runtime, "\n", system, "\n}"), "")
Released(mlir Text) Text
	NativeBuild(Logger, false, isReleased = true).Released(Watching) is Watching
	NativeBuild(Logger, false).Released(Watching) is Watching.Replace("(0 : i64)", "(1 : i64)")
	NativeBuild(Logger, isWeb = true).Released(Watching) is Watching
	NativeBuild(Logger, isWeb = true).Released(CpuNotice) is CpuNotice.Replace("(1 : i64)", "(0 : i64)")
	NativeBuild(Logger, false).Released(CpuNotice) is CpuNotice
	let quiet = isWeb then mlir.Replace(CpuNotice, CpuNotice.Replace("(1 : i64)", "(0 : i64)")) else mlir
	isReleased or isCrossing or isWeb then quiet else quiet.Replace(Watching, Watching.Replace("(0 : i64)", "(1 : i64)"))
Failure(program Text) Text
	NativeBuild.Failure("unsupported: a\nb") is "unsupported: a\nb"
	NativeBuild.Failure("x\nunsupported: a\nb") is "unsupported: a"
	NativeBuild.Failure("@c(\"unsupported: x\")") is ""
	if program.StartsWith("unsupported:")
		return program
	let at = program.IndexOf("\nunsupported:")
	at < 0 then "" else program.Substring(at + 1, program.Length - at - 1).Lines.First
