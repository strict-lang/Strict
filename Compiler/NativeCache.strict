has command Text
has rest Texts
IsEnabled Boolean
	NativeCache("test", ("Math", ".", "native")).IsEnabled
	NativeCache("test", ("Math/Vector2.strict", ".", "native")).IsEnabled
	NativeCache("test", ("Math/Vector2.strict", ".", "Length")).IsEnabled is false
	NativeCache("build", ("Examples/Sum.strict", ".", "fast")).IsEnabled
	if rest.Length < 2
		return false
	let isSource = Directory.Exists(rest(0)) or (File(rest(0)).Exists and (File(rest(0)).Modified is not 0))
	if (isSource is false) or ((command is "test") and (TestRequest(rest).Selection is not in ("", "*")))
		return false
	(NativeCompiler.Options(rest) - "native" - "unit" - "fast" - "windows" - "linux").Length is 0
CacheFile Text
	NativeCache("test", ("Math", ".", "native")).CacheFile is "./Math/obj/Tests.test.nativecache"
	NativeCache("build", ("Examples/Sum.strict", ".")).CacheFile is "./Examples/obj/Sum.nativecache"
	NativeBuild.Output(rest(0), (command is "build") and NativeBuild.IsProgram(rest(0))) + ".nativecache"
Key Text
	"3\t" + Directory.Current + "\t" + command + "\t" + Text.Combine(rest, "\t")
Output Text
	let program = (command is "build") and NativeBuild.IsProgram(rest(0))
	Toolchain(Platform.Current, rest(1)).Executable(NativeBuild.Output(rest(0), program))
Stamp(path Text) Text
	NativeCache.Stamp("Compiler/output/missing") is "unknown"
	NativeCache.Stamp(Process.Current.executable).Length is 16
	constant minuteLength = 16
	let built = Process(path).Built
	built.Length < minuteLength then "unknown" else built.Substring(0, minuteLength)
Message Text
	let source = rest(0)
	let executable = Output
	let changed = " (last changed " + Stamp(source) + ")"
	let built = " (last build " + Stamp(executable) + ")"
	let prefix = command is "test" then "Tests up to date: " else "Up to date: "
	prefix + source + changed + " < " + Path(executable).FileName.text + built
IsCurrent Boolean
	if (IsEnabled is false) or (File(CacheFile).Exists is false) or (File(Output).Exists is false)
		return false
	let lines = File(CacheFile).ReadLines
	let valid = (lines.Length > 1) and (lines.Length % 2 is 1) and (lines.First is Key)
	valid and Matches(lines.Slice(1, lines.Length - 1))
Matches(lines Texts) Boolean
	for Range(0, lines.Length / 2)
		let position = value * 2
		if Value(lines(position)) is not lines(position + 1)
			return false
	true
Saved(inputs Texts)
	if IsEnabled and Matches(inputs)
		Written(Text.Combine((List(Text) + Key) + inputs + Snapshot(Outputs.Unique), "\n"))
Inputs(sources Texts) Texts
	"./Content/**" is not in NativeCache("test", ("Math", ".", "native")).Inputs(List(Text))
	"./Examples/Content/**" is in NativeCache("build", ("Examples/Sum.strict", ".")).Inputs(List(Text))
	let source = FileCompiler.Normalized(rest(0))
	let runtimes = Directory.Files(rest(1) + "/Compiler", "NativeRuntime*.mlir")
	let extension = Toolchain(Platform.Current, rest(1)).Extension
	let tools = (List(Text) + (rest(1) + "/strict" + extension)) - Output - Output.Lower
	let content = Path(source).PathOnly.text + "/Content"
	let inputs = sources + runtimes + tools + NativeInputs(Folders(sources))
	command is "test" then inputs else inputs + (content + "/**")
Folders(sources Texts) Texts
	mutable folders = List(Text)
	for sources
		folders = folders + Path(value).PathOnly.text
	folders.Unique
NativeInputs(folders Texts) Texts
	mutable files = List(Text)
	let tools = Toolchain(Platform.Current, rest(1))
	for Toolchain.Needed + ("llvm-split", "lld-link", "llvm-rc")
		files = files + Process.Find(tools.Located(value)).executable
	for folders
		let native = value + "/native"
		let sources = NativeSources(List(Text) + native)
		let tokens = sources.Flags(Platform.Current, rest(1)).Split(" ")
		files = files + sources.Files + sources.Inputs(Platform.Current, rest(1)) + sources.Sources(tokens)
		files = files + (value + "/README.md", value + "/.origin", value + "/*", value + "/", native + "/*")
	files
Snapshot(paths Texts) Texts
	mutable lines = List(Text)
	for paths
		lines = lines + value + Value(value)
	lines
Value(path Text) Text
	NativeCache("build", ("Math/Vector3.strict", ".")).Value("Math/**") is "" + Directory.Modified("Math")
	if path.EndsWith("/**")
		return "" + Directory.Modified(path.Substring(0, path.Length - 3))
	if path.EndsWith("/")
		return Text.Combine(Directory.Directories(path).Sorted, "\t")
	if path.EndsWith("/*") is false
		return "" + File(path).Modified
	let folder = path.Substring(0, path.Length - 2)
	mutable files = List(Text)
	for ("*.strict", "*.c", "*.h", "*.m", "*.flags", "*.ico")
		files = files + Directory.Files(folder, value)
	Text.Combine(files.Sorted, "\t")
Outputs Texts
	let base = NativeBuild.Output(rest(0), (command is "build") and NativeBuild.IsProgram(rest(0)))
	let release = Release(Logger, base)
	mutable files = List(Text) + Output
	for Release.Sidecars
		if File(base + value).Exists
			files = files + (base + value)
	files + Released(release.Parent)
Released(parent Text) Texts
	NativeCache("build", ("Examples/Sum.strict", ".")).Released("Compiler/output/Missing").Length is 2
	NativeCache("build", ("Examples/Sum.strict", ".", "windows")).IsEnabled
	NativeCache("build", ("Examples/Sum.strict", ".", "linux")).IsEnabled
	NativeCache("build", ("Examples/Sum.strict", ".", "web")).IsEnabled is false
	mutable files = List(Text)
	let name = Path(Output).FileName.text
	for (parent + "/Release", parent + "/Release/" + Platform.NameOf(Platform.Current))
		files = files + (value + "/Content/**")
		if File(value + "/" + name).Exists
			files = files + (value + "/" + name)
	let linux = parent + "/Release/Linux/" + name.Replace(".exe", "")
	File(linux).Exists then files + linux else files
Written(text Text)
	let temporary = CacheFile + "." + 1000000000.Random.Floor + ".tmp"
	File(temporary).Write(text)
	if Text.Combine(File(temporary).ReadLines, "\n") is text
		File(temporary).Rename(CacheFile)
	File(temporary).Delete