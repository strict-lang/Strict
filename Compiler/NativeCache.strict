has command Text
has rest Texts
constant Adding = NativeCache("build", ("Examples/NativeAdd/NativeAdd.strict", "."))
constant Wgsl = "/Compiler/NativeRuntimeWgsl.js"
constant Script = "/Compiler/WebRuntime.js"
IsEnabled Boolean
	NativeCache("test", ("Math", ".", "native")).IsEnabled
	NativeCache("test", ("Math/Vector2.strict", ".", "native")).IsEnabled
	NativeCache("test", ("Math/Vector2.strict", ".", "Length")).IsEnabled is false
	NativeCache("build", ("Examples/Sum.strict", ".", "fast")).IsEnabled
	if rest.Length < 2
		return false
	isSource = Directory.Exists(rest(0)) or File(rest(0)).Exists and File(rest(0)).Modified is not 0
	if isSource is false or command is "test" and TestRequest(rest).Selection is not in ("", "*")
		return false
	(NativeCompiler.Options(rest) - "native" - "unit" - "fast" - "windows" - "linux" - "web").Length is 0
CacheFile Text
	NativeCache("test", ("Math", ".", "native")).CacheFile is "./Math/obj/Tests.test.nativecache"
	NativeCache("build", ("Examples/Sum.strict", ".")).CacheFile is "./Examples/obj/Sum.nativecache"
	NativeBuild.Output(rest(0), command is "build" and NativeBuild.IsProgram(rest(0))) + ".nativecache"
Key Text
	"3\t" + Directory.Current + "\t" + command + "\t" + Text.Combine(rest, "\t")
Output Text
	NativeCache("build", ("Examples/Sum.strict", ".", "web")).Output is "./Examples/Release/Web/Sum.html"
	program = command is "build" and NativeBuild.IsProgram(rest(0))
	base = NativeBuild.Output(rest(0), program)
	if "web" is in NativeCompiler.Options(rest)
		return Release(base).Parent + "/Release/Web/" + Path(base).FileName.text + ".html"
	Toolchain(Platform.Current, rest(1)).Executable(base)
Stamp(path Text) Text
	NativeCache.Stamp("Compiler/output/missing") is "unknown"
	NativeCache.Stamp(Process.Current.executable).Length is 16
	constant minuteLength = 16
	built = Process(path).Built
	built.Length < minuteLength then "unknown" else built.Substring(0, minuteLength)
Message Text
	source = rest(0)
	executable = Output
	changed = " (last changed " + Stamp(source) + ")"
	built = " (last build " + Stamp(executable) + ")"
	prefix = command is "test" then "Tests up to date: " else "Up to date: "
	prefix + source + changed + " < " + Path(executable).FileName.text + built
IsCurrent Boolean
	if IsEnabled is false or File(CacheFile).Exists is false or File(Output).Exists is false
		return false
	lines = File(CacheFile).ReadLines
	lines.Length > 1 and lines.Length % 2 is 1 and lines.First is Key and Matches(lines.Slice(1, lines.Length - 1))
Matches(lines Texts) Boolean
	NativeCache("build", ("A.strict", "C:/s")).Matches(("C:/s/strict.exe", "1")) is false
	for Range(0, lines.Length / 2)
		position = value * 2
		if Value(lines(position)) is not lines(position + 1)
			return false
	true
Save(inputs Texts)
	if IsEnabled and Matches(inputs)
		Write(Text.Combine((List(Text) + Key) + inputs + Snapshot(Outputs.Unique), "\n"))
Inputs(sources Texts) Texts
	"./Content/**" is not in NativeCache("test", ("Math", ".", "native")).Inputs(List(Text))
	"./Examples/Content/**" is in NativeCache("build", ("Examples/Sum.strict", ".")).Inputs(List(Text))
	source = FileCompiler.Normalize(rest(0))
	runtimes = Directory.Files(rest(1) + "/Compiler", "NativeRuntime*.mlir")
	tools = List(Text) + (rest(1) + "/strict" + Toolchain(Platform.Current, rest(1)).Extension)
	web = WebBuild(Toolchain(Platform.Current, rest(1), isWeb = true))
	shell = web.Shell(NativeBuild.Output(rest(0), command is "build" and NativeBuild.IsProgram(rest(0))))
	extra = shell.EndsWith(".shell.html") then List(Text) + shell else List(Text)
	webInputs = "web" is in NativeCompiler.Options(rest) then (rest(1) + Wgsl, rest(1) + Script, shell) else extra
	inputs = sources + runtimes + (tools - Output - Output.Lower) + webInputs + NativeInputs(Folders(sources))
	command is "test" then inputs else inputs + (Path(source).PathOnly.text + "/Content/**")
Files Texts slow
	"./Examples/NativeAdd/Adder.strict" is in Adding.Files
	"./Examples/NativeAdd/native/Adder.c" is in Adding.Inputs(Adding.Files)
	SourceFiles(rest(1)).Of(FileCompiler.Normalize(rest(0)))
Folders(sources Texts) Texts
	NativeCache("build", ("Math/Vector3.strict", ".")).Folders(("a/b.strict", "a/c.strict", "d/e.strict")) is ("a", "d")
	mutable folders = List(Text)
	for sources
		folders = folders + Path(value).PathOnly.text
	folders.Unique
NativeInputs(folders Texts) Texts
	mutable files = List(Text)
	tools = Toolchain(Platform.Current, rest(1))
	for Toolchain.Needed + ("llvm-split", "lld-link", "llvm-rc")
		files = files + Process.Find(tools.Locate(value)).executable
	for folders
		native = value + "/native"
		sources = NativeSources(List(Text) + native)
		tokens = sources.Flags(Platform.Current, rest(1)).Split(" ")
		files = files + sources.Files + sources.Inputs(Platform.Current, rest(1)) + sources.Sources(tokens)
		files = files + (value + "/README.md", value + "/.origin", value + "/*", value + "/", native + "/*")
	files
Snapshot(paths Texts) Texts
	mutable lines = List(Text)
	for paths
		lines = lines + value + Value(value)
	lines
Value(path Text) Text
	NativeCache("build", ("Math/Vector3.strict", ".")).Value("Math/**") is "" + Directory.ReadModified("Math")
	NativeCache("build", ("Math/Vector3.strict", ".")).Value("Math/") is ""
	if path.EndsWith("/**")
		return "" + Directory.ReadModified(path.Substring(0, path.Length - 3))
	if path.EndsWith("/")
		return Text.Combine(BuildOutput.Packages(path), "\t")
	if path.EndsWith("/*") is false
		return "" + File(path).Modified
	folder = path.Substring(0, path.Length - 2)
	mutable files = List(Text)
	for ("*.strict", "*.c", "*.h", "*.m", "*.flags", "*.ico")
		files = files + Directory.Files(folder, value)
	Text.Combine(files.Sorted, "\t")
Outputs Texts
	base = NativeBuild.Output(rest(0), command is "build" and NativeBuild.IsProgram(rest(0)))
	release = Release(base)
	mutable files = List(Text) + Output
	if "web" is in NativeCompiler.Options(rest)
		for (".wasm", ".js")
			sidecar = Output.Replace(".html", value)
			if File(sidecar).Exists
				files = files + sidecar
	for Release.Sidecars
		if File(base + value).Exists
			files = files + (base + value)
	files + FindReleases(release.Parent)
FindReleases(parent Text) Texts
	NativeCache("build", ("Examples/Sum.strict", ".")).FindReleases("Compiler/output/Missing").Length is 2
	NativeCache("build", ("Examples/Sum.strict", ".", "windows")).IsEnabled
	NativeCache("build", ("Examples/Sum.strict", ".", "linux")).IsEnabled
	NativeCache("build", ("Examples/Sum.strict", ".", "web")).IsEnabled
	mutable files = List(Text)
	name = Path(Output).FileName.text
	for (parent + "/Release", parent + "/Release/" + Platform.NameOf(Platform.Current))
		files = files + (value + "/Content/**")
		if File(value + "/" + name).Exists
			files = files + (value + "/" + name)
	linux = parent + "/Release/Linux/" + name.Replace(".exe", "")
	File(linux).Exists then files + linux else files
Write(text Text)
	temporary = CacheFile + "." + 1000000000.Random.Floor + ".tmp"
	File(temporary).Write(text)
	if Text.Combine(File(temporary).ReadLines, "\n") is text
		File(temporary).Rename(CacheFile)
	File(temporary).Delete