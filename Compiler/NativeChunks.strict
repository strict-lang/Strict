has selection Text = ""
constant Size = 4
constant Saving = "Compiler/output/Hellos.strictbinary"
constant Unsaved = "Compiler/output/Unsaved.strictbinary"
constant Stamping = "Compiler/output/Stamping.strictbinary"
constant Single = NativeChunks.Of(List(Text) + "Missing.strict", true)
constant Clashing = (List(Text) + "a/P.strict", List(Text) + "b/P.strict")
Of(folders Texts, isParallel Boolean) List(Texts)
	NativeChunks.Of(("Examples/Sum.strict", "Examples/HelloLogger.strict"), true).Length is 2
	NativeChunks.Of(List(Text) + "Math", false).Length is 1
	NativeChunks.Of(List(Text) + "Math", true).First.Length is 4
	mutable chunks = List(Mutable(Texts))
	for folders
		paths = Directory.Exists(value) then Directory.Files(value, "*.strict") else List(Text) + value
		size = isParallel then Size else paths.Length
		for Range(0, paths.Length is 0 then 0 else ((paths.Length + size - 1) / size).Floor)
			chunks.Add(paths.Slice(value * size, (paths.Length - value * size).Clamp(0, size)))
	chunks
Compile(chunks List(Texts), root Text, base Text) List(List(TypeEntry))
	NativeChunks("*").Compile(List(Texts), ".", "Compiler/output/Compiled").Length is 0
	NativeChunks("*").Compile(Clashing, ".", "Compiler/output/Compiled").First.Length is 0
	clash = Clash(chunks)
	if clash is not ""
		logger.Log(clash)
		return (List(TypeEntry), List(TypeEntry))
	loaded = Load(Prepare(chunks, root, base), chunks)
	for chunks
		loaded(index).Length > 0 then loaded(index) else NativeFolder(selection, false).CollectAll(value, root)
Clash(chunks List(Texts)) Text
	NativeChunks.Clash(Single) is ""
	NativeChunks.Clash(Clashing).StartsWith("SameNamedTypes: P in a/P.strict and b/P.strict, a build keys")
	mutable seen = Dictionary(Text, Text)
	for chunks
		chunk = value
		for chunk
			name = Path(value).FileName.text
			if name is in seen
				places = name.Replace(".strict", "") + " in " + seen(name) + " and " + value
				return "SameNamedTypes: " + places + ", a build keys types by their plain name, rename one"
			seen.Add(name, value)
	""
Chunk(base Text, index Number) Text
	NativeChunks.Chunk("./Math/Tests.test", 2) is "./Math/Tests.test-2.strictbinary"
	base + "-" + index + ".strictbinary"
Prepare(chunks List(Texts), root Text, base Text) Texts
	NativeChunks.Prepare(Single, ".", "Compiler/output/Prepared") is ("")
	if chunks.Length is 1
		return List(Text) + ""
	mutable commands = List(Mutable(Text))
	for chunks
		commands.Add(NativeCompiler.Arguments("linked", (Chunk(base, index), root, selection) + value))
	for ToolRunner(NativeCompiler.Executable(root)).ExecuteAll(commands, "Frontend / chunks (" + chunks.Length + " jobs)")
		Chunk(base, index)
Save(output Text, root Text, paths Texts)
	NativeChunks("*").Save(Unsaved, ".", List(Text) + "Missing.strict") is Error("ChunkNotCompiled")
	if IsKept(output, paths, root)
		return
	File(output).Delete
	counted = NativeFolder(selection, false).CollectAll(paths, root)
	if counted.Length < paths.Length
		return Error("ChunkNotCompiled")
	File(output).Write(BinaryFile(output).Pack(List(Number), counted, List(Text)))
	Stamp(output, paths, root, counted)
IsKept(output Text, paths Texts, root Text) Boolean
	NativeChunks.IsKept(Unsaved, NativeFolder.Hellos, ".") is false
	NativeChunks("*").Save(Stamping, ".", NativeFolder.Hellos) is not Error
	NativeChunks("*").IsKept(Stamping, NativeFolder.Hellos, ".")
	NativeChunks.IsKept(Stamping, NativeFolder.Hellos, ".") is false
	stamp = File(output + ".stamp")
	if File(output).Exists is false or stamp.Exists is false
		return false
	lines = stamp.ReadLines
	lines.First is Key(paths, root) and NativeCache.Adding.Matches(lines.Slice(1, lines.Length - 1))
Key(paths Texts, root Text) Text
	NativeChunks("*").Key(List(Text) + "A.strict", ".") is ".\t*\tA.strict"
	Text.Combine((root, selection) + paths, "\t")
Stamp(output Text, paths Texts, root Text, types List(TypeEntry))
	NativeChunks.Stamp(Unsaved, List(Text) + "Examples/Sum.strict", ".", List(TypeEntry)) is not Error
	mutable inputs = List(Text) + Process.Current.executable
	for paths
		inputs = inputs + (Path(value).PathOnly.text + "/*")
	for types
		inputs = inputs + TypeSource(value).Locate(Path(paths.First).PathOnly.text)
	lines = (List(Text) + Key(paths, root)) + NativeCache.Adding.Snapshot(inputs.Unique)
	File(output + ".stamp").Write(Text.Combine(lines, "\n"))
Load(outputs Texts, chunks List(Texts)) List(List(TypeEntry))
	NativeChunks.Load(List(Text) + Unsaved, Single).First.Length is 0
	Decodings(outputs, chunks)
Decodings(outputs Texts, chunks List(Texts)) List(List(TypeEntry))
	NativeChunks.Decodings(List(Text) + "", Single).Length is 1
	for outputs
		Decode(value, chunks(index).Length)
Decode(output Text, count Number) List(TypeEntry)
	NativeChunks.Decode(Unsaved, 1).Length is 0
	NativeChunks("*").Save(Saving, ".", NativeFolder.Hellos) is not Error
	NativeChunks.Decode(Saving, 2)(1).Name is "Strict/Examples/HelloLogger"
	if File(output).Exists is false
		return List(TypeEntry)
	types = BinaryFile(output).Types(BinaryFile(output).Unpack(File(output).ReadBytes))
	types.Length < count then List(TypeEntry) else types
