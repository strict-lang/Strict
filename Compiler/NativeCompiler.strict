has logger
Run(arguments Texts) Number
	let started = Process.Elapsed
	let rest = arguments.Slice(1, arguments.Length - 1)
	if Locked(rest(0)) is false
		return 1
	let cache = NativeCache(arguments(0), rest)
	if BuildProfile(logger).Current(cache)
		logger.Log(cache.Message)
		BuildProfile(logger).Reported("Build total", started)
		return 0
	let failed = BuildProfile(logger).Compiled(cache)
	BuildProfile(logger).Reported(failed is 0 then "Build total" else "Build FAILED (" + failed + "), total", started)
	failed
Locked(target Text) Slow(Boolean)
	let lock = File(Lock(target))
	if lock.Locked
		return true
	logger.Log("Waiting for the other build of " + target)
	let started = Process.Elapsed
	for as long as Process.Elapsed - started < Strict.MaxWait
		Process.Wait(0.1)
		if lock.Locked
			return true
	logger.Log("The other build of " + target + " did not finish within " + Strict.MaxWait + " seconds")
	false
Lock(target Text) Text
	NativeCompiler.Lock("Examples/Sum.strict") is "./Examples/obj/Sum.strict.lock"
	let path = BuildOutput.Intermediate(target) + ".lock"
	Directory.Create(Path(path).PathOnly.text)
	path
Compiled(command Text, rest Texts, sources Texts = List(Text)) Number
	if command is "build"
		return Checked(rest, sources)
	if command is "linked"
		return NativeChunks(logger, rest(2)).Saved(rest(0), rest(1), rest.Slice(3, rest.Length - 3))
	let request = TestRequest(rest)
	if request.Message is not ""
		logger.Log(request.Message)
		return 2
	let isCounting = request.Option is "lines"
	let isRecursive = "--no-recursive" is not in request.Options
	let build = NativeBuild(logger, false, selection = request.Selection, isRecursive = isRecursive)
	build.Compile(rest(0), rest(1), isCounting, isCounting is false, sources)
Checked(rest Texts, sources Texts) Number
	let failed = Execute(logger).Test(rest(0), rest(1), true)
	failed is 0 then Built(rest, sources) else failed
Built(rest Texts, sources Texts = List(Text)) Number
	let options = Options(rest)
	if (rest.Length > 2) and (rest(2) is "library")
		return LibraryBuild(logger).Built(rest(0), rest(1))
	if IsMixed(options)
		logger.Log("Mobile target cannot be combined with another platform")
		return 1
	Configured(options).Compile(rest(0), rest(1), false, false, sources)
IsMixed(options Texts) Boolean
	NativeCompiler.IsMixed(("android", "ios"))
	NativeCompiler.IsMixed(("ios", "web"))
	NativeCompiler.IsMixed(("ios", "simulator")) is false
	let isMobile = ("android" is in options) or ("ios" is in options)
	let isDesktop = ("web" is in options) or ("linux" is in options) or ("windows" is in options)
	(("android" is in options) and ("ios" is in options)) or (isMobile and isDesktop)
Configured(options Texts) NativeBuild
	NativeCompiler(Logger).Configured(("ios", "simulator")).Target is Platform.IOSSimulator
	NativeCompiler(Logger).Configured(("linux", "web")).isCrossing is false
	NativeCompiler(Logger).Configured(List(Text) + "windows").isReleased
	let isWeb = "web" is in options
	let isCrossing = ("linux" is in options) and (isWeb is false)
	let configured = NativeBuild(logger, isCrossing, isWeb, "android" is in options, "ios" is in options)
	NativeBuild(configured, isSimulator = "simulator" is in options, isReleased = "windows" is in options)
Replaced(executable Text, target Text) Boolean
	let old = executable.Replace(".exe", ".old.exe")
	File(executable).Rename(old)
	if File(executable).Exists
		return false
	File(target).Rename(executable)
	if File(target).Exists
		File(old).Rename(executable)
		return false
	File(old).Delete
	File(executable).Exists
Options(rest Texts) Texts
	NativeCompiler.Options(("a.strict", ".", "linux")) is ("linux")
	rest.Length > 2 then rest.Slice(2, rest.Length - 2) else List(Text)
Executable(root Text) Text
	NativeCompiler.Executable(".") is "./Compiler/NativeCompiler" + Toolchain(Platform.Current, ".").Extension
	root + "/Compiler/NativeCompiler" + Toolchain(Platform.Current, root).Extension
Arguments(command Text, rest Texts) Text
	NativeCompiler.Arguments("build", ("a b.strict", ".")) is "build \"a b.strict\" \".\""
	mutable text = command
	for rest
		text = text + " \"" + value + "\""
	text