has logger
Run(arguments Texts) Number
	let rest = arguments.Slice(1, arguments.Length - 1)
	if arguments(0) is "build"
		return Built(rest)
	NativeBuild(logger).Compile(rest(0), rest(1), true)
Built(rest Texts) Number
	let option = rest.Length > 2 then rest(2) else ""
	if option is "library"
		return LibraryBuild(logger).Built(rest(0), rest(1))
	let options = Options(rest)
	let isWeb = "web" is in options
	NativeBuild(logger, ("linux" is in options) and (isWeb is false), Level(rest), isWeb).Built(rest(0), rest(1))
Level(rest Texts) Text
	NativeCompiler.Level(("a.strict", ".", "linux", "small")) is NativeBuild.Small
	NativeCompiler.Level(("a.strict", ".")) is NativeBuild.Fast
	"small" is in Options(rest) then NativeBuild.Small else NativeBuild.Fast
Options(rest Texts) Texts
	NativeCompiler.Options(("a.strict", ".", "linux")) is ("linux")
	rest.Length > 2 then rest.Slice(2, rest.Length - 2) else List(Text)