constant Swapped = PtxCache("Compiler/output/Swapped")
constant Mixed = "Mobile target cannot be combined with another platform"
constant Alone = "fast builds for this computer only, without a platform or other options"
constant Model = " uses NeuralNetworks and runs on the GPU, build it without fast"
constant Summing = List(Text) + "Examples/Sum.strict"
constant Learning = ("Examples/Sum.strict", "NeuralNetworks/Batch.strict")
constant Logged = ("", "Error: InvalidTestRequest", "Error: UnsupportedBuildOptions")
constant Whole = "fast builds single programs, build a complete game with its Content without fast: "
constant WebOnly = " is a Web app, build it with web"
constant Tested = NativeCompiler
constant Web = "MossWeb.strict"
RunCommand(arguments Texts) Number
	rest = arguments.Slice(1, arguments.Length - 1)
	if IsLocked(rest(0)) is false
		return 1
	started = Process.Elapsed
	cache = NativeCache(arguments(0), rest)
	result = IsCurrent(cache) then 0 else BuildProfile.Compile(cache)
	code = result is Error("InvalidTestRequest") then 2 else result is Error then 1 else result
	reported = Report(code, started, result is Error then result to Text else "")
	IsUnlocked(rest(0)) then reported else 1
IsCurrent(cache NativeCache) Boolean
	isCurrent = BuildProfile.IsCurrent(cache)
	if isCurrent
		logger.Log(cache.Message)
	isCurrent
Report(code Number, started Number, problem Text) Number
	NativeCompiler.Report(1, Process.Elapsed, "Error: Failed\n\tat Compiler/NativeCompiler.strict:line 9") is 1
	NativeCompiler.Report(2, Process.Elapsed, "Error: InvalidTestRequest") is 2
	if (problem is "" then "" else problem.Lines.First) is not in Logged
		logger.Log(problem)
	BuildProfile.Report(code is 0 then "Build total" else "Build FAILED (" + code + "), total", started)
	code
IsLocked(target Text) Boolean slow
	lock = File(Lock(target))
	if lock.IsLocked
		return true
	logger.Log("Waiting for the other build of " + target)
	started = Process.Elapsed
	for as long as Process.Elapsed - started < Strict.BuildWait
		Process.Wait(0.1)
		if lock.IsLocked
			return true
	logger.Log("The other build of " + target + " did not finish within " + Strict.BuildWait + " seconds")
	false
IsUnlocked(target Text) Boolean
	NativeCompiler.IsLocked("Compiler/output/Again.strict")
	NativeCompiler.IsUnlocked("Compiler/output/Again.strict")
	NativeCompiler.IsLocked("Compiler/output/Again.strict")
	NativeCompiler.IsUnlocked("Compiler/output/Again.strict")
	File(Lock(target)).Delete
	File(Lock(target)).Exists is false
Lock(target Text) Text
	NativeCompiler.Lock("Examples/Sum.strict") is "./Examples/obj/Sum.strict.lock"
	path = BuildOutput.Intermediate(target) + ".lock"
	Directory.Create(Path(path).PathOnly.text)
	path
Compile(command Text, rest Texts, sources Texts = List(Text)) Number
	if command is "build"
		return Check(rest, sources)
	request = TestRequest(rest)
	if request.Message is not ""
		logger.Log(request.Message)
		return Error("InvalidTestRequest")
	isCounting = request.Option is "lines"
	isRecursive = "--no-recursive" is not in request.Options
	selection = request.Selection is "" then "" else TestCodegen.Everything + request.Selection.Replace("*", "")
	NativeBuild(false, selection = selection, isRecursive = isRecursive).TestPath(rest(0), rest(1), isCounting, sources)
Check(rest Texts, sources Texts) Number
	gate = Execute.Serve(rest(0), rest(1), true, sources)
	if gate.code is 0
		Build(rest, sources, gate.Types)
	gate.code
Build(rest Texts, sources Texts, gated List(TypeEntry))
	options = Options(rest)
	if rest.Length > 2 and rest(2) is "library"
		return LibraryBuild.Build(rest(0), rest(1))
	problem = Problem(rest(0), options, sources)
	if problem is not ""
		logger.Log(problem)
		return Error("UnsupportedBuildOptions")
	NativeBuild(Configure(options, rest(0)), gated = gated).Compile(rest(0), rest(1), sources = sources)
Problem(path Text, options Texts, sources Texts) Text
	NativeCompiler.Problem("Examples/Sum.strict", List(Text) + "fast", Summing) is ""
	NativeCompiler.Problem("Examples/Sum.strict", ("android", "ios"), Summing) is Mixed
	NativeCompiler.Problem("Examples/Sum.strict", ("fast", "linux"), Summing) is Alone
	NativeCompiler.Problem("Examples/Sum.strict", List(Text) + "fast", Learning) is "Examples/Sum.strict" + Model
	NativeCompiler.Problem("Examples/Sum.strict", List(Text), Learning) is ""
	Tested.Problem(Web, List(Text), Summing) is Web + WebOnly and Tested.Problem(Web, List(Text) + "web", Summing) is ""
	if Path(path).FileName.text.IndexOf("Web") >= 0 and "web" is not in options
		return path + WebOnly
	isFast = "fast" is in options
	if IsMixed(options) or isFast and options.Length > 1
		return isFast then Alone else Mixed
	isFast and IsGame(path) then Whole + path else isFast and IsLearning(sources) then path + Model else ""
IsGame(path Text) Boolean
	NativeCompiler.IsGame("Missing/App/App.strict") is false
	Release("Compiler/output/Game/obj/Demo").Creat("Compiler/output/Game/Content") is not Error
	NativeCompiler.IsGame("Compiler/output/Game/Game.strict")
	NativeCompiler.IsGame("Compiler/output/Game/Demo.strict") is false
	folder = Path(path).PathOnly.text
	content = Directory.Exists(folder + "/Content") or File(folder + "/ContentBuild.strict").Exists
	Path(path).FileName.text is Path(folder).FileName.text + ".strict" and content
IsLearning(sources Texts) Boolean
	NativeCompiler.IsLearning(Learning)
	NativeCompiler.IsLearning(Summing) is false
	for sources
		if ("/" + value).IndexOf("/NeuralNetworks/") >= 0
			return true
	false
IsMixed(options Texts) Boolean
	NativeCompiler.IsMixed(("android", "ios"))
	NativeCompiler.IsMixed(("ios", "web"))
	NativeCompiler.IsMixed(("ios", "simulator")) is false
	isMobile = "android" is in options or "ios" is in options
	isDesktop = "web" is in options or "linux" is in options or "windows" is in options
	"android" is in options and "ios" is in options or isMobile and isDesktop
Configure(options Texts, path = "") NativeBuild
	NativeCompiler.Configure(("ios", "simulator")).Target is Platform.IOSSimulator
	NativeCompiler.Configure(("linux", "web")).isCrossing is false
	NativeCompiler.Configure(List(Text) + "windows").isReleased
	NativeCompiler.Configure(List(Text) + "fast").isFast
	NativeCompiler.Configure(("web", "edit")).isEdited
	NativeCompiler.Configure(List(Text), "./Strict.strict").isReleased
	isWeb = "web" is in options
	isCrossing = "linux" is in options and isWeb is false
	configured = NativeBuild(isCrossing, isWeb, "android" is in options, "ios" is in options)
	isFast = "fast" is in options
	isReleased = "windows" is in options or Path(path).FileName.text is "Strict.strict"
	isEdited = "edit" is in options
	isSimulator = "simulator" is in options
	NativeBuild(configured, isSimulator = isSimulator, isReleased = isReleased, isFast = isFast, isEdited = isEdited)
Options(rest Texts) Texts
	NativeCompiler.Options(("a.strict", ".", "linux")) is ("linux")
	rest.Length > 2 then rest.Slice(2, rest.Length - 2) else List(Text)
Executable(root Text) Text
	NativeCompiler.Executable(".") is "./strict" + Toolchain(Platform.Current, ".").Extension
	root + "/strict" + Toolchain(Platform.Current, root).Extension
Arguments(command Text, rest Texts) Text
	NativeCompiler.Arguments("build", ("a b.strict", ".")) is "build \"a b.strict\" \".\""
	mutable text = command
	for rest
		text = text + " \"" + value + "\""
	text