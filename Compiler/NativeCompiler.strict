has logger
constant Swapped = PtxCache("Compiler/output/Swapped")
constant Mixed = "Mobile target cannot be combined with another platform"
constant Alone = "fast builds for this computer only, without a platform or other options"
constant Model = " uses NeuralNetworks and runs on the GPU, build it without fast"
constant Summing = List(Text) + "Examples/Sum.strict"
constant Learning = ("Examples/Sum.strict", "NeuralNetworks/Batch.strict")
constant Logged = ("", "Error: InvalidTestRequest", "Error: UnsupportedBuildOptions")
constant Whole = "fast builds single programs, build a complete game with its Content without fast: "
Ran(arguments Texts) Number
	let rest = arguments.Slice(1, arguments.Length - 1)
	if Locked(rest(0)) is false
		return 1
	let started = Process.Elapsed
	let cache = NativeCache(arguments(0), rest)
	let result = Current(cache) then 0 else BuildProfile(logger).Compiled(cache)
	let code = result is Error("InvalidTestRequest") then 2 else result is Error then 1 else result
	let reported = Reported(code, started, result is Error then result to Text else "")
	Unlocked(rest(0)) then reported else 1
Current(cache NativeCache) Boolean
	let isCurrent = BuildProfile(logger).Current(cache)
	if isCurrent
		logger.Log(cache.Message)
	isCurrent
Reported(code Number, started Number, problem Text) Number
	NativeCompiler(Logger).Reported(1, Process.Elapsed, "Error: Failed\n\tat Compiler/NativeCompiler.strict:line 9") is 1
	NativeCompiler(Logger).Reported(2, Process.Elapsed, "Error: InvalidTestRequest") is 2
	if (problem is "" then "" else problem.Lines.First) is not in Logged
		logger.Log(problem)
	BuildProfile(logger).Reported(code is 0 then "Build total" else "Build FAILED (" + code + "), total", started)
	code
Locked(target Text) Slow(Boolean)
	let lock = File(Lock(target))
	if lock.Locked
		return true
	logger.Log("Waiting for the other build of " + target)
	let started = Process.Elapsed
	for as long as Process.Elapsed - started < Strict.BuildWait
		Process.Wait(0.1)
		if lock.Locked
			return true
	logger.Log("The other build of " + target + " did not finish within " + Strict.BuildWait + " seconds")
	false
Unlocked(target Text) Boolean
	NativeCompiler(Logger).Locked("Compiler/output/Again.strict")
	NativeCompiler(Logger).Unlocked("Compiler/output/Again.strict")
	NativeCompiler(Logger).Locked("Compiler/output/Again.strict")
	NativeCompiler(Logger).Unlocked("Compiler/output/Again.strict")
	File(Lock(target)).Delete
	File(Lock(target)).Exists is false
Lock(target Text) Text
	NativeCompiler.Lock("Examples/Sum.strict") is "./Examples/obj/Sum.strict.lock"
	let path = BuildOutput.Intermediate(target) + ".lock"
	Directory.Create(Path(path).PathOnly.text)
	path
Compiled(command Text, rest Texts, sources Texts = List(Text)) Number
	if command is "build"
		return Checked(rest, sources)
	let request = TestRequest(rest)
	if request.Message is not ""
		logger.Log(request.Message)
		return Error("InvalidTestRequest")
	let isCounting = request.Option is "lines"
	let isRecursive = "--no-recursive" is not in request.Options
	let build = NativeBuild(logger, false, selection = request.Selection, isRecursive = isRecursive)
	build.Tested(rest(0), rest(1), isCounting, sources)
Checked(rest Texts, sources Texts) Number
	let gate = Execute(logger).Served(rest(0), rest(1), true, sources)
	if gate.code is 0
		Built(rest, sources, gate.Types)
	gate.code
Built(rest Texts, sources Texts, gated List(TypeEntry))
	let options = Options(rest)
	if (rest.Length > 2) and (rest(2) is "library")
		return LibraryBuild(logger).Built(rest(0), rest(1))
	let problem = Problem(rest(0), options, sources)
	if problem is not ""
		logger.Log(problem)
		return Error("UnsupportedBuildOptions")
	NativeBuild(Configured(options), gated = gated).Compile(rest(0), rest(1), sources = sources)
Problem(path Text, options Texts, sources Texts) Text
	NativeCompiler(Logger).Problem("Examples/Sum.strict", List(Text) + "fast", Summing) is ""
	NativeCompiler(Logger).Problem("Examples/Sum.strict", ("android", "ios"), Summing) is Mixed
	NativeCompiler(Logger).Problem("Examples/Sum.strict", ("fast", "linux"), Summing) is Alone
	NativeCompiler(Logger).Problem("Examples/Sum.strict", List(Text) + "fast", Learning) is "Examples/Sum.strict" + Model
	NativeCompiler(Logger).Problem("Examples/Sum.strict", List(Text), Learning) is ""
	let isFast = "fast" is in options
	if IsMixed(options) or (isFast and (options.Length > 1))
		return isFast then Alone else Mixed
	isFast and IsGame(path) then Whole + path else isFast and IsLearning(sources) then path + Model else ""
IsGame(path Text) Boolean
	NativeCompiler.IsGame("Missing/App/App.strict") is false
	Release(Logger, "Compiler/output/Game/obj/Demo").Created("Compiler/output/Game/Content") is not Error
	NativeCompiler.IsGame("Compiler/output/Game/Game.strict")
	NativeCompiler.IsGame("Compiler/output/Game/Demo.strict") is false
	let folder = Path(path).PathOnly.text
	let content = Directory.Exists(folder + "/Content") or File(folder + "/ContentBuild.strict").Exists
	(Path(path).FileName.text is Path(folder).FileName.text + ".strict") and content
IsLearning(sources Texts) Boolean
	NativeCompiler.IsLearning(Learning)
	NativeCompiler.IsLearning(Summing) is false
	for sources
		if ("/" + value).IndexOf("/NeuralNetworks/") >= 0
			return true
	false
IsMixed(options Texts) Boolean
	NativeCompiler.IsMixed(("android", "ios"))
	NativeCompiler.IsMixed(("ios", "web"))
	NativeCompiler.IsMixed(("ios", "simulator")) is false
	let isMobile = ("android" is in options) or ("ios" is in options)
	let isDesktop = ("web" is in options) or ("linux" is in options) or ("windows" is in options)
	(("android" is in options) and ("ios" is in options)) or (isMobile and isDesktop)
Configured(options Texts) NativeBuild
	NativeCompiler(Logger).Configured(("ios", "simulator")).Target is Platform.IOSSimulator
	NativeCompiler(Logger).Configured(("linux", "web")).isCrossing is false
	NativeCompiler(Logger).Configured(List(Text) + "windows").isReleased
	NativeCompiler(Logger).Configured(List(Text) + "fast").isFast
	let isWeb = "web" is in options
	let isCrossing = ("linux" is in options) and (isWeb is false)
	let configured = NativeBuild(logger, isCrossing, isWeb, "android" is in options, "ios" is in options)
	let isFast = "fast" is in options
	NativeBuild(configured, isSimulator = "simulator" is in options, isReleased = "windows" is in options, isFast = isFast)
Options(rest Texts) Texts
	NativeCompiler.Options(("a.strict", ".", "linux")) is ("linux")
	rest.Length > 2 then rest.Slice(2, rest.Length - 2) else List(Text)
Executable(root Text) Text
	NativeCompiler.Executable(".") is "./strict" + Toolchain(Platform.Current, ".").Extension
	root + "/strict" + Toolchain(Platform.Current, root).Extension
Arguments(command Text, rest Texts) Text
	NativeCompiler.Arguments("build", ("a b.strict", ".")) is "build \"a b.strict\" \".\""
	mutable text = command
	for rest
		text = text + " \"" + value + "\""
	text