has logger
has selection Text = ""
has isRecursive Boolean = true
constant Counting = TypeEntry("Strict/A", List(MemberEntry), List(MethodEntry) + MethodEntry.CountingLoop)
constant Initializing = TypeEntry("Strict/A", List(MemberEntry), List(MethodEntry) + MethodEntry.Initializing)
constant Hellos = ("Examples/HelloLogger.strict", "Examples/HelloLogger.strict")
constant Other = TypeEntry("Strict/B", List(MemberEntry), List(MethodEntry))
Module(path Text, root Text, isCounting Boolean, isProgram Boolean, platform = -1, sources Texts = List(Text)) Slow(MlirModule)
	NativeFolder(Logger).Module("Examples/HelloLogger.strict", ".", false, true).entryName is "Run"
	NativeFolder(Logger).Module("Examples/NativeAdd", ".", false, false).types.First.Name.EndsWith("Adder")
	let started = Process.Elapsed
	let paths = Paths(path)
	let execute = Execute(logger, selection)
	let isCollected = isCounting or Directory.Exists(path)
	let types = isCollected then Collected(path, root) else execute.Loaded(path, root, isProgram is false, sources)
	let counted = isCounting then CountedFiles(paths, root) else List(Text)
	let symbol = platform is Platform.IOS then "strict_main" else "main"
	let inlined = BuildProfile(logger).Inlined(types)
	BuildProfile(logger).Reported("Frontend", started)
	MlirModule(inlined, isProgram then "Run" else TestCodegen.Runner, counted, paths.Length, symbol)
Natives(path Text, root Text, types List(TypeEntry)) Slow(Texts)
	NativeFolder(Logger).Natives("Examples", ".", List(TypeEntry) + Foreign.Adder) is ("Examples/NativeAdd/native")
	let paths = Paths(path)
	mutable folders = List(Mutable(Text))
	for paths
		for NativeBuild(logger).Natives(value, root, types)
			if value is not in folders
				folders.Add(value)
	folders
IsNative(type TypeEntry, types List(TypeEntry)) Boolean
	NativeFolder.IsNative(Foreign.Adder, List(TypeEntry) + Foreign.Adder)
	NativeFolder.IsNative(Foreign.Shorter, List(TypeEntry) + Foreign.Shorter) is false
	for type.methods
		if MlirForeign(MlirFunction(types, type, value)).IsForeign
			return true
	false
CountedFiles(paths Texts, root Text) Texts
	NativeFolder(Logger).CountedFiles(List(Text) + "./Examples/Sum.strict", ".") is ("Examples/Sum.strict")
	for paths
		TypeEntry(FileCompiler.FullName(value, root), List(MemberEntry), List(MethodEntry)).Source
Paths(path Text) Texts
	NativeFolder.Paths("Examples/Sum.strict") is ("Examples/Sum.strict")
	Directory.Exists(path) then Files(path) else List(Text) + path
Files(folder Text) Texts
	NativeFolder.Files("Math").Length > 5
	NativeFolder(Logger, isRecursive = false).Files(".") is Directory.Files(".", "*.strict")
	mutable files = List(Mutable(Text))
	for isRecursive then ResolveCheck.Tree(folder) else List(Text) + folder
		files = files + Directory.Files(value, "*.strict")
	files
Collected(path Text, root Text) List(TypeEntry)
	NativeFolder(Logger).Collected("Examples/NativeAdd/native", ".").Length is 0
	let folders = Directory.Exists(path) and isRecursive then ResolveCheck.Tree(path) else List(Text) + path
	mutable mains = List(Mutable(TypeEntry))
	mutable used = List(Mutable(TypeEntry))
	for folders
		let paths = Directory.Exists(value) then Directory.Files(value, "*.strict") else List(Text) + value
		let counted = paths.Length is 0 then List(TypeEntry) else Counted(paths, root)
		if counted.Length < paths.Length
			return List(TypeEntry)
		mains = mains + Leading(counted, paths.Length)
		used = used + counted
	Merged(mains, used)
Leading(types List(TypeEntry), count Number) List(TypeEntry)
	NativeFolder.Leading((Counting, Other), 1) is List(TypeEntry) + Counting
	for Range(0, count)
		types(value)
Counted(paths Texts, root Text) Slow(List(TypeEntry))
	NativeFolder(Logger).Counted(Hellos, ".")(1).Name is "HelloLogger"
	let files = SourceFiles(root).Of(FileCompiler.Normalized(paths.First), paths)
	let rounds = Rounds(paths, root, files, ResolveCheck.Inference(files))
	if rounds.Length < paths.Length
		return List(TypeEntry)
	mutable mains = List(Mutable(TypeEntry))
	mutable used = List(Mutable(TypeEntry))
	for rounds
		mains.Add(value.entries.First)
		used = used + value.entries
	Merged(mains, used)
Rounds(paths Texts, root Text, files Texts, inference TypeInference) List(LinkRound)
	NativeFolder(Logger).Rounds(List(Text) + "Missing.strict", ".", List(Text), ResolveCheck.Counting).Length is 0
	mutable rounds = List(Mutable(LinkRound))
	mutable known = Dictionary(Text, TypeEntry)
	for paths
		let linked = Typed(value, root, files, inference, known)
		if linked.entries.Length is 0
			return rounds
		rounds.Add(linked)
		known = linked.Known(known)
	rounds
Typed(path Text, root Text, files Texts, inference TypeInference, known Dictionary(Text, TypeEntry)) LinkRound
	constant none = Dictionary(Text, TypeEntry)
	NativeFolder(Logger).Typed("Missing.strict", ".", List(Text), ResolveCheck.Counting, none).entries.Length is 0
	if File(path).Exists is false
		return FileCompiler.Unlinked
	let isFresh = (selection is "") and (Execute(logger).Stale(List(Text) + path).Length is 0)
	if isFresh
		return FileCompiler.Unlinked.With(Execute(logger).Loaded(path, root))
	let linked = FileCompiler(logger, false, selection).Built(path, root, true, files, inference, known)
	if linked.entries.Length is 0
		logger.Log("CompilationFailed: " + path)
	linked
Merged(known List(TypeEntry), added List(TypeEntry)) List(TypeEntry)
	NativeFolder.Merged(List(TypeEntry) + Counting, (Initializing, Counting)).First.methods.Length is 2
	NativeFolder.Merged(List(TypeEntry) + Counting, List(TypeEntry) + Other).Length is 2
	mutable merged = List(TypeEntry) + known
	mutable names = Names(known)
	for added
		let at = names.Index(value.Name)
		if at < 0
			merged = merged + value
			names = names + value.Name
		else
			merged(at) = Joined(merged(at), value)
	merged
Names(types List(TypeEntry)) Texts
	NativeFolder.Names((Counting, Other)) is ("Strict/A", "Strict/B")
	for types
		value.Name
Joined(type TypeEntry, other TypeEntry) TypeEntry
	NativeFolder.Joined(Counting, Counting).methods.Length is 1
	let known = Signatures(type.methods)
	let added = Signatures(other.methods)
	mutable methods = type.methods
	for other.methods
		if added(index) is not in known
			methods = methods + value
	TypeEntry(type.Name, type.members, methods)
Signatures(methods List(MethodEntry)) Texts
	NativeFolder.Signatures(Counting.methods) is ("Run(None)")
	for methods
		value.Name + "(" + Text.Combine(value.SignatureTypes) + ")"