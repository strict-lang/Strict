has selection Text = ""
has isRecursive Boolean = true
has gated List(TypeEntry) = List(TypeEntry)
constant Counting = TypeEntry("Strict/A", List(MemberEntry), List(MethodEntry) + MethodEntry.CountingLoop)
constant Initializing = TypeEntry("Strict/A", List(MemberEntry), List(MethodEntry) + MethodEntry.Initializing)
constant Hellos = ("Examples/HelloLogger.strict", "Examples/HelloLogger.strict")
constant Runless = List(TypeEntry) + TypeEntry("Strict/A", List(MemberEntry), List(MethodEntry))
constant Other = TypeEntry("Strict/B", List(MemberEntry), List(MethodEntry))
constant Greeting = List(TypeEntry) + TypeEntry.HelloLogger
Module(path Text, root Text, isCounting Boolean, isProgram Boolean, platform = -1, sources Texts = List(Text)) MlirModule slow
	NativeFolder.Module("Examples/HelloLogger.strict", ".", false, true).entryName is "Run"
	NativeFolder.Module("Examples/NativeAdd", ".", false, false).types.First.Name.EndsWith("Adder")
	started = Process.Elapsed
	paths = Paths(path)
	loaded = isCounting or Directory.Exists(path) then Collect(path, root) else TestFolder(path, root, sources)
	types = isProgram then Program(loaded, path, root, sources) else loaded
	counted = isCounting then CountedFiles(paths, root) else List(Text)
	symbol = platform is Platform.IOS then "strict_main" else "main"
	inlined = BuildProfile.Inline(MissingNatives(types, path, root).Stubbed)
	Phases.Report("Frontend", started)
	MlirModule(inlined, isProgram then "Run" else TestCodegen.Runner, counted, paths.Length, symbol, platform)
TestFolder(path Text, root Text, sources Texts) List(TypeEntry)
	NativeFolder(gated = Greeting).TestFolder("Missing.strict", ".", List(Text)) is Greeting
	gated.Length > 0 then gated else Execute(selection).Load(path, root, true, sources)
Natives(path Text, root Text, types List(TypeEntry)) Texts slow
	NativeFolder.Natives("Examples", ".", List(TypeEntry) + Foreign.Adder) is ("Examples/NativeAdd/native")
	paths = Paths(path)
	mutable folders = List(Mutable(Text))
	for folder, native in paths, NativeBuild.Natives(folder, root, types)
		if native is not in folders
			folders.Add(native)
	folders
IsNative(type TypeEntry, types List(TypeEntry)) Boolean
	NativeFolder.IsNative(Foreign.Adder, List(TypeEntry) + Foreign.Adder)
	NativeFolder.IsNative(Foreign.Shorter, List(TypeEntry) + Foreign.Shorter) is false
	for type.methods
		if MlirForeign(MlirFunction(types, type, value)).IsForeign
			return true
	false
CountedFiles(paths Texts, root Text) Texts
	NativeFolder.CountedFiles(List(Text) + "./Examples/Sum.strict", ".") is ("Examples/Sum.strict")
	for paths
		TypeEntry(FileCompiler.FullName(value, root), List(MemberEntry), List(MethodEntry)).Source
Program(loaded List(TypeEntry), path Text, root Text, sources Texts) List(TypeEntry)
	NativeFolder.Program(List(TypeEntry) + TypeEntry.HelloLogger, "Missing.strict", ".", List(Text)).Length is 1
	Execute.HasRun(NativeFolder.Program(Runless, "Examples/HelloLogger.strict", ".", List(Text)).First)
	isOld = loaded.Length > 0 then Execute.HasRun(loaded.First) is false else false
	isOld then Execute(selection).Load(path, root, false, sources) else loaded
Paths(path Text) Texts
	NativeFolder.Paths("Examples/Sum.strict") is ("Examples/Sum.strict")
	Directory.Exists(path) then Files(path) else List(Text) + path
Files(folder Text) Texts
	NativeFolder.Files("Math").Length > 5
	NativeFolder(isRecursive = false).Files(".") is Directory.Files(".", "*.strict")
	SourceFiles.Plain.Folder(folder, isRecursive)
Collect(path Text, root Text) List(TypeEntry)
	NativeFolder.Collect("Examples/NativeAdd/native", ".").Length is 0
	folders = Directory.Exists(path) and isRecursive then ResolveCheck.Tree(path) else List(Text) + path
	chunks = NativeChunks.Of(folders, File(NativeCompiler.Executable(root)).Exists)
	counted = NativeChunks(selection).Compile(chunks, root, NativeBuild.Output(path, false))
	mutable mains = List(Mutable(TypeEntry))
	mutable used = List(Mutable(TypeEntry))
	for counted
		if value.Length < chunks(index).Length
			return List(TypeEntry)
		mains = mains + Leading(value, chunks(index).Length)
		used = used + value
	Merge(mains, used)
Qualify(types List(TypeEntry), path Text, root Text) List(TypeEntry)
	NativeFolder.Qualify(Greeting, Hellos.First, ".").First.Name is "Strict/Examples/HelloLogger"
	NativeFolder.Qualify(List(TypeEntry) + Counting, Hellos.First, ".").First.Name is "Strict/A"
	package = Path(FileCompiler.FullName(FileCompiler.Normalize(path), root)).PathOnly.text
	for types
		value.Name.IndexOf("/") < 0 then TypeEntry(value, Name = package + "/" + value.Name) else value
Leading(types List(TypeEntry), count Number) List(TypeEntry)
	NativeFolder.Leading((Counting, Other), 1) is List(TypeEntry) + Counting
	for Range(0, count)
		types(value)
CollectAll(paths Texts, root Text) List(TypeEntry) slow
	NativeFolder.CollectAll(Hellos, ".")(1).Name is "Strict/Examples/HelloLogger"
	files = SourceFiles(root).Of(FileCompiler.Normalize(paths.First), paths)
	rounds = Rounds(paths, root, files, ResolveCheck.Inference(files))
	if rounds.Length < paths.Length
		return List(TypeEntry)
	mutable mains = List(Mutable(TypeEntry))
	mutable used = List(Mutable(TypeEntry))
	for rounds
		mains.Add(value.entries.First)
		used = used + value.entries
	Qualify(Merge(mains, used), paths.First, root)
Rounds(paths Texts, root Text, files Texts, inference TypeInference) List(LinkRound)
	NativeFolder.Rounds(List(Text) + "Missing.strict", ".", List(Text), ResolveCheck.Counting).Length is 0
	mutable rounds = List(Mutable(LinkRound))
	mutable known = Dictionary(Text, TypeEntry)
	for paths
		linked = LinkTypes(value, root, files, inference, known)
		if linked.entries.Length is 0
			return rounds
		rounds.Add(linked)
		known = linked.Known(known)
	rounds
LinkTypes(path Text, root Text, files Texts, inference TypeInference, known Dictionary(Text, TypeEntry)) LinkRound
	constant none = Dictionary(Text, TypeEntry)
	NativeFolder.LinkTypes("Missing.strict", ".", List(Text), ResolveCheck.Counting, none).entries.Length is 0
	if File(path).Exists is false
		return FileCompiler.Unlinked
	if selection is "" and Execute.Stale(List(Text) + path).Length is 0
		return FileCompiler.Unlinked.With(Execute.Load(path, root))
	linked = FileCompiler(false, selection).Build(path, root, true, files, inference, known)
	if linked.entries.Length is 0
		logger.Log("CompilationFailed: " + path)
	linked
Merge(known List(TypeEntry), added List(TypeEntry)) List(TypeEntry)
	NativeFolder.Merge(List(TypeEntry) + Counting, (Initializing, Counting)).First.methods.Length is 2
	NativeFolder.Merge(List(TypeEntry) + Counting, List(TypeEntry) + Other).Length is 2
	mutable merged = List(TypeEntry) + known
	mutable names = Names(known)
	for added
		at = names.Index(value.Name)
		if at < 0
			merged = merged + value
			names = names + value.Name
		else
			merged(at) = Join(merged(at), value)
	merged
Names(types List(TypeEntry)) Texts
	NativeFolder.Names((Counting, Other)) is ("Strict/A", "Strict/B")
	for types
		value.Name
Join(type TypeEntry, other TypeEntry) TypeEntry
	NativeFolder.Join(Counting, Counting).methods.Length is 1
	known = Signatures(type.methods)
	added = Signatures(other.methods)
	mutable methods = type.methods
	for other.methods
		if added(index) is not in known
			methods = methods + value
	TypeEntry(type.Name, type.members, methods)
Signatures(methods List(MethodEntry)) Texts
	NativeFolder.Signatures(Counting.methods) is ("Run(None)")
	for methods
		value.Name + "(" + Text.Combine(value.SignatureTypes) + ")"