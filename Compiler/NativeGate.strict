has logger
has build NativeBuild
Built(path Text, root Text) Number
	let isProgram = NativeBuild.IsProgram(path)
	let isStale = Execute(logger).Stale(List(Text) + path).Length > 0
	if build.isWeb or (isStale is false) or isProgram and (File(TestExecutable(path, root)).Exists is false)
		return Measured(path, root)
	let gated = Gated(path, root, isProgram)
	(gated > 0) or (isProgram is false) then gated else build.Compile(path, root)
Measured(path Text, root Text) Number
	let started = Process.Elapsed
	let failed = Execute(logger).Test(path, root)
	let tested = Process.Elapsed
	let built = failed > 0 then failed else build.Compile(path, root)
	let compiled = Process.Elapsed
	if (built > 0) or build.isWeb or (tested - started < 2 * (compiled - tested))
		return built
	let took = " took " + (tested - started).Round(1) + " s on the Strict VM, its build " + (compiled - tested).Round(1)
	logger.Log("The tests of " + path + took + " s: later builds run its native tests instead")
	let natively = NativeTests(path, root)
	natively > 0 then natively else built
Gated(path Text, root Text, isProgram Boolean) Number
	let failed = NativeTests(path, root)
	if failed >= 0
		return failed
	let checked = Execute(logger).Test(path, root)
	(checked > 0) or isProgram then checked else 1
NativeTests(path Text, root Text) Number
	let executable = TestExecutable(path, root)
	File(executable).Delete
	let failed = build.Compile(path, root, false, true)
	if File(executable).Exists and (ToolRunner.IsCrash(failed) is false)
		return failed
	let problem = File(executable).Exists then " crashed (exit code " + failed + ")" else " did not build"
	logger.Log("The native tests of " + path + problem + ", the Strict VM runs them")
	File(executable).Delete
	-1
TestExecutable(path Text, root Text) Text
	NativeGate(Logger, NativeBuild(Logger)).TestExecutable("Character.strict", ".").StartsWith("./Character.test")
	Toolchain(Platform.Current, root).Executable(NativeBuild.Output(path, false))