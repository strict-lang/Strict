has sources NativeSources
constant Adding = NativeLibrary(NativeSources.Adding)
constant Failing = "clang failed for Compiler/output/Cut.o: no"
constant NoObject = "clang failed for Compiler/output/No.o"
constant RandomSuffixRange = 999999
Built(platform Number, root Text) Text
	Adding.Built(Platform.Current, ".").StartsWith("Built Examples/NativeAdd/native/NativeAdd.")
	let folder = sources.folders.First
	let base = folder + "/" + Path(Path(folder).PathOnly.text).FileName.text
	let library = base + Platform.LibraryExtension(platform)
	let shared = platform is Platform.Windows then "-shared -O2 -DSTRICT_LIBRARY" else "-shared -fPIC -O2 -DSTRICT_LIBRARY"
	let previous = Waited(library, sources.Files + sources.Inputs(platform, root), shared)
	if previous is not ""
		return previous
	let output = base + "." + RandomSuffixRange.Random.Floor + Platform.LibraryExtension(platform)
	let clang = Toolchain(platform, root).Located("clang")
	let result = ToolRunner(clang).Execute(shared + sources.Arguments(platform, root) + " -o \"" + output + "\"")
	Finished(result, output, library, shared)
Objects(files Texts, platform Number, root Text, options Text) Slow(Texts)
	Adding.Objects(NativeSources.Adding.Files, Platform.Current, ".", "") is ("Examples/NativeAdd/native/Adder.o")
	mutable missing = List(Mutable(Text))
	mutable previous = List(Mutable(Text))
	for files
		let waited = Waited(Path(value).RemoveExtension.text + ".o", sources.Inputs(platform, root) + value, options)
		previous.Add(waited)
		if waited is ""
			missing.Add(value)
	let compiled = Compiled(missing, platform, root, options)
	for previous
		let built = value is "" then compiled(missing.Index(files(index))) else value
		built.StartsWith("Built ") then built.Substring(6, built.Length - 6) else built
Compiled(files Texts, platform Number, root Text, options Text) Slow(Texts)
	Adding.Compiled(List(Text) + "Compiler/output/No.c", Platform.Current, ".", "").First.StartsWith(NoObject)
	if files.Length is 0
		return List(Text)
	let suffix = "." + RandomSuffixRange.Random.Floor + ".o"
	let flags = " -I\"" + root + "/Compiler\"" + Toolchain.Optimized + options
	for ToolRunner(Toolchain(platform, root).Located("clang")).ExecuteAll(Commands(files, suffix, flags))
		let base = Path(files(index)).RemoveExtension.text
		Finished(value, base + suffix, base + ".o", options)
Commands(files Texts, suffix Text, flags Text) Texts
	Adding.Commands(List(Text) + "a/b.c", ".1.o", " -O2") is ("-c \"a/b.c\" -O2 -o \"a/b.1.o\"")
	for files
		"-c \"" + value + "\"" + flags + " -o \"" + Path(value).RemoveExtension.text + suffix + "\""
Waited(target Text, inputs Texts, options Text) Slow(Text)
	Adding.Waited("Compiler/output/Missing.dll", List(Text), "") is ""
	let started = Process.Elapsed
	for as long as Process.Elapsed - started < Strict.BuildWait
		if sources.IsCompiled(target, inputs, options)
			return "Built " + target
		let recorded = Text.Combine(File(target + ".built.nativecache").ReadLines, "\n")
		if recorded.StartsWith("clang failed") and sources.IsCurrent(target + ".built.nativecache", inputs)
			return Located(target, recorded)
		if File(target + ".lock").Locked
			return ""
		Process.Wait(0.1)
	""
Finished(result ProcessResult, output Text, target Text, options Text) Text
	File("Compiler/output/Cut.o.lock").Locked
	Adding.Finished(ProcessResult(1, "", "no"), "Compiler/output/Cut.1.o", "Compiler/output/Cut.o", "") is Failing
	File("Compiler/output/Cut.o.lock").Exists is false
	let failure = "clang failed for " + target + ": " + result.error
	let built = result.Failed then failure else "Built " + sources.Placed(output, target)
	File(target + ".built.nativecache").Write(built)
	File(target + ".lock").Delete
	if built is "Built " + target
		File(target + ".nativecache").Write(options)
	built
Located(target Text, recorded Text) Text
	Adding.Located("a/b.dll", "Built c/b.1.dll") is "Built a/b.1.dll"
	Adding.Located("b.dll", "Built c/b.dll") is "Built b.dll"
	Adding.Located("a/b.dll", "clang failed") is "clang failed"
	if recorded.StartsWith("Built ") is false
		return recorded
	let folder = Path(target).PathOnly.text
	"Built " + (folder is "" then "" else folder + "/") + Path(recorded.Substring(6, recorded.Length - 6)).FileName.text
