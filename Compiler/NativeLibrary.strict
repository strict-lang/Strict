has sources NativeSources
constant Adding = NativeLibrary(NativeSources.Adding)
constant Failing = "clang failed for Compiler/output/Cut.o: no"
constant NoObject = "clang failed for Compiler/output/No" + Platform.ObjectExtension(Platform.Current)
constant RandomSuffixRange = 999999
constant AdderObject = "Examples/NativeAdd/native/Adder" + Platform.ObjectExtension(Platform.Current)
Build(platform Number, root Text) Text
	Adding.Build(Platform.Current, ".").StartsWith("Built Examples/NativeAdd/native/NativeAdd.")
	folder = sources.folders.First
	base = folder + "/" + Path(Path(folder).PathOnly.text).FileName.text
	library = base + Platform.LibraryExtension(platform)
	shared = platform is Platform.Windows then "-shared -O2 -DSTRICT_LIBRARY" else "-shared -fPIC -O2 -DSTRICT_LIBRARY"
	previous = Wait(library, sources.Files + sources.Inputs(platform, root), shared)
	if previous is not ""
		return previous
	output = base + "." + RandomSuffixRange.Random.Floor + Platform.LibraryExtension(platform)
	clang = Toolchain(platform, root).Locate("clang")
	result = ToolRunner(clang).Execute(shared + sources.Arguments(platform, root) + " -o \"" + output + "\"")
	Finish(result, output, library, shared)
Objects(files Texts, platform Number, root Text, options Text) Texts slow
	Adding.Objects(NativeSources.Adding.Files, Platform.Current, ".", "") is (AdderObject)
	mutable missing = List(Mutable(Text))
	mutable previous = List(Mutable(Text))
	for files
		waited = Wait(Object(value, platform), sources.Inputs(platform, root) + value, options)
		previous.Add(waited)
		if waited is ""
			missing.Add(value)
	compiled = Compile(missing, platform, root, options)
	for previous
		built = value is "" then compiled(missing.Index(files(index))) else value
		built.StartsWith("Built ") then built.Substring(6) else built
Compile(files Texts, platform Number, root Text, options Text) Texts slow
	Adding.Compile(List(Text) + "Compiler/output/No.c", Platform.Current, ".", "").First.StartsWith(NoObject)
	Adding.Compile(NativeSources.Adding.Files, Platform.Web, ".", "").First.EndsWith("/Adder.web.o")
	File("Examples/NativeAdd/native/Adder.web.o").ReadBytes.Slice(0, 4) is (0, 97, 115, 109)
	if files.Length is 0
		return List(Text)
	suffix = "." + RandomSuffixRange.Random.Floor + ".o"
	isWeb = platform is Platform.Web
	flags = " -I\"" + root + "/Compiler\"" + (isWeb then WebBuild.Compiled else Toolchain.Optimized) + options
	tools = Toolchain(isWeb then Platform.Current else platform, root, isWeb = isWeb)
	for ToolRunner(tools.Locate(isWeb then "emcc" else "clang")).ExecuteAll(Commands(files, suffix, flags))
		Finish(value, Path(files(index)).RemoveExtension.text + suffix, Object(files(index), platform), options)
Object(file Text, platform Number) Text
	Adding.Object("a/b.c", Platform.Linux) is "a/b.linux.o"
	Path(file).RemoveExtension.text + Platform.ObjectExtension(platform)
Commands(files Texts, suffix Text, flags Text) Texts
	Adding.Commands(List(Text) + "a/b.c", ".1.o", " -O2") is ("-c \"a/b.c\" -O2 -o \"a/b.1.o\"")
	for files
		"-c \"" + value + "\"" + flags + " -o \"" + Path(value).RemoveExtension.text + suffix + "\""
Wait(target Text, inputs Texts, options Text) Text slow
	Adding.Wait("Compiler/output/Missing.dll", List(Text), "") is ""
	started = Process.Elapsed
	for as long as Process.Elapsed - started < Strict.BuildWait
		if sources.IsCompiled(target, inputs, options)
			return "Built " + target
		recorded = Text.Combine(File(target + ".built.nativecache").ReadLines, "\n")
		if recorded.StartsWith("clang failed") and sources.IsCurrent(target + ".built.nativecache", inputs)
			return Locate(target, recorded)
		if File(target + ".lock").IsLocked
			return ""
		Process.Wait(0.1)
	""
Finish(result ProcessResult, output Text, target Text, options Text) Text
	File("Compiler/output/Cut.o.lock").IsLocked
	Adding.Finish(ProcessResult(1, "", "no"), "Compiler/output/Cut.1.o", "Compiler/output/Cut.o", "") is Failing
	File("Compiler/output/Cut.o.lock").Exists is false
	failure = "clang failed for " + target + ": " + result.error
	built = result.HasFailed then failure else "Built " + sources.Place(output, target)
	File(target + ".built.nativecache").Write(built)
	File(target + ".lock").Delete
	if built is "Built " + target
		File(target + ".nativecache").Write(options)
	built
Locate(target Text, recorded Text) Text
	Adding.Locate("a/b.dll", "Built c/b.1.dll") is "Built a/b.1.dll"
	Adding.Locate("b.dll", "Built c/b.dll") is "Built b.dll"
	Adding.Locate("a/b.dll", "clang failed") is "clang failed"
	if recorded.StartsWith("Built ") is false
		return recorded
	folder = Path(target).PathOnly.text
	"Built " + (folder is "" then "" else folder + "/") + Path(recorded.Substring(6, recorded.Length - 6)).FileName.text
