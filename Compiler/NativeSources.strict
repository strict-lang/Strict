has folders Texts
constant Adding = NativeSources(List(Text) + "Examples/NativeAdd/native")
constant Iconed = "Examples/NativeAdd/NativeAdd"
constant Resourced = " \"Examples/NativeAdd/NativeAdd.res\""
constant Summed = " \"Examples/Sum.res\""
Files Texts
	Adding.Files is List(Text) + "Examples/NativeAdd/native/Adder.c"
	mutable files = List(Mutable(Text))
	for folders
		files = files + Directory.Files(value, "*.c")
	files
Flags(platform Number, root Text) Text
	Adding.Flags(Platform.Windows, ".") is ""
	mutable flags = ""
	for folders
		let file = value + "/" + Platform.NameOf(platform) + ".flags"
		if File(file).Exists
			flags = flags + Rooted(Text.Combine(File(file).ReadLines, " "), value, root)
	flags
Rooted(flags Text, folder Text, root Text) Text
	Adding.Rooted("-DX a/b.c a/d.m -Ia/c", "../E/F/native", ".") is " -DX ../E/a/b.c ../E/a/d.m -I../E/a/c"
	Adding.Rooted("-DX a/b.c", "Frameworks/native", ".") is " -DX a/b.c"
	Adding.Rooted("-DX a/b.c -Ia/c", "C:/s/E/native", "C:/s") is " -DX C:/s/a/b.c -IC:/s/a/c"
	let inside = folder.StartsWith(root + "/") then root + "/" else ""
	let project = folder.StartsWith("../") then "../" + folder.Split("/")(1) + "/" else inside
	mutable rooted = ""
	for flags.Split(" ")
		let isInclude = value.StartsWith("-I")
		let path = isInclude then "-I" + project + value.Substring(2, value.Length - 2) else project + value
		rooted = rooted + " " + (isInclude or IsSource(value) then path else value)
	rooted
Arguments(platform Number, root Text) Text
	Adding.Arguments(Platform.Windows, "C:/s") is " \"Examples/NativeAdd/native/Adder.c\" -I\"C:/s/Compiler\""
	NativeSources(List(Text)).Arguments(Platform.Windows, "C:/s") is ""
	if folders.Length is 0
		return ""
	mutable arguments = ""
	for Files
		arguments = arguments + " \"" + value + "\""
	arguments + " -I\"" + root + "/Compiler\"" + Flags(platform, root)
Objects(platform Number, root Text) Text
	Adding.Objects(Platform.Current, ".").StartsWith(" \"Examples/NativeAdd/native/Adder.o\"")
	NativeSources(List(Text)).Objects(Platform.Current, ".") is ""
	if folders.Length is 0
		return ""
	let tokens = Flags(platform, root).Split(" ")
	mutable arguments = ""
	for Files + Sources(tokens)
		let object = Object(value, platform, root, Options(tokens, false))
		if object.StartsWith("clang failed")
			return object
		arguments = arguments + " \"" + object + "\""
	arguments + Options(tokens, true)
Sources(tokens Texts) Texts
	Adding.Sources(("-DX", "a/b.c", "-lgdi32")) is ("a/b.c")
	Adding.Sources(("a/b.m", "-Wl,-framework,Cocoa")) is ("a/b.m")
	for tokens
		if IsSource(value)
			value
IsSource(token Text) Boolean
	Adding.IsSource("a/b.m")
	Adding.IsSource("-lm") is false
	token.EndsWith(".c") or token.EndsWith(".m")
Options(tokens Texts, isLinking Boolean) Text
	Adding.Options(("-DX", "a/b.c", "-lgdi32", "-Wl,/OPT:REF"), true) is " -lgdi32 -Wl,/OPT:REF"
	Adding.Options(("-DX", "a/b.c", "-lgdi32"), false) is " -DX"
	Adding.Options(("-DX", "a/b.m"), false) is " -DX"
	mutable options = ""
	for tokens
		let isLinked = value.StartsWith("-l") or value.StartsWith("-Wl")
		if (value is not "") and (IsSource(value) is false) and (isLinked is isLinking)
			options = options + " " + value
	options
Object(source Text, platform Number, root Text, options Text) Text
	Adding.Object("Examples/NativeAdd/native/Adder.c", Platform.Current, ".", "") is "Examples/NativeAdd/native/Adder.o"
	let target = Path(source).RemoveExtension.text + ".o"
	if IsCompiled(target, Inputs(platform, root) + source, options)
		return target
	let building = Path(source).RemoveExtension.text + "." + 999999.Random.Floor + ".o"
	let compile = "-c \"" + source + "\" -I\"" + root + "/Compiler\"" + options + Toolchain.Optimized
	let compiled = ToolRunner(Toolchain(platform, root).Located("clang")).Execute(compile + " -o \"" + building + "\"")
	if compiled.Failed
		return "clang failed for " + source + ": " + compiled.error
	let placed = Placed(building, target)
	File(placed + ".nativecache").Write(options)
	placed
IsCompiled(target Text, inputs Texts, options Text) Boolean
	let flags = File(target + ".nativecache")
	flags.Exists and (Text.Combine(flags.ReadLines, "\n") is options) and IsCurrent(target, inputs)
Inputs(platform Number, root Text) Texts
	Adding.Inputs(Platform.Windows, ".").Last is "Examples/NativeAdd/native/Windows.flags"
	let flags = folders.First + "/" + Platform.NameOf(platform) + ".flags"
	Directory.Files(folders.First, "*.h") + (root + "/Compiler/strict.h") + flags
Placed(building Text, library Text) Text
	Adding.Placed("Examples/NativeAdd/native/Missing.1.dll", Iconed + ".dll") is Iconed + ".dll"
	File(building).Rename(library)
	let unique = Path(building).RemoveExtension.text
	for (".lib", ".exp")
		if File(unique + value).Exists
			File(unique + value).Delete
	File(building).Exists then building else library
IsCurrent(target Text, inputs Texts) Boolean
	Adding.IsCurrent("Examples/NativeAdd/native/Missing.dll", List(Text)) is false
	if File(target).Exists is false
		return false
	let built = File(target).Modified
	for inputs
		if File(value).Exists and (File(value).Modified > built)
			return false
	true
Resource(base Text, platform Number, root Text) Text
	Adding.Resource("Examples/Sum", Platform.Current, ".") is (Platform.Current is Platform.Windows then Summed else "")
	Adding.Resource(Iconed, Platform.Linux, ".") is ""
	Adding.Resource(Iconed, Platform.Current, ".") is (Platform.Current is Platform.Windows then Resourced else "")
	let icon = Release(Logger, base).Icon
	if (platform is not Platform.Windows) or (File(icon).Exists is false)
		return ""
	let full = icon.IndexOf(":") > 0 then icon else Directory.Current.Replace("\\", "/") + "/" + icon
	File(base + ".rc").Write("GLFW_ICON ICON \"" + full + "\"")
	let compiler = Toolchain(platform, root).Located("llvm-rc")
	let compiled = ToolRunner(compiler).Execute("/FO \"" + base + ".res\" \"" + base + ".rc\"")
	File(base + ".rc").Delete
	compiled.Failed then "llvm-rc failed: " + compiled.error else " \"" + base + ".res\""
LinuxLinked(base Text, program Text, root Text) Text
	Adding.LinuxLinked("Compiler/output/missing", "missing", ".").StartsWith("Linux build skipped")
	let tools = Toolchain(Platform.Windows, root)
	mutable sources = folders.Length is 0 then "" else " -I" + tools.Quoted(tools.WslPath(root + "/Compiler"))
	for Files
		sources = sources + " " + tools.Quoted(tools.WslPath(value))
	let gcc = folders.Length is 0 then "-e gcc -static " else "-e gcc "
	let linkage = gcc + tools.Quoted(tools.WslPath(base + ".linux.o"))
	let output = " -o " + tools.Quoted(tools.WslPath(program)) + " -lm -lpthread" + Flags(Platform.Linux, root)
	let linked = ToolRunner("wsl").Execute(linkage + sources + output)
	linked.Failed then "Linux build skipped (needs WSL with gcc): " + linked.error else "Built " + program + " for Linux"