has folders Texts
constant Adding = NativeSources(List(Text) + "Examples/NativeAdd/native")
constant Paralleled = NativeSources(("Examples/NativeAdd/native", "NeuralNetworks/native"))
constant Fresh = "Compiler/output/Fresh.1.exe"
constant Iconed = "Examples/NativeAdd/NativeAdd"
constant Resourced = " \"Examples/NativeAdd/NativeAdd.res\""
constant Icon = Release(Iconed).Icon
constant Summed = " \"Examples/Sum.res\""
Files Texts
	Adding.Files is List(Text) + "Examples/NativeAdd/native/Adder.c"
	mutable files = List(Mutable(Text))
	for folders
		files = files + Directory.Files(value, "*.c")
	files
Flags(platform Number, root Text) Text
	Adding.Flags(Platform.Windows, ".") is ""
	mutable flags = ""
	for folders
		file = value + "/" + Platform.NameOf(platform) + ".flags"
		if File(file).Exists
			flags = flags + Root(Text.Combine(File(file).ReadLines, " "), value, root)
	flags
Root(flags Text, folder Text, root Text) Text
	Adding.Root("-DX a/b.c a/d.m -Ia/c", "../E/F/native", ".") is " -DX ../E/a/b.c ../E/a/d.m -I../E/a/c"
	Adding.Root("-DX a/b.c", "Frameworks/native", ".") is " -DX a/b.c"
	Adding.Root("-DX a/b.c -Ia/c", "C:/s/E/native", "C:/s") is " -DX C:/s/a/b.c -IC:/s/a/c"
	Adding.Root("-DX a/b.c", "C:/sx/E/native", "C:/s") is " -DX a/b.c"
	inside = folder.StartsWith(root + "/") then root + "/" else ""
	project = folder.StartsWith("../") then "../" + folder.Split("/")(1) + "/" else inside
	mutable rooted = ""
	for flags.Split(" ")
		isInclude = value.StartsWith("-I")
		path = isInclude then "-I" + project + value.Substring(2) else project + value
		rooted = rooted + " " + (isInclude or IsSource(value) then path else value)
	rooted
Arguments(platform Number, root Text) Text
	Adding.Arguments(Platform.Windows, "C:/s") is " \"Examples/NativeAdd/native/Adder.c\" -I\"C:/s/Compiler\""
	NativeSources(List(Text)).Arguments(Platform.Windows, "C:/s") is ""
	if folders.Length is 0
		return ""
	mutable arguments = ""
	for Files
		arguments = arguments + " \"" + value + "\""
	arguments + " -I\"" + root + "/Compiler\"" + Flags(platform, root)
Objects(platform Number, root Text, cpu = "native") Text
	Adding.Objects(Platform.Current, ".").StartsWith(" \"" + NativeLibrary.AdderObject + "\"")
	NativeSources(List(Text)).Objects(Platform.Current, ".") is ""
	if folders.Length is 0
		return ""
	tokens = Flags(platform, root).Split(" ")
	options = Options(tokens, false) + (cpu is "native" then "" else " -march=" + cpu)
	mutable arguments = ""
	for NativeLibrary(value).Objects(Files + Sources(tokens), platform, root, options)
		if value.StartsWith("clang failed")
			return value
		arguments = arguments + " \"" + value + "\""
	arguments + Options(tokens, true)
Sources(tokens Texts) Texts
	Adding.Sources(("-DX", "a/b.c", "-lgdi32")) is ("a/b.c")
	Adding.Sources(("a/b.m", "-Wl,-framework,Cocoa")) is ("a/b.m")
	for tokens
		if IsSource(value)
			value
IsSource(token Text) Boolean
	Adding.IsSource("a/b.m")
	Adding.IsSource("-lm") is false
	token.EndsWith(".c") or token.EndsWith(".m")
Options(tokens Texts, isLinking Boolean) Text
	Adding.Options(("-DX", "a/b.c", "-lgdi32", "-Wl,/OPT:REF"), true) is " -lgdi32 -Wl,/OPT:REF"
	Adding.Options(("-DX", "a/b.c", "-lgdi32"), false) is " -DX"
	Adding.Options(("-DX", "a/b.m"), false) is " -DX"
	Adding.Options(("", "-DX"), false) is " -DX"
	Adding.Options(("--use-port=contrib.glfw3", "-sX", "-DX"), true) is " --use-port=contrib.glfw3 -sX"
	mutable options = ""
	for tokens
		isLinked = value.StartsWith("-l") or value.StartsWith("-Wl")
		isBoth = value.StartsWith("-s") or value.StartsWith("--use-port")
		if value is not "" and IsSource(value) is false and (isLinked is isLinking or isBoth)
			options = options + " " + value
	options
IsCompiled(target Text, inputs Texts, options Text) Boolean
	flags = File(target + ".nativecache")
	flags.Exists and Text.Combine(flags.ReadLines, "\n") is options and IsCurrent(target, inputs)
Inputs(platform Number, root Text) Texts
	Adding.Inputs(Platform.Windows, ".").Last is "Examples/NativeAdd/native/Windows.flags"
	"NeuralNetworks/native/Parallel.h" is in Paralleled.Inputs(Platform.Windows, ".")
	mutable inputs = List(Text) + (root + "/Compiler/strict.h")
	for folders
		inputs = inputs + Directory.Files(value, "*.h") + (value + "/" + Platform.NameOf(platform) + ".flags")
	inputs
Place(building Text, library Text) Text
	Adding.Place("Examples/NativeAdd/native/Missing.1.dll", Iconed + ".dll") is Iconed + ".dll"
	Intermediates.IsWindows is false or Process.Find(Process.Variable("ComSpec")).Start(Intermediates.Holding) is 0
	File(Fresh).Write("fresh") is not Error
	Intermediates.IsWindows is false or Adding.Place(Fresh, Intermediates.Kept) is Intermediates.Kept
	File(building).Rename(library)
	if File(building).Exists and File(library).Exists
		aside = Path(library).RemoveExtension.text + ".old" + NativeLibrary.RandomSuffixRange.Random.Floor
		File(library).Rename(aside + library.Substring(library.LastIndexOf(".")))
		File(building).Rename(library)
	unique = Path(building).RemoveExtension.text
	for (".lib", ".exp")
		if File(unique + value).Exists
			File(unique + value).Delete
	File(building).Exists then building else library
IsCurrent(target Text, inputs Texts) Boolean
	Adding.IsCurrent("Examples/NativeAdd/native/Missing.dll", List(Text)) is false
	if File(target).Exists is false
		return false
	built = File(target).Modified
	for inputs
		if File(value).Exists and File(value).Modified > built
			return false
	true
Resource(base Text, platform Number, root Text) Text
	Adding.Resource("Examples/Sum", Platform.Current, ".") is (Platform.Current is Platform.Windows then Summed else "")
	Adding.Resource(Iconed, Platform.Linux, ".") is ""
	Adding.Resource(Iconed, Platform.Current, ".") is (Platform.Current is Platform.Windows then Resourced else "")
	icon = Release(base).Icon
	if platform is not Platform.Windows or File(icon).Exists is false
		return ""
	kept = Reuse(base + ".res", icon)
	kept is "" then Compile(base, icon, platform, root) else kept
Compile(base Text, icon Text, platform Number, root Text) Text
	Adding.Compile(Iconed, Icon, Platform.Windows, ".") is Resourced or Platform.Current is not Platform.Windows
	full = icon.IndexOf(":") > 0 then icon else Directory.Current.Replace("\\", "/") + "/" + icon
	File(base + ".rc").Write("GLFW_ICON ICON \"" + full + "\"")
	compiler = Toolchain(platform, root).Locate("llvm-rc")
	compiled = ToolRunner(compiler).Execute("/FO \"" + base + ".res\" \"" + base + ".rc\"")
	File(base + ".rc").Delete
	compiled.HasFailed then "llvm-rc failed: " + compiled.error else " \"" + base + ".res\""
Reuse(resource Text, icon Text) Text
	Adding.Reuse("Compiler/Missing.res", "Compiler/NativeSources.strict") is ""
	Adding.Reuse("Compiler/NativeSources.strict", "Compiler/Missing.ico") is " \"Compiler/NativeSources.strict\""
	IsCurrent(resource, List(Text) + icon) then " \"" + resource + "\"" else ""
LinuxLink(base Text, program Text, root Text) Text
	Adding.LinuxLink("Compiler/output/missing", "missing", ".").StartsWith("Linux build failed")
	tools = Toolchain(Platform.Windows, root)
	mutable sources = folders.Length is 0 then "" else " -I" + tools.Quote(LinuxBuild.WslPath(root + "/Compiler"))
	for Files
		sources = sources + " " + tools.Quote(LinuxBuild.WslPath(value))
	gcc = folders.Length is 0 then "-e gcc -static " else "-e gcc -no-pie "
	linkage = gcc + tools.Quote(LinuxBuild.WslPath(base + ".linux.o"))
	libraries = " -Wl,--gc-sections -lm -lpthread" + Wsl(Flags(Platform.Linux, root), tools)
	output = " -o " + tools.Quote(LinuxBuild.WslPath(program)) + libraries
	Release(base).Creat(Path(program).PathOnly.text)
	linked = ToolRunner("wsl").Execute(linkage + sources + output, "Linking for Linux in WSL")
	linked.HasFailed then "Linux build failed (needs WSL with gcc): " + linked.error else "Built " + program + " for Linux"
Wsl(flags Text, tools Toolchain) Text
	Adding.Wsl(" -DX -IC:/s/a C:/s/b.c -lm", Toolchain.OnWindows) is " -DX -I\"/mnt/c/s/a\" \"/mnt/c/s/b.c\" -lm"
	mutable converted = ""
	for flags.Split(" ")
		isInclude = value.StartsWith("-I")
		path = isInclude then value.Substring(2) else value
		wsl = (isInclude then "-I" else "") + tools.Quote(LinuxBuild.WslPath(path))
		if value is not ""
			converted = converted + " " + (isInclude or IsSource(value) then wsl else value)
	converted