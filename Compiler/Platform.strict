constant Windows
constant Linux
constant MacOS
constant Web
constant Android
constant IOS
constant IOSSimulator
NameOf(code Number) Text
	NameOf(Windows) is "Windows"
	NameOf(IOSSimulator) is "iOS"
	NameOf(Web) is "Web"
	if code is Windows
		return "Windows"
	if code is Linux
		return "Linux"
	if code is MacOS
		return "MacOS"
	if code is Web
		return "Web"
	code is Android then "Android" else (IsIOS(code) then "iOS" else "Unknown")
Current Number
	Platform.Current is in (Windows, Linux, MacOS)
	FromName(Process.OperatingSystem)
FromName(name Text) Number
	NameOf(FromName("iOS")) is "iOS"
	NameOf(FromName("Android")) is "Android"
	FromName("Linux") is Linux
	FromName("MacOS") is MacOS
	if name is "Windows"
		return Windows
	if name is "Android"
		return Android
	if name is "iOS"
		return IOS
	name is "MacOS" then MacOS else Linux
Architecture Text
	Platform.Architecture is in ("X64", "Arm64")
	Process.RunTool("uname", "-m").Output.Trim is "arm64" then "Arm64" else "X64"
Runtimes(code Number) Texts
	Platform.Runtimes(Linux) is ("Posix", "Linux")
	Platform.Runtimes(IOS).First is "Darwin"
	if code is Linux
		return ("Posix", "Linux")
	if code is Android
		return ("Posix", "Android", "Arm64")
	code is in (MacOS, IOS, IOSSimulator) then Darwin(code) else List(Text) + NameOf(code)
Darwin(code Number) Texts
	Platform.Darwin(MacOS).Last is (Platform.Architecture is "Arm64" then "Directories" else "MacOSX64")
	Platform.Darwin(IOS) is ("Darwin", "IOS", "Arm64", "Directories")
	Platform.Darwin(IOSSimulator) is ("Darwin", "IOS", Platform.Architecture, "Directories")
	let machine = code is IOS then "Arm64" else Architecture
	let directories = (code is MacOS) and (machine is "X64") then "MacOSX64" else "Directories"
	("Darwin", code is MacOS then "MacOS" else "IOS", machine, directories)
Runtime(code Number, root Text) Texts
	Platform.Runtime(Linux, ".").First.StartsWith("  // the heap")
	for Runtimes(code)
		Text.Combine(File(root + "/Compiler/NativeRuntime" + value + ".mlir").ReadLines, "\n")
LibraryExtension(code Number) Text
	Platform.LibraryExtension(Windows) is ".dll"
	Platform.LibraryExtension(Linux) is ".so"
	Platform.LibraryExtension(MacOS) is ".dylib"
	if code is Windows
		return ".dll"
	if IsIOS(code)
		return ".a"
	code is MacOS then ".dylib" else ".so"
IsWindows(code Number) Boolean
	if code is Windows
		return true
	false
IsLinux(code Number) Boolean
	if code is Linux
		return true
	false
IsMacOS(code Number) Boolean
	if code is MacOS
		return true
	false
IsIOS(code Number) Boolean
	IsIOS(IOSSimulator)
	IsIOS(MacOS) is false
	code is in (IOS, IOSSimulator)