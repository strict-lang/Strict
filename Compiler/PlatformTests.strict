has logger
Run
	logger.Log(Platform.NameOf(Platform.Windows))
	logger.Log(Platform.NameOf(Platform.Linux))
	logger.Log(Platform.NameOf(Platform.MacOS))
	logger.Log(Platform.IsWindows(Platform.Windows))
	logger.Log(NasmFormat(Platform.Linux).Format)
	logger.Log(NasmFormat(Platform.MacOS).Format)
	logger.Log(ToolInfo.NasmName)
	logger.Log(ToolInfo(Platform.Windows).LinkerName)