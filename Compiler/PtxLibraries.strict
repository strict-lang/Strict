has folder Text
has prefix Text
constant Marker = "// strict definitions"
constant Sample = PtxLibraries("Compiler/output/Libraries", "ptx/")
constant Both = (PtxFunction.Kernel, PtxFunction.Helper)
constant Endings = (".ptx", ".older.ptx")
Of(base Text) PtxLibraries
	PtxLibraries.Of("a/obj/B").folder is "a/obj" and PtxLibraries.Of("a/obj/B").prefix is "ptx/"
	PtxLibraries.Of("a/obj/B.test").prefix is "ptx/test/"
	PtxLibraries(Path(base).PathOnly.text, base.EndsWith(".test") then "ptx/test/" else "ptx/")
Indexed(texts Texts) Texts slow
	Sample.Indexed(List(Text) + "clang failed: x") is List(Text) + "clang failed: x"
	for texts
		value.StartsWith("//") then Index(value, Endings(index)) else value
Index(text Text, ending Text) Text slow
	let module = PtxModule(text.Split("\n"))
	let functions = module.Functions
	let names = Names(functions)
	Directory.Create(folder + "/ptx")
	Directory.Create(folder + "/" + prefix.Substring(0, prefix.Length - 1))
	for names
		Written(value, ending, functions)
	PtxGlobals(folder + "/" + prefix + "Globals" + ending, prefix).Written(module.Globals)
	let needs = " needs " + prefix + "Globals," + Text.Combine(Stems(names), "")
	"// strict program " + HashCode(text).number + needs + "\n" + module.Header
Names(functions List(PtxFunction)) Texts
	Sample.Names(Both) is ("H3Block", "Strict")
	Libraries(functions).Unique
Libraries(functions List(PtxFunction)) Texts
	Sample.Libraries(Both) is ("H3Block", "Strict")
	for functions
		value.Library
Stems(names Texts) Texts
	Sample.Stems(("A", "B")) is ("ptx/A,", "ptx/B,")
	for names
		prefix + value + ","
Written(library Text, ending Text, functions List(PtxFunction)) slow
	let path = folder + "/" + prefix + library + ending
	let fresh = Of(functions, library)
	let old = File(path).Exists then PtxModule(File(path).ReadLines).Functions else List(PtxFunction)
	let composed = Composed(library, fresh + Other(old, Titles(fresh)))
	if File(path).Exists is false or Text.Combine(File(path).ReadLines, "\n") is not composed
		File(path).Write(composed)
Of(functions List(PtxFunction), library Text) List(PtxFunction)
	Sample.Of(Both, "Strict").Length is 1 and Sample.Of(Both, "Missing").Length is 0
	for functions
		if value.Library is library
			value
Titles(functions List(PtxFunction)) Texts
	Sample.Titles(Both).Last is "strict_device_byte_read"
	for functions
		value.name
Other(old List(PtxFunction), names Texts) List(PtxFunction)
	Sample.Other(Both, List(Text) + "strict_device_byte_read").First.name is "H3Block_Gated_5_gpu7s"
	Sample.Other(Both, Sample.Titles(Both)).Length is 0
	for old
		if value.name is not in names
			value
Composed(library Text, functions List(PtxFunction)) Text
	Sample.Composed("A", Both.Slice(0, 1)).StartsWith("// strict library ptx/A needs ptx/Attention,ptx/Strict,\n" + Marker)
	Sample.Composed("B", Both.Slice(1, 1)).StartsWith("// strict library ptx/B needs \n.func ")
	let head = "// strict library " + prefix + library + " needs " + Text.Combine(Stems(Needed(functions).Unique), "")
	head + "\n" + Text.Combine(Prototypes(functions), "") + Marker + "\n" + Text.Combine(Bodies(functions), "")
Needed(functions List(PtxFunction)) Texts
	Sample.Needed(Both) is ("Attention", "Strict")
	mutable needs = List(Text)
	for functions
		needs = needs + value.Needs
	needs
Prototypes(functions List(PtxFunction)) Texts
	Sample.Prototypes(Both).First is "" and Sample.Prototypes(Both).Length is 2
	for functions
		value.Prototype
Bodies(functions List(PtxFunction)) Texts
	Sample.Bodies(Both).Length is 2
	for functions
		value.Body
Placed(base Text, ending Text, release Text) slow
	let sidecar = base + ending
	if File(sidecar).Exists and File(sidecar).Length > 0
		File(BuildOutput.Shipped(release, sidecar)).Write(File(sidecar).ReadBytes)
		if ending is in Endings
			Copied(Reached(sidecar, ending), ending, release)
	if ending is ".ptx"
		File(release + "/" + Path(base).FileName.text + ".fatbin").Delete
Copied(stems Texts, ending Text, release Text) slow
	Directory.Create(release + "/ptx")
	for stems
		let source = File(folder + "/" + value + ending)
		let target = File(release + "/" + value + ending)
		if target.Exists is false or target.ReadBytes is not source.ReadBytes
			target.Write(source.ReadBytes)
Reached(program Text, ending Text) Texts slow
	mutable stems = Needs(program)
	mutable at = 0
	for as long as at < stems.Length
		stems = (stems + Needs(folder + "/" + stems(at) + ending)).Unique
		at = at + 1
	stems
Needs(path Text) Texts slow
	Sample.Needs("Compiler/output/missing.ptx").Length is 0
	let first = File(path).Exists then File(path).ReadLines.First else ""
	let at = first.IndexOf(" needs ")
	for (at < 0 then "" else first.Substring(at + 7, first.Length - at - 7)).Split(",")
		if value is not ""
			value