has functions List(PtxFunction)
constant Both = PtxMerge((PtxFunction.Kernel, PtxFunction.Helper))
constant Helper = List(PtxFunction) + PtxFunction.Helper
In(library Text) List(PtxFunction)
	Both.In("Strict").Length is 1 and Both.In("Missing").Length is 0
	for functions
		if value.Library is library
			value
Titles Texts
	Both.Titles.Last is "strict_device_byte_read"
	for functions
		value.name
Other(names Texts) List(PtxFunction)
	Both.Other(List(Text) + "strict_device_byte_read").First.name is "H3Block_Gated_5_gpu7s"
	Both.Other(Both.Titles).Length is 0
	for functions
		if value.name is not in names
			value
Merged(fresh List(PtxFunction)) List(PtxFunction)
	Both.Merged(Helper).Length is 2 and Both.Merged(Helper).First.name is "H3Block_Gated_5_gpu7s"
	PtxMerge(Helper).Merged(Both.functions).Last.name is "H3Block_Gated_5_gpu7s"
	Latest(fresh) + PtxMerge(fresh).Other(Titles)
Latest(fresh List(PtxFunction)) List(PtxFunction)
	Both.Latest(List(PtxFunction)).Length is 2
	names = PtxMerge(fresh).Titles
	for functions
		value.name is in names then fresh(names.Index(value.name)) else value