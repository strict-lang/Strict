has logger
has base Text
constant Opening = "= func.call @" + "Window_Open("
AndroidPackaged Number
	let release = Parent + "/Release/Android"
	if Content(Parent + "/Release/Content") < 0
		return 1
	Directory.Create(Parent + "/Release")
	Directory.Create(release)
	Directory.Create(release + "/jniLibs")
	Directory.Create(release + "/jniLibs/arm64-v8a")
	let library = AndroidBuild(Toolchain(Platform.Current, TypeSource.Root)).Executable(base)
	File(release + "/jniLibs/arm64-v8a/libmain.so").Write(File(library).ReadBytes)
	Directory.Create(release + "/assets")
	logger.Log("Android native library and assets: " + release)
	Mirrored(release + "/assets/Content")
IOSPackaged Number
	if Content(Parent + "/Release/Content") < 0
		return 1
	let release = Parent + "/Release/iOS"
	Refreshed(release, release + "/Content", (".ios.a", ".simulator.a"))
Packaged(program Text, built Number, isWeb = false, isCrossing = false, platform = -1) Number
	Release(Logger, "Examples/Sum").Packaged("module {\n}", 0) is 0
	Release(Logger, "Examples/Sum").Packaged("module {\n}", 2) is 2
	Release(Logger, "Missing/App.test").Packaged(Opening, 0) is 0
	if (platform is in (Platform.Android, Platform.IOS, Platform.IOSSimulator)) and (built is 0)
		return Platform.IsIOS(platform) then IOSPackaged else AndroidPackaged
	let isWindowed = program.IndexOf(Opening) >= 0
	if (built is not 0) or base.EndsWith(".test") or (isWindowed is false)
		return built
	if isWeb
		return IsDemo then built else Refreshed(Parent + "/Release/Web", "", (".html", ".js", ".wasm", ".data"))
	NativePackaged(isCrossing)
NativePackaged(isCrossing Boolean) Number
	if Content(Parent + "/Release/Content") < 0
		return 1
	let ending = Platform.Current is Platform.Windows then ".exe" else ""
	if IsDemo
		return Refreshed(Parent + "/Release", "", List(Text) + ending)
	if Platform.Current is Platform.MacOS
		return MacOSBundle(logger, base).Released
	let folder = Parent + "/Release/" + Platform.NameOf(Platform.Current)
	let result = Refreshed(folder, folder + "/Content", List(Text) + ending)
	let isCrossed = isCrossing and (Platform.Current is Platform.Windows) and File(base).Exists
	let linux = Parent + "/Release/Linux"
	(result is 0) and isCrossed then Refreshed(linux, linux + "/Content", List(Text) + "") else result
IsDemo Boolean
	Release(Logger, TypeSource.Root + "/Examples/NativeAdd/AtlasDemo").IsDemo
	Release(Logger, "Missing/AtlasDemo").IsDemo is false
	Release(Logger, "Games/Samples/AtlasDemo").IsDemo is false
	let game = Parent + "/" + Path(Parent).FileName.text + ".strict"
	base.EndsWith("Demo") and File(game).Exists
Parent Text
	Release(Logger, "Missing/App").Parent is "Missing"
	Release(Logger, "App").Parent is "."
	let parent = Path(base).PathOnly.text
	parent is "" then "." else parent
Icon Text
	Release(Logger, "Examples/NativeAdd/NativeAdd").Icon is "Examples/NativeAdd/NativeAdd.ico"
	Release(Logger, "Examples/NativeAdd/Adder").Icon is "Examples/NativeAdd/NativeAdd.ico"
	Release(Logger, "Missing/App").Icon is TypeSource.Root + "/Strict.ico"
	let own = base + ".ico"
	let folder = Parent + "/" + Path(Parent).FileName.text + ".ico"
	if File(own).Exists
		return own
	File(folder).Exists then folder else TypeSource.Root + "/Strict.ico"
Refreshed(release Text, content Text, endings Texts) Number
	let parent = Path(release).PathOnly.text
	Directory.Create(parent)
	Directory.Create(release)
	for endings
		let built = base + value
		if File(built).Exists
			if Placed(built, release + "/" + Named(built)) is false
				logger.Log("Release could not replace " + release + "/" + Named(built) + ", is it still running?")
				return 1
	logger.Log("Release: " + release)
	Sidecar(release)
	Mirrored(content)
Placed(source Text, target Text) Boolean
	let temporary = target + "." + 1000000000.Random.Floor + ".tmp"
	let bytes = File(source).ReadBytes
	File(temporary).Write(bytes)
	let isComplete = File(temporary).Exists and (File(temporary).ReadBytes.Length is bytes.Length)
	if isComplete
		File(temporary).Rename(target)
	let isPlaced = isComplete and (File(temporary).Exists is false) and File(target).Exists
	File(temporary).Delete
	isPlaced
Sidecar(release Text) Number
	Release(Logger, "Missing/App").Sidecar("Missing/Release") is 0
	mutable copied = 0
	for Sidecars
		let sidecar = base + value
		if File(sidecar).Exists and (File(sidecar).Length > 0)
			File(release + "/" + Named(sidecar)).Write(File(sidecar).ReadBytes)
			copied = copied + 1
	copied
Sidecars Texts
	(".ptx", ".older.ptx", ".runtime.ptx", ".runtime.older.ptx", ".hsaco", ".metal")
Mirrored(target Text) Number
	if target is not ""
		let shared = Parent + "/Release/Content"
		Copied(shared, target)
		Removed(shared, target)
	0
Content(target Text) Number
	Release(Logger, "Missing/App").Content("Missing/Release/Content") is 0
	let source = Parent + "/Content"
	let builder = Parent + "/ContentBuild.strict"
	if File(builder).Exists is false
		return Copied(source, target) + Removed(source, target)
	let arguments = "\"" + builder + "\" \"" + source + "\" \"" + target + "\""
	let strict = Toolchain(Platform.Current, TypeSource.Root).Executable(TypeSource.Root + "/Strict")
	let built = ToolRunner(strict).Execute(arguments)
	if built.Failed
		logger.Log("Content build failed: " + builder + " " + built.error + built.Output)
	built.Failed then -1 else 0
Copied(source Text, target Text) Number
	if Directory.Exists(source) is false
		return 0
	Directory.Create(target)
	mutable copied = 0
	for Directory.Files(source)
		let copy = target + "/" + Named(value)
		if (File(copy).Exists is false) or (File(value).Modified > File(copy).Modified)
			File(copy).Write(File(value).ReadBytes)
			copied = copied + 1
	for Directory.Directories(source)
		copied = copied + Copied(value, target + "/" + Named(value))
	copied
Removed(source Text, target Text) Number
	Release(Logger, "Missing/App").Removed("Missing/Content", "Missing/Release/Content") is 0
	if Directory.Exists(source) is false
		return Directory.Exists(target) and Directory.Delete(target) then 1 else 0
	mutable removed = 0
	for Directory.Files(target)
		if File(source + "/" + Named(value)).Exists is false
			File(value).Delete
			removed = removed + 1
	for Directory.Directories(target)
		removed = removed + Removed(source + "/" + Named(value), value)
	removed
Named(path Text) Text
	Release(Logger, "App").Named("a\b/c.png") is "c.png"
	Path(path.Replace("\\", "/")).FileName.text