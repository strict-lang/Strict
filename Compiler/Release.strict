has logger
has base Text
constant Opening = "= func.call @" + "Window_Open("
constant Sidecars = (".ptx", ".runtime.ptx", ".fatbin", ".runtime.fatbin", ".hsaco", ".metal")
AndroidPackaged
	let release = Parent + "/Release/Android"
	Content(Parent + "/Release/Content")
	Directory.Create(Parent + "/Release")
	Directory.Create(release)
	Directory.Create(release + "/jniLibs")
	Directory.Create(release + "/jniLibs/arm64-v8a")
	let library = AndroidBuild(Toolchain(Platform.Current, TypeSource.Root)).Executable(base)
	File(release + "/jniLibs/arm64-v8a/libmain.so").Write(File(library).ReadBytes)
	Directory.Create(release + "/assets")
	logger.Log("Android native library and assets: " + release)
	Mirrored(release + "/assets/Content")
IOSPackaged
	Content(Parent + "/Release/Content")
	let release = Parent + "/Release/iOS"
	Refreshed(release, release + "/Content", base, (".ios.a", ".simulator.a"))
Packaged(program Text, isWeb = false, isCrossing = false, platform = -1, isReleased = false)
	Release(Logger, "Examples/Sum").Packaged("module {\n}") is not Error
	Release(Logger, "Missing/App.test").Packaged(Opening) is not Error
	Release(Logger, "Compiler/output/Console").Packaged("module {\n}", false, false, -1, true) is not Error
	Directory.Exists("Compiler/output/Release/" + Platform.NameOf(Platform.Current))
	if platform is in (Platform.Android, Platform.IOS, Platform.IOSSimulator)
		return Platform.IsIOS(platform) then IOSPackaged else AndroidPackaged
	if base.EndsWith(".test")
		return
	if isWeb
		return Refreshed(Parent + "/Release/Web", "", base, List(Text))
	if (program.IndexOf(Opening) >= 0) or isReleased or isCrossing
		NativePackaged(isCrossing)
NativePackaged(isCrossing Boolean)
	Content(Parent + "/Release/Content")
	let ending = Platform.Current is Platform.Windows then ".exe" else ""
	if IsDemo
		return Refreshed(Parent + "/Release", "", BuildOutput.Delivered(base), List(Text) + ending)
	if Platform.Current is Platform.MacOS
		return MacOSBundle(logger, base).Released
	let folder = Parent + "/Release/" + Platform.NameOf(Platform.Current)
	Refreshed(folder, folder + "/Content", BuildOutput.Delivered(base), List(Text) + ending)
	let linux = Parent + "/Release/Linux"
	if isCrossing and (Platform.Current is Platform.Windows) and File(linux + "/" + Named(base)).Exists
		Refreshed(linux, linux + "/Content", base, List(Text))
IsDemo Boolean
	Release(Logger, TypeSource.Root + "/Examples/NativeAdd/AtlasDemo").IsDemo
	Release(Logger, "Missing/AtlasDemo").IsDemo is false
	Release(Logger, "Games/Samples/AtlasDemo").IsDemo is false
	let game = Parent + "/" + Path(Parent).FileName.text + ".strict"
	base.EndsWith("Demo") and File(game).Exists
Parent Text
	Release(Logger, "Missing/App").Parent is "Missing"
	Release(Logger, "App").Parent is "."
	Release(Logger, "./Missing/obj/App.test").Parent is "./Missing"
	let parent = Path(base).PathOnly.text
	let source = parent.EndsWith("/obj") then parent.Substring(0, parent.Length - 4) else parent
	(source is "") or (source is "obj") then "." else source
Icon Text
	Release(Logger, "Examples/NativeAdd/NativeAdd").Icon is "Examples/NativeAdd/NativeAdd.ico"
	Release(Logger, "Examples/NativeAdd/Adder").Icon is "Examples/NativeAdd/NativeAdd.ico"
	Release(Logger, "Missing/App").Icon is TypeSource.Root + "/Strict.ico"
	Release(Logger, "Examples/NativeAdd/obj/NativeAdd").Icon is "Examples/NativeAdd/NativeAdd.ico"
	let own = BuildOutput.Delivered(base) + ".ico"
	let folder = Parent + "/" + Path(Parent).FileName.text + ".ico"
	File(own).Exists then own else File(folder).Exists then folder else TypeSource.Root + "/Strict.ico"
Refreshed(release Text, content Text, stem Text, endings Texts)
	Created(release)
	for endings
		let built = stem + value
		if File(built).Exists
			if Placed(built, release + "/" + Named(built)) is false
				logger.Log("Release could not replace " + release + "/" + Named(built) + ", is it still running?")
				return Error("ReleaseNotReplaced")
	logger.Log("Release: " + release)
	Sidecar(release)
	Mirrored(content)
Placed(source Text, target Text) Boolean
	let temporary = target + "." + 1000000000.Random.Floor + ".tmp"
	let bytes = File(source).ReadBytes
	File(temporary).Write(bytes)
	let isComplete = File(temporary).Exists and (File(temporary).ReadBytes.Length is bytes.Length)
	if isComplete
		File(temporary).Rename(target)
	let isPlaced = isComplete and (File(temporary).Exists is false) and File(target).Exists
	File(temporary).Delete
	isPlaced
Sidecar(release Text)
	Release(Logger, "Missing/App").Sidecar("Missing/Release") is not Error
	PtxCache("Compiler/output/Sided").Written(List(Text) + "// a", ".ptx")
	Release(Logger, "Compiler/output/Sided").Sidecar("Compiler/output/Release/Web") is not Error
	let isWeb = Path(release).FileName.text is "Web"
	if isWeb and (Icon is not TypeSource.Root + "/Strict.ico") and (Placed(Icon, release + "/favicon.ico") is false)
		logger.Log("Release could not place " + release + "/favicon.ico")
	for Sidecars
		let sidecar = base + value
		if (isWeb is false) and File(sidecar).Exists and (File(sidecar).Length > 0)
			File(BuildOutput.Shipped(release, sidecar)).Write(File(sidecar).ReadBytes)
Mirrored(target Text)
	if target is not ""
		Synced(Parent + "/Release/Content", target)
Synced(source Text, target Text)
	Copied(source, target)
	Removed(source, target)
Content(target Text)
	Release(Logger, "Missing/App").Content("Missing/Release/Content") is not Error
	let source = Parent + "/Content"
	let builder = Parent + "/ContentBuild.strict"
	if File(builder).Exists is false
		return Synced(source, target)
	let tools = Toolchain(Platform.Current, TypeSource.Root)
	let compiled = ToolRunner(tools.Executable(TypeSource.Root + "/Strict")).Execute("build \"" + builder + "\"")
	let program = ToolRunner(tools.Executable(Parent + "/ContentBuild"))
	let built = compiled.Failed then compiled else program.Execute("\"" + source + "\" \"" + target + "\"")
	if built.Failed
		logger.Log("Content build failed: " + builder + " " + built.error + built.Output)
		return Error("ContentBuildFailed")
Copied(source Text, target Text)
	if Directory.Exists(source)
		Created(target)
		for Directory.Files(source)
			let copy = target + "/" + Named(value)
			if (File(copy).Exists is false) or (File(value).Modified > File(copy).Modified)
				File(copy).Write(File(value).ReadBytes)
		for Directory.Directories(source)
			Copied(value, target + "/" + Named(value))
Created(path Text)
	Release(Logger, "Missing/App").Created("artifacts/Release/Content") is not Error
	Release(Logger, "Missing/App").Created("") is not Error
	if (path is not "") and (Directory.Exists(path) is false)
		Created(Path(path).PathOnly.text)
		Directory.Create(path)
Removed(source Text, target Text)
	Release(Logger, "Missing/App").Removed("Missing/Content", "Missing/Release/Content") is not Error
	if Directory.Exists(source) is false
		if Directory.Exists(target)
			Directory.Delete(target)
		return
	for Directory.Files(target)
		if File(source + "/" + Named(value)).Exists is false
			File(value).Delete
	for Directory.Directories(target)
		Removed(source + "/" + Named(value), value)
Named(path Text) Text
	Release(Logger, "App").Named("a\b/c.png") is "c.png"
	Path(path.Replace("\\", "/")).FileName.text