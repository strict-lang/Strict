has base Text
constant Opening = "= func.call @" + "Window_Open("
constant Sidecars = (".ptx", ".older.ptx", ".runtime.ptx", ".runtime.older.ptx", ".hsaco", ".metal")
AndroidPackage
	release = Parent + "/Release/Android"
	if File(Parent + "/ContentBuild.strict").Exists
		Content(Parent + "/Release/Content")
	Directory.Create(Parent + "/Release")
	Directory.Create(release)
	Directory.Create(release + "/jniLibs")
	Directory.Create(release + "/jniLibs/arm64-v8a")
	library = AndroidBuild(Toolchain(Platform.Current, TypeSource.Root)).Executable(base)
	File(release + "/jniLibs/arm64-v8a/libmain.so").Write(File(library).ReadBytes)
	Directory.Create(release + "/assets")
	logger.Log("Android native library and assets: " + release)
	Mirror(release + "/assets/Content")
MobilePackage(platform Number)
	if platform is Platform.Android
		return AndroidPackage
	if File(Parent + "/ContentBuild.strict").Exists
		Content(Parent + "/Release/Content")
	release = Parent + "/Release/iOS"
	Refresh(release, release + "/Content", base, (".ios.a", ".simulator.a"))
Package(program Text, isWeb = false, isCrossing = false, platform = -1, isReleased = false)
	Release("Examples/Sum").Package("module {\n}") is not Error
	Release("Missing/App.test").Package(Opening) is not Error
	Release("Compiler/output/Console").Package("module {\n}", false, false, -1, true) is not Error
	Directory.Exists("Compiler/output/Release/" + Platform.NameOf(Platform.Current))
	if platform is in (Platform.Android, Platform.IOS, Platform.IOSSimulator)
		return MobilePackage(platform)
	if base.EndsWith(".test")
		return
	if isWeb
		return Refresh(Parent + "/Release/Web", Parent + "/Release/Web/Content", base, List(Text))
	if program.IndexOf(Opening) >= 0 or isReleased or isCrossing or File(Parent + "/" + Label(base) + ".shell.html").Exists
		NativePackage(isCrossing)
NativePackage(isCrossing Boolean)
	if File(Parent + "/ContentBuild.strict").Exists
		Content(Parent + "/Release/Content")
	ending = Platform.Current is Platform.Windows then ".exe" else ""
	if IsDemo
		return Refresh(Parent + "/Release", "", BuildOutput.Deliver(base), (ending, ".shell.html"))
	if Platform.Current is Platform.MacOS
		return MacOSBundle(base).Ship
	folder = Parent + "/Release/" + Platform.NameOf(Platform.Current)
	Refresh(folder, folder + "/Content", BuildOutput.Deliver(base), (ending, ".shell.html"))
	linux = Parent + "/Release/Linux"
	if isCrossing and Platform.Current is Platform.Windows and File(linux + "/" + Label(base)).Exists
		Refresh(linux, linux + "/Content", base, List(Text))
IsDemo Boolean
	File("Compiler/output/A.shell.html").Write("<html/>") is not Error
	Release(TypeSource.Root + "/Examples/NativeAdd/AtlasDemo").IsDemo
	Release("Missing/AtlasDemo").IsDemo is false
	Release("Games/Samples/AtlasDemo").IsDemo is false
	game = Parent + "/" + Path(Parent).FileName.text + ".strict"
	base.EndsWith("Demo") and File(game).Exists
Parent Text
	Release("Missing/App").Parent is "Missing"
	Release("App").Parent is "."
	Release("./Missing/obj/App.test").Parent is "./Missing"
	parent = Path(base).PathOnly.text
	source = parent.EndsWith("/obj") then parent.Substring(0, parent.Length - 4) else parent
	source is "" or source is "obj" then "." else source
Icon Text
	Release("Examples/NativeAdd/NativeAdd").Icon is "Examples/NativeAdd/NativeAdd.ico"
	Release("Examples/NativeAdd/Adder").Icon is "Examples/NativeAdd/NativeAdd.ico"
	Release("Missing/App").Icon is TypeSource.Root + "/Strict.ico"
	Release("Examples/NativeAdd/obj/NativeAdd").Icon is "Examples/NativeAdd/NativeAdd.ico"
	own = BuildOutput.Deliver(base) + ".ico"
	folder = Parent + "/" + Path(Parent).FileName.text + ".ico"
	File(own).Exists then own else File(folder).Exists then folder else TypeSource.Root + "/Strict.ico"
Refresh(release Text, content Text, stem Text, endings Texts)
	Creat(release)
	for endings
		built = stem + value
		if File(built).Exists
			if IsPlaced(built, release + "/" + Label(built)) is false
				logger.Log("Release could not replace " + release + "/" + Label(built) + ", is it still running?")
				return Error("ReleaseNotReplaced")
	logger.Log("Release: " + release)
	Sidecar(release)
	Mirror(content)
IsPlaced(source Text, target Text) Boolean
	temporary = target + "." + 1000000000.Random.Floor + ".tmp"
	bytes = File(source).ReadBytes
	File(temporary).Write(bytes)
	isComplete = File(temporary).Exists and File(temporary).ReadBytes.Length is bytes.Length
	if isComplete
		File(temporary).Rename(target)
	isPlaced = isComplete and File(temporary).Exists is false and File(target).Exists
	File(temporary).Delete
	isPlaced
Sidecar(release Text)
	Release("Missing/App").Sidecar("Missing/Release") is not Error
	PtxCache("Compiler/output/Sided").HasWritten(List(Text) + "// a", ".ptx")
	Release("Compiler/output/Sided").Sidecar("Compiler/output/Release/Web") is not Error
	Release("Compiler/output/obj/A").Package("module {\n}") is not Error
	File("Compiler/output/Release/" + Platform.NameOf(Platform.Current) + "/A.shell.html").Exists
	isWeb = Path(release).FileName.text is "Web"
	if isWeb and Icon is not TypeSource.Root + "/Strict.ico" and IsPlaced(Icon, release + "/favicon.ico") is false
		logger.Log("Release could not place " + release + "/favicon.ico")
	for Sidecars
		if isWeb is false
			PtxLibraries.Of(base).Place(base, value, release)
Mirror(target Text)
	Release("Compiler/output/A").Mirror("Compiler/output/Release/Web/Content") is not Error
	if target is ""
		return
	if File(Parent + "/ContentBuild.strict").Exists is false
		return Synce(Parent + "/Content", target)
	if target.EndsWith("/Web/Content")
		Content(Parent + "/Release/Content")
	Synce(Parent + "/Release/Content", target)
Synce(source Text, target Text)
	Copy(source, target)
	Remove(source, target)
Content(target Text)
	Release("Missing/App").Content("Missing/Release/Content") is not Error
	source = Parent + "/Content"
	builder = Parent + "/ContentBuild.strict"
	if File(builder).Exists is false
		return Synce(source, target)
	built = BuiltContent(builder, source, target)
	if built.HasFailed
		logger.Log("Content build failed: " + builder + " " + built.error + built.Output)
		return Error("ContentBuildFailed")
BuiltContent(builder Text, source Text, target Text) ProcessResult
	tools = Toolchain(Platform.Current, TypeSource.Root)
	exe = tools.Executable(TypeSource.Root + "/Strict")
	isCurrent = NativeCache("build", (builder, TypeSource.Root)).IsCurrent
	compiled = isCurrent then ProcessResult(0, "", "") else ToolRunner(exe).Execute("build \"" + builder + "\"")
	if compiled.HasFailed
		return compiled
	ToolRunner(tools.Executable(Parent + "/ContentBuild")).Execute("\"" + source + "\" \"" + target + "\"")
Copy(source Text, target Text)
	if Directory.Exists(source)
		Creat(target)
		for Directory.Files(source)
			copy = target + "/" + Label(value)
			if File(copy).Exists is false or File(value).Modified > File(copy).Modified
				File(copy).Write(File(value).ReadBytes)
		for Directory.Directories(source)
			Copy(value, target + "/" + Label(value))
Creat(path Text)
	Release("Missing/App").Creat("artifacts/Release/Content") is not Error
	Release("Missing/App").Creat("") is not Error
	if path is not "" and Directory.Exists(path) is false
		Creat(Path(path).PathOnly.text)
		Directory.Create(path)
Remove(source Text, target Text)
	Release("Missing/App").Remove("Missing/Content", "Missing/Release/Content") is not Error
	if Directory.Exists(source) is false
		if Directory.Exists(target)
			Directory.Delete(target)
		return
	for Directory.Files(target)
		if File(source + "/" + Label(value)).Exists is false
			File(value).Delete
	for Directory.Directories(target)
		Remove(source + "/" + Label(value), value)
Label(path Text) Text
	Release("App").Label("a\b/c.png") is "c.png"
	Path(path.Replace("\\", "/")).FileName.text