has logger
has executable Text
constant Own = "$me = (Get-CimInstance Win32_Process -Filter ProcessId=$PID).ParentProcessId; "
constant Stopped = (0, 128)
constant Listing = "-NoProfile -Command " + Own + "$file = Get-Item -ErrorAction Ignore '"
constant Matching = "'; if ($file) { Get-CimInstance Win32_Process | Where-Object { $_.ExecutablePath -eq $file.FullName"
constant Older = " -and $_.CreationDate -lt $file.LastWriteTime -and $_.ProcessId -ne $me }"
constant Printed = " | ForEach-Object { '' + $_.ProcessId + [char]9 + ($_.CommandLine -replace '[\\r\\n]+', ' ') } }"
constant Missing = Running(Logger, "Compiler/output/Missing.exe")
constant Served = Running(Logger, "C:/s/strict.exe")
constant Idling = Running(Logger, "Compiler/output/strict.exe")
constant EndedCodes = (0, 128)
constant Line = "12\t\"C:/s/Sum.exe\" 5"
Listed Texts
	Missing.Listed.Length is 0
	Process.RunTool("powershell", Listing + TypeSource.Absolute(executable) + Matching + Older + Printed).Output.Lines - ""
Described Text
	Missing.Described is "another program"
	let found = Listed
	mutable ids = List(Mutable(Text))
	for found
		ids.Add(Id(value))
	found.Length is 0 then "another program" else "process " + Text.Combine(ids, ", ")
Id(line Text) Text
	Missing.Id(Line) is "12"
	line.Split("\t").First
Command(line Text) Text
	Missing.Command(Line) is "\"C:/s/Sum.exe\" 5"
	line.Substring(Id(line).Length + 1, line.Length - Id(line).Length - 1)
IsStopped(line Text) Boolean
	Missing.IsStopped(Line)
	Served.IsStopped("12\t\"C:/s/strict.exe\" serve 2") is false
	File("Compiler/output/obj/strict.free9").Write("1") is not Error
	Idling.IsStopped("12\t\"Compiler/output/strict.exe\"  serve 9  ")
	Served.IsStopped("12\t\"C:/s/strict.exe\" build Strict.strict") is false
	Served.IsStopped((Process.Id to Text) + "\t\"C:/s/strict.exe\" serve 2") is false
	Id(line) is not Process.Id to Text and (IsStrict is false or IsIdle(line))
IsIdle(line Text) Boolean
	File("Compiler/output/obj/strict.free8").Write("1") is not Error
	Idling.IsIdle("12\t\"Compiler/output/strict.exe\" serve 8")
	Served.IsIdle("12\t\"C:/s/strict.exe\" serve 2") is false
	Idling.IsIdle("12\t\"Compiler/output/strict.exe\" build A.strict") is false
	let command = Command(line)
	let at = command.IndexOf(" serve")
	let slot = at < 0 then "" else command.Substring(at + 6, command.Length - at - 6).Trim.Split(" ").First
	at >= 0 and File(Resident(Path(executable).PathOnly.text, slot).Freed).Exists
IsStrict Boolean
	Served.IsStrict
	Missing.IsStrict is false
	Path(executable).FileName.RemoveExtension.text is "strict"
Stopping Texts
	Missing.Stopping.Length is 0
	mutable kept = List(Mutable(Text))
	for Listed
		if IsStopped(value)
			kept.Add(value)
	kept
Ended(id Text) Boolean
	Missing.Ended("0") is false
	Process.OperatingSystem is not "Windows" or Missing.Ended("999999")
	let isClosed = Process.RunTool("taskkill", "/PID " + id).exitCode is in Stopped
	isClosed or Process.RunTool("taskkill", "/F /PID " + id).exitCode is in Stopped or IsGone(id)
IsGone(id Text) Boolean slow
	Missing.IsGone("999999") and Missing.IsGone(Process.Id to Text) is false
	for Range(0, 5)
		if Process.RunTool("tasklist", "/FI \"PID eq " + id + "\" /NH").Output.IndexOf(" " + id + " ") < 0
			return true
		Process.Wait(0.1)
	false
Restarted(old Text) Text slow
	Missing.Restarted("Compiler/output/Missing.old.exe") is ""
	if Directory.Files(Path(executable).PathOnly.text + "/obj", "strict.server*").Length is 0
		return ""
	let stopping = Stopping
	for stopping
		logger.Log("Stopping " + executable + " (process " + Id(value) + ")")
		if Ended(Id(value)) is false
			return "process " + Id(value) + " did not stop"
	if stopping.Length > 0 and IsStrict is false and Intermediates(logger).Deleted(old) is Error
		return old + " is still in use by " + Described
	IsStrict then "" else Started(stopping)
Started(lines Texts) Text
	Missing.Started(List(Text)) is ""
	for lines
		let command = Forwarding.Quote + Command(value).Replace("'", "''").Replace("\"", Forwarding.Quote) + Forwarding.Quote
		let folder = "' -WindowStyle Hidden -WorkingDirectory '" + Directory.Current + "'"
		let started = Process.RunTool("powershell", Forwarding.Starting + command + folder)
		logger.Log(started.exitCode is 0 then "Started " + executable + " again" else "Could not start " + Command(value))
	""
