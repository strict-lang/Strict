constant Passes = " --mem2reg --cse --canonicalize -o "
constant Lowered = "Compiler/obj/Seed.opt.mlir"
constant ToolSeconds = 270
Run(arguments Texts) Number
	if arguments.Length is 0
		Write
	else
		NativeCompiler.Build(arguments.Slice(1, arguments.Length - 1), List(Text), List(TypeEntry))
	0
Write
	if Process.Variable("STRICT_GPU") is not "0"
		return Error("SeedNeedsStrictGpuZero")
	tool = Toolchain(Platform.Current, ".").Locate("mlir-opt")
	shrunk = Process.RunTool(tool, "Compiler/obj/Seed.mlir" + Passes + Lowered, ToolSeconds)
	if shrunk.exitCode is not 0
		return Error("SeedNotShrunk: " + shrunk.Output + shrunk.error)
	File("Compiler/Bootstrap.mlir").Write(Cut(File(Lowered).ReadText, File("Compiler/NativeRuntime.mlir").ReadLines.First))
	logger.Log("Written Compiler/Bootstrap.mlir, " + File("Compiler/Bootstrap.mlir").Length + " bytes")
Cut(module Text, runtime Text) Text
	Seed.Cut("module {\n  a\n  b\n  c\n}", "  b") is "module {\n  a\n"
	module.Substring(0, module.IndexOf("\n" + runtime) + 1)
