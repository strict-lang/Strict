has root Text
has executable Text
constant Current = Error("Current")
constant CheckedFile = "/obj/Strict.checked"
constant BuildLock = "/obj/Strict.selfbuild.lock"
constant HoldFile = "/obj/Strict.hold"
constant CompilerPackages = ("Compiler", "Compiler/Checks", "Compiler/Gpu", "Compiler/Mlir", "Compiler/MlirValues", "Compiler/MlirStructs", "Compiler/MlirLoops", "Compiler/MlirDevice")
constant CorePackages = CompilerPackages + ("Bytecode", "Bytecode/Binary", "Bytecode/Optimize", "Expressions", "Expressions/Syntax", "Runtime", "Runtime/Core", "Validators")
constant ExtraPackages = ("Math", "Binary", "Compression", "Regex", "Json", "Networking", "NeuralNetworks")
constant DaemonCommands = ("coordinator", "serve", "linked", "status", "stop")
constant InfoCommands = ("help", "--help", "version", "--version")
constant BuildOptions = ("", "windows", "linux", "web", "android", "ios", "fast", "library", "full", "strict")
Rebuilt(arguments Texts) Number slow
	SelfBuild("Compiler/output/Missing", "Missing.exe").Rebuilt(List(Text) + "test") is Current
	SelfBuild(".", "strict.exe").Rebuilt(List(Text) + "stop") is Current
	if IsStale(arguments) is false
		return Current
	if File(root + HoldFile).Exists
		logger.Log(Shown + " is older than Strict sources, not rebuilt while obj/Strict.hold exists")
		return Current
	IsBuilt(arguments) then Process(TargetExecutable).Start(Quote(arguments)) else Current
TargetExecutable Text
	SelfBuild("C:\\a", "C:\\b\\strict.exe").TargetExecutable is "C:/a/strict.exe"
	root.Replace("\\", "/") + "/" + Path(executable).FileName.text
Shown Text
	SelfBuild("C:\\a/b", "s").Shown is (Process.OperatingSystem is "Windows" then "C:\\a\\b\\s" else "C:/a/b/s")
	Process.OperatingSystem is "Windows" then TargetExecutable.Replace("/", "\\") else TargetExecutable
IsBuilt(arguments Texts) Boolean slow
	exeBefore = File(TargetExecutable).Modified
	if IsLocked is false
		return false
	home = Directory.Current
	Directory.Change(root)
	current = IsStale(arguments) is false or NativeCache("build", ("Strict.strict", ".")).IsCurrent
	built = current then File(TargetExecutable).Modified > exeBefore else IsCoreRebuilt
	Mark
	Directory.Change(home)
	IsUnlocked and built
IsCoreRebuilt Boolean slow
	logger.Log(Shown + " is older than Strict sources, rebuilding")
	IsRebuilt(Process(TargetExecutable).Start("build Strict.strict ."))
IsRebuilt(code Number) Boolean
	SelfBuild("a", "strict.exe").IsRebuilt(0)
	SelfBuild("a", "strict.exe").IsRebuilt(3) is false
	if code is 0
		return true
	logger.Log(Shown + " could not be rebuilt (exit code " + code + "), it stays in use until the sources change")
	false
IsLocked Boolean slow
	if Directory.Exists(root + "/obj") is false
		Directory.Create(root + "/obj")
	lock = File(root + BuildLock)
	if lock.IsLocked
		return true
	started = Process.Elapsed
	for as long as Process.Elapsed - started < Strict.BuildWait
		Process.Wait(0.1)
		if lock.IsLocked
			return true
	false
IsUnlocked Boolean
	SelfBuild("Compiler/output", "s").IsLocked and SelfBuild("Compiler/output", "s").IsUnlocked
	File(root + BuildLock).Delete
	File(root + BuildLock).Exists is false
Mark
	Directory.Create(root + "/obj")
	File(root + CheckedFile).Write("checked")
IsStale(arguments Texts) Boolean
	SelfBuild("Compiler/output/Missing", "strict.exe").IsStale(List(Text) + "test") is false
	if File(root + "/Strict.strict").Exists is false or IsSkipped(arguments)
		return false
	exeTime = File(TargetExecutable).Modified
	if exeTime is 0
		return false
	stamp = File(root + CheckedFile).Modified.Maximum(exeTime)
	IsGitNewer(stamp) then true else IsSourceScanNeeded(arguments) and NewestSource > stamp
IsGitNewer(stamp Number) Boolean
	SelfBuild("Compiler/output/Missing", "strict.exe").IsGitNewer(0) is false
	log = File(root + "/.git/logs/HEAD")
	if log.Exists
		return log.Modified > stamp
	if File(root + "/.git/HEAD").Exists is false
		return false
	result = Process.RunTool("git", "-C \"" + root + "\" log -1 --format=%ct")
	parsed = result.HasSucceeded then result.Output.Trim to Number else 0
	parsed is not Error and parsed > stamp
IsSkipped(arguments Texts) Boolean
	SelfBuild(".", "strict.exe").IsSkipped(("build", "Strict.strict"))
	SelfBuild(".", "strict.exe").IsSkipped(("build", "."))
	SelfBuild(".", "strict.exe").IsSkipped(("build", "Examples/Sum.strict")) is false
	command = arguments.Length > 0 then arguments(0) else ""
	if command is in DaemonCommands or command is in InfoCommands
		return true
	if command is not "build"
		return false
	second = arguments.Length > 1 then arguments(1).Replace("\\", "/").Lower else ""
	isRoot = TypeSource.Absolute(root).Lower is Directory.Current.Replace("\\", "/").Lower
	second is in BuildOptions or second.EndsWith("strict.strict") or second is "." and isRoot
IsSourceScanNeeded(arguments Texts) Boolean
	SelfBuild(".", "strict.exe").IsSourceScanNeeded(("test", "Bytecode/SourceFiles.strict")) is false
	SelfBuild(".", "strict.exe").IsSourceScanNeeded(List(Text) + "Examples/Sum.strict")
	if root is not "." and Directory.Current.Replace("\\", "/").Lower is not root.Replace("\\", "/").Lower
		return true
	command = arguments.Length > 0 then arguments(0) else ""
	if command is in ("check", "format", "suggest")
		return false
	if command is not "test"
		return true
	IsCoreTarget(arguments.Length > 1 then arguments(1).Replace("\\", "/") else "") is false
IsCoreTarget(target Text) Boolean
	SelfBuild(".", "strict.exe").IsCoreTarget("Bytecode/SourceFiles.strict")
	SelfBuild(".", "strict.exe").IsCoreTarget("Examples/Sum.strict") is false
	if target is "" or target.EndsWith(".strict") and target.IndexOf("/") < 0
		return true
	for CorePackages + ExtraPackages
		if target is value or target.StartsWith(value + "/")
			return true
	false
NewestSource Number
	SelfBuild("Compiler/output/Missing", "strict.exe").NewestSource is 0
	mutable newest = File(root + "/Strict.strict").Modified
	newest = MaxModify(Directory.Files(root, "*.strict"), newest)
	newest = MaxModify(Directory.Files(root + "/Compiler", "*.mlir"), newest)
	for CorePackages + ExtraPackages
		newest = MaxModify(Directory.Files(root + "/" + value, "*.strict"), newest)
	newest
MaxModify(paths Texts, current Number) Number
	SelfBuild(".", "strict.exe").MaxModify(List(Text) + "Missing.strict", 5) is 5
	mutable newest = current
	for paths
		modified = File(value).Modified
		if modified > newest
			newest = modified
	newest
Quote(arguments Texts) Text
	SelfBuild(".", "strict.exe").Quote(("a b", "c\"d")) is "\"a b\" \"c\\\"d\""
	mutable text = ""
	for arguments
		quoted = value.IndexOf(" ") >= 0 or value.IndexOf("\"") >= 0 or value is ""
		part = quoted then "\"" + value.Replace("\"", "\\\"") + "\"" else value
		text = index is 0 then part else text + " " + part
	text