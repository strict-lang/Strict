has logger
has root Text
has executable Text
constant Current = Error("Current")
constant CheckedFile = "/obj/Strict.checked"
constant BuildLock = "/obj/Strict.selfbuild.lock"
constant HoldFile = "/obj/Strict.hold"
constant CorePackages = ("Compiler", "Bytecode", "Expressions", "Runtime", "Validators")
constant ExtraPackages = ("Math", "Binary", "Compression", "Regex", "Json", "Networking", "NeuralNetworks")
constant DaemonCommands = ("coordinator", "serve", "linked", "status", "stop")
constant InfoCommands = ("help", "--help", "version", "--version")
constant BuildOptions = ("", "windows", "linux", "web", "android", "ios", "fast", "library", "full", "strict")
Rebuilt(arguments Texts) Number slow
	SelfBuild(Logger, "Compiler/output/Missing", "Missing.exe").Rebuilt(List(Text) + "test") is Current
	SelfBuild(Logger, ".", "strict.exe").Rebuilt(List(Text) + "stop") is Current
	if IsStale(arguments) is false
		return Current
	if File(root + HoldFile).Exists
		logger.Log(Shown + " is older than Strict sources, not rebuilt while obj/Strict.hold exists")
		return Current
	Built(arguments) then Process(TargetExecutable).Started(Quoted(arguments)) else Current
TargetExecutable Text
	SelfBuild(Logger, "C:\\a", "C:\\b\\strict.exe").TargetExecutable is "C:/a/strict.exe"
	root.Replace("\\", "/") + "/" + Path(executable).FileName.text
Shown Text
	SelfBuild(Logger, "C:\\a/b", "s").Shown is (Process.OperatingSystem is "Windows" then "C:\\a\\b\\s" else "C:/a/b/s")
	Process.OperatingSystem is "Windows" then TargetExecutable.Replace("/", "\\") else TargetExecutable
Built(arguments Texts) Boolean slow
	let exeBefore = File(TargetExecutable).Modified
	if Locked is false
		return false
	let home = Directory.Current
	Directory.Change(root)
	let current = IsStale(arguments) is false or NativeCache("build", ("Strict.strict", ".")).IsCurrent
	let built = current then File(TargetExecutable).Modified > exeBefore else RebuiltCore
	Marked
	Directory.Change(home)
	Unlocked and built
RebuiltCore Boolean slow
	logger.Log(Shown + " is older than Strict sources, rebuilding")
	IsRebuilt(Process(TargetExecutable).Started("build Strict.strict ."))
IsRebuilt(code Number) Boolean
	SelfBuild(Logger, "a", "strict.exe").IsRebuilt(0)
	SelfBuild(Logger, "a", "strict.exe").IsRebuilt(3) is false
	if code is 0
		return true
	logger.Log(Shown + " could not be rebuilt (exit code " + code + "), it stays in use until the sources change")
	false
Locked Boolean slow
	if Directory.Exists(root + "/obj") is false
		Directory.Create(root + "/obj")
	let lock = File(root + BuildLock)
	if lock.Locked
		return true
	let started = Process.Elapsed
	for as long as Process.Elapsed - started < Strict.BuildWait
		Process.Wait(0.1)
		if lock.Locked
			return true
	false
Unlocked Boolean
	SelfBuild(Logger, "Compiler/output", "s").Locked and SelfBuild(Logger, "Compiler/output", "s").Unlocked
	File(root + BuildLock).Delete
	File(root + BuildLock).Exists is false
Marked
	Directory.Create(root + "/obj")
	File(root + CheckedFile).Write("checked")
IsStale(arguments Texts) Boolean
	SelfBuild(Logger, "Compiler/output/Missing", "strict.exe").IsStale(List(Text) + "test") is false
	if File(root + "/Strict.strict").Exists is false or IsSkipped(arguments)
		return false
	let exeTime = File(TargetExecutable).Modified
	if exeTime is 0
		return false
	let stamp = File(root + CheckedFile).Modified.Maximum(exeTime)
	IsGitNewer(stamp) then true else IsSourceScanNeeded(arguments) and NewestSource > stamp
IsGitNewer(stamp Number) Boolean
	SelfBuild(Logger, "Compiler/output/Missing", "strict.exe").IsGitNewer(0) is false
	let log = File(root + "/.git/logs/HEAD")
	if log.Exists
		return log.Modified > stamp
	if File(root + "/.git/HEAD").Exists is false
		return false
	let result = Process.RunTool("git", "-C \"" + root + "\" log -1 --format=%ct")
	let parsed = result.Succeeded then result.Output.Trim to Number else 0
	parsed is not Error and parsed > stamp
IsSkipped(arguments Texts) Boolean
	SelfBuild(Logger, ".", "strict.exe").IsSkipped(("build", "Strict.strict"))
	SelfBuild(Logger, ".", "strict.exe").IsSkipped(("build", "."))
	SelfBuild(Logger, ".", "strict.exe").IsSkipped(("build", "Examples/Sum.strict")) is false
	let command = arguments.Length > 0 then arguments(0) else ""
	if command is in DaemonCommands or command is in InfoCommands
		return true
	if command is not "build"
		return false
	let second = arguments.Length > 1 then arguments(1).Replace("\\", "/").Lower else ""
	let isRoot = TypeSource.Absolute(root).Lower is Directory.Current.Replace("\\", "/").Lower
	second is in BuildOptions or second.EndsWith("strict.strict") or second is "." and isRoot
IsSourceScanNeeded(arguments Texts) Boolean
	SelfBuild(Logger, ".", "strict.exe").IsSourceScanNeeded(("test", "Bytecode/SourceFiles.strict")) is false
	SelfBuild(Logger, ".", "strict.exe").IsSourceScanNeeded(List(Text) + "Examples/Sum.strict")
	if root is not "." and Directory.Current.Replace("\\", "/").Lower is not root.Replace("\\", "/").Lower
		return true
	let command = arguments.Length > 0 then arguments(0) else ""
	if command is in ("check", "format", "suggest")
		return false
	if command is not "test"
		return true
	IsCoreTarget(arguments.Length > 1 then arguments(1).Replace("\\", "/") else "") is false
IsCoreTarget(target Text) Boolean
	SelfBuild(Logger, ".", "strict.exe").IsCoreTarget("Bytecode/SourceFiles.strict")
	SelfBuild(Logger, ".", "strict.exe").IsCoreTarget("Examples/Sum.strict") is false
	if target is "" or target.EndsWith(".strict") and target.IndexOf("/") < 0
		return true
	for CorePackages + ExtraPackages
		if target is value or target.StartsWith(value + "/")
			return true
	false
NewestSource Number
	SelfBuild(Logger, "Compiler/output/Missing", "strict.exe").NewestSource is 0
	mutable newest = File(root + "/Strict.strict").Modified
	newest = MaxModified(Directory.Files(root, "*.strict"), newest)
	newest = MaxModified(Directory.Files(root + "/Compiler", "*.mlir"), newest)
	for CorePackages + ExtraPackages
		newest = MaxModified(Directory.Files(root + "/" + value, "*.strict"), newest)
	newest
MaxModified(paths Texts, current Number) Number
	SelfBuild(Logger, ".", "strict.exe").MaxModified(List(Text) + "Missing.strict", 5) is 5
	mutable newest = current
	for paths
		let modified = File(value).Modified
		if modified > newest
			newest = modified
	newest
Quoted(arguments Texts) Text
	SelfBuild(Logger, ".", "strict.exe").Quoted(("a b", "c\"d")) is "\"a b\" \"c\\\"d\""
	mutable text = ""
	for arguments
		let quoted = value.IndexOf(" ") >= 0 or value.IndexOf("\"") >= 0 or value is ""
		let part = quoted then "\"" + value.Replace("\"", "\\\"") + "\"" else value
		text = index is 0 then part else text + " " + part
	text