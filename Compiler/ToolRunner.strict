has name Text
constant IsWindows = Process.OperatingSystem is "Windows"
constant Echo = IsWindows then ToolRunner("cmd") else ToolRunner("echo")
constant Echoed = IsWindows then "/c echo " else ""
Executable Text
	ToolRunner("noSuchStrictTool").Executable is ""
	Process.Find(name).executable
IsAvailable Boolean
	ToolRunner("noSuchStrictTool").IsAvailable is false
	Process.Find(name).IsAvailable
Execute(arguments Text, phase = "") ProcessResult
	ToolRunner("noSuchStrictTool").Execute("").HasFailed
	Echo.Execute(Echoed + "a").Output.IndexOf("\r") is -1
	ExecuteAll(List(Text) + arguments, phase).First
ExecuteAll(arguments Texts, phase = "") List(ProcessResult)
	ToolRunner("noSuchStrictTool").ExecuteAll(("", "")).Last.HasFailed
	Echo.ExecuteAll((Echoed + "a", Echoed + "b")).Last.Output is "b\n"
	tool = "Tool " + Path(name).FileName.text + " (" + arguments.Length + " jobs)"
	started = Process.Elapsed
	results = Process.RunTools(name, arguments)
	BuildProfile.Report(phase is "" then tool else phase, started)
	for results
		Retry(Clean(value), arguments(index))
Retry(result ProcessResult, arguments Text) ProcessResult
	ToolRunner("noSuchStrictTool").Retry(ProcessResult(139, "", ""), "").exitCode is 127
	ToolRunner("noSuchStrictTool").Retry(ProcessResult(1, "", ""), "").exitCode is 1
	IsCrash(result.exitCode) then Clean(Process.RunTool(name, arguments)) else result
Clean(result ProcessResult) ProcessResult
	Echo.Clean(ProcessResult(0, "a\r\n", "")).Output is "a\n"
	Echo.Clean(ProcessResult(127, "", "")).error is "Tool " + Echo.name + " exited 127 without output"
	silent = result.HasFailed and result.Output is "" and result.error is ""
	error = silent then "Tool " + name + " exited " + result.exitCode + " without output" else result.error
	ProcessResult(result.exitCode, result.Output.Replace("\r", ""), error.Replace("\r", ""))
IsCrash(exitCode Number) Boolean
	ToolRunner.IsCrash(139)
	ToolRunner.IsCrash(-1073741819)
	ToolRunner.IsCrash(3) is false
	constant crashExitCode = 128
	exitCode < 0 or exitCode >= crashExitCode
to Text
	name
