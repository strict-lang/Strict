has name Text
constant IsWindows = Process.OperatingSystem is "Windows"
constant Echo = IsWindows then ToolRunner("cmd") else ToolRunner("echo")
constant Echoed = IsWindows then "/c echo " else ""
Executable Text
	ToolRunner("noSuchStrictTool").Executable is ""
	Process.Find(name).executable
IsAvailable Boolean
	ToolRunner("noSuchStrictTool").IsAvailable is false
	Process.Find(name).IsAvailable
Execute(arguments Text, phase = "") ProcessResult
	ToolRunner("noSuchStrictTool").Execute("").Failed
	Echo.Execute(Echoed + "a").Output.IndexOf("\r") is -1
	ExecuteAll(List(Text) + arguments, phase).First
ExecuteAll(arguments Texts, phase = "") List(ProcessResult)
	ToolRunner("noSuchStrictTool").ExecuteAll(("", "")).Last.Failed
	Echo.ExecuteAll((Echoed + "a", Echoed + "b")).Last.Output is "b\n"
	let tool = "Tool " + Path(name).FileName.text + " (" + arguments.Length + " jobs)"
	let started = Process.Elapsed
	let results = Process.RunTools(name, arguments)
	BuildProfile(Logger).Reported(phase is "" then tool else phase, started)
	for results
		Retried(Cleaned(value), arguments(index))
Retried(result ProcessResult, arguments Text) ProcessResult
	ToolRunner("noSuchStrictTool").Retried(ProcessResult(139, "", ""), "").exitCode is 127
	ToolRunner("noSuchStrictTool").Retried(ProcessResult(1, "", ""), "").exitCode is 1
	IsCrash(result.exitCode) then Cleaned(Process.RunTool(name, arguments)) else result
Cleaned(result ProcessResult) ProcessResult
	Echo.Cleaned(ProcessResult(0, "a\r\n", "")).Output is "a\n"
	ProcessResult(result.exitCode, result.Output.Replace("\r", ""), result.error.Replace("\r", ""))
IsCrash(exitCode Number) Boolean
	ToolRunner.IsCrash(139)
	ToolRunner.IsCrash(-1073741819)
	ToolRunner.IsCrash(3) is false
	(exitCode < 0) or (exitCode >= 128)
to Text
	name