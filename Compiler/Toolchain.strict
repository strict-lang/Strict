has platform Number
has root Text
has natives Texts = List(Text)
constant Needed = ("mlir-opt", "mlir-translate", "clang")
constant WindowsFolders = ("C:/msys64/ucrt64/bin/", "C:/Program Files/LLVM/bin/")
constant LinuxRelease = "LLVM-22.1.0-Linux-X64"
constant LinuxDownload = "https://github.com/llvm/llvm-project/releases/download/llvmorg-22.1.0/LLVM-22.1.0-Linux-X64.tar.xz"
constant LinuxMembers = " LLVM-22.1.0-Linux-X64/bin/clang LLVM-22.1.0-Linux-X64/bin/clang-22 LLVM-22.1.0-Linux-X64/bin/mlir-opt LLVM-22.1.0-Linux-X64/bin/mlir-translate LLVM-22.1.0-Linux-X64/lib/clang/22/include"
constant Accept = " --accept-package-agreements --accept-source-agreements"
constant Pacman = "C:\\msys64\\usr\\bin\\pacman.exe"
constant SingleThreaded = " --mlir-disable-threading"
constant LinuxTarget = " --target=x86_64-unknown-linux-gnu -O2 -c -Wno-override-module"
constant Optimized = " -O2 -march=native -Wno-override-module"
constant OnWindows = Toolchain(Platform.Windows, "C:/s")
constant OnLinux = Toolchain(Platform.Linux, "/s")
Located(name Text) Text
	OnWindows.Located("noSuchStrictTool") is ""
	if Process.Find(name).IsAvailable
		return name
	for Folders
		if File(value + name + Extension).Exists
			return value + name + Extension
	""
Folders Texts
	OnLinux.Folders is ("/s/Tools/LLVM-22.1.0-Linux-X64/bin/")
	if platform is Platform.Windows
		return WindowsFolders
	List(Text) + (root + "/Tools/" + LinuxRelease + "/bin/")
Extension Text
	OnWindows.Extension is ".exe"
	OnLinux.Extension is ""
	platform is Platform.Windows then ".exe" else ""
Executable(base Text) Text
	OnWindows.Executable("./Strict") is "./strict.exe"
	OnLinux.Executable("./Examples/ProcessImage") is "./Examples/ProcessImage"
	let isCommand = Path(base).FileName.text is "Strict"
	(isCommand then base.Substring(0, base.Length - 6) + "strict" else base) + Extension
Missing(names Texts) Texts
	OnLinux.Missing(("noSuchStrictTool")) is ("noSuchStrictTool")
	for names
		if Located(value) is ""
			value
InstallLines(missing Texts) Texts
	OnLinux.InstallLines(("clang")).Length is 2
	platform is Platform.Windows then WindowsLines(missing) else LinuxLines
WindowsLines(missing Texts) Texts
	OnWindows.WindowsLines(("clang")).First is "winget install -e --id LLVM.LLVM" + Accept
	mutable lines = List(Mutable(Text))
	let needsMlir = ("mlir-opt" is in missing) or ("mlir-translate" is in missing)
	if needsMlir and (File(Pacman).Exists is false)
		lines.Add("winget install -e --id MSYS2.MSYS2" + Accept)
	if needsMlir
		lines.Add(Pacman + " -S --noconfirm --needed mingw-w64-ucrt-x86_64-mlir")
	if "clang" is in missing
		lines.Add("winget install -e --id LLVM.LLVM" + Accept)
	lines
LinuxLines Texts
	OnLinux.LinuxLines.First is "mkdir -p /s/Tools"
	let extract = " | tar -xJ --occurrence -C " + root + "/Tools" + LinuxMembers
	("mkdir -p " + root + "/Tools", "curl -sL " + LinuxDownload + extract)
Launch(script Text) Text
	OnWindows.Launch("C:/s/Tools/Install.cmd") is "/c start \"Strict tools\" cmd /k \"C:\\s\\Tools\\Install.cmd\""
	OnLinux.Launch("/s/Tools/install.sh") is "-c \"nohup sh /s/Tools/install.sh > /s/Tools/install.log 2>&1 &\""
	if platform is Platform.Windows
		return "/c start \"Strict tools\" cmd /k \"" + script.Replace("/", "\\") + "\""
	"-c \"nohup sh " + script + " > " + root + "/Tools/install.log 2>&1 &\""
Installing(missing Texts) Text
	OnWindows.Installing(List(Text)) is ""
	if missing.Length is 0
		return ""
	let isWindows = platform is Platform.Windows
	let script = root + "/Tools/" + (isWindows then "Install.cmd" else "install.sh")
	Directory.Create(root + "/Tools")
	File(script).Write(Text.Combine(InstallLines(missing), "\n"))
	let shell = isWindows then "cmd" else "sh"
	let started = Process.RunTool(shell, Launch(script))
	let where = isWindows then " in a new window" else " in the background (" + root + "/Tools/install.log)"
	let problem = started.Failed then ", could not start it: " + started.error else ""
	Text.Combine(missing, ", ") + " not found, installing them with " + script + where + problem
Built(base Text, executable Text) Text
	OnWindows.Built("Compiler/output/missing", "missing.exe").StartsWith("mlir-opt failed") is true
	let lowered = Lowered(base)
	if lowered is not ""
		return lowered
	let system = platform is Platform.Windows then " -Wl,-Brepro" else " -lm"
	let sources = NativeSources(natives).Arguments(platform, root)
	let linking = Quoted(base + ".ll") + sources + " -o " + Quoted(executable) + Optimized + system
	let linked = ToolRunner(Located("clang")).Execute(linking)
	linked.Failed then "clang failed: " + linked.error else "Built " + executable
CrossBuilt(base Text) Text
	OnWindows.CrossBuilt("Compiler/output/missing").StartsWith("mlir-opt failed") is true
	let lowered = Lowered(base + ".linux")
	if lowered is not ""
		return lowered
	let compiling = Quoted(base + ".linux.ll") + " -o " + Quoted(base + ".linux.o") + LinuxTarget
	let compiled = ToolRunner(Located("clang")).Execute(compiling)
	if compiled.Failed
		return "clang failed: " + compiled.error
	let program = Toolchain(Platform.Linux, root).Executable(base)
	NativeSources(natives).LinuxLinked(base, program, root)
WslPath(path Text) Text
	OnWindows.WslPath("C:/code/A") is "/mnt/c/code/A"
	OnWindows.WslPath("D:\\B\\c") is "/mnt/d/B/c"
	OnWindows.WslPath("./Examples/Sum") is "./Examples/Sum"
	let slashed = path.Replace("\\", "/")
	let drive = "/mnt/" + slashed.Substring(0, 1).Lower
	slashed.IndexOf(":") is 1 then drive + slashed.Substring(2, slashed.Length - 2) else slashed
Lowered(base Text) Text
	OnWindows.Lowered("Compiler/output/missing").StartsWith("mlir-opt failed") is true
	constant passes = " --convert-scf-to-cf --convert-arith-to-llvm --convert-func-to-llvm --convert-cf-to-llvm"
	let output = " --reconcile-unrealized-casts -o " + Quoted(base + ".llvm.mlir")
	let lowering = Quoted(base + ".mlir") + SingleThreaded + passes + output
	let lowered = ToolRunner(Located("mlir-opt")).Execute(lowering)
	if lowered.Failed
		return "mlir-opt failed: " + lowered.error
	let translation = SingleThreaded + " --mlir-to-llvmir " + Quoted(base + ".llvm.mlir") + " -o " + Quoted(base + ".ll")
	let translated = ToolRunner(Located("mlir-translate")).Execute(translation)
	translated.Failed then "mlir-translate failed: " + translated.error else ""
Quoted(path Text) Text
	OnWindows.Quoted("a b") is "\"a b\""
	"\"" + path + "\""