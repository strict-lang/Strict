has platform Number
has root Text
has natives Texts = List(Text)
has isWeb Boolean = false
constant Needed = ("mlir-opt", "mlir-translate", "clang", "opt", "llc")
constant WindowsFolders = ("C:/Program Files/LLVM/bin/", "C:/msys64/ucrt64/bin/")
constant LinuxRelease = "LLVM-23.1.3-Linux-X64"
constant Optimized = " -march=native -Wno-override-module"
constant Parts = 16
constant Direct = " -fuse-ld=lld -Wl,clang_rt.builtins-x86_64.lib"
constant Thin = " -x none -flto=thin -Wl,/opt:lldltojobs=all -Wl,/mllvm:-mcpu=native" + Direct
constant OnWindows = Toolchain(Platform.Windows, "C:/s")
constant OnLinux = Toolchain(Platform.Linux, "/s")
Located(name Text) Text
	OnWindows.Located("noSuchStrictTool") is ""
	Toolchain(Platform.MacOS, "/s").Located("clang") is ""
	if (platform is not Platform.MacOS) and Process.Find(name).IsAvailable
		return name
	for Folders
		if File(value + name + Extension).Exists
			return value + name + Extension
	""
Folders Texts
	OnLinux.Folders is ("/s/Tools/LLVM-23.1.3-Linux-X64/bin/")
	Toolchain(Platform.MacOS, "/s").Folders is ("/s/Tools/LLVM-23.1.3-MacOS/bin/")
	Toolchain(OnWindows, isWeb = true).Folders.Last is "C:/s/Tools/emsdk/upstream/emscripten/"
	let release = platform is Platform.MacOS then MacOSTools.Release else LinuxRelease
	let unix = List(Text) + (root + "/Tools/" + release + "/bin/")
	let folders = platform is Platform.Windows then WindowsFolders else unix
	isWeb then folders + (root + "/Tools/emsdk/upstream/bin/") + (root + "/Tools/emsdk/upstream/emscripten/") else folders
Extension Text
	OnWindows.Extension is ".exe"
	OnLinux.Extension is ""
	platform is Platform.Windows then ".exe" else ""
Executable(base Text) Text
	OnWindows.Executable("./Strict") is "./strict.exe"
	OnLinux.Executable("./Examples/ProcessImage") is "./Examples/ProcessImage"
	Toolchain(OnWindows, isWeb = true).Executable("./Examples/HelloLogger") is "./Examples/HelloLogger.html"
	if isWeb
		return base + ".html"
	let isCommand = Path(base).FileName.text is "Strict"
	(isCommand then base.Substring(0, base.Length - 6) + "strict" else base) + Extension
Missing(names Texts) Texts
	OnLinux.Missing(("noSuchStrictTool")) is ("noSuchStrictTool")
	for names
		if Located(value) is ""
			value
InstallLines(missing Texts) Texts
	OnLinux.InstallLines(("clang")).Length is 2
	Toolchain(OnWindows, isWeb = true).InstallLines(("emcc")).First.StartsWith("git clone --depth 1 ")
	let others = missing - "emcc"
	let unixLines = platform is Platform.MacOS then MacOSTools(root).Lines else LinuxLines
	let hostLines = platform is Platform.Windows then WindowsTools.Lines(others) else unixLines
	let host = others.Length is 0 then List(Text) else hostLines
	host + ("emcc" is in missing then WebBuild(value).InstallLines else List(Text))
LinuxLines Texts
	OnLinux.LinuxLines.First is "mkdir -p /s/Tools"
	constant Download = "https://github.com/llvm/llvm-project/releases/download/llvmorg-23.1.3/"
	constant Tools = ("clang", "clang-23", "mlir-opt", "mlir-translate", "opt", "llc")
	constant Offload = ("lld", "ld.lld", "clang-offload-bundler", "amdgpu-arch")
	let bin = " " + LinuxRelease + "/bin/"
	let members = bin + Text.Combine(Tools + Offload, bin) + " " + LinuxRelease + "/lib/clang/23/include"
	let download = Download + LinuxRelease + ".tar.xz"
	let extract = " | tar -xJ --occurrence -C " + root + "/Tools" + members
	("mkdir -p " + root + "/Tools", "curl -sL " + download + extract)
Launch(script Text) Text
	OnWindows.Launch("C:/s/Tools/Install.cmd") is "/c start \"Strict tools\" cmd /k \"C:\\s\\Tools\\Install.cmd\""
	OnLinux.Launch("/s/Tools/install.sh") is "-c \"nohup sh /s/Tools/install.sh > /s/Tools/install.log 2>&1 &\""
	if platform is Platform.Windows
		return "/c start \"Strict tools\" cmd /k \"" + script.Replace("/", "\\") + "\""
	"-c \"nohup sh " + script + " > " + root + "/Tools/install.log 2>&1 &\""
Installing(missing Texts) Text
	OnWindows.Installing(List(Text)) is ""
	if missing.Length is 0
		return ""
	let isWindows = platform is Platform.Windows
	let script = root + "/Tools/" + (isWindows then "Install.cmd" else "install.sh")
	Directory.Create(root + "/Tools")
	File(script).Write(Text.Combine(InstallLines(missing), "\n"))
	let shell = isWindows then "cmd" else "sh"
	let started = Process.RunTool(shell, Launch(script))
	let where = isWindows then " in a new window" else " in the background (" + root + "/Tools/install.log)"
	let problem = started.Failed then ", could not start it: " + started.error else ""
	Text.Combine(missing, ", ") + " not found, installing them with " + script + where + problem
Built(base Text, executable Text, level Text) Text
	OnWindows.Built("Compiler/output/missing", "missing.exe", NativeBuild.Fast).StartsWith("mlir-opt failed")
	let lowered = BuildProfile(Logger).Lowered(value, base, level)
	if lowered is not ""
		return lowered
	let system = platform is Platform.Windows then " -Wl,-Brepro -Wl,/STACK:67108864" else MacOSTools.Linked(platform)
	let files = NativeSources(natives).Objects(platform, root, level is NativeBuild.Quick then NativeBuild.Fast else level)
	let resource = files.StartsWith("clang") then files else NativeSources(natives).Resource(base, platform, root)
	if resource.StartsWith("llvm-rc failed") or resource.StartsWith("clang failed")
		return resource
	let linking = Inputs(base, level) + files + resource + " -o " + Quoted(executable) + Optimized + level + system
	let linked = ToolRunner(Located("clang")).Execute(linking, "Linking")
	linked.Failed then "clang failed: " + linked.error + linked.Output else "Built " + executable
Inputs(base Text, level Text) Text
	OnLinux.Inputs("Compiler/output/missing", "") is "\"Compiler/output/missing.ll\""
	let isDivided = (platform is Platform.Windows) and (File(base + ".ll").Exists is false)
	if isDivided is false
		return Quoted(base + ".ll") + (platform is Platform.Windows then Direct else "")
	if PartsCompiled(base, level) is false
		return Quoted(base + ".ll")
	mutable parts = ""
	for Parts
		parts = parts + " " + Quoted(base + "-" + value + ".o")
	parts + Thin + " -Wno-unused-command-line-argument"
PartsCompiled(base Text, level Text) Boolean
	OnWindows.PartsCompiled("Compiler/output/missing", "") is false
	mutable compiling = List(Mutable(Text))
	for Parts
		let part = base + "-" + value
		compiling.Add("-c -flto=thin -x ir " + Quoted(part) + " -o " + Quoted(part + ".o") + Optimized + level)
	for ToolRunner(Located("clang")).ExecuteAll(compiling, "Host clang (" + Parts + " jobs)")
		if value.Failed
			Logger.Log("clang failed (exit " + value.exitCode + "): " + value.Output + value.error)
			return false
	true
CrossBuilt(base Text, level Text) Text
	OnWindows.CrossBuilt("Compiler/output/missing", NativeBuild.Fast).StartsWith("mlir-opt failed")
	let lowered = Lowered(base + ".linux")
	if lowered is not ""
		return lowered
	constant target = " --target=x86_64-unknown-linux-gnu -mf16c -c -Wno-override-module"
	let compiling = Quoted(base + ".linux.ll") + " -o " + Quoted(base + ".linux.o") + target + level
	let compiled = ToolRunner(Located("clang")).Execute(compiling)
	if compiled.Failed
		return "clang failed: " + compiled.error
	let program = Toolchain(Platform.Linux, root).Executable(base)
	NativeSources(natives).LinuxLinked(base, program, root)
WslPath(path Text) Text
	OnWindows.WslPath("C:/code/A") is "/mnt/c/code/A"
	OnWindows.WslPath("D:\\B\\c") is "/mnt/d/B/c"
	OnWindows.WslPath("./Examples/Sum") is "./Examples/Sum"
	let slashed = path.Replace("\\", "/")
	let drive = "/mnt/" + slashed.Substring(0, 1).Lower
	slashed.IndexOf(":") is 1 then drive + slashed.Substring(2, slashed.Length - 2) else slashed
Lowered(base Text, kept = "", parts = 1) Text
	OnWindows.Lowered("Compiler/output/missing").StartsWith("mlir-opt failed")
	if (parts > 1) and File(base + ".mlir").Exists
		return MlirSplit(File(base + ".mlir").ReadLines).Lowered(base, Toolchain(platform, root, natives, isWeb))
	let privatized = kept is "" then "" else " --symbol-privatize=exclude=" + kept
	let lowering = Quoted(base + ".mlir") + privatized + MlirSplit.Passes + " -o " + Quoted(base + ".llvm.mlir")
	let lowered = ToolRunner(Located("mlir-opt")).Execute(lowering)
	if lowered.Failed
		return "mlir-opt failed: " + lowered.error
	let translation = MlirSplit.Translating + Quoted(base + ".llvm.mlir") + " -o " + Quoted(base + ".ll")
	let translated = ToolRunner(Located("mlir-translate")).Execute(translation)
	translated.Failed then "mlir-translate failed: " + translated.error else ""
Quoted(path Text) Text
	OnWindows.Quoted("a b") is "\"a b\""
	"\"" + path + "\""
