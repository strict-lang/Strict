has platform Number
has root Text
has natives Texts = List(Text)
has isWeb Boolean = false
has cpu = "native"
has target = ""
has isReleased = false
has isEdited = false
constant Needed = ("mlir-opt", "mlir-translate", "clang", "opt", "llc")
constant WindowsFolders = ("C:/Program Files/LLVM/bin/", "C:/msys64/ucrt64/bin/")
constant LinuxRelease = "LLVM-23.1.3-Linux-X64"
constant LinuxDownload = "https://github.com/llvm/llvm-project/releases/download/llvmorg-23.1.3/"
constant Optimized = " -march=native -Wno-override-module -O3"
constant Optimization = " -O3"
constant Parts = 64
constant Direct = " -fuse-ld=lld -Wl,clang_rt.builtins-x86_64.lib"
constant LtoCachePolicy = "prune_interval=0s:cache_size_bytes=64m"
constant Thin = " -x none -flto=thin -Wl,/opt:lldltojobs=all -Wl,/mllvm:-mcpu=native" + Direct
constant NoImports = " -Wl,/mllvm:-import-instr-limit=0"
constant Edited = " -Wl,/mllvm:-import-instr-limit=25"
constant OnWindows = Toolchain(Platform.Windows, "C:/s")
constant OnLinux = Toolchain(Platform.Linux, "/s")
Locate(name Text) Text
	OnWindows.Locate("noSuchStrictTool") is ""
	Toolchain(Platform.MacOS, "/s").Locate("clang") is ""
	Toolchain(Platform.Current, ".", isWeb = true).Locate("emcc").StartsWith("./") is false
	if platform is not Platform.MacOS and Process.Find(name).IsAvailable
		return name
	for Folders
		if File(value + name + Extension).Exists
			return TypeSource.Absolute(value + name + Extension)
	""
Folders Texts
	OnLinux.Folders is ("/s/Tools/LLVM-23.1.3-Linux-X64/bin/")
	Toolchain(Platform.MacOS, "/s").Folders is ("/s/Tools/LLVM-23.1.3-MacOS/bin/")
	Toolchain(OnWindows, isWeb = true).Folders.Last is "C:/s/Tools/emsdk/upstream/emscripten/"
	Toolchain(OnWindows, isWeb = true).Folders.First is "C:/s/Tools/emsdk/upstream/bin/"
	Toolchain(OnWindows, isWeb = true).Folders.Length is 4
	release = platform is Platform.MacOS then MacOSTools.Release else LinuxRelease
	unix = List(Text) + (root + "/Tools/" + release + "/bin/")
	folders = platform is Platform.Windows then WindowsFolders else unix
	emsdk = root + "/Tools/emsdk/upstream/"
	isWeb then List(Text) + (emsdk + "bin/") + folders + (emsdk + "emscripten/") else folders
Extension Text
	OnWindows.Extension is ".exe"
	OnLinux.Extension is ""
	platform is Platform.Windows then ".exe" else ""
Executable(base Text) Text
	OnWindows.Executable("./obj/Strict") is "./strict.exe"
	OnWindows.Executable("./Math/obj/Tests.test") is "./Math/obj/Tests.test.exe"
	OnLinux.Executable("./Examples/obj/ProcessImage") is "./Examples/ProcessImage"
	Toolchain(OnWindows, isWeb = true).Executable("./A/obj/B") is "./A/Release/Web/B.html"
	if isWeb
		return BuildOutput.ReleasePath(base, "Web") + ".html"
	program = BuildOutput.Deliver(base)
	isCommand = Path(program).FileName.text is "Strict"
	(isCommand then program.Substring(0, program.Length - 6) + "strict" else program) + Extension
Missing(names Texts) Texts
	OnLinux.Missing("noSuchStrictTool") is ("noSuchStrictTool")
	for names
		if Locate(value) is ""
			value
InstallLines(missing Texts) Texts
	OnLinux.InstallLines("clang").Length is 2
	Toolchain(OnWindows, isWeb = true).InstallLines("emcc").First.StartsWith("git clone --depth 1 ")
	others = missing - "emcc"
	unixLines = platform is Platform.MacOS then MacOSTools(root).Lines else LinuxLines
	hostLines = platform is Platform.Windows then WindowsTools.Lines(others) else unixLines
	host = others.Length is 0 then List(Text) else hostLines
	host + ("emcc" is in missing then WebBuild(value).InstallLines else List(Text))
LinuxLines Texts
	OnLinux.LinuxLines.First is "mkdir -p /s/Tools"
	OnLinux.LinuxLines.Length is 2
	OnLinux.LinuxLines.Last.StartsWith("curl -sL " + LinuxDownload + LinuxRelease + ".tar.xz | tar -xJ --occurrence -C ")
	OnLinux.LinuxLines.Last.EndsWith(" " + LinuxRelease + "/bin/amdgpu-arch " + LinuxRelease + "/lib/clang/23/include")
	OnLinux.LinuxLines.Last.IndexOf("/Tools " + LinuxRelease + "/bin/clang " + LinuxRelease + "/bin/clang-23 ") > 0
	constant Tools = ("clang", "clang-23", "mlir-opt", "mlir-translate", "opt", "llc")
	constant Offload = ("lld", "ld.lld", "clang-offload-bundler", "amdgpu-arch")
	bin = " " + LinuxRelease + "/bin/"
	members = bin + Text.Combine(Tools + Offload, bin) + " " + LinuxRelease + "/lib/clang/23/include"
	download = LinuxDownload + LinuxRelease + ".tar.xz"
	("mkdir -p " + root + "/Tools", "curl -sL " + download + (" | tar -xJ --occurrence -C " + root + "/Tools" + members))
Launch(script Text) Text
	OnWindows.Launch("C:/s/Tools/Install.cmd") is "/c start \"Strict tools\" cmd /k \"C:\\s\\Tools\\Install.cmd\""
	OnLinux.Launch("/s/Tools/install.sh") is "-c \"nohup sh /s/Tools/install.sh > /s/Tools/install.log 2>&1 &\""
	if platform is Platform.Windows
		return "/c start \"Strict tools\" cmd /k \"" + script.Replace("/", "\\") + "\""
	"-c \"nohup sh " + script + " > " + root + "/Tools/install.log 2>&1 &\""
Installing(missing Texts) Text
	OnWindows.Installing(List(Text)) is ""
	if missing.Length is 0
		return ""
	isWindows = platform is Platform.Windows
	script = root + "/Tools/" + (isWindows then "Install.cmd" else "install.sh")
	Directory.Create(root + "/Tools")
	File(script).Write(Text.Combine(InstallLines(missing), "\n"))
	started = Process.RunTool(isWindows then "cmd" else "sh", Launch(script))
	where = isWindows then " in a new window" else " in the background (" + root + "/Tools/install.log)"
	problem = started.HasFailed then ", could not start it: " + started.error else ""
	Text.Combine(missing, ", ") + " not found, installing them with " + script + where + problem
Build(base Text, executable Text) Text
	OnWindows.Build("Compiler/output/missing", "missing.exe").StartsWith("mlir-opt failed")
	lowered = BuildProfile.Lower(value, base)
	if lowered is not ""
		return lowered
	system = platform is Platform.Windows then " -Wl,-Brepro -Wl,/STACK:67108864" else MacOSTools.Link(platform)
	files = NativeSources(natives).Objects(platform, root, cpu)
	resource = files.StartsWith("clang") then files else NativeSources(natives).Resource(base, platform, root)
	if resource.StartsWith("llvm-rc failed") or resource.StartsWith("clang failed")
		return resource
	linking = Inputs(base) + files + resource + " -o " + Quote(executable) + Optimized.Replace("native", cpu) + system
	linked = ToolRunner(Locate("clang")).Execute(linking, "Linking")
	linked.HasFailed then "clang failed: " + linked.error + linked.Output else "Built " + executable
Inputs(base Text) Text
	OnLinux.Inputs("Compiler/output/missing") is "\"Compiler/output/missing.ll\""
	if (platform is Platform.Windows and File(base + ".ll").Exists is false) is false
		return Quote(base + ".ll") + (platform is Platform.Windows then Direct else "")
	if PartsCompiled(base) is false
		return Quote(base + ".ll")
	parts = PartObjects(base)
	cache = " -Xlinker " + Quote("/lldltocache:" + base + ".lto") + " -Wl,/lldltocachepolicy:" + LtoCachePolicy
	linked = IsThin then Thin.Replace("native", cpu) + Importing(base) + cache else Direct
	parts + linked + " -Wno-unused-command-line-argument"
Importing(base Text) Text
	OnWindows.Importing("a/obj/Tests.test") is NoImports
	OnWindows.Importing("a/obj/Sum") is Edited
	Toolchain(OnWindows, isReleased = true).Importing("a/obj/Sum") is ""
	base.EndsWith(".test") then NoImports else isReleased then "" else Edited
Bitcode(part Text) Text
	OnWindows.Bitcode("p").StartsWith("-c -x ir \"p\" -o \"p.o\" -march=")
	Toolchain(OnWindows, isReleased = true).Bitcode("p").StartsWith("-c -flto=thin -x ir \"p\" -o \"p.o\" -march=")
	Toolchain(OnLinux, isEdited = true).Bitcode("p").StartsWith("-c -flto=thin -x ir")
	Toolchain(Platform.Windows, ".", cpu = "skylake").Bitcode("p").IndexOf("-march=skylake") > 0
	Toolchain(Platform.Windows, ".", target = " --target=x").Bitcode("p").IndexOf(" --target=x -march=") > 0
	Toolchain(OnWindows, isWeb = true).Bitcode("p").StartsWith("-c -flto=thin -x ir \"p\" -o \"p.o\"" + WebBuild.Target)
	Toolchain(OnWindows, isWeb = true).Bitcode("p").EndsWith(WebBuild.Lowering + Optimization)
	native = target + Optimized.Replace("native", cpu)
	flags = isWeb then WebBuild.Target + WebBuild.Lowering + Optimization else native
	"-c " + (IsThin then "-flto=thin " else "") + "-x ir " + Quote(part) + " -o " + Quote(part + ".o") + flags
IsThin Boolean
	OnLinux.IsThin and Toolchain(OnWindows, isReleased = true).IsThin and Toolchain(OnWindows, isWeb = true).IsThin
	OnWindows.IsThin is false
	isReleased or isWeb or platform is not Platform.Windows
PartsCompiled(base Text) Boolean
	PtxCache("Compiler/output/Broken-0").Save("", "not llvm") is not Error
	OnWindows.PartsCompiled("Compiler/output/Broken") is false
	mutable compiling = List(Mutable(Text))
	for Parts
		part = base + "-" + value
		if File(part).Exists and File(part + ".o").Exists is false
			compiling.Add(Bitcode(part))
	for ToolRunner(Locate("clang")).ExecuteAll(compiling, "Host clang (" + compiling.Length + " jobs)")
		if value.HasFailed
			Logger.Log("clang failed (exit " + value.exitCode + "): " + value.Output + value.error)
			return false
	PartCache(root).HasPublished(base)
PartObjects(base Text) Text
	OnWindows.PartObjects("Compiler/output/missing") is ""
	mutable parts = ""
	for Parts
		if File(base + "-" + value + ".o").Exists
			parts = parts + " " + Quote(base + "-" + value + ".o")
	parts
Lower(base Text, kept = "", parts = 1) Text
	OnWindows.Lower("Compiler/output/missing").StartsWith("mlir-opt failed")
	if parts > 1 and File(base + ".mlir").Exists
		split = MlirSplit(File(base + ".mlir").ReadLines)
		return MlirParts(split).Laid.Lower(base, Toolchain(platform, root, natives, isWeb, cpu, target))
	privatized = kept is "" then "" else " --symbol-privatize=exclude=" + kept
	lowering = Quote(base + ".mlir") + privatized + MlirSplit.Single + base + ".llvm.mlir\""
	lowered = ToolRunner(Locate("mlir-opt")).Execute(lowering)
	if lowered.HasFailed
		return "mlir-opt failed (exit " + lowered.exitCode + "): " + lowered.error
	translation = MlirSplit.Translating + Quote(base + ".llvm.mlir") + " -o " + Quote(base + ".ll")
	translated = ToolRunner(Locate("mlir-translate")).Execute(translation)
	translated.HasFailed then "mlir-translate failed: " + translated.error else ""
Quote(path Text) Text
	OnWindows.Quote("a b") is "\"a b\""
	"\"" + path + "\""
