has tools Toolchain
constant Missing = WebBuild(Toolchain(Toolchain.OnWindows, isWeb = true))
constant Options = " -sALLOW_MEMORY_GROWTH -sMAXIMUM_MEMORY=4GB -sINITIAL_MEMORY=64MB -sSTACK_SIZE=16MB -sASYNCIFY -sASYNCIFY_STACK_SIZE=1048576 -sEXPORTED_RUNTIME_METHODS=callMain --closure 1 -g0 -Wl,--fatal-warnings -Wno-override-module"
constant OneCallerInlining = " --one-caller-inline-max-function-size=1000"
constant Features = " --enable-bulk-memory --enable-sign-ext --enable-nontrapping-float-to-int --enable-mutable-globals"
constant Passes = " --strip-debug --strip-producers --skip-pass=coalesce-locals" + OneCallerInlining + Features
constant Target = " -target wasm32-unknown-emscripten -fignore-exceptions -Wno-override-module"
constant Lowering = " -mllvm -combiner-global-alias-analysis=false -mllvm -enable-emscripten-sjlj -mllvm -disable-lsr"
constant LinkLowering = " -Wl,-mllvm,-combiner-global-alias-analysis=false -Wl,-mllvm,-enable-emscripten-sjlj -Wl,-mllvm,-disable-lsr"
constant Thin = " -Wl,--lto-O2 -Wl,--thinlto-jobs=all" + LinkLowering + " -Wl,--thinlto-cache-policy=" + Toolchain.LtoCachePolicy
constant Sizes = ("malloc", "calloc", "realloc", "memcpy", "memset", "strlen", "strncmp", "strftime", "fread", "fwrite", "fseek", "ftell", "strtol", "snprintf")
Link(base Text, executable Text) Text
	Missing.Link("Compiler/output/missing", "missing.html").StartsWith("mlir-opt failed")
	compiled = Compile(base)
	if compiled is not ""
		return compiled
	folder = Release(base).Parent
	sources = NativeSources(tools.natives).Arguments(Platform.Web, tools.root) + Preload(folder + "/Content")
	page = " --shell-file " + tools.Quote(Shell(base))
	Release(base).Creat(Path(executable).PathOnly.text)
	inputs = tools.PartObjects(base + ".web") + sources + Mirror(folder, base) + Script(base) + page + Runtime
	output = " -o " + tools.Quote(executable) + Options + ThinLink(base) + " -O1"
	linked = ToolRunner(tools.Locate("emcc")).Execute(inputs + output)
	linked.HasFailed then "emcc failed: " + linked.error else Optimize(executable)
ThinLink(base Text) Text
	Options.IndexOf("--closure 1") >= 0 and Options.IndexOf("--profiling-funcs") is -1
	Missing.ThinLink("a").EndsWith(" -Wl,--thinlto-cache-dir=\"a.web.lto\"")
	Missing.ThinLink("a").StartsWith(Thin)
	Thin + " -Wl,--thinlto-cache-dir=" + tools.Quote(base + ".web.lto")
Compile(base Text) Text
	Missing.Compile("Compiler/output/missing").StartsWith("mlir-opt failed")
	if File(base + ".mlir").Exists is false
		return tools.Lower(base)
	lowered = MlirParts(MlirSplit(File(base + ".mlir").ReadLines)).Laid.Lower(base + ".web", tools)
	lowered is not "" then lowered else tools.PartsCompiled(base + ".web") then "" else "clang failed for " + base
Optimize(executable Text) Text
	Missing.Optimize("Compiler/output/missing.html").StartsWith("wasm-opt failed")
	wasm = tools.Quote(executable.Replace(".html", ".wasm"))
	optimizing = wasm + Toolchain.Optimization + Passes + " -o " + wasm
	optimized = ToolRunner(tools.Locate("wasm-opt")).Execute(optimizing)
	optimized.HasFailed then "wasm-opt failed: " + optimized.error else Icone(executable)
Icone(executable Text) Text
	page = Text.Combine(File(executable).ReadLines, "\n")
	source = executable.Replace("/Release/Web/", "/obj/").Replace(".html", "")
	own = Release(source).Icon is not TypeSource.Root + "/Strict.ico"
	File(executable).Write(Favicons(page, own then "favicon.ico" else "https://strict-lang.org/img/favicon.ico"))
	"Built " + executable
Favicons(page Text, icon Text) Text
	Missing.Favicons("<head></head>", "a.ico") is "<head><link rel=\"icon\" href=\"a.ico\"></head>"
	Missing.Favicons("<head><link rel=icon href=b.ico></head>", "a.ico") is "<head><link rel=icon href=b.ico></head>"
	Missing.Favicons("rel=icon</head>", "a.ico") is "rel=icon</head>"
	Missing.Favicons("rel=\"icon\"</head>", "a.ico") is "rel=\"icon\"</head>"
	linked = "rel=icon" is in page or "rel=\"icon\"" is in page
	linked then page else page.Replace("</head>", "<link rel=\"icon\" href=\"" + icon + "\"></head>")
Patch(mlir Text) Text
	WebBuild.Patch("  llvm.func @malloc(i64) -> !llvm.ptr\n  llvm.call @malloc(%b)") is "  llvm.call @strict_c_malloc(%b)"
	WebBuild.Patch("  llvm.func @free(!llvm.ptr)" + MlirParameters.ReadScope) is "  llvm.func @free(!llvm.ptr)"
	WebBuild.Patch("  a\n  b") is "  a\n  b"
	WebBuild.Patch(MlirEntry.CollectorStart.First).IndexOf("\"llvm.stacksave.p0\"()") > 0
	mutable kept = List(Mutable(Text))
	for mlir.Lines
		if Declare(value) is not in Sizes
			kept.Add(value.Replace(MlirParameters.ReadScope, "").Replace(MlirParameters.WriteScope, ""))
	mutable sized = Text.Combine(kept, "\n")
	for Sizes
		sized = sized.Replace("@" + value + "(", "@strict_c_" + value + "(")
	sized.Replace("\"llvm.addressofreturnaddress.p0\"()", "\"llvm.stacksave.p0\"()")
Declare(line Text) Text
	WebBuild.Declare("  llvm.func @malloc(i64) -> !llvm.ptr") is "malloc"
	WebBuild.Declare("    %a = llvm.call @malloc(%b)") is ""
	constant start = MlirGpu.FunctionStart
	line.StartsWith(start) then line.Substring(start.Length, line.IndexOf("(") - start.Length) else ""
Preload(content Text) Text
	Missing.Preload("Compiler/output/missing") is ""
	Missing.Preload("Compiler") is " --preload-file \"Compiler@/Content\""
	Release("Missing/App").Creat("Compiler/output/EmptyApp/Content/Inner") is not Error
	Missing.Preload("Compiler/output/EmptyApp/Content") is ""
	HasFiles(content) then " --preload-file \"" + content + "@/Content\"" else ""
HasFiles(folder Text) Boolean
	Missing.HasFiles("Compiler")
	Missing.HasFiles("Compiler/output/missing") is false
	if Directory.Exists(folder) is false
		return false
	if Directory.Files(folder).Length > 0
		return true
	for Directory.Directories(folder)
		if HasFiles(value)
			return true
	false
Mirror(folder Text, base Text) Text
	Missing.Mirror(".", "Compiler/output/missing") is ""
	Missing.Mirror("./Compiler", "Compiler/output/missing") is ""
	Missing.Mirror("./Compiler/output/EmptyApp", "Compiler/output/missing") is ""
	if folder is "." or HasFiles(folder + "/Content") is false
		return ""
	path = "/" + (folder.StartsWith("./") then folder.Substring(2) else folder)
	linked = "FS.symlink(\"/Content\", \"" + path + "/Content\")"
	File(base + ".pre.js").Write("(Module.preRun ||= []).push(() => { FS.mkdirTree(\"" + path + "\"); " + linked + " })")
	" --pre-js \"" + base + ".pre.js\""
BuildShaders(program Text, base Text, isWritten Boolean) Text
	WebBuild.BuildShaders("module {\n}", "Compiler/output/Unshaded", true) is "module {\n}"
	WebBuild.BuildShaders("module {\n}\n" + WgslShader.Marker + "\nx", "Compiler/output/Shaded", true) is "module {\n}"
	Missing.Script("Compiler/output/Shaded") is " --pre-js \"Compiler/output/Shaded.shaders.js\""
	marker = program.IndexOf("\n" + WgslShader.Marker + "\n")
	if marker < 0
		return program
	start = marker + WgslShader.Marker.Length + 2
	if isWritten
		File(base + ".shaders.js").Write(program.Substring(start, program.Length - start))
	program.Substring(0, marker)
Shell(base Text) Text
	Missing.Shell("Compiler/output/missing") is "C:/s/Compiler/WebShell.html"
	shell = BuildOutput.Deliver(base) + ".shell.html"
	File(shell).Exists then shell else tools.root + "/Compiler/WebShell.html"
Runtime Text
	Missing.Runtime is " --js-library \"C:/s/Compiler/WebRuntime.js\" --pre-js \"C:/s/Compiler/NativeRuntimeWgsl.js\""
	library = " --js-library " + tools.Quote(tools.root + "/Compiler/WebRuntime.js")
	library + " --pre-js " + tools.Quote(tools.root + "/Compiler/NativeRuntimeWgsl.js")
Script(base Text) Text
	Missing.Script("Compiler/output/missing") is ""
	File(base + ".shaders.js").Exists then " --pre-js \"" + base + ".shaders.js\"" else ""
InstallLines Texts
	Missing.InstallLines.First is "git clone --depth 1 https://github.com/emscripten-core/emsdk.git C:/s/Tools/emsdk"
	Missing.InstallLines(1) is "C:/s/Tools/emsdk/emsdk install latest"
	Missing.InstallLines.Last is "C:/s/Tools/emsdk/emsdk activate latest"
	folder = tools.root + "/Tools/emsdk"
	cloned = "git clone --depth 1 https://github.com/emscripten-core/emsdk.git " + folder
	(cloned, folder + "/emsdk install latest", folder + "/emsdk activate latest")