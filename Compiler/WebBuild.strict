has tools Toolchain
constant Missing = WebBuild(Toolchain(Toolchain.OnWindows, isWeb = true))
Linked(base Text, executable Text, level Text) Text
	Missing.Linked("Compiler/output/missing", "missing.html", "").StartsWith("mlir-opt failed")
	constant memory = " -sMEMORY64=2 -sALLOW_MEMORY_GROWTH -sMAXIMUM_MEMORY=4GB -sINITIAL_MEMORY=64MB -sSTACK_SIZE=16MB"
	constant options = memory + " -sASYNCIFY -sASYNCIFY_STACK_SIZE=1048576 -Wno-override-module -Wno-deprecated"
	let lowered = tools.Lowered(base)
	if lowered is not ""
		return lowered
	let sources = NativeSources(tools.natives).Arguments(Platform.Web, tools.root)
	let linking = tools.Quoted(base + ".ll") + sources + " -o " + tools.Quoted(executable) + options + level
	let linked = ToolRunner(tools.Located("emcc")).Execute(linking)
	linked.Failed then "emcc failed: " + linked.error else "Built " + executable
InstallLines Texts
	Missing.InstallLines.Last is "C:/s/Tools/emsdk/emsdk activate latest"
	let folder = tools.root + "/Tools/emsdk"
	let cloned = "git clone --depth 1 https://github.com/emscripten-core/emsdk.git " + folder
	(cloned, folder + "/emsdk install latest", folder + "/emsdk activate latest")