has tools Toolchain
constant Missing = WebBuild(Toolchain(Toolchain.OnWindows, isWeb = true))
constant Options = " -sALLOW_MEMORY_GROWTH -sMAXIMUM_MEMORY=4GB -sINITIAL_MEMORY=64MB -sSTACK_SIZE=16MB -sASYNCIFY -sASYNCIFY_STACK_SIZE=1048576 -sEXPORTED_RUNTIME_METHODS=callMain --closure 1 -g0 -Wl,--fatal-warnings -Wno-override-module"
constant OneCallerInlining = " --one-caller-inline-max-function-size=1000"
constant Features = " --enable-bulk-memory --enable-sign-ext --enable-nontrapping-float-to-int --enable-mutable-globals"
constant Passes = " --strip-debug --strip-producers --skip-pass=coalesce-locals" + OneCallerInlining + Features
constant Sizes = ("malloc", "calloc", "realloc", "memcpy", "memset", "strlen", "strncmp", "strftime", "fread", "fwrite", "fseek", "ftell", "strtol", "snprintf")
Linked(base Text, executable Text) Text
	(Options.IndexOf("--closure 1") >= 0) and (Options.IndexOf("--profiling-funcs") is -1)
	Missing.Linked("Compiler/output/missing", "missing.html").StartsWith("mlir-opt failed")
	let compiled = Compiled(base)
	if compiled is not ""
		return compiled
	let folder = Release(Logger, base).Parent
	let sources = NativeSources(tools.natives).Arguments(Platform.Web, tools.root) + Preloaded(folder + "/Content")
	let page = " --shell-file " + tools.Quoted(Shell(base))
	Release(Logger, base).Created(Path(executable).PathOnly.text)
	let inputs = tools.Quoted(base + ".o") + sources + Mirrored(folder, base) + Scripted(base) + page + Runtime
	let linked = ToolRunner(tools.Located("emcc")).Execute(inputs + " -o " + tools.Quoted(executable) + Options + " -O1")
	linked.Failed then "emcc failed: " + linked.error else Optimized(executable)
Compiled(base Text) Text
	Missing.Compiled("Compiler/output/missing").StartsWith("mlir-opt failed")
	let lowered = tools.Lowered(base)
	if lowered is not ""
		return lowered
	let output = " -o " + tools.Quoted(base + ".o") + " -Wno-override-module" + Toolchain.Optimization
	let compiled = ToolRunner(tools.Located("emcc")).Execute("-c " + tools.Quoted(base + ".ll") + output)
	compiled.Failed then "emcc failed: " + compiled.error else ""
Optimized(executable Text) Text
	Missing.Optimized("Compiler/output/missing.html").StartsWith("wasm-opt failed")
	let wasm = tools.Quoted(executable.Replace(".html", ".wasm"))
	let optimizing = wasm + Toolchain.Optimization + Passes + " -o " + wasm
	let optimized = ToolRunner(tools.Located("wasm-opt")).Execute(optimizing)
	optimized.Failed then "wasm-opt failed: " + optimized.error else Iconed(executable)
Iconed(executable Text) Text
	let page = Text.Combine(File(executable).ReadLines, "\n")
	let source = executable.Replace("/Release/Web/", "/obj/").Replace(".html", "")
	let own = Release(Logger, source).Icon is not TypeSource.Root + "/Strict.ico"
	File(executable).Write(Favicons(page, own then "favicon.ico" else "https://strict-lang.org/img/favicon.ico"))
	"Built " + executable
Favicons(page Text, icon Text) Text
	Missing.Favicons("<head></head>", "a.ico") is "<head><link rel=\"icon\" href=\"a.ico\"></head>"
	Missing.Favicons("<head><link rel=icon href=b.ico></head>", "a.ico") is "<head><link rel=icon href=b.ico></head>"
	let linked = (page.IndexOf("rel=icon") >= 0) or (page.IndexOf("rel=\"icon\"") >= 0)
	linked then page else page.Replace("</head>", "<link rel=\"icon\" href=\"" + icon + "\"></head>")
Sized(mlir Text) Text
	WebBuild.Sized("  llvm.func @malloc(i64) -> !llvm.ptr\n  llvm.call @malloc(%b)") is "  llvm.call @strict_c_malloc(%b)"
	WebBuild.Sized("  llvm.func @free(!llvm.ptr)" + MlirParameters.ReadScope) is "  llvm.func @free(!llvm.ptr)"
	WebBuild.Sized(MlirEntry.CollectorStart.First).IndexOf("\"llvm.stacksave.p0\"()") > 0
	mutable kept = List(Mutable(Text))
	for mlir.Lines
		if Declared(value) is not in Sizes
			kept.Add(value.Replace(MlirParameters.ReadScope, "").Replace(MlirParameters.WriteScope, ""))
	mutable sized = Text.Combine(kept, "\n")
	for Sizes
		sized = sized.Replace("@" + value + "(", "@strict_c_" + value + "(")
	sized.Replace("\"llvm.addressofreturnaddress.p0\"()", "\"llvm.stacksave.p0\"()")
Declared(line Text) Text
	WebBuild.Declared("  llvm.func @malloc(i64) -> !llvm.ptr") is "malloc"
	WebBuild.Declared("    %a = llvm.call @malloc(%b)") is ""
	constant start = MlirGpu.FunctionStart
	line.StartsWith(start) then line.Substring(start.Length, line.IndexOf("(") - start.Length) else ""
Preloaded(content Text) Text
	Missing.Preloaded("Compiler/output/missing") is ""
	Missing.Preloaded("Compiler") is " --preload-file \"Compiler@/Content\""
	Release(Logger, "Missing/App").Created("Compiler/output/EmptyApp/Content/Inner")
	Missing.Preloaded("Compiler/output/EmptyApp/Content") is ""
	HasFiles(content) then " --preload-file \"" + content + "@/Content\"" else ""
HasFiles(folder Text) Boolean
	Missing.HasFiles("Compiler")
	Missing.HasFiles("Compiler/output/missing") is false
	if Directory.Exists(folder) is false
		return false
	if Directory.Files(folder).Length > 0
		return true
	for Directory.Directories(folder)
		if HasFiles(value)
			return true
	false
Mirrored(folder Text, base Text) Text
	Missing.Mirrored(".", "Compiler/output/missing") is ""
	Missing.Mirrored("./Compiler", "Compiler/output/missing") is ""
	Missing.Mirrored("./Compiler/output/EmptyApp", "Compiler/output/missing") is ""
	if (folder is ".") or (HasFiles(folder + "/Content") is false)
		return ""
	let path = "/" + (folder.StartsWith("./") then folder.Substring(2, folder.Length - 2) else folder)
	let linked = "FS.symlink(\"/Content\", \"" + path + "/Content\")"
	File(base + ".pre.js").Write("(Module.preRun ||= []).push(() => { FS.mkdirTree(\"" + path + "\"); " + linked + " })")
	" --pre-js \"" + base + ".pre.js\""
Shaded(program Text, base Text, isWritten Boolean) Text
	WebBuild.Shaded("module {\n}", "Compiler/output/Unshaded", true) is "module {\n}"
	WebBuild.Shaded("module {\n}\n" + WgslShader.Marker + "\nx", "Compiler/output/Shaded", true) is "module {\n}"
	Missing.Scripted("Compiler/output/Shaded") is " --pre-js \"Compiler/output/Shaded.shaders.js\""
	let marker = program.IndexOf("\n" + WgslShader.Marker + "\n")
	if marker < 0
		return program
	let start = marker + WgslShader.Marker.Length + 2
	if isWritten
		File(base + ".shaders.js").Write(program.Substring(start, program.Length - start))
	program.Substring(0, marker)
Shell(base Text) Text
	Missing.Shell("Compiler/output/missing") is "C:/s/Compiler/WebShell.html"
	let shell = BuildOutput.Delivered(base) + ".shell.html"
	File(shell).Exists then shell else tools.root + "/Compiler/WebShell.html"
Runtime Text
	Missing.Runtime is " --js-library \"C:/s/Compiler/WebRuntime.js\" --pre-js \"C:/s/Compiler/NativeRuntimeWgsl.js\""
	let library = " --js-library " + tools.Quoted(tools.root + "/Compiler/WebRuntime.js")
	library + " --pre-js " + tools.Quoted(tools.root + "/Compiler/NativeRuntimeWgsl.js")
Scripted(base Text) Text
	Missing.Scripted("Compiler/output/missing") is ""
	File(base + ".shaders.js").Exists then " --pre-js \"" + base + ".shaders.js\"" else ""
InstallLines Texts
	Missing.InstallLines.Last is "C:/s/Tools/emsdk/emsdk activate latest"
	let folder = tools.root + "/Tools/emsdk"
	let cloned = "git clone --depth 1 https://github.com/emscripten-core/emsdk.git " + folder
	(cloned, folder + "/emsdk install latest", folder + "/emsdk activate latest")