has tools Toolchain
constant Missing = WebBuild(Toolchain(Toolchain.OnWindows, isWeb = true))
constant Options = " -sALLOW_MEMORY_GROWTH -sMAXIMUM_MEMORY=4GB -sINITIAL_MEMORY=64MB -sSTACK_SIZE=16MB -sASYNCIFY -sASYNCIFY_STACK_SIZE=1048576 -sEXPORTED_RUNTIME_METHODS=callMain -Wl,--fatal-warnings -Wno-override-module"
constant Sizes = ("malloc", "calloc", "realloc", "memcpy", "memset", "strlen", "strncmp", "strftime", "fread", "fwrite", "fseek", "ftell", "strtol", "snprintf")
Linked(base Text, executable Text, level Text) Text
	Missing.Linked("Compiler/output/missing", "missing.html", "").StartsWith("mlir-opt failed")
	let lowered = tools.Lowered(base)
	if lowered is not ""
		return lowered
	let sources = NativeSources(tools.natives).Arguments(Platform.Web, tools.root)
	let content = Preloaded(Release(Logger, base).Parent + "/Content")
	let page = " --shell-file " + tools.Quoted(tools.root + "/Compiler/WebShell.html")
	let inputs = tools.Quoted(base + ".ll") + sources + content + page
	let linking = inputs + " -o " + tools.Quoted(executable) + Options + level
	let linked = ToolRunner(tools.Located("emcc")).Execute(linking)
	linked.Failed then "emcc failed: " + linked.error else "Built " + executable
Sized(mlir Text) Text
	WebBuild.Sized("  llvm.func @malloc(i64) -> !llvm.ptr\n  llvm.call @malloc(%b)") is "  llvm.call @strict_c_malloc(%b)"
	WebBuild.Sized("  llvm.func @free(!llvm.ptr)") is "  llvm.func @free(!llvm.ptr)"
	mutable kept = List(Mutable(Text))
	for mlir.Lines
		if Declared(value) is not in Sizes
			kept.Add(value)
	mutable sized = Text.Combine(kept, "\n")
	for Sizes
		sized = sized.Replace("@" + value + "(", "@strict_c_" + value + "(")
	sized
Declared(line Text) Text
	WebBuild.Declared("  llvm.func @malloc(i64) -> !llvm.ptr") is "malloc"
	WebBuild.Declared("    %a = llvm.call @malloc(%b)") is ""
	line.StartsWith("  llvm.func @") then line.Substring(13, line.IndexOf("(") - 13) else ""
Preloaded(content Text) Text
	Missing.Preloaded("Compiler/output/missing") is ""
	Missing.Preloaded("Compiler") is " --preload-file \"Compiler@/Content\""
	Directory.Exists(content) then " --preload-file \"" + content + "@/Content\"" else ""
InstallLines Texts
	Missing.InstallLines.Last is "C:/s/Tools/emsdk/emsdk activate latest"
	let folder = tools.root + "/Tools/emsdk"
	let cloned = "git clone --depth 1 https://github.com/emscripten-core/emsdk.git " + folder
	(cloned, folder + "/emsdk install latest", folder + "/emsdk activate latest")