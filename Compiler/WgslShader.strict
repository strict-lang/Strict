has function MlirFunction
has position Number
constant Lines = ("has scale Number with value.Bits is 32", "Scaled(count Number) Numbers", "\tfor count", "\t\tindex * scale")
constant Scaling = TypeCodegen("Strict/Scaling", Lines, ValueCodegen.NoTypes, List(Text)).Entry
constant Scaled = WgslShader(MlirFunction(List(TypeEntry) + Scaling, Scaling, Scaling.methods.First), 2)
constant Doubling = WgslShader(MlirParallel.Doubling.function, 2)
constant Halving = TypeCodegen("Strict/Halving", ("has numbers Numbers", "Halved BFloat16s", "\tfor numbers", "\t\tvalue / 2"), ValueCodegen.NoTypes, List(Text)).Entry
constant Halved = WgslShader(MlirFunction(List(TypeEntry) + Halving, Halving, Halving.methods.First), 2)
constant Marker = "// web shaders"
constant Bindings = ("@group(0) @binding(0) var<storage, read_write> output: array<f32>;", "@group(0) @binding(1) var<storage, read> numbers: array<f32>;", "@group(0) @binding(2) var<storage, read> places: array<u32>;", "@group(0) @binding(3) var<storage, read_write> failed: array<u32>;")
constant Numbers = ("struct num { f: f32, i: i32, w: bool, d: bool }", "fn n_float(f: f32) -> num { return num(f, 0, false, false); }", "fn n_int(i: i32) -> num { return num(f32(i), i, true, true); }", "fn n_of(f: f32) -> num { let w = fract(f) == 0.0 && abs(f) < 16777216.0; return num(f, i32(f), w, w); }", "fn n_add(a: num, b: num) -> num { if (a.w && b.w) { return n_int(a.i + b.i); } return n_float(a.f + b.f); }", "fn n_sub(a: num, b: num) -> num { if (a.w && b.w) { return n_int(a.i - b.i); } return n_float(a.f - b.f); }", "fn n_mul(a: num, b: num) -> num { if (a.w && b.w) { return n_int(a.i * b.i); } return n_float(a.f * b.f); }", "fn n_mod(a: num, b: num) -> num { if (a.w && b.w && b.i != 0) { return n_int(a.i % b.i); } return n_float(a.f % b.f); }", "fn n_div(a: num, b: num) -> num {", "if (!(a.w && b.w && b.i != 0)) { return n_float(a.f / b.f); }", "let q = a.i / b.i;", "let r = a.i % b.i;", "if (r == 0) { return n_int(q); }", "return num(a.f / b.f, select(q, q - 1, (r < 0) != (b.i < 0)), false, true);", "}", "fn n_floor(a: num) -> num { if (a.d) { return n_int(a.i); } return n_of(floor(a.f)); }", "fn n_index(a: num) -> u32 { return select(u32(max(a.f, 0.0)), u32(max(a.i, 0)), a.w); }", "fn n_equal(a: num, b: num) -> bool { if (a.w && b.w) { return a.i == b.i; } return a.f == b.f; }", "fn n_unequal(a: num, b: num) -> bool { return !n_equal(a, b); }", "fn n_less(a: num, b: num) -> bool { if (a.w && b.w) { return a.i < b.i; } return a.f < b.f; }", "fn n_more(a: num, b: num) -> bool { if (a.w && b.w) { return a.i > b.i; } return a.f > b.f; }", "fn n_power(base: num, exponent: num) -> num {", "let size = pow(abs(base.f), exponent.f);", "let isOdd = abs(exponent.f % 2.0) == 1.0;", "return n_float(select(select(size, -size, base.f < 0.0 && isOdd), 1.0, exponent.f == 0.0));", "}")
constant Entry = ("@compute @workgroup_size(64)", "fn main(@builtin(global_invocation_id) id: vec3<u32>, @builtin(num_workgroups) groups: vec3<u32>) {", "let at = id.x + id.y * groups.x * 64u;")
Source Text
	Scaled.Source.StartsWith(Bindings.First)
	Scaled.Source.IndexOf("struct num {") > 0
	Doubling.Source.StartsWith(Bindings.First)
	if IsShaded is false
		return ""
	let lines = Bindings + Numbers + Globals + Functions + Main
	for lines
		if value.StartsWith("unsupported")
			return ""
	Text.Combine(lines, "\n")
IsShaded Boolean
	Scaled.IsShaded
	Doubling.IsShaded
	WgslShader(MlirGpu.Randomizing.function, 2).IsShaded is false
	Halved.IsShaded
	let collection = MlirLoops(function, position).Collection
	let isFloats = MlirDoubles(function, position).Format is in (0, 17, 32)
	let isKernel = MlirWholeKernel(function, position).IsKernel
	(collection is in ("", "List(Number)")) and isFloats and (isKernel is false) and MlirGpuCheck(function, position).IsGpu
Functions Texts
	Doubling.Functions.First is "fn s_Rows_Twice_1(instance: num, p0: num) -> num {"
	mutable symbols = List(Text)
	mutable lines = List(Text)
	for MlirGpu.Devices(function, position + 1, function.method.LoopEndOf(position), 0)
		if (value.Symbol is not in symbols) and (value.method.Name is not in ("Floor", "Length"))
			symbols = symbols + value.Symbol
			lines = lines + WgslFunction(value).Lines
	lines
Main Texts
	Scaled.Main.First is "@compute @workgroup_size(64)"
	"if (at >= places[4]) { return; }" is in Scaled.Main
	"output[at] = r3.f;" is in Scaled.Main
	let count = "if (at >= places[" + (MlirGpuCheck(function, position).Free.Length + 1) * 2 + "]) { return; }"
	let body = WgslFunction(function).Statements(position + 1, function.method.LoopEndOf(position))
	(Entry + count + WgslFunction(function).Declarations + Loaded + Started + body) + "}"
Loaded Texts
	Scaled.Loaded is ("m_scale = numbers[places[0]];", "v_scale = n_of(m_scale);")
	mutable lines = List(Text)
	for MlirGpuCheck(function, position).Free
		let place = "places[" + index * 2 + "]"
		let pair = "l = vec2<u32>(" + place + ", places[" + (index * 2 + 1) + "]);"
		let suffix = MlirDevice(function, position).IsList(value) then "l" else ""
		let loaded = "m_" + value + (suffix is "l" then pair else " = numbers[" + place + "];")
		let converted = suffix is "l" then "m_" + value + "l" else "n_of(m_" + value + ")"
		lines = lines + loaded + ("v_" + value + suffix + " = " + converted + ";")
	lines
Globals Texts
	WgslShader(MlirGpuCheck.Heading.function, 2).Globals.Last is "var<private> m_weightsl: vec2<u32>;"
	mutable lines = List(Text)
	for MlirGpuCheck(function, position).Free
		lines = lines + ("var<private> m_" + value + ": f32;") + ("var<private> m_" + value + "l: vec2<u32>;")
	lines
Started Texts
	Scaled.Started is ("v_index = n_int(i32(at));", "v_value = n_int(i32(at));")
	Doubling.Started.Last is "v_value = n_of(n_item(places[0], at));"
	let source = "places[" + MlirGpuCheck(function, position).Free.Length * 2 + "]"
	let isCounted = MlirLoops(function, position).Collection is ""
	let item = isCounted then "n_int(i32(at))" else "n_of(n_item(" + source + ", at))"
	("v_index = n_int(i32(at));", "v_value = " + item + ";")
Scripts(functions List(MlirFunction)) Text
	WgslShader.Scripts(List(MlirFunction) + Scaled.function).StartsWith(Marker + "\n;(Module[\"strictShaders\"] ||= {})")
	WgslShader.Scripts(List(MlirFunction) + Doubling.function).IndexOf("Rows_Doubled_1_gpu2s") > 0
	WgslShader.Scripts(List(MlirFunction) + MlirGpu.Randomizing.function) is ""
	WgslShader.Scripts(List(MlirFunction) + Halved.function).IndexOf("Halving_Halved_") > 0
	mutable lines = List(Text)
	for functions
		lines = lines + Shaded(value)
	lines = lines - ""
	lines.Length is 0 then "" else Marker + "\n" + Text.Combine(lines, "\n")
Shaded(inspected MlirFunction) Texts
	WgslShader.Shaded(Scaled.function).First.IndexOf("[\"Scaling_Scaled_1_gpu2s\"] = \"@group(0)") > 0
	WgslShader.Shaded(Scaled.function).First.EndsWith("strictSingles\"] ||= {})[\"Scaling_Scaled_1_gpu2s\"] = [0];")
	for inspected.method.instructions
		if value.kind is InstructionType.LoopBegin
			let shader = WgslShader(inspected, index)
			let source = shader.Source.Replace("\n", "\\n")
			let name = "[\"" + MlirDevice(inspected, index).Name + "s\"] = "
			let singles = " (Module[\"strictSingles\"] ||= {})" + name + shader.Singles + ";"
			source is "" then "" else ";(Module[\"strictShaders\"] ||= {})" + name + "\"" + source + "\";" + singles
Singles Text
	Scaled.Singles is "[0]"
	Doubling.Singles is "[]"
	let free = MlirGpuCheck(function, position).Free
	mutable singles = List(Text)
	for function.type.members
		if (value.Bits is 32) and (value.Name is in free)
			singles = singles + (free.Index(value.Name) to Text)
	"[" + Text.Combine(singles, ", ") + "]"
