has bytes Numbers
Stored Numbers
	Deflate((1, 2, 3)).Stored is (120, 1, 1, 3, 0, 252, 255, 1, 2, 3, 0, 13, 0, 7)
	Inflate(Inflate.Part(Deflate((104, 105)).Stored, 2, 7)).Inflated is (104, 105)
	mutable result = List(Number) + 120 + 1
	for Range(0, (bytes.Length / 65535).Ceiling.Clamp(1, bytes.Length + 1))
		result = result + Block(value)
	result + Adler
Block(number Number) Numbers
	Deflate((1, 2, 3)).Block(0) is (1, 3, 0, 252, 255, 1, 2, 3)
	let start = number * 65535
	let size = (bytes.Length - start).Clamp(0, 65535)
	let final = start + size >= bytes.Length then 1 else 0
	let header = (final, size % 256, (size / 256).Floor, (65535 - size) % 256, ((65535 - size) / 256).Floor)
	header + Inflate.Part(bytes, start, size)
Adler Numbers
	Deflate((1, 2, 3)).Adler is (0, 13, 0, 7)
	mutable low = 1
	mutable high = 0
	for bytes
		low = (low + value) % 65521
		high = (high + low) % 65521
	((high / 256).Floor, high % 256, (low / 256).Floor, low % 256)
