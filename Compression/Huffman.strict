has counts Numbers
has symbols Numbers
constant Sample = Huffman.From((2, 1, 3, 3))
From(lengths Numbers) Huffman
	Huffman.From((2, 1, 3, 3)).symbols is (1, 0, 2, 3)
	Huffman(Counts(lengths), Sorted(lengths))
Counts(lengths Numbers) Numbers
	Sample.Counts((2, 1, 3, 3)).Length is 16
	Sample.Counts((2, 1, 3, 3)).Sum is 4
	for 16
		index is 0 then 0 else lengths.Count(index)
Sorted(lengths Numbers) Numbers
	Sample.Sorted((2, 1, 3, 3)) is (1, 0, 2, 3)
	Sample.Sorted((0, 2, 0, 1)) is (3, 1)
	mutable sorted = List(Mutable(Number))
	for Range(1, 16)
		sorted = sorted + WithLength(lengths, value)
	sorted
WithLength(lengths Numbers, length Number) Numbers
	Sample.WithLength((2, 1, 2), 2) is (0, 2)
	for lengths
		if value is length
			index
Decoded(stream Inflate, position Number) Symbol
	Sample.Decoded(Inflate(List(Number) + 6), 1) is Symbol(2, 3)
	mutable code = 0
	mutable first = 0
	mutable offset = 0
	for Range(1, 16)
		code = code * 2 + stream.Bit(position + value - 1)
		first = (first + counts(value - 1)) * 2
		offset = offset + counts(value - 1)
		if code - counts(value) < first
			return Symbol(symbols(offset + code - first), value)
	Symbol(-1, 0)
