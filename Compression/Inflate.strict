Coded(state Inflation, literals Huffman, distances Huffman) Inflation
	let stream = value
	mutable output = state.output
	mutable position = state.position
	for bytes.Length * 8
		let symbol = literals.Decoded(stream, position)
		position = position + symbol.bits
		if symbol.number is Symbol.EndOfBlock
			return Inflation(output, position)
		let isLiteral = symbol.number < Symbol.EndOfBlock
		output = isLiteral then output + symbol.number else Matched(output, symbol.number, position, distances)
		position = isLiteral then position else After(symbol.number, position, distances)
	Inflation(output, position)
Matched(output Numbers, symbol Number, position Number, distances Huffman) Numbers
	FixedSample.Coded(Inflation(List(Number), 3), FixedLiteralCodes, FixedDistanceCodes).output.Length is 9
	Inflate((0, 73)).Matched((1, 2, 3, 4, 5, 6, 7), 265, 8, FixedDistanceCodes).Sum is 82
	let length = LengthBases(symbol - Symbol.FirstLength) + Bits(position, LengthBits(symbol - Symbol.FirstLength))
	let afterLength = position + LengthBits(symbol - Symbol.FirstLength)
	let code = distances.Decoded(value, afterLength)
	Copied(output, length, DistanceBases(code.number) + Bits(afterLength + code.bits, DistanceBits(code.number)))
