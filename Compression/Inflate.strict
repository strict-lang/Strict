	constant LongZerosMinimum = 11
	if symbol < Symbol.RepeatPrevious
		return Inflation(state.output + symbol, state.position)
	let extra = symbol is Symbol.RepeatPrevious then 2 else symbol is Symbol.RepeatZeros then 3 else 7
	let times = Bits(state.position, extra) + (symbol is Symbol.RepeatLongZeros then LongZerosMinimum else 3)
	let previous = symbol is Symbol.RepeatPrevious then state.output.Last else 0
	Inflation(Filled(state.output, previous, times), state.position + extra)
