	StoredSample.Lengths(Inflation((1, 2), 0), Huffman.Sample, 4).output is (1, 2, 0, 1)
	StoredSample.Lengths(Inflation((1, 2), 0), Huffman.Sample, 4).position is 3
	mutable current = state
	for count
		if current.output.Length >= count
			return current
