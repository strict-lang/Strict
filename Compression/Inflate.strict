	let at = (position / 8).Floor
	let middle = at + 1 < bytes.Length then bytes(at + 1) else 0
	let high = at + 2 < bytes.Length then bytes(at + 2) else 0
	((bytes(at) + (middle + high * Byte.Values) * Byte.Values) / Powers(position % 8)).Floor % 2 ^ count
