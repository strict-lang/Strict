Dynamic(state Inflation) Inflation
	DynamicSample.Dynamic(Inflation(List(Number), 3)).output is DynamicText
	constant HeaderBits = 14
	let literalCount = Bits(state.position, 5) + Symbol.FirstLength
	let distanceCount = Bits(state.position + 5, 5) + 1
	let codeCount = Bits(state.position + 10, 4) + 4
	let codes = Huffman.From(CodeLengths(state.position + HeaderBits, codeCount))
	let start = state.position + HeaderBits + codeCount * 3
	let lengths = Lengths(Inflation(List(Number), start), codes, literalCount + distanceCount)
	let literals = Huffman.From(Part(lengths.output, 0, literalCount))
	let distances = Huffman.From(Part(lengths.output, literalCount, distanceCount))
	Coded(Inflation(state.output, lengths.position), literals, distances)
