from(text)
GetFiles Texts slow
Directories(path) Texts slow
Exists(path) Boolean slow
Current Text
Files(path, pattern = "") Texts slow
ReadModified(path) Number slow
Create(path) slow
Change(path) slow
Delete(path Text) slow
	Directory.Delete("Missing/Deleted") is not Error
	isWindows = Process.OperatingSystem is "Windows"
	command = isWindows then "/c rd /s /q \"" + path.Replace("/", "\\") + "\"" else "-rf \"" + path + "\""
	if Process.RunTool(isWindows then "cmd" else "rm", command).exitCode < 0 or Exists(path)
		return Error("DirectoryNotDeleted: " + path)
Temporary Text
	Directory.Exists(Directory.Temporary)
	Directory.Temporary.EndsWith("/") is false
	windows = Process.Variable("TEMP").Replace("\\", "/")
	other = Process.Variable("TMPDIR")
	folder = windows is not "" then windows else (other is not "" then other else "/tmp")
	folder.Length > 1 and folder.EndsWith("/") then folder.Substring(0, folder.Length - 1) else folder
