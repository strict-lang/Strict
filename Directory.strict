from(text)
GetFiles Texts
Directories(path) Texts
Exists(path) Boolean
Current Text
Files(path, pattern = "") Texts
Modified(path) Number
Create(path)
Change(path)
Delete(path Text)
	Directory.Delete("Missing/Deleted") is not Error
	let isWindows = Process.OperatingSystem is "Windows"
	let command = isWindows then "/c rd /s /q \"" + path.Replace("/", "\\") + "\"" else "-rf \"" + path + "\""
	if (Process.RunTool(isWindows then "cmd" else "rm", command).exitCode < 0) or Exists(path)
		return Error("DirectoryNotDeleted")
