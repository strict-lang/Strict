has Name
has Stacktraces
to Text
	(Error("Missing") to Text).StartsWith("Error: Missing\n\tat Error.") is true
	Error("Missing").Stacktraces(0).Line is 5
	mutable text = "Error: " + Name
	for Stacktraces
		text = text + "\n" + value to Text
	text
Code Text
	Error("Missing").Code is "Error(\"Missing\")"
	"Error(" + (Name to Text).Code + ")"
