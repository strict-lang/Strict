has Size
has logger
Area Number
	AreaCalculator(Size(3, 4)).Area is 12
	AreaCalculator(Size(10, 5)).Area is 50
	Size.Area
Perimeter Number
	AreaCalculator(Size(3, 4)).Perimeter is 14
	AreaCalculator(Size(10, 5)).Perimeter is 30
	Size.Width + Size.Width + Size.Height + Size.Height
Run
	constant rect = AreaCalculator(Size(5, 10))
	logger.Log("Area: " + rect.Area)
	logger.Log("Perimeter: " + rect.Perimeter)