Copy(times Number) Number slow
	LargeCollections.Copy(2) is 2 * 67108865
	constant Doublings = 25
	large = Double("ab", Doublings)
	mutable length = 0
	for times
		length = length + (large + "!").Length
	length
Double(text Text, times Number) Text
	LargeCollections.Double("ab", 2) is "abababab"
	mutable doubled = text
	for times
		doubled = doubled + doubled
	doubled
Run
	constant Copies = 1100
	logger.Log(Copy(Copies) to Text)
