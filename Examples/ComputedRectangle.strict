has Width Number
has Height Number
Area = Width * Height
Doubled(factor = 2) = Area * factor
IsSquare = Width is Height
Scaled(factor Number) Number
	ComputedRectangle(2, 3).Scaled(2) is 24
	ComputedRectangle(2, 3).IsSquare is false
	ComputedRectangle(2, 2).IsSquare is true
	ComputedRectangle(2, 3).Doubled is 12
	Doubled(factor) * 2
