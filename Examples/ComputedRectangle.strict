has Size
Area = Size.Area
Double(factor = 2) = Area * factor
IsSquare = Width is Height
Scale(factor Number) Number
	ComputedRectangle(Size(2, 3)).Scale(2) is 24
	ComputedRectangle(Size(2, 3)).IsSquare is false
	ComputedRectangle(Size(2, 2)).IsSquare
	ComputedRectangle(Size(2, 3)).Double is 12
	Double(factor) * 2
Widened(extra Number) ComputedRectangle
	ComputedRectangle(Size(2, 3)).Widened(1) is ComputedRectangle(Size(3, 3))
	ComputedRectangle(Size(Width + extra, Height))