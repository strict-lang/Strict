has Size
Area = Size.Area
Doubled(factor = 2) = Area * factor
IsSquare = Size.Width is Size.Height
Scaled(factor Number) Number
	ComputedRectangle(Size(2, 3)).Scaled(2) is 24
	ComputedRectangle(Size(2, 3)).IsSquare is false
	ComputedRectangle(Size(2, 2)).IsSquare
	ComputedRectangle(Size(2, 3)).Doubled is 12
	Doubled(factor) * 2
Widened(extra Number) ComputedRectangle
	ComputedRectangle(Size(2, 3)).Widened(1) is ComputedRectangle(Size(3, 3))
	ComputedRectangle(Size(Size.Width + extra, Size.Height))