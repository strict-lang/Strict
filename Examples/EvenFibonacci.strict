has number
Sum Number
	EvenFibonacci(100).Sum is 44 and EvenFibonacci(8).Sum is 2
	mutable first = 1
	mutable second = 2
	mutable total = 0
	for Range(1, number)
		if second >= number
			return total
		total = AddIfEven(total, second)
		second = first + second
		first = second - first
	total
AddIfEven(current Number, next Number) Number
	EvenFibonacci(100).AddIfEven(2, 4) is 6
	EvenFibonacci(100).AddIfEven(2, 3) is 2
	if next % 2 is 0
		current + next
	else
		current