has firstBank RegisterBank
has secondBank RegisterBank
Add RegisterBank
	ExecuteOperation(RegisterBank(1, 0, 0), RegisterBank(2, 0, 0)).Add is RegisterBank(3, 0, 0)
	firstBank + secondBank
Subtract RegisterBank
	ExecuteOperation(RegisterBank(3, 0, 0), RegisterBank(1, 0, 0)).Subtract is RegisterBank(2, 0, 0)
	firstBank - secondBank