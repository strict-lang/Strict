has number
Score(model Generic) Number
	GenericParameter(1).Score(Size(2, 3)) is 6
	GenericParameter(2).Score(Size(2, 3)) is 12
	model.Area * number
Score(model Generic, scale Number) Number
	GenericParameter(1).Score(Size(2, 3), 2) is 12
	model.Area * scale
Score(scale Number, model Generic) Number
	GenericParameter(1).Score(3, Size(2, 3)) is 18
	model.Area * scale
Score(model Generic, suffix Text) Number
	GenericParameter(1).Score(Size(2, 3), "abc") is 9
	model.Area + suffix.Length
