Append(count Number) Text
	Growing.Append(0) is ""
	Growing.Append(3) is "0, 1, 2, "
	Growing.Append(400).Length is 1890
	mutable text = ""
	for count
		text = text + index + ", "
	text
Share(piece Text) Texts
	Growing.Share("b") is ("ab", "abb", "abbb")
	Growing.Share("") is ("a", "a", "a")
	mutable text = "a"
	mutable kept = List(Text)
	for 3
		text = text + piece
		kept = kept + text
	kept
Twice(piece Text) Text
	Growing.Twice("ab") is "abab, abab"
	mutable text = ""
	text = text + piece
	text = text + text
	text + ", " + text
Extend(start Numbers, count Number) Numbers
	Growing.Extend((7, 8), 2) is (7, 8, 0, 1)
	Growing.Extend(List(Number), 0).Length is 0
	mutable raw = start
	for count
		raw = raw + index
	raw
SumLengths(start Numbers) Number
	Growing.SumLengths((1, 2, 3)) is 10
	Extend(start, 4).Length + start.Length
Both(start Numbers) Numbers
	Growing.Both((1, 2, 3)) is (1, 2, 3, 0, 1, 2, 3, 0, 1)
	Extend(start, 1) + Extend(start, 2)
