has label Text = "Names"
has names Texts = ("a", "b")
constant Short = Labeled("Short")
Described Text
	Labeled.Described is "Names a b"
	Labeled("Letters").Described is "Letters a b"
	label + " " + names.First + " " + names.Last
Prefix(separator = ": ") Text
	Labeled.Prefix is "Names: a"
	Labeled.Prefix(" - ") is "Names - a"
	label + separator + names.First
Combine(other = Short) Text
	Labeled.Combine is "Names Short"
	Labeled.Combine(Labeled("Long")) is "Names Long"
	label + " " + other.label
