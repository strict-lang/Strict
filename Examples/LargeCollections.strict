has logger
Copied(times Number) Slow(Number)
	LargeCollections.Copied(2) is 2 * 67108865
	let large = Doubled("ab", 25)
	mutable length = 0
	for times
		length = length + (large + "!").Length
	length
Doubled(text Text, times Number) Text
	LargeCollections.Doubled("ab", 2) is "abababab"
	mutable doubled = text
	for times
		doubled = doubled + doubled
	doubled
Run
	logger.Log(Copied(1100) to Text)
