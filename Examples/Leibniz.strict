constant Digits = 16
Pi(rounds Number) Number
	Leibniz.Pi(0) is 4
	Leibniz.Pi(1) is (1 - 1 / 3) * 4
	Leibniz.Pi(2) is (1 - 1 / 3 + 1 / 5) * 4
	Leibniz.Pi(4) is (1 - 1 / 3 + 1 / 5 - 1 / 7 + 1 / 9) * 4
	mutable pi = 1
	for Range(1, rounds + 1)
		pi = pi + (1 - 2 * (value % 2)) / (2 * value + 1)
	pi * 4
Run(times = 1) Number
	rounds = File("rounds.txt").ReadLines.First.Trim to Number
	if times < 2
		logger.Log(Pi(rounds).Fixed(Digits))
		0
	else
		TimeRounds(rounds, times)
TimeRounds(rounds Number, times Number) Number
	Leibniz.TimeRounds(0, 0) is 0
	warmup = Pi(rounds)
	for times
		started = Process.Elapsed
		pi = Pi(rounds)
		milliseconds = ((Process.Elapsed - started) * 1000).Round(1)
		logger.Log("" + milliseconds + " ms " + pi.Fixed(Digits) + (warmup is pi then "" else ", the first call differs"))
	0
