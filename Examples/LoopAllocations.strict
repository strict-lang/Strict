constant Iterations = 500
constant Allowed = 1600
Run
	before = Process.Executed(5)
	total = Sum(Iterations)
	made = Process.Executed(5)
	logger.Log("a VM loop of 500 iterations made " + made + " allocations, sum " + total + " " + before)
	if made > Allowed
		return Error("LoopAllocatesTooMuch: " + made)
Sum(count Number) Number
	Sum(3) is 6
	mutable sum = 0
	for Range(0, count)
		sum = sum + value * 2
	sum