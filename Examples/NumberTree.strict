has number
has children List(NumberTree)
constant Small = NumberTree(0.1, List(NumberTree) + NumberTree(0.2, List(NumberTree) + NumberTree(0.4, List(NumberTree))))
constant Tripled = NumberTree(0.3, List(NumberTree) + NumberTree(0.6, List(NumberTree) + NumberTree(1.2, List(NumberTree))))
constant Different = NumberTree(0.3, List(NumberTree) + NumberTree(0.6, List(NumberTree) + NumberTree(1.3, List(NumberTree))))
Scaled(factor Number) NumberTree
	Small.Scaled(3) is Tripled
	Small.Scaled(3) is not Different
	NumberTree(number * factor, ScaledChildren(factor))
ScaledChildren(factor Number) List(NumberTree)
	Small.ScaledChildren(2).First.number is 0.4
	for children
		value.Scaled(factor)
