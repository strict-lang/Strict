has first Number with value >= 0 and value.Bits is 32
has second Number with value.Bits is 32
has Third = 0 with value.Bits is 32
Advanced(step Number) RecycledPair
	RecycledPair(1, 2).Advanced(3) is RecycledPair(4, 2, 3)
	RecycledPair(1, 2).Advanced(-1) is Error("InvalidStep: -1")
	step < 0 then Error("InvalidStep: " + step) else RecycledPair(first + step, second, step)
