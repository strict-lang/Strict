constant Pattern = "constant \\w+ = "
Run
	lines = Lines("Compiler")
	reused = Regex(Pattern)
	started = Process.Elapsed
	built = Matches(lines, "")
	parsed = Process.Elapsed
	kept = Keep(lines, reused)
	matched = Process.Elapsed
	found = Find(lines)
	ended = Process.Elapsed
	perLine = Milliseconds(parsed - started) + " ms, one Regex " + Milliseconds(matched - parsed)
	logger.Log(lines.Length + " lines, a Regex per line " + perLine + " ms, IndexOf " + Milliseconds(ended - matched))
	logger.Log("hits: " + built + ", " + kept + ", " + found)
Lines(folder Text) Texts slow
	mutable lines = List(Text)
	for Directory.Files(folder, "*.strict")
		lines = lines + File(value).ReadLines
	lines
Matches(lines Texts, prefix Text) Number
	RegexSpeed.Matches(("constant Wait = 1", "x"), "") is 1
	for lines
		if Regex(prefix + Pattern).IsMatch(value)
			1
Keep(lines Texts, regex Regex) Number
	RegexSpeed.Keep(("constant Wait = 1", "x"), Regex(Pattern)) is 1
	for lines
		if regex.IsMatch(value)
			1
Find(lines Texts) Number
	RegexSpeed.Find(("constant Wait = 1", "x")) is 1
	for lines
		if value.IndexOf("constant ") >= 0
			1
Milliseconds(seconds Number) Number
	RegexSpeed.Milliseconds(0.0015) is 1.5
	(seconds * 1000).Round(1)
