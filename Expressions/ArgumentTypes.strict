has inference TypeInference
constant Scopes = (Scope(List(Text) + "number", List(Text) + "Number"), Scope(("size", "depth"), ("Size", "Number")), Scope(List(Text) + "width", List(Text) + "Number"), Scope(List(Text) + "number", List(Text) + "Number"))
constant Methods = (Scope(("Grow", "Spread"), ("Count", "Count")), KnownTypes.NoMembers, KnownTypes.NoMembers, KnownTypes.NoMembers)
constant CountParameters = Scope(("Grow", "Grow types", "Grow required", "Spread", "Spread types", "from", "from types"), ("area", "Area", "1", "area,size", "Area,Size", "size", "Size"))
constant Parameters = (CountParameters, KnownTypes.NoMembers, Scope(List(Text) + "from", List(Text) + "width"), Scope(("from", "from types"), ("text", "Text")))
constant Shapes = (Scope(List(Text) + "Limit", List(Text) + "3"), KnownTypes.NoMembers, KnownTypes.NoMembers, KnownTypes.NoMembers)
constant Sizing = ArgumentTypes(TypeInference(KnownTypes(("Count", "Area", "Size", "Letter"), Scopes, Methods, Parameters), Shapes))
constant RangeMembers = (Scope(List(Text) + "start", List(Text) + "Number"), Scope(List(Text) + "type", List(Text) + "Range"))
constant Generics = ArgumentTypes(TypeInference(KnownTypes(("Range", "Generic"), RangeMembers, KnownTypes.NoMemberPair, KnownTypes.NoMemberPair), Shapes))
constant LoggedMembers = (Scope(List(Text) + "logger", List(Text) + "Logger"), KnownTypes.NoMembers)
constant LoggedTypes = KnownTypes(("Wrong", "Logger"), LoggedMembers, KnownTypes.NoMemberPair, (Scope(List(Text) + "from", List(Text) + "logger"), KnownTypes.NoMembers))
constant Logged = ArgumentTypes(TypeInference(LoggedTypes, Shapes))
constant Made = SyntaxParser(Tokenizer("Wrong(1, 2)").Tokens).Parse
constant Couples = ArgumentTypes(TypeInference(Instantiation.Implicit.types, List(Scope)))
constant Coupled = SyntaxParser(Tokenizer("Couple(\"a\", 2)").Tokens).Parse
constant Grown = SyntaxParser(Tokenizer("count.Grow(count)").Tokens).Parse
constant Listed = SyntaxParser(Tokenizer("1 > 0 and (count)").Tokens).Parse
constant Limited = SyntaxParser(Tokenizer("count.Limit").Tokens).Parse
constant Created = SyntaxParser(Tokenizer("Count(count)").Tokens).Parse
constant Spread = SyntaxParser(Tokenizer("count.Spread(area, size, size)").Tokens).Parse
constant Counted = Scope(("count", "area", "size"), ("Count", "Area", "Size"))
constant Owned = Counted.With("self type", "Count")
constant OwnGrown = SyntaxParser(Tokenizer("Grow(count)").Tokens).Parse
constant DepthCopies = (SyntaxParser(Tokenizer("Area(area, size, depth = 2)").Tokens).Parse, SyntaxParser(Tokenizer("Area(area, depth = 2)").Tokens).Parse, SyntaxParser(Tokenizer("Area(size, size, depth = 2)").Tokens).Parse)
constant Copies = DepthCopies + (SyntaxNode("Call", "Area"), SyntaxParser(Tokenizer("Area(area, size)").Tokens).Parse, SyntaxParser(Tokenizer("Area(size)").Tokens).Parse, SyntaxParser(Tokenizer("Number(5)").Tokens).Parse)
constant Scaling = ArgumentTypes(Overloads.ScalerInference)
constant Scalers = Overloads.Scalers
constant Inheriting = ArgumentTypes(TypeInference(KnownTypes.Options, (KnownTypes.NoMembers, KnownTypes.NoMembers, KnownTypes.NoMembers)))
constant Parsing = SyntaxParser(Tokenizer("settings.Parsed(5)").Tokens).Parse
constant Indexing = ArgumentTypes(IndexedValues.Typed.inference)
constant Mixed = "CopyChangesMustBeNamed: Area(area, size, depth = 2) copies area, name every change like depth = 2"
Checked(node SyntaxNode, scope Scope, current Scope) Text
	Sizing.Checked(Grown, Counted, Counted).StartsWith("ArgumentTypeMismatch")
	Sizing.Checked(Listed, Counted, Counted).StartsWith("LogicalOperandIsAList")
	Sizing.Checked(Limited, Counted, Counted).StartsWith("ConstantNeedsTypeName")
	Sizing.ConstantAccess(Limited, Methods(0), Counted).StartsWith("ConstantNeedsTypeName")
	Sizing.Operands(SyntaxNode("Call", "and", Listed.children)) is ""
	Sizing.Operands(SyntaxNode("Binary", "+", Listed.children)) is ""
	Sizing.Checked(TextJoins.Listed, TextJoins.Named, TextJoins.Named).StartsWith("ListToTextMustBeExplicit")
	Indexing.Checked(IndexedValues.Parsed(0), IndexedValues.Named, Counted).StartsWith("IndexedValueMustHaveElements")
	let branched = BranchTypes(inference).Issue(node, scope, current) + TextJoins(inference).Issue(node, scope, current)
	let indexed = IndexedValues(inference).Issue(node, scope, current)
	let operands = Operands(node) + ConstantAccess(node, scope, current) + branched + indexed
	operands is "" then Issue(node, scope, current) + OwnCall(node, scope, current) else operands
ConstantAccess(node SyntaxNode, scope Scope, current Scope) Text
	Sizing.ConstantAccess(SyntaxParser(Tokenizer("count.Grow").Tokens).Parse, Counted, Counted) is ""
	Sizing.ConstantAccess(Limited, Counted, Counted).EndsWith(": Limit is read from an instance, write Count.Limit")
	Sizing.ConstantAccess(Limited, Counted, Counted).StartsWith("ConstantNeedsTypeName")
	Sizing.ConstantAccess(SyntaxParser(Tokenizer("Count.Limit").Tokens).Parse, Counted, Counted) is ""
	Sizing.ConstantAccess(SyntaxParser(Tokenizer("Limit(count)").Tokens).Parse, Counted, Counted) is ""
	let isMember = (node.Kind is in ("Member", "MethodCall")) and (node.children.Length > 0)
	let first = isMember then node.children(0) else node
	let isTypeName = (first.Kind is "Type") or (scope.TypeOf(first.text) is "") and inference.types.IsKnown(first.text)
	let owner = isMember and (isTypeName is false) then inference.TypeOf(first, scope, current) else ""
	if (owner is "") or (inference.ConstantOf(owner, node.text) is "")
		return ""
	"ConstantNeedsTypeName: " + node.text + " is read from an instance, write " + owner + "." + node.text
Operands(node SyntaxNode) Text
	Sizing.Operands(SyntaxParser(Tokenizer("1 > 0 or (count)").Tokens).Parse).EndsWith("remove the parentheses")
	Sizing.Operands(SyntaxParser(Tokenizer("1 > 0 xor (count)").Tokens).Parse).EndsWith("remove the parentheses")
	Sizing.Operands(SyntaxParser(Tokenizer("1 > 0 and (1, 2)").Tokens).Parse) is ""
	Sizing.Operands(SyntaxParser(Tokenizer("1 > 0 and count.Limit").Tokens).Parse) is ""
	Sizing.Operands(Listed).EndsWith("remove the parentheses")
	Sizing.Operands(SyntaxParser(Tokenizer("(1 > 0) and (2 > 1)").Tokens).Parse) is ""
	if (node.Kind is not "Binary") or (node.text is not in ("and", "or", "xor"))
		return ""
	for node.children
		if (value.Kind is "List") and (value.children.Length is 1)
			return "LogicalOperandIsAList: " + value + " is a list of one element, remove the parentheses"
	""
Issue(call SyntaxNode, scope Scope, current Scope) Text
	Sizing.Issue(Grown, Counted, Counted).StartsWith("ArgumentTypeMismatch")
	Sizing.Issue(SyntaxParser(Tokenizer("count.Grow(area)").Tokens).Parse, Counted, Counted) is ""
	Sizing.Issue(Created, Counted, Counted).EndsWith("Count got a Count for a Size")
	Sizing.Issue(Created, Counted, Scope(List(Text) + "Count", List(Text) + "Count")) is ""
	Sizing.Issue(SyntaxParser(Tokenizer("Area(area)").Tokens).Parse, Counted, Counted).StartsWith("CopyWithoutChanges")
	let isConstructor = (call.Kind is "Call") and inference.types.IsKnown(call.text) and (current.TypeOf(call.text) is "")
	let isCall = (call.Kind is "MethodCall") and (call.children.Length > 1)
	if (isCall or isConstructor) is false
		return ""
	let instance = isCall then inference.TypeOf(call.children(0), scope, current) else call.text
	let compared = Compared(call, instance, isCall then call.text else "from", scope, current)
	(compared is "") and isConstructor then Copied(call, scope, current) else compared
OwnCall(call SyntaxNode, scope Scope, current Scope) Text
	Sizing.OwnCall(OwnGrown, Owned, Methods(0)).EndsWith("Count.Grow got a Count for a Area")
	Scaling.Issue(Overloads.Rescaled, Scalers, Scalers).StartsWith("NoOverloadFits")
	Sizing.OwnCall(SyntaxParser(Tokenizer("Grow(area)").Tokens).Parse, Owned, Methods(0)) is ""
	Sizing.OwnCall(Grown, Owned, Methods(0)) is ""
	Sizing.OwnCall(OwnGrown, Owned, Counted) is ""
	Sizing.Issue(SyntaxNode("List", "Count", Created.children), Counted, Counted) is ""
	Sizing.Issue(SyntaxParser(Tokenizer("Count(count, size)").Tokens).Parse, Counted, Counted).StartsWith("ArgumentType")
	Sizing.Issue(SyntaxParser(Tokenizer("count.Spread(area, size)").Tokens).Parse, Counted, Counted) is ""
	Sizing.Issue(SyntaxParser(Tokenizer("count.Grow(area, area)").Tokens).Parse, Counted, Counted).StartsWith("TooMany")
	let isOwn = (call.Kind is "Call") and (current.TypeOf(call.text) is not "")
	isOwn then Compared(call, scope.TypeOf("self type"), call.text, scope, current) else ""
Copied(call SyntaxNode, scope Scope, current Scope) Text
	Sizing.Copied(SyntaxParser(Tokenizer("Area(area)").Tokens).Parse, Counted, Counted).EndsWith("use area itself")
	Sizing.Copied(Copies(0), Counted, Counted) is Mixed
	(Sizing.Copied(Copies(1), Counted, Counted) is "") and (Sizing.Copied(Copies(2), Counted, Counted) is "")
	(Sizing.Copied(Copies(3), Counted, Counted) is "") and (Sizing.Copied(Copies(4), Counted, Counted) is "")
	(Sizing.Copied(Copies(5), Counted, Counted) is "") and (Sizing.Copied(Copies(6), Counted, Counted) is "")
	let first = call.children.Length > 0 then call.children(0) else call
	let isCopy = (first is not call) and (inference.TypeOf(first, scope, current) is call.text)
	if isCopy and (call.children.Last.Kind is "Reassignment") and (call.children(1).Kind is not "Reassignment")
		return "CopyChangesMustBeNamed: " + call + " copies " + first + ", name every change like " + call.children.Last
	if (isCopy is false) or (call.children.Length > 1) or (inference.types.MembersOf(call.text).names.Length < 2)
		return ""
	"CopyWithoutChanges: " + call + " copies " + first + " without naming a changed member, use " + first + " itself"
Compared(call SyntaxNode, instance Text, method Text, scope Scope, current Scope) Text
	Sizing.Compared(Grown, "Count", "Grow", Counted, Counted).StartsWith("ArgumentTypeMismatch: Count.Grow")
	Sizing.Compared(Spread, "Count", "Spread", Counted, Counted) is "TooManyArguments: Count.Spread got 3 of 2"
	if inference.types.ParameterScope(Owner(instance, method)).Count(method) is not 1
		return Overloads(inference.types).Unfit(call, instance, method, inference, scope, current)
	let types = Declared(instance, method)
	let arguments = Arguments(call, scope, current)
	let at = Matched(arguments, types, instance, method)
	let name = method is "from" then instance else instance + "." + method
	if at < 0
		return TooMany(call, name, types)
	"ArgumentTypeMismatch: " + name + " got a " + arguments(at) + " for a " + types(at)
TooMany(call SyntaxNode, name Text, types Texts) Text
	Logged.Compared(Made, "Wrong", "from", Counted, Counted) is "TooManyArguments: Wrong got 2 of 1"
	(Sizing.TooMany(DepthCopies(1), "Area", List(Text) + "Size") is "") and (Logged.TooMany(Made, "Wrong", ("")) is "")
	(Couples.TooMany(Coupled, "Couple", List(Text)) is "") and (Sizing.TooMany(Created, "Count", ("Size", "Number")) is "")
	mutable given = 0
	for call.children
		if (value.Kind is not "Reassignment") and ((index > 0) or (call.Kind is not "MethodCall"))
			given = given + 1
	let isOpen = ("" is in types) or (Text.Combine(inference.types.MembersOf(name).types).IndexOf("Generic") >= 0)
	if IsListed(types) or isOpen or (given <= types.Length)
		return ""
	"TooManyArguments: " + name + " got " + given + " of " + types.Length
Owner(instance Text, method Text) Text
	Inheriting.Owner("Settings", "Parsed") is "Any"
	Inheriting.Owner("Text", "Parsed") is "Text"
	Inheriting.Owner("Settings", "from") is "Settings"
	Inheriting.Owner("Settings", "to") is "Settings"
	Inheriting.Compared(Parsing, "Settings", "Parsed", Counted, Counted).EndsWith(".Parsed got a Number for a Texts")
	Sizing.Owner("Count", "Grow") is "Count"
	let types = inference.types
	let isOwn = (types.ParameterScope(instance).Count(method) > 0) or (types.MethodsOf(instance).TypeOf(method) is not "")
	isOwn or (types.Inherited(instance, method) is "") then instance else "Any"
Declared(instance Text, method Text) Texts
	Sizing.Declared("Count", "Grow") is ("Area")
	Sizing.Declared("Size", "from") is ("Number")
	Couples.Declared("Couple", "from").Length is 0
	let parameters = inference.types.ParameterScope(Owner(instance, method))
	if (method is "from") and ("Generic" is in inference.types.MembersOf(instance).types)
		return List(Text)
	let declared = parameters.TypeOf(method + " types")
	if (declared is not "") or (method is not "from")
		return declared.Split(",")
	for parameters.TypeOf("from").Split(",")
		inference.types.MembersOf(instance).TypeOf(value)
Matched(arguments Texts, types Texts, instance Text, method Text) Number
	Sizing.Matched(List(Text) + "Number", List(Text) + "Text", "Letter", "Grow") is 0
	Sizing.Matched(List(Text) + "Number", List(Text) + "Text", "Letter", "from") is -1
	Sizing.Matched(List(Text) + "Text", List(Text) + "Text", "Letter", "from") is -1
	Sizing.Matched(List(Text) + "Text", List(Text) + "Size", "Count", "from") is 0
	let members = inference.types.MembersOf(instance).types
	((method is "from") and ((arguments - members).Length is 0)) then -1 else Mismatched(arguments, types)
Arguments(call SyntaxNode, scope Scope, current Scope) Texts
	Sizing.Compared(Grown, "Count", "Missing", Counted, Counted) is ""
	Sizing.IsBaseMismatch("Number", "Count") is false
	Sizing.IsBaseMismatch("Text", "Xyz") is false
	Sizing.IsBaseMismatch("Count", "Number") is false
	Sizing.Mismatch("Size", "Size") is false
	Sizing.Mismatch("Count", "Xyz") is false
	Sizing.Arguments(SyntaxParser(Tokenizer("count.Grow(area)").Tokens).Parse, Counted, Counted) is ("Area")
	for Range((call.Kind is "MethodCall" then 1 else 0), call.children.Length)
		inference.TypeOf(call.children(value), scope, current)
Mismatched(arguments Texts, types Texts) Number
	Sizing.Mismatched(("Area", "Count"), List(Text) + "Area") is -1
	Sizing.Mismatched(("Area", "Count"), ("Area", "Area")) is 1
	Sizing.Mismatched(List(Text) + "Area", List(Text) + "Area") is -1
	Sizing.Mismatched(("Text", "Text"), ("Sizes", "Text")) is 0
	Sizing.Mismatched(("Text", "Text"), ("Texts", "Text")) is -1
	for arguments
		if (index < types.Length) and (Mismatch(value, types(index)) or IsWrongElement(value, types(index)))
			return index
	-1
IsWrongElement(argument Text, parameter Text) Boolean
	Sizing.IsWrongElement("Text", "Pair(Size)") is false
	Sizing.IsWrongElement("Text", "List(Size)")
	Sizing.IsWrongElement("Text", "Sizes")
	Sizing.IsWrongElement("Number", "Sizes") is false
	Sizing.IsWrongElement("Text", "Texts") is false
	Sizing.IsWrongElement("Sizes", "Sizes") is false
	Sizing.IsWrongElement("Texts", "Numbers") and (Sizing.IsWrongElement("Numbers", "Texts") is false)
	(Sizing.IsWrongElement("Numbers", "Sizes") is false) and (Sizing.IsWrongElement("List(Texts)", "Numbers") is false)
	let elements = ListFits(inference.types).Elements(parameter)
	let listed = ListFits(inference.types).Elements(argument)
	let compared = (listed.Length is not 1) or ("Text" is in elements) then argument else listed(0)
	IsScalar(compared) and (elements.Length is 1) and Mismatch(compared, elements(0))
Mismatch(argument Text, parameter Text) Boolean
	Sizing.Mismatch("Count", "Area")
	Sizing.Mismatch("Area", "Size") is false
	Sizing.Mismatch("Number", "Area") is false
	Sizing.Mismatch("Area", "Area") is false
	Generics.Mismatch("Range", "Generic") is false
	Sizing.Mismatch("Text", "Size")
	let types = inference.types
	let isUser = (TypeEntry.IsBaseName(argument) or TypeEntry.IsBaseName(parameter) or (parameter is "Generic")) is false
	let isKnown = types.IsKnown(argument) and types.IsKnown(parameter)
	let isChecked = isUser and isKnown and (types.MembersOf(parameter).names.Length > 0) and (argument is not parameter)
	IsBaseMismatch(argument, parameter) or isChecked and (parameter is not in types.MembersOf(argument).types)
IsBaseMismatch(argument Text, parameter Text) Boolean
	Sizing.IsBaseMismatch("Text", "Count")
	Sizing.IsBaseMismatch("Number", "Size") is false
	Sizing.IsBaseMismatch("Text", "Text") is false
	Sizing.IsBaseMismatch("Text", "Number")
	Sizing.IsBaseMismatch("Number", "Text")
	Sizing.IsBaseMismatch("Boolean", "Number")
	Sizing.IsBaseMismatch("Numbers", "Number")
	let types = inference.types
	let hasMembers = types.IsKnown(parameter) and (types.MembersOf(parameter).names.Length > 0)
	let isComposite = hasMembers and (TypeEntry.IsBaseName(parameter) is false)
	let isScalar = IsScalar(parameter) and (argument is not parameter) and (IsScalar(argument) or types.IsPlural(argument))
	isScalar or (argument is "Text") and isComposite and (types.ValueOf(parameter) is not "Text")
IsListed(types Texts) Boolean
	Sizing.IsListed(List(Text) + "Areas") and Sizing.IsListed(List(Text) + "Generic")
	Sizing.IsListed(List(Text) + "Area") is false and (Sizing.IsListed(("Areas", "Area")) is false)
	(types.Length is 1) and (inference.types.BaseName(types.First) is in ("List", "Generic", "Generics"))
IsScalar(type Text) Boolean
	Sizing.IsScalar("Boolean")
	Sizing.IsScalar("Count") is false
	Sizing.IsWrongElement("Count", "Areas") is false
	Sizing.Mismatch("Xyz", "Area") is false
	Sizing.IsBaseMismatch("Count", "Area") is false
	Sizing.IsBaseMismatch("Text", "Area")
	Sizing.Copied(SyntaxParser(Tokenizer("Area(area)").Tokens).Parse, Counted, Counted).Split(" ")(2) is "copies"
	type is in ("Boolean", "Number", "Text")