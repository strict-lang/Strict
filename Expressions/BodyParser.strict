has lines Texts
constant Positions = ("Run", "\tmutable position = 3", "\tnext(add = 1) = position + add", "\tnext", "\tposition = 10", "\tnext(2)")
constant Inlined = ("\tmutable position = 3", "\tposition + 1", "\tposition = 10", "\tposition + 2")
Block(start Number, depth Number) SyntaxNode
	BodyParser("Run", "\tif a", "\t\tb", "\tc").Block(1, 1).children.Length is 2
	BodyParser("Run", "\tif a", "\t\tb", "\tc").Block(1, 1).Lines("\t") is ("\tif a", "\t\tb", "\tc")
	mutable statements = List(Mutable(SyntaxNode))
	for Range(start, BlockEnd(start, depth))
		if Indent(lines(value)) is depth
			statements.Add(Statement(value, depth))
	SyntaxNode("Body", "", statements)
Method(start Number) SyntaxNode
	BodyParser(Positions).Method(1).Lines("\t") is Inlined
	BodyParser("Area = Width * Height").Method(1).Lines("\t") is List(Text) + "\tWidth * Height"
	if (start > 0) and TypeShape(lines).IsComputed(lines(start - 1))
		return Computed(start - 1)
	Definitions(lines).Inlined(Block(start, 1), start)
Computed(header Number) SyntaxNode
	BodyParser("Next(add = 1) = add + 1").Computed(0).children.First to Text is "add + 1"
	let tokens = Tokenizer(lines(header)).Tokens
	let assigned = SyntaxParser(tokens).ParseRange(HeaderTokens(tokens).ParametersEnd + 2, tokens.Length)
	SyntaxNode("Body", "", List(SyntaxNode) + SyntaxNode(assigned.Kind, assigned.text, assigned.children, header + 1))
Statement(lineIndex Number, depth Number) SyntaxNode
	BodyParser("Run", "\tfor 3", "\t\tvalue").Statement(1, 1).children.Length is 2
	BodyParser("Run", "\ta", "\tb").Statement(1, 1).children.Length is 0
	BodyParser("Run", "\ta", "\tb").Statement(2, 1).line is 3
	let statement = StatementParser(Tokenizer(lines(lineIndex).Trim).Tokens).ParseStatement
	if (lineIndex + 1 is lines.Length) or Indent(lines(lineIndex + 1)) <= depth
		return SyntaxNode(statement.Kind, statement.text, statement.children, lineIndex + 1)
	SyntaxNode(statement.Kind, statement.text, statement.children + Block(lineIndex + 1, depth + 1), lineIndex + 1)
BlockEnd(start Number, depth Number) Number
	BodyParser("Run", "\ta", "Other").BlockEnd(1, 1) is 2
	BodyParser("Run", "\ta", "\t\tb").BlockEnd(1, 1) is 3
	for Range(start, lines.Length)
		if Indent(lines(value)) < depth
			return value
	lines.Length
Indent(line Text) Number
	Indent("\t\ta") is 2
	line.Length - line.TrimStart.Length