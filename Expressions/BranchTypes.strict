has inference TypeInference
constant Sizing = BranchTypes(ArgumentTypes.Sizing.inference)
constant Counted = ArgumentTypes.Counted
constant Mixed = SyntaxParser(Tokenizer("count is count then count else area").Tokens).Parse
constant Same = SyntaxParser(Tokenizer("count is count then count else count").Tokens).Parse
constant Failing = SyntaxParser(Tokenizer("count is count then count else Error").Tokens).Parse
constant Handed = SyntaxParser(Tokenizer("count is Error then count else area").Tokens).Parse
constant Other = SyntaxParser(Tokenizer("count is Error then area else count").Tokens).Parse
constant Kept = SyntaxParser(Tokenizer("count is not Error then count else area").Tokens).Parse
constant Sized = SyntaxParser(Tokenizer("count is count then size else area").Tokens).Parse
constant Areas = SyntaxParser(Tokenizer("count is count then area else size").Tokens).Parse
constant ElseFailed = SyntaxParser(Tokenizer("count is count then count else failed").Tokens).Parse
constant ThenFailed = SyntaxParser(Tokenizer("count is count then failed else count").Tokens).Parse
constant Failures = KnownTypes(("Count", "Error"), (Scope(List(Text) + "number", List(Text) + "Number"), ArgumentTypes.ErrorMembers(0)), KnownTypes.NoMemberPair, KnownTypes.NoMemberPair)
constant Erred = BranchTypes(TypeInference(Failures, KnownTypes.NoMemberPair))
constant Failed = Scope(("count", "failed"), ("Count", "Error"))
constant Fallback = SyntaxParser(Tokenizer("count else area").Tokens).Parse
constant Statement = SyntaxNode("Else", "else")
constant Compared = SyntaxNode("Binary", "is", Mixed.children)
constant Message = "ConditionalBranchesMustHaveOneType: count is count then count else area gives a Count or a Area"
constant Coupled = BranchTypes(Instantiation.Inferring)
constant Paired = SyntaxParser(Tokenizer("1 is 1 then Couple(\"a\", 2) else Couple(1, 2)").Tokens).Parse
constant Held = Scope("Checker", "Checker")
constant Checks = Scope("IsChecked", "Boolean")
constant Checkers = KnownTypes(("Checker", "MockCheck", "RealCheck"), (KnownTypes.NoMembers, Held, Held), (Checks, Checks, Checks), (Scope(" trait", "true"), KnownTypes.NoMembers, KnownTypes.NoMembers))
constant Picking = BranchTypes(TypeInference(Checkers, (KnownTypes.NoMembers, KnownTypes.NoMembers, KnownTypes.NoMembers)))
constant Picked = SyntaxParser(Tokenizer("isReal then RealCheck else MockCheck").Tokens).Parse
constant Unchecked = ("", "Unknown", "Error", "ErrorWithValue", "None", "Generic")
Issue(node SyntaxNode, scope Scope, current Scope) Text
	Sizing.Issue(Mixed, Counted, Counted) is Message
	Sizing.Issue(Same, Counted, Counted) is "" and Sizing.Issue(Failing, Counted, Counted) is ""
	Sizing.Issue(ArgumentTypes.Grown, Counted, Counted) is "" and Sizing.Issue(Statement, Counted, Counted) is ""
	Sizing.Issue(Compared, Counted, Counted) is "" and Sizing.Issue(Fallback, Counted, Counted) is ""
	Picking.Issue(Picked, Scope("isReal", "Boolean"), KnownTypes.NoMembers) is ""
	if node.Kind is not "Binary" or node.text is not "else" or node.children(0).text is not "then"
		return ""
	thenType = Then(node.children(0), scope, current)
	elseType = inference.TypeOf(node.children(1), scope, current)
	checks = ArgumentTypes(inference)
	isMixed = checks.IsMismatch(elseType, thenType) or checks.IsMismatch(thenType, elseType) or IsSplit(thenType, elseType)
	message = "ConditionalBranchesMustHaveOneType: " + node + " gives a " + thenType + " or a " + elseType
	isChecked = thenType is not in Unchecked and elseType is not in Unchecked and isMixed
	isChecked and IsShared(thenType, elseType) is false then message else ""
IsShared(first Text, second Text) Boolean
	Picking.IsShared("RealCheck", "MockCheck") and Picking.IsShared("RealCheck", "Checker") is false
	types = inference.types
	for types.MembersOf(first).types
		isTrait = types.ParameterScope(value).TypeOf(" trait") is "true" and value is in types.MembersOf(second).types
		if isTrait and IsCovering(first, value) and IsCovering(second, value)
			return true
	false
IsCovering(type Text, trait Text) Boolean
	Picking.IsCovering("MockCheck", "Checker")
	(inference.types.MethodsOf(trait).names - inference.types.MethodsOf(type).names).Length is 0
IsSplit(first Text, second Text) Boolean
	Coupled.IsSplit("Couple(Text, Number)", "Couple(Number, Number)")
	(Coupled.IsSplit("Couple(Text)", "Couple") or Coupled.IsSplit("Couple", "Couple(Text)")) is false
	Coupled.Issue(Paired, Counted, Counted).EndsWith(" gives a Couple(Text, Number) or a Couple(Number, Number)")
	(Coupled.IsSplit("Pair(Text)", "Pair(Number)") or Coupled.IsSplit("Couple(Text)", "Couple(Text)")) is false
	Coupled.IsSplit("Couple(Text, Number)", "Pair(Number)") is false
	types = inference.types
	isOpen = "Generic" is in types.MembersOf(types.BaseName(first)).types
	isArgued = first.IndexOf("(") > 0 and second.IndexOf("(") > 0
	isOpen and isArgued and first is not second and types.BaseName(first) is types.BaseName(second)
Then(branch SyntaxNode, scope Scope, current Scope) Text
	Sizing.Then(Handed.children(0), Counted, Counted) is "Error"
	Sizing.Then(Mixed.children(0), Counted, Counted) is "Count"
	Sizing.Issue(Sized, Counted, Counted).EndsWith("gives a Size or a Area")
	Sizing.Issue(Areas, Counted, Counted).EndsWith("gives a Area or a Size")
	Erred.Issue(ElseFailed, Failed, Failed) is "" and Erred.Issue(ThenFailed, Failed, Failed) is ""
	IsHanded(branch) then "Error" else inference.TypeOf(branch.children(1), scope, current)
IsHanded(branch SyntaxNode) Boolean
	Sizing.IsHanded(Handed.children(0))
	Sizing.IsHanded(Other.children(0)) is false
	Sizing.IsHanded(Mixed.children(0)) is false
	Sizing.IsHanded(Kept.children(0)) is false
	Sizing.Issue(Handed, Counted, Counted) is ""
	condition = branch.children(0)
	condition.text is "is" and condition.children.Last.text is "Error" and condition.children(0) is branch.children(1)