has types KnownTypes
constant Counted = KnownTypes(("Box", "Count"), (Scope(List(Text) + "Count", List(Text) + "Count"), KnownTypes.CountMembers), (KnownTypes.NoMembers, KnownTypes.CountMethods), KnownTypes.NoMemberPair)
constant Shadowing = KnownTypes(Counted.names, Counted.members, (Scope(List(Text) + "Twice", List(Text) + "Number"), KnownTypes.CountMethods), KnownTypes.NoMemberPair)
constant Listed = KnownTypes(("Box", "List"), (Scope(List(Text) + "counts", List(Text) + "Counts"), KnownTypes.Lengths(0)), (KnownTypes.NoMembers, Scope(List(Text) + "First", List(Text) + "Generic")), KnownTypes.NoMemberPair)
Scoped(typeName Text) Scope
	Composition(Counted).Scoped("Box").TypeOf("Twice") is "Count"
	Composition(Shadowing).Scoped("Box").TypeOf("Twice") is "Number"
	Composition(KnownTypes.Measured).Scoped("F").Count("Length") is 1
	let members = types.MembersOf(typeName)
	let held = Held(members)
	let own = held.names.Length is 0 then members else held.WithAll(members.names, members.types).Owned(members.owner)
	own.WithAll(types.MethodsOf(typeName).names, types.MethodsOf(typeName).types)
Held(members Scope) Scope
	Composition(Counted).Held(Counted.members(0)).TypeOf("number") is "Number"
	Composition(Listed).Held(Listed.members(0)).TypeOf("First") is ""
	Composition(KnownTypes.Nested).Held(KnownTypes.Nested.members(0)).TypeOf("Length") is "Length"
	mutable held = Scope(List(Text), List(Text))
	for members.types
		if IsComposite(value)
			let fields = types.MembersOf(value)
			let methods = types.MethodsOf(value)
			held = held.WithAll(fields.names, fields.types).WithAll(methods.names, methods.types)
	held
IsComposite(type Text) Boolean
	Composition(Counted).IsComposite("Count") and Composition(Listed).IsComposite("Counts") is false
	Composition(KnownTypes.Measured).IsComposite("Length") is false
	types.IsKnown(type) and types.MembersOf(type).names.Length > 0
