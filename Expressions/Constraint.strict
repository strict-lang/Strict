has name Text
has type Text
has types KnownTypes
constant Framed = "Run(frames = 0 with value >= 0, other Number)"
constant Misnamed = "ConstraintNeedsWith: where in A.strict:1, write has a Number with value > 0"
constant Counting = Constraint("count", "Count", KnownTypes.Sample)
Condition(constraint Text) Text
	Counting.Condition("value >= 0") is "count >= 0"
	Counting.Condition("Increment is value and value < Limit") is "count.Increment is count and count < Limit"
	Rewritten(SyntaxParser(Tokenizer(constraint).Tokens).Parse) to Text
Rewritten(node SyntaxNode) SyntaxNode
	Counting.Rewritten(SyntaxNode("Identifier", "value")).text is "count"
	Counting.Rewritten(SyntaxNode("Identifier", "Twice")).Kind is "Member"
	if node.Kind is "Identifier"
		let own = SyntaxNode("Identifier", name)
		if node.text is "value"
			return own
		let isOwn = types.MemberType(type, node.text) is not "Unknown"
		return isOwn then SyntaxNode("Member", node.text, List(SyntaxNode) + own) else node
	mutable children = List(Mutable(SyntaxNode))
	for node.children
		children.Add(Rewritten(value))
	SyntaxNode(node.Kind, node.text, children, node.line)
Failure(constraint Text) Text
	Counting.Failure("value > 0") is "return Error(\"ConstraintNotMet: count with value > 0 is false for \" + count)"
	let escaped = constraint.Replace("\"", "\\\"")
	"return Error(\"ConstraintNotMet: " + name + " with " + escaped + " is false for \" + " + name + ")"
Checked(constraint Text, line Number) SyntaxNode
	Counting.Checked("value > 0", 3).line is 3
	Counting.Checked("value > 0", 3) to Text is "if count > 0 is false"
	let check = StatementParser(Tokenizer("if (" + Condition(constraint) + ") is false").Tokens).ParseStatement
	let failed = StatementParser(Tokenizer(Failure(constraint)).Tokens).ParseStatement
	let body = SyntaxNode("Body", "", List(SyntaxNode) + SyntaxNode(failed.Kind, failed.text, failed.children, line))
	SyntaxNode(check.Kind, check.text, check.children + body, line)
IsConstrained(lines Texts) Boolean
	Constraint.IsConstrained(List(Text) + "has width Number with value > 0") is true
	Constraint.IsConstrained(("has width Number", "Area Number", "\t\"with\"")) is false
	Constraint.IsConstrained(List(Text) + "has price Number with Step 0.01") is false
	for lines
		let tokens = Tokenizer(value).Tokens
		if TypeShape(lines).IsMemberLine(value) and ("with" is in tokens) and (Steps(tokens).Of(1) is "")
			return true
	false
Parameter(header HeaderTokens, parameter Text) Text
	Constraint.Parameter(HeaderTokens(Tokenizer(Framed).Tokens), "frames") is "value >= 0"
	Constraint.Parameter(HeaderTokens(Tokenizer("Run(frames Number)").Tokens), "frames") is ""
	Constraint.Parameter(HeaderTokens(Tokenizer("B(a Number with Step 0.5)").Tokens), "a") is ""
	mutable words = List(Mutable(Text))
	mutable isConstraint = false
	for Range(header.tokens.Index(parameter) + 1, header.ParametersEnd)
		let word = header.tokens(value)
		if (word is ",") and (header.Depth(value) is 1)
			return Text.Combine(words, " ").Replace(" . ", ".")
		words = isConstraint then words + word else words
		isConstraint = isConstraint or (word is "with") and (header.tokens(value + 1) is not "Step")
	Text.Combine(words, " ").Replace(" . ", ".")
Where(path Text, lines Texts) Texts
	Constraint.Where("A.strict", List(Text) + "has a Number where value > 0").First is Misnamed
	Constraint.Where("A.strict", List(Text) + "has a Number with value > 0").Length is 0
	for lines
		if (value.StartsWith("	") is false) and ("where" is in Tokenizer(value).Tokens)
			"ConstraintNeedsWith: where in " + path + ":" + (index + 1) + ", write " + value.Replace(" where ", " with ")