has inference TypeInference
constant Counting = DefaultCheck(TypeInference(KnownTypes.Sample, (Scope(("Limit", "Started"), ("3", "Count(1, 2)")), KnownTypes.NoMembers)))
constant Keywords = ("has", "constant", "let", "mutable", "if", "else", "for", "with", "return", "is", "in", "to", "and", "or", "xor", "not", "from", "then")
constant LoopVariables = ("value", "index", "outer")
constant Moving = List(Text) + "M(from Number) Number"
constant Countdown = ("Run Number", "\tmutable index = 3", "\tfor as long as index > 0", "\t\tindex", "\tindex")
constant Missed = List(Text) + "has c Count = Count.Missing"
constant Sized = List(Text) + "has size Count = Count(1, 2)"
constant Outside = ("Run", "\tfor 2", "\t\tlet outer = 1")
constant Shifting = ("Shifted(index Number) Numbers", "\tfor 2", "\t\tindex")
constant Methods = ("Run", "\tfor 2", "\t\t1", "\t1", "Other", "\t1", "Last", "\tfor 2", "\t\t1")
constant Defaulted = ("has b Text", "constant c = Text(other)", "Run", "\tlet d = Text(other)")
constant Declared = ("Run", "\tmutable outer = 1", "\tconstant outer = 1", "\tlet other = 1", "\tif outer", "\tlet", "constant outer = 1")
constant ValueMember = List(Text) + "has value Number"
constant Measuring = DefaultCheck(TypeInference(KnownTypes.Measured, (KnownTypes.NoMembers, KnownTypes.NoMembers)))
constant Coupled = DefaultCheck(Instantiation.Inferring)
constant Empty = (KnownTypes.NoMembers, KnownTypes.NoMembers, KnownTypes.NoMembers)
constant Kept = (Scope(("pair"), ("Couple")), Instantiation.Couples.members(0), Scope(("value"), ("Number")))
constant Keeping = DefaultCheck(TypeInference(KnownTypes(("Keeper", "Couple", "Valued"), Kept, Empty, Empty), List(Scope)))
constant Unstepped = "A:line 1: StepMustBeOnNumber: Numbers, only a Number is rounded to its step"
constant Paired = "A:line 1: GenericMemberTypeMustBeNamed: pair, name the type of each Generic member of Couple like has pair Couple(Number, Number)"
constant Recoupled = Paired.Replace("pair", "couple").Replace("line 1", "line 2")
constant Unlocated = Paired.Replace("A:line 1: ", "")
constant Named = ("has pair Couple(Text, Number)", "has name Text", "has first Generic", "has items Generics", "has other Couple(first, Generic)")
constant Typed = Named + ("constant Pair = Couple", "Swapped Couple", "\tCouple(1, 2)")
Unsupported(path Text, lines Texts) Texts
	Coupled.Unsupported("A", List(Text) + "has pair Couple").Length is 1
	Counting.Unsupported("A.strict", Moving).First is "A.strict:line 1: CannotUseKeywordsAsName: from"
	Counting.Unsupported("A.strict", Countdown).First is "A.strict:line 2: LoopNameMustNotBeDeclared: index"
	Counting.Unsupported("A.strict", Missed).First is "A.strict:line 1: ConstantNotFound: Count.Missing"
	Counting.Unsupported("A.strict", Shifting).First is "A.strict:line 1: LoopNameMustNotBeDeclared: index"
	Counting.Unsupported("A", List(Text) + "has value Number").Length is 1
	Counting.Unsupported("A", List(Text) + "L(prices Numbers with Step 0.5) Number").First is Unstepped
	let named = LoopNames(path, lines) + LoopParameters(path, lines) + Members(path, lines)
	Defaults(path, lines) + Keyworded(path, lines) + named + Steps(List(Text)).Unnumbered(path, lines)
Members(path Text, lines Texts) Texts
	Coupled.Members("A", ("has value Number", "has pair Couple")).Length is 2
	ValueMembers(path, lines) + OpenMembers(path, lines)
HasCheckedMembers(typeName Text) Boolean
	Keeping.HasCheckedMembers("Keeper") and Keeping.HasCheckedMembers("Valued")
	Keeping.HasCheckedMembers("Couple") is false
	let members = inference.types.MembersOf(typeName)
	for members.types
		if "Generic" is in inference.types.MembersOf(value).types
			return true
	"value" is in members.names
OpenMembers(path Text, lines Texts) Texts
	Coupled.OpenMembers("A", List(Text) + "has pair Couple").First is Paired
	Coupled.OpenMembers("A", ("has name Text", "has couple")).First is Recoupled
	Coupled.OpenMembers("A", Typed).Length is 0
	let shape = TypeShape(lines)
	for lines
		let isMember = shape.IsMemberLine(value) and (value.StartsWith("constant ") is false)
		let issue = isMember then Unnamed(HeaderTokens(Tokenizer(value).Tokens)) else ""
		if issue is not ""
			ResolveCheck.Located(path, index + 1, issue)
Unnamed(member HeaderTokens) Text
	Coupled.Unnamed(HeaderTokens("mutable", "pair", "Couple")) is Unlocated.Replace("has", "mutable")
	Counting.Unnamed(HeaderTokens("has", "count")) is ""
	let type = inference.types.BaseName(member.DeclaredType(1))
	mutable types = List(Mutable(Text))
	for inference.types.MembersOf(type).types
		if value is "Generic"
			types.Add("Number")
	let named = member.tokens(0) + " " + member.MemberName + " " + type + "(" + Text.Combine(types, ", ") + ")"
	let hint = ", name the type of each Generic member of " + type + " like " + named
	let isNamed = (types.Length is 0) or (Text.Combine(member.tokens, " ").IndexOf(type + " (") > 0)
	isNamed then "" else "GenericMemberTypeMustBeNamed: " + member.MemberName + hint
ValueMembers(path Text, lines Texts) Texts
	Counting.ValueMembers("A", ValueMember).First.StartsWith("A:line 1: MemberMustNotBeNamedValue: value")
	Counting.ValueMembers("A.strict", Sized).Length is 0
	Counting.ValueMembers("A", ValueMember).First.EndsWith(", value is the instance in every method")
	Counting.ValueMembers("A", ("Run", "\tlet value = 1")).Length is 0
	let shape = TypeShape(lines)
	for lines
		if shape.IsMemberLine(value) and (HeaderTokens(Tokenizer(value).Tokens).MemberName is "value")
			ResolveCheck.Located(path, index + 1, "MemberMustNotBeNamedValue: value, value is the instance in every method")
LoopNames(path Text, lines Texts) Texts
	Counting.LoopNames("A.strict", Moving).Length is 0
	Counting.LoopNames("A.strict", Outside).First is "A.strict:line 3: LoopNameMustNotBeDeclared: outer"
	Counting.LoopNames("A.strict", ("Run", "\tlet outer = 1")).First is "A.strict:line 2: LoopNameMustNotBeDeclared: outer"
	Counting.LoopNames("A.strict", Declared).Length is 2
	Counting.LoopNames("A.strict", Declared).Last is "A.strict:line 3: LoopNameMustNotBeDeclared: outer"
	for lines
		let tokens = Tokenizer(value.Trim).Tokens
		if IsDeclared(value) and IsLoopName(tokens(1), lines, index)
			ResolveCheck.Located(path, index + 1, "LoopNameMustNotBeDeclared: " + tokens(1))
IsDeclared(line Text) Boolean
	DefaultCheck.IsDeclared("\tmutable outer = 1")
	(DefaultCheck.IsDeclared("constant outer = 1") or DefaultCheck.IsDeclared("\tlet")) is false
	let tokens = Tokenizer(line.Trim).Tokens
	line.StartsWith("\t") and (tokens.Length > 1) and (tokens(0) is in ("let", "mutable", "constant"))
IsLoopName(name Text, lines Texts, position Number) Boolean
	DefaultCheck.IsLoopName("outer", ("Run", "\tlet outer = 1"), 1)
	DefaultCheck.IsLoopName("value", ("Twice(value Number) Number", "\tvalue * 2"), 0) is false
	DefaultCheck.IsLoopName("index", Countdown, 1)
	DefaultCheck.IsLoopName("other", Countdown, 1) is false
	DefaultCheck.HasLoop(Methods, 3) and (DefaultCheck.HasLoop(Methods, 5) is false)
	(name is in LoopVariables) and ((name is "outer") or HasLoop(lines, position))
HasLoop(lines Texts, position Number) Boolean
	DefaultCheck.HasLoop(Countdown, 1)
	DefaultCheck.HasLoop(("Twice(value Number) Number", "\tvalue * 2"), 1) is false
	mutable header = 0
	for Range(0, position + 1)
		if lines(value).StartsWith("\t") is false
			header = value
	for Range(header + 1, lines.Length)
		if lines(value).StartsWith("\t") is false
			return false
		if lines(value).Trim.StartsWith("for ")
			return true
	false
Keyworded(path Text, lines Texts) Texts
	Counting.Keyworded("A.strict", List(Text) + "Moved(other Number) Number").Length is 0
	Counting.Keyworded("A.strict", List(Text) + "has (from)").Length is 0
	mutable issues = List(Mutable(Text))
	for lines
		let line = index + 1
		if TypeShape(lines).IsMethodHeader(value)
			for HeaderTokens(Tokenizer(value).Tokens).ParameterNames
				if value is in Keywords
					issues.Add(ResolveCheck.Located(path, line, "CannotUseKeywordsAsName: " + value))
	issues
LoopParameters(path Text, lines Texts) Texts
	Counting.LoopParameters("A.strict", Moving).Length is 0
	Counting.LoopParameters("A.strict", ("Twice(value Number) Number", "\tvalue * 2")).Length is 0
	Counting.LoopParameters("A.strict", ("has (index)", "\tfor 2")).Length is 0
	Counting.LoopParameters("A.strict", ("S(index Number, other Number) Numbers", "\tfor 2", "\t\tindex")).Length is 1
	mutable issues = List(Mutable(Text))
	for lines
		let line = index + 1
		if TypeShape(lines).IsMethodHeader(value) and HasLoop(lines, index)
			for HeaderTokens(Tokenizer(value).Tokens).ParameterNames
				if value is in LoopVariables
					issues.Add(ResolveCheck.Located(path, line, "LoopNameMustNotBeDeclared: " + value))
	issues
Defaults(path Text, lines Texts) Texts
	Counting.Unsupported("A.strict", Sized).First.StartsWith("A.strict:line 1: UnsupportedDefault: size, ")
	Counting.Unsupported("A.strict", ("has a Number = 5", "has c Numbers = List(Number)")).Length is 0
	Counting.Unsupported("A.strict", List(Text) + "has b Text = Text(other)").Length is 1
	Counting.Defaults("A.strict", Defaulted).Length is 0
	let shape = TypeShape(lines)
	for lines
		let tokens = Tokenizer(value).Tokens
		let isDefault = shape.IsMemberLine(value) and (value.StartsWith("constant ") is false) and (tokens.Index("=") > 0)
		let issue = isDefault then Issue(tokens) else ""
		if issue is not ""
			ResolveCheck.Located(path, index + 1, issue)
Issue(tokens Texts) Text
	Counting.Issue(Tokenizer(Sized(0)).Tokens).EndsWith("pass it to the constructor")
	Counting.Issue(Tokenizer("has size Count = Count.Limit").Tokens) is ""
	Counting.Issue(Tokenizer("has size Count = Count.Started").Tokens) is ""
	Counting.Issue(Tokenizer("has a Number = 5 with value > 0").Tokens) is ""
	constant hint = ", only literals, constants, empty lists and dictionaries and types with one member can be defaults"
	let end = tokens.Index("with") > 0 then tokens.Index("with") else tokens.Length
	let node = SyntaxParser(tokens).ParseRange(tokens.Index("=") + 1, end)
	if (node.Kind is not "Member") and (IsConstant(node) is false)
		return "UnsupportedDefault: " + tokens(1) + hint + ", pass it to the constructor"
	Missing(node)
Missing(node SyntaxNode) Text
	Counting.Missing(SyntaxParser(Tokenizer("Count.Missing").Tokens).Parse) is "ConstantNotFound: Count.Missing"
	Counting.Missing(SyntaxParser(Tokenizer("Count.Limit").Tokens).Parse) is ""
	Counting.Missing(SyntaxParser(Tokenizer("Count.number").Tokens).Parse) is ""
	Counting.IsWrapper(SyntaxParser(Tokenizer("Number(Count(1, 2))").Tokens).Parse) is false
	let owner = node.Kind is "Member" then node.children(0).text else ""
	let isUnknown = inference.types.IsKnown(owner) and (inference.ConstantOf(owner, node.text) is "")
	let isMissing = isUnknown and (inference.types.MemberType(owner, node.text) is "Unknown")
	isMissing then "ConstantNotFound: " + owner + "." + node.text else ""
IsConstant(node SyntaxNode) Boolean
	Counting.IsConstant(SyntaxParser(Tokenizer("Count.Limit").Tokens).Parse)
	Counting.IsConstant(SyntaxParser(Tokenizer("-1 + 2").Tokens).Parse)
	Counting.IsConstant(SyntaxParser(Tokenizer("Count(1, 2)").Tokens).Parse) is false
	Counting.IsConstant(SyntaxParser(Tokenizer("Count.Started").Tokens).Parse) is false
	if node.Kind is "Member"
		return IsConstantMember(node)
	if node.IsLiteral or (node.Kind is "Identifier")
		return true
	if node.Kind is in ("Binary", "Negate")
		return IsConstant(node.children(0)) and IsConstant(node.children.Last)
	(node.Kind is "Call") and ((node.text is in ("List", "Dictionary")) or IsWrapper(node))
IsConstantMember(member SyntaxNode) Boolean
	Counting.IsConstantMember(SyntaxParser(Tokenizer("Count.Missing").Tokens).Parse)
	Counting.IsConstant(SyntaxParser(Tokenizer("other").Tokens).Parse)
	Counting.IsConstant(SyntaxParser(Tokenizer("1 + Count(1, 2)").Tokens).Parse) is false
	Counting.IsConstant(SyntaxParser(Tokenizer("Count(1, 2) + 1").Tokens).Parse) is false
	Counting.IsConstant(SyntaxParser(Tokenizer("-Count(1, 2)").Tokens).Parse) is false
	Counting.IsConstant(SyntaxParser(Tokenizer("Dictionary(Text, Number)").Tokens).Parse)
	let expression = inference.ConstantOf(member.children(0).text, member.text)
	expression is "" then true else IsConstant(SyntaxParser(Tokenizer(expression).Tokens).Parse)
IsWrapper(call SyntaxNode) Boolean
	Counting.IsWrapper(SyntaxParser(Tokenizer("Number(1)").Tokens).Parse)
	Counting.IsWrapper(SyntaxParser(Tokenizer("Count(1, 2)").Tokens).Parse) is false
	Counting.IsWrapper(SyntaxParser(Tokenizer("Number(List(Number))").Tokens).Parse)
	Counting.IsWrapper(SyntaxParser(Tokenizer("Count(1)").Tokens).Parse) is false
	Measuring.IsWrapper(SyntaxParser(Tokenizer("F(1)").Tokens).Parse)
	Counting.IsWrapper(SyntaxParser(Tokenizer("Number(List(Number), 1)").Tokens).Parse) is false
	Counting.IsWrapper(SyntaxParser(Tokenizer("Text(other)").Tokens).Parse) is false
	let isBase = call.text is in ("Number", "Text", "Boolean")
	let isNested = (call.children.Length is 1) and (call.children(0).Kind is "Call") and IsConstant(call.children(0))
	let isConstant = SyntaxNode("List", "", call.children).IsLiteral or isNested
	(isBase or inference.types.MembersOf(call.text).names.Length is 1) and isConstant