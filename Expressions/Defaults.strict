has lines Texts
constant Paired = Scope(("a", "b"), ("N", "M"))
constant Custom = Scope(List(Text) + "from", List(Text) + "c")
constant Pairs = Scope(List(Text) + "from", List(Text) + "x,y")
constant Kept = (Defaults(List(Text)).Constructors(Pairs, ("a", "b"), Paired), Defaults(List(Text)).Constructors(Custom, List(Text), Paired), Defaults(List(Text) + "has b Number = 0").Added(KnownTypes.NoMembers))
constant Joint = Defaults(List(Text)).Constructors(Custom, ("a", "b"), Paired).TypeAt("from", 0)
constant Zero = Scope(("b default"), ("0"))
constant Sampled = Defaults(("has x Number", "Add(a Number) Number", "\ta"))
constant Fresh = Defaults(List(Text)).Constructors(KnownTypes.NoMembers, ("a", "b"), Paired).names.Length
constant Adding = Defaults(("A(x Number) N", "\tx"))
constant Named = Scope(("A"), ("N"))
constant Widths = Defaults(List(Text) + "has width Number with value > 0")
constant Empty = Defaults(List(Text))
Added(scope Scope) Scope
	Defaults(("has a Number", "has b Number = 0", "constant C = 3")).Added(KnownTypes.NoMembers).names is ("b default")
	Defaults(List(Text) + "mutable count = 2 with value > 0").Added(KnownTypes.NoMembers).TypeOf("count default") is "2"
	Defaults(List(Text) + "has label = \"a with b\"").Added(KnownTypes.NoMembers).TypeOf("label default") is "\"a with b\""
	mutable names = List(Mutable(Text))
	mutable values = List(Mutable(Text))
	for lines
		let start = value.IndexOf(" = ")
		if (value.StartsWith("has ") or value.StartsWith("mutable ")) and start > 0
			let end = Constraint.WithStart(value) > start then Constraint.WithStart(value) else value.Length
			names.Add(HeaderTokens(Tokenizer(value).Tokens).MemberName + " default")
			values.Add(value.Substring(start + 3, end - start - 3))
	scope.WithAll(names, values)
Constructors(scope Scope, names Texts, members Scope) Scope
	Defaults(List(Text)).Constructors(Custom, ("a", "b"), Paired).TypeOf("from") is "c" and Kept is (Pairs, Custom, Zero)
	Defaults(List(Text)).Constructors(Custom, ("a", "b"), Paired).TypeAt("from types", 0) is "N,M" and Joint is "a,b"
	Defaults(List(Text)).Constructors(KnownTypes.NoMembers, ("a", "b"), Paired).TypeOf("from") is "a,b" and Fresh is 1
	if "from" is not in scope.names
		return scope.With("from", Text.Combine(names, ","))
	if names.Length is 0 or scope.TypeOf("from").Split(",").Length is names.Length
		return scope
	mutable types = List(Mutable(Text))
	for names
		types.Add(members.TypeOf(value))
	Scope(("from", "from types"), (Text.Combine(names, ","), Text.Combine(types, ","))).WithAll(scope.names, scope.types)
Parameters(methods Scope, isContract Boolean) Scope
	Defaults(("A(x Number) N", "\tx")).Parameters(Scope(("A"), ("N")), false).TypeOf("A types") is "Number"
	"\t types" is not in Defaults(("A(x Number) N", "\tx")).Parameters(Scope(("A"), ("N")), false).names
	mutable scope = isContract then Scope(List(Text) + " trait", List(Text) + "true") else Scope(List(Text), List(Text))
	let shape = TypeShape(lines)
	for lines
		if shape.IsMethodHeader(value)
			let entries = HeaderEntries(HeaderTokens(Tokenizer(value).Tokens), methods).Parameters
			scope = scope.WithAll(entries.names, entries.types)
	let added = Changes(lines).Added(Changes(lines, true).Added(Steps(List(Text)).Members(lines)))
	scope.WithAll(added.names, added.types)
Of(methods Scope, members Scope, names Texts) Scope
	Sampled.Of(Scope(("Add"), ("Number")), Scope(("x"), ("Number")), ("x")).TypeOf("from") is "x"
	" constrained" is not in Sampled.Of(Scope(("Add"), ("Number")), Scope(("x"), ("Number")), ("x")).names
	Widths.Of(KnownTypes.NoMembers, KnownTypes.NoMembers, List(Text)).TypeOf(" constrained") is "true"
	Adding.Parameters(Named, true).TypeOf(" trait") is "true" and Adding.Parameters(Named, false).TypeOf(" trait") is ""
	Defaults(("A(x Number) N", "\tA(1) is 1", "\tx")).Parameters(Named, false).TypeOf("A types") is "Number"
	let parameters = Added(Parameters(methods, TypeShape(lines).IsContract))
	let kind = Constraint.Kind(lines)
	Constructors(kind is "" then parameters else parameters.With(TypeShape.Constrained, kind), names, members)
ConstantScope(end Number) Scope
	Defaults(("constant A", "constant B = 10", "constant C")).ConstantScope(3).TypeOf("C") is "11"
	mutable names = List(Mutable(Text))
	mutable values = List(Mutable(Text))
	mutable next = 0
	for Constants(end)
		let literal = ConstantAt(value, next)
		next = NextEnum(value, next)
		if literal is not ""
			names.Add(value.Substring(9, value.Length - 9).Split(" ").First)
			values.Add(literal)
	Scope(names, values)
Constants(end Number) Texts
	Defaults(("has a Number", "constant A", "constant B")).Constants(2) is ("constant A")
	for lines.Slice(0, end)
		if value.StartsWith("constant ")
			value
ConstantAt(line Text, next Number) Text
	Defaults(List(Text)).ConstantAt("constant A", 3) is "3"
	Defaults(List(Text)).ConstantAt("constant A = ", 3) is ""
	Empty.ConstantAt("constant A = 5", 0) is "5" and Empty.ConstantAt("constant A=5", 0) is ""
	Defaults(("has a Number", "constant A = ", "constant Bb = 10")).ConstantScope(3).names is ("Bb")
	Empty.NextEnum("constant A = B", 4) is 4 and Empty.NextEnum("constant A =", 4) is 4
	if line.IndexOf("=") < 0
		return next to Text
	let equal = line.IndexOf(" = ")
	equal < 0 then "" else line.Substring(equal + 3, line.Length - equal - 3)
NextEnum(line Text, current Number) Number
	Defaults(List(Text)).NextEnum("constant A", 0) is 1
	Defaults(List(Text)).NextEnum("constant A = 10", 0) is 11
	if line.IndexOf("=") < 0
		return current + 1
	let tokens = Tokenizer(line).Tokens
	if tokens.Length > 3
		if SyntaxParser(tokens).Leaf(tokens(3)).Kind is "Number"
			return tokens(3) to Number + 1
	current