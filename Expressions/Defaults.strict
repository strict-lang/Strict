has lines Texts
constant Paired = Scope(("a", "b"), ("N", "M"))
constant Custom = Scope(List(Text) + "from", List(Text) + "c")
constant Pairs = Scope(List(Text) + "from", List(Text) + "x,y")
constant Kept = (Defaults(List(Text)).Constructors(Pairs, ("a", "b"), Paired), Defaults(List(Text)).Constructors(Custom, List(Text), Paired), Defaults(List(Text) + "has b Number = 0").Added(KnownTypes.NoMembers))
constant Joint = Defaults(List(Text)).Constructors(Custom, ("a", "b"), Paired).TypeAt("from", 0)
constant Zero = Scope(("b default"), ("0"))
constant Fresh = Defaults(List(Text)).Constructors(KnownTypes.NoMembers, ("a", "b"), Paired).names.Length
Added(scope Scope) Scope
	Defaults(("has a Number", "has b Number = 0", "constant C = 3")).Added(KnownTypes.NoMembers).names is ("b default")
	Defaults(List(Text) + "mutable count = 2 with value > 0").Added(KnownTypes.NoMembers).TypeOf("count default") is "2"
	mutable names = List(Mutable(Text))
	mutable values = List(Mutable(Text))
	for lines
		let start = value.IndexOf(" = ")
		if (value.StartsWith("has ") or value.StartsWith("mutable ")) and (start > 0)
			let end = value.IndexOf(" with ") > start then value.IndexOf(" with ") else value.Length
			names.Add(HeaderTokens(Tokenizer(value).Tokens).MemberName + " default")
			values.Add(value.Substring(start + 3, end - start - 3))
	scope.WithAll(names, values)
Constructors(scope Scope, names Texts, members Scope) Scope
	Defaults(List(Text)).Constructors(Custom, ("a", "b"), Paired).TypeOf("from") is "c" and (Kept is (Pairs, Custom, Zero))
	Defaults(List(Text)).Constructors(Custom, ("a", "b"), Paired).TypeAt("from types", 0) is "N,M" and (Joint is "a,b")
	Defaults(List(Text)).Constructors(KnownTypes.NoMembers, ("a", "b"), Paired).TypeOf("from") is "a,b" and (Fresh is 1)
	if "from" is not in scope.names
		return scope.With("from", Text.Combine(names, ","))
	if (names.Length is 0) or (scope.TypeOf("from").Split(",").Length is names.Length)
		return scope
	mutable types = List(Mutable(Text))
	for names
		types.Add(members.TypeOf(value))
	Scope(("from", "from types"), (Text.Combine(names, ","), Text.Combine(types, ","))).WithAll(scope.names, scope.types)