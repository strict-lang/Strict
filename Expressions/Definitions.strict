has lines Texts
constant Positions = Definitions(BodyParser.Positions)
constant Body = BodyParser(BodyParser.Positions).Block(1, 1)
constant Next = Body.children(1)
constant Assigned = SyntaxNode("Reassignment", "", (SyntaxNode("Identifier", "next"), SyntaxNode("Number", "5")))
constant Branch = SyntaxNode("If", "", (SyntaxNode("Identifier", "a"), Body))
constant NextTwo = SyntaxNode("Call", "next", List(SyntaxNode) + SyntaxNode("Number", "2"))
constant CallsNext = SyntaxNode("Call", "f", List(SyntaxNode) + SyntaxNode("Identifier", "next"))
constant Double = BodyParser(("Run", "\tdouble(x) = x * 2")).Block(1, 1).children(0)
constant Computed = SyntaxNode("Computed", "next", Next.children)
constant Unused = SyntaxNode("Body", "", (CallsNext, Next, SyntaxNode("Number", "1")))
constant Member = SyntaxNode("Reassignment", "", (SyntaxNode("Member", "b"), Body))
constant LetNext = SyntaxNode("Declaration", "let next", List(SyntaxNode) + SyntaxNode("Number", "5"))
constant Redeclared = BodyParser(("Run", "\tlet next = 1", "\tnext = 2")).Block(1, 1)
Inline(body SyntaxNode, start Number) SyntaxNode
	Positions.Inline(Body, 1).children.Length is 4
	Positions.Inline(Body, 1).children.Last to Text is "position + 2"
	Positions.Define(Next, List(Text), List(SyntaxNode)).Kind is "Computed"
	Positions.Define(Member, List(Text), List(SyntaxNode)).Kind is "Reassignment"
	Positions.Define(Member, List(Text), List(SyntaxNode) + SyntaxNode("Computed", "b")).Kind is "Reassignment"
	Positions.Expand(Redeclared, List(Text), List(SyntaxNode)).children.Last.Kind is "Reassignment"
	Positions.Define(SyntaxNode("Reassignment", "", (NextTwo, Body)), List(Text), List(SyntaxNode)).Kind is "Reassignment"
	Expand(body, Known(start), List(SyntaxNode))
Known(start Number) Texts
	Definitions(("has count Number", "Add(other Number) Number", "\tother")).Known(2) is ("count", "other", "value")
	Definitions(("has count Number", "Add(other Number) Number")).Known(0) is ("count", "value")
	header = start > 0 then HeaderTokens(Tokenizer(lines(start - 1)).Tokens).ParameterNames else List(Text)
	TypeShape(lines).MemberScope.names + header + "value"
Expand(body SyntaxNode, known Texts, definitions SyntaxNodes) SyntaxNode
	Positions.Expand(Body, ("value", "position"), List(SyntaxNode)).children(1) to Text is "position + 1"
	mutable names = known
	mutable computed = definitions
	mutable statements = List(Mutable(SyntaxNode))
	for body.children
		statement = Used(Substitute(Define(value, names, computed), computed), body, index)
		computed = statement.Kind is "Computed" then computed + statement else computed
		if statement.Kind is not "Computed"
			statements.Add(Nest(statement, names, computed))
		names = names + Declare(statement)
	SyntaxNode(body.Kind, body.text, statements, body.line)
Nest(statement SyntaxNode, known Texts, definitions SyntaxNodes) SyntaxNode
	Positions.Nest(Branch, List(Text), List(SyntaxNode)).children.Last.children.Length is 4
	Positions.Nest(SyntaxNode("If", "", (CallsNext, Body)), List(Text), List(SyntaxNode) + Next).children(0) is CallsNext
	mutable children = List(Mutable(SyntaxNode))
	for statement.children
		children.Add(value.Kind is "Body" then Expand(value, known, definitions) else value)
	SyntaxNode(statement.Kind, statement.text, children, statement.line)
Define(statement SyntaxNode, known Texts, definitions SyntaxNodes) SyntaxNode
	Positions.Define(Assigned, List(Text), List(SyntaxNode)).Kind is "Declaration"
	Positions.Define(Assigned, List(Text), List(SyntaxNode)).text is "let next"
	Positions.Define(Assigned, List(Text) + "next", List(SyntaxNode)).Kind is "Reassignment"
	Positions.Define(Assigned, List(Text), List(SyntaxNode) + Next).Kind is "Invalid"
	Positions.Define(Assigned, List(Text), List(SyntaxNode) + Next).text.StartsWith("ComputedNameMustNotBeAssigned")
	Positions.Define(SyntaxNode("Reassignment", "", Next.children), List(Text), List(SyntaxNode) + Next).Kind is "Invalid"
	if statement.Kind is "Declaration" and statement.text.StartsWith("let ")
		return Redefine(statement, known, definitions)
	if statement.Kind is not "Reassignment"
		return statement
	target = statement.children(0)
	if target.Kind is in ("Identifier", "Call") and target.text is in Names(definitions)
		return SyntaxNode("Invalid", "ComputedNameMustNotBeAssigned: " + target.text, List(SyntaxNode), statement.line)
	if target.Kind is "Identifier" and target.text is not in known
		return SyntaxNode("Declaration", "let " + target.text, List(SyntaxNode) + statement.children(1), statement.line)
	isNew = target.Kind is "Call" and target.text is not in known and AreNames(target.children)
	isNew then SyntaxNode("Computed", target.text, statement.children, statement.line) else statement
Redefine(declaration SyntaxNode, known Texts, definitions SyntaxNodes) SyntaxNode
	Positions.Redefine(LetNext, List(Text), List(SyntaxNode)).Kind is "Declaration"
	Positions.Redefine(LetNext, List(Text) + "next", List(SyntaxNode)).Kind is "Reassignment"
	name = Tokenizer(declaration.text).Tokens.Last
	if name is in Names(definitions)
		return SyntaxNode("Invalid", "ComputedNameMustNotBeAssigned: " + name, List(SyntaxNode), declaration.line)
	target = SyntaxNode("Identifier", name, List(SyntaxNode), declaration.line)
	reassigned = SyntaxNode("Reassignment", "", (target, declaration.children(0)), declaration.line)
	name is in known then reassigned else declaration
Used(statement SyntaxNode, body SyntaxNode, position Number) SyntaxNode
	Positions.Used(Computed, Body, 1) is Computed
	Positions.Used(Computed, SyntaxNode("Body", "", (Next, Branch)), 0) is Computed
	Positions.Used(Computed, Body, 4).Kind is "Invalid"
	Positions.Used(Computed, Unused, 1).text is "UnusedComputedNameMustBeRemoved: next"
	Positions.Used(Body.children(0), Body, 4) is Body.children(0)
	later = body.children.Slice(position + 1, body.children.Length - position - 1)
	if statement.Kind is not "Computed" or IsUsed(statement.text, later)
		return statement
	SyntaxNode("Invalid", "UnusedComputedNameMustBeRemoved: " + statement.text, List(SyntaxNode), statement.line)
IsUsed(name Text, nodes SyntaxNodes) Boolean
	Positions.IsUsed("next", List(SyntaxNode) + Branch)
	Positions.IsUsed("other", List(SyntaxNode) + Branch) is false
	Positions.IsUsed("next", List(SyntaxNode) + SyntaxNode("Text", "next")) is false
	for nodes
		if value.Kind is in ("Identifier", "Call") and value.text is name or IsUsed(name, value.children)
			return true
	false
Substitute(node SyntaxNode, definitions SyntaxNodes) SyntaxNode
	Positions.Substitute(NextTwo, List(SyntaxNode) + Next) to Text is "position + 2"
	Positions.Substitute(SyntaxNode("Identifier", "other"), List(SyntaxNode) + Next) to Text is "other"
	if node.Kind is in ("Reassignment", "Computed")
		return SyntaxNode(node.Kind, node.text, (node.children(0), Substitute(node.children(1), definitions)), node.line)
	mutable children = List(Mutable(SyntaxNode))
	for node.children
		children.Add(value.Kind is "Body" then value else Substitute(value, definitions))
	for definitions
		if node.Kind is in ("Identifier", "Call") and node.text is value.text
			applied = Apply(value, children)
			return SyntaxNode(applied.Kind, applied.text, applied.children, node.line)
	SyntaxNode(node.Kind, node.text, children, node.line)
Apply(definition SyntaxNode, arguments SyntaxNodes) SyntaxNode
	Positions.Apply(Next, List(SyntaxNode)) to Text is "position + 1"
	Positions.Apply(Next, List(SyntaxNode) + SyntaxNode("Identifier", "step")) to Text is "position + step"
	Positions.Apply(Double, List(SyntaxNode) + SyntaxNode("Number", "3")) to Text is "3 * 2"
	Positions.Apply(Double, List(SyntaxNode)) to Text is "x * 2"
	mutable bound = List(Mutable(SyntaxNode))
	for definition.children(0).children
		isDefault = value.Kind is "Reassignment"
		name = isDefault then value.children(0) else value
		argument = index < arguments.Length then arguments(index) else isDefault then value.children(1) else value
		bound.Add(SyntaxNode("", name.text, (name, argument)))
	Substitute(definition.children(1), bound)
Declare(statement SyntaxNode) Texts
	Positions.Declare(Body.children(0)) is ("position")
	Positions.Declare(Next).Length is 0
	Positions.Substitute(Assigned, List(SyntaxNode) + Next) is Assigned
	Positions.Substitute(Branch, List(SyntaxNode) + Next) is Branch
	Positions.Substitute(SyntaxNode("Text", "next"), List(SyntaxNode) + Next).Kind is "Text"
	statement.Kind is "Declaration" then List(Text) + Tokenizer(statement.text).Tokens.Last else List(Text)
Names(definitions SyntaxNodes) Texts
	Positions.Names(List(SyntaxNode) + Next) is ("next")
	for definitions
		value.text
AreNames(nodes SyntaxNodes) Boolean
	Positions.AreNames(List(SyntaxNode) + SyntaxNode("Identifier", "a"))
	Positions.AreNames(List(SyntaxNode) + SyntaxNode("Number", "1")) is false
	for nodes
		if value.Kind is not "Identifier"
			return false
	true