has inference TypeInference
constant Checked = SyntaxParser(Tokenizer("a is Error").Tokens).Parse
constant Compared = SyntaxParser(Tokenizer("a is 5").Tokens).Parse
constant Negated = SyntaxParser(Tokenizer("a is not Error").Tokens).Parse
constant Literal = SyntaxParser(Tokenizer("5 is Error").Tokens).Parse
constant Called = SyntaxNode("Call", "is", Checked.children)
constant NumberA = Scope(List(Text) + "a", List(Text) + "Number")
constant MixedA = Scope(List(Text) + "a", List(Text) + "Number or Text")
constant IsNumber = SyntaxParser(Tokenizer("a is Number").Tokens).Parse
Narrow(condition SyntaxNode, scope Scope, methods Scope) Scope
	ErrorNarrowing(MethodBodies.NoInference).Narrow(Checked, NumberA, NumberA).TypeOf("a") is "Error"
	ErrorNarrowing(MethodBodies.NoInference).Narrow(Compared, NumberA, NumberA).TypeOf("a") is "Number"
	ErrorNarrowing(MethodBodies.NoInference).Narrow(Negated, NumberA, NumberA).TypeOf("a") is "Number"
	ErrorNarrowing(MethodBodies.NoInference).Narrow(Literal, NumberA, NumberA) is NumberA
	ErrorNarrowing(MethodBodies.NoInference).Narrow(Called, NumberA, NumberA) is NumberA
	ErrorNarrowing(MethodBodies.NoInference).Narrow(IsNumber, MixedA, MixedA).TypeOf("a") is "Number"
	isChecked = condition.Kind is "Binary" and condition.text is "is" and condition.children(0).Kind is "Identifier"
	isError = isChecked and inference.TypeOf(condition.children(1), scope, methods) is "Error"
	tested = isChecked then condition.children(1).text else ""
	checkedType = isChecked then inference.TypeOf(condition.children(0), scope, methods) else ""
	isAlternative = checkedType.IndexOf(" or ") > 0 and tested is in checkedType.Split(" or ")
	narrowed = isError then "Error" else isAlternative then tested else ""
	narrowed is "" then scope else scope.With(condition.children(0).text, narrowed)