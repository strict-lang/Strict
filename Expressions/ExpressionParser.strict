has Method
ParseLine(line Text) Type
	ParseLine("not true is false").Name is "TypeComparison"
	ParseLine("not (false xor false)").Name is "NotExpression"
	ParseLine("value is other").Name is "TypeComparison"
	ParseTrimmedLine(line.Trim)
ParseTrimmedLine(trimmed Text) Type
	ParseTrimmedLine("not true").Name is "NotExpression"
	let thenIndex = trimmed.IndexOf(" " + "then" + " ")
	let isIndex = trimmed.IndexOf(" " + "is" + " ")
	if thenIndex is not -1
		return Type("IfExpression")
	if isIndex is not -1
		return Type("TypeComparison")
	if trimmed.StartsWith("not ")
		return Type("NotExpression")
	if IsBinary(trimmed)
		return Type("Binary")
	IsBooleanLiteral(trimmed) then Type("BooleanExpression") else Type("VariableCall")
IsBooleanLiteral(trimmed Text) Boolean
	IsBooleanLiteral("true") is true
	if trimmed is "true"
		return true
	if trimmed is "false"
		return true
	false
IsBinary(trimmed Text) Boolean
	IsBinary("left and right") is true
	if trimmed.IndexOf(" and ") is not -1
		return true
	if trimmed.IndexOf(" or ") is not -1
		return true
	if trimmed.IndexOf(" xor ") is not -1
		return true
	false
