has inference TypeInference
has known Texts
constant NoScope = Scope(("x", "z"), ("y", "w"))
constant NoScopes = (NoScope, NoScope)
constant NoInference = TypeInference(KnownTypes(("A", "B"), NoScopes, NoScopes, NoScopes), NoScopes)
constant Counting = FileCheck(TypeInference(KnownTypes.Sample, (KnownTypes.NoMembers, KnownTypes.NoMembers)), ("Count", "Text"))
constant LimitTypes = KnownTypes(List(Text) + "Count", List(Scope) + Scope(("number", "Limit"), ("Number", "Number")), List(Scope) + KnownTypes.NoMembers, List(Scope) + KnownTypes.NoMembers)
constant Limiting = FileCheck(TypeInference(LimitTypes, List(Scope) + Scope("Limit", "3")), List(Text) + "Count")
constant Counted = Scope(List(Text) + "count", List(Text) + "Count")
constant TwiceCall = ScopedStatement(SyntaxParser(Tokenizer("count.Twice").Tokens).Parse, Counted, 0)
constant MissingCall = ScopedStatement(SyntaxParser(Tokenizer("count.Missing").Tokens).Parse, Counted, 0)
constant Untested = ("Twice(number Number) Number", "\tTwice(2) is 4")
constant OtherName = ScopedStatement(SyntaxParser(Tokenizer("count + other").Tokens).Parse, Counted, 0)
constant RequiredTwice = KnownTypes(List(Text) + "Count", List(Scope) + KnownTypes.NoMembers, List(Scope) + Scope(List(Text) + "Twice", List(Text) + "Count"), List(Scope) + Scope(("Twice", "Twice required"), ("times", "1")))
constant Requiring = FileCheck(TypeInference(RequiredTwice, List(Scope) + KnownTypes.NoMembers), ("Count", "Text"))
constant HiddenCall = SyntaxParser(Tokenizer("Count.Missing").Tokens).Parse
constant Flagged = Scope(List(Text) + "flag", List(Text) + "Boolean")
constant FlagLoop = ScopedStatement(StatementParser(Tokenizer("for flag").Tokens).ParseStatement, Flagged, 0)
constant WhileFlag = ScopedStatement(StatementParser(Tokenizer("for as long as flag").Tokens).ParseStatement, Flagged, 0)
constant OtherLoop = ScopedStatement(StatementParser(Tokenizer("for other").Tokens).ParseStatement, Flagged, 0)
constant TextLoop = ScopedStatement(StatementParser(Tokenizer("for \"ab\"").Tokens).ParseStatement, Flagged, 0)
constant CountLoop = ScopedStatement(StatementParser(Tokenizer("for count").Tokens).ParseStatement, Counted, 0)
constant Increment = ScopedStatement(SyntaxParser(Tokenizer("count.Increment").Tokens).Parse, Counted.With(" dropped", "dropped"), 0)
constant Numbered = ScopedStatement(SyntaxParser(Tokenizer("number").Tokens).Parse, Scope("value", "Count"), 0)
constant Enumerating = FileCheck(TypeInference(KnownTypes(("A", "B"), KnownTypes.NoMemberPair, NoScopes, NoScopes), NoScopes), "A")
constant ForMethod = Scope(List(Text) + "for", List(Text) + "Numbers")
constant Loops = KnownTypes(("Count", "Text"), KnownTypes.NoMemberPair, (ForMethod, KnownTypes.NoMembers), KnownTypes.NoMemberPair)
constant Looping = FileCheck(TypeInference(Loops, KnownTypes.NoMemberPair), "Count")
constant HiddenBody = SyntaxNode("For", "", List(SyntaxNode) + SyntaxNode("Body", "", List(SyntaxNode) + MissingCall.statement))
constant Requirements = Scope(("Twice required", "Twice required", "Twice required"), ("2", "1", "3"))
constant SelfCounted = Counted.With("self type", "Count")
constant Owning = Counted.With("Count", "Count")
constant Lists = KnownTypes(("List", "Generic"), KnownTypes.NoMemberPair, KnownTypes.NoMemberPair, KnownTypes.NoMemberPair)
constant Listing = FileCheck(TypeInference(Lists, NoScopes), "A")
constant Boxes = KnownTypes(List(Text) + "Box", List(Scope) + Scope(List(Text) + "first", List(Text) + "Generic"), List(Scope) + KnownTypes.NoMembers, List(Scope) + KnownTypes.NoMembers)
constant Boxing = FileCheck(TypeInference(Boxes, NoScopes), "A")
constant TextMissing = SyntaxNode("Member", "Missing", List(SyntaxNode) + SyntaxNode("Text", "Count"))
constant HeldTypes = KnownTypes(("Box", "Count"), (Counted, KnownTypes.CountMembers), (KnownTypes.NoMembers, KnownTypes.CountMethods), (KnownTypes.NoMembers, KnownTypes.CountParameters))
constant Held = FileCheck(TypeInference(HeldTypes, NoScopes), ("Box", "Count"))
constant RequiredThrice = KnownTypes(RequiredTwice.names, RequiredTwice.members, RequiredTwice.methods, List(Scope) + Requirements)
Unknown(scoped ScopedStatement, current Scope) Text
	Counting.Unknown(TwiceCall, KnownTypes.NoMembers) is ""
	Counting.Unknown(MissingCall, KnownTypes.NoMembers) is "MethodNotFound: Count.Missing"
	Counting.Unknown(OtherName, KnownTypes.NoMembers) is "NameNotFound: other"
	Counting.Unknown(FlagLoop, KnownTypes.NoMembers).StartsWith("NotIterable: flag is a Boolean")
	if scoped.statement.Kind is "Invalid"
		return scoped.statement.text
	names = UnknownNames(scoped.statement, known + scoped.scope.names + ValueNames(scoped.scope))
	if names.Length > 0
		return "NameNotFound: " + names.First
	methods = UnknownMethods(scoped.statement, scoped.scope, current)
	iterable = methods.Length > 0 then methods.First else NotIterable(scoped, current)
	iterable is not "" then iterable else MutatingCheck(inference).Issue(scoped, current)
NotIterable(scoped ScopedStatement, current Scope) Text
	Counting.NotIterable(FlagLoop, KnownTypes.NoMembers) is "NotIterable: flag is a Boolean, use for as long as flag"
	Counting.NotIterable(TwiceCall, KnownTypes.NoMembers) is ""
	Counting.NotIterable(ScopedStatement(SyntaxNode("For", ""), Counted, 0), Counted) is ""
	loop = scoped.statement
	if loop.Kind is not "For" or loop.HasValue is false or loop.text is "for as long as"
		return ""
	type = inference.TypeOf(loop.children(0), scoped.scope, current)
	if IsIterable(type) or type is in ("Unknown", "Generic", "Generics")
		return ""
	hint = type is "Boolean" then ", use for as long as " + loop.children(0) else ""
	"NotIterable: " + loop.children(0) + " is a " + type + hint
IsIterable(type Text) Boolean
	Counting.IsIterable("Text")
	Counting.IsIterable("Boolean") is false
	Counting.IsIterable("Count") is false
	Counting.Unknown(ScopedStatement(SyntaxNode("Invalid", "Broken: x"), Counted, 0), Counted) is "Broken: x"
	Enumerating.IsIterable("A") and Looping.IsIterable("Count")
	Counting.NotIterable(WhileFlag, Flagged) is "" and Counting.NotIterable(OtherLoop, Flagged) is ""
	Counting.NotIterable(TextLoop, Flagged) is ""
	Counting.NotIterable(CountLoop, Counted) is "NotIterable: count is a Count"
	element = inference.types.ElementType(type)
	iterated = inference.types.ElementType(inference.types.MethodsOf(type).TypeOf("for"))
	element is not "Unknown" or iterated is not "Unknown" or inference.Enumerated(type).Length > 0
UnknownMethods(node SyntaxNode, scope Scope, current Scope) Texts
	Counting.UnknownMethods(MissingCall.statement, Counted, KnownTypes.NoMembers) is ("MethodNotFound: Count.Missing")
	mutable unknown = UnknownMembers(node)
	issue = MethodIssue(node, scope, current)
	if issue is not ""
		unknown = unknown + issue
	narrowed = node.text is "then" then ErrorNarrowing(inference).Narrowed(node.children(0), scope, current) else scope
	for node.children
		if value.Kind is not "Body"
			unknown = unknown + UnknownMethods(value, narrowed, current)
	unknown
MethodIssue(node SyntaxNode, scope Scope, current Scope) Text
	Counting.MethodIssue(MissingCall.statement, Counted, KnownTypes.NoMembers) is "MethodNotFound: Count.Missing"
	Counting.MethodIssue(TwiceCall.statement, Counted, KnownTypes.NoMembers) is ""
	Counting.Unknown(Numbered, Counted).StartsWith("Name") is false
	Counting.Unknown(Increment, Counted) is not ""
	Counting.UnknownMethods(HiddenBody, Counted, Counted).Length is 0
	Counting.CallIssue(HiddenCall, Counted, KnownTypes.NoMembers) is "MethodNotFound: Count.Missing"
	Counting.MethodIssue(Counting.Parsed("1 > 0 and (count)"), Counted, Counted).StartsWith("LogicalOperandIsAList")
	Counting.MethodIssue(Counting.Parsed("Count.Twice"), SelfCounted, Owning).StartsWith("AmbiguousName")
	Held.MethodIssue(Held.Parsed("Twice(1, 2, 3)"), Counted.With("self type", "Box"), Counted).StartsWith("NoOverloadFits")
	hidden = HiddenType(inference).Ambiguous(node, scope, current) + HiddenType(inference).Issue(node, scope, current)
	called = IsCall(node) then CallIssue(node, scope, current) else ""
	typed = called is "" then ArgumentTypes(inference).Checked(node, scope, current) else called
	hidden is "" then typed else hidden
CallIssue(call SyntaxNode, scope Scope, current Scope) Text
	Counting.CallIssue(MissingCall.statement, Counted, KnownTypes.NoMembers) is "MethodNotFound: Count.Missing"
	Requiring.CallIssue(TwiceCall.statement, Counted, KnownTypes.NoMembers) is "ArgumentMissing: Count.Twice got 0 of 1"
	Counting.CallIssue(HiddenCall, Counted, Scope(List(Text) + "Count", List(Text) + "Text")).EndsWith("use outer.Count")
	Limiting.CallIssue(Counting.Parsed("count.Limit(1)"), Counted, KnownTypes.NoMembers) is "MethodNotFound: Count.Limit"
	instance = inference.TypeOf(call.children(0), scope, current)
	hidden = call.children(0).text
	isHidden = call.children(0).Kind is "Identifier" and inference.types.IsKnown(hidden) and instance is not hidden
	hint = isHidden then HiddenType.Hint(inference.Origin(hidden, scope), hidden) else ""
	isScalar = call.children.Length > 1 then ConstantCalls(inference).IsScalar(instance, call.text) else false
	if IsMissing(instance, call.text) or isScalar
		return "MethodNotFound: " + instance + "." + call.text + hint
	fewest = Fewest(instance, call.text)
	issue = "ArgumentMissing: " + instance + "." + call.text + " got " + (call.children.Length - 1) + " of " + fewest
	fewest > call.children.Length - 1 then issue else ""
Fewest(instance Text, name Text) Number
	Requiring.Fewest("Count", "Twice") is 1
	Counting.Fewest("Count", "Twice") is 0
	FileCheck(TypeInference(RequiredThrice, NoScopes), "Count").Fewest("Count", "Twice") is 1
	scope = inference.types.ParameterScope(instance)
	mutable fewest = -1
	for scope.names
		if value is name + " required"
			required = scope.types(index) to Number
			fewest = fewest < 0 or required < fewest then required else fewest
	fewest.Maximum(0)
UnknownMembers(call SyntaxNode) Texts
	Counting.UnknownMembers(SyntaxParser(Tokenizer("c + cs").Tokens).Parse).Length is 0
	Counting.UnknownMembers(SyntaxParser(Tokenizer("c.Count(size = 2)").Tokens).Parse).Length is 0
	Counting.UnknownMembers(SyntaxParser(Tokenizer("Count(c, number = 2)").Tokens).Parse).Length is 0
	Counting.UnknownMembers(SyntaxParser(Tokenizer("Count(c, size = 2)").Tokens).Parse) is ("MemberNotFound: Count.size")
	Counting.UnknownMembers(SyntaxParser(Tokenizer("c in cs").Tokens).Parse) is ("InMustFollowIs: write c is in cs")
	Counting.UnknownMembers(SyntaxNode("Member", "in")).Length is 0
	if call.Kind is "Binary" and call.text is "in"
		return List(Text) + ("InMustFollowIs: write " + call.children(0) + " is in " + call.children(1))
	members = inference.types.MembersOf(call.text).names
	for call.children
		if call.Kind is "Call" and value.Kind is "Reassignment" and value.children(0).text is not in members
			"MemberNotFound: " + call.text + "." + value.children(0).text
IsCall(node SyntaxNode) Boolean
	Counting.IsCall(SyntaxParser(Tokenizer("count.Twice(1)").Tokens).Parse)
	Counting.IsCall(SyntaxParser(Tokenizer("Count(c)").Tokens).Parse) is false
	Counting.IsCall(SyntaxNode("Member", "Twice")) is false
	Counting.IsCall(SyntaxParser(Tokenizer("count.value").Tokens).Parse) is false
	Counting.IsCall(SyntaxParser(Tokenizer("count.index").Tokens).Parse) is false
	Counting.IsCall(MissingCall.statement)
	Counting.IsCall(OtherName.statement) is false
	Counting.IsCall(SyntaxNode("Member", "1", MissingCall.statement.children)) is false
	isNamed = node.text.Length > 0 and node.text(0).Upper is not node.text(0).Lower
	isMember = node.Kind is in ("Member", "MethodCall") and node.children.Length > 0
	isMember and isNamed and node.text is not in ("value", "index")
IsMissing(instance Text, name Text) Boolean
	Counting.IsMissing("Generics", "number") is false
	Counting.IsMissing("Xyz", "number") is false
	Counting.IsMissing("Count", "Missing")
	Counting.IsMissing("Count", "Twice") is false
	Counting.IsMissing("Generic", "number") is false
	FileCheck(TypeInference(KnownTypes.Options, NoScopes), "Text").IsMissing("Text", "Parsed")
	FileCheck(TypeInference(KnownTypes.Options, NoScopes), "Text").IsMissing("Settings", "Parsed") is false
	Listing.IsMissing("Generic", "number") is false and Listing.IsMissing("List(Text, Number)", "Key") is false
	Boxing.IsMissing("Box", "first") is false
	types = inference.types
	isChecked = types.IsKnown(types.BaseName(instance)) and instance is not in ("Generic", "Generics")
	isChecked and types.DeclaredType(instance, name, 3) is "" and types.MemberType(instance, name) is "Unknown"
ValueNames(scope Scope) Texts
	FileCheck(NoInference, ("N", "R")).ValueNames(NoScope).Length is 0
	Counting.ValueNames(Scope(List(Text) + "value", List(Text) + "Count")) is ("number", "unused", "Increment", "Twice")
	Counting.IsMissing("Count", "number") is false
	Counting.IsMissing("Text", "Missing")
	Counting.CallIssue(TextMissing, Counted, Counted) is "MethodNotFound: Text.Missing"
	inference.types.ShapeScope(scope.TypeOf("value")).names
UnknownNames(statement SyntaxNode, names Texts) Texts
	Counting.IsUnimplemented(("Add Number", "\tAdd is 1"), 0, "A")
	Counting.IsUnimplemented(("Add(other) Number", "\tAdder(1) is 1"), 0, "A") is false
	Counting.IsUnimplemented(("Add(other) Number", "\tA(1).Other.Add(2) is 3"), 0, "A") is false
	Counting.IsUnimplemented(("Add(other) Number", "\tAb(1).Add(2) is 3"), 0, "A") is false
	Counting.IsUnimplemented(("Add(other) Number", "\tA(1).Add(2) is 3"), 0, "A")
	FileCheck(NoInference, ("N", "R")).UnknownNames(SyntaxNode("Identifier", "c"), ("a", "b")) is ("c")
	for statement.HeadNames
		if not IsKnown(value, names)
			value
IsKnown(name Text, names Texts) Boolean
	IsKnown("ab", List(Text) + "a") is false
	IsKnown("Numbers", ("Number", "a"))
	IsKnown("logger", ("Number", "a"))
	IsKnown("b", ("Number", "a")) is false
	if name is "logger" or name is in names
		return true
	name.EndsWith("s") is false then false else name.Substring(0, name.Length - 1) is in names
Unimplemented(path Text, lines Texts) Texts
	Counting.Unimplemented("A.strict", Untested + "\tTwice(3) is 6").Length is 1
	Counting.Unimplemented("A.strict", Untested) is ("A.strict:line 1: ImplementationNotFound: Twice")
	Counting.Unimplemented("A.strict", Untested + "\tnumber * 2").Length is 0
	Counting.Unimplemented("A.strict", ("from(number)", "\tA(2) is A(2)")).Length is 1
	Counting.Unimplemented("A.strict", List(Text) + "constant Ones = A(1) is A(1)").Length is 0
	Counting.Unimplemented("A.strict", ("from", "\tA(2) is A(2)")).Length is 0
	Counting.Unimplemented("A.strict", ("Twice(number Number) Number", "\tA(3).Twice(2) is 6")).Length is 1
	Counting.Unimplemented("A.strict", ("Run", "\t1", "", "\t2")).Length is 0
	typeName = Path(path).FileName.RemoveExtension.text
	for lines
		if value.StartsWith("\t") is false and IsUnimplemented(lines, index, typeName)
			ResolveCheck.Located(path, index + 1, "ImplementationNotFound: " + Tokenizer(value).Tokens.First)
IsUnimplemented(lines Texts, header Number, typeName Text) Boolean
	Counting.IsUnimplemented(("Add(other) Number", "\tAdd(1) > 0 is true"), 0, "A")
	Counting.IsUnimplemented(("Add(other) Number", "\tA.Add(1) is 1"), 0, "A")
	Counting.IsUnimplemented(("Add(other) Number", "\tother + 1"), 0, "A") is false
	lastLine = LastLine(lines, header)
	if lastLine is header or lines(header) is in ("from", "") or TypeShape(lines).IsMemberLine(lines(header))
		return false
	last = lines(lastLine).Trim
	called = lines(header).StartsWith("from") then typeName else Tokenizer(lines(header)).Tokens.First
	isComparison = last.IndexOf(" is ") > 0 or last.IndexOf(" < ") > 0 or last.IndexOf(" > ") > 0
	isCalled = last.StartsWith(called + "(") or last.StartsWith(called + " ")
	isInstance = last.StartsWith(typeName + "(") and last.IndexOf(")." + called) > 0
	isComparison and (isCalled or isInstance or last.StartsWith(typeName + "." + called))
LastLine(lines Texts, header Number) Number
	Counting.IsUnimplemented(List(Text) + "Add(1) is 2", 0, "A") is false
	Counting.IsUnimplemented(("Add(other) Number", "\tAdd(1) < 2"), 0, "A")
	Counting.IsUnimplemented(("Add(other) Number", "\tAdd(1) > 0"), 0, "A")
	Counting.IsUnimplemented(("Add(other) Number", "\tAdd(1)"), 0, "A") is false
	Counting.LastLine(("Add(other) Number", "\tother", "Run", "\t1"), 0) is 1
	Counting.LastLine(List(Text) + "has number", 0) is 0
	mutable last = header
	for Range(header + 1, lines.Length)
		if lines(value).StartsWith("\t") is false
			return last
		last = value
	last
Problem(lines Texts, broken Number) Text
	Counting.Problem(("Run", "	1 +"), 1) is "ParsingFailed: 1 +"
	Counting.Problem(("Run", "	let a = for 3"), 1).StartsWith("ForWithBodyOnlyAsMethodResult: let a = for 3, ")
	Counting.Problem(("has number", "Run", "	1", "", "	2"), 3) is "EmptyLineIsNotAllowed: remove it"
	Counting.Problem(("", "Run"), 0) is "EmptyLineIsNotAllowed: remove it"
	Counting.Unimplemented("A.strict", ("Run", "\tA.\t", "\tA.\t is 1")).Length is 0
	Counting.IsUnimplemented(("has number", "\thas 1 is 1"), 0, "A") is false
	lines(broken).Trim is "" then "EmptyLineIsNotAllowed: remove it" else StatementParser.Problem(lines(broken).Trim)
Parsed(code Text) SyntaxNode
	Counting.UnknownMethods(Parsed("count is Error then count.Missing else 1"), Counted, KnownTypes.NoMembers).Length is 0
	Counting.UnknownMethods(Parsed("count is Error then 1 else count.Missing"), Counted, KnownTypes.NoMembers).Length is 1
	Counting.UnknownMethods(Parsed("count is Error or count.Missing"), Counted, KnownTypes.NoMembers).Length is 1
	Counting.Parsed("1").Kind is "Number"
	SyntaxParser(Tokenizer(code).Tokens).Parse