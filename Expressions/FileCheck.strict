has inference TypeInference
has known Texts
constant NoScope = Scope(("x", "z"), ("y", "w"))
constant NoScopes = (NoScope, NoScope)
constant NoInference = TypeInference(KnownTypes(("A", "B"), NoScopes, NoScopes, NoScopes), NoScopes)
constant Counting = FileCheck(TypeInference(KnownTypes.Sample, (KnownTypes.NoMembers, KnownTypes.NoMembers)), ("Count", "Text"))
constant Counted = Scope(List(Text) + "count", List(Text) + "Count")
constant TwiceCall = ScopedStatement(SyntaxParser(Tokenizer("count.Twice").Tokens).Parse, Counted, 0)
constant MissingCall = ScopedStatement(SyntaxParser(Tokenizer("count.Missing").Tokens).Parse, Counted, 0)
constant Untested = ("Twice(number Number) Number", "\tTwice(2) is 4")
constant OtherName = ScopedStatement(SyntaxParser(Tokenizer("count + other").Tokens).Parse, Counted, 0)
constant Requiring = FileCheck(TypeInference(KnownTypes(List(Text) + "Count", List(Scope) + KnownTypes.NoMembers, List(Scope) + Scope(List(Text) + "Twice", List(Text) + "Count"), List(Scope) + Scope(("Twice", "Twice required"), ("times", "1"))), List(Scope) + KnownTypes.NoMembers), ("Count", "Text"))
constant HiddenCall = SyntaxParser(Tokenizer("Count.Missing").Tokens).Parse
constant Flagged = Scope(List(Text) + "flag", List(Text) + "Boolean")
constant FlagLoop = ScopedStatement(StatementParser(Tokenizer("for flag").Tokens).ParseStatement, Flagged, 0)
Unknown(scoped ScopedStatement, current Scope) Text
	Counting.Unknown(TwiceCall, KnownTypes.NoMembers) is ""
	Counting.Unknown(MissingCall, KnownTypes.NoMembers) is "MethodNotFound: Count.Missing"
	Counting.Unknown(OtherName, KnownTypes.NoMembers) is "NameNotFound: other"
	Counting.Unknown(FlagLoop, KnownTypes.NoMembers).StartsWith("NotIterable: flag is a Boolean") is true
	if scoped.statement.Kind is "Invalid"
		return scoped.statement.text
	let names = UnknownNames(scoped.statement, known + scoped.scope.names + ValueNames(scoped.scope))
	if names.Length > 0
		return "NameNotFound: " + names.First
	let methods = UnknownMethods(scoped.statement, scoped.scope, current)
	let iterable = methods.Length > 0 then methods.First else NotIterable(scoped, current)
	iterable is not "" then iterable else MutatingCheck(inference).Issue(scoped, current)
NotIterable(scoped ScopedStatement, current Scope) Text
	Counting.NotIterable(FlagLoop, KnownTypes.NoMembers) is "NotIterable: flag is a Boolean, use for as long as flag"
	Counting.NotIterable(TwiceCall, KnownTypes.NoMembers) is ""
	let loop = scoped.statement
	if (loop.Kind is not "For") or (loop.HasValue is false) or (loop.text is "for as long as")
		return ""
	let type = inference.TypeOf(loop.children(0), scoped.scope, current)
	let element = inference.types.ElementType(type)
	let iterated = inference.types.ElementType(inference.types.MethodsOf(type).TypeOf("for"))
	if (element is not "Unknown") or (iterated is not "Unknown") or (type is in ("Unknown", "Generic", "Generics"))
		return ""
	let hint = type is "Boolean" then ", use for as long as " + loop.children(0) else ""
	"NotIterable: " + loop.children(0) + " is a " + type + hint
UnknownMethods(node SyntaxNode, scope Scope, current Scope) Texts
	Counting.UnknownMethods(MissingCall.statement, Counted, KnownTypes.NoMembers) is ("MethodNotFound: Count.Missing")
	mutable unknown = UnknownMembers(node)
	let hidden = HiddenType(inference).Ambiguous(node, scope, current) + HiddenType(inference).Issue(node, scope, current)
	let called = IsCall(node) then CallIssue(node, scope, current) else ""
	let typed = called is "" then ArgumentTypes(inference).Issue(node, scope, current) else called
	let issue = hidden is "" then typed else hidden
	if issue is not ""
		unknown = unknown + issue
	for node.children
		if value.Kind is not "Body"
			unknown = unknown + UnknownMethods(value, scope, current)
	unknown
CallIssue(call SyntaxNode, scope Scope, current Scope) Text
	Counting.CallIssue(MissingCall.statement, Counted, KnownTypes.NoMembers) is "MethodNotFound: Count.Missing"
	Requiring.CallIssue(TwiceCall.statement, Counted, KnownTypes.NoMembers) is "ArgumentMissing: Count.Twice got 0 of 1"
	Counting.CallIssue(HiddenCall, Counted, Scope(List(Text) + "Count", List(Text) + "Text")).EndsWith("use outer.Count")
	let instance = inference.TypeOf(call.children(0), scope, current)
	let hidden = call.children(0).text
	let isHidden = (call.children(0).Kind is "Identifier") and inference.types.IsKnown(hidden) and (instance is not hidden)
	let hint = isHidden then HiddenType.Hint(hidden) else ""
	if IsMissing(instance, call.text)
		return "MethodNotFound: " + instance + "." + call.text + hint
	let fewest = Fewest(instance, call.text)
	let issue = "ArgumentMissing: " + instance + "." + call.text + " got " + (call.children.Length - 1) + " of " + fewest
	fewest > call.children.Length - 1 then issue else ""
Fewest(instance Text, name Text) Number
	Requiring.Fewest("Count", "Twice") is 1
	Counting.Fewest("Count", "Twice") is 0
	let scope = inference.types.ParameterScope(instance)
	mutable fewest = -1
	for scope.names
		if value is name + " required"
			let required = scope.types(index) to Number
			fewest = (fewest < 0) or (required < fewest) then required else fewest
	fewest < 0 then 0 else fewest
UnknownMembers(call SyntaxNode) Texts
	Counting.UnknownMembers(SyntaxParser(Tokenizer("Count(c, number = 2)").Tokens).Parse).Length is 0
	Counting.UnknownMembers(SyntaxParser(Tokenizer("Count(c, size = 2)").Tokens).Parse) is ("MemberNotFound: Count.size")
	let members = inference.types.MembersOf(call.text).names
	for call.children
		if (call.Kind is "Call") and (value.Kind is "Reassignment") and (value.children(0).text is not in members)
			"MemberNotFound: " + call.text + "." + value.children(0).text
IsCall(node SyntaxNode) Boolean
	Counting.IsCall(MissingCall.statement) is true
	Counting.IsCall(OtherName.statement) is false
	let isNamed = (node.text.Length > 0) and (node.text.Substring(0, 1).Upper is not node.text.Substring(0, 1).Lower)
	let isMember = (node.Kind is in ("Member", "MethodCall")) and (node.children.Length > 0)
	isMember and isNamed and (node.text is not in ("value", "index"))
IsMissing(instance Text, name Text) Boolean
	Counting.IsMissing("Count", "Missing") is true
	Counting.IsMissing("Count", "Twice") is false
	Counting.IsMissing("Generic", "number") is false
	let types = inference.types
	let isChecked = types.IsKnown(types.BaseName(instance)) and (instance is not in ("Generic", "Generics"))
	isChecked and (types.DeclaredType(instance, name, 3) is "") and (types.MemberType(instance, name) is "Unknown")
ValueNames(scope Scope) Texts
	FileCheck(NoInference, ("N", "R")).ValueNames(NoScope).Length is 0
	if scope.TypeOf("value") is ""
		return List(Text)
	let valueScope = inference.types.ShapeScope(scope.TypeOf("value"))
	valueScope.names
UnknownNames(statement SyntaxNode, names Texts) Texts
	FileCheck(NoInference, ("N", "R")).UnknownNames(SyntaxNode("Identifier", "c"), ("a", "b")) is ("c")
	for statement.HeadNames
		if not IsKnown(value, names)
			value
IsKnown(name Text, names Texts) Boolean
	IsKnown("Numbers", ("Number", "a")) is true
	IsKnown("b", ("Number", "a")) is false
	if name is in names
		return true
	if name.Substring(name.Length - 1, 1) is not "s"
		return false
	name.Substring(0, name.Length - 1) is in names
Unimplemented(path Text, lines Texts) Texts
	Counting.Unimplemented("A.strict", Untested) is ("ImplementationNotFound: Twice in A.strict:1")
	Counting.Unimplemented("A.strict", Untested + "\tnumber * 2").Length is 0
	Counting.Unimplemented("A.strict", ("from(number)", "\tA(2) is A(2)")).Length is 1
	Counting.Unimplemented("A.strict", List(Text) + "constant Ones = A(1) is A(1)").Length is 0
	Counting.Unimplemented("A.strict", ("from", "\tA(2) is A(2)")).Length is 0
	Counting.Unimplemented("A.strict", ("Twice(number Number) Number", "\tA(3).Twice(2) is 6")).Length is 1
	let typeName = Path(path).FileName.RemoveExtension.text
	for lines
		if (value.StartsWith("\t") is false) and IsUnimplemented(lines, index, typeName)
			"ImplementationNotFound: " + Tokenizer(value).Tokens.First + " in " + path + ":" + (index + 1)
IsUnimplemented(lines Texts, header Number, typeName Text) Boolean
	Counting.IsUnimplemented(("Add(other) Number", "\tAdd(1) > 0 is true"), 0, "A") is true
	Counting.IsUnimplemented(("Add(other) Number", "\tA.Add(1) is 1"), 0, "A") is true
	Counting.IsUnimplemented(("Add(other) Number", "\tother + 1"), 0, "A") is false
	let lastLine = LastLine(lines, header)
	if (lastLine is header) or (lines(header) is "from") or TypeShape(lines).IsMemberLine(lines(header))
		return false
	let last = lines(lastLine).Trim
	let called = lines(header).StartsWith("from") then typeName else Tokenizer(lines(header)).Tokens.First
	let isComparison = (last.IndexOf(" is ") > 0) or (last.IndexOf(" < ") > 0) or (last.IndexOf(" > ") > 0)
	let isCalled = last.StartsWith(called + "(") or last.StartsWith(called + " ")
	let isInstance = last.StartsWith(typeName + "(") and (last.IndexOf(")." + called) > 0)
	isComparison and (isCalled or isInstance or last.StartsWith(typeName + "." + called))
LastLine(lines Texts, header Number) Number
	Counting.LastLine(("Add(other) Number", "\tother", "Run", "\t1"), 0) is 1
	Counting.LastLine(List(Text) + "has number", 0) is 0
	mutable last = header
	for Range(header + 1, lines.Length)
		if lines(value).StartsWith("\t") is false
			return last
		last = value
	last
Problem(lines Texts, broken Number) Text
	Counting.Problem(("Run", "	1 +"), 1) is "ParsingFailed: 1 +"
	Counting.Problem(("Run", "	let a = for 3"), 1).StartsWith("ForWithBodyOnlyAsMethodResult: let a = for 3, ") is true
	Counting.Problem(("has number", "Run", "	1", "", "	2"), 3) is "EmptyLineInsideMethod: Run"
	if lines(broken).Trim is not ""
		let isFor = lines(broken).IndexOf(" = for ") > 0
		let hint = isFor then StatementParser.ForHint else ""
		return (isFor then StatementParser.ForProblem else "ParsingFailed: ") + lines(broken).Trim + hint
	mutable header = 0
	for Range(0, broken)
		if lines(value).StartsWith("	") is false
			header = value
	"EmptyLineInsideMethod: " + Tokenizer(lines(header)).Tokens.First