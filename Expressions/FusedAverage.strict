has fusion Fusion
has name Text
constant Ones = FusedAverage(Fusion.Averaging, "Ones")
constant Grays = FusedAverage(Fusion.Coloring, "Grays")
Lines Texts
	Ones.Lines.Last is "\tfusedSum / fusedCount"
	Grays.Lines(6) is "\tfor count"
	Grays.Lines(8) is "\t\tfusedRed = fusedRed + fused.Red"
	lines = fusion.lines
	ending = fusion.Ending(fusion.Header(name))
	last = lines(ending - 1)
	tabs = last.Substring(0, BodyParser.Indent(last))
	start = Statements(ending)
	Signature + lines.Slice(start, ending - start - 1) + (tabs + "fused = " + last.TrimStart) + Accumulate(tabs) + Result
Element Text
	Grays.Element is "Color"
	fusion.Element(fusion.lines(fusion.Header(name)))
Members Texts
	Ones.Members is ("Sum")
	Element is "Number" then List(Text) + "Sum" else fusion.MemberScope(Element).names
Signature Texts
	Grays.Signature(0) is "GraysAveraged(count Number) Color"
	Grays.Signature(2) is "\tmutable fusedRed = 0"
	header = fusion.lines(fusion.Header(name))
	parameters = header.Substring(name.Length, header.LastIndexOf(" ") - name.Length)
	mutable result = List(Text) + (name + "Averaged" + parameters + " " + Element)
	for List(Text) + "Count" + Members
		result = result + ("\tmutable fused" + value + " = 0")
	result
Accumulate(tabs Text) Texts
	Ones.Accumulate("\t") is ("\tfusedSum = fusedSum + fused", "\tfusedCount = fusedCount + 1")
	Grays.Accumulate("\t").First is "\tfusedRed = fusedRed + fused.Red"
	mutable result = List(Mutable(Text))
	for Members
		result.Add(tabs + "fused" + value + " = fused" + value + " + fused" + (value is "Sum" then "" else "." + value))
	result + (tabs + "fusedCount = fusedCount + 1")
Result Text
	Ones.Result is "\tfusedSum / fusedCount"
	Grays.Result.StartsWith("\tColor(Byte(fusedRed / fusedCount), Byte(fusedGreen / fusedCount), ")
	if Element is "Number"
		return "\tfusedSum / fusedCount"
	types = fusion.MemberScope(Element).types
	mutable averages = List(Mutable(Text))
	for Members
		average = "fused" + value + " / fusedCount"
		averages.Add(types(index) is "Number" then average else types(index) + "(" + average + ")")
	"\t" + Element + "(" + Text.Combine(averages) + ")"
Statements(ending Number) Number
	Ones.Statements(6) is 4
	for Range(fusion.Header(name) + 1, ending)
		tokens = Tokenizer(fusion.lines(value).TrimStart).Tokens
		isAssigned = tokens.Length > 1 and tokens(1) is "="
		if tokens.First is in ("for", "let", "mutable", "if", "return") or isAssigned
			return value
	ending
