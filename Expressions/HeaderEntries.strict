has header HeaderTokens
has methods Scope = KnownTypes.NoMembers
constant Mutating = HeaderEntries(HeaderTokens(Tokenizer("Add(x Number) Mutable(List)").Tokens))
constant Adding = HeaderEntries(HeaderTokens(Tokenizer("Add(x Number) Number").Tokens))
constant Defaulting = HeaderEntries(HeaderTokens(Tokenizer("Add(x Number, y List(Text) = List(Text), z = Basis.None)").Tokens))
constant Pair = HeaderEntries(HeaderTokens(Tokenizer("A(x Number, y Text)").Tokens))
Parameters Scope
	HeaderEntries(HeaderTokens(Tokenizer("Merged Numbers slow").Tokens)).Parameters.TypeOf("Merged slow") is "Slow"
	Mutating.Parameters.TypeOf("Add mutable") is "Mutable"
	Adding.Parameters.names is ("Add", "Add types", "Add required")
	Defaulting.Parameters.TypeOf("Add z default") is "Basis . None"
	HeaderEntries(HeaderTokens(Tokenizer("B(a Number with Step 0.5)").Tokens)).Parameters.TypeOf("B a step") is "0.5"
	HeaderEntries(HeaderTokens(Tokenizer("T(a Number) Number with Step 0.5").Tokens)).Parameters.TypeOf("T step") is "0.5"
	let steps = "Step" is in header.tokens then Steps(header.tokens).Entries(header) else KnownTypes.NoMembers
	WithModifiers(Summary.WithAll(steps.names, steps.types))
Summary Scope
	(Adding.Summary.TypeOf("Add required") is "1") and (Defaulting.Summary.TypeOf("Add z default") is "Basis . None")
	Defaulting.Summary.TypeOf("Add required") is "1"
	let name = header.tokens(0)
	let names = header.ParameterNames
	let hasDefaults = "=" is in header.tokens
	let key = (name, name + " types", name + " required")
	let required = hasDefaults then Required to Text else names.Length to Text
	let entries = Scope(key, (Text.Combine(names, ","), Text.Combine(ParameterTypes, ","), required))
	hasDefaults then Defaults(entries) else entries
WithModifiers(entries Scope) Scope
	Adding.WithModifiers(KnownTypes.NoMembers).names.Length is 0
	Mutating.WithModifiers(KnownTypes.NoMembers).TypeOf("Add mutable") is "Mutable"
	let name = header.tokens(0)
	let marked = header.ReturnsSlow then entries.With(name + " slow", "Slow") else entries
	header.ReturnsMutable then marked.With(name + " mutable", "Mutable") else marked
ParameterTypes Texts
	HeaderEntries(HeaderTokens(Tokenizer("A(x o, y = o)").Tokens), Scope(("o"), ("N"))).ParameterTypes is ("o", "N")
	Pair.Parameters.TypeOf("A") is "x,y"
	Pair.Parameters.TypeOf("A types") is "Number,Text"
	HeaderEntries(HeaderTokens(Tokenizer("A(x = Range(0, 2))").Tokens)).Default(2) is ("Range", "(", "0", ",", "2", ")")
	HeaderEntries(HeaderTokens(Tokenizer("A(x B(c = 1) = d)").Tokens)).Default(2) is ("d")
	for header.ParameterTypes
		let position = header.ParameterPosition(header.ParameterNames(index))
		let inferred = header.tokens(position + 1) is "=" then methods.TypeOf(value) else ""
		inferred is "" then value else inferred
Required Number
	HeaderEntries(HeaderTokens(Tokenizer("Add(x Number, y = 1, z Number with value > 0)").Tokens)).Required is 2
	HeaderEntries(HeaderTokens(Tokenizer("Add(x Number, y Text = \"a\")").Tokens)).Required is 1
	Defaulting.Required is 1
	mutable required = 0
	for header.ParametersEnd
		if header.IsParameterStart(index) and (Default(index).Length is 0)
			required = required + 1
	required
Defaults(scope Scope) Scope
	Defaulting.Defaults(Scope(List(Text), List(Text))).names is ("Add y default", "Add z default")
	mutable names = List(Mutable(Text))
	mutable values = List(Mutable(Text))
	for header.ParametersEnd
		if header.IsParameterStart(index)
			let tokens = Default(index)
			if tokens.Length > 0
				names.Add(header.tokens(0) + " " + header.tokens(index) + " default")
				values.Add(Text.Combine(tokens, " "))
	scope.WithAll(names, values)
Default(position Number) Texts
	(Defaulting.Default(5) is ("List", "(", "Text", ")")) and (Defaulting.Default(2).Length is 0)
	mutable depth = 1
	mutable tokens = List(Mutable(Text))
	mutable isDefault = false
	for Range(position + 1, header.ParametersEnd)
		let token = header.tokens(value)
		if (depth is 1) and (token is in (",", "with"))
			return tokens
		tokens = isDefault then tokens + token else tokens
		isDefault = isDefault or ((depth is 1) and (token is "="))
		depth = depth + (token is "(" then 1 else (token is ")" then -1 else 0))
	tokens
