has header HeaderTokens
has methods Scope = KnownTypes.NoMembers
constant Mutating = HeaderEntries(HeaderTokens(Tokenizer("Add(x Number) Mutable(List)").Tokens))
constant Adding = HeaderEntries(HeaderTokens(Tokenizer("Add(x Number) Number").Tokens))
constant Defaulting = HeaderEntries(HeaderTokens(Tokenizer("Add(x Number, y List(Text) = List(Text), z = Basis.None)").Tokens))
Parameters Scope
	HeaderEntries(HeaderTokens(Tokenizer("Merged Slow(Numbers)").Tokens)).Parameters.TypeOf("Merged slow") is "Slow"
	Mutating.Parameters.TypeOf("Add mutable") is "Mutable"
	Adding.Parameters.names is ("Add", "Add types", "Add required")
	Defaulting.Parameters.TypeOf("Add z default") is "Basis . None"
	HeaderEntries(HeaderTokens(Tokenizer("B(a Number with Step 0.5)").Tokens)).Parameters.TypeOf("B a step") is "0.5"
	HeaderEntries(HeaderTokens(Tokenizer("T(a Number) Number with Step 0.5").Tokens)).Parameters.TypeOf("T step") is "0.5"
	let name = header.tokens(0)
	let parameters = (Text.Combine(header.ParameterNames, ","), Text.Combine(ParameterTypes, ","), Required to Text)
	let steps = Defaults(Steps(header.tokens).Entries(header))
	let entries = Scope((name, name + " types", name + " required"), parameters).WithAll(steps.names, steps.types)
	let marked = header.ReturnsSlow then entries.With(name + " slow", "Slow") else entries
	header.ReturnsMutable then marked.With(name + " mutable", "Mutable") else marked
ParameterTypes Texts
	for header.ParameterTypes
		let position = header.tokens.Index(header.ParameterNames(index))
		let inferred = header.tokens(position + 1) is "=" then methods.TypeOf(value) else ""
		inferred is "" then value else inferred
Required Number
	HeaderEntries(HeaderTokens(Tokenizer("Add(x Number, y = 1, z Number with value > 0)").Tokens)).Required is 2
	HeaderEntries(HeaderTokens(Tokenizer("Add(x Number, y Text = \"a\")").Tokens)).Required is 1
	Defaulting.Required is 1
	mutable required = 0
	for header.ParametersEnd
		if (index > 1) and header.IsParameterStart(index) and (Default(index).Length is 0)
			required = required + 1
	required
Defaults(scope Scope) Scope
	Defaulting.Defaults(Scope(List(Text), List(Text))).names is ("Add y default", "Add z default")
	mutable names = List(Mutable(Text))
	mutable values = List(Mutable(Text))
	for header.ParametersEnd
		if (index > 1) and header.IsParameterStart(index) and (Default(index).Length > 0)
			names.Add(header.tokens(0) + " " + header.tokens(index) + " default")
			values.Add(Text.Combine(Default(index), " "))
	scope.WithAll(names, values)
Default(position Number) Texts
	Defaulting.Default(5) is ("List", "(", "Text", ")")
	Defaulting.Default(2).Length is 0
	mutable tokens = List(Mutable(Text))
	mutable isDefault = false
	for Range(position + 1, header.ParametersEnd)
		let token = header.tokens(value)
		if (header.Depth(value) is 1) and (token is in (",", "with"))
			return tokens
		tokens = isDefault then tokens + token else tokens
		isDefault = isDefault or ((token is "=") and (header.Depth(value) is 1))
	tokens
