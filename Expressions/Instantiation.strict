has types KnownTypes
constant CoupleFrom = Scope(("from", "from types"), ("first,second", "Generic,Generic"))
constant Couples = KnownTypes(("Couple", "Text"), (Scope(("first", "second"), ("Generic", "Generic")), KnownTypes.NoMembers), (KnownTypes.NoMembers, KnownTypes.NoMembers), (CoupleFrom, KnownTypes.NoMembers))
constant Implicit = Instantiation(KnownTypes(("Couple", "Text"), (Couples.members(0), KnownTypes.NoMembers), (KnownTypes.NoMembers, KnownTypes.NoMembers), (Scope(("from", "from types"), ("", "Type")), KnownTypes.NoMembers)))
constant Pairing = Instantiation(Couples)
constant BoxMembers = (Scope(("first", "size", "second"), ("Generic", "Number", "Generic")), Scope(("Number"), ("Number")), KnownTypes.NoMembers, KnownTypes.NoMembers)
constant BoxMethods = (Scope(("Swap", "Sizes"), ("Box(second, size, first)", "List(Number)")), Scope(("Half", "get"), ("Number", "Text")), Scope(("Abs", "size"), ("Number", "Text")), Scope(("Copy", "to"), ("Any", "Text")))
constant Boxed = KnownTypes(("Box", "Meter", "Number", "Any"), BoxMembers, BoxMethods, (KnownTypes.NoMembers, KnownTypes.NoMembers, KnownTypes.NoMembers, KnownTypes.NoMembers))
constant Inferring = TypeInference(Couples, (KnownTypes.NoMembers, KnownTypes.NoMembers))
constant Swapping = TypeShape("has first Generic", "has second Generic", "Swapped Couple", "\tCouple(second, first)")
constant Mixed = SyntaxParser(Tokenizer("Couple(\"a\", 2)").Tokens).Parse
Name(node SyntaxNode, inference TypeInference, scope Scope, current Scope) Text
	Pairing.Name(Mixed, Inferring, KnownTypes.NoMembers, KnownTypes.NoMembers) is "Couple(Text, Number)"
	Pairing.Name(SyntaxNode("Call", "Text"), Inferring, KnownTypes.NoMembers, KnownTypes.NoMembers) is ""
	Pairing.Name(SyntaxNode("Call", "Couple"), Inferring, KnownTypes.NoMembers, KnownTypes.NoMembers) is ""
	Implicit.Name(Mixed, Inferring, KnownTypes.NoMembers, KnownTypes.NoMembers) is "Couple(Text, Number)"
	Pairing.Name(Mixed, Inferring, KnownTypes.NoMembers, Scope(("Couple"), ("Text"))) is ""
	let isType = types.IsKnown(node.text) and (current.TypeOf(node.text) is "") and (scope.TypeOf(node.text) is "")
	let declared = isType then ConstructorTypes(node) else List(Text)
	mutable arguments = List(Mutable(Text))
	for declared
		if IsGeneric(value) and (index < node.children.Length)
			arguments.Add(inference.TypeOf(node.children(index), scope, current))
	arguments.Length is 0 then "" else node.text + "(" + Text.Combine(arguments, ", ") + ")"
ConstructorTypes(node SyntaxNode) Texts
	Pairing.Filled("Strict/List(Number)", "Dictionary(Text, Generic)") is "Dictionary(Text, Number)"
	Pairing.Filled("Strict/List(Number)", "Couple(Text, Generic, Number)") is "Couple(Text, Number, Number)"
	Pairing.Filled("Strict/Number", "List(Generic)") is "List(Generic)"
	Pairing.Argument("Couple(Text, Number)", "missing") is "Unknown"
	Pairing.Position("Couple(Text, Number)", "first") is 0
	Pairing.IsGeneric("Generics") and (Pairing.IsGeneric("Text") is false)
	Pairing.Template(TypeShape("has first Text", "Swapped Couple", "	Couple(first)"), 1, "Couple") is ""
	Pairing.Template(TypeShape("has first Generic", "Swapped Couple", "	first"), 1, "Couple") is ""
	let explicit = types.ParametersOf(node.text, "from types", node.children.Length)
	explicit.Length is node.children.Length then explicit else types.MembersOf(node.text).types
Argument(instanceType Text, name Text) Text
	Pairing.Argument("Couple(Text, Number)", "second") is "Number"
	Pairing.Argument("Couple(Text, Number)", "first") is "Text"
	Pairing.Argument("Iterator(Text)", "first") is "Text"
	Pairing.Argument("List(Text)", "elements") is "Text"
	let arguments = Arguments(instanceType)
	let base = types.BaseName(instanceType)
	if (arguments.Length is 0) or (base is in ("List", "Dictionary", "Iterator"))
		return (base is "List") and (arguments.Length is 1) then arguments(0) else types.ElementType(instanceType)
	let position = Position(instanceType, name)
	(position >= 0) and (position < arguments.Length) then arguments(position) else "Unknown"
Position(instanceType Text, name Text) Number
	Pairing.Position("Couple(Text, Number)", "second") is 1
	Pairing.Position("Couple(Text, Number)", "missing") is -1
	let members = types.MembersOf(instanceType)
	mutable position = -1
	for members.names
		position = IsGeneric(members.types(index)) then position + 1 else position
		if value is name
			return IsGeneric(members.types(index)) then position else -1
	-1
Arguments(instanceType Text) Texts
	Pairing.Arguments("Couple(Text, Number)") is ("Text", "Number")
	Pairing.Arguments("Couple(List(Text, Number), Number)") is ("List(Text, Number)", "Number")
	Pairing.Arguments("Couple").Length is 0
	if instanceType.IndexOf("(") < 0
		return List(Text)
	for SyntaxParser(Tokenizer(instanceType).Tokens).Parse.children
		value to Text
Members(typeName Text, members Scope) Scope
	Pairing.Members("Couple(Text, Number)", Couples.members(0)).TypeOf("second") is "Number"
	Pairing.Members("Couple", Couples.members(0)).TypeOf("second") is "Generic"
	Pairing.Members("Couple(Text)", Scope(List(Text) + "first", List(Text) + "Generic")).TypeOf("first") is "Text"
	Pairing.Members("Couple(Text)", Scope(List(Text) + "first", List(Text) + "Generics")).TypeOf("first") is "Texts"
	if Arguments(typeName).Length is 0
		return members
	mutable concrete = List(Mutable(Text))
	for members.names
		let type = members.types(index)
		let argument = IsGeneric(type) then Argument(typeName, value) else type
		concrete.Add(type is "Generics" then Plural(argument) else argument)
	Scope(members.names, concrete)
IsGeneric(type Text) Boolean
	Pairing.IsGeneric("Generic") and (Pairing.IsGeneric("Couple") is false)
	Instantiation(KnownTypes(("S"), Couples.members, Couples.methods, (Scope((" trait"), ("true"))))).IsGeneric("S")
	(type is in ("Generic", "Generics")) or (types.ParameterScope(type).TypeOf(" trait") is "true")
Plural(element Text) Text
	Instantiation(Boxed).Position("Box(Text, Number)", "second") is 1
	Instantiation(Boxed).Position("Box(Text, Number)", "size") is -1
	Instantiation(Boxed).Members("Box(Text, Number)", Boxed.members(0)).TypeOf("size") is "Number"
	Instantiation(Boxed).Substituted("Box(Text, Number)", "Box(second, size, first)") is "Box(Number, Text)"
	Pairing.Argument("Texts", "first") is "Text"
	Instantiation(Boxed).Argument("Meter", "x") is "Text"
	Pairing.Argument("Couple(Text)", "second") is "Unknown"
	Pairing.Name(Mixed, Inferring, Scope(("Couple"), ("Text")), KnownTypes.NoMembers) is ""
	Pairing.Plural("Text") is "Texts"
	Pairing.Plural("Couple(Text, Number)") is "List(Couple(Text, Number))"
	element.IndexOf("(") < 0 then element + "s" else "List(" + element + ")"
Own(fullName Text, type Text) Text
	Pairing.Own("Strict/Couple(Text, Number)", "Couple") is "Couple(Text, Number)"
	Pairing.Own("Strict/Dictionary(Text, Number)", "Dictionary") is "Dictionary"
	Pairing.Own("Strict/Couple(Text, Number)", "Text") is "Text"
	Pairing.Own("Strict/Couple(Text, Number)", "Couple(second, first)") is "Couple(Number, Text)"
	let typeName = fullName.Substring(fullName.LastIndexOf("/") + 1, fullName.Length - fullName.LastIndexOf("/") - 1)
	if (type is in ("List", "Dictionary")) or (types.BaseName(type) is not types.BaseName(typeName))
		return type
	type is types.BaseName(typeName) then typeName else Substituted(typeName, type)
Template(shape TypeShape, position Number, typeName Text) Text
	Pairing.Template(TypeShape("has first Generic", "Swapped Pair", "	Couple(first)"), 1, "Couple") is ""
	Pairing.Template(TypeShape("has first Generic", "Swapped Couple", "	Pair(first)"), 1, "Couple") is ""
	Pairing.Template(TypeShape("has first Generic", "Swapped Couple", "	\"Couple\""), 1, "Couple") is ""
	Pairing.Template(Swapping, 2, "Couple") is "Couple(second, first)"
	Pairing.Template(Swapping, 2, "Pair") is ""
	if (HeaderTokens(Tokenizer(shape.lines(position)).Tokens).ReturnType is not typeName) or (shape.UsesGenerics is false)
		return ""
	let result = BodyParser(shape.lines).Method(position + 1).children.Last
	(result.Kind is "Call") and (result.text is typeName) then result to Text else ""
Substituted(instanceType Text, template Text) Text
	Pairing.Substituted("Couple(Text, Number)", "Couple(second, first)") is "Couple(Number, Text)"
	Pairing.Substituted("Couple(Text, Number)", "Couple(1, first)") is "Couple(Text, Number)"
	Pairing.Substituted("Couple(Text, Number)", "Couple(first, second, first)") is "Couple(Text, Number)"
	let members = types.MembersOf(instanceType)
	mutable arguments = List(Mutable(Text))
	for Arguments(template)
		if (index < members.types.Length) and (members.types(index) is "Generic")
			let argument = Argument(instanceType, value)
			if argument is "Unknown"
				return instanceType
			arguments.Add(argument)
	types.BaseName(instanceType) + "(" + Text.Combine(arguments, ", ") + ")"
Filled(owner Text, type Text) Text
	Pairing.Filled("Strict/List(Number)", "Dictionary(Generic, Boolean)") is "Dictionary(Number, Boolean)"
	Pairing.Filled("Strict/List(Number)", "List(Generic)") is "List(Number)"
	Pairing.Filled("Strict/Dictionary(Text, Number)", "List(Generic)") is "List(Generic)"
	Pairing.Filled("Strict/List(Number)", "Number") is "Number"
	let open = owner.IndexOf("(")
	if (open < 0) or (owner.IndexOf(",") > 0) or (type.IndexOf("Generic") < 0)
		return type
	let argument = owner.Substring(open + 1, owner.Length - open - 2)
	let first = type.Replace("(Generic)", "(" + argument + ")").Replace("(Generic, ", "(" + argument + ", ")
	first.Replace(", Generic)", ", " + argument + ")").Replace(", Generic,", ", " + argument + ",")
