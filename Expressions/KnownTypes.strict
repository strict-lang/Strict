has names Texts
has members Scopes
has methods Scopes
has parameters Scopes
has positions Dictionary(Text, Number) = Dictionary(Text, Number)
constant NoMembers = Scope(List(Text), List(Text))
constant NoMemberPair = (NoMembers, NoMembers)
constant CountMembers = Scope(("number", "unused"), ("Number", "Unused"))
constant CountMethods = Scope(("Increment", "Twice"), ("Count", "Count"))
constant Lengths = (Scope(("Length"), ("Length")), NoMembers)
constant Measured = KnownTypes(("F", "Length"), Lengths, (NoMembers, Scope(("Length"), ("Number"))), (NoMembers, NoMembers))
constant Nested = KnownTypes(("G", "F", "Length"), (Scope(("f"), ("F")), Lengths(0), NoMembers), (NoMembers, NoMembers, Scope(("Length"), ("Number"))), (NoMembers, NoMembers, NoMembers))
constant CountParameters = Scope(("Increment", "Increment mutable", "Twice", "Twice", "Twice types"), ("", "Mutable", "times,offset", "times", "Number"))
constant SampleParameters = (CountParameters, NoMembers)
constant Sample = KnownTypes(("Count", "Text"), (CountMembers, NoMembers), (CountMethods, NoMembers), SampleParameters)
constant Indexed = KnownTypes(Sample.names, Sample.members, Sample.methods, Sample.parameters, Dictionary(("Count", 0), ("Text", 1)))
IsKnown(typeName Text) Boolean
	Sample.ResolvedType("Text", "Missing", 1) is "Unknown"
	Instantiation.Couples.ResolvedType("Couple(Text, Number)", "second", 1) is "Number"
	Sample.MemberType("outer", "Missing") is "Unknown"
	Sample.MemberType("Count", "Key") is "Unknown"
	Sample.ElementType("Count") is "Unknown"
	Sample.ElementType("List") is "Generics"
	Sample.MemberMethodType("Count", "Missing", 1) is ""
	Sample.IsKnown("Count")
	Sample.IsKnown("Missing") is false
	Index(typeName) >= 0
Index(typeName Text) Number
	KnownTypes(Sample.names, Sample.members, Sample.methods, Sample.parameters, Dictionary(("Text", 0))).Index("Text") is 0
	Sample.Index("Text") is 1
	Sample.Index("Missing") is -1
	Indexed.Index("Text") is 1
	Indexed.Index("Missing") is -1
	positions.Length is 0 then names.Index(typeName) else typeName is in positions then positions(typeName) else -1
IsPlural(typeName Text) Boolean
	Instantiation.Boxed.ResolvedType("Box(Text, Number)", "Swap", 1) is "Box(Number, Text)"
	Instantiation.Boxed.ResolvedType("Box(Text, Number)", "Sizes", 1) is "List(Number)"
	Instantiation.Boxed.ResolvedType("Box(Text, Number)", "size", 1) is "Number"
	Instantiation.Boxed.ResolvedType("Box(Text, Number)", "Abs", 1) is "Number"
	Sample.IsPlural("s") is false
	Sample.IsPlural("Count") is false
	KnownTypes(("Bus"), (NoMembers), (NoMembers), (NoMembers)).IsPlural("Bus") is false
	Sample.IsPlural("Counts")
	Sample.IsPlural("Text") is false
	typeName.Length > 1 and typeName.EndsWith("s") and (not IsKnown(typeName))
BaseName(typeName Text) Text
	Instantiation.Boxed.ResolvedType("Meter", "Number", 1) is "Number"
	Instantiation.Boxed.ResolvedType("Meter", "Half", 1) is "Number"
	Instantiation.Boxed.ResolvedType("Meter", "Abs", 1) is "Meter"
	Instantiation.Boxed.ResolvedType("Meter", "Copy", 1) is "Meter"
	Sample.BaseName("Counts") is "List"
	Sample.BaseName("Count(Number)") is "Count"
	Sample.BaseName("Count") is "Count"
	if IsPlural(typeName)
		return "List"
	let open = typeName.IndexOf("(")
	open > 0 then typeName.Substring(0, open) else typeName
MembersOf(typeName Text) Scope
	Instantiation.Boxed.ResolvedType("Meter", "to", 1) is "Text"
	KnownTypes(("M"), Lengths, (Scope(("get", "x"), ("Number", "Generic"))), Lengths).ResolvedType("M", "x", 1) is "Number"
	KnownTypes(("List"), Lengths, (Scope(("y"), ("List"))), Lengths).ResolvedType("List(Text)", "y", 1) is "List(Text)"
	KnownTypes(("A"), (CountMembers), (CountMethods), (CountParameters)).MembersOf("B").names.Length is 0
	KnownTypes(("A"), (CountMembers), (CountMethods), (CountParameters)).MethodsOf("B").names.Length is 0
	KnownTypes(("A"), (CountMembers), (CountMethods), (CountParameters)).ParameterScope("B").names.Length is 0
	Measured.ValueOf("F") is "Length"
	Sample.MembersOf("Count").TypeOf("number") is "Number"
	let index = Index(BaseName(typeName))
	index is -1 then NoMembers else members(index)
MethodsOf(typeName Text) Scope
	KnownTypes(("Map"), (NoMembers), (Scope(("get"), ("Number"))), (NoMembers)).ElementType("Map") is "Number"
	KnownTypes(("List"), Lengths, (Scope(("x", "y"), ("Generic", "List"))), Lengths).MemberMethodType("Ts", "x", 1) is "T"
	KnownTypes(("List"), Lengths, (Scope(("x", "y"), ("Generic", "List"))), Lengths).MemberMethodType("Ts", "y", 1) is "Ts"
	KnownTypes(("List"), Lengths, (Scope(("x", "y"), ("Generic", "List"))), Lengths).MemberMethodType("T", "y", 1) is ""
	Sample.MethodsOf("Count").TypeOf("Increment") is "Count"
	Sample.MethodsOf("Count(Number)").TypeOf("Increment") is "Count"
	let index = Index(BaseName(typeName))
	index is -1 then NoMembers else methods(index)
ParametersOf(typeName Text, method Text, arguments Number) Texts
	Sample.ParametersOf("Count", "Twice", 2) is ("times", "offset")
	Sample.ParametersOf("Count", "Twice", 1) is ("times")
	Sample.ParametersOf("Count", "Increment", 0).Length is 0
	let scope = ParameterScope(typeName)
	for scope.names
		if (value is method) and (ParameterNames(scope.types(index)).Length is arguments)
			return ParameterNames(scope.types(index))
	for scope.names
		if (value is method) and (arguments > 0) and (ParameterNames(scope.types(index)).Length > arguments)
			return ParameterNames(scope.types(index))
	ParameterNames(scope.TypeOf(method))
ParameterScope(typeName Text) Scope
	KnownTypes(("T"), Lengths, Lengths, (Scope(("A", "A"), ("x", "x,y,z")))).ParametersOf("T", "A", 2) is ("x", "y", "z")
	Sample.MemberType("List(Text, Number)", "Length") is "Unknown"
	KnownTypes(("T"), Lengths, Lengths, (Scope(("B", "A", "A"), ("z,y", "x,y", "")))).ParametersOf("T", "A", 1)(0) is "x"
	Sample.ParameterScope("Count").TypeOf("Twice types") is "Number"
	let position = Index(BaseName(typeName))
	position is -1 then NoMembers else parameters(position)
ParameterNames(joined Text) Texts
	Sample.ParameterNames("a,b") is ("a", "b")
	joined is "" then List(Text) else joined.Split(",")
ShapeScope(typeName Text) Scope
	KnownTypes(("Any"), (NoMembers), (Scope(("to"), ("Text"))), (NoMembers)).MemberMethodType("Foo", "to", 1) is ""
	KnownTypes(("Any"), (NoMembers), (Scope(("to"), ("Text"))), (NoMembers)).DeclaredType("Foo", "to", 1) is "Text"
	KnownTypes(("Any"), (NoMembers), (Scope(("to"), ("Text"))), (NoMembers)).DeclaredType("Foo", "to", 0) is ""
	Nested.DeclaredType("G", "Length", 1) is ""
	Measured.DeclaredType("F", "Length", 0) is ""
	Sample.ShapeScope("Count").TypeOf("Increment") is "Count"
	let typeMethods = MethodsOf(typeName)
	MembersOf(typeName).WithAll(typeMethods.names, typeMethods.types)
ElementType(typeName Text) Text
	Sample.ElementType("Texts") is "Text" and (Sample.ElementType("Range") is "Number")
	Sample.ElementType("Iterator(Text)") is "Text" and (Sample.ElementType("Text") is "Character")
	Sample.ElementType("Dictionary(Text, Number)") is "Number"
	Sample.ElementType("Iterator(Couple(Text, Number))") is "Couple(Text, Number)"
	Sample.ElementType("Dictionary(Text, Couple(Text, Number))") is "Couple(Text, Number)"
	if typeName is in ("Number", "Range", "Text", "List")
		return typeName is "Text" then "Character" else typeName is "List" then "Generics" else "Number"
	if typeName.StartsWith("Iterator(") or typeName.StartsWith("Dictionary(")
		let start = typeName.StartsWith("Dictionary(") then typeName.IndexOf(", ") + 2 else typeName.IndexOf("(") + 1
		return typeName.Substring(start, typeName.Length - start - 1)
	let keyed = MethodsOf(typeName).TypeOf("get")
	IsPlural(typeName) then typeName.Substring(0, typeName.Length - 1) else keyed is "" then "Unknown" else keyed
MemberType(instanceType Text, name Text) Text
	Sample.MemberType("Count", "Increment") is "Count"
	Measured.MemberType("F", "Length") is "Number"
	Sample.MemberType("Unknown", "Length") is "Unknown"
	Sample.MemberType("outer", "Count") is "Count"
	Sample.MemberType("List(Text, Number)", "Key") is "Text"
	Sample.MemberType("List(Text, Number)", "Value") is "Number"
	if (instanceType is "outer") and IsKnown(name)
		return name
	let pair = MethodBodies.Pair(instanceType)
	if (pair.Length is 0) or (name is not in ("Key", "Value"))
		return ResolvedType(instanceType, name, 3)
	name is "Key" then pair(0) else pair(1)
ResolvedType(instanceType Text, name Text, depth Number) Text
	Sample.ResolvedType("Count", "Twice", 1) is "Count"
	Sample.ResolvedType("Count(Number)", "Twice", 1) is "Count(Number)"
	let type = DeclaredType(instanceType, name, depth)
	if type is ""
		return "Unknown"
	if type is "Generic"
		return Instantiation(value).Argument(instanceType, name)
	if (type.IndexOf("(") > 0) and (BaseName(type) is BaseName(instanceType))
		return Instantiation(value).Substituted(instanceType, type)
	let isInherited = (MembersOf(instanceType).TypeOf(name) is "") and (MethodsOf(instanceType).TypeOf(name) is "")
	let isOwn = (type is in ("List", BaseName(instanceType))) or (isInherited and (MethodsOf("Any").TypeOf(name) is "Any"))
	isOwn or isInherited and (type is ValueOf(instanceType)) then instanceType else type
ValueOf(typeName Text) Text
	Sample.ValueOf("Text") is ""
	let typeMembers = MembersOf(typeName)
	typeMembers.types.Length is 1 then typeMembers.types(0) else ""
DeclaredType(typeName Text, name Text, depth Number) Text
	Sample.DeclaredType("Count", "number", 0) is "Number"
	let typeMembers = Instantiation(value).Members(typeName, MembersOf(typeName))
	let member = typeMembers.TypeOf(name)
	if (member is not "") and ((member is not name) or (MethodsOf(member).TypeOf(name) is ""))
		return member
	if (MethodsOf(typeName).TypeOf(name) is not "") or (depth is 0)
		return MethodsOf(typeName).TypeOf(name)
	let holder = Holder(typeName, name, depth)
	holder is "" then MethodsOf("Any").TypeOf(name) else MemberMethodType(typeMembers.TypeOf(holder), name, depth - 1)
Holder(typeName Text, name Text, depth Number) Text
	Measured.Holder("F", "Length", 1) is "Length"
	Nested.Holder("G", "Length", 2) is "f"
	Sample.Holder("Count", "Twice", 1) is ""
	if MethodsOf(typeName).TypeOf(name) is not ""
		return ""
	let typeMembers = Instantiation(value).Members(typeName, MembersOf(typeName))
	for typeMembers.types
		if MemberMethodType(value, name, depth - 1) is not ""
			return typeMembers.names(index)
	""
MemberMethodType(memberType Text, name Text, depth Number) Text
	Sample.MemberMethodType("Texts", "Missing", 1) is ""
	if IsKnown(memberType)
		let type = ResolvedType(memberType, name, depth)
		return type is "Unknown" then "" else type
	let listType = IsPlural(memberType) then MethodsOf("List").TypeOf(name) else ""
	listType is "Generic" then ElementType(memberType) else listType is "List" then memberType else listType
