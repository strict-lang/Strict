has elements Texts
has elementTypeName Text
to Text
	ListExpression(("1", "2", "3"), "Number") to Text is "(1, 2, 3)"
	"(" + JoinElements + ")"
JoinElements Text
	mutable result = ""
	for elements
		if result is not ""
			result = result + ", "
		result = result + value
	result
Count Number
	elements.Length