has types KnownTypes
constant Scaling = ListFits(Overloads.Scaler)
constant Sorter = KnownTypes("Sorter", KnownTypes.NoMembers, Scope(("Sorted", "Sorted"), ("Numbers", "Numbers")).Owned("Sorter"), Scope(("Sorted", "Sorted types", "Sorted", "Sorted types"), ("", "", "numbers", "Numbers")))
constant Sorts = Overloads(Sorter)
IsWidened(argument Text, declared Text) Boolean
	Scaling.IsWidened("Bytes", "Numbers")
	Scaling.IsWidened("List(Bytes, Numbers)", "List(Numbers)")
	Scaling.IsWidened("List(Bytes, Text)", "List(Numbers)") is false
	Scaling.IsWidened("Bytes", "Generic") and Scaling.IsWidened("Bytes", "Number") is false
	Scaling.IsWidened("Byte", "Bytes") and Scaling.IsWidened("Text", "Bytes") is false
	elements = Elements(argument)
	wanted = Elements(declared)
	if wanted.Length is not 1
		return Overloads(types).Converts(argument, declared)
	if elements.Length is 0
		return Overloads(types).IsAssignable(argument, wanted.First, false)
	IsFitting(elements, wanted.First)
IsFitting(elements Texts, element Text) Boolean
	Scaling.IsFitting(("Byte", "Number"), "Number")
	Scaling.IsFitting(("Byte", "Text"), "Number") is false
	for elements
		if Overloads(types).IsAssignable(value, element, false) is false
			return false
	true
Elements(type Text) Texts
	Scaling.Elements("Bytes") is ("Byte")
	Scaling.Elements("List(Bytes, Numbers)") is ("Bytes", "Numbers")
	Scaling.Elements("Byte").Length is 0
	if type.StartsWith("List(")
		return Instantiation(types).Arguments(type)
	types.IsPlural(type) then List(Text) + types.ElementType(type) else List(Text)
IsList(typeName Text) Boolean
	ListFits(KnownTypes.Sample).IsList("Counts") and ListFits(KnownTypes.Sample).IsList("List(Count)")
	ListFits(KnownTypes.Sample).IsList("Count") is false and ListFits(KnownTypes.Sample).IsList("List")
	types.IsPlural(typeName) or typeName.StartsWith("List(") or typeName is "List"
