has typeName Text
has shape TypeShape
has inference TypeInference
constant FromGeneric = HeaderTokens(Tokenizer("from(generic)").Tokens)
constant NoScope = Scope(("x", "z"), ("y", "w"))
constant NoScopes = (NoScope, NoScope)
constant NoInference = TypeInference(KnownTypes(("A", "B"), NoScopes, NoScopes, NoScopes), NoScopes)
constant Sample = TypeShape("has a Number", "Run", "\tlet b = a", "\tb")
constant AddOther = HeaderTokens("Add", "(", "other", ")")
constant Picking = HeaderTokens(Tokenizer("Pick(random Ticker, count Number)").Tokens)
constant Ticking = TypeInference(MutatingCheck.Tickers, TypeInference.Limits)
constant Adding = MethodBodies("Demo", Sample, NoInference).HeaderScope(AddOther, NoScope)
constant Constanted = MethodBodies("Demo", TypeShape("has a Number", "constant Twice = a * 2"), NoInference).Statements.Last
constant CheckedA = BodyParser("Run", "\tif a is Error", "\t\ta").Block(1, 1).children(0)
constant Looped = MethodBodies("Demo", TypeShape("Run", "	mutable t = 1", "	for (1, 2)", "		t = 2", "	t"), NoInference).Statements
Statements ScopedStatements
	MethodBodies("Demo", Sample, NoInference).Statements.Length is 2
	MethodBodies("Demo", Sample, NoInference).Statements.Last.line is 3
	MethodBodies("Demo", TypeShape("has a Number", "constant Twice = a * 2"), NoInference).Statements.Last.line is 1
	let members = shape.MemberScope.With("self type", typeName)
	mutable statements = List(Mutable(ScopedStatement))
	for shape.lines
		if shape.IsMethodHeader(value)
			let parameters = HeaderScope(HeaderTokens(Tokenizer(value).Tokens), members)
			statements = statements + Flatten(BodyParser(shape.lines).Method(index + 1), parameters, index + 1)
		if value.StartsWith("constant ") and (value.IndexOf(" = ") > 0)
			statements.Add(ScopedStatement(BodyParser(shape.lines).Statement(index, 0), members, index))
	statements
HeaderScope(header HeaderTokens, members Scope) Scope
	(Adding.TypeOf("other"), Adding.TypeOf("self type")) is ("Demo", "Demo")
	MethodBodies("Demo(Number)", Sample, NoInference).HeaderScope(FromGeneric, NoScope).TypeOf("generic") is "Number"
	let open = typeName.IndexOf("(")
	let argument = open < 0 then "Generic" else typeName.Substring(open + 1, typeName.Length - open - 2)
	mutable types = List(Mutable(Text))
	for HeaderEntries(header, Methods).ParameterTypes
		types.Add(value is "Other" then typeName else (value is "Generic" then argument else value))
	let concrete = Instantiation(inference.types).Members(typeName, members)
	mutable scope = concrete.With("value", InstanceType).With("self type", typeName).WithAll(header.ParameterNames, types)
	for header.MutableParameters + Changes(shape.lines).Members + RefParameters(header)
		scope = scope.With(value + " mutable", "mutable")
	scope
InstanceType Text
	MethodBodies("List", Sample, NoInference).InstanceType is "Generics"
	Looped.Length is 4
	Looped(0).scope.TypeOf(" dropped") is "dropped" and (Looped(3).scope.TypeOf(" dropped") is "")
	Looped(2).scope.TypeOf(" dropped") is ""
	(Looped(0).line, Looped(2).line) is (1, 3)
	Looped(1).scope.TypeOf("t mutable") is "mutable"
	Looped(2).scope.TypeOf("value") is "Number" and (Looped(2).scope.TypeOf("index") is "Number")
	Looped(2).scope.TypeOf("outer") is "Demo"
	Constanted.scope.TypeOf("self type") is "Demo"
	typeName is "List" then "Generics" else typeName
IteratedType Text
	MethodBodies("Text", Sample, NoInference).IteratedType is "Characters"
	MethodBodies("Demo", Sample, NoInference).Statements.Last.scope.TypeOf("b mutable") is ""
	MethodBodies("Demo", TypeShape("has a Number", "constant Twice"), NoInference).Statements.Length is 0
	MethodBodies("Demo", Sample, NoInference).StatementType(Looped(2)) is "Number"
	MethodBodies("Demo", Sample, NoInference).StatementType(Looped(1)) is "Numbers"
	MethodBodies("Demo", Sample, NoInference).StatementType(Looped(3)) is "Number"
	typeName is "Text" then "Characters" else InstanceType
Flatten(body SyntaxNode, outerScope Scope, start Number) ScopedStatements
	MethodBodies("Demo", Sample, NoInference).Statements.Last.scope.TypeOf("b") is "Number"
	MethodBodies("Demo", TypeShape(BodyParser.Positions), NoInference).Statements.Last.line is 5
	mutable statements = List(Mutable(ScopedStatement))
	mutable scope = outerScope
	for body.children
		let line = value.line > 0 then value.line - 1 else start + statements.Length
		let isDropped = index < body.children.Length - 1
		statements.Add(ScopedStatement(value, isDropped then scope.With(" dropped", "dropped") else scope, line))
		if value.HasBody
			statements = statements + Flatten(value.children.Last, LoopScope(value, scope), line + 1)
		scope = Declare(value, scope)
	statements
Methods Scope
	MethodBodies("Demo", Sample, NoInference).Methods.names.Length is 0
	StatementType(ScopedStatement(SyntaxNode("Return", "return"), NoScope, 0)) is ""
	StatementType(ScopedStatement(SyntaxNode("Else", "else"), NoScope, 0)) is ""
	MethodBodies("Demo", Sample, NoInference).BlockType(SyntaxNode("For", "for"), NoScope) is "Demo"
	BlockType(BodyParser("Run", "	if a is", "		1 then 2").Block(1, 1).children(0), NoScope) is "Number"
	BlockType(BodyParser("Run", "	if a is", "		1 then 2", "		else \"x\"").Block(1, 1).children(0), NoScope) is "Text"
	IsSelector(BodyParser("Run", "	if a is b", "		1").Block(1, 1).children(0)) is false
	BlockType(BodyParser("Run", "	if a is b", "		1").Block(1, 1).children(0), NoScope) is ""
	inference.types.MethodsOf(typeName)
LoopScope(statement SyntaxNode, scope Scope) Scope
	MethodBodies("Range", Sample, NoInference).LoopScope(SyntaxNode("For", "for"), NoScope).TypeOf("value") is "Number"
	MethodBodies("Range", Sample, NoInference).LoopScope(CheckedA, ErrorNarrowing.NumberA).TypeOf("a") is "Error"
	if statement.Kind is "If"
		return ErrorNarrowing(inference).Narrowed(statement.children(0), scope, Methods)
	if statement.Kind is not "For"
		return scope
	let iterated = statement.HasValue then inference.TypeOf(statement.children(0), scope, Methods) else IteratedType
	let nested = scope.With("outer", scope.TypeOf("value"))
	nested.With("value", Element(iterated)).With("index", "Number")
Element(iterated Text) Text
	MethodBodies("Demo", Sample, NoInference).Element("Dictionary(Text, Number)") is "List(Text, Number)"
	MethodBodies("Demo", Sample, NoInference).Element("Dictionary(Text, Text)") is "Texts"
	if inference.Enumerated(iterated).Length > 0
		return iterated
	let isDictionary = iterated.StartsWith("Dictionary(")
	isDictionary then Item(iterated.Substring(11, iterated.Length - 12)) else inference.types.ElementType(iterated)
Item(arguments Text) Text
	MethodBodies.Item("Number") is "Number"
	MethodBodies.Item("Text, Text") is "Texts"
	MethodBodies.Item("Text, Number") is "List(Text, Number)"
	MethodBodies.Item("Text, Texts") is "List(Text, Texts)"
	MethodBodies.Item("List(Text, Number), List(Text, Number)") is "List(Text, Number)s"
	if arguments.IndexOf(", ") < 0
		return arguments
	let half = ((arguments.Length - 2) / 2).Floor
	let first = arguments.Substring(0, half)
	first + ", " + first is arguments then first + "s" else "List(" + arguments + ")"
Pair(type Text) Texts
	MethodBodies.Pair("List(Text, Number)") is ("Text", "Number")
	MethodBodies.Pair("List(List(Text, Number))").Length is 0
	MethodBodies.Pair("Texts, Number").Length is 0
	MethodBodies.Pair("List(Text)").Length is 0
	MethodBodies.Pair("List(Text, List(Number))") is ("Text", "List(Number)")
	let comma = type.IndexOf(", ")
	let isPair = type.StartsWith("List(") and (comma > 0) and (type.Substring(5, comma - 5).IndexOf("(") < 0)
	isPair then (type.Substring(5, comma - 5), type.Substring(comma + 2, type.Length - comma - 3)) else List(Text)
Declare(statement SyntaxNode, scope Scope) Scope
	if statement.Kind is not "Declaration"
		return scope
	let name = Tokenizer(statement.text).Tokens.Last
	let declared = scope.With(name, inference.TypeOf(statement.children(0), scope, Methods))
	statement.text.StartsWith("mutable ") then declared.With(name + " mutable", "mutable") else declared
StatementType(scoped ScopedStatement) Text
	StatementType(ScopedStatement(SyntaxNode("Number", "1"), NoScope, 0)) is "Number"
	let statement = scoped.statement
	if statement.Kind is in ("If", "For")
		return BlockType(statement, scoped.scope)
	if (statement.Kind is in ("ElseIf", "Else", "ElseValue")) or (statement.Kind is "Return") and (not statement.HasValue)
		return ""
	if statement.Kind is "Reassignment"
		return Reassigned(statement, scoped.scope)
	let result = statement.Kind is in ("Declaration", "Return") then statement.children(0) else statement
	inference.TypeOf(result, scoped.scope, Methods)
Reassigned(statement SyntaxNode, scope Scope) Text
	Adding.TypeOf("value") is "Demo"
	Adding.names.Length is 5
	MethodBodies("Demo", Sample, NoInference).HeaderScope(FromGeneric, NoScope).TypeOf("generic") is "Generic"
	MethodBodies("Demo", Sample, NoInference).HeaderScope(Picking, NoScope).TypeOf("count") is "Number"
	MethodBodies("Demo", Sample, Ticking).HeaderScope(Picking, NoScope).TypeOf("random mutable") is "mutable"
	let target = inference.TypeOf(statement.children(0), scope, Methods)
	inference.Assigned(target, inference.TypeOf(statement.children(1), scope, Methods))
BlockType(statement SyntaxNode, scope Scope) Text
	BlockType(SyntaxNode("For", "for"), NoScope) is ""
	if statement.Kind is "For"
		return statement.HasValue then inference.TypeOf(statement.children(0), scope, Methods) else typeName
	if not IsSelector(statement)
		return ""
	let lastCase = statement.children.Last.children.Last
	let chosen = lastCase.Kind is "ElseValue" then lastCase.children(0) else lastCase.children(1)
	inference.TypeOf(chosen, scope, Methods)
IsSelector(statement SyntaxNode) Boolean
	IsSelector(BodyParser("Run", "\tif a is", "\t\t1 then 2").Block(1, 1).children(0))
	IsSelector(StatementParser(Tokenizer("if a is b").Tokens).ParseStatement) is false
	if not (statement.HasValue and statement.HasBody)
		return false
	let condition = statement.children(0)
	(condition.Kind is "Binary") and (condition.children(1).Kind is "Missing")
RefParameters(header HeaderTokens) Texts
	MethodBodies("Demo", Sample, Ticking).RefParameters(Picking) is ("random")
	MethodBodies("Demo", Sample, NoInference).RefParameters(AddOther).Length is 0
	let types = header.ParameterTypes
	for header.ParameterNames
		if Changes.HasChanges(inference.types.ParameterScope(types(index)))
			value