has methodName Text
has instance Text
has arguments Texts
has ResultTypeName Text
to Text
	MethodCall("Log", "logger", ("\"Hi\""), "None") to Text is "logger.Log(\"Hi\")"
	MethodCall("Run", "", List(Text), "None") to Text is "Run()"
	if instance is ""
		return methodName + "(" + JoinArguments + ")"
	instance + "." + methodName + "(" + JoinArguments + ")"
JoinArguments Text
	mutable result = ""
	for arguments
		if result is not ""
			result = result + ", "
		result = result + value
	result
ArgumentCount Number
	arguments.Length