has variableName Text
has newValue Text
to Text
	MutableReassignment("count", "count + 1") to Text is "count = count + 1"
	variableName + " = " + newValue
Parse(text Text) MutableReassignment
	Parse("total = 0").variableName is "total"
	Parse("total = 0") is MutableReassignment("total", "0")
	Parse("total") is MutableReassignment("total", "")
	let equalsIndex = text.IndexOf(" = ")
	if equalsIndex is -1
		return MutableReassignment(text, "")
	let name = text.Substring(0, equalsIndex).Trim
	let assigned = text.Substring(equalsIndex + 3, text.Length - equalsIndex - 3).Trim
	MutableReassignment(name, assigned)