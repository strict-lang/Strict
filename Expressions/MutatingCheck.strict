has inference TypeInference
constant Counting = MutatingCheck(TypeInference(KnownTypes.Sample, TypeInference.Limits))
constant Counted = Scope(List(Text) + "a", List(Text) + "Count").With(" dropped", "dropped")
constant Increment = SyntaxNode("Member", "Increment", SyntaxNode("Identifier", "a"))
constant Twice = SyntaxNode("Member", "Twice", SyntaxNode("Identifier", "a"))
constant Added = SyntaxNode("Binary", "+", (SyntaxNode("Identifier", "a"), SyntaxNode("Identifier", "a")))
constant Values = ("Binary", "Number", "Text", "List")
constant Unchecked = ("None", "Error", "Boolean", "Unknown", "")
constant Immutable = ScopedStatement(Increment, Counted, 0)
Issue(scoped ScopedStatement, current Scope) Text
	Counting.Issue(Immutable, Counted).StartsWith("MutatingCallNeedsMutableVariable: a.Increment")
	Counting.Issue(ScopedStatement(Increment, Counted.With("a mutable", "mutable"), 0), Counted) is ""
	let statement = scoped.statement
	if (scoped.scope.TypeOf(" dropped") is "") or (IsMutating(statement, scoped.scope, current) is false)
		return Unused(scoped, current)
	let target = statement.children(0).text
	if scoped.scope.TypeOf(target + " mutable") is not ""
		return ""
	let call = target + "." + statement.text
	"MutatingCallNeedsMutableVariable: " + call + " has no effect, use a mutable variable or assign the result"
Unused(scoped ScopedStatement, current Scope) Text
	Counting.Unused(ScopedStatement(Added, Counted, 0), Counted).StartsWith("UnusedValueMustBeRemoved: a + a is")
	Counting.Unused(ScopedStatement(Added, Counted.With(" dropped", ""), 0), Counted) is ""
	Counting.Unused(ScopedStatement(Twice, Counted, 0), Counted) is ""
	Counting.Unused(ScopedStatement(SyntaxNode("Identifier", "Twice"), Counted, 0), KnownTypes.CountMethods) is ""
	Counting.Unused(ScopedStatement(SyntaxNode("Binary", "then", Added.children), Counted, 0), Counted) is ""
	let statement = scoped.statement
	let isVariable = (statement.Kind is "Identifier") and (current.TypeOf(statement.text) is "")
	let isValue = (statement.Kind is in Values) and (statement.text is not "then")
	if (scoped.scope.TypeOf(" dropped") is "") or (isValue or isVariable) is false
		return ""
	let type = inference.TypeOf(statement, scoped.scope, current)
	type is in Unchecked then "" else "UnusedValueMustBeRemoved: " + statement + " is a " + type + ", assign or return it"
IsMutating(statement SyntaxNode, scope Scope, current Scope) Boolean
	Counting.IsMutating(Increment, Counted, Counted)
	if (statement.Kind is not in ("MethodCall", "Member")) or (statement.children(0).Kind is not "Identifier")
		return false
	let type = inference.TypeOf(statement.children(0), scope, current)
	inference.types.ParameterScope(type).TypeOf(statement.text + " mutable") is not ""