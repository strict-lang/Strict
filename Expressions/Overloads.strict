has types KnownTypes
constant ScalerParameters = (Scope(("Scaled", "Scaled types", "Scaled", "Scaled types", "*", "* types", "*", "* types"), ("text", "Text", "byte", "Byte", "other", "Other", "factor", "Number")), KnownTypes.NoMembers)
constant Scaler = KnownTypes(("Scaler", "Byte"), (KnownTypes.NoMembers, Scope("number", "Number")), (Scope(("Scaled", "Scaled", "*", "*"), ("Number", "Number", "Number", "Scaler")), KnownTypes.NoMembers), ScalerParameters)
constant Scaling = Overloads(Scaler)
constant LabelsParameters = Scope(("Labels", "Labels types", "Labels", "Labels types"), ("", "", "label,count", "Numbers,Number"))
constant Labeler = KnownTypes(List(Text) + "Labeler", List(Scope) + KnownTypes.NoMembers, List(Scope) + Scope(("Labels", "Labels"), ("Numbers", "List(Numbers)")).Owned("Labeler"), List(Scope) + LabelsParameters)
constant Labeling = Overloads(Labeler)
constant LabelInference = TypeInference(Labeler, List(Scope) + KnownTypes.NoMembers)
constant LabelsCall = SyntaxParser(Tokenizer("Labels((1, 0), 2)").Tokens).Parse
constant LabelerLabels = SyntaxNode("Member", "Labels", SyntaxNode("Type", "Labeler"))
constant Presets = KnownTypes(List(Text) + "Presets", List(Scope) + KnownTypes.NoMembers, List(Scope) + Scope(List(Text) + "Preset", List(Text) + "Numbers").Owned("Presets"), List(Scope) + KnownTypes.NoMembers)
constant Presetting = Overloads(Presets)
constant PresetRead = SyntaxParser(Tokenizer("Preset(0)").Tokens).Parse
constant ScaledRead = SyntaxParser(Tokenizer("Scaled(3)").Tokens).Parse
constant TwinValues = Scope(List(Text) + "Values", List(Text) + "Numbers")
constant TwinParameters = (KnownTypes.NoMembers, Scope(List(Text) + "Values", List(Text) + "count"))
constant TwinMethods = (TwinValues.Owned("Plain"), TwinValues.Owned("Counted"))
constant Twins = Overloads(KnownTypes(("Plain", "Counted"), KnownTypes.NoMemberPair, TwinMethods, TwinParameters))
constant PickerParameters = ("Mixed", "Mixed types", "Chosen", "Chosen types", "Second", "Second types", "Put", "Put types", "Put", "Put types")
constant PickerTypes = ("items", "Generics", "items", "Generics", "count,item", "Number,Generic", "item", "Generic", "number", "Number")
constant Picker = KnownTypes("Picker", KnownTypes.NoMembers, Scope(("Mixed", "Chosen", "Second"), ("Generics", "Generic", "Generic")), Scope(PickerParameters, PickerTypes))
constant Picking = Overloads(Picker)
constant Mixing = SyntaxParser(Tokenizer("p.Mixed((1, 2))").Tokens).Parse
constant Choosing = SyntaxParser(Tokenizer("p.Chosen((\"a\", \"b\"))").Tokens).Parse
constant LabelsMember = SyntaxNode("Member", "Labels", LabelsCall)
constant Limits = ("constant Limit = 3", "has count", "constant Limit = 4")
constant Valued = ("Value(name Text, default Number) Text", "\tname", "Value(name Text, default Text) Text", "\tname")
constant Clashing = "A:line 3: OverloadsNeedDifferentParameterNames: Value(name, default) like line 1"
constant ListToText = KnownTypes(List(Text) + "List", List(Scope) + KnownTypes.NoMembers, List(Scope) + Scope(List(Text) + "to", List(Text) + "Text"), List(Scope) + KnownTypes.NoMembers)
constant DefaultNames = ("from", "from types", "from", "from types", "b default", "Get", "Get types", "Get", "Get types", "Get count default")
constant DefaultTypes = ("text", "Text", "a,b", "Number,Number", "0", "x,b", "Number,Number", "count", "Number", "1")
constant Defaulted = Overloads(KnownTypes(List(Text) + "D", List(Scope) + KnownTypes.NoMembers, List(Scope) + KnownTypes.NoMembers, List(Scope) + Scope(DefaultNames, DefaultTypes)))
constant ScalerInference = TypeInference(Scaler, (KnownTypes.NoMembers, KnownTypes.NoMembers))
constant Scalers = Scope(List(Text) + "scaler", List(Text) + "Scaler")
constant Unfitted = "NoOverloadFits: Scaler.Scaled got Scaler"
constant Rescaled = SyntaxParser(Tokenizer("scaler.Scaled(scaler)").Tokens).Parse
constant Renamed = SyntaxParser(Tokenizer("scaler.Scaled(scaler, factor = 2)").Tokens).Parse
constant ScaledOnce = SyntaxParser(Tokenizer("scaler.Scaled(1)").Tokens).Parse
constant ScaledTwice = SyntaxParser(Tokenizer("scaler.Scaled(1, 2)").Tokens).Parse
constant Relabeled = Scope(("Labels", "Labels", "X"), ("Numbers", "List(Numbers)", "Number"))
constant SecondCall = SyntaxParser(Tokenizer("q.Second(1, \"a\")").Tokens).Parse
Chosen(owner Text, method Text, argumentTypes Texts) Number
	Scaling.Chosen("Scaler", "Scaled", List(Text) + "Text") is 0
	Scaling.Chosen("Scaler", "Scaled", List(Text) + "Number") is 1
	Scaling.Chosen("Scaler", "*", List(Text) + "Scaler") is 0
	Scaling.Chosen("Scaler", "*", List(Text) + "Byte") is 1
	Scaling.Chosen("Scaler", "Missing", List(Text)) is -1
	Scaling.Chosen("Scaler", "*", List(Text) + "Number") is 1
	Defaulted.Chosen("D", "from", List(Text) + "Number") is 1
	Defaulted.Chosen("D", "from", ("Number", "Number")) is 1
	Picking.Chosen("Picker", "Put", List(Text) + "Number") is 1
	ListFits.Sorts.Chosen("Sorter", "Sorted", List(Text) + "Number") is -1
	exact = Ordinal(owner, method, argumentTypes, true)
	if exact >= 0
		return exact
	widened = Ordinal(owner, method, argumentTypes, false)
	IsIndexing(owner, method, argumentTypes, widened) then Number.NotFound else widened
IsIndexing(owner Text, method Text, arguments Texts, ordinal Number) Boolean
	ListFits.Sorts.IsIndexing("Sorter", "Sorted", List(Text) + "Number", 1)
	ListFits.Sorts.IsIndexing("Sorter", "Sorted", List(Text) + "Numbers", 1) is false
	Picking.IsIndexing("Picker", "Put", List(Text) + "Number", 0) is false
	if ordinal < 0 or arguments.Length is not 1
		return false
	scope = types.ParameterScope(owner)
	if arguments.First is not "Number" or scope.TypeAt(method + " types", ordinal) is "Number"
		return false
	for Range(0, scope.Count(method))
		if scope.TypeAt(method, value) is ""
			return true
	false
Ordinal(owner Text, method Text, arguments Texts, isExact Boolean) Number
	Scaling.Ordinal("Scaler", "Scaled", List(Text) + "Number", true) is -1
	Picking.Ordinal("Picker", "Mixed", List(Text) + "Generics", true) is -1
	scope = types.ParameterScope(owner)
	if scope.Count(method) < 2
		return Number.NotFound
	mutable ordinal = -1
	for scope.names
		if value is method + " types"
			ordinal = ordinal + 1
			if Fits(types.ParameterNames(scope.types(index)), arguments, owner, isExact, Require(owner, method, ordinal).Length)
				return ordinal
	Number.NotFound
Require(owner Text, method Text, ordinal Number) Texts
	Defaulted.Require("D", "from", 1) is ("a") and Defaulted.Require("D", "from", 0) is ("text")
	Labeling.Require("Labeler", "Labels", 0).Length is 0
	Defaulted.Require("D", "Get", 1).Length is 0 and Defaulted.Require("D", "Get", 0) is ("x", "b")
	Defaulted.Chosen("D", "Get", List(Text) + "Number") is 1 and Defaulted.Chosen("D", "Get", List(Text)) is 1
	scope = types.ParameterScope(owner)
	for scope.TypeAt(method, ordinal).Split(",")
		isOwn = scope.TypeOf(method + " " + value + " default") is not ""
		isMember = method is "from" and scope.TypeOf(value + " default") is not ""
		if value is not "" and (isOwn or isMember) is false
			value
Fits(declared Texts, argumentTypes Texts, owner Text, isExact Boolean, required Number) Boolean
	Scaling.Fits(("Other", "Bytes"), ("Scaler", "List(Byte)"), "Scaler", true, 2)
	Scaling.Fits(List(Text) + "Texts", List(Text) + "Bytes", "Scaler", true, 1) is false
	Scaling.Fits(("Number", "Number"), List(Text) + "Number", "Scaler", true, 1)
	Scaling.Fits(("Number", "Number"), List(Text) + "Number", "Scaler", true, 2) is false
	Scaling.Fits(List(Text) + "Number", ("Number", "Number"), "Scaler", true, 1) is false
	if argumentTypes.Length > declared.Length or argumentTypes.Length < required
		return false
	for argumentTypes
		if IsAssignable(value, declared(index) is "Other" then owner else declared(index), isExact) is false
			return false
	true
IsAssignable(argument Text, declared Text, isExact Boolean) Boolean
	Scaling.IsAssignable("List(Byte)", "Bytes", true)
	Scaling.IsAssignable("List(A, B)", "List(A, B)", true)
	Scaling.IsAssignable("Number", "Generic", true) is false
	Scaling.IsAssignable("Number", "Generic", false)
	Scaling.IsAssignable("Bytes", "Numbers", false) and Scaling.IsAssignable("Bytes", "Numbers", true) is false
	isList = argument.StartsWith("List(") and argument.IndexOf(",") < 0
	plural = isList then argument.Substring(5, argument.Length - 6) + "s" else argument
	plural is declared then true else isExact is false and ListFits(types).IsWidened(argument, declared)
Converts(argument Text, declared Text) Boolean
	Scaling.Converts("Byte", "Number")
	Overloads(TypeInference.Colors.types).Converts("ColorValue", "Color")
	Scaling.Converts("Text", "Number") is false
	Overloads(ListToText).Converts("Texts", "Text") is false
	Overloads(TypeInference.Colors.types).Converts("Color", "ColorValue")
	Presetting.CheckIndex(SyntaxNode("Member", "Preset", PresetRead), Presets.methods(0)) is ""
	if declared is "Generic" or types.ValueOf(declared) is argument or types.ValueOf(argument) is declared
		return true
	converter = TypeInference(types, List(Scope)).Converter(argument, declared)
	converter is "from" or converter is "to" and ListFits(types).Elements(argument).Length is 0
CheckReturn(node SyntaxNode, inference TypeInference, scope Scope, current Scope) Text
	Labeling.CheckReturn(LabelsCall, LabelInference, KnownTypes.NoMembers, Labeler.methods(0)) is "List(Numbers)"
	Labeling.CheckReturn(TypeInference.Labels, LabelInference, KnownTypes.NoMembers, Labeler.methods(0)) is "Numbers"
	Scaling.CheckReturn(LabelsCall, LabelInference, KnownTypes.NoMembers, KnownTypes.NoMembers) is ""
	Labeling.CheckReturn(LabelsMember, LabelInference, KnownTypes.NoMembers, Labeler.methods(0)) is "Numbers"
	Scaling.CheckReturn(SyntaxNode("Call", "Scaled"), LabelInference, KnownTypes.NoMembers, Scaler.methods(0)) is ""
	Labeling.CheckReturn(LabelsCall, LabelInference, KnownTypes.NoMembers, Relabeled) is ""
	Presetting.CheckReturn(PresetRead, LabelInference, KnownTypes.NoMembers, Presets.methods(0)) is "Number"
	position = types.Index(current.owner)
	if position < 0 or current.Count(node.text) < 2
		return CheckIndex(node, current)
	current.TypeAt(node.text, Chosen(types.names(position), node.text, Arguments(node, inference, scope, current)))
CheckIndex(node SyntaxNode, current Scope) Text
	Presetting.CheckIndex(PresetRead, Presets.methods(0)) is "Number"
	Presetting.CheckIndex(SyntaxNode("Call", "Preset"), Presets.methods(0)) is ""
	Presetting.CheckIndex(SyntaxParser(Tokenizer("Other(0)").Tokens).Parse, Presets.methods(0)) is ""
	Presetting.CheckIndex(PresetRead, KnownTypes.NoMembers) is ""
	Labeling.CheckIndex(LabelsCall, Labeler.methods(0)) is ""
	Labeling.CheckIndex(LabelsMember, Labeler.methods(0)) is ""
	Scaling.CheckIndex(ScaledRead, Scaler.methods(0)) is ""
	position = types.Index(current.owner)
	if position < 0 or node.Kind is not "Call" or node.children.Length is not 1
		return ""
	returned = current.TypeOf(node.text)
	isPlain = types.ParameterScope(types.names(position)).TypeOf(node.text) is ""
	returned is not "" and isPlain then types.ElementType(returned) else ""
Unfit(call SyntaxNode, instance Text, method Text, inference TypeInference, scope Scope, current Scope) Text
	Scaling.Unfit(Rescaled, "Scaler", "Scaled", ScalerInference, Scalers, Scalers) is Unfitted
	Scaling.Unfit(ScaledOnce, "Scaler", "Scaled", ScalerInference, Scalers, Scalers) is ""
	Scaling.Unfit(ScaledTwice, "Scaler", "Scaled", ScalerInference, Scalers, Scalers).EndsWith("Number, Number")
	Scaling.Unfit(Rescaled, "Scaler", "Missing", ScalerInference, Scalers, Scalers) is ""
	Scaling.Unfit(Renamed, "Scaler", "Scaled", ScalerInference, Scalers, Scalers) is ""
	ListFits.Sorts.Unfit(ScaledRead, "Sorter", "Sorted", ScalerInference, Scalers, Scalers).StartsWith("IndexOrList")
	arguments = Arguments(call, inference, scope, current)
	isOverloaded = types.ParameterScope(instance).Count(method) > 1
	isNamed = call.children.Length > 0 and call.children.Last.Kind is "Reassignment"
	if isOverloaded is false or isNamed or Chosen(instance, method, arguments) >= 0
		return ""
	target = instance + "." + method
	if IsIndexing(instance, method, arguments, Ordinal(instance, method, arguments, false))
		reason = "(Number) indexes " + method + " or passes a one-element list, index a let of it"
		return "IndexOrListIsAmbiguous: " + target + reason
	"NoOverloadFits: " + target + " got " + Text.Combine(arguments, ", ")
Arguments(node SyntaxNode, inference TypeInference, scope Scope, current Scope) Texts
	Labeling.Arguments(LabelsMember, LabelInference, KnownTypes.NoMembers, Labeler.methods(0)).Length is 0
	Picking.Infer(SyntaxNode("Identifier", "value"), "A", LabelInference, KnownTypes.NoMembers, Relabeled) is "A"
	Picking.Infer(Mixing, "A", LabelInference, KnownTypes.NoMembers, KnownTypes.NoMembers) is "Unknown"
	Scaling.Unfit(SyntaxNode("Call", "Scaled"), "Scaler", "Scaled", ScalerInference, Scalers, Scalers).StartsWith("No")
	Picking.Infer(SecondCall, "Picker", LabelInference, KnownTypes.NoMembers, KnownTypes.NoMembers) is "Text"
	for Range(node.Kind is in ("Member", "MethodCall") then 1 else 0, node.children.Length)
		inference.TypeOf(node.children(value), scope, current)
Infer(node SyntaxNode, instanceType Text, inference TypeInference, scope Scope, current Scope) Text
	Picking.Infer(Mixing, "Picker", LabelInference, KnownTypes.NoMembers, KnownTypes.NoMembers) is "Numbers"
	Picking.Infer(Choosing, "Picker", LabelInference, KnownTypes.NoMembers, KnownTypes.NoMembers) is "Text"
	Labeling.Infer(LabelerLabels, "Labeler", LabelInference, KnownTypes.NoMembers, KnownTypes.NoMembers) is "List(Numbers)"
	if node.text is "value"
		return instanceType
	position = types.Index(instanceType)
	declared = position < 0 then "" else types.methods(position).TypeOf(node.text)
	if declared is not in ("Generic", "Generics")
		return types.MemberType(instanceType, node.text)
	parameters = types.ParameterNames(types.parameters(position).TypeOf(node.text + " types"))
	specialized = Specialize(declared, parameters, Arguments(node, inference, scope, current))
	specialized is declared then types.MemberType(instanceType, node.text) else specialized
Specialize(type Text, declared Texts, arguments Texts) Text
	Picking.Specialize("Generics", "Generics", "Numbers") is "Numbers"
	Picking.Specialize("Generic", ("Number", "Generics"), ("Number", "Texts")) is "Text"
	Picking.Specialize("Generic", "Number", "Number") is "Generic"
	Picking.Specialize("Generic", ("Number", "Generic"), ("Number", "Texts")) is "Texts"
	Picking.Specialize("Generic", List(Text) + "Generic", List(Text)) is "Generic"
	Picking.Specialize("Generic", ("Number", "Generic"), List(Text)) is "Generic"
	at = declared.Index("Generics") >= 0 then declared.Index("Generics") else declared.Index("Generic")
	if at < 0 or at >= arguments.Length
		return type
	element = declared(at) is "Generics" then types.ElementType(arguments(at)) else arguments(at)
	type is "Generics" then Instantiation(types).Plural(element) else element
Ambiguities(path Text, lines Texts) Texts
	Scaling.Ambiguities("A", Valued) is (Clashing)
	Scaling.Ambiguities("A", ("to Text", "\t\"a\"", "to Number", "\t1")).Length is 0
	Scaling.Ambiguities("A", Limits) is ("A:line 3: NameAlreadyDeclared: Limit like line 1")
	Twins.CheckIndex(SyntaxParser(Tokenizer("Values(2)").Tokens).Parse, TwinMethods(1)) is ""
	signatures = Signatures(lines)
	for signatures
		if value is not "" and signatures.Index(value) < index
			first = signatures.Index(value) + 1
			rule = value.EndsWith(")") then "OverloadsNeedDifferentParameterNames: " else "NameAlreadyDeclared: "
			ResolveCheck.Locate(path, index + 1, rule + value + " like line " + first)
Signatures(lines Texts) Texts
	Scaling.Signatures(Valued) is ("Value(name, default)", "", "Value(name, default)", "")
	Picking.Infer(SyntaxNode("Call", "Chosen"), "Picker", LabelInference, Relabeled, Relabeled) is "Unknown"
	shape = TypeShape(lines)
	for lines
		tokens = Tokenizer(value).Tokens
		name = shape.IsMethodHeader(value) then tokens.First else "to"
		signature = name is "to" then "" else name + "(" + Text.Combine(HeaderTokens(tokens).ParameterNames, ", ") + ")"
		shape.IsMemberLine(value) then tokens(1) else signature
