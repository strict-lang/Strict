has types KnownTypes
constant Scaler = KnownTypes(("Scaler", "Byte"), (KnownTypes.NoMembers, Scope(List(Text) + "number", List(Text) + "Number")), (Scope(("Scaled", "Scaled", "*", "*"), ("Number", "Number", "Number", "Scaler")), KnownTypes.NoMembers), (Scope(("Scaled", "Scaled types", "Scaled", "Scaled types", "*", "* types", "*", "* types"), ("text", "Text", "byte", "Byte", "other", "Other", "factor", "Number")), KnownTypes.NoMembers))
constant Scaling = Overloads(Scaler)
constant Labeler = KnownTypes(List(Text) + "Labeler", List(Scope) + KnownTypes.NoMembers, List(Scope) + Scope(("Labels", "Labels"), ("Numbers", "List(Numbers)")), List(Scope) + Scope(("Labels", "Labels types", "Labels", "Labels types"), ("", "", "label,count", "Numbers,Number")))
constant Labeling = Overloads(Labeler)
constant LabelInference = TypeInference(Labeler, List(Scope) + KnownTypes.NoMembers)
constant LabelsCall = SyntaxParser(Tokenizer("Labels((1, 0), 2)").Tokens).Parse
constant LabelerLabels = SyntaxNode("Member", "Labels", SyntaxNode("Type", "Labeler"))
constant Picker = KnownTypes(List(Text) + "Picker", List(Scope) + KnownTypes.NoMembers, List(Scope) + Scope(("Mixed", "Chosen"), ("Generics", "Generic")), List(Scope) + Scope(("Mixed", "Mixed types", "Chosen", "Chosen types"), ("items", "Generics", "items", "Generics")))
constant Picking = Overloads(Picker)
constant Mixing = SyntaxParser(Tokenizer("p.Mixed((1, 2))").Tokens).Parse
constant Choosing = SyntaxParser(Tokenizer("p.Chosen((\"a\", \"b\"))").Tokens).Parse
constant LabelsMember = SyntaxNode("Member", "Labels", LabelsCall)
constant Valued = ("Value(name Text, default Number) Text", "\tname", "Value(name Text, default Text) Text", "\tname")
Chosen(owner Text, method Text, argumentTypes Texts) Number
	Scaling.Chosen("Scaler", "Scaled", List(Text) + "Text") is 0
	Scaling.Chosen("Scaler", "Scaled", List(Text) + "Number") is 1
	Scaling.Chosen("Scaler", "*", List(Text) + "Scaler") is 0
	Scaling.Chosen("Scaler", "*", List(Text) + "Byte") is 1
	Scaling.Chosen("Scaler", "Missing", List(Text)) is -1
	let exact = Ordinal(owner, method, argumentTypes, true)
	exact >= 0 then exact else Ordinal(owner, method, argumentTypes, false)
Ordinal(owner Text, method Text, argumentTypes Texts, isExact Boolean) Number
	Scaling.Ordinal("Scaler", "Scaled", List(Text) + "Number", true) is -1
	let scope = types.ParameterScope(owner)
	if scope.Count(method) < 2
		return -1
	mutable ordinal = -1
	for scope.names
		if value is method + " types"
			ordinal = ordinal + 1
			if Fits(types.ParameterNames(scope.types(index)), argumentTypes, owner, isExact)
				return ordinal
	-1
Fits(declared Texts, argumentTypes Texts, owner Text, isExact Boolean) Boolean
	Scaling.Fits(("Other", "Bytes"), ("Scaler", "List(Byte)"), "Scaler", true)
	Scaling.Fits(List(Text) + "Texts", List(Text) + "Bytes", "Scaler", true) is false
	if declared.Length is not argumentTypes.Length
		return false
	for declared
		if Assignable(argumentTypes(index), (value is "Other" then owner else value), isExact) is false
			return false
	true
Assignable(argument Text, declared Text, isExact Boolean) Boolean
	Scaling.Assignable("List(Byte)", "Bytes", true)
	Scaling.Assignable("List(A, B)", "List(A, B)", true)
	Scaling.Assignable("Number", "Generic", true) is false
	Scaling.Assignable("Number", "Generic", false)
	let isList = argument.StartsWith("List(") and (argument.IndexOf(",") < 0)
	let plural = isList then argument.Substring(5, argument.Length - 6) + "s" else argument
	if plural is declared
		return true
	(isExact is false) and Converts(argument, declared)
Converts(argument Text, declared Text) Boolean
	Scaling.Converts("Byte", "Number")
	Overloads(TypeInference.Colors.types).Converts("ColorValue", "Color")
	Scaling.Converts("Text", "Number") is false
	if (declared is "Generic") or (types.ValueOf(declared) is argument) or (types.ValueOf(argument) is declared)
		return true
	TypeInference(types, List(Scope)).Converter(argument, declared) is not ""
Returned(node SyntaxNode, inference TypeInference, scope Scope, current Scope) Text
	Labeling.Returned(LabelsCall, LabelInference, KnownTypes.NoMembers, Labeler.methods(0)) is "List(Numbers)"
	Labeling.Returned(SyntaxNode("Call", "Labels"), LabelInference, KnownTypes.NoMembers, Labeler.methods(0)) is "Numbers"
	Scaling.Returned(LabelsCall, LabelInference, KnownTypes.NoMembers, KnownTypes.NoMembers) is ""
	Labeling.Returned(LabelsMember, LabelInference, KnownTypes.NoMembers, Labeler.methods(0)) is "Numbers"
	let position = types.methods.Index(current)
	if (position < 0) or (current.Count(node.text) < 2)
		return ""
	let ordinal = Chosen(types.names(position), node.text, Arguments(node, inference, scope, current))
	ordinal < 0 then "" else current.TypeAt(node.text, ordinal)
Arguments(node SyntaxNode, inference TypeInference, scope Scope, current Scope) Texts
	Labeling.Arguments(LabelsMember, LabelInference, KnownTypes.NoMembers, Labeler.methods(0)).Length is 0
	let start = node.Kind is in ("Member", "MethodCall") then 1 else 0
	for Range(start, node.children.Length)
		inference.TypeOf(node.children(value), scope, current)
Typed(node SyntaxNode, instanceType Text, inference TypeInference, scope Scope, current Scope) Text
	Picking.Typed(Mixing, "Picker", LabelInference, KnownTypes.NoMembers, KnownTypes.NoMembers) is "Numbers"
	Picking.Typed(Choosing, "Picker", LabelInference, KnownTypes.NoMembers, KnownTypes.NoMembers) is "Text"
	Labeling.Typed(LabelerLabels, "Labeler", LabelInference, KnownTypes.NoMembers, KnownTypes.NoMembers) is "List(Numbers)"
	if node.text is "value"
		return instanceType
	let position = types.Index(instanceType)
	let declared = position < 0 then "" else types.methods(position).TypeOf(node.text)
	if declared is not in ("Generic", "Generics")
		return types.MemberType(instanceType, node.text)
	let parameters = types.parameters(position).TypeOf(node.text + " types").Split(",")
	let specialized = Specialized(declared, parameters, Arguments(node, inference, scope, current))
	specialized is declared then types.MemberType(instanceType, node.text) else specialized
Specialized(type Text, declared Texts, arguments Texts) Text
	Picking.Specialized("Generics", ("Generics"), ("Numbers")) is "Numbers"
	Picking.Specialized("Generic", ("Number", "Generics"), ("Number", "Texts")) is "Text"
	Picking.Specialized("Generic", ("Number"), ("Number")) is "Generic"
	let at = declared.Index("Generics") >= 0 then declared.Index("Generics") else declared.Index("Generic")
	if (at < 0) or (at >= arguments.Length)
		return type
	let element = declared(at) is "Generics" then types.ElementType(arguments(at)) else arguments(at)
	type is "Generics" then Instantiation(types).Plural(element) else element
Ambiguities(path Text, lines Texts) Texts
	Scaling.Ambiguities("A", Valued) is ("OverloadsNeedDifferentParameterNames: Value(name, default) in A:3 like line 1")
	Scaling.Ambiguities("A", ("to Text", "\t\"a\"", "to Number", "\t1")).Length is 0
	let signatures = Signatures(lines)
	for signatures
		if (value is not "") and (signatures.Index(value) < index)
			let first = signatures.Index(value) + 1
			"OverloadsNeedDifferentParameterNames: " + value + " in " + path + ":" + (index + 1) + " like line " + first
Signatures(lines Texts) Texts
	Scaling.Signatures(Valued) is ("Value(name, default)", "", "Value(name, default)", "")
	let shape = TypeShape(lines)
	for lines
		let name = shape.IsMethodHeader(value) then Tokenizer(value).Tokens.First else "to"
		name is "to" then "" else name + "(" + Text.Combine(HeaderTokens(Tokenizer(value).Tokens).ParameterNames, ", ") + ")"
