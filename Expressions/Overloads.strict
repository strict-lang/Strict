has types KnownTypes
constant ScalerParameters = (Scope(("Scaled", "Scaled types", "Scaled", "Scaled types", "*", "* types", "*", "* types"), ("text", "Text", "byte", "Byte", "other", "Other", "factor", "Number")), KnownTypes.NoMembers)
constant Scaler = KnownTypes(("Scaler", "Byte"), (KnownTypes.NoMembers, Scope(("number"), ("Number"))), (Scope(("Scaled", "Scaled", "*", "*"), ("Number", "Number", "Number", "Scaler")), KnownTypes.NoMembers), ScalerParameters)
constant Scaling = Overloads(Scaler)
constant LabelsParameters = Scope(("Labels", "Labels types", "Labels", "Labels types"), ("", "", "label,count", "Numbers,Number"))
constant Labeler = KnownTypes(List(Text) + "Labeler", List(Scope) + KnownTypes.NoMembers, List(Scope) + Scope(("Labels", "Labels"), ("Numbers", "List(Numbers)")), List(Scope) + LabelsParameters)
constant Labeling = Overloads(Labeler)
constant LabelInference = TypeInference(Labeler, List(Scope) + KnownTypes.NoMembers)
constant LabelsCall = SyntaxParser(Tokenizer("Labels((1, 0), 2)").Tokens).Parse
constant LabelerLabels = SyntaxNode("Member", "Labels", SyntaxNode("Type", "Labeler"))
constant Presets = KnownTypes(List(Text) + "Presets", List(Scope) + KnownTypes.NoMembers, List(Scope) + Scope(List(Text) + "Preset", List(Text) + "Numbers"), List(Scope) + KnownTypes.NoMembers)
constant Presetting = Overloads(Presets)
constant PresetRead = SyntaxParser(Tokenizer("Preset(0)").Tokens).Parse
constant OtherRead = SyntaxParser(Tokenizer("Other(0)").Tokens).Parse
constant ScaledRead = SyntaxParser(Tokenizer("Scaled(3)").Tokens).Parse
constant Picker = KnownTypes(("Picker"), (KnownTypes.NoMembers), (Scope(("Mixed", "Chosen"), ("Generics", "Generic"))), (Scope(("Mixed", "Mixed types", "Chosen", "Chosen types"), ("items", "Generics", "items", "Generics"))))
constant Picking = Overloads(Picker)
constant Mixing = SyntaxParser(Tokenizer("p.Mixed((1, 2))").Tokens).Parse
constant Choosing = SyntaxParser(Tokenizer("p.Chosen((\"a\", \"b\"))").Tokens).Parse
constant LabelsMember = SyntaxNode("Member", "Labels", LabelsCall)
constant Valued = ("Value(name Text, default Number) Text", "\tname", "Value(name Text, default Text) Text", "\tname")
constant ListToText = KnownTypes(List(Text) + "List", List(Scope) + KnownTypes.NoMembers, List(Scope) + Scope(List(Text) + "to", List(Text) + "Text"), List(Scope) + KnownTypes.NoMembers)
constant DefaultNames = ("from", "from types", "from", "from types", "b default", "Get", "Get types", "Get", "Get types", "Get count default")
constant DefaultTypes = ("text", "Text", "a,b", "Number,Number", "0", "x,b", "Number,Number", "count", "Number", "1")
constant Defaulted = Overloads(KnownTypes(List(Text) + "D", List(Scope) + KnownTypes.NoMembers, List(Scope) + KnownTypes.NoMembers, List(Scope) + Scope(DefaultNames, DefaultTypes)))
constant ScalerInference = TypeInference(Scaler, (KnownTypes.NoMembers, KnownTypes.NoMembers))
constant Scalers = Scope(List(Text) + "scaler", List(Text) + "Scaler")
constant Unfitted = "NoOverloadFits: Scaler.Scaled got Scaler"
constant Rescaled = SyntaxParser(Tokenizer("scaler.Scaled(scaler)").Tokens).Parse
constant Renamed = SyntaxParser(Tokenizer("scaler.Scaled(scaler, factor = 2)").Tokens).Parse
constant ScaledOnce = SyntaxParser(Tokenizer("scaler.Scaled(1)").Tokens).Parse
constant ScaledTwice = SyntaxParser(Tokenizer("scaler.Scaled(1, 2)").Tokens).Parse
constant Relabeled = Scope(("Labels", "Labels", "X"), ("Numbers", "List(Numbers)", "Number"))
Chosen(owner Text, method Text, argumentTypes Texts) Number
	Scaling.Chosen("Scaler", "Scaled", List(Text) + "Text") is 0
	Scaling.Chosen("Scaler", "Scaled", List(Text) + "Number") is 1
	Scaling.Chosen("Scaler", "*", List(Text) + "Scaler") is 0
	Scaling.Chosen("Scaler", "*", List(Text) + "Byte") is 1
	Scaling.Chosen("Scaler", "Missing", List(Text)) is -1
	Scaling.Chosen("Scaler", "*", List(Text) + "Number") is 1
	Defaulted.Chosen("D", "from", List(Text) + "Number") is 1
	Defaulted.Chosen("D", "from", ("Number", "Number")) is 1
	let exact = Ordinal(owner, method, argumentTypes, true)
	exact >= 0 then exact else Ordinal(owner, method, argumentTypes, false)
Ordinal(owner Text, method Text, arguments Texts, isExact Boolean) Number
	Scaling.Ordinal("Scaler", "Scaled", List(Text) + "Number", true) is -1
	Picking.Ordinal("Picker", "Mixed", List(Text) + "Generics", true) is -1
	let scope = types.ParameterScope(owner)
	if scope.Count(method) < 2
		return -1
	mutable ordinal = -1
	for scope.names
		if value is method + " types"
			ordinal = ordinal + 1
			if Fits(types.ParameterNames(scope.types(index)), arguments, owner, isExact, Required(owner, method, ordinal).Length)
				return ordinal
	-1
Required(owner Text, method Text, ordinal Number) Texts
	Defaulted.Required("D", "from", 1) is ("a") and (Defaulted.Required("D", "from", 0) is ("text"))
	Labeling.Required("Labeler", "Labels", 0).Length is 0
	Defaulted.Required("D", "Get", 1).Length is 0 and (Defaulted.Required("D", "Get", 0) is ("x", "b"))
	Defaulted.Chosen("D", "Get", List(Text) + "Number") is 1 and (Defaulted.Chosen("D", "Get", List(Text)) is 1)
	let scope = types.ParameterScope(owner)
	for scope.TypeAt(method, ordinal).Split(",")
		let isOwn = scope.TypeOf(method + " " + value + " default") is not ""
		let isMember = (method is "from") and (scope.TypeOf(value + " default") is not "")
		if (value is not "") and ((isOwn or isMember) is false)
			value
Fits(declared Texts, argumentTypes Texts, owner Text, isExact Boolean, required Number) Boolean
	Scaling.Fits(("Other", "Bytes"), ("Scaler", "List(Byte)"), "Scaler", true, 2)
	Scaling.Fits(List(Text) + "Texts", List(Text) + "Bytes", "Scaler", true, 1) is false
	Scaling.Fits(("Number", "Number"), List(Text) + "Number", "Scaler", true, 1)
	Scaling.Fits(("Number", "Number"), List(Text) + "Number", "Scaler", true, 2) is false
	Scaling.Fits(List(Text) + "Number", ("Number", "Number"), "Scaler", true, 1) is false
	if (argumentTypes.Length > declared.Length) or (argumentTypes.Length < required)
		return false
	for argumentTypes
		if Assignable(value, (declared(index) is "Other" then owner else declared(index)), isExact) is false
			return false
	true
Assignable(argument Text, declared Text, isExact Boolean) Boolean
	Scaling.Assignable("List(Byte)", "Bytes", true)
	Scaling.Assignable("List(A, B)", "List(A, B)", true)
	Scaling.Assignable("Number", "Generic", true) is false
	Scaling.Assignable("Number", "Generic", false)
	Scaling.Assignable("Bytes", "Numbers", false) and (Scaling.Assignable("Bytes", "Numbers", true) is false)
	let isList = argument.StartsWith("List(") and (argument.IndexOf(",") < 0)
	let plural = isList then argument.Substring(5, argument.Length - 6) + "s" else argument
	if plural is declared
		return true
	(isExact is false) and ListFits(types).Widened(argument, declared)
Converts(argument Text, declared Text) Boolean
	Scaling.Converts("Byte", "Number")
	Overloads(TypeInference.Colors.types).Converts("ColorValue", "Color")
	Scaling.Converts("Text", "Number") is false
	Overloads(ListToText).Converts("Texts", "Text") is false
	Overloads(TypeInference.Colors.types).Converts("Color", "ColorValue")
	if (declared is "Generic") or (types.ValueOf(declared) is argument) or (types.ValueOf(argument) is declared)
		return true
	let converter = TypeInference(types, List(Scope)).Converter(argument, declared)
	(converter is "from") or (converter is "to") and (ListFits(types).Elements(argument).Length is 0)
Returned(node SyntaxNode, inference TypeInference, scope Scope, current Scope) Text
	Labeling.Returned(LabelsCall, LabelInference, KnownTypes.NoMembers, Labeler.methods(0)) is "List(Numbers)"
	Labeling.Returned(SyntaxNode("Call", "Labels"), LabelInference, KnownTypes.NoMembers, Labeler.methods(0)) is "Numbers"
	Scaling.Returned(LabelsCall, LabelInference, KnownTypes.NoMembers, KnownTypes.NoMembers) is ""
	Labeling.Returned(LabelsMember, LabelInference, KnownTypes.NoMembers, Labeler.methods(0)) is "Numbers"
	Scaling.Returned(SyntaxNode("Call", "Scaled"), LabelInference, KnownTypes.NoMembers, Scaler.methods(0)) is ""
	Labeling.Returned(LabelsCall, LabelInference, KnownTypes.NoMembers, Relabeled) is ""
	let position = types.methods.Index(current)
	if (position < 0) or (current.Count(node.text) < 2)
		return Indexed(node, current)
	let ordinal = Chosen(types.names(position), node.text, Arguments(node, inference, scope, current))
	ordinal < 0 then "" else current.TypeAt(node.text, ordinal)
Indexed(node SyntaxNode, current Scope) Text
	Presetting.Indexed(PresetRead, Presets.methods(0)) is "Number"
	Presetting.Indexed(SyntaxNode("Call", "Preset"), Presets.methods(0)) is ""
	Presetting.Indexed(OtherRead, Presets.methods(0)) is ""
	Presetting.Indexed(PresetRead, KnownTypes.NoMembers) is ""
	(Labeling.Indexed(LabelsCall, Labeler.methods(0)) is "") and (Labeling.Indexed(LabelsMember, Labeler.methods(0)) is "")
	Scaling.Indexed(ScaledRead, Scaler.methods(0)) is ""
	let position = types.methods.Index(current)
	if (position < 0) or (node.Kind is not "Call") or (node.children.Length is not 1)
		return ""
	let returned = current.TypeOf(node.text)
	let isPlain = types.ParameterScope(types.names(position)).TypeOf(node.text) is ""
	(returned is not "") and isPlain then types.ElementType(returned) else ""
Unfit(call SyntaxNode, instance Text, method Text, inference TypeInference, scope Scope, current Scope) Text
	Scaling.Unfit(Rescaled, "Scaler", "Scaled", ScalerInference, Scalers, Scalers) is Unfitted
	Scaling.Unfit(ScaledOnce, "Scaler", "Scaled", ScalerInference, Scalers, Scalers) is ""
	Scaling.Unfit(ScaledTwice, "Scaler", "Scaled", ScalerInference, Scalers, Scalers).EndsWith("Number, Number")
	Scaling.Unfit(Rescaled, "Scaler", "Missing", ScalerInference, Scalers, Scalers) is ""
	Scaling.Unfit(Renamed, "Scaler", "Scaled", ScalerInference, Scalers, Scalers) is ""
	let arguments = Arguments(call, inference, scope, current)
	let isOverloaded = types.ParameterScope(instance).Count(method) > 1
	let isNamed = (call.children.Length > 0) and (call.children.Last.Kind is "Reassignment")
	let isUnfit = isOverloaded and (isNamed is false) and (Chosen(instance, method, arguments) < 0)
	isUnfit then "NoOverloadFits: " + instance + "." + method + " got " + Text.Combine(arguments, ", ") else ""
Arguments(node SyntaxNode, inference TypeInference, scope Scope, current Scope) Texts
	Labeling.Arguments(LabelsMember, LabelInference, KnownTypes.NoMembers, Labeler.methods(0)).Length is 0
	Picking.Typed(SyntaxNode("Identifier", "value"), "A", LabelInference, KnownTypes.NoMembers, Relabeled) is "A"
	Picking.Typed(Mixing, "A", LabelInference, KnownTypes.NoMembers, KnownTypes.NoMembers) is "Unknown"
	let start = node.Kind is in ("Member", "MethodCall") then 1 else 0
	for Range(start, node.children.Length)
		inference.TypeOf(node.children(value), scope, current)
Typed(node SyntaxNode, instanceType Text, inference TypeInference, scope Scope, current Scope) Text
	Picking.Typed(Mixing, "Picker", LabelInference, KnownTypes.NoMembers, KnownTypes.NoMembers) is "Numbers"
	Picking.Typed(Choosing, "Picker", LabelInference, KnownTypes.NoMembers, KnownTypes.NoMembers) is "Text"
	Labeling.Typed(LabelerLabels, "Labeler", LabelInference, KnownTypes.NoMembers, KnownTypes.NoMembers) is "List(Numbers)"
	if node.text is "value"
		return instanceType
	let position = types.Index(instanceType)
	let declared = position < 0 then "" else types.methods(position).TypeOf(node.text)
	if declared is not in ("Generic", "Generics")
		return types.MemberType(instanceType, node.text)
	let parameters = types.parameters(position).TypeOf(node.text + " types").Split(",")
	let specialized = Specialized(declared, parameters, Arguments(node, inference, scope, current))
	specialized is declared then types.MemberType(instanceType, node.text) else specialized
Specialized(type Text, declared Texts, arguments Texts) Text
	Picking.Specialized("Generics", ("Generics"), ("Numbers")) is "Numbers"
	Picking.Specialized("Generic", ("Number", "Generics"), ("Number", "Texts")) is "Text"
	Picking.Specialized("Generic", ("Number"), ("Number")) is "Generic"
	Picking.Specialized("Generic", ("Number", "Generic"), ("Number", "Texts")) is "Texts"
	Picking.Specialized("Generic", List(Text) + "Generic", List(Text)) is "Generic"
	let at = declared.Index("Generics") >= 0 then declared.Index("Generics") else declared.Index("Generic")
	if (at < 0) or (at >= arguments.Length)
		return type
	let element = declared(at) is "Generics" then types.ElementType(arguments(at)) else arguments(at)
	type is "Generics" then Instantiation(types).Plural(element) else element
Ambiguities(path Text, lines Texts) Texts
	Scaling.Ambiguities("A", Valued) is ("OverloadsNeedDifferentParameterNames: Value(name, default) in A:3 like line 1")
	Scaling.Ambiguities("A", ("to Text", "\t\"a\"", "to Number", "\t1")).Length is 0
	let signatures = Signatures(lines)
	for signatures
		if (value is not "") and (signatures.Index(value) < index)
			let first = signatures.Index(value) + 1
			"OverloadsNeedDifferentParameterNames: " + value + " in " + path + ":" + (index + 1) + " like line " + first
Signatures(lines Texts) Texts
	Scaling.Signatures(Valued) is ("Value(name, default)", "", "Value(name, default)", "")
	let shape = TypeShape(lines)
	for lines
		let name = shape.IsMethodHeader(value) then Tokenizer(value).Tokens.First else "to"
		name is "to" then "" else name + "(" + Text.Combine(HeaderTokens(Tokenizer(value).Tokens).ParameterNames, ", ") + ")"
