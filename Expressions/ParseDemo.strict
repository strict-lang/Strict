has logger
Run
	logger.Log(ExpressionParser("not true").ParseLine)
	logger.Log(ExpressionParser("a + b").ParseLine)
	logger.Log(ExpressionParser("let x = 1").ParseLine)
	logger.Log(ExpressionParser("return 1").ParseLine)
	logger.Log(ExpressionParser("true").ParseLine)
	logger.Log(ShuntingYard("a + b * c").Postfix.Length)