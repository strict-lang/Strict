constant IsRequested = Process.Variable("STRICT_BUILD_PROFILE") is "1"
IsDetailed Boolean
	IsRequested
Report(phase Text, started Number)
	Phases.Report("a", Process.Elapsed) is not Error
	elapsed = Process.Elapsed - started
	if IsDetailed or elapsed >= 3
		logger.Log((IsDetailed then "[build] " + phase else phase) + ": " + elapsed.Round(IsDetailed then 4 else 2) + " s")
Shapes(files Texts) List(TypeShape)
	started = Process.Elapsed
	shapes = ResolveCheck.Shapes(files)
	Report("Frontend / shape loading and fusion (" + files.Length + " files)", started)
	shapes
