has input Text
Tokens Texts
	PhraseTokenizer("a + b").Tokens is ("a", "+", "b")
	PhraseTokenizer("not true").Tokens is ("not", "true")
	input.Split(" ")
TokenCount Number
	PhraseTokenizer("a + b").TokenCount is 3
	Tokens.Length
Token(index Number) Text
	PhraseTokenizer("a + b").Token(1) is "+"
	Tokens(index)
IsValidInput Boolean
	PhraseTokenizer("a + b").IsValidInput is true
	PhraseTokenizer("").IsValidInput is false
	input.Length > 0
HasSpaces Boolean
	PhraseTokenizer("a b").HasSpaces is true
	input.IndexOf(" ") is not -1
to Text
	input
