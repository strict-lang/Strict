has logger
Run(folder Text, root Text)
	let files = AllFiles(root) + Directory.Files(folder, "*.strict")
	let known = TypeNames(files) + ("value", "index", "outer")
	mutable unresolved = 0
	for Directory.Files(folder, "*.strict")
		unresolved = unresolved + CheckFile(value, files, known)
	logger.Log("Unresolved names: " + unresolved)
CheckFile(path Text, files Texts, known Texts) Number
	let shape = TypeShape(File(path).ReadLines)
	let unresolved = FileCheck(shape, TypeInference(files), known + shape.MemberNames + shape.MethodNames).Unresolved
	for unresolved
		logger.Log(path + ": " + value)
	unresolved.Length
AllFiles(root Text) Texts
	mutable files = Directory.Files(root, "*.strict")
	for Directory.Directories(root)
		files = files + Directory.Files(value, "*.strict")
	files
TypeNames(files Texts) Texts
	for files
		Path(value).FileName.RemoveExtension.text