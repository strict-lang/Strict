has logger
constant Counting = TypeInference(KnownTypes.Sample, (KnownTypes.NoMembers, KnownTypes.NoMembers))
constant Stray = "A.strict:line 3: MembersMustComeBeforeMethods: constant B = 1"
constant Joined = ("Names Texts", "\t\"a\" + \"b\"")
constant Joining = MethodBodies("Demo", TypeShape(Joined), Counting)
constant Missing = ("Names Texts", "\tmissing")
constant Missed = MethodBodies("Demo", TypeShape(Missing), Counting)
constant WriterParameters = Scope(("Write", "Write", "Read", "Seek", "Seek", TypeShape.Constrained, TypeShape.Constrained), ("lines", "bytes", "", "", "", "a", "b"))
constant Writers = KnownTypes(("W", "V"), (KnownTypes.NoMembers, KnownTypes.NoMembers), (KnownTypes.NoMembers, KnownTypes.NoMembers), (WriterParameters, Scope(("Go", "Go"), ("a", "b"))))
constant OverloadShapes = (TypeShape("Write(lines Texts)"), TypeShape("Go Number", "\t1"))
constant Writing = TypeShape("has W", "has V")
constant DataNames = ("Content", "Tools")
Unresolved(path Text, inference TypeInference) Texts
	ResolveCheck.Unresolved("Logger.strict", Inference(("Logger.strict", "TextWriter.strict"))).Length is 0
	let lines = File(path).ReadLines
	let bodies = MethodBodies(TypeName(path), TypeShape(lines), inference)
	let known = inference.types.names + ("value", "index", "outer") + inference.types.ShapeScope(TypeName(path)).names
	let check = FileCheck(inference, known)
	let issues = check.Unimplemented(path, lines) + DefaultCheck(inference).Unsupported(path, lines)
	let ambiguous = TypeChoice(lines).Ambiguous(inference.types.names, path)
	let overloaded = Overloads(inference.types).Ambiguities(path, lines)
	let placed = issues + Misplaced(path, lines) + Constraint.Where(path, lines)
	placed + ambiguous + overloaded + Found(check, bodies, lines, path)
Misplaced(path Text, lines Texts) Texts
	ResolveCheck.Misplaced("A.strict", ("Run", "\t1", "constant B = 1")) is (Stray)
	ResolveCheck.Misplaced("A.strict", ("constant B = 1", "Run", "\t1")).Length is 0
	for Limits(lines, false).OrderIssues
		Located(path, value.Line, value to Text)
Found(check FileCheck, bodies MethodBodies, lines Texts, path Text) Texts
	ResolveCheck.Found(FileCheck(Counting, List(Text)), Joining, Joined, "A.strict").First.StartsWith("A.strict:line 2: ")
	ResolveCheck.Found(FileCheck(Counting, List(Text)), Missed, Missing, "A").First is "A:line 2: NameNotFound: missing"
	for bodies.Statements
		let found = check.Unknown(value, bodies.Methods)
		let returns = ReturnTypes(check.inference)
		let returned = found is "" then returns.Issue(value, bodies.Methods, lines) else found
		let unknown = returned is "" then returns.Unresulted(value, bodies.Methods, lines) else returned
		if unknown is not ""
			Located(path, value.line + 1, unknown)
Located(path Text, line Number, issue Text) Text
	ResolveCheck.Located("A.strict", 2, "NameNotFound: b") is "A.strict:line 2: NameNotFound: b"
	path + ":line " + line + ": " + issue
Tree(folder Text) Texts
	ResolveCheck.Tree("./Math") is List(Text) + "./Math"
	"./Examples/NativeAdd" is in ResolveCheck.Tree("./Examples")
	ResolveCheck.Tree("./Tools").Length is 0
	mutable folders = List(Mutable(Text))
	if Directory.Files(folder, "*.strict").Length > 0
		folders.Add(folder)
	for Directory.Directories(folder)
		let name = Path(value.Replace("\\", "/")).FileName.text
		if IsCode(name, folder + "/" + name)
			folders = folders + Tree(folder + "/" + name)
	folders
IsCode(name Text, path Text) Boolean
	ResolveCheck.IsCode("Math", "./Math") and ResolveCheck.IsCode("Content", "./Math")
	(ResolveCheck.IsCode("Release", "./Math") or ResolveCheck.IsCode("Tools", "./Tools")) is false
	(ResolveCheck.IsCode("obj", "./obj") or ResolveCheck.IsCode(".git", "./.git")) is false
	let first = name(0)
	let isData = (name is "Release") or ((name is in DataNames) and (Directory.Files(path, "*.strict").Length is 0))
	(first is first.Upper) and (first is not first.Lower) and (isData is false)
AllFiles(root Text) Texts
	mutable files = Directory.Files(root, "*.strict")
	for Directory.Directories(root)
		files = files + Directory.Files(value, "*.strict")
	files
Refined(inference TypeInference, shapes List(TypeShape)) TypeInference
	ResolveCheck.Refined(Counting, List(TypeShape)).types.methods.Length is 0
	Inference(("File.strict", "TextWriter.strict", "BytesWriter.strict")).types.ParameterScope("File").Count("Write") is 2
	let types = KnownTypes(inference.types, positions = Positions(inference.types.names))
	let indexed = TypeInference(types, inference.constants)
	mutable methods = List(Mutable(Scope))
	mutable parameters = List(Mutable(Scope))
	for shapes
		let typed = ShapeTyping(indexed).Typed(value, types.methods(index), types.names(index))
		methods.Add(typed.Indexed.Owned(types.names(index)))
		parameters.Add(Overloaded(types, shapes, value, types.parameters(index)))
	TypeInference(KnownTypes(types, methods = methods, parameters = parameters), inference.constants)
Overloaded(types KnownTypes, shapes List(TypeShape), shape TypeShape, scope Scope) Scope
	ResolveCheck.Overloaded(Counting.types, List(TypeShape), TypeShape("has a"), KnownTypes.NoMembers).names.Length is 0
	mutable traits = KnownTypes.NoMembers
	for shape.MemberScope.types
		let position = types.Index(value)
		if (position >= 0) and shapes(position).IsTrait
			traits = traits.WithAll(types.parameters(position).names, types.parameters(position).types)
	mutable result = scope
	for traits.names
		if (traits.Count(value) > 1) and (scope.Count(value) is 0) and (value is not TypeShape.Constrained)
			result = result.With(value, traits.types(index))
	result
Positions(names Texts) Dictionary(Text, Number)
	ResolveCheck.Positions(("A", "B", "A"))("A") is 0
	ResolveCheck.Positions(("A", "B", "A"))("B") is 1
	mutable positions = Dictionary(Text, Number)
	for names
		if value is not in positions
			positions(value) = index
	positions
TypeNames(files Texts) Texts
	for files
		TypeName(value)
Inference(files Texts) TypeInference
	let shapes = BuildProfile(Logger).Shapes(files)
	let generics = Generics(files, shapes)
	mutable members = List(Mutable(Scope))
	mutable methods = List(Mutable(Scope))
	mutable parameters = List(Mutable(Scope))
	mutable constants = List(Mutable(Scope))
	for shapes
		members.Add(value.MemberScope.Indexed.Owned(TypeName(files(index))))
		methods.Add(value.MethodScope)
		parameters.Add(value.CallScope(generics))
		constants.Add(value.ConstantScope)
	Refined(TypeInference(KnownTypes(TypeNames(files), members, methods, parameters), constants), shapes)
Shapes(files Texts) List(TypeShape)
	for files
		TypeShape(Fusion(File(value).ReadLines, Path(value).PathOnly.text).Fused)
Generics(files Texts, shapes List(TypeShape)) Texts
	for shapes
		if value.UsesGenerics
			TypeName(files(index))
TypeName(path Text) Text
	TypeName("Examples/Sum.strict") is "Sum"
	ResolveCheck.Overloaded(Writers, OverloadShapes, Writing, Scope(("Seek"), ("x"))).names is ("Seek", "Write", "Write")
	Path(path).FileName.RemoveExtension.text