has logger
Run(folder Text, root Text)
	let inference = Inference(Directory.Files(folder, "*.strict") + AllFiles(root))
	let known = inference.types.names + ("value", "index", "outer")
	mutable unresolved = 0
	for Directory.Files(folder, "*.strict")
		unresolved = unresolved + CheckFile(value, inference, known)
	logger.Log("Unresolved names: " + unresolved)
CheckFile(path Text, inference TypeInference, known Texts) Number
	let shape = TypeShape(File(path).ReadLines)
	let statements = MethodBodies(TypeName(path), shape, inference).Statements
	let typeNames = inference.types.ShapeScope(TypeName(path)).names
	let unresolved = FileCheck(inference, known + typeNames).Unresolved(statements)
	for unresolved
		logger.Log(path + ": " + value)
	unresolved.Length
AllFiles(root Text) Texts
	mutable files = Directory.Files(root, "*.strict")
	for Directory.Directories(root)
		files = files + Directory.Files(value, "*.strict")
	files
TypeNames(files Texts) Texts
	for files
		TypeName(value)
Inference(files Texts) TypeInference
	let shapes = Shapes(files)
	let generics = Generics(files, shapes)
	mutable members = List(Mutable(Scope))
	mutable methods = List(Mutable(Scope))
	mutable parameters = List(Mutable(Scope))
	mutable constants = List(Mutable(Scope))
	for shapes
		members.Add(value.MemberScope)
		methods.Add(value.MethodScope)
		parameters.Add(value.CallScope(generics))
		constants.Add(value.ConstantScope)
	TypeInference(KnownTypes(TypeNames(files), members, methods, parameters), constants)
Shapes(files Texts) List(TypeShape)
	for files
		TypeShape(File(value).ReadLines)
Generics(files Texts, shapes List(TypeShape)) Texts
	for shapes
		if value.UsesGenerics
			TypeName(files(index))
TypeName(path Text) Text
	TypeName("Examples/Sum.strict") is "Sum"
	Path(path).FileName.RemoveExtension.text