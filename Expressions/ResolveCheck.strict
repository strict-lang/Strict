has logger
constant Counting = TypeInference(KnownTypes.Sample, (KnownTypes.NoMembers, KnownTypes.NoMembers))
constant Joined = ("Names Texts", "\t\"a\" + \"b\"")
constant Joining = MethodBodies("Demo", TypeShape(Joined), Counting)
Run(folder Text, root Text)
	let inference = Inference(Directory.Files(folder, "*.strict") + AllFiles(root))
	mutable unresolved = List(Mutable(Text))
	for Directory.Files(folder, "*.strict")
		unresolved = unresolved + Unresolved(value, inference)
	for unresolved
		logger.Log(value)
	logger.Log("Unresolved names: " + unresolved.Length)
Unresolved(path Text, inference TypeInference) Texts
	ResolveCheck.Unresolved("Logger.strict", Inference(("Logger.strict", "TextWriter.strict"))).Length is 0
	let lines = File(path).ReadLines
	let bodies = MethodBodies(TypeName(path), TypeShape(lines), inference)
	let known = inference.types.names + ("value", "index", "outer") + inference.types.ShapeScope(TypeName(path)).names
	let check = FileCheck(inference, known)
	let issues = check.Unimplemented(path, lines) + DefaultCheck(inference).Unsupported(path, lines)
	let ambiguous = TypeChoice(lines).Ambiguous(inference.types.names, path)
	issues + Constraint.Where(path, lines) + ambiguous + Found(check, bodies, lines, path)
Found(check FileCheck, bodies MethodBodies, lines Texts, path Text) Texts
	ResolveCheck.Found(FileCheck(Counting, List(Text)), Joining, Joined, "A.strict").First.EndsWith("A.strict:2")
	for bodies.Statements
		let found = check.Unknown(value, bodies.Methods)
		let unknown = found is "" then ReturnTypes(check.inference).Issue(value, bodies.Methods, lines) else found
		if unknown is not ""
			unknown + " used in " + path + ":" + (value.line + 1)
Tree(folder Text) Texts
	ResolveCheck.Tree("./Math") is List(Text) + "./Math"
	"./Examples/NativeAdd" is in ResolveCheck.Tree("./Examples")
	mutable folders = List(Mutable(Text)) + folder
	for Directory.Directories(folder)
		let name = Path(value.Replace("\\", "/")).FileName.text
		let first = name.Substring(0, 1)
		if (first is first.Upper) and (first is not first.Lower)
			folders = folders + Tree(folder + "/" + name)
	folders
AllFiles(root Text) Texts
	mutable files = Directory.Files(root, "*.strict")
	for Directory.Directories(root)
		files = files + Directory.Files(value, "*.strict")
	files
Refined(inference TypeInference, shapes List(TypeShape)) TypeInference
	ResolveCheck.Refined(Counting, List(TypeShape)).types.methods.Length is 0
	Inference(("File.strict", "TextWriter.strict", "BytesWriter.strict")).types.ParameterScope("File").Count("Write") is 2
	let types = inference.types
	mutable methods = List(Mutable(Scope))
	mutable parameters = List(Mutable(Scope))
	for shapes
		methods.Add(ShapeTyping(inference).Typed(value, types.methods(index), types.names(index)))
		parameters.Add(Overloaded(types, shapes, value, types.parameters(index)))
	TypeInference(KnownTypes(types.names, types.members, methods, parameters), inference.constants)
Overloaded(types KnownTypes, shapes List(TypeShape), shape TypeShape, scope Scope) Scope
	ResolveCheck.Overloaded(Counting.types, List(TypeShape), TypeShape("has a"), KnownTypes.NoMembers).names.Length is 0
	mutable traits = KnownTypes.NoMembers
	for shape.MemberScope.types
		let position = types.names.Index(value)
		if (position >= 0) and shapes(position).IsTrait
			traits = traits.WithAll(types.parameters(position).names, types.parameters(position).types)
	mutable result = scope
	for traits.names
		if (traits.Count(value) > 1) and (scope.Count(value) is 0) and (value is not TypeShape.Constrained)
			result = result.With(value, traits.types(index))
	result
TypeNames(files Texts) Texts
	for files
		TypeName(value)
Inference(files Texts) TypeInference
	let shapes = Shapes(files)
	let generics = Generics(files, shapes)
	mutable members = List(Mutable(Scope))
	mutable methods = List(Mutable(Scope))
	mutable parameters = List(Mutable(Scope))
	mutable constants = List(Mutable(Scope))
	for shapes
		members.Add(value.MemberScope)
		methods.Add(value.MethodScope)
		parameters.Add(value.CallScope(generics))
		constants.Add(value.ConstantScope)
	Refined(TypeInference(KnownTypes(TypeNames(files), members, methods, parameters), constants), shapes)
Shapes(files Texts) List(TypeShape)
	for files
		TypeShape(Fusion(File(value).ReadLines).Fused)
Generics(files Texts, shapes List(TypeShape)) Texts
	for shapes
		if value.UsesGenerics
			TypeName(files(index))
TypeName(path Text) Text
	TypeName("Examples/Sum.strict") is "Sum"
	Path(path).FileName.RemoveExtension.text