has inference TypeInference
constant Naming = ReturnTypes(TypeInference(KnownTypes.Sample, (KnownTypes.NoMembers, KnownTypes.NoMembers)))
constant Named = Scope(List(Text) + "name", List(Text) + "Text")
constant Joined = ScopedStatement(SyntaxParser(Tokenizer("\"a\" + name").Tokens).Parse, Named, 1)
constant Splitted = ScopedStatement(SyntaxParser(Tokenizer("name.Split(\",\")").Tokens).Parse, Named, 1)
constant Dropped = Scope((" dropped", "name"), ("Boolean", "Text"))
constant Returned = ScopedStatement(SyntaxNode("Return", "", List(SyntaxNode) + Joined.statement), Named, 1)
constant Bodied = ScopedStatement(SyntaxNode("Binary", "+", Joined.statement.children + SyntaxNode("Body", "")), Named, 1)
constant Counted = ScopedStatement(SyntaxParser(Tokenizer("1").Tokens).Parse, Named, 1)
constant Coupling = ReturnTypes(Instantiation.Inferring)
constant Early = ScopedStatement(SyntaxNode("Return", "", List(SyntaxNode) + BranchTypes.Paired.children(1)), Named, 2)
constant Making = ("Made(first Boolean) Couple", "\tif first", "\t\treturn Couple(1, 2)", "\tCouple(\"a\", 2)")
constant Bare = ScopedStatement(SyntaxNode("Return", "return"), Named, 2)
constant Unreturned = ScopedStatement(SyntaxNode("Declaration", "let a", Early.statement.children), Named, 2)
constant Finals = Scope(List(Text) + "Made", List(Text) + "Couple(Text, Number)")
constant Lines = ("Names Texts", "\tvalue")
constant Looped = ("Names Texts", "\tfor names", "\t\tvalue")
constant Drawers = Scope(("Drawn", "Count"), ("None", "Number"))
constant Tail = ScopedStatement(SyntaxParser(Tokenizer("Drawn(1)").Tokens).Parse, Named, 1)
constant Branched = ScopedStatement(SyntaxParser(Tokenizer("name is \"a\" then 0 else Drawn(1)").Tokens).Parse, Named, 1)
constant Argued = ScopedStatement(SyntaxParser(Tokenizer("Count(Drawn(1))").Tokens).Parse, Dropped, 1)
constant Compared = ScopedStatement(SyntaxParser(Tokenizer("Drawn(1) is Error").Tokens).Parse, Named, 1)
constant Unreturning = ScopedStatement(SyntaxNode("Return", "", List(SyntaxNode) + Tail.statement), Dropped, 1)
constant Valued = SyntaxParser(Tokenizer("Count(1)").Tokens).Parse
constant Assigned = ScopedStatement(SyntaxNode("Declaration", "let x", List(SyntaxNode) + Tail.statement), Dropped, 1)
constant Counting = ("Count Number", "\tDrawn(1)")
constant Running = ("Run", "\tDrawn(1)")
constant Keeping = ("Return", "Declaration", "Reassignment", "Ignore")
constant Calls = ("Call", "Member", "MethodCall", "Identifier")
constant Unvalued = "ReturnTypeMismatch: Drawn has no return type, its call gives no value"
Issue(scoped ScopedStatement, current Scope, lines Texts) Text
	Naming.Issue(Joined, Named, Lines).StartsWith("ReturnTypeMismatch: a Text is returned for Texts")
	Naming.Issue(Splitted, Named, Lines) is ""
	Naming.Issue(ScopedStatement(Joined.statement, Named, 2), Named, Looped) is ""
	constant hint = ", brackets around an operator only group, List(Text) + value is a list of one"
	let node = scoped.statement
	if (IsTail(scoped, lines) is false) or node.HasBody or (node.Kind is in ("Declaration", "Reassignment", "Return"))
		return Split(scoped, current, lines)
	let declared = Declared(lines, scoped.line)
	let type = inference.TypeOf(node, scoped.scope, current)
	let isSingle = inference.types.IsPlural(declared) and (inference.types.ElementType(declared) is type)
	isSingle then "ReturnTypeMismatch: a " + type + " is returned for " + declared + hint else ""
Split(scoped ScopedStatement, current Scope, lines Texts) Text
	Coupling.Split(Early, Finals, Making).EndsWith(" gives a Couple(Number, Number) or a Couple(Text, Number)")
	Coupling.Split(Early, Scope(Finals.names, List(Text) + "Couple(Number, Number)"), Making) is ""
	Coupling.Split(Early, Finals, Making).StartsWith("ConditionalBranchesMustHaveOneType: return Couple(1, 2) gives a ")
	(Coupling.Split(Unreturned, Finals, Making) + Coupling.Split(Bare, Finals, Making)) is ""
	let node = scoped.statement
	if (node.Kind is not "Return") or (node.HasValue is false)
		return ""
	let type = inference.TypeOf(node.children(0), scoped.scope, current)
	let name = Header(lines, scoped.line).tokens.First
	let final = current.TypeAt(name, TypeShape(lines).Overload(name, scoped.line))
	let message = "ConditionalBranchesMustHaveOneType: " + node + " gives a " + type + " or a " + final
	BranchTypes(inference).IsSplit(type, final) then message else ""
Declared(lines Texts, line Number) Text
	Naming.Declared(Lines, 1) is "Texts"
	Naming.Declared(Looped, 2) is "Texts"
	Naming.Issue(ScopedStatement(Joined.statement, Dropped, 1), Named, Lines) is ""
	Naming.Issue(Returned, Named, ("Names Unknowns", "\tvalue")) is "" and (Naming.Issue(Bodied, Named, Lines) is "")
	Naming.Issue(Counted, Named, ("Count Number", "\tvalue")) is ""
	Header(lines, line).ReturnType
Header(lines Texts, line Number) HeaderTokens
	Naming.Header(Lines, 1).tokens.First is "Names"
	Naming.Header(Lines, 0).tokens.Length is 0
	Coupling.Split(Early, Scope(("Made", "Made"), ("Couple(Number, Number)", "Couple(Text, Number)")), Making) is ""
	for Range(0, line).Reverse
		if lines(value).StartsWith("\t") is false
			return HeaderTokens(Tokenizer(lines(value)).Tokens)
	HeaderTokens(List(Text))
Unresulted(scoped ScopedStatement, current Scope, lines Texts) Text
	Naming.Unresulted(Tail, Drawers, Counting) is Unvalued
	Naming.Unresulted(Unreturning, Drawers, Counting) is Unvalued
	Naming.Unresulted(Branched, Drawers, Counting) is Unvalued
	Naming.Unresulted(Assigned, Drawers, Running) is ""
	Naming.Unresulted(Argued, Drawers, Running) is Unvalued
	(Naming.Unresulted(Tail, Drawers, Running) + Naming.Unresulted(Compared, Drawers, Counting)) is ""
	Naming.Unresulted(Unreturning, Drawers, Running) is ""
	Naming.Unresulted(ScopedStatement(Tail.statement, Dropped, 1), Drawers, Counting) is ""
	let isReturning = Declared(lines, scoped.line) is not "None"
	let isValue = isReturning and ((scoped.statement.Kind is "Return") or IsTail(scoped, lines))
	let names = Resultless(scoped.statement, isValue, scoped.scope, current)
	names.Length is 0 then "" else "ReturnTypeMismatch: " + names.First + " has no return type, its call gives no value"
Resultless(node SyntaxNode, isValue Boolean, scope Scope, current Scope) Texts
	Naming.Resultless(Branched.statement, false, Named, Drawers) is (List(Text) + "Drawn")
	Naming.Resultless(Valued, true, Named, Drawers).Length is 0
	Naming.Resultless(SyntaxNode("Ignore", "ignore", List(SyntaxNode) + Tail.statement), false, Named, Drawers).Length is 0
	Naming.Resultless(SyntaxParser(Tokenizer("Drawn(1) + 1").Tokens).Parse, true, Named, Drawers) is (List(Text) + "Drawn")
	let isCall = (node.Kind is in Calls) and (scope.TypeOf(node.text) is "")
	if isValue and isCall and (inference.TypeOf(node, scope, current) is "None")
		return List(Text) + node.text
	if node.text.StartsWith("is") or (node.Kind is "Body")
		return List(Text)
	mutable names = List(Mutable(Text))
	for node.children
		names = names + Resultless(value, isValue or (node.Kind is not in Keeping), scope, current)
	names
IsTail(scoped ScopedStatement, lines Texts) Boolean
	Naming.IsTail(Tail, Counting)
	Naming.IsTail(Argued, Counting) is false
	Naming.Resultless(SyntaxNode("Body", "", List(SyntaxNode) + Tail.statement), true, Named, Drawers).Length is 0
	Naming.Resultless(SyntaxNode("Identifier", "shot"), true, Scope(("shot"), ("None")), Drawers).Length is 0
	(scoped.scope.TypeOf(" dropped") is "") and (lines(scoped.line).StartsWith("\t\t") is false)
