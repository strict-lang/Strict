has logger
Run(folder Text)
	mutable mismatches = 0
	for Directory.Files(folder, "*.strict")
		mismatches = mismatches + CheckFile(value)
	logger.Log("Round trip mismatches: " + mismatches)
CheckFile(path Text) Number
	let shape = TypeShape(File(path).ReadLines)
	mutable mismatches = 0
	for shape.lines
		if shape.IsMethodHeader(value)
			mismatches = mismatches + CheckBody(shape.lines, index + 1, path)
	mismatches
CheckBody(lines Texts, start Number, path Text) Number
	CheckBody(("Run", "\tif a + b * c", "\t\tlet x = (1, 2)"), 1, "test") is 0
	mutable mismatches = 0
	for BodyParser(lines).Block(start, 1).Lines("\t")
		if value is not lines(start + index)
			logger.Log(path + ": " + lines(start + index) + " => " + value)
			mismatches = mismatches + 1
	mismatches