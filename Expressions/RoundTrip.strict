has logger
Run(folder Text)
	mutable mismatches = 0
	for Directory.Files(folder, "*.strict")
		mismatches = mismatches + CheckFile(value)
	logger.Log("Round trip mismatches: " + mismatches)
CheckFile(path Text) Number
	let shape = TypeShape(File(path).ReadLines)
	mutable mismatches = 0
	for shape.lines
		if shape.IsMethodHeader(value)
			mismatches = mismatches + CheckBody(shape.lines, index + 1, path)
	mismatches
CheckBody(lines Texts, start Number, path Text) Number
	CheckBody(("Run", "\tif a + b * c", "\t\tlet x = (1, 2)"), 1, "test") is 0
	mutable mismatches = 0
	for BodyParser(lines).Block(start, 1).Lines("\t")
		if value is not lines(start + index)
			logger.Log(path + ": " + lines(start + index) + " => " + value)
			mismatches = mismatches + 1
	mismatches
Formatted(lines Texts) Texts
	RoundTrip.Formatted(("Run", "	let x=(1,2)")) is ("Run", "	let x = (1, 2)")
	RoundTrip.Formatted(("has number ", "Twice Number", "	number*2")) is ("has number", "Twice Number", "	number * 2")
	let shape = TypeShape(lines)
	mutable formatted = List(Mutable(Text))
	for lines
		if value.StartsWith("	") is false
			formatted.Add(value.Trim)
			if shape.IsMethodHeader(value)
				formatted = formatted + BodyParser(lines).Block(index + 1, 1).Lines("	")
	formatted
Tabbed(lines Texts) Texts
	RoundTrip.Tabbed(("Run", "    1")) is ("Run", "\t1")
	for lines
		Indented(value)
Indented(line Text) Text
	RoundTrip.Indented("    a") is "\ta"
	RoundTrip.Indented("\t      b") is "\t\t\tb"
	RoundTrip.Indented("a  b") is "a  b"
	if line.StartsWith("\t")
		return "\t" + Indented(line.Substring(1, line.Length - 1))
	if line.StartsWith(" ") is false
		return line
	let wide = line.StartsWith("    ") then 4 else (line.StartsWith("   ") then 3 else 2)
	let spaces = line.StartsWith("  ") then wide else 1
	"\t" + Indented(line.Substring(spaces, line.Length - spaces))