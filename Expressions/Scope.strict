has names Texts
has types Texts
has positions Dictionary(Text, Number) = Dictionary(Text, Number)
has indexed Number = 0
has owner Text = ""
With(name Text, type Text) Scope
	Scope(("a", "b"), ("A", "B")).With("c", "C").TypeOf("c") is "C"
	Scope(names + name, types + type, positions, indexed, owner)
WithAll(otherNames Texts, otherTypes Texts) Scope
	Scope(("a", "b"), ("A", "B")).WithAll(("c", "d"), ("C", "D")).TypeOf("d") is "D"
	Scope(names + otherNames, types + otherTypes, positions, indexed, owner)
TypeOf(name Text) Text
	Scope(("a", "b"), ("A", "B")).TypeOf("b") is "B"
	Scope(("a", "b"), ("A", "B")).TypeOf("c") is ""
	Scope(("a", "a"), ("A", "B")).TypeOf("a") is "B"
	for names.Length - indexed
		let position = names.Length - 1 - index
		if names(position) is name
			return types(position)
	name is in positions then types(positions(name)) else ""
Has(name Text, type Text) Boolean
	Scope(("to", "to"), ("A", "B")).Has("to", "A")
	Scope(("to", "to"), ("A", "B")).Has("to", "C") is false
	for names
		if (value is name) and (types(index) is type)
			return true
	false
Count(name Text) Number
	Scope(("a", "b", "a"), ("A", "B", "C")).Count("a") is 2
	for names
		if value is name
			1
TypeAt(name Text, ordinal Number) Text
	Scope(("a", "b", "a"), ("A", "B", "C")).TypeAt("a", 1) is "C"
	Scope(("a", "b"), ("A", "B")).TypeAt("a", 1) is ""
	let position = Position(name, ordinal)
	position < 0 then "" else types(position)
Position(name Text, ordinal Number) Number
	Scope(("a", "b", "a"), ("A", "B", "C")).Position("a", 1) is 2
	Scope(("a", "b"), ("A", "B")).Position("a", 1) is -1
	mutable found = -1
	for names
		if value is name
			found = found + 1
			if found is ordinal
				return index
	-1
Indexed Scope
	Scope(("a", "b", "a"), ("A", "B", "C")).Indexed.indexed is 3
	Scope(("a", "b", "a"), ("A", "B", "C")).Indexed.TypeOf("a") is "C"
	Scope(("a", "b"), ("A", "B")).Indexed.With("a", "D").TypeOf("a") is "D"
	Scope(("a", "b"), ("A", "B")).Indexed.WithAll(("c", "d"), ("C", "D")).TypeOf("b") is "B"
	mutable named = Dictionary(Text, Number)
	for names
		named(value) = index
	Scope(names, types, named, names.Length, owner)
Owned(typeName Text) Scope
	Scope(("a"), ("A")).Owned("T").Indexed.With("b", "B").owner is "T"
	Scope(names, types, positions, indexed, typeName)