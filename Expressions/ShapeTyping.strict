has inference TypeInference
constant NoScope = Scope(List(Text), List(Text))
constant Chained = ShapeTyping(TypeInference(KnownTypes(("Box", "Item"), (KnownTypes.NoMembers, KnownTypes.NoMembers), (Scope(List(Text) + "Inner", List(Text) + "Item"), Scope(List(Text) + "Weight", List(Text) + "Number")), (KnownTypes.NoMembers, KnownTypes.NoMembers)), (Scope(List(Text) + "Sample", List(Text) + "Box(3).Inner"), KnownTypes.NoMembers)))
constant Counting = ShapeTyping(ResolveCheck.Counting)
constant Twice = TypeShape("Twice = number * 2")
constant Next = Tokenizer("Next(add = 1) = number + add").Tokens
constant Boxed = ShapeTyping(TypeInference(KnownTypes(("Box", "Item"), (KnownTypes.NoMembers, KnownTypes.NoMembers), (Scope(("Sample", "Inner"), ("Box", "Item")), KnownTypes.NoMembers), (KnownTypes.NoMembers, KnownTypes.NoMembers)), (Scope(List(Text) + "Sample", List(Text) + "Box(3).Inner"), KnownTypes.NoMembers)))
Typed(shape TypeShape, scope Scope, typeName Text) Scope
	Counting.Typed(TypeShape("constant a = 1"), KnownTypes.NoMembers, "Count").names.Length is 0
	Counting.Typed(Twice, KnownTypes.NoMembers, "Count").TypeOf("Twice") is "Number"
	mutable result = scope
	for shape.lines
		let tokens = Tokenizer(value).Tokens
		if value.StartsWith("constant ")
			result = Refined(result, tokens(1), ChainType(tokens, typeName, result))
		else if shape.IsComputed(value)
			result = result.With(tokens(0), ComputedType(tokens, typeName, result))
		else if shape.IsMethodHeader(value)
			result = Known(result, tokens(0), Instantiation(inference.types).Template(shape, index, typeName))
	result
Refined(scope Scope, name Text, type Text) Scope
	Counting.Refined(Scope(List(Text) + "a", List(Text) + "Box"), "a", "Item").names.Length is 1
	Counting.Refined(Scope(List(Text) + "a", List(Text) + "Box"), "a", "Item").TypeOf("a") is "Item"
	Counting.Refined(KnownTypes.NoMembers, "a", "Item").TypeOf("a") is "Item"
	if (type is "") or (scope.Count(name) is 0)
		return Known(scope, name, type)
	mutable types = scope.types
	for scope.names
		if value is name
			types(index) = type
	Scope(scope.names, types)
Known(scope Scope, name Text, type Text) Scope
	Counting.Known(KnownTypes.NoMembers, "a", "").names.Length is 0
	Counting.Known(KnownTypes.NoMembers, "a", "Number").TypeOf("a") is "Number"
	type is "" then scope else scope.With(name, type)
ChainType(tokens Texts, typeName Text, known Scope) Text
	Counting.ChainType(Tokenizer("constant a = Count(1).Twice(2)").Tokens, "Count", KnownTypes.NoMembers) is "Count"
	Counting.ChainType(Tokenizer("constant a = 1").Tokens, "Count", KnownTypes.NoMembers) is ""
	Counting.ChainType(Tokenizer("constant a = Twice(2)").Tokens, "Count", KnownTypes.NoMembers) is "Count"
	Counting.ChainType(Tokenizer("constant a = List(Number) + 3").Tokens, "Count", KnownTypes.NoMembers) is "Numbers"
	Counting.ChainType(Tokenizer("constant b = a.Twice(2)").Tokens, "C", NoScope.With("a", "Count")) is "Count"
	if (tokens.Length < 4) or (tokens(2) is not "=")
		return ""
	let node = SyntaxParser(tokens).ParseRange(3, tokens.Length)
	if node.Kind is in ("Call", "Identifier")
		return inference.types.MethodsOf(typeName).TypeOf(node.text)
	let isInferred = node.Kind is in ("MethodCall", "Member", "Binary", "List")
	isInferred then Inferred(node, typeName, known) else ""
Inferred(node SyntaxNode, typeName Text, known Scope) Text
	Boxed.Inferred(SyntaxParser(Tokenizer("Box.Sample").Tokens).Parse, "User", KnownTypes.NoMembers) is "Item"
	Chained.Inferred(SyntaxParser(Tokenizer("Box.Sample.Weight").Tokens).Parse, "User", KnownTypes.NoMembers) is "Number"
	let owner = node.Kind is "Member" then node.children(0).text else ""
	let aliased = owner is "" then "" else inference.ConstantOf(owner, node.text)
	let chained = aliased is "" then "" else ChainType(Tokenizer("constant a = " + aliased).Tokens, owner, NoScope)
	let current = inference.types.ShapeScope(typeName).WithAll(known.names, known.types)
	chained is "" then inference.TypeOf(Expanded(node), NoScope, current) else chained
Expanded(node SyntaxNode) SyntaxNode
	Chained.Expanded(SyntaxParser(Tokenizer("Box.Sample").Tokens).Parse) is SyntaxNode("Type", "Item")
	let owner = (node.Kind is "Member") and (node.children(0).Kind is "Identifier") then node.children(0).text else ""
	let definition = inference.types.IsKnown(owner) then inference.ConstantOf(owner, node.text) else ""
	let typed = definition is "" then "" else ChainType(Tokenizer("constant a = " + definition).Tokens, owner, NoScope)
	if typed is not ""
		return SyntaxNode("Type", typed)
	mutable children = List(Mutable(SyntaxNode))
	for node.children
		children.Add(Expanded(value))
	SyntaxNode(node.Kind, node.text, children, node.line)
ComputedType(tokens Texts, typeName Text, methods Scope) Text
	Counting.ComputedType(Next, "Count", KnownTypes.NoMembers) is "Number"
	let header = HeaderTokens(tokens)
	let node = SyntaxParser(tokens).ParseRange(header.ParametersEnd + 2, tokens.Length)
	let current = inference.types.ShapeScope(typeName).WithAll(methods.names, methods.types)
	inference.TypeOf(node, Scope(header.ParameterNames, header.ParameterTypes), current)