has input Text
Tokens Texts
	ShuntingYard("a").Tokens is ("a")
	ShuntingYard("a + b").Tokens is ("a", "+", "b")
	input.Split(" ")
OperatorPrecedence(token Text) Number
	OperatorPrecedence("+") is 1
	OperatorPrecedence("*") is 2
	OperatorPrecedence("and") is 3
	OperatorPrecedence("a") is 0
	ArithmeticPrecedence(token)
ArithmeticPrecedence(token Text) Number
	ArithmeticPrecedence("+") is 1
	ArithmeticPrecedence("-") is 1
	ArithmeticPrecedence("*") is 2
	ArithmeticPrecedence("/") is 2
	ArithmeticPrecedence("and") is 3
	if (token is "+") or (token is "-")
		return 1
	if (token is "*") or (token is "/")
		return 2
	LogicalPrecedence(token)
LogicalPrecedence(token Text) Number
	LogicalPrecedence("and") is 3
	LogicalPrecedence("or") is 3
	LogicalPrecedence("xor") is 3
	LogicalPrecedence("+") is 0
	if (token is "and") or (token is "or") or (token is "xor")
		return 3
	0
IsOperator(token Text) Boolean
	IsOperator("+")
	IsOperator("and")
	IsOperator("a") is false
	OperatorPrecedence(token) > 0
OperandTokens Texts
	ShuntingYard("a").OperandTokens is ("a")
	ShuntingYard("a + b").OperandTokens is ("a", "b")
	ShuntingYard("a * b + c").OperandTokens is ("a", "b", "c")
	mutable operands = List(Mutable(Text))
	for Tokens
		if not IsOperator(value)
			operands.Add(value)
	operands
OperatorTokens Texts
	ShuntingYard("a").OperatorTokens.Length is 0
	ShuntingYard("a + b").OperatorTokens is ("+")
	ShuntingYard("a * b + c").OperatorTokens is ("*", "+")
	mutable ops = List(Mutable(Text))
	for Tokens
		if IsOperator(value)
			ops.Add(value)
	ops
Postfix Texts
	ShuntingYard("a").Postfix is ("a")
	ShuntingYard("a + b").Postfix is ("a", "b", "+")
	ShuntingYard("a + b * c").Postfix is ("a", "b", "c", "*", "+")
	ShuntingYard("a * b + c").Postfix is ("a", "b", "*", "c", "+")
	ShuntingYard("a + b - c").Postfix is ("a", "b", "+", "c", "-")
	mutable output = List(Mutable(Text))
	mutable operators = List(Mutable(Text))
	for Tokens
		output = output + Emitted(operators, value)
		if IsOperator(value)
			operators = (List(Text) + value) + Kept(operators, value)
	output + operators
Emitted(operators Texts, token Text) Texts
	ShuntingYard("").Emitted(("*", "+"), "a") is ("a")
	ShuntingYard("").Emitted(("*", "+"), "-") is ("*", "+")
	ShuntingYard("").Emitted(("+"), "*").Length is 0
	if IsOperator(token) is false
		return List(Text) + token
	for operators
		if OperatorPrecedence(value) >= OperatorPrecedence(token)
			value
Kept(operators Texts, token Text) Texts
	ShuntingYard("").Kept(("*", "+"), "-").Length is 0
	ShuntingYard("").Kept(("+"), "*") is ("+")
	for operators
		if OperatorPrecedence(value) < OperatorPrecedence(token)
			value
to Text
	input