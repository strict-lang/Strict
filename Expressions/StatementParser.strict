has tokens Texts
constant ForProblem = "ForWithBodyOnlyAsMethodResult: "
constant ForHint = ", a for with a body can only be the last line of a method, move it into one"
constant Starters = ("return", "if", "for", "else")
constant IgnoreProblem = "IgnoreMustWrapOneExpression: "
constant IgnoreHint = ", write ignore(expression) to call it and drop its result and Error"
constant SingleHint = ", a single iterator is value: for list instead of for x in list"
constant MatchHint = ", name each iterator once: for y, x in Height, Width or for width, height in sizes"
constant Mismatched = StatementParser(Tokenizer("for a, b, c in x, y").Tokens)
constant Unlisted = StatementParser(Tokenizer("for a, b in").Tokens)
Syntax SyntaxParser
	StatementParser("a", "b").Syntax.tokens.Length is 2
	StatementParser(Tokenizer("for list").Tokens).Keyword("for") to Text is "for list"
	StatementParser(Tokenizer("if as long as a").Tokens).Keyword("if").Kind is "If"
	StatementParser(Tokenizer("for as long x a").Tokens).Keyword("for").text is not "for as long as"
	StatementParser(Tokenizer("for x long as a").Tokens).Keyword("for").text is not "for as long as"
	StatementParser(Tokenizer("for as x as a").Tokens).Keyword("for").text is not "for as long as"
	SyntaxParser(tokens)
ParseStatement SyntaxNode
	StatementParser(Tokenizer("let a = b + 1").Tokens).ParseStatement to Text is "let a = b + 1"
	StatementParser(Tokenizer("x.y = 2").Tokens).ParseStatement to Text is "x.y = 2"
	StatementParser(Tokenizer("return a then b else c").Tokens).ParseStatement to Text is "return a then b else c"
	StatementParser(Tokenizer("else if a is 1").Tokens).ParseStatement to Text is "else if a is 1"
	StatementParser(Tokenizer("for as long as a").Tokens).ParseStatement to Text is "for as long as a"
	StatementParser(Tokenizer("let a = for b").Tokens).ParseStatement.Kind is "Invalid"
	let first = tokens(0)
	if first is in ("let", "constant", "mutable")
		let declared = SyntaxNode("Declaration", first + " " + tokens(1), Rest(3))
		let isLooped = (tokens.Length > 3) and (tokens(3) is "for")
		return isLooped then SyntaxNode("Invalid", ForProblem + declared + ForHint) else declared
	first is "ignore" then Ignored else first is in Starters then Keyword(first) else ParseAssignmentOrExpression
Ignored SyntaxNode
	StatementParser(Tokenizer("ignore(File.Delete(name))").Tokens).ParseStatement to Text is "ignore(File.Delete(name))"
	StatementParser(Tokenizer("ignore(Run)").Tokens).ParseStatement.Kind is "Ignore"
	StatementParser(Tokenizer("ignore Run").Tokens).Ignored to Text is IgnoreProblem + "ignore Run" + IgnoreHint
	StatementParser(Tokenizer("ignore(a) + 1").Tokens).Ignored.Kind is "Invalid"
	StatementParser(Tokenizer("ignore(a, b)").Tokens).Ignored.Kind is "Invalid"
	StatementParser(Tokenizer("ignore.Length").Tokens).Ignored.Kind is "Invalid"
	let call = Syntax.ParseRange(0, tokens.Length)
	let isWrapped = (call.text is "ignore") and (call.children.Length is 1) and (call.children(0).Kind is not "Missing")
	let problem = IgnoreProblem + Text.Combine(tokens, " ") + IgnoreHint
	isWrapped then SyntaxNode("Ignore", "ignore", call.children) else SyntaxNode("Invalid", problem)
Keyword(first Text) SyntaxNode
	StatementParser(Tokenizer("for as long as a").Tokens).Keyword("for").text is "for as long as"
	StatementParser("return").Keyword("return").Kind is "Return"
	StatementParser(Tokenizer("for y, x in Range(0, 2), 3").Tokens).Keyword("for") to Text is "for y, x in Range(0, 2), 3"
	StatementParser("return").Keyword("return").text is "return"
	if first is "else"
		return ParseElse
	if tokens.Length is 1
		return SyntaxNode(first.Capitalize, first)
	if ((first is "for") and (tokens.Length > 4) and (tokens(1) is "as") and (tokens(3) is "as")) and (tokens(2) is "long")
		return SyntaxNode("For", "for as long as", Rest(4))
	IsNamed then Named else SyntaxNode(first.Capitalize, "", Rest(1))
IsNamed Boolean
	StatementParser(Tokenizer("for y, x in 2, 3").Tokens).IsNamed
	StatementParser(Tokenizer("for x in list").Tokens).IsNamed
	StatementParser(Tokenizer("for list").Tokens).IsNamed is false
	StatementParser(Tokenizer("for a, b").Tokens).IsNamed is false
	StatementParser(Tokenizer("if a, b in c").Tokens).IsNamed is false
	StatementParser(Tokenizer("for x is in list").Tokens).IsNamed is false
	StatementParser(Tokenizer("for x in").Tokens).IsNamed is false
	(tokens.Length > 3) and (tokens(0) is "for") and (tokens(2) is in (",", "in")) and ("in" is in tokens)
Named SyntaxNode
	StatementParser(Tokenizer("for y, x in Range(0, 2), 3").Tokens).Named.children.Length is 2
	StatementParser(Tokenizer("for a, b in ((1, 2), (3, 4))").Tokens).Named.children.Length is 1
	StatementParser(Tokenizer("for x in list").Tokens).Named to Text is "SingleIteratorMustNotBeNamed: x" + SingleHint
	Mismatched.Named to Text is "IteratorNamesMustMatchIterators: a, b, c" + MatchHint
	let iterables = Syntax.Parts(tokens.Index("in") + 1, tokens.Length)
	let problem = NamedProblem(iterables.Length)
	if problem is not ""
		return SyntaxNode("Invalid", problem)
	SyntaxNode("For", "for " + Text.Combine(IteratorNames) + " in", iterables)
NamedProblem(count Number) Text
	Mismatched.NamedProblem(2) is "IteratorNamesMustMatchIterators: a, b, c" + MatchHint
	Unlisted.NamedProblem(0) is "IteratorNamesMustMatchIterators: a, b" + MatchHint
	StatementParser(Tokenizer("for 1, b in x").Tokens).NamedProblem(1) is "IteratorNameMustStartLowercase: 1"
	StatementParser(Tokenizer("for a, b in x").Tokens).NamedProblem(1) is ""
	if IteratorNames.Length < 2
		return "SingleIteratorMustNotBeNamed: " + Text.Combine(IteratorNames) + SingleHint
	if Unnamed is not ""
		return "IteratorNameMustStartLowercase: " + Unnamed
	let mismatch = "IteratorNamesMustMatchIterators: " + Text.Combine(IteratorNames) + MatchHint
	(count is 1) or (count is IteratorNames.Length) then "" else mismatch
Unnamed Text
	StatementParser(Tokenizer("for a, B in x").Tokens).Unnamed is "B"
	StatementParser(Tokenizer("for a, (b) in x").Tokens).Unnamed is "("
	StatementParser(Tokenizer("for a, b in x").Tokens).Unnamed is ""
	for IteratorNames
		let first = value(0)
		if first.Upper is first
			return value
	""
IteratorNames Texts
	StatementParser(Tokenizer("for y, x in 2, 3").Tokens).IteratorNames is ("y", "x")
	StatementParser(Tokenizer("for y, x in").Tokens).IteratorNames is ("y", "x")
	tokens.Slice(1, tokens.Index("in") - 1) - ","
Rest(start Number) SyntaxNodes
	StatementParser("return", "1").Rest(1).Length is 1
	Syntax.Single(Syntax.ParseRange(start, tokens.Length))
ParseElse SyntaxNode
	StatementParser(Tokenizer("else").Tokens).ParseElse.Kind is "Else"
	StatementParser("else", "if", "a").ParseElse.Kind is "ElseIf"
	StatementParser("else", "0").ParseElse.Kind is "ElseValue"
	StatementParser(Tokenizer("else").Tokens).ParseElse.text is "else"
	if tokens.Length is 1
		return SyntaxNode("Else", "else")
	tokens(1) is "if" then SyntaxNode("ElseIf", "", Rest(2)) else SyntaxNode("ElseValue", "", Rest(1))
ParseAssignmentOrExpression SyntaxNode
	StatementParser("a", "=", "1").ParseAssignmentOrExpression.Kind is "Reassignment"
	StatementParser(Tokenizer("a").Tokens).ParseAssignmentOrExpression.Kind is "Identifier"
	StatementParser(Tokenizer("next(add = 1) = add").Tokens).ParseAssignmentOrExpression to Text is "next(add = 1) = add"
	StatementParser(Tokenizer("next(add = 1) = add").Tokens).ParseAssignmentOrExpression.Kind is "Computed"
	constant assignment = AssignmentIndex
	if assignment is -1
		return Syntax.Parse
	let assigned = Syntax.ParseRange(assignment + 1, tokens.Length)
	if tokens.Index("=") < assignment
		return SyntaxNode("Computed", tokens(0), (Signature(assignment), assigned))
	SyntaxNode("Reassignment", "", (Syntax.ParseRange(0, assignment), assigned))
Signature(assignment Number) SyntaxNode
	StatementParser(Tokenizer("f(a, b = (1, 2)) = a").Tokens).Signature(12) to Text is "f(a, b = (1, 2))"
	SyntaxNode("Call", tokens(0), Syntax.Parts(2, assignment - 1))
AssignmentIndex Number
	StatementParser("a", "=", "1").AssignmentIndex is 1
	StatementParser("f", "(", "a", ")").AssignmentIndex is -1
	StatementParser(Tokenizer("f(a = 1)").Tokens).AssignmentIndex is -1
	mutable depth = 0
	mutable assignment = -1
	for tokens
		depth = depth + Syntax.BracketDelta(value)
		if (depth is 0) and (value is "=")
			assignment = index
	assignment
Problem(line Text) Text
	StatementParser.Problem("constant Help = (\"first") is "TextMustEndOnItsLine: constant Help = (\"first"
	StatementParser.Problem("for x in list") is "SingleIteratorMustNotBeNamed: x" + SingleHint
	StatementParser.Problem("x = for y") is ForProblem + "x = for y" + ForHint
	StatementParser.Problem("a") is "ParsingFailed: a"
	StatementParser.Problem("let b = \"a = for b\" + for") is "ParsingFailed: let b = \"a = for b\" + for"
	let words = Tokenizer(line).Tokens
	if (words.Index("for") > 0) and (words(words.Index("for") - 1) is "=")
		return ForProblem + line + ForHint
	let statement = StatementParser(words).ParseStatement
	if statement.Kind is "Invalid"
		return statement.text
	(Tokenizer(line).HasOpenText then "TextMustEndOnItsLine: " else "ParsingFailed: ") + line