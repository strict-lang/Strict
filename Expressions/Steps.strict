has tokens Texts
constant SecondStep = Steps(Tokenizer("B(a Number, b Number with Step 0.5)").Tokens)
constant Rounded = ("has price Number with Step 0.01", "T(a Number) Number with Step 0.5", "	L(a Numbers with Step 1)")
constant NotNumber = "A:line 1: StepMustBeOnNumber: Numbers, only a Number is rounded to its step"
constant Mixed = Steps(Tokenizer("B(a Number with Step 0.5, b List(Number) with Step 0.5)").Tokens)
Of(nameIndex Number) Text
	Steps(Tokenizer("has price Number with Step 0.01").Tokens).Of(1) is "0.01" and SecondStep.Of(2) is ""
	Steps(Tokenizer("has lot Number with Step 0.001 Floor").Tokens).Of(1) is "0.001 Floor"
	Steps(Tokenizer("has width Number with value > 0").Tokens).Of(1) is "" and SecondStep.Of(5) is "0.5"
	Steps(Tokenizer("has iterator").Tokens).Of(1) is "" and Steps(Tokenizer("has a Number Step 0.5").Tokens).Of(1) is ""
	for Range(nameIndex + 1, tokens.Length - 2 > nameIndex then tokens.Length - 2 else nameIndex + 1)
		if tokens(value) is in (",", ")")
			return ""
		if tokens(value) is "with" and tokens(value + 1) is "Step"
			isRounding = value + 3 < tokens.Length and tokens(value + 3) is in ("Floor", "Ceiling")
			return tokens(value + 2) + (isRounding then " " + tokens(value + 3) else "")
	""
Entries(header HeaderTokens) Scope
	Steps(List(Text)).Entries(HeaderTokens(Tokenizer("B(a Number with Step 0.5)").Tokens)).TypeOf("B a step") is "0.5"
	Steps(List(Text)).Entries(HeaderTokens(SecondStep.tokens)).names is ("B b step")
	Steps(List(Text)).Entries(HeaderTokens(Tokenizer("B(a Number) Number with Step 0.5").Tokens)).TypeOf("B step") is "0.5"
	Steps(List(Text)).Members(("has maxStep Number", "Run(a Number with Step 0.5)")).names.Length is 0
	name = header.tokens(0)
	mutable entries = Scope(List(Text), List(Text))
	for "Step" is in header.tokens then header.ParameterNames else List(Text)
		step = Steps(header.tokens).Of(header.ParameterPosition(value))
		if step is not ""
			entries = entries.With(name + " " + value + " step", step)
	returned = "Step" is in header.tokens then Steps(header.tokens).Of(header.ParametersEnd) else ""
	returned is "" then entries else entries.With(name + " step", returned)
Members(lines Texts) Scope
	Steps(List(Text)).Members(("has price Number with Step 0.01", "has count Number")).TypeOf("price step") is "0.01"
	mutable names = List(Mutable(Text))
	mutable types = List(Mutable(Text))
	for lines
		if TypeShape(lines).IsMemberLine(value)
			step = value.IndexOf("Step") > 0 then Steps(Tokenizer(value).Tokens).Of(1) else ""
			if step is not ""
				names.Add(HeaderTokens(Tokenizer(value).Tokens).MemberName + " step")
				types.Add(step)
	Scope(names, types)
CheckNumbering(path Text, lines Texts) Texts
	Steps(List(Text)).CheckNumbering("A", Rounded).Length is 0
	Steps(List(Text)).CheckNumbering("A", List(Text) + "has a Numbers with Step 1") is (NotNumber)
	for lines
		type = value.StartsWith("	") then "" else Steps(Tokenizer(value).Tokens).Unrounded
		if type is not ""
			ResolveCheck.Locate(path, index + 1, "StepMustBeOnNumber: " + type + ", only a Number is rounded to its step")
Unrounded Text
	Mixed.Unrounded is ")"
	Steps(Tokenizer("has a Numbers Step 1").Tokens).Unrounded is ""
	Steps(Tokenizer("has a Numbers with value > 0").Tokens).Unrounded is ""
	Steps(Tokenizer("has a Text = \"b with Step 1\"").Tokens).Unrounded is ""
	Steps(("with", "Step")).Unrounded is ""
	for tokens
		if value is "Step" and index > 1
			if tokens(index - 1) is "with" and tokens(index - 2) is not "Number"
				return tokens(index - 2)
	""