has tokens Texts
constant SecondStep = Steps(Tokenizer("B(a Number, b Number with Step 0.5)").Tokens)
Of(nameIndex Number) Text
	Steps(Tokenizer("has price Number with Step 0.01").Tokens).Of(1) is "0.01" and (SecondStep.Of(2) is "")
	Steps(Tokenizer("has lot Number with Step 0.001 Floor").Tokens).Of(1) is "0.001 Floor"
	Steps(Tokenizer("has width Number with value > 0").Tokens).Of(1) is "" and (SecondStep.Of(5) is "0.5")
	Steps(Tokenizer("has iterator").Tokens).Of(1) is "" and (Steps(Tokenizer("has a Number Step 0.5").Tokens).Of(1) is "")
	for Range(nameIndex + 1, tokens.Length - 2 > nameIndex then tokens.Length - 2 else nameIndex + 1)
		if tokens(value) is in (",", ")")
			return ""
		if (tokens(value) is "with") and (tokens(value + 1) is "Step")
			let isRounding = (value + 3 < tokens.Length) and (tokens(value + 3) is in ("Floor", "Ceiling"))
			return tokens(value + 2) + (isRounding then " " + tokens(value + 3) else "")
	""
Entries(header HeaderTokens) Scope
	Steps(List(Text)).Entries(HeaderTokens(Tokenizer("B(a Number with Step 0.5)").Tokens)).TypeOf("B a step") is "0.5"
	Steps(List(Text)).Entries(HeaderTokens(SecondStep.tokens)).names is ("B b step")
	Steps(List(Text)).Entries(HeaderTokens(Tokenizer("B(a Number) Number with Step 0.5").Tokens)).TypeOf("B step") is "0.5"
	Steps(List(Text)).Members(("has maxStep Number", "Run(a Number with Step 0.5)")).names.Length is 0
	let name = header.tokens(0)
	mutable entries = Scope(List(Text), List(Text))
	for header.ParameterNames
		let step = Steps(header.tokens).Of(header.ParameterPosition(value))
		if step is not ""
			entries = entries.With(name + " " + value + " step", step)
	let returned = Steps(header.tokens).Of(header.ParametersEnd)
	returned is "" then entries else entries.With(name + " step", returned)
Members(lines Texts) Scope
	Steps(List(Text)).Members(("has price Number with Step 0.01", "has count Number")).TypeOf("price step") is "0.01"
	mutable names = List(Mutable(Text))
	mutable types = List(Mutable(Text))
	for lines
		if TypeShape(lines).IsMemberLine(value) and (value.IndexOf("Step") > 0)
			let line = Tokenizer(value).Tokens
			let step = Steps(line).Of(1)
			if step is not ""
				names.Add(HeaderTokens(line).MemberName + " step")
				types.Add(step)
	Scope(names, types)
