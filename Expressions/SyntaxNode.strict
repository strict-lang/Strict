has Kind Text
has text
has children SyntaxNodes
has line Number = 0
constant operators = ("then", "else", "is", "is in", "is not", "is not in", "or", "xor", "and", "<", ">", "<=", ">=", "in", "+", "-", "%", "*", "/", "^", "to")
constant precedences = (1, 1, 7, 7, 7, 7, 4, 5, 6, 7, 7, 7, 7, 9, 11, 11, 13, 13, 13, 14, 20)
constant AdditivePrecedence = 11
constant ArithmeticPrecedences = Range(AdditivePrecedence, 20)
constant MemberPrecedence = 21
constant keywordKinds = ("Return", "If", "For", "ElseIf", "ElseValue")
constant keywordTexts = ("return", "if", "for", "else if", "else")
constant one = SyntaxNode("Number", "1")
constant two = SyntaxNode("Number", "2")
constant sum = SyntaxNode("Binary", "+", (one, two))
constant identifier = SyntaxNode("Identifier", "a")
constant missing = SyntaxNode("Missing", "")
constant nested = SyntaxNode("Body", "", List(SyntaxNode) + SyntaxNode("If", "if", (SyntaxNode("Identifier", "a"), SyntaxNode("Body", "", List(SyntaxNode) + SyntaxNode("Number", "1")))))
Precedence Number
	SyntaxNode("Binary", "+").Precedence is 11
	SyntaxNode("Binary", "is not").Precedence is 7
	SyntaxNode("Number", "1").Precedence is 0
	SyntaxNode("Binary", "x").Precedence is 0
	SyntaxNode("Not", "").Precedence is 3 and (SyntaxNode("Number", "+").Precedence is 0)
	if Kind is "Not"
		return 3
	Kind is not "Binary" or text is not in operators then 0 else precedences(operators.Index(text))
to Text
	SyntaxNode("Number", "1") to Text is "1"
	SyntaxNode("Binary", "+", (SyntaxNode("Number", "1"), SyntaxNode("Number", "2"))) to Text is "1 + 2"
	SyntaxNode("List", "", (SyntaxNode("Number", "1"), SyntaxNode("Number", "2"))) to Text is "(1, 2)"
	SyntaxNode("Reassignment", "", (identifier, one)) to Text is "a = 1"
	SyntaxNode("Identifier", "a", (one, one)) to Text is "a"
	Kind is "Binary" then BinaryText else Kind is "List" then "(" + ArgumentsText(0) + ")" else CallText
BinaryText Text
	SyntaxNode("Binary", "*", (SyntaxNode("Missing", ""), SyntaxNode("Number", "2"))).BinaryText is "* 2"
	SyntaxNode("Binary", "-", (one, SyntaxNode("Binary", "-", (one, two)))).BinaryText is "1 - (1 - 2)"
	SyntaxNode("Binary", "*", (missing, missing)).BinaryText is "*"
	SyntaxNode("Binary", "*", (one, missing)).BinaryText is "1 *"
	SyntaxNode("Binary", "*", (sum, two)).BinaryText is "(1 + 2) * 2"
	constant left = ChildText(0, Precedence)
	constant right = ChildText(1, Precedence + 1)
	if left is ""
		return right is "" then text else text + " " + right
	right is "" then left + " " + text else left + " " + text + " " + right
CallText Text
	SyntaxNode("Call", "Add", (SyntaxNode("Number", "1"), SyntaxNode("Number", "2"))).CallText is "Add(1, 2)"
	SyntaxNode("Member", "Length", (SyntaxNode("Identifier", "x"), SyntaxNode("Identifier", "x"))).CallText is "x.Length"
	SyntaxNode("MethodCall", "Add", (identifier, one, two)).CallText is "a.Add(1, 2)"
	if Kind is "Call"
		return text + "(" + ArgumentsText(0) + ")"
	if Kind is "MethodCall"
		return ChildText(0, MemberPrecedence) + "." + text + "(" + ArgumentsText(1) + ")"
	if Kind is "Index"
		return ChildText(0, MemberPrecedence) + "(" + ArgumentsText(1) + ")"
	Kind is "Member" then ChildText(0, MemberPrecedence) + "." + text else UnaryText
UnaryText Text
	SyntaxNode("Not", "", (SyntaxNode("Identifier", "a"), SyntaxNode("Identifier", "a"))).UnaryText is "not a"
	SyntaxNode("Negate", "", (one, one)).UnaryText is "-1"
	SyntaxNode("Index", "", (identifier, one)).CallText is "a(1)"
	constant notOperandPrecedence = 13
	constant negatePrecedence = 15
	if Kind is "Not"
		return "not " + ChildText(0, notOperandPrecedence)
	Kind is "Negate" then "-" + ChildText(0, negatePrecedence) else StatementText
StatementText Text
	SyntaxNode("Return", "", (SyntaxNode("Number", "1"), SyntaxNode("Number", "1"))).StatementText is "return 1"
	SyntaxNode("Declaration", "let a", (SyntaxNode("Number", "1"), SyntaxNode("Number", "1"))).StatementText is "let a = 1"
	SyntaxNode("Else", "else").StatementText is "else"
	SyntaxNode("For", "for", (SyntaxNode("Body", ""), SyntaxNode("Body", ""))).StatementText is "for"
	SyntaxNode("For", "for as long as", List(SyntaxNode) + SyntaxNode("Number", "1")).StatementText is "for as long as 1"
	if Kind is "Declaration"
		return text + " = " + ChildText(0, 0)
	if Kind is in ("Reassignment", "Computed")
		return ChildText(0, 0) + " = " + ChildText(1, 0)
	if (HasValue is false) or (Kind is not in keywordKinds)
		return text
	(text is "" then keywordTexts(keywordKinds.Index(Kind)) else text) + " " + ValuesText
ValuesText Text
	SyntaxNode("For", "for y, x in", (SyntaxNode("Number", "2"), SyntaxNode("Number", "3"))).ValuesText is "2, 3"
	SyntaxNode("For", "", (SyntaxNode("Number", "2"), SyntaxNode("Body", ""))).ValuesText is "2"
	SyntaxNode("Return", "", (SyntaxNode("Number", "1"), SyntaxNode("Number", "1"))).ValuesText is "1"
	if Kind is not "For"
		return ChildText(0, 0)
	SyntaxNode("List", "", HasBody then children.Slice(0, children.Length - 1) else children).ArgumentsText(0)
ChildText(childIndex Number, minimumPrecedence Number) Text
	SyntaxNode("Not", "", (SyntaxNode("Identifier", "a"), SyntaxNode("Identifier", "a"))).ChildText(0, 15) is "a"
	SyntaxNode("Member", "Length", (sum, sum)).CallText is "(1 + 2).Length"
	SyntaxNode("MethodCall", "Add", (sum, one)).CallText is "(1 + 2).Add(1)"
	SyntaxNode("Index", "", (sum, one)).CallText is "(1 + 2)(1)"
	let child = children(childIndex)
	let childText = child to Text
	child.Precedence > 0 and child.Precedence < minimumPrecedence then "(" + childText + ")" else childText
ArgumentsText(firstIndex Number) Text
	SyntaxNode("Call", "Add", (SyntaxNode("Number", "1"), SyntaxNode("Number", "2"))).ArgumentsText(1) is "2"
	StatementParser(Tokenizer("f(1, (a then b else c))").Tokens).ParseStatement to Text is "f(1, (a then b else c))"
	StatementParser(Tokenizer("f(a then b else c)").Tokens).ParseStatement to Text is "f(a then b else c)"
	SyntaxNode("MethodCall", "f", (identifier, SyntaxNode("Binary", "then", (one, two)))).ArgumentsText(1) is "1 then 2"
	let minimumPrecedence = children.Length - firstIndex > 1 then 2 else 0
	mutable result = ""
	for children.Length - firstIndex
		if index > 0
			result = result + ", "
		result = result + ChildText(firstIndex + index, minimumPrecedence)
	result
HeadNames Texts
	StatementParser(Tokenizer("let a = b.Length + Add(c)").Tokens).ParseStatement.HeadNames is ("b", "Add", "c")
	SyntaxNode("Body", "", (SyntaxNode("Identifier", "a"), SyntaxNode("Identifier", "b"))).HeadNames.Length is 0
	SyntaxParser(Tokenizer("Point(p, y = q)").Tokens).Parse.HeadNames is ("Point", "p", "q")
	if Kind is in ("Body", "Identifier")
		return Kind is "Body" then List(Text) else Tokenizer(text).Tokens
	mutable names = List(Mutable(Text))
	if Kind is "Call"
		names.Add(text)
	for children
		let isNamed = (Kind is "Call") and (value.Kind is "Reassignment")
		names = names + (isNamed then value.children.Last.HeadNames else HeadNames)
	names
Kinds Texts
	SyntaxParser(Tokenizer("Point(p, y = q)").Tokens).Parse.Kinds is ("Identifier", "Reassignment")
	sum.Kinds is ("Number", "Number")
	for children
		value.Kind
HasBody Boolean
	SyntaxNode("For", "", (SyntaxNode("Number", "3"), SyntaxNode("Body", ""))).HasBody
	SyntaxNode("Number", "3").HasBody is false
	children.Length > 0 and (children.Last.Kind is "Body")
HasValue Boolean
	SyntaxNode("For", "", (SyntaxNode("Body", ""), SyntaxNode("Body", ""))).HasValue is false
	SyntaxNode("Body", "b").HeadNames.Length is 0
	SyntaxNode("List", "", List(SyntaxNode) + SyntaxNode("Reassignment", "", (identifier, two))).HeadNames is ("a")
	children.Length > 0 and children(0).Kind is not "Body"
Lines(indentation Text) Texts
	SyntaxNode("Body", "", (SyntaxNode("Identifier", "a"), SyntaxNode("Identifier", "b"))).Lines("\t") is ("\ta", "\tb")
	nested.Lines("") is ("if a", "\t1")
	mutable lines = List(Mutable(Text))
	for children
		lines.Add(indentation + value to Text)
		if value.HasBody
			lines = lines + value.children.Last.Lines(indentation + "\t")
	lines
Statements SyntaxNodes
	BodyParser("Run", "\tif a", "\t\tb", "\tc").Block(1, 1).Statements.Length is 3
	mutable statements = List(Mutable(SyntaxNode))
	for children
		statements.Add(value)
		if value.HasBody
			statements = statements + value.children.Last.Statements
	statements
IsLiteral Boolean
	SyntaxNode("List", "", (SyntaxNode("Number", "1"), SyntaxNode("Text", "\"a\""))).IsLiteral
	SyntaxNode("List", "", (SyntaxNode("Number", "1"), SyntaxNode("Identifier", "a"))).IsLiteral is false
	SyntaxNode("Boolean", "true").IsLiteral
	SyntaxNode("Identifier", "a").IsLiteral is false
	if Kind is in ("Number", "Text", "Boolean")
		return true
	if Kind is not "List"
		return false
	for children
		if value.Kind is not in ("Number", "Text")
			return false
	true
Unquoted Text
	SyntaxNode("Text", "\"a\"").Unquoted is "a"
	SyntaxNode("Text", "\"a\\\\b\"").Unquoted is "a\\b"
	SyntaxNode("Text", "\"a\\\\tb\"").Unquoted is "a\\tb"
	SyntaxNode("Text", "\"a\\nb\\rc\\td\\\"e\"").Unquoted is "a\nb\rc\td\"e"
	mutable parts = List(Mutable(Text))
	for text.Substring(1, text.Length - 2).Split("\\\\")
		parts.Add(value.Replace("\\n", "\n").Replace("\\r", "\r").Replace("\\t", "\t").Replace("\\\"", "\""))
	Text.Combine(parts, "\\")