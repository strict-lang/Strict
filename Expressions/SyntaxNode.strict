has Kind Text
has text
has children SyntaxNodes
constant operators = ("then", "else", "is", "is in", "is not", "is not in", "or", "xor", "and", "<", ">", "<=", ">=", "in", "+", "-", "%", "*", "/", "^", "to")
constant precedences = (1, 1, 2, 2, 7, 7, 4, 5, 6, 7, 7, 7, 7, 9, 11, 11, 12, 13, 13, 14, 20)
constant keywordKinds = ("Return", "If", "For", "ElseIf", "ElseValue")
constant keywordTexts = ("return", "if", "for", "else if", "else")
Precedence Number
	SyntaxNode("Binary", "+").Precedence is 11
	SyntaxNode("Binary", "is not").Precedence is 7
	SyntaxNode("Number", "1").Precedence is 0
	SyntaxNode("Binary", "x").Precedence is 0
	if Kind is "Not"
		return 3
	if Kind is not "Binary" or text is not in operators
		return 0
	precedences(operators.Index(text))
to Text
	SyntaxNode("Number", "1") to Text is "1"
	SyntaxNode("Binary", "+", (SyntaxNode("Number", "1"), SyntaxNode("Number", "2"))) to Text is "1 + 2"
	SyntaxNode("List", "", (SyntaxNode("Number", "1"), SyntaxNode("Number", "2"))) to Text is "(1, 2)"
	if Kind is "Binary"
		return BinaryText
	if Kind is "List"
		return "(" + ArgumentsText(0) + ")"
	CallText
BinaryText Text
	SyntaxNode("Binary", "*", (SyntaxNode("Missing", ""), SyntaxNode("Number", "2"))).BinaryText is "* 2"
	constant left = ChildText(0, Precedence)
	constant right = ChildText(1, Precedence + 1)
	if left is ""
		return right is "" then text else text + " " + right
	right is "" then left + " " + text else left + " " + text + " " + right
CallText Text
	SyntaxNode("Call", "Add", (SyntaxNode("Number", "1"), SyntaxNode("Number", "2"))).CallText is "Add(1, 2)"
	SyntaxNode("Member", "Length", (SyntaxNode("Identifier", "x"), SyntaxNode("Identifier", "x"))).CallText is "x.Length"
	if Kind is "Call"
		return text + "(" + ArgumentsText(0) + ")"
	if Kind is "MethodCall"
		return ChildText(0, 21) + "." + text + "(" + ArgumentsText(1) + ")"
	if Kind is "Member"
		return ChildText(0, 21) + "." + text
	UnaryText
UnaryText Text
	SyntaxNode("Not", "", (SyntaxNode("Identifier", "a"), SyntaxNode("Identifier", "a"))).UnaryText is "not a"
	if Kind is "Not"
		return "not " + ChildText(0, 13)
	if Kind is "Negate"
		return "-" + ChildText(0, 15)
	StatementText
StatementText Text
	SyntaxNode("Return", "", (SyntaxNode("Number", "1"), SyntaxNode("Number", "1"))).StatementText is "return 1"
	SyntaxNode("Declaration", "let a", (SyntaxNode("Number", "1"), SyntaxNode("Number", "1"))).StatementText is "let a = 1"
	SyntaxNode("Else", "else").StatementText is "else"
	SyntaxNode("For", "for", (SyntaxNode("Body", ""), SyntaxNode("Body", ""))).StatementText is "for"
	if Kind is "Declaration"
		return text + " = " + ChildText(0, 0)
	if Kind is "Reassignment"
		return ChildText(0, 0) + " = " + ChildText(1, 0)
	HasValue and (Kind is in keywordKinds) then keywordTexts(keywordKinds.Index(Kind)) + " " + ChildText(0, 0) else text
ChildText(childIndex Number, minimumPrecedence Number) Text
	SyntaxNode("Not", "", (SyntaxNode("Identifier", "a"), SyntaxNode("Identifier", "a"))).ChildText(0, 15) is "a"
	let child = children(childIndex)
	let childText = child to Text
	if child.Precedence > 0 and child.Precedence < minimumPrecedence
		return "(" + childText + ")"
	childText
ArgumentsText(firstIndex Number) Text
	SyntaxNode("Call", "Add", (SyntaxNode("Number", "1"), SyntaxNode("Number", "2"))).ArgumentsText(1) is "2"
	mutable result = ""
	for children.Length - firstIndex
		if index > 0
			result = result + ", "
		let argument = children(firstIndex + index) to Text
		result = result + argument
	result
HeadNames Texts
	StatementParser(Tokenizer("let a = b.Length + Add(c)").Tokens).ParseStatement.HeadNames is ("b", "Add", "c")
	SyntaxNode("Body", "", (SyntaxNode("Identifier", "a"), SyntaxNode("Identifier", "b"))).HeadNames.Length is 0
	if Kind is "Body"
		return List(Text)
	if Kind is "Identifier"
		return Tokenizer(text).Tokens
	mutable names = List(Mutable(Text))
	if Kind is "Call"
		names.Add(text)
	for children
		names = names + HeadNames
	names
HasBody Boolean
	SyntaxNode("For", "", (SyntaxNode("Number", "3"), SyntaxNode("Body", ""))).HasBody is true
	SyntaxNode("Number", "3").HasBody is false
	children.Length > 0 and (children.Last.Kind is "Body")
HasValue Boolean
	SyntaxNode("For", "", (SyntaxNode("Body", ""), SyntaxNode("Body", ""))).HasValue is false
	children.Length > 0 and children(0).Kind is not "Body"
Lines(indentation Text) Texts
	SyntaxNode("Body", "", (SyntaxNode("Identifier", "a"), SyntaxNode("Identifier", "b"))).Lines("\t") is ("\ta", "\tb")
	mutable lines = List(Mutable(Text))
	for children
		lines.Add(indentation + value to Text)
		if value.HasBody
			lines = lines + value.children.Last.Lines(indentation + "\t")
	lines