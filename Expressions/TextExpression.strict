has text
IsConstant Boolean
	true
to Text
	TextExpression("hi") to Text is "\"hi\""
	"\"" + text + "\""
Parse(input Text) TextExpression
	Parse("\"hi\"").text is "hi"
	if input.Length >= 2 and input.StartsWith("\"")
		return TextExpression(input.Substring(1, input.Length - 2))
	TextExpression(input)