has line Text
constant WordCharacters = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789"
Tokens Texts
	Tokenizer("a + b").Tokens is ("a", "+", "b")
	Tokenizer("Add(5, x.y)").Tokens is ("Add", "(", "5", ",", "x", ".", "y", ")")
	Tokenizer("\"hi there\" + 1.5").Tokens is ("\"hi there\"", "+", "1.5")
	Tokenizer("a >= -1").Tokens is ("a", ">=", "-", "1")
	mutable tokens = List(Mutable(Text))
	mutable nextStart = 0
	for line.Length
		if index >= nextStart and line.Substring(index, 1) is not " "
			let length = TokenLength(index)
			tokens.Add(line.Substring(index, length))
			nextStart = index + length
	tokens
TokenLength(start Number) Number
	Tokenizer("ab+1").TokenLength(0) is 2
	Tokenizer("\"x y\"").TokenLength(0) is 5
	Tokenizer("a<=b").TokenLength(1) is 2
	Tokenizer("1.5)").TokenLength(0) is 3
	let character = line.Substring(start, 1)
	if character is "\""
		return TextEnd(start + 1) - start + 1
	if IsWordCharacter(character)
		return WordLength(start)
	if start + 1 < line.Length and (line.Substring(start, 2) is in ("<=", ">="))
		return 2
	1
TextEnd(position Number) Number
	Tokenizer("\"a\"").TextEnd(1) is 2
	Tokenizer("\"\\\"\"").TextEnd(1) is 3
	mutable escaped = false
	for Range(position, line.Length)
		let character = line.Substring(value, 1)
		if (not escaped) and (character is "\"")
			return value
		escaped = (not escaped) and (character is "\\")
	line.Length - 1
WordLength(start Number) Number
	Tokenizer("abc d").WordLength(0) is 3
	Tokenizer("12.5").WordLength(0) is 4
	Tokenizer("x.y").WordLength(0) is 1
	Tokenizer("1.Lerp").WordLength(0) is 1
	Tokenizer("Vector2.One").WordLength(0) is 7
	for Range(start, line.Length)
		let character = line.Substring(value, 1)
		if (WordCharacters.IndexOf(character) is -1) and (character is not "." or (not IsDecimalPoint(value)))
			return value - start
	line.Length - start
IsDecimalPoint(position Number) Boolean
	Tokenizer("1.5").IsDecimalPoint(1) is true
	Tokenizer("a2.b").IsDecimalPoint(2) is false
	if position + 1 >= line.Length or (not IsDigit(line.Substring(position + 1, 1)))
		return false
	IsDigit(line.Substring(position - 1, 1))
IsWordCharacter(character Text) Boolean
	IsWordCharacter("a") is true
	IsWordCharacter("7") is true
	IsWordCharacter("(") is false
	WordCharacters.IndexOf(character) is not -1
IsDigit(character Text) Boolean
	IsDigit("7") is true
	IsDigit("a") is false
	"0123456789".IndexOf(character) is not -1