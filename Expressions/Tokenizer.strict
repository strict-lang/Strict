has line Text
constant Minus = 45
constant Dot = 46
constant LessThan = 60
constant EqualsSign = 61
constant GreaterThan = 62
constant LowercaseE = 101
Tokens Texts
	Tokenizer("a + b").Tokens is ("a", "+", "b")
	Tokenizer("Add(5, x.y)").Tokens is ("Add", "(", "5", ",", "x", ".", "y", ")")
	Tokenizer("\"hi there\" + 1.5").Tokens is ("\"hi there\"", "+", "1.5")
	Tokenizer("a >= -1").Tokens is ("a", ">=", "-", "1")
	mutable tokens = List(Mutable(Text))
	mutable position = 0
	for as long as position < line.Length
		let length = line.characters(position).number is Character.Space then 0 else TokenLength(position)
		if length > 0
			tokens.Add(line.Substring(position, length))
		position = position + (length is 0 then 1 else length)
	tokens
TokenLength(start Number) Number
	Tokenizer("ab+1").TokenLength(0) is 2
	Tokenizer("\"x y\"").TokenLength(0) is 5
	Tokenizer("a<=b").TokenLength(1) is 2
	Tokenizer("1.5)").TokenLength(0) is 3
	Tokenizer("a>=b").TokenLength(1) is 2 and (Tokenizer("a<b").TokenLength(1) is 1)
	let code = line.characters(start).number
	if code is Character.Quote
		return (TextEnd(start + 1) + 1).Clamp(0, line.Length) - start
	if IsWordCode(code)
		return WordLength(start)
	let isCompared = ((code is LessThan) or (code is GreaterThan)) and (start + 1 < line.Length)
	isCompared and (line.characters(start + 1).number is EqualsSign) then 2 else 1
TextEnd(position Number) Number
	Tokenizer("\"a\"").TextEnd(1) is 2
	Tokenizer("\"\\\"\"").TextEnd(1) is 3
	Tokenizer("\"a").TextEnd(1) is 2
	Tokenizer("\"\\\\\"").TextEnd(1) is 3
	mutable escaped = false
	for Range(position, line.Length)
		let code = line.characters(value).number
		if (not escaped) and (code is Character.Quote)
			return value
		escaped = (not escaped) and (code is Character.Backslash)
	line.Length
HasOpenText Boolean
	Tokenizer("x + \"a").HasOpenText
	Tokenizer("(\"a\", \"b\")").HasOpenText is false
	Tokenizer("\"a\\\"").HasOpenText
	Tokenizer("a").HasOpenText is false
	Tokenizer("x + \"a\"").HasOpenText is false
	Tokenizer("").HasOpenText is false
	if line.IndexOf("\"") < 0
		return false
	let last = Tokens.Last
	last.StartsWith("\"") and (TextEnd(line.LastIndexOf(last) + 1) is line.Length)
WordLength(start Number) Number
	Tokenizer("abc d").WordLength(0) is 3
	Tokenizer("12.5").WordLength(0) is 4
	Tokenizer("x.y").WordLength(0) is 1
	Tokenizer("1.Lerp").WordLength(0) is 1
	Tokenizer("Vector2.One").WordLength(0) is 7
	Tokenizer("1e-5)").WordLength(0) is 4
	for Range(start, line.Length)
		let code = line.characters(value).number
		let isNumberPart = (code is Dot) and IsDecimalPoint(value) or (code is Minus) and IsExponentSign(start, value)
		if (IsWordCode(code) is false) and (not isNumberPart)
			return value - start
	line.Length - start
IsDecimalPoint(position Number) Boolean
	Tokenizer("1.5").IsDecimalPoint(1)
	Tokenizer("a2.b").IsDecimalPoint(2) is false
	Tokenizer("1.").IsDecimalPoint(1) is false
	Tokenizer("a.5").IsDecimalPoint(1) is false
	if position + 1 >= line.Length or (not IsDigitCode(line.characters(position + 1).number))
		return false
	IsDigitCode(line.characters(position - 1).number)
IsExponentSign(start Number, position Number) Boolean
	Tokenizer("1e-5").IsExponentSign(0, 2)
	Tokenizer("e-5").IsExponentSign(0, 1) is false
	Tokenizer("1x-5").IsExponentSign(0, 2) is false
	Tokenizer("1e-").IsExponentSign(0, 2) is false
	Tokenizer("1e-x").IsExponentSign(0, 2) is false
	Tokenizer("ae-5").IsExponentSign(0, 2) is false
	let isExponent = (position > start) and (line.characters(position - 1).number is LowercaseE)
	let isNumber = isExponent and IsDigitCode(line.characters(start).number)
	isNumber and (position + 1 < line.Length) and IsDigitCode(line.characters(position + 1).number)
IsWordCharacter(character Text) Boolean
	IsWordCharacter("a")
	IsWordCharacter("7")
	IsWordCharacter("(") is false
	IsWordCharacter("ab") is false
	(character.Length is 1) and IsWordCode(character.characters(0).number)
IsWordCode(code Number) Boolean
	IsWordCode(97)
	IsWordCode(90)
	IsWordCode(55)
	IsWordCode(40) is false
	IsWordCode(95) is false
	IsWordCode(122) and IsWordCode(65) and IsWordCode(48)
	IsWordCode(123) is false and (IsWordCode(96) is false) and (IsWordCode(91) is false)
	IsWordCode(64) is false and (IsWordCode(58) is false) and (IsWordCode(47) is false)
	let isLower = (code >= Character.LowercaseA) and (code <= Character.LowercaseZ)
	let isUpper = (code >= Character.UppercaseA) and (code <= Character.UppercaseZ)
	isLower or isUpper or IsDigitCode(code)
IsDigit(character Text) Boolean
	IsDigit("7")
	IsDigit("a") is false
	Tokenizer("").Tokens.Length is 0 and (Tokenizer("").Names.Length is 0)
	Tokenizer("a+=b").TokenLength(1) is 1 and (Tokenizer("=<").TokenLength(1) is 1)
	Tokenizer("a \"x\"").TokenLength(2) is 3
	Tokenizer("1+2").WordLength(0) is 1 and (Tokenizer("1e+5").WordLength(0) is 2)
	Tokenizer("1-5").WordLength(0) is 1 and (Tokenizer("a bc").WordLength(2) is 2)
	Tokenizer("a. Size").Names.Length is 0 and (Tokenizer("x + Size").Names is ("Size"))
	"0123456789".IndexOf(character) is not -1
IsDigitCode(code Number) Boolean
	IsDigitCode(48)
	IsDigitCode(57)
	IsDigitCode(58) is false
	IsDigitCode(47) is false
	Tokenizer("Id ").IsName(0, 2) and (Tokenizer("Id  = 1").IsName(0, 2) is false)
	Tokenizer("1").IsName(0, 1) is false and (Tokenizer("Id =").IsName(0, 2) is false)
	Tokenizer("Id= 1").IsName(0, 2) is false
	(code >= Character.zeroCharacter) and (code <= Character.zeroCharacter + 9)
IsGrouped(tokens Texts) Boolean
	Tokenizer.IsGrouped(Tokenizer("value.None is ()").Tokens) is false
	Tokenizer.IsGrouped(Tokenizer("(a + b) * c").Tokens)
	Tokenizer.IsGrouped(Tokenizer("(a + b").Tokens) is false
	if tokens.Count("(") is not tokens.Count(")")
		return false
	for tokens
		if (value is "(") and (index + 1 < tokens.Length) and (tokens(index + 1) is ")")
			return false
	true
Names Texts
	Tokenizer("Number.Pi + x * Size").Names is ("Number", "Size")
	Tokenizer("\"Not A Name\" + Size >= Other").Names is ("Size", "Other")
	mutable names = List(Mutable(Text))
	mutable position = 0
	mutable isAfterDot = false
	for as long as position < line.Length
		let length = line.characters(position).number is Character.Space then 0 else TokenLength(position)
		if (length > 0) and (isAfterDot is false) and IsName(position, length)
			names.Add(line.Substring(position, length))
		isAfterDot = length is 0 then isAfterDot else (length is 1) and (line.characters(position).number is Dot)
		position = position + (length is 0 then 1 else length)
	names
IsName(start Number, length Number) Boolean
	Tokenizer("Id = 1").IsName(0, 2) is false
	Tokenizer("Id >= 1").IsName(0, 2)
	Tokenizer("x").IsName(0, 1) is false
	let first = line.characters(start)
	mutable after = start + length
	for as long as (after < line.Length) and (line.characters(after).number is Character.Space)
		after = after + 1
	let isAssigned = (after < line.Length) and (line.characters(after).number is EqualsSign) and (TokenLength(after) is 1)
	(first is first.Upper) and (first is not first.Lower) and (isAssigned is false)
