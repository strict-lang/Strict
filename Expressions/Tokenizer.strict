has line Text
Tokens Texts
	Tokenizer("a + b").Tokens is ("a", "+", "b")
	Tokenizer("Add(5, x.y)").Tokens is ("Add", "(", "5", ",", "x", ".", "y", ")")
	Tokenizer("\"hi there\" + 1.5").Tokens is ("\"hi there\"", "+", "1.5")
	Tokenizer("a >= -1").Tokens is ("a", ">=", "-", "1")
	mutable tokens = List(Mutable(Text))
	mutable position = 0
	for as long as position < line.Length
		let length = line.characters(position).number is 32 then 0 else TokenLength(position)
		if length > 0
			tokens.Add(line.Substring(position, length))
		position = position + (length is 0 then 1 else length)
	tokens
TokenLength(start Number) Number
	Tokenizer("ab+1").TokenLength(0) is 2
	Tokenizer("\"x y\"").TokenLength(0) is 5
	Tokenizer("a<=b").TokenLength(1) is 2
	Tokenizer("1.5)").TokenLength(0) is 3
	let code = line.characters(start).number
	if code is 34
		return (TextEnd(start + 1) + 1).Clamp(0, line.Length) - start
	if IsWordCode(code)
		return WordLength(start)
	let isCompared = ((code is 60) or (code is 62)) and (start + 1 < line.Length)
	isCompared and (line.characters(start + 1).number is 61) then 2 else 1
TextEnd(position Number) Number
	Tokenizer("\"a\"").TextEnd(1) is 2
	Tokenizer("\"\\\"\"").TextEnd(1) is 3
	Tokenizer("\"a").TextEnd(1) is 2
	mutable escaped = false
	for Range(position, line.Length)
		let code = line.characters(value).number
		if (not escaped) and (code is 34)
			return value
		escaped = (not escaped) and (code is 92)
	line.Length
HasOpenText Boolean
	Tokenizer("x + \"a").HasOpenText
	Tokenizer("(\"a\", \"b\")").HasOpenText is false
	Tokenizer("\"a\\\"").HasOpenText
	Tokenizer("a").HasOpenText is false
	if line.IndexOf("\"") < 0
		return false
	let last = Tokens.Last
	last.StartsWith("\"") and (TextEnd(line.LastIndexOf(last) + 1) is line.Length)
WordLength(start Number) Number
	Tokenizer("abc d").WordLength(0) is 3
	Tokenizer("12.5").WordLength(0) is 4
	Tokenizer("x.y").WordLength(0) is 1
	Tokenizer("1.Lerp").WordLength(0) is 1
	Tokenizer("Vector2.One").WordLength(0) is 7
	Tokenizer("1e-5)").WordLength(0) is 4
	for Range(start, line.Length)
		let code = line.characters(value).number
		let isNumberPart = (code is 46) and IsDecimalPoint(value) or (code is 45) and IsExponentSign(start, value)
		if (IsWordCode(code) is false) and (not isNumberPart)
			return value - start
	line.Length - start
IsDecimalPoint(position Number) Boolean
	Tokenizer("1.5").IsDecimalPoint(1)
	Tokenizer("a2.b").IsDecimalPoint(2) is false
	if position + 1 >= line.Length or (not IsDigitCode(line.characters(position + 1).number))
		return false
	IsDigitCode(line.characters(position - 1).number)
IsExponentSign(start Number, position Number) Boolean
	Tokenizer("1e-5").IsExponentSign(0, 2)
	Tokenizer("e-5").IsExponentSign(0, 1) is false
	let isExponent = (position > start) and (line.characters(position - 1).number is 101)
	let isNumber = isExponent and IsDigitCode(line.characters(start).number)
	isNumber and (position + 1 < line.Length) and IsDigitCode(line.characters(position + 1).number)
IsWordCharacter(character Text) Boolean
	IsWordCharacter("a")
	IsWordCharacter("7")
	IsWordCharacter("(") is false
	(character.Length is 1) and IsWordCode(character.characters(0).number)
IsWordCode(code Number) Boolean
	IsWordCode(97)
	IsWordCode(90)
	IsWordCode(55)
	IsWordCode(40) is false
	IsWordCode(95) is false
	(code >= 97) and (code <= 122) or (code >= 65) and (code <= 90) or (code >= 48) and (code <= 57)
IsDigit(character Text) Boolean
	IsDigit("7")
	IsDigit("a") is false
	"0123456789".IndexOf(character) is not -1
IsDigitCode(code Number) Boolean
	IsDigitCode(48)
	IsDigitCode(57)
	IsDigitCode(58) is false
	IsDigitCode(47) is false
	(code >= 48) and (code <= 57)
IsGrouped Boolean
	Tokenizer("value.None is ()").IsGrouped is false
	Tokenizer("(a + b) * c").IsGrouped
	Tokenizer("(a + b").IsGrouped is false
	let tokens = Tokens
	if tokens.Count("(") is not tokens.Count(")")
		return false
	for tokens
		if (value is "(") and (index + 1 < tokens.Length) and (tokens(index + 1) is ")")
			return false
	true
