has lines Texts
constant Project = ("./LogoApp/Scene.strict", "./WebWars/Scene.strict", "./WebWars/Unit.strict")
constant Scenes = ("./LogoApp/Scene.strict", "./WebWars/Scene.strict")
constant Both = TypeChoice(("has logo LogoApp/Scene", "has web WebWars/Scene", "Loaded Number", "\tweb.Units.Length"))
constant Plain = TypeChoice(("Loaded Number", "\tScene.Units.Length"))
constant Qualified = TypeChoice(("has scene WebWars/Scene", "Loaded Number", "\tscene.Units.Length"))
Chosen(files Texts, source Text) Texts
	Plain.Chosen(Project, "./LogoApp/Game.strict") is ("./LogoApp/Scene.strict", "./WebWars/Unit.strict")
	Qualified.Chosen(Project, "./Content/Catalog.strict") is ("./WebWars/Scene.strict", "./WebWars/Unit.strict")
	Plain.Chosen(Project, "./Content/Catalog.strict") is Project
	names = Names(files)
	mutable counts = Dictionary(Text, Number)
	for names
		counts(value) = (value is in counts then counts(value) else 0) + 1
	for files
		best = counts(names(index)) > 1 then Best(SameNamed(files, names, names(index)), source) else value
		if best is "" or best is value
			value
Names(files Texts) Texts
	Plain.Names("x\\Scene.strict") is ("Scene.strict")
	Plain.Best("./WebWars/Scene.strict", "./Content/Catalog.strict") is "./WebWars/Scene.strict"
	Plain.Names(Project) is ("Scene.strict", "Scene.strict", "Unit.strict")
	for files
		slashed = value.IndexOf("\\") < 0 then value else value.Replace("\\", "/")
		slash = slashed.LastIndexOf("/")
		slash < 0 then slashed else slashed.Substring(slash + 1, slashed.Length - slash - 1)
SameNamed(files Texts, names Texts, name Text) Texts
	Plain.Best(("x\\Scene.strict", "y\\Scene.strict"), "y\\Game.strict") is "y\\Scene.strict"
	Plain.SameNamed(Project, Plain.Names(Project), "Scene.strict").Length is 2
	for files
		if names(index) is name
			value
Best(candidates Texts, source Text) Text
	Qualified.Best(Scenes, "./Content/Catalog.strict") is "./WebWars/Scene.strict"
	Plain.Best(Scenes, "./Content/Catalog.strict") is ""
	Both.Best(Scenes, "./Content/Catalog.strict") is ""
	qualified = Qualifying(candidates)
	if candidates.Length is 1 or qualified.Length > 0
		return candidates.Length is 1 then candidates.First else (qualified.Length is 1 then qualified.First else "")
	folder = Path(source.Replace("\\", "/")).PathOnly.text
	for candidates
		if Path(value.Replace("\\", "/")).PathOnly.text is folder
			return value
	""
Qualifying(candidates Texts) Texts
	Qualified.IsQualified("x\\WebWars\\Scene.strict")
	Both.Qualifying(Scenes) is Scenes
	for candidates
		if IsQualified(value)
			value
IsQualified(path Text) Boolean
	Qualified.IsQualified("./WebWars/Scene.strict")
	Plain.IsQualified("./WebWars/Scene.strict") is false
	TypeChoice(("has a WebWars/Scenery", "\tlet b = \"WebWars/Scene\"")).IsQualified("./WebWars/Scene.strict") is false
	parts = path.Replace("\\", "/").Split("/")
	parts(parts.Length - 2) is in Packages(parts.Last.Replace(".strict", ""))
Ambiguous(names Texts, path Text) Texts
	Plain.Ambiguous(("Scene", "Scene", "Unit", "Unit"), "A").Length is 1
	Plain.Ambiguous(("Scene", "Scene", "Unit"), "A").First.StartsWith("A:line 2: AmbiguousType: Scene")
	Plain.Ambiguous(("Scene", "Unit"), "./Content/Catalog.strict").Length is 0
	Both.Ambiguous(("Scene", "Scene"), "A.strict").First.StartsWith("A.strict:line 1: SameNamedTypes: Scene from")
	Qualified.Ambiguous(("Scene", "Scene"), "A.strict").Length is 0
	for names
		if names.Index(value) is index and names.Count(value) > 1 and UsedLine(value) > 0
			issue = Issue(value)
			if issue is not ""
				ResolveCheck.Located(path, UsedLine(value), issue)
Issue(name Text) Text
	Plain.Issue("Scene").StartsWith("AmbiguousType: Scene") and Qualified.Issue("Scene") is ""
	Both.Issue("Scene").StartsWith("SameNamedTypes: Scene")
	packages = Packages(name)
	if packages.Length is 1
		return ""
	clash = " from " + Text.Combine(packages, " and ") + ", a build keys types by their plain name, rename one"
	advice = " is defined in several packages here, write Package/" + name + " in a declaration"
	packages.Length > 1 then "SameNamedTypes: " + name + clash else "AmbiguousType: " + name + advice
Unique(candidates Texts) Texts
	TypeChoice(List(Text) + "a/Net.strict").Unique(("b/Net.strict", "b/Lay.strict")) is ("b/Lay.strict")
	existing = Names(lines)
	names = Names(candidates)
	for candidates
		if names(index) is not in existing
			value
Packages(name Text) Texts
	Plain.Packages("Units").Length is 0 and Both.Packages("Unit").Length is 0
	TypeChoice("Scene").Packages("Scene").Length is 0
	TypeChoice(("a WebWars/Scene", "b WebWars/Scene")).Packages("Scene") is ("WebWars")
	Both.Packages("Scene") is ("LogoApp", "WebWars")
	Plain.Packages("Scene").Length is 0
	mutable packages = List(Mutable(Text))
	for lines
		tokens = Tokenizer(value).Tokens
		for Range(0, tokens.Length > 2 then tokens.Length - 2 else 0)
			if tokens(value + 1) is "/" and tokens(value + 2) is name and tokens(value) is not in packages
				packages.Add(tokens(value))
	packages
UsedLine(name Text) Number
	Plain.Ambiguous(("Scene", "Scene"), "A").First.EndsWith("write Package/Scene in a declaration")
	Both.Ambiguous(("Scene", "Scene"), "A")(0).EndsWith(" and WebWars, a build keys types by their plain name, rename one")
	Plain.UsedLine("Scene") is 2
	Plain.UsedLine("Unit") is 0
	for lines
		if name is in Tokenizer(value).Tokens
			return index + 1
	0