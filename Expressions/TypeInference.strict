has types KnownTypes
constant NoScope = Scope(("x", "z"), ("y", "w"))
constant NoShape = Scope(("x", "z"), ("y", "w"))
constant NoInference = TypeInference(KnownTypes(("A", "B"), (NoShape, NoShape), (NoShape, NoShape), (NoShape, NoShape)))
constant NoNode = SyntaxNode("Identifier", "x")
constant ToText = SyntaxNode("Binary", "to", (NoNode, SyntaxNode("Identifier", "Text")))
constant MutableText = SyntaxNode("Call", "Mutable", (SyntaxNode("Identifier", "Text"), NoNode))
TypeOf(node SyntaxNode, scope Scope, current Scope) Text
	NoInference.TypeOf(SyntaxNode("Number", "1"), NoScope, NoShape) is "Number"
	if node.Kind is in ("Number", "Text", "Boolean")
		return node.Kind
	if node.Kind is "Identifier"
		return IdentifierType(node.text, scope, current)
	if node.Kind is "Call"
		return node.text is "List" then ConstructedType(node.children(0)) + "s" else CallType(node.text, scope, current)
	if node.Kind is in ("Member", "MethodCall")
		return MemberCallType(node, scope, current)
	OperatorType(node, scope, current)
ConstructedType(node SyntaxNode) Text
	NoInference.ConstructedType(MutableText) is "Text"
	(node.Kind is "Call") and (node.text is "Mutable") then ConstructedType(node.children(0)) else node.text
IdentifierType(name Text, scope Scope, current Scope) Text
	NoInference.IdentifierType("x", Scope(("x", "y"), ("Number", "Text")), NoShape) is "Number"
	if scope.TypeOf(name) is not ""
		return scope.TypeOf(name)
	if ImplicitValueType(name, scope) is not ""
		return ImplicitValueType(name, scope)
	current.TypeOf(name) is "" then name else current.TypeOf(name)
CallType(name Text, scope Scope, current Scope) Text
	NoInference.CallType("Vector2", NoScope, NoShape) is "Vector2"
	NoInference.CallType("x", NoScope, Scope(("x", "y"), ("Texts", "Y"))) is "Text"
	if current.TypeOf(name) is not ""
		return IsListName(name) then types.ElementType(current.TypeOf(name)) else current.TypeOf(name)
	if types.IsKnown(name)
		return name
	if scope.TypeOf(name) is not ""
		return types.ElementType(scope.TypeOf(name))
	ImplicitValueType(name, scope) is "" then name else ImplicitValueType(name, scope)
IsListName(name Text) Boolean
	NoInference.IsListName("precedences") is true
	NoInference.IsListName("Length") is false
	name.Substring(0, 1).Lower is name.Substring(0, 1)
MemberCallType(node SyntaxNode, scope Scope, current Scope) Text
	NoInference.MemberCallType(SyntaxNode("Member", "Length", (ToText, NoNode)), NoScope, NoShape) is "Unknown"
	let instanceType = TypeOf(node.children(0), scope, current)
	let type = node.text is "value" then instanceType else types.MemberType(instanceType, node.text)
	let isMember = (node.text is "value") or types.MembersOf(instanceType).TypeOf(node.text) is not ""
	let isListCall = (node.Kind is "MethodCall") and isMember
	isListCall then types.ElementType(type) else type
ImplicitValueType(name Text, scope Scope) Text
	NoInference.ImplicitValueType("Length", NoScope) is ""
	if scope.TypeOf("value") is ""
		return ""
	let type = types.MemberType(scope.TypeOf("value"), name)
	type is "Unknown" then "" else type
OperatorType(node SyntaxNode, scope Scope, current Scope) Text
	NoInference.OperatorType(SyntaxNode("Not", ""), NoScope, NoShape) is "Boolean"
	if node.Kind is "Not"
		return "Boolean"
	if node.Kind is "Binary"
		return BinaryType(node, scope, current)
	if node.Kind is "List"
		return TypeOf(node.children(0), scope, current) + "s"
	node.Kind is "Negate" then TypeOf(node.children(0), scope, current) else "Unknown"
BinaryType(node SyntaxNode, scope Scope, current Scope) Text
	NoInference.BinaryType(ToText, NoScope, NoShape) is "Text"
	if node.text is "to"
		return ConstructedType(node.children(1))
	if node.text is in ("then", "else")
		return ConditionalType(node, scope, current)
	if node.children(0).Kind is "Missing"
		return TypeOf(node.children(1), scope, current)
	if node.Precedence < 11
		return "Boolean"
	let left = TypeOf(node.children(0), scope, current)
	let operatorType = types.MemberType(left, node.text)
	operatorType is "Unknown" then left else operatorType
ConditionalType(node SyntaxNode, scope Scope, current Scope) Text
	NoInference.ConditionalType(SyntaxNode("Binary", "then", (NoNode, NoNode)), NoScope, NoShape) is "y"
	if node.text is "then"
		return TypeOf(node.children(1), scope, current)
	let thenType = TypeOf(node.children(0), scope, current)
	thenType is "Error" then TypeOf(node.children(1), scope, current) else thenType