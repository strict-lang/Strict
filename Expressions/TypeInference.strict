has types KnownTypes
has constants Scopes
constant NoScope = Scope(("x", "z"), ("y", "w"))
constant NoShape = Scope(("x", "z"), ("y", "w"))
constant NoShapes = (NoShape, NoShape)
constant NoInference = TypeInference(KnownTypes(("A", "B"), NoShapes, NoShapes, NoShapes), NoShapes)
constant Limits = (Scope(List(Text) + "Limit", List(Text) + "3"), NoShape)
constant NoNode = SyntaxNode("Identifier", "x")
constant ToText = SyntaxNode("Binary", "to", (NoNode, SyntaxNode("Identifier", "Text")))
constant MutableText = SyntaxNode("Call", "Mutable", (SyntaxNode("Identifier", "Text"), NoNode))
constant Pairs = SyntaxParser(Tokenizer("Dictionary((1, \"a\"))").Tokens).Parse
constant Typed = SyntaxParser(Tokenizer("Dictionary(Text, Number)").Tokens).Parse
constant Hashing = TypeInference(KnownTypes(("Hash", "B"), (KnownTypes.NoMembers, KnownTypes.NoMembers), (KnownTypes.NoMembers, KnownTypes.NoMembers), (Scope(("from", "from types"), ("generic", "Generic")), KnownTypes.NoMembers)), NoShapes)
constant Primitives = ("None", "Boolean", "Number", "Byte", "Text", "Character", "Name", "Generic")
constant Colors = TypeInference(KnownTypes(("Color", "ColorValue"), (Scope(List(Text) + "Red", List(Text) + "Byte"), KnownTypes.NoMembers), (Scope(List(Text) + "to", List(Text) + "ColorValue"), KnownTypes.NoMembers), (Scope(("from", "from types"), ("current", "ColorValue")), KnownTypes.NoMembers)), NoShapes)
ConstantOf(typeName Text, name Text) Text
	TypeInference(KnownTypes.Sample, Limits).ConstantOf("Count", "Limit") is "3"
	NoInference.ConstantOf("A", "Missing") is ""
	let index = types.names.Index(typeName)
	index is -1 then "" else constants(index).TypeOf(name)
TypeOf(node SyntaxNode, scope Scope, current Scope) Text
	NoInference.TypeOf(SyntaxNode("Number", "1"), NoScope, NoShape) is "Number"
	if node.Kind is in ("Number", "Text", "Boolean")
		return node.Kind
	if node.Kind is "Identifier"
		return IdentifierType(node.text, scope, current)
	if node.Kind is "Call"
		return node.text is "List" then ConstructedType(node.children(0)) + "s" else Called(node, scope, current)
	if node.Kind is in ("Member", "MethodCall")
		return MemberCallType(node, scope, current)
	OperatorType(node, scope, current)
ConstructedType(node SyntaxNode) Text
	NoInference.ConstructedType(MutableText) is "Text"
	(node.Kind is "Call") and (node.text is "Mutable") then ConstructedType(node.children(0)) else node.text
IdentifierType(name Text, scope Scope, current Scope) Text
	NoInference.IdentifierType("x", Scope(("x", "y"), ("Number", "Text")), NoShape) is "Number"
	if scope.TypeOf(name) is not ""
		return scope.TypeOf(name)
	if ImplicitValueType(name, scope) is not ""
		return ImplicitValueType(name, scope)
	current.TypeOf(name) is "" then name else current.TypeOf(name)
Called(node SyntaxNode, scope Scope, current Scope) Text
	NoInference.Called(SyntaxNode("Call", "Mutable", SyntaxNode("Number", "5")), NoScope, NoShape) is "Number"
	NoInference.Called(Pairs, NoScope, NoShape) is "Dictionary(Number, Text)"
	NoInference.Called(Typed, NoScope, NoShape) is "Dictionary(Text, Number)"
	Hashing.Called(SyntaxNode("Call", "Hash", SyntaxNode("Number", "5")), NoScope, NoShape) is "Hash(Number)"
	if (node.text is "Dictionary") and (node.children.Length > 0)
		let pair = node.children(0).Kind is "List" then node.children(0).children else node.children
		return "Dictionary(" + TypeOf(pair(0), scope, current) + ", " + TypeOf(pair.Last, scope, current) + ")"
	let isGeneric = (node.children.Length is 1) and (types.ParametersOf(node.text, "from types", 1) is ("Generic"))
	if isGeneric
		return node.text + "(" + TypeOf(node.children(0), scope, current) + ")"
	let isMutable = (node.text is "Mutable") and (node.children.Length is 1)
	isMutable then TypeOf(node.children(0), scope, current) else CallType(node.text, scope, current)
CallType(name Text, scope Scope, current Scope) Text
	NoInference.CallType("Vector2", NoScope, NoShape) is "Vector2"
	NoInference.CallType("x", NoScope, Scope(("x", "y"), ("Texts", "Y"))) is "Text"
	NoInference.CallType("failed", Scope(("failed"), ("Error")), NoShape) is "ErrorWithValue"
	if current.TypeOf(name) is not ""
		return IsListName(name) then types.ElementType(current.TypeOf(name)) else current.TypeOf(name)
	if types.IsKnown(name)
		return name
	if scope.TypeOf(name) is not ""
		return scope.TypeOf(name) is "Error" then "ErrorWithValue" else types.ElementType(scope.TypeOf(name))
	ImplicitValueType(name, scope) is "" then name else ImplicitValueType(name, scope)
IsListName(name Text) Boolean
	NoInference.IsListName("precedences") is true
	NoInference.IsListName("Length") is false
	name.Substring(0, 1).Lower is name.Substring(0, 1)
MemberCallType(node SyntaxNode, scope Scope, current Scope) Text
	NoInference.MemberCallType(SyntaxNode("Member", "Length", (ToText, NoNode)), NoScope, NoShape) is "Unknown"
	let binary = SyntaxNode("Binary", node.text, node.children)
	if (node.Kind is "MethodCall") and (binary.Precedence >= 11) and (binary.Precedence < 20)
		return ArithmeticType(binary, scope, current)
	let instanceType = TypeOf(node.children(0), scope, current)
	let type = node.text is "value" then instanceType else types.MemberType(instanceType, node.text)
	let isMember = (node.text is "value") or types.MembersOf(instanceType).TypeOf(node.text) is not ""
	let isListCall = (node.Kind is "MethodCall") and isMember
	isListCall then types.ElementType(type) else type
ImplicitValueType(name Text, scope Scope) Text
	NoInference.ImplicitValueType("Length", NoScope) is ""
	if scope.TypeOf("value") is ""
		return ""
	let type = types.MemberType(scope.TypeOf("value"), name)
	type is "Unknown" then "" else type
OperatorType(node SyntaxNode, scope Scope, current Scope) Text
	NoInference.OperatorType(SyntaxNode("Not", ""), NoScope, NoShape) is "Boolean"
	NoInference.OperatorType(Pairs.children(0), NoScope, NoShape) is "List(Number, Text)"
	if node.Kind is "Not"
		return "Boolean"
	if node.Kind is "Binary"
		return BinaryType(node, scope, current)
	if (node.Kind is "List") and (node.children.Length is 2)
		return MethodBodies.Item(TypeOf(node.children(0), scope, current) + ", " + TypeOf(node.children(1), scope, current))
	if node.Kind is "List"
		return TypeOf(node.children(0), scope, current) + "s"
	node.Kind is "Negate" then TypeOf(node.children(0), scope, current) else "Unknown"
BinaryType(node SyntaxNode, scope Scope, current Scope) Text
	NoInference.BinaryType(ToText, NoScope, NoShape) is "Text"
	NoInference.BinaryType(SyntaxParser(Tokenizer("3 + (4)").Tokens).Parse, NoScope, NoShape) is "Numbers"
	if node.text is "to"
		return ConstructedType(node.children(1))
	if node.text is in ("then", "else")
		return ConditionalType(node, scope, current)
	if node.children(0).Kind is "Missing"
		return TypeOf(node.children(1), scope, current)
	node.Precedence < 11 then "Boolean" else ArithmeticType(node, scope, current)
ArithmeticType(node SyntaxNode, scope Scope, current Scope) Text
	NoInference.ArithmeticType(SyntaxParser(Tokenizer("2 * 3").Tokens).Parse, NoScope, NoShape) is "Number"
	let left = TypeOf(node.children(0), scope, current)
	let right = TypeOf(node.children(1), scope, current)
	if (node.text is "+") and (left is "Number") and types.IsPlural(right)
		return right
	let ordinal = types.ParameterScope(left).Overload(node.text, List(Text) + right, left)
	let declared = types.MethodsOf(left).TypeAt(node.text, ordinal)
	let overloaded = declared is in ("List", types.BaseName(left)) then left else declared
	let operatorType = ordinal < 0 then types.MemberType(left, node.text) else overloaded
	operatorType is "Unknown" then left else operatorType
ConditionalType(node SyntaxNode, scope Scope, current Scope) Text
	NoInference.ConditionalType(SyntaxNode("Binary", "then", (NoNode, NoNode)), NoScope, NoShape) is "y"
	if node.text is "then"
		return TypeOf(node.children(1), scope, current)
	let thenType = TypeOf(node.children(0), scope, current)
	thenType is "Error" then TypeOf(node.children(1), scope, current) else thenType
Converter(source Text, type Text) Text
	Colors.Converter("ColorValue", "Color") is "from"
	Colors.Converter("Color", "ColorValue") is "to"
	Colors.Converter("Number", "Color") is ""
	Colors.Converter("Character", "Text") is "to"
	Colors.Converter("Text", "Character") is "to"
	if (source is in ("Character", "Text")) and (type is in ("Character", "Text")) and (source is not type)
		return "to"
	if (source is in Primitives) or (type is in Primitives) or (source is type)
		return ""
	let origins = types.ParametersOf(type, "from types", 1)
	let isFrom = (origins.Length is 1) and (origins(0) is source)
	types.MethodsOf(source).Has("to", type) then "to" else (isFrom then "from" else "")
Assigned(target Text, assigned Text) Text
	Colors.Assigned("Color", "ColorValue") is "Color"
	Colors.Assigned("Number", "Number") is "Number"
	Converter(assigned, target) is "" then assigned else target