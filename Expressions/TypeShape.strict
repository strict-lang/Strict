has lines Texts
constant Constrained = " constrained"
constant Measured = TypeShape("has Width Number", "Area Number", "\tconstant Big = 3", "\tVector2(Big, Width).Length * Area")
IsMemberLine(line Text) Boolean
	TypeShape("has a").IsMemberLine("mutable count Number")
	TypeShape("has a").IsMemberLine("Run") is false
	line.StartsWith("has ") or line.StartsWith("mutable ") or line.StartsWith("constant ")
IsMethodHeader(line Text) Boolean
	TypeShape("has a").IsMethodHeader("Run Number")
	TypeShape("has a").IsMethodHeader("\tlogger.Log(1)") is false
	if (line is "") or line.StartsWith("\t")
		return false
	not IsMemberLine(line)
IsComputed(line Text) Boolean
	TypeShape("has a").IsComputed("Area = Width * Height")
	TypeShape("has a").IsComputed("Next(add = 1) = add")
	TypeShape("has a").IsComputed("Add(other) Number") is false
	TypeShape("has a").IsComputed("constant Limit = 3") is false
	if IsMethodHeader(line) is false
		return false
	let tokens = Tokenizer(line).Tokens
	let assigned = HeaderTokens(tokens).ParametersEnd + 1
	(assigned < tokens.Length) and (tokens(assigned) is "=")
IsTrait Boolean
	TypeShape("Length Number").IsTrait
	TypeShape("has length", "in(element) Boolean").IsTrait
	TypeShape("Not Boolean", "\ttrue").IsTrait is false
	TypeShape("has a", "Twice = a * 2").IsTrait is false
	for lines
		if value.StartsWith("\t") or IsComputed(value)
			return false
	true
IsContract Boolean
	TypeShape("Result Number").IsContract
	TypeShape("from(type)").IsContract is false
	TypeShape("has Name").IsContract is false
	TypeShape("has number", "constant Max = 255").IsContract is false
	IsTrait and not UsesGenerics and ((MethodScope.names - ConstantScope.names - "from").Length > 0)
MemberScope Scope
	TypeShape("has count Number", "constant Limit = 3").MemberScope.TypeOf("count") is "Number"
	TypeShape("has count Number", "constant Limit = 3").MemberScope.names.Length is 1
	mutable names = List(Mutable(Text))
	mutable types = List(Mutable(Text))
	for lines
		if IsMemberLine(value) and (not value.StartsWith("constant "))
			let header = HeaderTokens(Tokenizer(value).Tokens)
			names.Add(header.MemberName)
			types.Add(header.DeclaredType(1))
	Scope(names, types)
ParameterScope Scope
	TypeShape("Add(first Number, second Number) Number", "\tfirst").ParameterScope.TypeOf("Add") is "first,second"
	TypeShape("Add(first Number, second) Number", "\tfirst").ParameterScope.TypeOf("Add types") is "Number,Second"
	TypeShape("Add(first Number) Mutable(Number)", "\tfirst").ParameterScope.TypeOf("Add mutable") is "Mutable"
	TypeShape("has price Number with Step 0.01").ParameterScope.TypeOf("price step") is "0.01"
	mutable scope = Scope(List(Text), List(Text))
	for lines
		if IsMethodHeader(value)
			let entries = HeaderEntries(HeaderTokens(Tokenizer(value).Tokens), MethodScope).Parameters
			scope = scope.WithAll(entries.names, entries.types)
	let steps = Steps(List(Text)).Members(lines)
	let result = scope.WithAll(steps.names, steps.types)
	IsContract then result.With(" trait", "true") else result
UsesGenerics Boolean
	TypeShape("has value Generic").UsesGenerics
	TypeShape("has value Generic or None").UsesGenerics is false
	TypeShape("for Iterator(Generic)", "in(element Generic) Boolean").UsesGenerics
	TypeShape("constant Names = (\"Generic\")", "Run", "\tNames").UsesGenerics is false
	for lines
		if index < 3 and IsGenericLine(index)
			return true
	false
IsGenericLine(position Number) Boolean
	TypeShape("has count Number").IsGenericLine(0) is false
	let line = lines(position)
	let mentions = line.IndexOf("Generic") is not -1 or line.IndexOf("generic") is not -1
	if line.StartsWith("has ") or line.StartsWith("mutable ")
		let words = line.Split(" ")
		return mentions and (words.Length < 4 or words(2) is not in ("Generic", "generic") or line.IndexOf("(") is not -1)
	let hasBody = position + 1 < lines.Length and lines(position + 1).StartsWith("\t")
	mentions and (line.StartsWith("constant ") is false) and (hasBody is false)
CallScope(generics Texts) Scope
	TypeShape("has iterator", "has Start Number").CallScope(List(Text) + "Iterator").TypeOf("from") is "Start"
	TypeShape("from(number)", "\tvalue").CallScope(List(Text)).TypeOf("from") is "number"
	TypeShape("has Name", "has Value Generic", "has Size = 0").CallScope(List(Text)).TypeOf("from") is "Name,Value,Size"
	TypeShape("has width Number with value > 0").CallScope(List(Text)).TypeOf(Constrained) is "true"
	TypeShape("has light Number = 0").CallScope(List(Text)).TypeOf("light default") is "0"
	constant parameters = Defaults(lines).Added(ParameterScope)
	constant scope = Constraint.Kind(lines) is "" then parameters else parameters.With(Constrained, Constraint.Kind(lines))
	mutable names = List(Mutable(Text))
	for MemberScope.types
		if (value is not in generics) and ((value is "Generic") or (value.IndexOf("Generic") is -1))
			names.Add(MemberScope.names(index))
	"from" is in scope.names then scope else scope.With("from", Text.Combine(names, ","))
MethodScope Scope
	TypeShape("constant Limit = 3", "Add(other Number) Number", "\tother").MethodScope.TypeOf("Add") is "Number"
	TypeShape("constant Limit = 3", "Add(other Number) Number", "\tother").MethodScope.TypeOf("Limit") is "Number"
	mutable names = List(Mutable(Text))
	mutable types = List(Mutable(Text))
	for lines
		if value.StartsWith("constant ") or IsMethodHeader(value)
			let header = HeaderTokens(Tokenizer(value).Tokens)
			names.Add(IsMethodHeader(value) then header.tokens(0) else header.MemberName)
			types.Add(IsMethodHeader(value) then header.ReturnType else header.DeclaredType(1))
	Scope(names, types)
EnumValue(position Number) Number
	TypeShape("constant A", "constant B = 10", "constant C").EnumValue(2) is 11
	TypeShape("constant A").EnumValue(0) is 0
	mutable next = 0
	for position
		let tokens = Tokenizer(lines(index)).Tokens
		if (tokens(0) is "constant") and (tokens.Length is 2)
			next = next + 1
		else if (tokens(0) is "constant") and (SyntaxParser(tokens).Leaf(tokens(3)).Kind is "Number")
			next = tokens(3) to Number + 1
	next
ConstantText(position Number) Text
	TypeShape("constant A", "constant B = 10", "constant C").ConstantText(2) is "11"
	TypeShape("constant Limit = 3 * 2").ConstantText(0) is "3 * 2"
	let tokens = Tokenizer(lines(position)).Tokens
	if tokens.Length is 2
		return EnumValue(position) to Text
	let line = lines(position)
	line.Substring(line.IndexOf(" = ") + 3, line.Length - line.IndexOf(" = ") - 3)
ConstantScope Scope
	TypeShape("constant A", "constant B = 10", "constant C").ConstantScope.TypeOf("C") is "11"
	TypeShape("constant Limit = 3 * 2", "has a").ConstantScope.names.Length is 1
	mutable names = List(Mutable(Text))
	mutable literals = List(Mutable(Text))
	for lines
		if value.StartsWith("constant ") and ConstantText(index) is not ""
			let tokens = Tokenizer(value).Tokens
			names.Add(tokens(1))
			literals.Add(ConstantText(index))
	Scope(names, literals)
UsedTypes Texts
	Measured.UsedTypes is ("Vector2")
	mutable own = MemberScope.names + MethodScope.names
	mutable used = List(Mutable(Text))
	for lines
		let tokens = Tokenizer(value.Trim).Tokens
		if (tokens.Length > 1) and (tokens(0) is "constant")
			own = own + tokens(1)
		else if value.StartsWith("\t") or IsComputed(value)
			used = used + Capitalized(tokens)
	for used
		if (value is not in own) and (used.Index(value) is index)
			value
Capitalized(tokens Texts) Texts
	TypeShape("has a").Capitalized(("Number", ".", "Pi", "+", "x", "*", "Size")) is ("Number", "Size")
	TypeShape("has a").Capitalized(("Shape", "(", "Basic", ",", "Id", "=", "1", ")")) is ("Shape", "Basic")
	for tokens
		let first = value.Substring(0, 1)
		let isNamed = (index > 0) and (tokens(index - 1) is ".") or (index + 1 < tokens.Length) and (tokens(index + 1) is "=")
		if (first is first.Upper) and (first is not first.Lower) and (isNamed is false)
			value
