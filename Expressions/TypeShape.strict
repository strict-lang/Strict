has lines Texts
IsMemberLine(line Text) Boolean
	TypeShape("has a").IsMemberLine("mutable count Number") is true
	TypeShape("has a").IsMemberLine("Run") is false
	line.StartsWith("has ") or line.StartsWith("mutable ") or line.StartsWith("constant ")
IsMethodHeader(line Text) Boolean
	TypeShape("has a").IsMethodHeader("Run Number") is true
	TypeShape("has a").IsMethodHeader("\tlogger.Log(1)") is false
	if (line is "") or line.StartsWith("\t")
		return false
	not IsMemberLine(line)
IsTrait Boolean
	TypeShape("Length Number").IsTrait is true
	TypeShape("has length", "in(element) Boolean").IsTrait is true
	TypeShape("Not Boolean", "\ttrue").IsTrait is false
	for lines
		if value.StartsWith("\t")
			return false
	true
MemberScope Scope
	TypeShape("has count Number", "constant Limit = 3").MemberScope.TypeOf("count") is "Number"
	TypeShape("has count Number", "constant Limit = 3").MemberScope.names.Length is 1
	mutable names = List(Mutable(Text))
	mutable types = List(Mutable(Text))
	for lines
		if IsMemberLine(value) and (not value.StartsWith("constant "))
			let header = HeaderTokens(Tokenizer(value).Tokens)
			names.Add(header.MemberName)
			types.Add(header.DeclaredType(1))
	Scope(names, types)
ParameterScope Scope
	TypeShape("Add(first Number, second Number) Number", "\tfirst").ParameterScope.TypeOf("Add") is "first,second"
	TypeShape("Add(first Number, second) Number", "\tfirst").ParameterScope.TypeOf("Add types") is "Number,Second"
	mutable names = List(Mutable(Text))
	mutable parameters = List(Mutable(Text))
	for lines
		if IsMethodHeader(value)
			let header = HeaderTokens(Tokenizer(value).Tokens)
			names.Add(header.tokens(0))
			parameters.Add(Text.Combine(header.ParameterNames, ","))
			names.Add(header.tokens(0) + " types")
			parameters.Add(Text.Combine(header.ParameterTypes, ","))
	Scope(names, parameters)
UsesGenerics Boolean
	TypeShape("has value Generic").UsesGenerics is true
	TypeShape("has value Generic or None").UsesGenerics is false
	TypeShape("for Iterator(Generic)", "in(element Generic) Boolean").UsesGenerics is true
	TypeShape("constant Names = (\"Generic\")", "Run", "\tNames").UsesGenerics is false
	for lines
		if index < 3 and IsGenericLine(index)
			return true
	false
IsGenericLine(position Number) Boolean
	TypeShape("has count Number").IsGenericLine(0) is false
	let line = lines(position)
	let mentions = line.IndexOf("Generic") is not -1 or line.IndexOf("generic") is not -1
	if line.StartsWith("has ") or line.StartsWith("mutable ")
		let words = line.Split(" ")
		return mentions and (words.Length < 4 or words(2) is not in ("Generic", "generic") or line.IndexOf("(") is not -1)
	let hasBody = position + 1 < lines.Length and lines(position + 1).StartsWith("\t")
	mentions and (line.StartsWith("constant ") is false) and (hasBody is false)
CallScope(generics Texts) Scope
	TypeShape("has iterator", "has Start Number").CallScope(List(Text) + "Iterator").TypeOf("from") is "Start"
	TypeShape("from(number)", "\tvalue").CallScope(List(Text)).TypeOf("from") is "number"
	constant scope = ParameterScope
	if "from" is in scope.names
		return scope
	constant members = MemberScope
	mutable names = List(Mutable(Text))
	for members.names
		if members.types(index) is not in generics and (members.types(index).IndexOf("Generic") is -1)
			names.Add(value)
	scope.With("from", Text.Combine(names, ","))
MethodScope Scope
	TypeShape("constant Limit = 3", "Add(other Number) Number", "\tother").MethodScope.TypeOf("Add") is "Number"
	TypeShape("constant Limit = 3", "Add(other Number) Number", "\tother").MethodScope.TypeOf("Limit") is "Number"
	mutable names = List(Mutable(Text))
	mutable types = List(Mutable(Text))
	for lines
		if value.StartsWith("constant ") or IsMethodHeader(value)
			let header = HeaderTokens(Tokenizer(value).Tokens)
			names.Add(IsMethodHeader(value) then header.tokens(0) else header.MemberName)
			types.Add(IsMethodHeader(value) then header.ReturnType else header.DeclaredType(1))
	Scope(names, types)
EnumValue(position Number) Number
	TypeShape("constant A", "constant B = 10", "constant C").EnumValue(2) is 11
	TypeShape("constant A").EnumValue(0) is 0
	mutable next = 0
	for position
		let tokens = Tokenizer(lines(index)).Tokens
		if (tokens(0) is "constant") and (tokens.Length is 2)
			next = next + 1
		else if (tokens(0) is "constant") and (SyntaxParser(tokens).Leaf(tokens(3)).Kind is "Number")
			next = tokens(3) to Number + 1
	next
ConstantText(position Number) Text
	TypeShape("constant A", "constant B = 10", "constant C").ConstantText(2) is "11"
	TypeShape("constant Limit = 3 * 2").ConstantText(0) is "3 * 2"
	let tokens = Tokenizer(lines(position)).Tokens
	if tokens.Length is 2
		return EnumValue(position) to Text
	let line = lines(position)
	line.Substring(line.IndexOf(" = ") + 3, line.Length - line.IndexOf(" = ") - 3)
ConstantScope Scope
	TypeShape("constant A", "constant B = 10", "constant C").ConstantScope.TypeOf("C") is "11"
	TypeShape("constant Limit = 3 * 2", "has a").ConstantScope.names.Length is 1
	mutable names = List(Mutable(Text))
	mutable literals = List(Mutable(Text))
	for lines
		if value.StartsWith("constant ") and ConstantText(index) is not ""
			let tokens = Tokenizer(value).Tokens
			names.Add(tokens(1))
			literals.Add(ConstantText(index))
	Scope(names, literals)