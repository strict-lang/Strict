has lines Texts
has folder = ""
constant Blurring = Unswitching(Callees.Sums, "ImageProcessing")
constant Nested = Callees.Sums.Slice(0, 3)
constant Checked = "\t\t\tif bitmap.IsInside(pixel, x, y)"
constant LoopVariables = ("value", "outer", "index")
constant Single = Unswitching(("Run", "\tfor Range(-1, 2)", "\t\tif f(value, outer)"), "")
constant Moving = Unswitching(Nested + "\t\tif bitmap.IsInside(pixel, x, y)" + "\t\t\tpixel = pixel + 1", "ImageProcessing")
constant Mixed = Unswitching(("Sums(bitmap Bitmap, pixel Number) Number", "\tmutable sum = 0", "\tfor y, x in 3, Range(-1, 2)", "\t\tif bitmap.IsInside(pixel, x, 0)", "\t\t\tsum = sum + 1", "\tsum"), "ImageProcessing")
Lines Texts
	Blurring.Lines(2) is "\tif " + Text.Combine(Corners(Blurring, 2).Calls, " and ")
	Blurring.Lines(4) is Callees.Sums(4)
	Blurring.Lines(5) is "\telse"
	Blurring.Lines(7) is Checked
	Blurring.Lines.Length is 10
	Unswitching(Fusion.Grays, "ImageProcessing").Lines is Fusion.Grays
	Rewritten(0)
Rewritten(start Number) Texts
	Blurring.Rewritten(3) is Callees.Sums.Slice(3, 3)
	let at = Found(start)
	if at < 0
		return lines.Slice(start, lines.Length - start)
	lines.Slice(start, at - start) + Hoisted(at) + Rewritten(Callees(lines, folder).BlockEnd(at))
Found(start Number) Number
	Blurring.Found(0) is 2
	Blurring.Found(3) is -1
	for Range(start, lines.Length)
		if IsHoistable(value)
			return value
	-1
Hoisted(at Number) Texts
	Blurring.Hoisted(2).Length is 7
	Blurring.Hoisted(2)(1) is "\t\tfor y, x in Range(-1, 2), Range(-1, 2)"
	let tabs = lines(at).Substring(0, Callees(lines, folder).Depth(lines(at)))
	let end = Callees(lines, folder).BlockEnd(at)
	let corners = Text.Combine(Corners(Unswitching(lines, folder), at).Calls, " and ")
	let unchecked = (List(Text) + (tabs + "if " + corners) + ("\t" + lines(at))) + lines.Slice(at + 2, end - at - 2)
	unchecked + (tabs + "else") + Indented(at, end)
Indented(start Number, end Number) Texts
	Blurring.Indented(2, 3) is List(Text) + "\t\tfor y, x in Range(-1, 2), Range(-1, 2)"
	for Range(start, end)
		"\t" + lines(value)
IsHoistable(at Number) Boolean
	Blurring.IsHoistable(2)
	Blurring.IsHoistable(3) is false
	Blurring.IsHoistable(4) is false
	Unswitching(Nested + Checked, "ImageProcessing").IsHoistable(2) is false
	Mixed.IsHoistable(2)
	let callees = Callees(lines, folder)
	let condition = at + 1
	let isLoop = lines(at).TrimStart.StartsWith("for ") and (condition < lines.Length)
	if (isLoop is false) or (lines(condition).TrimStart.StartsWith("if ") is false) or (Names(at).Length is 0)
		return false
	let isBody = (callees.BlockEnd(condition) is callees.BlockEnd(at)) and IsStatements(condition)
	isBody and (callees.Depth(lines(condition)) is callees.Depth(lines(at)) + 1) and IsMonotone(at)
IsStatements(condition Number) Boolean
	Blurring.IsStatements(3)
	Unswitching(Nested + Checked + "\t\t\t\tbitmap.Colors(pixel)", "ImageProcessing").IsStatements(3) is false
	Unswitching(Nested + Checked, "ImageProcessing").IsStatements(3) is false
	Moving.IsStatements(3) is false
	let end = Callees(lines, folder).BlockEnd(condition)
	let checked = Tokenizer(Text.Combine(Arguments(condition - 1))).Tokens
	for Range(condition + 1, end)
		if IsIndependent(Tokenizer(lines(value).TrimStart).Tokens, checked) is false
			return false
	end > condition + 1
IsIndependent(tokens Texts, checked Texts) Boolean
	Blurring.IsIndependent(Tokenizer("sum = sum + 1").Tokens, ("pixel", "x"))
	Blurring.IsIndependent(Tokenizer("let at = pixel").Tokens, ("pixel", "x"))
	Blurring.IsIndependent(Tokenizer("pixel = pixel + 1").Tokens, ("pixel", "x")) is false
	Blurring.IsIndependent(Tokenizer("bitmap.Colors(pixel)").Tokens, ("pixel", "x")) is false
	let isDeclared = tokens.First is in ("let", "mutable")
	let isAssigned = isDeclared or (tokens.Length > 1) and (tokens(1) is "=")
	isAssigned and (Monotone(List(Text) + (isDeclared then tokens(1) else tokens.First)).Mentions(checked) is false)
Names(at Number) Texts
	Blurring.Names(2) is ("y", "x")
	Blurring.Names(3).Length is 0
	Single.Names(1) is ("value")
	Unswitching(List(Text) + "\tfor Range(0, value)", "").Names(0).Length is 0
	Unswitching(List(Text) + "\tfor y, x in Range(0, 2), Range(0, y)", "").Names(0).Length is 0
	Mixed.Names(2) is ("y", "x")
	let parser = StatementParser(Tokenizer(at < lines.Length then lines(at).TrimStart else "").Tokens)
	let names = parser.IsNamed then parser.IteratorNames else List(Text) + "value"
	let iterables = Iterables(at)
	let isFree = Monotone(names + LoopVariables).Mentions(Tokenizer(Text.Combine(iterables)).Tokens) is false
	(iterables.Length is names.Length) and isFree then names else List(Text)
Iterables(at Number) Texts
	Blurring.Iterables(2) is ("Range(-1, 2)", "Range(-1, 2)")
	Single.Iterables(1) is ("Range(-1, 2)")
	Single.Iterables(2).Length is 0
	let line = at < lines.Length then lines(at).TrimStart else ""
	if line.StartsWith("for ") is false
		return List(Text)
	let start = StatementParser(Tokenizer(line).Tokens).IsNamed then line.IndexOf(" in ") + 4 else 4
	Callees(lines, folder).Parts(line.Substring(start, line.Length - start))
Bounds(at Number, position Number) Texts
	Blurring.Bounds(2, 1) is ("-1", "2")
	Blurring.Bounds(1, 0).Length is 0
	Unswitching(List(Text) + "\tfor Range(0, f(1, 2), 3)", "").Bounds(0, 0).Length is 0
	let iterables = Iterables(at)
	let iterable = position < iterables.Length then iterables(position) else ""
	if (iterable.StartsWith("Range(") is false) or (iterable.EndsWith(")") is false)
		return List(Text)
	let parts = Callees(lines, folder).Parts(iterable.Substring(6, iterable.Length - 7))
	parts.Length is 2 then parts else List(Text)
Call(at Number) Texts
	Blurring.Call(3) is ("bitmap", "IsInside", "pixel", "x", "y")
	Blurring.Call(4).Length is 0
	Unswitching(List(Text) + "\tif IsInside(1)", "").Call(0) is ("", "IsInside", "1")
	Unswitching(List(Text) + "\tif f(1).Is(value)", "").Call(0).Length is 0
	let line = lines(at).TrimStart
	let text = line.StartsWith("if ") then line.Substring(3, line.Length - 3) else ""
	let open = text.IndexOf("(")
	if (open < 1) or (text.EndsWith(")") is false) or (Callees(lines, folder).Closing(text, open) is not text.Length - 1)
		return List(Text)
	let dot = text.Substring(0, open).IndexOf(".")
	let named = List(Text) + (dot < 0 then "" else text.Substring(0, dot)) + text.Substring(dot + 1, open - dot - 1)
	named + Callees(lines, folder).Parts(text.Substring(open + 1, text.Length - open - 2))
LoopNames(at Number) Texts
	Blurring.LoopNames(2) is ("x", "y")
	Single.LoopNames(1) is ("value")
	Mixed.LoopNames(2) is ("x")
	let loops = Names(at)
	mutable names = List(Mutable(Text))
	for Arguments(at)
		if (value is in loops) and (value is not in names) and (Bounds(at, loops.Index(value)).Length is 2)
			names.Add(value)
	names
Arguments(at Number) Texts
	Blurring.Arguments(2) is ("pixel", "x", "y")
	Blurring.Arguments(3).Length is 0
	Blurring.Arguments(5).Length is 0
	let call = at + 1 < lines.Length then Call(at + 1) else List(Text)
	call.Length < 2 then List(Text) else call.Slice(2, call.Length - 2)
IsMonotone(at Number) Boolean
	Blurring.IsMonotone(2)
	Unswitching(Nested + "\t\tif bitmap.IsInside(pixel, x, 1)", "ImageProcessing").IsMonotone(2)
	Unswitching(Nested + "\t\tif bitmap.IsInside(pixel, x, index)", "ImageProcessing").IsMonotone(2) is false
	Unswitching(Nested + "\t\tif bitmap.IsOpaque", "ImageProcessing").IsMonotone(2) is false
	let call = Call(at + 1)
	let callee = call.Length < 3 then List(Text) else Callees(lines, folder).Lines(call(0), call(1), at)
	let parameters = callee.Length < 2 then List(Text) else Callees(lines, folder).ParameterNames(callee.First)
	if (callee.Length < 2) or (parameters.Length is not call.Length - 2)
		return false
	let bound = Bound(at, parameters)
	(bound.Length > 0) and Monotone(bound).IsBounded(Monotone(bound).Condition(callee.Slice(1, callee.Length - 1)))
Bound(at Number, parameters Texts) Texts
	Blurring.Bound(2, ("pixel", "x", "y")) is ("x", "y")
	Blurring.Bound(3, ("pixel", "x", "y")).Length is 0
	let names = LoopNames(at)
	let variables = Monotone(Names(at) + LoopVariables)
	mutable bound = List(Mutable(Text))
	for Arguments(at)
		if value is in names
			bound.Add(parameters(index))
		else if variables.Mentions(Tokenizer(value).Tokens)
			return List(Text)
	bound
