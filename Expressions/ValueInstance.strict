has typeName Text
has number
has text
has kind Text
HasValue Boolean
	ValueInstance("None", 0, "", "").HasValue is false
	if typeName is not "None"
		return true
	if number is not 0
		return true
	false
IsText Boolean
	text is not ""
IsList Boolean
	kind is "list"
IsDictionary Boolean
	kind is "dictionary"
IsTypeInstance Boolean
	kind is "type"
to Text
	if IsText
		return "\"" + text + "\""
	if IsList
		return "(list)"
	if IsDictionary
		return "(dictionary)"
	if IsTypeInstance
		return typeName
	number to Text
