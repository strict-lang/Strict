has number
from(generic)
	HashCode(5) is 5
	HashCode("abc") is 96354
	HashCode((1, 2)) is 33
	HashCode(Type("Number", "Strict")) is HashCode(("Number", "Strict"))
	if generic is
		Number then generic
		Character then generic.number
		Iterator then Combined(generic)
		Boolean then (generic then 1 else 0)
		else (generic to HashCode).number
Combined(elements Generic) Number
	HashCode((1, 2)).Combined((3, 4)) is 97
	mutable hash = 0
	for elements
		hash = (hash * 31 + HashCode(value).number) % 4294967296
	hash