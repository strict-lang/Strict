has names Texts
has kinds Texts
has numbers
has texts
Has(name Text) Boolean
	for names
		if value is name
			return true
	false
GetValue(name Text) RuntimeValue
	mutable index = 0
	for names
		if value is name
			return ValueAt(index)
		index = index + 1
	RuntimeValue.None
ValueAt(index Number) RuntimeValue
	ExecutionContext.Empty.SetValue("n", "Number", 4, "").ValueAt(0).number is 4
	let kind = kinds(index)
	if kind is "Number"
		return RuntimeValue("Number", numbers(index), "", false)
	if kind is "Text"
		return RuntimeValue("Text", 0, texts(index), false)
	if kind is "Boolean"
		return RuntimeValue("Boolean", 0, texts(index), texts(index) is "true")
	RuntimeValue.None
SetValue(name Text, kind Text, amount Number, content Text) ExecutionContext
	if Has(name)
		return ExecutionContext(names, kinds, numbers, texts)
	Append(name, kind, amount, content)
Append(name Text, kind Text, amount Number, content Text) ExecutionContext
	ExecutionContext.Empty.Append("a", "Number", 1, "").Append("b", "Text", 0, "x").names.Length is 2
	ExecutionContext(names + name, kinds + kind, numbers + amount, texts + content)
ReturnWith(kind Text, amount Number, content Text) ExecutionContext
	ExecutionContext.Empty.ReturnWith("Number", 1, "").DidReturn is true
	SetValue("__return__", kind, amount, content)
DidReturn Boolean
	Has("__return__")
Empty ExecutionContext
	constant emptyNames = List(Text)
	constant emptyKinds = List(Text)
	constant emptyNumbers = List(Number)
	constant emptyTexts = List(Text)
	ExecutionContext(emptyNames, emptyKinds, emptyNumbers, emptyTexts)
to Text
	"vars=" + names.Length to Text