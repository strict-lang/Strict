EvaluateBinaryText(text Text, context ExecutionContext) RuntimeValue
	let plus = text.IndexOf(" + ")
	if plus is not -1
		return BinaryAt(text, plus, "+", context)
	let minus = text.IndexOf(" - ")
	if minus is not -1
		return BinaryAt(text, minus, "-", context)
	EvaluateCompareText(text, context)
EvaluateCompareText(text Text, context ExecutionContext) RuntimeValue
	let isNot = text.IndexOf(" is not ")
	if isNot is not -1
