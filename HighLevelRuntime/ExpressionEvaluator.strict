	RuntimeValue("Text", 0, text, false)
NotText(text Text, context ExecutionContext) RuntimeValue
	let rest = text.Substring(4, 200).Trim
	callers.EvaluateNot(Evaluate(rest, context))
BinaryAt(text Text, index Number, operatorName Text, context ExecutionContext) RuntimeValue
	let leftText = text.Substring(0, index).Trim
	let left = Evaluate(leftText, context)
	let rightStart = index + operatorName.Length + 2
	let rightText = text.Substring(rightStart, 200).Trim
	let right = Evaluate(rightText, context)
	callers.EvaluateBinary(left, operatorName, right)
