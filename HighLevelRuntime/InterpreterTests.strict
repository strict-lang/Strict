has logger
Run
	constant runtime = Interpreter.Empty
	constant context = ExecutionContext.Empty
	logger.Log(runtime.EvaluateLine("1 + 2", context).Result)
	logger.Log(runtime.EvaluateLine("8 / 2", context).Result)
	constant first = runtime.EvaluateLine("let total = 4 + 1", context)
	logger.Log(first.Result)
	let second = runtime.EvaluateLine("total * 3", first.Frame)
	logger.Log(second.Result)
	let third = runtime.EvaluateLine("total is 5", first.Frame)
	logger.Log(third.Result)