has logger
constant Source = "ImageProcessing/Compare/Landscape.ppm"
constant Target = Source.Replace(".ppm", ".strict.ppm")
constant Radius = 4
constant Square = Bitmap(Size(2, 2), (Color(1, 1, 1), Color(2, 2, 2), Color(3, 3, 3), Color(4, 4, 4)), true)
Run
	let bitmap = Ppm.Loaded(Source)
	if bitmap is Error
		logger.Log("Missing " + Source + ", see ImageProcessing/Compare/README.md")
	else
		let warmup = Blurred(bitmap)
		let started = Process.Elapsed
		let blurred = Blurred(bitmap)
		let milliseconds = ((Process.Elapsed - started) * 1000).Round(1)
		let difference = warmup is blurred then "" else ", the first call differs"
		Ppm.Save(Bitmap(bitmap.Size, blurred, bitmap.IsOpaque), Target)
		logger.Log("Blurred " + bitmap.Size.Width + "x" + bitmap.Size.Height + " in " + milliseconds + " ms" + difference)
Blurred(bitmap Bitmap) Colors
	BenchBlur.Blurred(Bitmap.Tiny)(0) is Color(4, 4, 4)
	for bitmap.Colors
		Neighbors(bitmap, index).Average
Neighbors(bitmap Bitmap, pixel Number) Colors
	BenchBlur.Neighbors(Bitmap.Tiny, 0).Length is 9
	BenchBlur.Neighbors(Square, 3) is Square.Colors
	for y, x in Range(-Radius, Radius + 1), Range(-Radius, Radius + 1)
		if bitmap.IsInside(pixel, x, y)
			bitmap.Colors(pixel + x + y * bitmap.Size.Width)
