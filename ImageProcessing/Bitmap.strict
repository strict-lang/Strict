has Size
has Colors
has IsOpaque Boolean
constant Gray = (Color(0, 0, 0), Color(9, 9, 9))
constant Tiny = Bitmap(Size(3, 3), Gray + Gray + Gray + Gray + Color(0, 0, 0), true)
Center Number
	Tiny.Center is 4
	(Height / 2).Floor * Width + (Width / 2).Floor
IsInside(pixel Number, x Number, y Number) Boolean
	Tiny.IsInside(4, 1, -1)
	Tiny.IsInside(3, -1, 0) is false
	Tiny.IsInside(2, 0, 1)
	Tiny.IsInside(6, 0, 1) is false
	Tiny.IsInside(2, 1, 0) is false and Tiny.IsInside(1, 0, -1) is false and Tiny.IsInside(0, 0, 0)
	column = pixel % Width + x
	row = (pixel / Width).Floor + y
	column >= 0 and column < Width and row >= 0 and row < Height
