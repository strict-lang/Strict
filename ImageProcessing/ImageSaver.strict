has path Text
constant Corner = Image(Size(2, 2), (ColorValue(0, 0, 0), ColorValue(0, 0, 0), ColorValue(0, 0, 0), ColorValue(1, 1, 1)))
constant Saved = "Compiler/output/ImageSaverCorner.png"
Save(image Image)
	Directory.Create("Compiler/output") is not Error
	ImageSaver(Saved).Save(Corner) is not Error
	ImageLoader(Saved).Loaded.Colors is Corner.Colors
	ImageCodec.SavePng(path, Flat(image), image.Size.Width)
Flat(image Image) Numbers
	ImageSaver("").Flat(Image.Blank(Size(1, 1))) is (0, 0, 0, 1)
	ImageSaver("").Flat(Image(Size(1, 1), List(ColorValue) + ColorValue(0.2, 0.4, 0.6, 0.8))) is (0.2, 0.4, 0.6, 0.8)
	for image.Colors.Length * 4
		Channel(image.Colors((index / 4).Floor), index % 4)
Channel(color ColorValue, channel Number) Number
	ImageSaver("").Channel(ColorValue(1, 0.5, 0), 1) is 0.5
	ImageSaver("").Channel(ColorValue(0.2, 0.4, 0.6, 0.8), 3) is 0.8
	let rgb = channel is 0 then color.Red else channel is 1 then color.Green else color.Blue
	channel is 3 then color.Alpha else rgb
