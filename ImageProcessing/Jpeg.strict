Segments(marker Number) Numbers
	(Gray.Segments(Codes) is (102, 124)) and (Gap.Segments(Codes) is (2)) and (Ended.Segments(Codes) is (2))
	Jpeg.Read("ImageProcessing/Progressive.jpg").Segments(Scan).Length is 10
	mutable found = List(Mutable(Number))
