has jpeg Jpeg
has plan Numbers
has samplings Numbers
has tables List(Numbers)
constant Gray = JpegDecoder.From(Jpeg.Gray)
constant Colored = JpegDecoder.From(Jpeg.Colored)
From(image Jpeg) JpegDecoder
	JpegDecoder.From(Jpeg.Gray).plan is List(Number) + 0
	JpegDecoder.From(Jpeg.Colored).samplings is (34, 17, 17)
	let count = image.bytes(image.Segment(Jpeg.Frame) + 9)
	let factors = Component(image, count, 11)
	JpegDecoder(image, Plan(factors), factors, Quantizations(image, count))
Read(path Text) JpegDecoder
	JpegDecoder.Read("ImageProcessing/Progressive.jpg").samplings is (34, 17, 17)
	From(Jpeg.Read(path))
Component(image Jpeg, count Number, offset Number) Numbers
	JpegDecoder.Component(Jpeg.Colored, 3, 10) is (1, 2, 3)
	for count
		image.bytes(image.Segment(Jpeg.Frame) + offset + index * 3)
Plan(factors Numbers) Numbers
	JpegDecoder.Plan((34, 17, 17)) is (0, 0, 0, 0, 1, 2)
	mutable order = List(Mutable(Number))
	for factors
		let component = index
		for (value / 16).Floor * (value % 16)
			order.Add(component)
	order
Quantizations(image Jpeg, count Number) List(Numbers)
	JpegDecoder.Quantizations(Jpeg.Colored, 3).Last.Last is 20
	for Component(image, count, 12)
		image.Quantization(value)
Factor(component Number, isHorizontal Boolean) Number
	Colored.Factor(0, true) is 2
	Colored.Factor(1, false) is 1
	let sampling = samplings(component)
	isHorizontal then (sampling / 16).Floor else sampling % 16
Factors(isHorizontal Boolean) Numbers
	Colored.Factors(true) is (2, 1, 1)
	for samplings
		Factor(index, isHorizontal)
Columns Number
	Colored.Columns is 1
	JpegDecoder.Read("ImageProcessing/Progressive.jpg").Columns is 3
	(jpeg.Width / (8 * Factors(true).Maximum)).Ceiling
Total Number
	Colored.Total is 6
	Gray.Total is 1
	Columns * (jpeg.Height / (8 * Factors(false).Maximum)).Ceiling * plan.Length
Zeros List(Numbers)
	Colored.Zeros.Length is 6
	Gray.Zeros.First.Length is 64
	for Total
		Idct.Flat * 0
Extent(component Number, isHorizontal Boolean) Number
	Colored.Extent(0, true) is 2
	Colored.Extent(1, false) is 1
	let factors = Factors(isHorizontal)
	let length = isHorizontal then jpeg.Width else jpeg.Height
	((length * factors(component) / factors.Maximum).Ceiling / 8).Ceiling
Located(component Number, column Number, row Number, columns Number) Number
	Colored.Located(0, 1, 1, 1) is 3
	Colored.Located(2, 0, 0, 1) is 5
	let horizontal = Factor(component, true)
	let vertical = Factor(component, false)
	let mcu = (row / vertical).Floor * columns + (column / horizontal).Floor
	mcu * plan.Length + plan.Index(component) + (row % vertical) * horizontal + column % horizontal
Blocks List(Numbers)
	Gray.Blocks.Length is 1
	Colored.Blocks.Length is 6
	let decoder = value
	mutable coefficients = Zeros
	for jpeg.Segments(Jpeg.Scan)
		coefficients = JpegScan(decoder, value).Scanned(coefficients)
	for coefficients
		Idct.Dequantized(value, tables(plan(index % plan.Length)))
