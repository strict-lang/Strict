has bytes Numbers
constant ImageData = 1229209940
constant Palette = 1347179589
constant GraySample = Png((137, 80, 78, 71, 13, 10, 26, 10, 0, 0, 0, 13, 73, 72, 68, 82, 0, 0, 0, 3, 0, 0, 0, 2, 8, 0, 0, 0, 0, 184, 31, 57, 198, 0, 0, 0, 16, 73, 68, 65, 84, 120, 218, 99, 228, 226, 226, 98, 145, 19, 145, 3, 0, 1, 116, 0, 116, 205, 241, 126, 133, 0, 0, 0, 0, 73, 69, 78, 68, 174, 66, 96, 130))
constant PaletteSample = Png((137, 80, 78, 71, 13, 10, 26, 10, 0, 0, 0, 13, 73, 72, 68, 82, 0, 0, 0, 4, 0, 0, 0, 2, 1, 3, 0, 0, 0, 69, 102, 239, 32, 0, 0, 0, 6, 80, 76, 84, 69, 0, 0, 0, 255, 255, 255, 165, 217, 159, 221, 0, 0, 0, 12, 73, 68, 65, 84, 120, 218, 99, 72, 96, 152, 0, 0, 1, 180, 0, 241, 102, 13, 212, 149, 0, 0, 0, 0, 73, 69, 78, 68, 174, 66, 96, 130))
Read(path Text) Png
	Png.Read("ImageProcessing/4x4.png").Width is 4
	Png(File(path).ReadBytes)
Width Number
	GraySample.Width is 3
	Number32(16)
Height Number
	GraySample.Height is 2
	Number32(20)
Channels Number
	GraySample.Channels is 1
	let kind = bytes(25)
	kind is 2 then 3 else kind is 4 then 2 else kind is 6 then 4 else 1
Stride Number
	PaletteSample.Stride is 1
	((Width * Channels * bytes(24) + 7) / 8).Floor
Step Number
	GraySample.Step is 1
	let bytesPerPixel = (Channels * bytes(24) / 8).Floor
	bytesPerPixel < 1 then 1 else bytesPerPixel
Number32(position Number) Number
	GraySample.Number32(8) is 13
	((bytes(position) * 256 + bytes(position + 1)) * 256 + bytes(position + 2)) * 256 + bytes(position + 3)
Chunk(type Number) Numbers
	PaletteSample.Chunk(Palette) is (0, 0, 0, 255, 255, 255)
	mutable data = List(Mutable(Number))
	mutable position = 8
	for bytes.Length
		if position + 8 > bytes.Length
			return data
		if Number32(position + 4) is type
			data = data + Inflate.Part(bytes, position + 8, Number32(position))
		position = position + 12 + Number32(position)
	data
Raw Numbers
	GraySample.Raw.Length is 8
	let compressed = Chunk(ImageData)
	Inflate(Inflate.Part(compressed, 2, compressed.Length - 2)).Inflated
Unfiltered(raw Numbers) Numbers
	GraySample.Unfiltered(GraySample.Raw) is (10, 20, 30, 40, 60, 90)
	let stride = Stride
	let step = Step
	mutable result = List(Mutable(Number))
	for Height * stride
		let row = (index / stride).Floor
		let column = index % stride
		let left = column >= step then result(index - step) else 0
		let up = row > 0 then result(index - stride) else 0
		let corner = (column >= step) and (row > 0) then result(index - stride - step) else 0
		result = result + Filtered(raw(row * (stride + 1)), raw(row * (stride + 1) + 1 + column), left, up, corner)
	result
Filtered(kind Number, filtered Number, left Number, up Number, corner Number) Number
	GraySample.Filtered(4, 5, 10, 20, 15) is 20
	if kind is 1
		return (filtered + left) % 256
	if kind is 2
		return (filtered + up) % 256
	if kind is 3
		return (filtered + ((left + up) / 2).Floor) % 256
	kind is 4 then (filtered + Paeth(left, up, corner)) % 256 else filtered
Paeth(left Number, up Number, corner Number) Number
	GraySample.Paeth(10, 20, 15) is 15
	let estimate = left + up - corner
	let toLeft = (estimate - left).Absolute
	let toUp = (estimate - up).Absolute
	let toCorner = (estimate - corner).Absolute
	(toLeft <= toUp) and (toLeft <= toCorner) then left else toUp <= toCorner then up else corner
Samples(lines Numbers) Numbers
	PaletteSample.Samples((96, 144)) is (0, 1, 1, 0, 1, 0, 0, 1)
	let depth = bytes(24)
	let perRow = Width * Channels
	for Height * perRow
		let bit = (index % perRow) * depth
		let byte = lines((index / perRow).Floor * Stride + (bit / 8).Floor)
		depth >= 8 then byte else (byte / 2 ^ (8 - depth - bit % 8)).Floor % 2 ^ depth
Grays Numbers
	GraySample.Grays.First is 10 / 255
	PaletteSample.Grays is (0, 1, 1, 0, 1, 0, 0, 1)
	let samples = Samples(Unfiltered(Raw))
	let palette = Chunk(Palette)
	for Width * Height
		Gray(samples, palette, index)
Gray(samples Numbers, palette Numbers, pixel Number) Number
	GraySample.Gray(List(Number) + 255, List(Number), 0) is 1
	let channels = Channels
	let first = samples(pixel * channels)
	if bytes(25) is 3
		return (palette(first * 3) * 299 + palette(first * 3 + 1) * 587 + palette(first * 3 + 2) * 114) / 255000
	if (bytes(25) is 2) or (bytes(25) is 6)
		return (first * 299 + samples(pixel * channels + 1) * 587 + samples(pixel * channels + 2) * 114) / 255000
	first / (bytes(24) >= 8 then 255 else 2 ^ bytes(24) - 1)
