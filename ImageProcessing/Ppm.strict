constant Sample = (80, 54, 10, 50, 32, 49, 10, 50, 53, 53, 10, 1, 2, 3, 4, 5, 6)
Loaded(path Text) Bitmap
	Ppm.Loaded("ImageProcessing/Missing.ppm").Pixels.Length is 0
	File(path).Exists then Decoded(File(path).ReadBytes) else Bitmap(0, 0, Bytes, true)
Decoded(bytes Bytes) Bitmap
	Ppm.Decoded(Sample).Pixels is (1, 2, 3, 255, 4, 5, 6, 255)
	Ppm.Decoded(Sample).height is 1
	let width = Field(bytes, 1)
	let height = Field(bytes, 2)
	Bitmap(width, height, Rgba(bytes, Start(bytes), width * height), true)
Rgba(bytes Bytes, start Number, count Number) Bytes
	Ppm.Rgba(Sample, 11, 2) is (1, 2, 3, 255, 4, 5, 6, 255)
	for count * 4
		index % 4 is 3 then 255 else bytes(start + (index / 4).Floor * 3 + index % 4)
Save(bitmap Bitmap, path Text)
	File(path).Write(Encoded(bitmap))
Encoded(bitmap Bitmap) Bytes
	Ppm.Encoded(Ppm.Decoded(Sample)) is Sample
	let header = (80, 54, 10) + Digits(bitmap.width) + 32 + Digits(bitmap.height) + (10, 50, 53, 53, 10)
	let rgb = Rgb(bitmap.Pixels)
	for header.Length + rgb.Length
		index < header.Length then header(index) else rgb(index - header.Length)
Rgb(pixels Bytes) Bytes
	Ppm.Rgb((1, 2, 3, 255, 4, 5, 6, 255)) is (1, 2, 3, 4, 5, 6)
	for pixels.Length / 4 * 3
		pixels((index / 3).Floor * 4 + index % 3)
Field(bytes Bytes, number Number) Number
	Ppm.Field(Sample, 1) is 2
	Ppm.Field(Sample, 3) is 255
	mutable token = 0
	mutable result = 0
	mutable wasSpace = false
	for Range(2, Start(bytes))
		let isSpace = bytes(value) is in (9, 10, 13, 32)
		token = wasSpace and (isSpace is false) then token + 1 else token
		result = (token is number) and (isSpace is false) then result * 10 + bytes(value) - 48 else result
		wasSpace = isSpace
	result
Start(bytes Bytes) Number
	Ppm.Start(Sample) is 11
	mutable token = 0
	mutable wasSpace = false
	for Range(2, bytes.Length)
		let isSpace = bytes(value) is in (9, 10, 13, 32)
		if isSpace and (wasSpace is false) and (token is 3)
			return value + 1
		token = wasSpace and (isSpace is false) then token + 1 else token
		wasSpace = isSpace
	bytes.Length
Digits(number Number) Numbers
	Ppm.Digits(4096) is (52, 48, 57, 54)
	Ppm.Digits(7) is (55)
	for 7
		if ((number / 10 ^ (6 - index)).Floor > 0) or (index is 6)
			48 + (number / 10 ^ (6 - index)).Floor % 10
