has logger
Run(path)
	let loader = ImageLoader(path)
	let image = AdjustBrightness(0.25).Process(Image(Size(loader.Width, loader.Height), loader.Colors))
	let outputPath = path.RemoveExtension + "_output.jpg"
	ImageSaver.Save(outputPath, image.Colors, image.Size.Width, image.Size.Height)
	logger.Log("Processed image saved to: " + outputPath)