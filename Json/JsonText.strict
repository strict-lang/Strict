has raw Text
constant Escaped = JsonText("a\\\"b\\u0041\\u00e9\\ud83d\\ude00\\n")
constant HexDigits = "0123456789abcdef"
constant HighSurrogate = 55296
constant LowSurrogate = 56320
constant SurrogateValues = 1024
constant SupplementaryStart = 65536
constant AsciiLimit = 128
constant TwoByteLimit = 2048
constant ContinuationMark = 128
constant PayloadBase = 64
constant Controls = ("\n", "\t", "\r", Character(8) to Text, Character(12) to Text)
Unescaped Text
	JsonText("plain").Unescaped is "plain"
	Escaped.Unescaped is "a\"bAé😀\n"
	mutable result = ""
	mutable at = 0
	for as long as at < raw.Length
		let slash = raw.IndexOf("\\", at)
		let stop = slash < 0 then raw.Length else slash
		result = result + raw.Substring(at, stop - at) + (slash < 0 then "" else Escape(slash + 1))
		at = slash < 0 then raw.Length else slash + Step(slash + 1)
	result
Step(position Number) Number
	Escaped.Step(2) is 2
	Escaped.Step(5) is 6
	Escaped.Step(17) is 12
	constant PairEscapeLength = 12
	raw(position) is not "u" then 2 else IsPair(position) then PairEscapeLength else 6
Escape(position Number) Text
	Escaped.Escape(2) is "\""
	Escaped.Escape(29) is "\n"
	Escaped.Escape(17) is "😀"
	let code = raw(position) to Text
	let high = Hex(position + 1)
	if code is "u"
		let offset = (high - HighSurrogate) * SurrogateValues - LowSurrogate
		return Utf8(IsPair(position) then SupplementaryStart + offset + Hex(position + 7) else high)
	let found = "ntrbf".IndexOf(code)
	found < 0 then code else Controls(found)
IsPair(position Number) Boolean
	Escaped.IsPair(17)
	Escaped.IsPair(11) is false
	let high = Hex(position + 1)
	(high >= HighSurrogate) and (high < LowSurrogate) and raw.StartsWith("\\u", position + 5)
Hex(position Number) Number
	Escaped.Hex(6) is 65
	JsonText("D83d").Hex(0) is 55357
	mutable number = 0
	for Range(position, position + 4)
		number = number * HexDigits.Length + HexDigits.IndexOf(raw(value).Lower)
	number
Utf8(code Number) Text
	Escaped.Utf8(65) is "A"
	Escaped.Utf8(233) is "é"
	Escaped.Utf8(8364) is "€"
	Escaped.Utf8(128512) is "😀"
	if code < AsciiLimit
		return Character(code) to Text
	let count = code < TwoByteLimit then 2 else code < SupplementaryStart then 3 else 4
	mutable text = Character((Byte.Values - 2 ^ (8 - count)) + (code / PayloadBase ^ (count - 1)).Floor) to Text
	for Range(1, count)
		text = text + (Character(ContinuationMark + (code / PayloadBase ^ (count - 1 - value)).Floor % PayloadBase) to Text)
	text
