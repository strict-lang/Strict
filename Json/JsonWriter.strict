has text
has isSpaced Boolean = false
constant Object = JsonWriter("{}")
constant Array = JsonWriter("[]")
constant SpacedObject = JsonWriter("{}", true)
constant SpacedArray = JsonWriter("[]", true)
With(name Text, content Text) JsonWriter
	Object.With("asset", "BTC").text is "{\"asset\":\"BTC\"}"
	Object.With("a", "x").With("b", "y").text is "{\"a\":\"x\",\"b\":\"y\"}"
	SpacedObject.With("a", "x").With("b", SpacedArray.With(1).With(2)).text is "{\"a\": \"x\", \"b\": [1, 2]}"
	Added(Quote(name) + Colon + Quote(content))
With(name Text, number Number) JsonWriter
	Object.With("free", 1.5).With("locked", 0).text is "{\"free\":1.5,\"locked\":0}"
	Added(Quote(name) + Colon + number)
With(name Text, flag Boolean) JsonWriter
	Object.With("open", true).With("closed", false).text is "{\"open\":true,\"closed\":false}"
	Added(Quote(name) + Colon + (flag then "true" else "false"))
With(name Text, nested JsonWriter) JsonWriter
	Object.With("prices", Array.With(1).With(2)).text is "{\"prices\":[1,2]}"
	Added(Quote(name) + Colon + nested.text)
With(content Text) JsonWriter
	Array.With("a").With("b").text is "[\"a\",\"b\"]"
	Added(Quote(content))
With(number Number) JsonWriter
	Array.With(3).text is "[3]"
	Added(number to Text)
With(nested JsonWriter) JsonWriter
	Array.With(Object.With("a", 1)).With(Array).text is "[{\"a\":1},[]]"
	Added(nested.text)
Quote(content Text) Text
	Object.Quote("plain") is "\"plain\""
	Object.Quote("say \"hi\" \\ bye") is "\"say \\\"hi\\\" \\\\ bye\""
	Object.Quote("at\tline\r\n") is "\"at\\tline\\r\\n\""
	Object.Quote(Character(1) + Character(31)) is "\"\\u0001\\u001f\""
	Object.Quote(Character(8) + Character(12)) is "\"\\b\\f\""
	Object.Quote(JsonText.Escaped.Utf8(228)).Bytes is (34, 195, 164, 34)
	Json(Object.Quote("a\tb\"c")) to Text is "a\tb\"c"
	mutable quoted = "\""
	for content
		quoted = quoted + Escape(value)
	quoted + "\""
Added(entry Text) JsonWriter
	Object.Added("\"a\":1").Added("\"b\":2").text is "{\"a\":1,\"b\":2}"
	separator = text.Length > 2 then (isSpaced then ", " else ",") else ""
	JsonWriter(text.Substring(0, text.Length - 1) + separator + entry + text(text.Length - 1), isSpaced)
Colon Text
	Object.Colon is ":" and SpacedObject.Colon is ": "
	isSpaced then ": " else ":"
Escape(character Character) Text
	Object.Escape(Character(9)) is "\\t"
	Object.Escape(Character(1)) is "\\u0001"
	Object.Escape(Character("\\")) is "\\\\"
	if character is "\"" or character is "\\"
		return "\\" + character
	if character.number >= Character.Space
		return character to Text
	named = JsonText.Controls.Index(character to Text)
	if named >= 0
		return "\\" + "ntrbf".characters(named)
	constant hex = JsonText.HexDigits
	"\\u00" + hex.characters((character.number / hex.Length).Floor) + hex.characters(character.number % hex.Length)