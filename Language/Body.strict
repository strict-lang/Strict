has Lines Texts
has Start Number
has Length Number
BodyLines Texts
	for Range(Start, Start + Length)
		Lines(index)
Expressions ConcreteExpressions
	for BodyLines
		ParseLine(value)
ParseLine(line Text) ConcreteExpression
	let trimmed = line.Trim
	ConcreteExpression(Expression(ExpressionKind(trimmed), Start, false), trimmed)
ExpressionKind(line Text) Text
	ExpressionKind("return value") is "Return"
	ExpressionKind("if count > 0") is "If"
	ExpressionKind("for items") is "For"
	ExpressionKind("let total = 0") is "Declaration"
	KeywordExpressionKind(line)
KeywordExpressionKind(line Text) Text
	KeywordExpressionKind("return value") is "Return"
	if line.StartsWith("return ")
		return "Return"
	if line.StartsWith("if ")
		return "If"
	if line.StartsWith("for ")
		return "For"
	if line.StartsWith("let ")
		return "Declaration"
	TailExpressionKind(line)
TailExpressionKind(line Text) Text
	TailExpressionKind("value.ToText") is "MethodCall"
	TailExpressionKind("total = total + value") is "Reassignment"
	TailExpressionKind("count is 0") is "Binary"
	if line.IndexOf(" = ") is not -1
		return "Reassignment"
	if line.IndexOf(".") is not -1
		return "MethodCall"
	if line.IndexOf(" is ") is not -1
		return "Binary"
	"Expression"
