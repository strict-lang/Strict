has text
IsAssignment Boolean
	ExpressionParser("let count = 1").IsAssignment is true
	ExpressionParser("count = 1").IsAssignment is false
	text.StartsWith("let ") or text.StartsWith("mutable ") or text.StartsWith("constant ")
IsArithmeticExpression Boolean
	ExpressionParser("a + b").IsArithmeticExpression is true
	text.IndexOf(" + ") > 0
IsComparisonExpression Boolean
	ExpressionParser("a is b").IsComparisonExpression is true
	text.IndexOf(" is ") > 0
IsReassignment Boolean
	ExpressionParser("count = 1").IsReassignment is true
	ExpressionParser("let count = 1").IsReassignment is true
	text.IndexOf(" = ") > 0
