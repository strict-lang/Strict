has Name
has Type
has Kind Text
has InitialValue Text
IsMutable Boolean
	Kind is "mutable"
IsConstant Boolean
	Kind is "constant"
IsPublic Boolean
	Name.StartsWith("A")
to Text
	Kind + " " + Name
Parse(line Text, containingType Name) Member
	Parse("has Age Number", "Person").Name is "Age"
	let kind = ExtractKind(line)
	let text = line.Substring(KeywordLength(kind), line.Length - KeywordLength(kind)).Trim
	let memberName = ExtractName(text) to Name
	if memberName is containingType
		return Error("Member name must not start with type name " + containingType)
	let typeName = ExtractTypeName(text, memberName)
	let memberType = typeName to Type
	Member(memberName, memberType, kind, ExtractInitialValue(text))
ExtractKind(line Text) Text
	ExtractKind("mutable Name Text") is "mutable"
	if line.StartsWith("mutable" + " ")
		return "mutable"
	if line.StartsWith("constant" + " ")
		return "constant"
	"has"
KeywordLength(kind Text) Number
	kind.Length + 1
ExtractName(text Text) Text
	let spaceIndex = text.IndexOf(" ")
	let equalsIndex = text.IndexOf("=")
	let endIndex = FirstPositiveIndex(spaceIndex, equalsIndex)
	endIndex is -1 then text else text.Substring(0, endIndex).Trim
FirstPositiveIndex(first Number, second Number) Number
	FirstPositiveIndex(-1, 4) is 4
	if first is -1
		return second
	if second is -1
		return first
	if first < second
		return first
	second
ExtractTypeName(text Text, memberName Text) Text
	ExtractTypeName("Age Number", "Age") is "Number"
	ExtractTypeName("Age", "Age") is "Age"
	ExtractTypeName("Age = 5", "Age") is "Age"
	let rest = text.Substring(memberName.Length, text.Length - memberName.Length).Trim
	if (rest is "") or rest.StartsWith("=")
		return TypeNameFromMemberName(memberName)
	ExplicitTypeFromRest(rest, memberName)
ExplicitTypeFromRest(rest Text, memberName Text) Text
	ExplicitTypeFromRest("Number", "Age") is "Number"
	ExplicitTypeFromRest("Number = 5", "Age") is "Number"
	let endIndex = FirstPositiveIndex(rest.IndexOf(" "), rest.IndexOf("="))
	if endIndex is -1
		return rest
	let typePart = rest.Substring(0, endIndex).Trim
	if typePart is ""
		return TypeNameFromMemberName(memberName)
	typePart
TypeNameFromMemberName(memberName Text) Text
	TypeNameFromMemberName("lines") is "Line"
	if memberName.Substring(memberName.Length - 1, 1) is "s"
		return memberName.Substring(0, memberName.Length - 1).Capitalize
	memberName.Capitalize
ExtractInitialValue(text Text) Text
	let equalsIndex = text.IndexOf("= ")
	if equalsIndex is -1
		return ""
	text.Substring(equalsIndex + 2, text.Length - equalsIndex - 2).Trim