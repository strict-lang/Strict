has Name
has Type
has IsMutable Boolean
has DefaultValue Text
HasDefault Boolean
	DefaultValue is not ""
to Text
	Name + " " + Type
Parse(text Text) Parameter
	let trimmed = text.Trim
	let isMutable = trimmed.StartsWith("mutable" + " ")
	let withoutMutable = WithoutMutableKeyword(trimmed, isMutable)
	let equalsIndex = withoutMutable.IndexOf(" = ")
	let beforeDefault = equalsIndex is -1 then withoutMutable else withoutMutable.Substring(0, equalsIndex)
	let parts = beforeDefault.Split(" ")
	let typeName = parts.Length > 1 then parts.Last else "Any"
	let name = parts.First to Name
	let parameterType = typeName to Type
	let defaultValue = ExtractDefaultValue(withoutMutable, equalsIndex)
	Parameter(name, parameterType, isMutable, defaultValue)
WithoutMutableKeyword(text Text, isMutable Boolean) Text
	WithoutMutableKeyword("name Text", false) is "name Text"
	WithoutMutableKeyword("mutable name Text", true) is "name Text"
	if not isMutable
		return text
	constant start = "mutable".Length + 1
	text.Substring(start, text.Length - start)
ExtractDefaultValue(text Text, equalsIndex Number) Text
	ExtractDefaultValue("name Text", -1) is ""
	ExtractDefaultValue("name Text = hi", 9) is "hi"
	if equalsIndex is -1
		return ""
	text.Substring(equalsIndex + 3, text.Length - equalsIndex - 3)
