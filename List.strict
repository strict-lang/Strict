has iterator
has elements Generics
to Text
	(1, 2) to Text is "(1, 2)"
	Text.Combine(value).ToBrackets
Code Text
	(1, 2).Code is "(1, 2)"
	("a", "b").Code is "(\"a\", \"b\")"
	mutable codes = List(Mutable(Text))
	for elements
		codes.Add(value.Code)
	"(" + Text.Combine(codes) + ")"
for Iterator
	elements
Length Number
	(1, 2).Length is 2
	for elements
		1
is(other) Boolean
	(1, 2) is (1, 2)
	(1, 2, 3) is not (1, 2)
	elements is other.elements
+(other) List
	(1, 2, 3) + (4, 5) is (1, 2, 3, 4, 5)
	("Hello", "World") + (1, 2) is ("Hello", "World", "1", "2")
	("1", "2") + (3, 4) is ("1", "2", "3", "4")
	("1", "2") to Numbers + (3, 4) is (1, 2, 3, 4)
	("3", "4") + (1, 2) to Text is ("3", "4", "(1, 2)")
	("3", "4") + (1, 2) to Texts is ("3", "4", "1", "2")
	(1 + 2) * 3 is not 1 + 2 * 3
	(("1", "2") + (3, 4)) to Numbers is (1, 2, 3, 4)
	3 + (4) is (3, 4)
	(1) + ("Hi") is Error("Cannot downcast Text to Number for list: Text \"Hi\"")
	elements + other.elements
-(other) List
	(1, 2, 3) - (3) is (1, 2)
	((Range(0, 1), Range(2, 3)) - (Range(0, 1))).Length is 1
	elements - other.elements
/(other) List
	(2, 4, 6) / (2) is (1, 2, 3)
	(1, 2) / (2, 4) is (0.5, 0.5)
	(1) / (20, 10) is (0.05, 0.1)
	elements / other.elements
*(other) List
	(1, 2) * (3, 5) is (3, 10)
	constant listsHaveDifferentDimensions = Error
	(1) * (1, 2) is listsHaveDifferentDimensions
	if Length is not other.Length
		listsHaveDifferentDimensions
	elements * other.elements
+(generic) List
	(1, 2, 3) + 4 is (1, 2, 3, 4)
	("Hello", "World") + 5 is ("Hello", "World", "5")
	elements + generic
-(generic) List
	(1, 2, 3) - 3 is (1, 2)
	(1, 2, 3) - 4 is (1, 2, 3)
	((Range(0, 1), Range(2, 3)) - Range(0, 1)).Length is 1
	elements - generic
*(generic) List
	(1, 2) * 3 is (3, 6)
	elements * generic
/(generic) List
	(2, 4, 6) / 2 is (1, 2, 3)
	(20, 10) / 2 is (10, 5)
	elements / generic
Sum Generic
	(1, 2, 3).Sum is 6
	for elements
		value
Maximum Generic
	(1, 3, 2).Maximum is 3
	mutable maximum = First
	for elements
		if value > maximum
			maximum = value
	maximum
Minimum Generic
	(2, 1, 3).Minimum is 1
	mutable minimum = First
	for elements
		if value < minimum
			minimum = value
	minimum
X Generic
	(1, 2, 3).X is 1
	Numbers.X is Error
	elements(0)
Y Generic
	(1, 2).Y is 2
	(1).Y is Error
	elements(1)
Z Generic
	(1, 2, 3).Z is 3
	(1, 2).Z is Error
	elements(2)
W Generic
	(1, 2, 3, 4).W is 4
	(1, 2, 3).W is Error
	elements(3)
First Generic
	(1, 2, 3).First is 1
	elements(0)
Last Generic
	(1, 2, 3).Last is 3
	elements(-1)
Key Generic
	("A", "Apple").Key is "A"
	elements(0)
Value Generic
	("A", "Apple").Value is "Apple"
	elements(1)
in(other Generic) Boolean
	3 is in (1, 2, 3)
	3 is not in (1, 2)
	5 is not in (1, 8)
	5 is in (11, 7, 5, 3, 2)
	"b" is in ("a", "b", "c")
	"d" is not in ("a", "b", "c")
	for elements
		value is other
Index(other Generic) Number
	(1, 2, 3).Index(2) is 1
	(1, 2, 3).Index(9) is -1
	(Range(0, 1), Range(2, 3)).Index(Range(2, 3)) is 1
	for elements
		if value is other
			return index
	-1
Add(element Generic) Mutable(List)
	(1, 2).Add(3) is (1, 2, 3)
	("a", "b").Add("c") is ("a", "b", "c")
	value = value + element
Remove(element Generic) Mutable(List)
	(1, 2, 3).Remove(2) is (1, 3)
	(Range(0, 1), Range(2, 3)).Remove(Range(0, 1)).Length is 1
	value = value - element
Count(searchFor Generic) Number
	(1, 2).Count(1) is 1
	(1, 3).Count(2) is 0
	("Hi", "Hello", "Hi").Count("Hi") is 2
	(Range(0, 1), Range(2, 3)).Count(Range(2, 3)) is 1
	for elements
		if value is searchFor
			1
Reverse List
	(1, 2, 3).Reverse is (3, 2, 1)
	(5, 10, 5).Reverse is (5, 10, 5)
	for Range(0, Length).Reverse
		elements(value)
Slice(start Number, count Number) List
	(1, 2, 3, 4).Slice(1, 2) is (2, 3)
	(1, 2).Slice(2, 0) is List(Number)
	for Range(start, start + count)
		elements(value)
Insert(position Number, element Generic) List
	(1, 3).Insert(1, 2) is (1, 2, 3)
	(1, 2).Insert(2, 3) is (1, 2, 3)
	elements.Slice(0, position) + element + elements.Slice(position, Length - position)
Unique List
	(1, 2, 1, 3, 2).Unique is (1, 2, 3)
	mutable seen = Dictionary(Generic, Boolean)
	for elements
		if value is not in seen
			seen.Add(value, true)
			value
Sorted List
	(3, 1, 2).Sorted is (1, 2, 3)
	(2, 1, 2, 0).Sorted is (0, 1, 2, 2)
	(1).Sorted is (1)
	("b", "c", "a").Sorted is ("a", "b", "c")
	if Length < 2
		return elements
	let half = (Length / 2).Floor
	elements.Slice(0, half).Sorted.Merged(elements.Slice(half, Length - half).Sorted)
Merged(other) List
	(1, 3, 5).Merged((2, 4)) is (1, 2, 3, 4, 5)
	(2).Merged((1, 2)) is (1, 2, 2)
	mutable merged = elements.Slice(0, 0)
	mutable left = 0
	mutable right = 0
	for Range(0, Length + other.elements.Length)
		let isDone = right >= other.elements.Length
		let isLeft = isDone or ((left < elements.Length) and ((other.elements(right) < elements(left)) is false))
		merged = merged + (isLeft then elements(left) else other.elements(right))
		left = isLeft then left + 1 else left
		right = isLeft then right else right + 1
	merged
Average Generic
	(1, 2, 6).Average is 3
	Sum / Length
Median Number
	(3, 1, 2).Median is 2
	(4, 1, 3, 2).Median is 2.5
	let sorted = Sorted
	let middle = (Length / 2).Floor
	Length % 2 is 1 then sorted(middle) else (sorted(middle - 1) + sorted(middle)) / 2
Normalized List
	(2, 4, 6).Normalized is (0, 0.5, 1)
	(5, 5).Normalized is (0, 0)
	let lowest = Minimum
	let range = Maximum - lowest
	for elements
		range is 0 then 0 else (value - lowest) / range
IndexOfMaximum Number
	(1, 3, 2).IndexOfMaximum is 1
	(3, 3).IndexOfMaximum is 0
	mutable best = 0
	for elements
		if value > elements(best)
			best = index
	best
IndexOfMinimum Number
	(2, 1, 3).IndexOfMinimum is 1
	mutable best = 0
	for elements
		if value < elements(best)
			best = index
	best
Pick(random PseudoRandom) Generic
	(10, 20, 30).Pick(PseudoRandom.Seeded(1).Next) is 20
	elements(random.Uint % elements.Length)
Shuffled(random PseudoRandom) List
	(1, 2, 3, 4).Shuffled(PseudoRandom.Seeded(1).Next) is (3, 2, 4, 1)
	(1, 2, 3, 4).Shuffled(PseudoRandom.Seeded(1).Next).Sum is 10
	List(Number).Shuffled(PseudoRandom.Seeded(1)) is List(Number)
	mutable shuffled = elements
	mutable generator = random
	for Range(0, (elements.Length - 1).Clamp(0, elements.Length))
		generator = generator.Next
		let other = value + generator.Uint % (elements.Length - value)
		let kept = shuffled(value)
		shuffled(value) = shuffled(other)
		shuffled(other) = kept
	shuffled
SwapRemoved(position Number) List
	(1, 2, 3, 4).SwapRemoved(1) is (1, 4, 3)
	(1, 2, 3).SwapRemoved(2) is (1, 2)
	mutable swapped = elements
	swapped(position) = elements.Last
	swapped.Slice(0, elements.Length - 1)
