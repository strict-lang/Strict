	for order
		elements(value)
Order Numbers
	(3, 1, 2).Order is (1, 2, 0)
	(1, 0, 1).Order is (1, 0, 2)
	(5).Order is (0)
	mutable order = List(Number)
	for elements
		order = order + index
	mutable width = 1
	for as long as width < Length
		order = MergedRuns(order, width)
		width = width * 2
	order
MergedRuns(order Numbers, width Number) Numbers
	(3, 1, 2).MergedRuns((0, 1, 2), 1) is (1, 0, 2)
	(1, 3, 2, 4, 0).MergedRuns((0, 1, 2, 3, 4), 2) is (0, 2, 1, 3, 4)
	mutable left = 0
	mutable right = width
	for Length
		isLeft = IsLeftNext(order, left, right, index - index % (width * 2), width)
		item = isLeft then order(left) else order(right)
		isPairDone = (index + 1) % (width * 2) is 0
		left = isPairDone then index + 1 else (isLeft then left + 1 else left)
		right = isPairDone then index + 1 + width else (isLeft then right else right + 1)
		item
IsLeftNext(order Numbers, left Number, right Number, start Number, width Number) Boolean
	(2, 1).IsLeftNext((0, 1), 0, 1, 0, 1) is false
	(1, 1).IsLeftNext((0, 1), 0, 1, 0, 1)
	(1, 2).IsLeftNext((0, 1), 1, 2, 0, 1)
	(3, 2, 1).IsLeftNext((0, 1, 2), 0, 1, 0, 2) is false
	end = start + width * 2
	right >= end or right >= Length or left < start + width and elements(order(right)) < elements(order(left)) is false
