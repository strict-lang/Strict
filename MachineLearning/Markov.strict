has text Text
has order Number
constant Sample = Markov("abcabd", 2)
Count(context Text) Number
	Sample.Count("ab") is 2
	Sample.Count("bd") is 0
	Sample.Count("xy") is 0
	Position(context, text.Length)
Position(context Text, wanted Number) Number
	Sample.Position("ab", 1) is 3
	Sample.Position("ab", 6) is 2 and Sample.Position("ab", 5) is -1 and Sample.Position("ab", 9) is 2
	mutable found = 0
	mutable start = text.IndexOf(context)
	for text.Length
		if start < 0 or start + context.Length is text.Length
			return wanted >= text.Length then found else Number.NotFound
		if found is wanted
			return start
		found = found + 1
		start = text.IndexOf(context, start + 1)
	Number.NotFound
Next(context Text) Text
	Sample.Next("bc") is "a"
	Sample.Next("bd") is ""
	Sample.Next("ca") is "b"
	count = Count(context)
	count is 0 then "" else text(Position(context, count.Random.Floor) + context.Length) to Text
Generate(start Text, length Number) Text
	Sample.Generate("bc", 1) is "bca"
	Sample.Generate("bd", 5) is "bd"
	mutable generated = start
	for length
		generated = generated + Next(generated.Substring(generated.Length - order, order))
	generated