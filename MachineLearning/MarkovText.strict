has logger
has evaluation NeuralNetworks/Evaluation
constant Address = "https://raw.githubusercontent.com/karpathy/char-rnn/master/data/tinyshakespeare/input.txt"
constant Downloaded = "MachineLearning/shakespeare.txt"
constant Characters = 200000
constant Order = 5
Run
	let text = evaluation.Downloaded(Downloaded, Address).Substring(0, Characters)
	let started = Process.Elapsed
	let generated = Markov(text, Order).Generated(text.Substring(0, Order), 400)
	let milliseconds = ((Process.Elapsed - started) * 1000).Round(1)
	logger.Log("Order " + Order + " chain over " + Characters + " characters of Shakespeare in " + milliseconds + " ms:")
	logger.Log(generated)