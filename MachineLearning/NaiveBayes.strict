has means List(Numbers)
has variances List(Numbers)
has priors Numbers
constant Tiny = 0.000000001
constant Points = ((0, 0), (0, 1), (1, 1), (5, 5), (5, 6))
constant Kinds = (0, 0, 0, 1, 1)
Trained(samples List(Numbers), labels Numbers) NaiveBayes
	NaiveBayes.Trained(Points, Kinds).priors is (0.6, 0.4)
	NaiveBayes.Trained(Points, Kinds).means.Last is (5, 5.5)
	mutable centers = List(Mutable(Numbers))
	mutable spreads = List(Mutable(Numbers))
	mutable shares = List(Mutable(Number))
	for labels.Maximum + 1
		let members = Members(samples, labels, index)
		centers.Add(Mean(members))
		spreads.Add(Variance(members, centers.Last))
		shares.Add(members.Length / samples.Length)
	NaiveBayes(centers, spreads, shares)
Members(samples List(Numbers), labels Numbers, kind Number) List(Numbers)
	NaiveBayes.Members(Points, Kinds, 1).Length is 2
	for samples
		if labels(index) is kind
			value
Mean(members List(Numbers)) Numbers
	NaiveBayes.Mean(((1, 2), (3, 4))) is (2, 3)
	for members.First
		Csv.Sample.Column(members, index).Average
Variance(members List(Numbers), mean Numbers) Numbers
	NaiveBayes.Variance(((1, 2), (3, 4)), (2, 3)).First.Round(6) is 1
	for mean
		Squared(Csv.Sample.Column(members, index), value).Sum / members.Length + Tiny
Squared(values Numbers, center Number) Numbers
	NaiveBayes.Squared((1, 3), 2) is (1, 1)
	for values
		(value - center) * (value - center)
Classified(sample Numbers) Number
	NaiveBayes.Trained(Points, Kinds).Classified((0.5, 0.5)) is 0
	NaiveBayes.Trained(Points, Kinds).Classified((5, 5)) is 1
	let scores = Scores(sample)
	scores.Index(scores.Maximum)
Scores(sample Numbers) Numbers
	NaiveBayes(List(Numbers) + (0, 0), List(Numbers) + (1, 1), List(Number) + 1).Scores((0, 0)).First.Round(3) is -1.838
	for priors
		value.Logarithm + LogLikelihood(sample, means(index), variances(index))
LogLikelihood(sample Numbers, mean Numbers, variance Numbers) Number
	NaiveBayes.LogLikelihood(List(Number) + 0, List(Number) + 0, List(Number) + 1).Round(3) is -0.919
	mutable sum = 0
	for sample
		let difference = value - mean(index)
		sum = sum - 0.5 * (2 * Number.Pi * variance(index)).Logarithm - difference * difference / (2 * variance(index))
	sum
Predicted(tests List(Numbers)) Numbers
	NaiveBayes.Trained(Points, Kinds).Predicted(((0, 0), (5, 5))) is (0, 1)
	for tests
		Classified(value)