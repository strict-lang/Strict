has samples List(Numbers)
has labels Numbers
constant Points = NearestNeighbors(((0, 0), (0, 1), (1, 1), (5, 5), (5, 6)), (0, 0, 0, 1, 1))
Classified(sample Numbers, count Number) Number
	Points.Classified((0.5, 0.5), 3) is 0
	Points.Classified((4, 5), 1) is 1
	let distances = Distances(sample)
	mutable chosen = List(Mutable(Number))
	for count
		chosen.Add(labels(Closest(distances, chosen)))
	DecisionTree.Majority(chosen)
Distances(sample Numbers) Numbers
	Points.Distances((0, 0)).First is 0
	for samples
		KMeans.Corners.Distance(value, sample)
Closest(distances Numbers, chosen Numbers) Number
	Points.Closest((3, 1, 2), List(Number)) is 1
	Points.Closest((3, 1, 2), List(Number) + 1) is 2
	mutable best = -1
	for distances
		if (index is not in chosen) and ((best is -1) or (value < distances(best)))
			best = index
	best
Predicted(tests List(Numbers), count Number) Numbers
	Points.Predicted(((0, 0), (5, 5)), 1) is (0, 1)
	for tests
		Classified(value, count)