Escape(real Number, imaginary Number, limit Number) Number
	Escape(0, 0, 64) is 0
	Escape(-1, 0, 64) is 0
	Escape(1, 0, 64) is 3
	Escape(2, 0, 64) is 2
	Escape(-2, 0, 64) is 0
	Escape(0, 1, 64) is 0
	if Interior(real, imaginary)
		return 0
	Iterated(real, imaginary, limit)
Interior(real Number, imaginary Number) Boolean
	Interior(0, 0)
	Interior(-1, 0)
	Interior(0.3, 0) is false
	Interior(-1.25, 0) is false
	Interior(0, 0.5) and Interior(-1.1, 0)
	(Interior(0.4, 0.1) or Interior(0.25, 0) or Interior(-1, 0.3)) is false
	let vertical = imaginary * imaginary
	let shifted = real - 0.25
	let radius = shifted * shifted + vertical
	let cardioid = radius * (radius + shifted) < 0.25 * vertical - 0.00000000000001
	cardioid or (real + 1) * (real + 1) + vertical < 0.0625 - 0.00000000000001
Iterated(real Number, imaginary Number, limit Number) Number
	mutable horizontal = 0
	mutable vertical = 0
	mutable squared = 0
	mutable height = 0
	for limit
		vertical = 2 * horizontal * vertical + imaginary
		horizontal = squared - height + real
		squared = horizontal * horizontal
		height = vertical * vertical
		if squared + height > 4
			return index + 1
	0
Orbit(start ComplexDoubleDouble, seed ComplexDoubleDouble, limit Number) List(Complex)
	Orbit(ComplexDoubleDouble.Zero, ComplexDoubleDouble.Of(Complex(1, 0)), 8).Length is 4
	Orbit(ComplexDoubleDouble.Zero, ComplexDoubleDouble.Of(Complex(1, 0)), 8).Last is Complex(5, 0)
	Orbit(ComplexDoubleDouble.Of(Complex(1, 0)), ComplexDoubleDouble.Zero, 2).Length is 3
	mutable point = start
	mutable orbit = List(Complex) + start.High
	for limit
		point = point.Squared + seed
		orbit = orbit + point.High
		if Beyond(point.SquaredLength)
			return orbit
	orbit
Enclosed(orbit List(Complex), radius Number, limit Number) Boolean
	Enclosed((Complex.Zero, Complex.Zero, Complex.Zero), 0.01, 2)
	Enclosed((Complex.Zero, Complex(2, 0)), 0.01, 1) is false
	Enclosed(Orbit(ComplexDoubleDouble.Zero, ComplexDoubleDouble.Of(Complex(-0.75, 0.1)), 32), 0.0000001, 32)
	Enclosed(Orbit(ComplexDoubleDouble.Zero, ComplexDoubleDouble.Of(Complex(-0.75, 0.1)), 64), 0.0000001, 64) is false
	Enclosed(Orbit(ComplexDoubleDouble.Zero, ComplexDoubleDouble.Zero, 32), 0.75, 32) is false
	if orbit.Length < limit + 1
		return false
	DiskEnclosed(orbit, radius, limit)
DiskEnclosed(orbit List(Complex), radius Number, limit Number) Boolean
	mutable offset = Complex.Zero
	mutable error = 0
	for limit
		error = DiskError(orbit, index, offset, error)
		offset = orbit(index) * offset * 2 + Complex(radius, 0)
		if orbit(index + 1).Length + 0.000000000000001 + offset.Length * 1.000000000000001 + error >= 2
			return false
	true
DiskError(orbit List(Complex), position Number, offset Complex, previous Number) Number
	let bound = offset.Length * 1.000000000000001
	let factor = 2 * (orbit(position).Length + 0.000000000000001) + 2 * bound + previous
	let error = factor * previous + bound * bound
	error * 1.000000000000001 + bound * 0.000000000000001 + 0.00000000000000000000000000001
Beyond(squared DoubleDouble) Boolean
	Beyond(DoubleDouble(4, 0.000000000000000000000000000001))
	Beyond(DoubleDouble(4, -0.000000000000000000000000000001)) is false
	Beyond(DoubleDouble(4.5, -0.000000000000000000000000000001))
	Beyond(DoubleDouble(3.5, 0.000000000000000000000000000001)) is false
	squared.high >= 4 and (squared.high > 4 or squared.low > 0)
