constant CardioidCenter = 0.25
constant CardioidFactor = 0.25
constant BulbRadiusSquared = 0.0625
constant RoundingGrowth = 1.000000000000001
IsInterior(real Number, imaginary Number) Boolean
	IsInterior(0, 0)
	IsInterior(-1, 0)
	IsInterior(0.3, 0) is false
	IsInterior(-1.25, 0) is false
	IsInterior(0, 0.5) and IsInterior(-1.1, 0)
	(IsInterior(0.4, 0.1) or IsInterior(0.25, 0) or IsInterior(-1, 0.3)) is false
	vertical = imaginary * imaginary
	shifted = real - CardioidCenter
	radius = shifted * shifted + vertical
	cardioid = radius * (radius + shifted) < CardioidFactor * vertical - 0.00000000000001
	cardioid or (real + 1) * (real + 1) + vertical < BulbRadiusSquared - 0.00000000000001
Orbit(start ComplexDoubleDouble, seed ComplexDoubleDouble, limit Number) List(Complex)
	Orbit(ComplexDoubleDouble.Zero, ComplexDoubleDouble.Of(Complex(1, 0)), 8).Length is 4
	Orbit(ComplexDoubleDouble.Zero, ComplexDoubleDouble.Of(Complex(1, 0)), 8).Last is Complex(5, 0)
	Orbit(ComplexDoubleDouble.Of(Complex(1, 0)), ComplexDoubleDouble.Zero, 2).Length is 3
	mutable point = start
	mutable orbit = List(Complex) + start.High
	for limit
		point = point.Squared + seed
		orbit = orbit + point.High
		if IsBeyond(point.SquaredLength)
			return orbit
	orbit
IsEnclosed(orbit List(Complex), radius Number, limit Number) Boolean
	IsEnclosed((Complex.Zero, Complex.Zero, Complex.Zero), 0.01, 2)
	IsEnclosed((Complex.Zero, Complex(2, 0)), 0.01, 1) is false
	IsEnclosed(Orbit(ComplexDoubleDouble.Zero, ComplexDoubleDouble.Of(Complex(-0.75, 0.1)), 32), 0.0000001, 32)
	IsEnclosed(Orbit(ComplexDoubleDouble.Zero, ComplexDoubleDouble.Of(Complex(-0.75, 0.1)), 64), 0.0000001, 64) is false
	IsEnclosed(Orbit(ComplexDoubleDouble.Zero, ComplexDoubleDouble.Zero, 32), 0.75, 32) is false
	IsEnclosed((Complex.Zero, Complex.Zero), 0.01, 2) is false
	orbit.Length < limit + 1 then false else IsDiskEnclosed(orbit, radius, limit)
IsDiskEnclosed(orbit List(Complex), radius Number, limit Number) Boolean
	IsDiskEnclosed((Complex.Zero, Complex(1, 0), Complex.Zero), 0.9999999999999977, 1) is false
	IsDiskEnclosed((Complex.Zero, Complex(1, 0), Complex.Zero), 0.9999999999999976, 1)
	mutable offset = Complex.Zero
	mutable error = 0
	for limit
		error = DiskError(orbit, index, offset, error)
		offset = orbit(index) * offset * 2 + Complex(radius, 0)
		if orbit(index + 1).Length + 0.000000000000001 + offset.Length * RoundingGrowth + error >= 2
			return false
	true
DiskError(orbit List(Complex), position Number, offset Complex, previous Number) Number
	DiskError(Complex.Zero, 0, Complex(1, 0), 0) > 1.000000000000003
	DiskError(Complex.Zero, 0, Complex.Zero, 0) > 0 and DiskError(Complex.Zero, 0, Complex.Zero, 1) > 1
	bound = offset.Length * RoundingGrowth
	factor = 2 * (orbit(position).Length + 0.000000000000001) + 2 * bound + previous
	(factor * previous + bound * bound) * RoundingGrowth + bound * 0.000000000000001 + 0.00000000000000000000000000001
IsBeyond(squared DoubleDouble) Boolean
	IsBeyond(DoubleDouble(4, 0.000000000000000000000000000001))
	IsBeyond(DoubleDouble(4, -0.000000000000000000000000000001)) is false
	IsBeyond(DoubleDouble(4.5, -0.000000000000000000000000000001))
	IsBeyond(DoubleDouble(3.5, 0.000000000000000000000000000001)) is false
	squared.high >= 4 and (squared.high > 4 or squared.low > 0)
