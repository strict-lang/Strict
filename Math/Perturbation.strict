has orbit List(Complex) with value.Bits is 32
has center Complex with value.Bits is 32
has left Number with value.Bits is 32
has top Number with value.Bits is 32
has step Number with value.Bits is 32
has limit Number with value.Bits is 32
has julia Number with value.Bits is 32
has start Number with value.Bits is 32
constant Seahorse = Mandelbrot.Orbit(ComplexDoubleDouble.Zero, ComplexDoubleDouble.Of(Complex(-0.75, 0.1)), 64)
constant Inside = Perturbation(Seahorse, Complex(-0.75, 0.1), 0, 0, 0.001, 64, 0, 0)
constant Outside = Perturbation(Mandelbrot.Orbit(ComplexDoubleDouble.Zero, ComplexDoubleDouble.Of(Complex(1, 0)), 64), Complex(1, 0), 0, 0, 0.001, 64, 0, 0)
constant Rabbits = Mandelbrot.Orbit(ComplexDoubleDouble.Zero, ComplexDoubleDouble.Of(Complex(-0.123, 0.745)), 64)
constant Rabbit = Perturbation(Rabbits, Complex.Zero, 0, 0, 0.01, 64, 1, 0)
constant Offset = Perturbation(Rabbits + Mandelbrot.Orbit(ComplexDoubleDouble.Of(Complex(0.3, -0.2)), ComplexDoubleDouble.Of(Complex(-0.123, 0.745)), 64), Complex(0.3, -0.2), 0, 0, 0.01, 64, 1, 65)
constant Tiny = Perturbation(Inside, orbit = (Complex(1, 0), Complex(0, 1), Complex(0, 2)))
Strip(first Number, count Number, width Number) Float32s
	Inside.Strip(0, 4, 2) is (34, 0, 33, 35)
	Inside.Rebased(Complex(1.75, -0.1)) is 3
	for count
		let position = first + index
		Pixel(Complex(left + (position % width + 0.5) * step, top - ((position / width).Floor + 0.5) * step))
Pixel(offset Complex) Number
	Outside.Pixel(Complex(-1.5, 0)) is 0
	Tiny.Pixel(Complex(0.75, -0.1)) is 0
	Perturbation(Outside, step = 0.000001).Pixel(Complex(-1.5, 0)) is 0
	Perturbation(Tiny, step = 0.000001).Pixel(Complex(0.75, -0.1)) is 2
	(Rabbit.Pixel(Complex(-0.3, 0.4)), Rabbit.Pixel(Complex(0.96, -0.58)), Rabbit.Pixel(Complex(0.5, 0.6))) is (40, 45, 3)
	(Offset.Pixel(Complex(-0.6, 0.6)), Offset.Pixel(Complex(0.66, -0.38)), Offset.Pixel(Complex(0.2, 0.8))) is (40, 45, 3)
	let point = center + offset
	let coarse = julia < 0.5 and step > 0.00001 and Mandelbrot.Interior(point.real, point.imaginary)
	coarse then 0 else Rebased(offset)
Rebased(offset Complex) Number
	Outside.Rebased(Complex(-1.75, 0.1)) is 33
	mutable delta = offset * julia
	mutable position = start
	for limit
		delta = Next(position, delta, offset * (1 - julia))
		position = Moved(position, delta)
		if position is orbit.Length
			return index + 1
	0
Moved(position Number, delta Complex) Number
	Inside.Moved(0, Complex.Zero) is 1
	Inside.Moved(-3, Complex.Zero) is 1
	Outside.Moved(2, Complex.Zero) is Outside.orbit.Length
	Inside.Moved(0, Complex(0.5, 0)) is -2
	(Offset.Moved(63, Complex.Zero), Offset.Moved(70, Complex.Zero)) is (-65, 71) and Rabbit.Moved(63, Complex.Zero) is -65
	let next = position < 0 then 1 else position + 1
	let squared = (orbit(next) + delta).SquaredLength
	if squared > 4
		return orbit.Length
	let last = next < start then start else orbit.Length
	squared < delta.SquaredLength or next + 1 is last then -1 - next else next
Next(position Number, delta Complex, added Complex) Complex
	Inside.Next(0, Complex.Zero, Complex(0.5, 0.5)) is Complex(0.5, 0.5)
	(Inside.Next(1, Complex(0.1, 0), Complex.Zero) - Complex(-0.14, 0.02)).Length < 0.000001
	Tiny.Next(-2, Complex.Zero, Complex.Zero) is Complex(-2, 0)
	Tiny.Next(1, Complex(1, 0), Complex.Zero) is Complex(1, 2)
	Tiny.Next(2, Complex(1, 0), Complex.Zero) is Complex(1, 4)
	let rebased = position < 0
	let shifted = rebased then delta + orbit(-1 - position) - orbit(0) else delta
	let anchor = rebased then orbit(0) else orbit(position)
	anchor * shifted * 2 + shifted.Squared + added
