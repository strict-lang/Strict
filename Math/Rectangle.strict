has Center Vector2
has Size
Left = Center.X - Size.Width / 2
Right = Center.X + Size.Width / 2
Bottom = Center.Y - Size.Height / 2
Top = Center.Y + Size.Height / 2
Contains(point Vector2) Boolean
	Rectangle(Vector2(2, 3), Size(4, 6)).Contains(Vector2(0, 0))
	Rectangle(Vector2(2, 3), Size(4, 6)).Contains(Vector2(4, 6))
	Rectangle(Vector2(2, 3), Size(4, 6)).Contains(Vector2(5, 3)) is false
	Rectangle(Vector2(2, 3), Size(4, 6)).Contains(Vector2(-1, 3)) is false
	Rectangle(Vector2(2, 3), Size(4, 6)).Contains(Vector2(2, -1)) is false
	Rectangle(Vector2(2, 3), Size(4, 6)).Contains(Vector2(2, 7)) is false
	Rectangle(Vector2(0, 0), Size(0.1, 1)).Contains(Vector2(0.05000000074505806, 0))
	Rectangle(Vector2(5, 5), Size(2, 2)).Contains(Vector2(3, 5)) is false
	Rectangle(Vector2(5, 5), Size(2, 2)).Contains(Vector2(5, 3)) is false
	Rectangle(Vector2(2, 3), Size(4, 6)).Size is Size(4, 6)
	point.X >= Left and point.X <= Right and point.Y >= Bottom and point.Y <= Top
Intersects(other) Boolean
	Rectangle(Vector2(0, 0), Size(6, 2)).Intersects(Rectangle(Vector2(0, 0), Size(2, 6)))
	Rectangle(Vector2(0, 0), Size(2, 2)).Intersects(Rectangle(Vector2(2, 0), Size(2, 2)))
	Rectangle(Vector2(0, 0), Size(2, 2)).Intersects(Rectangle(Vector2(3, 0), Size(2, 2))) is false
	Rectangle(Vector2(0, 0), Size(2, 2)).Intersects(Rectangle(Vector2(-3, 0), Size(2, 2))) is false
	Rectangle(Vector2(0, 0), Size(2, 2)).Intersects(Rectangle(Vector2(0, -3), Size(2, 2))) is false
	Rectangle(Vector2(0, 0), Size(2, 2)).Intersects(Rectangle(Vector2(0, 3), Size(2, 2))) is false
	Rectangle(Vector2(0, 0), Size(2, 2)).Intersects(Rectangle(Vector2(-2, 0), Size(2, 2)))
	Rectangle(Vector2(0, 0), Size(2, 2)).Intersects(Rectangle(Vector2(0, -2), Size(2, 2)))
	Rectangle(Vector2(0, 0), Size(2, 2)).Intersects(Rectangle(Vector2(0, 2), Size(2, 2)))
	Left <= other.Right and Right >= other.Left and Bottom <= other.Top and Top >= other.Bottom
CreateFromCorners(first Vector2, second Vector2) Rectangle
	Rectangle.CreateFromCorners(Vector2(4, 6), Vector2(0, 0)) is Rectangle(Vector2(2, 3), Size(4, 6))
	Rectangle.CreateFromCorners(Vector2(1, 2), Vector2(5, 8)) is Rectangle(Vector2(3, 5), Size(4, 6))
	let center = Vector2((first.X + second.X) / 2, (first.Y + second.Y) / 2)
	Rectangle(center, Size((second.X - first.X).Absolute, (second.Y - first.Y).Absolute))