has X Number with value.Bits is 32
has Y Number with value.Bits is 32
constant Zero = Vector2(0, 0)
constant One = Vector2(1, 1)
constant Left = Vector2(-1, 0)
constant Right = Vector2(1, 0)
constant Up = Vector2(0, -1)
constant Down = Vector2(0, 1)
constant QuarterTurn = 90
constant HalfTurn = 180
Numbers Numbers
	Vector2(1, 2).Numbers is (1, 2)
	(X, Y)
Length Number
	Zero.Length is 0
	Vector2(3, 4).Length is 5
	(X * X + Y * Y).SquareRoot
+(other) Vector2
	Vector2(0, 0) + Vector2.One is Vector2(1, 1)
	Vector2(1, 2) + Vector2(4, 5) is Vector2(5, 7)
	Vector2(1, 0) + Vector2(0, 1) - Vector2(0, -2) is Vector2(1, 3)
	Vector2(X + other.X, Y + other.Y)
*(other) Number
	Vector2(1, 2) * Vector2(3, 4) is 11
	X * other.X + Y * other.Y
*(scale Number) Vector2
	Vector2(1, 2) * 3 is Vector2(3, 6)
	Vector2(X * scale, Y * scale)
Normalize Vector2
	Vector2(1, 0).Normalize is Vector2(1, 0)
	Vector2(0, 5).Normalize is Vector2(0, 1)
	Vector2(3, 4).Normalize.Length.IsNearlyEqual(1)
	Vector2(X / Length, Y / Length)
Atan Degrees
	Vector2(0, 0).Atan is 0
	Vector2(1, 0).Atan is 90 and Vector2(-1, 0).Atan is -90
	Vector2(-1, -1).Atan is -135
	Vector2(1, -1).Atan is 135 and Vector2(1, 1).Atan is 45 and Vector2(0, -1).Atan is 180
	Vector2(2, 1).Atan is Degrees(63.43494882292201) and Vector2(-2, -1).Atan is Degrees(-116.56505117707799)
	Vector2(1, 2).Atan is Degrees(26.56505117707799) and Vector2(2, -1).Atan is Degrees(116.56505117707799)
	half = Y < 0 then (X < 0 then -HalfTurn else HalfTurn) else 0
	turn = X > 0 then QuarterTurn else -QuarterTurn
	Degrees(X.Absolute > Y.Absolute then turn - Ratio(Y / X).Atan else Ratio(Y is 0 then 0 else X / Y).Atan + half)
-(other) Vector2
	Vector2(4, 7) - Vector2(1, 2) is Vector2(3, 5)
	Vector2(X - other.X, Y - other.Y)
/(scale Number) Vector2
	Vector2(6, 8) / 2 is Vector2(3, 4)
	Vector2(X / scale, Y / scale)
DistanceTo(other) Number
	Vector2(1, 2).DistanceTo(Vector2(4, 6)) is 5
	(value - other).Length
Lerp(other, alpha Number) Vector2
	Vector2(2, 4).Lerp(Vector2(6, 8), 0.25) is Vector2(3, 5)
	Vector2(X + (other.X - X) * alpha, Y + (other.Y - Y) * alpha)
Rotated(angle Degrees) Vector2
	Vector2(1, 0).Rotated(Degrees(90)).DistanceTo(Vector2(0, 1)) < 0.000001
	Vector2(0, 1).Rotated(Degrees(90)).DistanceTo(Vector2(-1, 0)) < 0.000001
	Vector2(1, 2).Rotated(Degrees(0)).DistanceTo(Vector2(1, 2)) < 0.000001
	Vector2(X * angle.Cos - Y * angle.Sin, X * angle.Sin + Y * angle.Cos)