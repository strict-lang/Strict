has capacity Number
has values Numbers = List(Number)
has added Number = 0
has sum Number = 0
has lows MonotonicQueue = MonotonicQueue.Lows
has highs MonotonicQueue = MonotonicQueue.Highs
constant Pair = MovingWindow(2)
Added(number Number) MovingWindow
	Pair.Added(1).Added(3).values is (1, 3)
	Pair.Added(1).Added(3).Added(5).values is (5, 3)
	Pair.Added(1).Added(3).Added(5).Added(7).Sum is 12
	MovingWindow(3).Added(5).Added(1).Added(4).Added(2).Added(3).Added(0).Minimum is 0
	let removed = values.Length < capacity then 0 else values(added % capacity)
	let kept = Stored(number)
	let total = (added + 1) % capacity is 0 then kept.Sum else sum - removed + number
	MovingWindow(capacity, kept, added + 1, total, lows.Pushed(added, kept, capacity), highs.Pushed(added, kept, capacity))
Stored(number Number) Numbers
	Pair.Added(1).Added(3).Stored(5) is (5, 3)
	if values.Length < capacity
		return values + number
	mutable kept = values
	kept(added % capacity) = number
	kept
Sum Number
	Pair.Added(4).Sum is 4
	sum
Average Number
	Pair.Added(1).Added(3).Added(5).Average is 4
	Pair.Average is 0
	values.Length is 0 then 0 else sum / values.Length
Minimum Number
	Pair.Added(4).Added(2).Added(3).Minimum is 2
	MovingWindow(3).Added(5).Added(1).Added(4).Added(2).Minimum is 1
	lows.Value(values, capacity)
Maximum Number
	Pair.Added(4).Added(2).Added(3).Maximum is 3
	MovingWindow(3).Added(5).Added(1).Added(4).Added(2).Added(3).Maximum is 4
	highs.Value(values, capacity)