has capacity Number
has values Numbers = List(Number)
has oldest Number = 0
has sum Number = 0
constant Pair = MovingWindow(2)
Added(value Number) MovingWindow
	Pair.Added(1).Added(3).values is (1, 3)
	Pair.Added(1).Added(3).Added(5).values is (5, 3)
	Pair.Added(1).Added(3).Added(5).Added(7).Sum is 12
	if values.Length < capacity
		return MovingWindow(capacity, values + value, oldest, sum + value)
	mutable kept = values
	let removed = kept(oldest)
	kept(oldest) = value
	let next = (oldest + 1) % capacity
	MovingWindow(capacity, kept, next, next is 0 then kept.Sum else sum - removed + value)
Sum Number
	Pair.Added(4).Sum is 4
	sum
Average Number
	Pair.Added(1).Added(3).Added(5).Average is 4
	Pair.Average is 0
	values.Length is 0 then 0 else sum / values.Length
Minimum Number
	Pair.Added(4).Added(2).Added(3).Minimum is 2
	values.Minimum
Maximum Number
	Pair.Added(4).Added(2).Added(3).Maximum is 3
	values.Maximum
