constant FormHeader = "Content-Type: application/x-www-form-urlencoded"
Fetch(method Text, url Text, body Text = "", headers Text = "", seconds Number = 15, maximum Number = 67108864) HttpResponse slow
	Http.Fetch("GET", "ftp://example.com") is Error("InvalidHttpUrl")
	Http.Fetch("GET", "https://") is Error("InvalidHttpUrl")
	Response(Request(method, url, body, headers, seconds, maximum))
Request(method Text, url Text, body Text, headers Text, seconds Number, maximum Number) Text slow
Start(method Text, url Text, body Text = "", headers Text = "", seconds Number = 15, maximum Number = 67108864) Number slow
Receive(request Number) HttpResponse slow
	Http.Receive(0) is Error("InvalidHttpRequest")
	Http.Start("GET", "ftp://example.com") is Error("InvalidHttpUrl")
	Response(Poll(request))
Poll(request Number) Text slow
Response(raw Text) HttpResponse
	Http.Response("200\n\nbody") is HttpResponse(200, "", "body")
	Http.Response("404\nA: b\nC: d\n\n{}") is HttpResponse(404, "A: b\nC: d", "{}")
	lineEnd = raw.IndexOf("\n")
	headEnd = raw.IndexOf("\n\n")
	headers = headEnd > lineEnd then raw.Substring(lineEnd + 1, headEnd - lineEnd - 1) else ""
	HttpResponse(raw.Substring(0, lineEnd) to Number, headers, raw.Substring(headEnd + 2, raw.Length - headEnd - 2))
