Loopback Number
	let server = Socket.Listen(34567)
	if server is Error
		return 1
	let client = Socket.Connect("127.0.0.1", 34567)
	if client is Error
		return 2
	let accepted = Socket.Accept(server)
	let result = accepted is Error then 3 else Exchanged(client, accepted)
	Socket.Close(client)
	Socket.Close(server)
	result
Exchanged(client Number, accepted Number) Number
	if Socket.Send(client, (1, 2, 3)) is not 3
		return 4
	let received = Socket.Receive(accepted, 3)
	Socket.Close(accepted)
	received is (1, 2, 3) then 0 else 5
