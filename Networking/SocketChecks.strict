has logger
Failures Slow(Number)
	Socket.Send(0, List(Number)) is Error("InvalidSocket")
	Socket.Receive(0, 1) is Error("InvalidSocket")
	Socket.Close(0) is 0
	Socket.Waiting(0) is Error("InvalidSocket")
	Socket.Port(0) is Error("InvalidSocket")
	(Socket.Listen(-1) is Error("InvalidPort")) and (Socket.Listen(65536) is Error("InvalidPort"))
	Socket.Connect("127.0.0.1", 70000) is Error("InvalidPort")
	Socket.Local(-1) is Error("InvalidPort")
	Loopback(Socket.Listen(0)) is 0
	Loopback(Socket.Local(0)) is 0
	0
Loopback(server Number) Number
	if server is Error
		return 1
	let result = Connected(server)
	Socket.Close(server)
	result
Connected(server Number) Number
	let client = Socket.Connect("127.0.0.1", Socket.Port(server))
	if client is Error
		return 2
	let accepted = Socket.Accept(server)
	if accepted is Error
		Socket.Close(client)
		return 3
	let result = Exchanged(client, accepted)
	Socket.Close(accepted)
	Socket.Close(client)
	result
Exchanged(client Number, accepted Number) Number
	let sent = Socket.Send(client, (1, 2, 3))
	if (sent is Error) or (sent is not 3)
		return 4
	let received = Socket.Receive(accepted, 3)
	if (received is Error) or (received is not (1, 2, 3))
		return 5
	Socket.Output(accepted)
	logger.Log("a")
	Socket.Output(0)
	let logged = Socket.Pending(client) is 2 then Socket.Receive(client, 2) else List(Number)
	logged is (Character.LowercaseA, Character.NewLine.number) then 0 else 6