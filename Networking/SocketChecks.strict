has logger
Failures Slow(Number)
	Socket.Send(0, List(Number)) is Error("InvalidSocket")
	Socket.Receive(0, 1) is Error("InvalidSocket")
	Socket.Close(0) is not Error
	Socket.Waiting(0) is Error("InvalidSocket")
	Socket.Port(0) is Error("InvalidSocket")
	(Socket.Listen(-1) is Error("InvalidPort")) and (Socket.Listen(65536) is Error("InvalidPort"))
	Socket.Connect("127.0.0.1", 70000) is Error("InvalidPort")
	Socket.Local(-1) is Error("InvalidPort")
	Loopback(Socket.Listen(0)) is not Error
	Loopback(Socket.Local(0)) is not Error
	0
Loopback(server Number)
	if server is Error
		return Error("ServerNotOpened")
	let connected = Connected(server)
	Socket.Close(server)
	if connected is Error
		return connected
Connected(server Number)
	let client = Socket.Connect("127.0.0.1", Socket.Port(server))
	if client is Error
		return Error("ClientNotConnected")
	let accepted = Socket.Accept(server)
	if accepted is Error
		Socket.Close(client)
		return Error("ClientNotAccepted")
	let exchanged = Exchanged(client, accepted)
	Socket.Close(accepted)
	Socket.Close(client)
	if exchanged is Error
		return exchanged
Exchanged(client Number, accepted Number)
	if Socket.Send(client, (1, 2, 3)) is Error
		return Error("BytesNotSent")
	let received = Socket.Receive(accepted, 3)
	if (received is Error) or (received is not (1, 2, 3))
		return Error("BytesNotReceived")
	Socket.Output(accepted)
	logger.Log("a")
	Socket.Output(0)
	let logged = Socket.Pending(client) is 2 then Socket.Receive(client, 2) else List(Number)
	if logged is not (Character.LowercaseA, Character.NewLine.number)
		return Error("LogNotForwarded")