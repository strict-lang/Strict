has kind Number
constant Sigmoid = Activation(0)
constant Tanh = Activation(1)
constant Relu = Activation(2)
constant LeakyRelu = Activation(3)
constant Softplus = Activation(4)
constant Swish = Activation(5)
constant Names = ("Sigmoid", "Tanh", "Relu", "LeakyRelu", "Softplus", "Swish")
Output(sum Number) Number
	Sigmoid.Output(0) is 0.5
	Tanh.Output(1).IsNearlyEqual(0.7615941559557649)
	(Relu.Output(-2), LeakyRelu.Output(-2)) is (0, -0.02)
	Softplus.Output(0) is 0.6931471805599453
	Swish.Output(1).IsNearlyEqual(0.7310585786300049)
	if value is
		Tanh then 2 / (1 + (-2 * sum).Exponential) - 1
		Relu then (sum > 0 then sum else 0)
		LeakyRelu then (sum > 0 then sum else 0.01 * sum)
		Softplus then (1 + sum.Exponential).Logarithm
		Swish then sum / (1 + (-sum).Exponential)
		else 1 / (1 + (-sum).Exponential)
Derivative(sum Number, output Number) Number
	Sigmoid.Derivative(0, 0.5) is 0.25
	Tanh.Derivative(0.5493061443340549, 0.5) is 0.75
	(Relu.Derivative(3, 3), LeakyRelu.Derivative(-2, -0.02)) is (1, 0.01)
	Softplus.Derivative(0, 0.6931471805599453).IsNearlyEqual(0.5)
	Swish.Derivative(1, 0.7310585786300049).IsNearlyEqual(0.9276705118714866)
	if value is
		Tanh then 1 - output * output
		Relu then (output > 0 then 1 else 0)
		LeakyRelu then (output > 0 then 1 else 0.01)
		Softplus then 1 - (-output).Exponential
		Swish then Sigmoid.Output(sum) * (1 + sum * (1 - Sigmoid.Output(sum)))
		else output * (1 - output)
to Text
	Tanh to Text is "Tanh"
	Names(kind)