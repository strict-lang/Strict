has rows List(Numbers)
has lowest Numbers
has highest Numbers
constant Planar = Arm(((0, 0, 0), (0.5, 0, 0), (0.3, 0, 0)), (-180, -180), (180, 180))
constant Franka = Arm(((0, 0, 0.333), (0, -90, 0), (0, 90, 0.316), (0.0825, 90, 0), (-0.0825, -90, 0.384), (0, 90, 0), (0.088, 90, 0), (0, 0, 0.107)), (-166, -101, -166, -176, -166, -1, -166), (166, 101, 166, -4, 166, 215, 166))
Reached(angles Numbers) Numbers
	Planar.Reached((0, 0)) is (0.8, 0, 0)
	Franka.Reached((0, 0, 0, 0, 0, 0, 0)).First.IsNearlyEqual(0.088)
	Franka.Reached((0, 0, 0, 0, 0, 0, 0)).Last.IsNearlyEqual(0.926)
	Franka.Reached((0, -45, 0, -135, 0, 90, 45)).First.IsNearlyEqual(0.3068905665929411)
	Franka.Reached((0, -45, 0, -135, 0, 90, 45)).Last.IsNearlyEqual(0.5902820523028393)
	mutable rotation = Turned(0)
	mutable position = (0, 0, 0)
	for rows
		let tilted = Times(rotation, Tilted(value(1)))
		position = Moved(position, tilted, value)
		rotation = Times(tilted, Turned(index < angles.Length then angles(index) else 0))
	position
Tilted(degrees Number) List(Numbers)
	Planar.Tilted(90) is ((1, 0, 0), (0, 0, -1), (0, 1, 0))
	let cosine = Degrees(degrees).Cos
	let sine = Degrees(degrees).Sin
	((1, 0, 0), (0, cosine, -sine), (0, sine, cosine))
Turned(degrees Number) List(Numbers)
	Planar.Turned(90) is ((0, -1, 0), (1, 0, 0), (0, 0, 1))
	let cosine = Degrees(degrees).Cos
	let sine = Degrees(degrees).Sin
	((cosine, -sine, 0), (sine, cosine, 0), (0, 0, 1))
Times(left List(Numbers), right List(Numbers)) List(Numbers)
	Planar.Times(Planar.Turned(90), Planar.Turned(-90)) is Planar.Turned(0)
	for left
		Row(value, right)
Row(row Numbers, right List(Numbers)) Numbers
	Planar.Row((1, 2, 3), Planar.Turned(90)) is (2, -1, 3)
	let first = right(0)
	let second = right(1)
	let third = right(2)
	for row
		row(0) * first(index) + row(1) * second(index) + row(2) * third(index)
Moved(position Numbers, frame List(Numbers), link Numbers) Numbers
	Planar.Moved((1, 1, 1), Planar.Turned(90), (2, 0, 3)) is (1, 3, 4)
	for position
		value + link(0) * frame(index).First + link(2) * frame(index).Last
Random Numbers
	Franka.Random.Length is 7
	Planar.Random.First <= 180
	for lowest
		value + (highest(index) - value).Random