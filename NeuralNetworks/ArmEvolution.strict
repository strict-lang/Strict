has logger
constant Generations = 200
Run
	logger.Log(Report("Planar arm", Reach.Planar, Generations))
	logger.Log(Report("Franka arm", Reach(Arm.Franka, (0.01, 0.7, 0.28)), Generations))
Report(name Text, reach Reach, generations Number) Text
	ArmEvolution.Report("Planar arm", Reach.Planar, 1).StartsWith("Planar arm: joint angles (") is true
	let started = Process.Elapsed
	let best = reach.Evolved(reach.Arms, generations)
	let milliseconds = ((Process.Elapsed - started) * 1000).Round(1)
	let millimeters = (reach.Distance(best) * 1000).Round(2)
	let reached = " reach " + reach.target + " within " + millimeters + " mm"
	name + ": joint angles " + best + reached + " in " + milliseconds + " ms"