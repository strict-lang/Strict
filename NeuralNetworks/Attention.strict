has queries Numbers
has keys Numbers
has values Numbers
has heads Number
has groups Number
has size Number
has sequences Number = 1
has causal Boolean = true
constant Single = Attention((1, 0), (1, 0, 0, 1), (3, 4, 5, 6), 1, 1, 2)
constant Pair = Attention((1, 0, 0, 1), (1, 0, 1, 0, 0, 1, 0, 1), (3, 4, 7, 8, 5, 6, 5, 6), 1, 1, 2, 2)
constant Prompt = Gguf("NeuralNetworks/blocks.gguf", 32).Rows("prompt").First
constant Prompted = Attention(Safetensors.Part(Prompt, 0, 4096, 1), Safetensors.Part(Prompt, 4096, 3072, 1), Safetensors.Part(Prompt, 7168, 3072, 1), 4, 2, 64)
constant Tiled = Attention(Safetensors.Part(Prompt, 0, 4096, 1), Safetensors.Part(Prompt, 4096, 3072, 1), Safetensors.Part(Prompt, 7168, 3072, 1), 4, 1, 64)
constant Unmasked = Attention(Prompt.Slice(0, 32) + Prompt.Slice(2016, 32), Prompted.keys, Prompted.values, 2, 1, 16, 1, false)
constant Spread = Attention(Safetensors.Part(Prompt, 9600, 32, 1), Safetensors.Part(Prompt, 0, 4800, 2), Safetensors.Part(Prompt, 1, 4800, 2), 2, 1, 8)
Merged Numbers
	Single.Merged.First.IsNearlyEqual(3.6604769013466867)
	Single.Merged.Last.IsNearlyEqual(4.660476901346686)
	Pair.Merged(1).IsNearlyEqual(4.660476901346686)
	Pair.Merged(2).IsNearlyEqual(5.660476901346686)
	let positions = keys.Length / groups / size / sequences
	let shares = Softmax.Shares(Scores(positions), positions)
	let perSequence = queries.Length / sequences
	for queries.Length
		let row = (index / size).Floor
		let group = (index / perSequence).Floor * groups + ((row % heads) * groups / heads).Floor
		let visible = Last(row, positions, perSequence / heads / size) + 1
		Softmax.Weighted(shares, row * positions, visible, values, group * size + index % size, sequences * groups * size)
Scores(positions Number) Numbers
	Single.Scores(2).First.IsNearlyEqual(0.7071067811865476)
	Single.Scores(2).Last is 0
	let tokens = queries.Length / heads / size / sequences
	for tokens * sequences * heads * positions
		let row = (index / positions).Floor
		let group = ((row / heads).Floor / tokens).Floor * groups + ((row % heads) * groups / heads).Floor
		let keyStart = ((index % positions) * sequences * groups + group) * size
		let queryStart = row * size
		mutable sum = Visible(0, index % positions, Last(row, positions, tokens))
		for (sum is 0 then size else 0)
			sum = sum + queries(queryStart + index) * keys(keyStart + index)
		sum / size.SquareRoot
Last(row Number, positions Number, tokens Number) Number
	Single.Last(3, 5, 2) is 4
	Prompted.Merged(4095).IsNearlyEqual(0.061657, 0.005)
	Attention(Prompt.Slice(0, 256), Prompted.keys, Prompted.values, 4, 2, 64).Merged(255).IsNearlyEqual(0.104795, 0.005)
	Tiled.Merged(1500).IsNearlyEqual(0.031491, 0.005)
	Tiled.Merged(4095).IsNearlyEqual(0.045206, 0.005)
	Attention(Pair.queries, Pair.keys, (3, 4, 7, 8, 5, 6, 9, 10), 1, 1, 2, 1, false).Merged.First.IsNearlyEqual(5.6604769)
	Attention(Pair.queries, Pair.keys, (3, 4, 7, 8, 5, 6, 9, 10), 1, 1, 2).Merged.First is 5
	Attention(Pair.queries, Pair.keys, (3, 4, 7, 8, 5, 6, 9, 10), 1, 1, 2, 1, false).Merged(3).IsNearlyEqual(7.3395231)
	causal then positions - tokens + (row / heads).Floor % tokens else positions - 1
Visible(score Number, position Number, limit Number) Number
	Single.Visible(2, 1, 1) is 2
	Single.Visible(2, 2, 1) is -1000000000
	Prompted.Merged(1866).IsNearlyEqual(-0.025784, 0.005)
	Spread.Merged(14).IsNearlyEqual(0.050249, 0.001)
	Spread.Merged(30).IsNearlyEqual(0.043154, 0.001)
	Attention(Prompted.queries, Prompted.keys, Prompted.values, 4, 2, 64, 1, false).Merged(0).IsNearlyEqual(-0.2334, 0.005)
	Attention.Unmasked(0).Merged(0).IsNearlyEqual(-0.0168, 0.005)
	Attention.Unmasked(2016).Merged(31).IsNearlyEqual(0.02, 0.005)
	position > limit then -1000000000 else score
Unmasked(start Number) Attention
	Attention.Unmasked(0).queries.Length is 32
	Attention(Safetensors.Part(Prompt, start, 32, 1), Prompted.keys, Prompted.values, 2, 1, 16, 1, false)
