has queries Numbers
has keys Numbers
has values Numbers
has heads Number
has groups Number
has size Number
has sequences Number = 1
has causal Boolean = true
has valueOffset Number = 0
has valueStride Number = 0
has quantized Boolean = false
has routing Number = 0
has exact Number = 0
constant Single = Attention((1, 0), (1, 0, 0, 1), (3, 4, 5, 6), 1, 1, 2)
constant Prompt = Gguf("NeuralNetworks/blocks.gguf", 32).Rows("prompt").First
Merged Slow(Numbers)
	Single.Merged.First.IsNearlyEqual(3.6604769013466867)
	Attention(Single, values = (0, 3, 4, 0, 5, 6), valueOffset = 1, valueStride = 3).Merged.First.IsNearlyEqual(3.6604769)
	Single.Merged.Last.IsNearlyEqual(4.660476901346686)
	Attention.Pair.Merged(1).IsNearlyEqual(4.660476901346686)
	Attention.Pair.Merged(2).IsNearlyEqual(5.660476901346686)
	let positions = keys.Length / groups / size / sequences
	let shares = Softmax.Shares(Scores(positions), positions)
	let perSequence = queries.Length / sequences
	for queries.Length
		let row = (index / size).Floor
		let visible = Last(row, positions, perSequence / heads / size) + 1
		Softmax.Weighted(shares, row * positions, visible, values, ValueStart(index), Stride)
Stride Slow(Number)
	Attention(Prompted, values = Prompt, valueOffset = 7168, valueStride = 128).Merged(4095).IsNearlyEqual(0.061657, 0.005)
	Attention(Prompt, Prompt, Prompt, 1, 1, 128, 1, false, 0, 0, true).Merged(10239).IsNearlyEqual(-0.24048, 0.01)
	Attention(Prompt, Prompt, Prompt, 1, 1, 128, 1, false, 0, 0, true, 1).Merged(10239).IsNearlyEqual(-0.24048, 0.01)
	valueStride is 0 then sequences * groups * size else valueStride
ValueStart(at Number) Number
	let row = (at / size).Floor
	let sequence = (at / (queries.Length / sequences)).Floor
	let group = sequence * groups + ((row % heads) * groups / heads).Floor
	valueOffset + group * size + at % size
Scores(positions Number) Numbers
	Single.Scores(2).First.IsNearlyEqual(0.7071067811865476)
	Single.Scores(2).Last is 0
	let tokens = queries.Length / heads / size / sequences
	for tokens * sequences * heads * positions
		let row = (index / positions).Floor
		let group = ((row / heads).Floor / tokens).Floor * groups + ((row % heads) * groups / heads).Floor
		let keyStart = ((index % positions) * sequences * groups + group) * size
		let queryStart = row * size
		mutable sum = Visible(0, index % positions, Last(row, positions, tokens))
		for (sum is 0 then size else 0)
			sum = sum + queries(queryStart + index) * keys(keyStart + index)
		sum / size.SquareRoot
Last(row Number, positions Number, tokens Number) Slow(Number)
	Attention(Prompt.Slice(0, 4000), Prompt, Prompt, 2, 1, 40).Merged(5).IsNearlyEqual(0.064627, 0.002)
	Attention(Prompt.Slice(0, 4000), Prompt, Prompt, 2, 1, 40, 1, false).Merged(5).IsNearlyEqual(0.081243, 0.002)
	Single.Last(3, 5, 2) is 4
	Prompted.Merged(4095).IsNearlyEqual(0.061657, 0.005)
	Attention(Prompt.Slice(0, 256), Prompted.keys, Prompted.values, 4, 2, 64).Merged(255).IsNearlyEqual(0.104795, 0.005)
	Attention(Prompted, groups = 1).Merged(1500).IsNearlyEqual(0.031491, 0.005)
	Attention(Prompted, groups = 1).Merged(4095).IsNearlyEqual(0.045206, 0.005)
	Attention.Paired((3, 4, 7, 8, 5, 6, 9, 10), false).Merged.First.IsNearlyEqual(5.6604769)
	Attention.Paired((3, 4, 7, 8, 5, 6, 9, 10), true).Merged.First is 5
	Attention.Paired((3, 4, 7, 8, 5, 6, 9, 10), false).Merged(3).IsNearlyEqual(7.3395231)
	causal then positions - tokens + (row / heads).Floor % tokens else positions - 1
Visible(score Number, position Number, limit Number) Slow(Number)
	Attention(Prompt, Prompt, Prompt, 1, 1, 128, 1, false).Merged(10239).IsNearlyEqual(-0.24048, 0.002)
	Attention(Prompt, Prompt, Prompt, 1, 1, 128).Merged(100).IsNearlyEqual(0.196385, 0.002)
	Single.Visible(2, 1, 1) is 2
	Single.Visible(2, 2, 1) is -1000000000
	Prompted.Merged(1866).IsNearlyEqual(-0.025784, 0.005)
	Attention.Spread.Merged(14).IsNearlyEqual(0.050249, 0.001)
	Attention.Spread.Merged(30).IsNearlyEqual(0.043154, 0.001)
	Attention(Prompted.queries, Prompted.keys, Prompted.values, 4, 2, 64, 1, false).Merged(0).IsNearlyEqual(-0.2334, 0.005)
	Attention.Unmasked(0).Merged(0).IsNearlyEqual(-0.0168, 0.005)
	Attention.Unmasked(2016).Merged(31).IsNearlyEqual(0.02, 0.005)
	position > limit then -1000000000 else score
Unmasked(start Number) Slow(Attention)
