	let evenRows = Safetensors.Part(Prompt, 0, 4800, 2)
	Attention(Safetensors.Part(Prompt, 9600, 32, 1), evenRows, Safetensors.Part(Prompt, 1, 4800, 2), 2, 1, 8)
Pair Attention
