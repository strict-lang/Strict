has number
from(unrounded Number)
	BFloat16(1) is 1
	BFloat16(1.00390625) is 1
	BFloat16(1.01171875) is 1.015625
	BFloat16(0.1) is 0.10009765625
	BFloat16(-300.5) is -300
	BFloat16(41473) is 41472
	BFloat16(0.1).IsNearlyEqual(0.10009765625)
	BFloat16(0) is 0
	Float32.Rounded(unrounded, 7)
Packed(numbers Numbers) BFloat16s
	BFloat16.Packed((0.5, 1.00390625, -3.25)) is (0.5, 1, -3.25)
	for numbers
		BFloat16(value)