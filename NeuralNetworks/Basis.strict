has signs List(Numbers)
has block Number = 1024
has grouped Boolean = false
has folded Texts = List(Text)
has convrot Number = 0
constant None = Basis(List(Numbers))
constant Model = Gguf("NeuralNetworks/tinyqwen35basis.gguf", 32)
constant Tiny = Basis.Loaded(Model)
constant Probe = (1, -2, 3, 0.5, 4, 0, -1, 2)
Loaded(model Gguf) Slow(Basis)
	Tiny.block is 4
	Tiny.grouped is true
	Basis.Loaded(Gguf("NeuralNetworks/tinyqwen35.gguf")) is None
	let widths = model.Value("prism.hadamard.sign_widths")
	if widths is ""
		return None
	let values = model.Value("prism.hadamard.sign_values").Lines to Numbers
	let size = model.Value("prism.hadamard.block_size") to Number
	if size > Sylvester.Radix * Sylvester.Radix
		return Error("HadamardBlocksAboveRadixSquaredAreNotSupported")
	let isGrouped = model.Value("prism.hadamard.gdn_v_grouped") is "true"
	Basis(Parts(values, widths.Lines to Numbers), size, isGrouped, model.Value("prism.hadamard.weight_names").Lines)
Parts(values Numbers, sizes Numbers) List(Numbers)
	None.Parts((1, 2, 3), (1, 2)).Last is (2, 3)
	for sizes
		values.Slice(sizes.Slice(0, index).Sum, value)
IsFolded(name Text) Boolean
	Tiny.IsFolded("blk.0.ssm_beta.weight") is false
	None.IsFolded("blk.0.ssm_beta.weight")
	Tiny.IsFolded("blk.0.ssm_out.weight")
	(signs.Length is 0) or (name is in folded)
Signs(width Number) Numbers
	Tiny.Signs(12).Length is 12
	Tiny.Signs(5) is Error
	for signs
		if value.Length is width
			return value
	Error("NoHadamardSignsForWidth" + width)
Rotated(input Numbers, width Number) Numbers
	None.Rotated((1, 2), 2) is (1, 2)
	Tiny.Rotated((0, 1, 0, 0, 0, 0, 0, 0), 8).Length is 8
	Tiny.Restored(Tiny.Rotated(Probe + Probe, 8), 8) is Probe + Probe
	Basis(None, convrot = 4).Rotated((1, 0, 0, 0, 0, 2, 0, 0), 8) is (0.5, 0.5, 0.5, -0.5, 1, 1, -1, 1)
	if convrot > 0
		return Convrot(input, convrot).Rotated
	signs.Length is 0 then input else Sylvester(input, Signs(width), block).Rotated
Sums(weights List(Numbers), biases Numbers, input Numbers) Numbers
	None.Sums(List(Numbers) + Probe, Layer.Unbiased, Probe) is List(Number) + 35.25
	Tiny.Sums(List(Numbers) + Tiny.Rotated(Probe, 8), Layer.Unbiased, Probe).First.IsNearlyEqual(35.25)
	Batch(weights, biases).Sums(Rotated(input, weights.First.Length))
Restored(input Numbers, width Number) Numbers
	None.Restored((1, 2), 2) is (1, 2)
	Basis(None, convrot = 4).Restored(Basis(None, convrot = 4).Rotated(Probe, 8), 8) is Probe
	if convrot > 0
		return Convrot(input, convrot).Rotated
	signs.Length is 0 then input else Flipped(Sylvester(input, Sylvester.Unflipped, block).Rotated, Signs(width))
Flipped(input Numbers, flips Numbers) Numbers
	None.Flipped((1, 2, 3, 4), (1, -1)) is (1, -2, 3, -4)
	for input
		value * flips(index % flips.Length)
Grouped(input Numbers, size Number, keyHeads Number, heads Number) Numbers
	Tiny.Grouped((0, 1, 2, 3, 4, 5, 6, 7), 2, 2, 4) is (0, 1, 4, 5, 2, 3, 6, 7)
	None.Grouped((0, 1, 2, 3), 1, 2, 4) is (0, 1, 2, 3)
	if grouped is false
		return input
	let width = size * heads
	let repeats = heads / keyHeads
	for input
		let within = index % width
		let head = (within / size).Floor
		input(index - within + within % size + size * ((head / repeats).Floor + keyHeads * (head % repeats)))
