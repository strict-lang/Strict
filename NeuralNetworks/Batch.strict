has weights List(Numbers)
has biases Numbers
constant Pair = Batch(((1, 2), (3, 4)), (10, 20))
constant Blocks = Gguf("NeuralNetworks/blocks.gguf", 4)
constant Tokens = Gguf("NeuralNetworks/blocks.gguf", 32).Rows("tokens").First
constant Prompt = Gguf("NeuralNetworks/blocks.gguf", 32).Rows("prompt").First
constant Long = Gguf("NeuralNetworks/blocks.gguf", 32).Rows("long").First
constant Wide = Gguf("NeuralNetworks/blocks.gguf", 32).Rows("wider").First
constant Fours = Batch(Blocks.Rows("four"), List(Number) + 0)
constant Tile = 64
Sums(input Numbers) Numbers
	Pair.Sums((1, 1)) is (13, 27)
	Pair.Sums((1, 1, 2, 0)) is (13, 27, 12, 26)
	Batch(Blocks.Rows("four"), List(Number) + 0).Sums(Tokens)(2).IsNearlyEqual(34.943, 0.5)
	Batch(Blocks.Rows("eight"), List(Number) + 0).Sums(Tokens)(140).IsNearlyEqual(-2.042, 0.05)
	Batch(Blocks.Rows("four"), List(Number) + 0).Sums(Prompt)(637).IsNearlyEqual(5.001, 0.5)
	Batch(Blocks.Rows("six"), List(Number) + 0).Sums(Prompt)(500).IsNearlyEqual(-3.413, 0.2)
	let width = weights.First.Length
	if (input.Length <= 4 * width) and (weights.Length < 100000)
		return input.Length is width then Layer(weights, biases).Sums(input) else Ordered(input)
	let rows = weights.Length
	for rows * input.Length / width
		Dot(weights(index % rows), 0, input, (index / rows).Floor * width) + biases(index % biases.Length)
Ordered(input Numbers) Numbers
	Pair.Ordered((1, 1, 2, 0)) is (13, 27, 12, 26)
	Batch(Pair.weights, (1, 2, 3, 4)).Ordered((1, 1, 2, 0)) is (4, 9, 5, 10)
	let rows = weights.Length
	let tokens = input.Length / weights.First.Length
	let sums = Interleaved(input, tokens)
	for sums
		sums((index % rows) * tokens + (index / rows).Floor) + biases(index % biases.Length)
Interleaved(input Numbers, tokens Number) Numbers
	Pair.Interleaved((1, 1, 2, 0), 2) is (3, 2, 7, 6)
	let width = weights.First.Length
	for weights.Length * tokens
		Dot(weights((index / tokens).Floor), 0, input, (index % tokens) * width)
Grouped(bases Numbers, count Number, input Numbers) Numbers
	Pair.Grouped(List(Number) + 1, 1, (1, 1, 2, 0)) is (7, 6)
	Pair.Grouped(List(Number) + 0, 2, (1, 1, 2, 0)) is (3, 7, 2, 6)
	Fours.Grouped(List(Number) + 8, 8, Tokens)(3) is Fours.Sums(Tokens)(11)
	Fours.Grouped((0, 8), 8, Long)(83).IsNearlyEqual(Fours.Sums(Long)(163), 0.5)
	Fours.Grouped((0, 8), 8, Long)(523).IsNearlyEqual(Fours.Sums(Long)(1051), 0.5)
	let width = weights.First.Length
	for count * input.Length / width
		Dot(weights(bases((index / count / Tile).Floor) + index % count), 0, input, (index / count).Floor * width)
Dot(row Numbers, first Number, input Numbers, start Number) Number
	Pair.Dot((1, 2), 0, (5, 1, 3), 1) is 7
	Batch(Blocks.Rows("four"), List(Number) + 0).Sums(Long)(1277).IsNearlyEqual(5.001, 0.5)
	Batch(Blocks.Rows("six"), List(Number) + 0).Sums(Long)(1140).IsNearlyEqual(-3.413, 0.2)
	Batch(Blocks.Rows("four"), Long).Sums(Long)(1277).IsNearlyEqual(4.533, 0.5)
	Batch(Blocks.Rows("wide"), List(Number) + 0).Sums(Wide)(1000).IsNearlyEqual(-9.015, 0.5)
	mutable sum = 0
	for row.Length
		sum = sum + row(first + index) * input(start + index)
	sum
Columns(values Numbers, width Number, start Number, count Number) Numbers
	Pair.Columns((1, 2, 3, 4, 5, 6), 3, 1, 2) is (2, 3, 5, 6)
	for values.Length / width * count
		values((index / count).Floor * width + start + index % count)
