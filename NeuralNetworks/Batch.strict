has weights List(Numbers)
has biases Numbers
constant Pair = Batch(((1, 2), (3, 4)), (10, 20))
constant Blocks = Gguf("NeuralNetworks/blocks.gguf", 4)
constant Tokens = Gguf("NeuralNetworks/blocks.gguf", 32).Rows("tokens").First
constant Prompt = Gguf("NeuralNetworks/blocks.gguf", 32).Rows("prompt").First
constant Long = Gguf("NeuralNetworks/blocks.gguf", 32).Rows("long").First
constant Wide = Gguf("NeuralNetworks/blocks.gguf", 32).Rows("wider").First
constant Fours = Batch(Blocks.Rows("four"), Layer.Unbiased)
constant Sixes = Batch(Blocks.Rows("six"), Layer.Unbiased)
constant Eights = Batch(Blocks.Rows("eight"), Layer.Unbiased)
constant Threes = Batch(Blocks.Rows("two"), Layer.Unbiased)
constant Gates = Batch(((1, 0), (0, 1), (2, 0), (0, 3)), Layer.Unbiased)
constant Wholes = Batch(Safetensors.Bytes.Quantized("a"), Layer.Unbiased)
constant Tile = 64
Sums(input Numbers) Numbers
	(Pair.Sums((1, 1)), Pair.Sums((1, 1, 2, 0))) is ((13, 27), (13, 27, 12, 26))
	Fours.Sums(Tokens)(2).IsNearlyEqual(34.943, 0.5)
	Eights.Sums(Tokens)(140).IsNearlyEqual(-2.042, 0.05)
	Fours.Sums(Prompt)(637).IsNearlyEqual(5.001, 0.5)
	Sixes.Sums(Prompt)(500).IsNearlyEqual(-3.413, 0.2)
	Threes.Sums(Tokens)(255).IsNearlyEqual(-1.549, 0.2)
	let width = weights.First.Length
	if input.Length is width
		return Layer(weights, biases).Sums(input)
	let rows = weights.Length
	for rows * input.Length / width
		Dot(weights(index % rows), 0, input, (index / rows).Floor * width) + biases(index % biases.Length)
Grouped(bases Numbers, count Number, input Numbers) Numbers
	Pair.Grouped(List(Number) + 1, 1, (1, 1, 2, 0)) is (7, 6)
	Pair.Grouped(List(Number) + 0, 2, (1, 1, 2, 0)) is (3, 7, 2, 6)
	Fours.Grouped(List(Number) + 8, 8, Tokens)(3) is Fours.Sums(Tokens)(11)
	Fours.Grouped((0, 8), 8, Long)(83).IsNearlyEqual(Fours.Sums(Long)(163), 0.5)
	Fours.Grouped((0, 8), 8, Long)(523).IsNearlyEqual(Fours.Sums(Long)(1051), 0.5)
	Threes.Grouped((0, 0), 16, Long)(1277).IsNearlyEqual(3.704, 0.2)
	let width = weights.First.Length
	for count * input.Length / width
		Dot(weights(bases((index / count / Tile).Floor) + index % count), 0, input, (index / count).Floor * width)
Gated(input Numbers) Numbers
	Gates.Gated((1, 1, 2, 0))(1).IsNearlyEqual(2.1931757)
	Gates.Gated((1, 1, 2, 0))(2).IsNearlyEqual(7.0463766)
	Wholes.Gated(Tokens)(0).IsNearlyEqual(Wholes.Sums(Tokens)(0) * Wholes.Sums(Tokens)(2), 40)
	Wholes.Gated(Tokens)(1).IsNearlyEqual(Wholes.Sums(Tokens)(1) * Wholes.Sums(Tokens)(3), 130)
	let width = weights.First.Length
	let half = weights.Length / 2
	for half * input.Length / width
		let gate = Dot(weights(index % half), 0, input, (index / half).Floor * width)
		gate / (1 + (0 - gate).Exponential) * Dot(weights(index % half + half), 0, input, (index / half).Floor * width)
Dot(row Numbers, first Number, input Numbers, start Number) Number
	Pair.Dot((1, 2), 0, (5, 1, 3), 1) is 7
	Fours.Sums(Long)(1277).IsNearlyEqual(5.001, 0.5)
	Sixes.Sums(Long)(1140).IsNearlyEqual(-3.413, 0.2)
	Batch(Blocks.Rows("four"), Long).Sums(Long)(1277).IsNearlyEqual(4.533, 0.5)
	Batch(Blocks.Rows("wide"), Layer.Unbiased).Sums(Wide)(1000).IsNearlyEqual(-9.015, 0.5)
	Eights.Sums(Long)(1277).IsNearlyEqual(-1.514, 0.05)
	Batch(Gguf("NeuralNetworks/blocks.gguf", 32).Rows("four"), Layer.Unbiased).Sums(Long)(1277).IsNearlyEqual(5.001, 0.5)
	Wholes.Sums(Tokens)(255).IsNearlyEqual(383.65, 2)
	mutable sum = 0
	for row.Length
		sum = sum + row(first + index) * input(start + index)
	sum
Columns(values Numbers, width Number, start Number, count Number) Numbers
	Pair.Columns((1, 2, 3, 4, 5, 6), 3, 1, 2) is (2, 3, 5, 6)
	for values.Length / width * count
		values((index / count).Floor * width + start + index % count)
