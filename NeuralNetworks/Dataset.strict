has inputs List(Numbers)
has targets List(Numbers)
constant Pairs = Csv.Sample.Classified(2)
OneHot(label Number, classes Number) Numbers
	Dataset.OneHot(1, 3) is (0, 1, 0)
	for classes
		index is label then 1 else 0
Images(folder Text, classes Number) Dataset
	Dataset.Images("NeuralNetworks/mnist", 1).inputs.Length is 40
	Dataset.Images("NeuralNetworks/mnist", 1).inputs.First.Sum is 83.99215686274508
	mutable images = List(Mutable(Numbers))
	mutable labeled = List(Mutable(Numbers))
	for classes
		let files = Directory.Files(folder + "/" + index, "*.png")
		images = images + Pictures(files)
		labeled = labeled + Labels(OneHot(index, classes), files.Length)
	Dataset(images, labeled)
Pictures(files Texts) List(Numbers)
	Pairs.Pictures(List(Text)).Length is 0
	for files
		Png.Read(value).Grays
Labels(label Numbers, count Number) List(Numbers)
	Pairs.Labels((1, 0), 2) is ((1, 0), (1, 0))
	for count
		label
Training Dataset
	Pairs.Training.inputs is List(Numbers) + (1, 0, 1, 1)
	Dataset(Kept(inputs, false), Kept(targets, false))
Testing Dataset
	Pairs.Testing.inputs is List(Numbers) + (0, 1, 0, 0)
	Dataset(Kept(inputs, true), Kept(targets, true))
Kept(rows List(Numbers), isTesting Boolean) List(Numbers)
	Pairs.Kept(Pairs.targets, true) is List(Numbers) + (1, 0)
	for rows
		if (index % 5 is 0) is isTesting
			value
Evaluated(name Text, sizes Numbers, epochs Number) Text
	Pairs.Evaluated("Pairs", (4, 3, 2), 1).StartsWith("Pairs test accuracy ") is true
	let started = Process.Elapsed
	let network = Network.Random(sizes).Learned(Training, epochs)
	let milliseconds = ((Process.Elapsed - started) * 1000).Round(1)
	name + " test accuracy " + network.Accuracy(Testing) + " after " + epochs + " epochs in " + milliseconds + " ms"
