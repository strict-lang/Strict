has inputs List(Numbers)
has targets List(Numbers)
constant Pairs = Csv.Sample.Classified(2)
OneHot(label Number, classes Number) Numbers
	Dataset.OneHot(1, 3) is (0, 1, 0)
	for classes
		index is label then 1 else 0
Images(folder Text, classes Number) Dataset
	Dataset.Images("NeuralNetworks/images", 2).inputs.Length is 2
	Dataset.Images("NeuralNetworks/images", 1).inputs.First.Sum.IsNearlyEqual(83.99215686274508)
	Dataset.Images("NeuralNetworks/images", 2).inputs.Last.Length is 784
	Dataset.Images("NeuralNetworks/images", 2).targets is ((1, 0), (0, 1))
	mutable images = List(Mutable(Numbers))
	mutable labeled = List(Mutable(Numbers))
	let folders = Directory.Directories(folder)
	for classes
		let files = Directory.Files(folders(index), "*.png") + Directory.Files(folders(index), "*.jpg")
		images = images + Pictures(files)
		labeled = labeled + Labels(OneHot(index, classes), files.Length)
	Dataset(images, labeled)
Pictures(files Texts) List(Numbers)
	Pairs.Pictures(List(Text)).Length is 0
	for files
		value.EndsWith(".jpg") then JpegPixels.Read(value).Grays else Png.Read(value).Grays
Labels(label Numbers, count Number) List(Numbers)
	Pairs.Labels((1, 0), 2) is ((1, 0), (1, 0))
	for count
		label
Training Dataset
	Pairs.Training.inputs is List(Numbers) + (1, 0, 1, 1)
	Dataset(Kept(inputs, false), Kept(targets, false))
Testing Dataset
	Pairs.Testing.inputs is List(Numbers) + (0, 1, 0, 0)
	Dataset(Kept(inputs, true), Kept(targets, true))
Labels Numbers
	Pairs.Labels is (0, 1)
	for targets
		value.Index(1)
Labeled List(Numbers)
	Pairs.Labeled.First.Last is 0
	Pairs.Labeled.First.Length is 5
	let labels = Labels
	for inputs
		value + labels(index)
Agreement(predicted Numbers) Number
	Pairs.Agreement((0, 1)) is 1
	Pairs.Agreement((0, 0)) is 0.5
	let expected = Labels
	mutable matching = 0
	for predicted
		if value is expected(index)
			matching = matching + 1
	matching / predicted.Length
Kept(rows List(Numbers), isTesting Boolean) List(Numbers)
	Pairs.Kept(Pairs.targets, true) is List(Numbers) + (1, 0)
	for rows
		if (index % 5 is 0) is isTesting
			value
Evaluated(name Text, sizes Numbers, epochs Number, hidden = Activation.Sigmoid) Text
	Pairs.Evaluated("Pairs", (4, 3, 2), 1).StartsWith("Pairs test accuracy ")
	let started = Process.Elapsed
	let network = Network.Random(sizes, hidden).Learned(Training, epochs)
	let milliseconds = ((Process.Elapsed - started) * 1000).Round(1)
	name + " test accuracy " + network.Accuracy(Testing) + " after " + epochs + " epochs in " + milliseconds + " ms"
Shuffled Dataset
	Pairs.Shuffled.inputs.Length is Pairs.inputs.Length
	Pairs.Shuffled.targets.Length is Pairs.targets.Length
	let order = Order(inputs.Length)
	Dataset(Picked(inputs, order), Picked(targets, order))
Order(count Number) Numbers
	Pairs.Order(5).Sum is 10
	Pairs.Order(5).Length is 5
	mutable order = Indices(count)
	for count
		let other = index + (count - index).Random.Floor
		let current = order(index)
		order(index) = order(other)
		order(other) = current
	order
Indices(count Number) Numbers
	Pairs.Indices(3) is (0, 1, 2)
	for count
		index
Picked(rows List(Numbers), order Numbers) List(Numbers)
	Pairs.Picked(List(Numbers) + (1, 2) + (3, 4), (1, 0)).First is (3, 4)
	for order
		rows(value)