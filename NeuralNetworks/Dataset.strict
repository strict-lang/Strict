has inputs List(Numbers)
has targets List(Numbers)
constant Sample = ("variety", "5.1,3.5,1.4,.2,0", "7,3.2,4.7,1.4,1")
constant Pairs = Dataset.Read(Sample, 2)
Read(lines Texts, classes Number) Dataset
	Dataset.Read(Sample, 2).inputs is ((0, 1, 0, 0), (1, 0, 1, 1))
	Dataset.Read(Sample, 2).targets is ((1, 0), (0, 1))
	let rows = Rows(lines)
	Dataset(Scaled(rows), Targets(rows, classes))
Rows(lines Texts) List(Numbers)
	Dataset.Rows(Sample).Length is 2
	for Range(1, lines.Length)
		Parsed(lines(value))
Parsed(line Text) Numbers
	Dataset.Parsed("5.1,3.5,1.4,.2,0") is (5.1, 3.5, 1.4, 0.2, 0)
	for line.Split(",")
		value to Number
Scaled(rows List(Numbers)) List(Numbers)
	Dataset.Scaled(((1, 5, 0), (3, 5, 1))) is ((0, 0), (1, 0))
	let lows = Extremes(rows, false)
	let highs = Extremes(rows, true)
	for rows
		Features(value, lows, highs)
Extremes(rows List(Numbers), isHighest Boolean) Numbers
	Dataset.Extremes(((1, 5, 0), (3, 4, 1)), true) is (3, 5)
	for rows.First.Length - 1
		isHighest then Column(rows, index).Maximum else Column(rows, index).Minimum
Column(rows List(Numbers), position Number) Numbers
	Dataset.Column(((1, 5, 0), (3, 4, 1)), 1) is (5, 4)
	for rows
		value(position)
Features(row Numbers, lows Numbers, highs Numbers) Numbers
	Dataset.Features((5, 10, 1), (0, 10), (10, 10)) is (0.5, 0)
	for lows
		highs(index) is value then 0 else (row(index) - value) / (highs(index) - value)
Targets(rows List(Numbers), classes Number) List(Numbers)
	Dataset.Targets(((1, 2), (3, 0)), 3) is ((0, 0, 1), (1, 0, 0))
	for rows
		OneHot(value.Last, classes)
OneHot(label Number, classes Number) Numbers
	Dataset.OneHot(1, 3) is (0, 1, 0)
	for classes
		index is label then 1 else 0
Training Dataset
	Pairs.Training.inputs is List(Numbers) + (1, 0, 1, 1)
	Dataset(Kept(inputs, false), Kept(targets, false))
Testing Dataset
	Pairs.Testing.inputs is List(Numbers) + (0, 1, 0, 0)
	Dataset(Kept(inputs, true), Kept(targets, true))
Kept(rows List(Numbers), isTesting Boolean) List(Numbers)
	Pairs.Kept(Pairs.targets, true) is List(Numbers) + (1, 0)
	for rows
		if (index % 5 is 0) is isTesting
			value
Evaluated(name Text, sizes Numbers, epochs Number) Text
	Pairs.Evaluated("Pairs", (4, 3, 2), 1).StartsWith("Pairs test accuracy ") is true
	let started = Process.Elapsed
	let network = Network.Random(sizes).Learned(Training, epochs)
	let milliseconds = ((Process.Elapsed - started) * 1000).Round(1)
	name + " test accuracy " + network.Accuracy(Testing) + " after " + epochs + " epochs in " + milliseconds + " ms"
