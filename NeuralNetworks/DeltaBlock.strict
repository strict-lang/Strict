has attentionNorm Numbers
has inputs Layer
has convolution Numbers
has decays Numbers
has steps Numbers
has norm Numbers
has projection Layer
has mlpNorm Numbers
has experts Experts
has window Numbers = List(Number)
has memory Numbers = List(Number)
has merged Numbers = List(Number)
constant Model = Gguf("NeuralNetworks/tinyqwen35.gguf")
constant Tiny = DeltaBlock.Loaded(Model, "blk.0.", Layer.Zeros(16))
constant Rows = Model.Rows("token_embd.weight")
Loaded(model Gguf, prefix Text, zeros Numbers) DeltaBlock
	Tiny.inputs.weights.Length is 32
	let combined = Qwen3Block.Dense(model, prefix, ("attn_qkv", "attn_gate", "ssm_beta", "ssm_alpha"))
	let taps = model.Values(prefix + "ssm_conv1d.weight")
	let logarithms = model.Values(prefix + "ssm_a")
	let projected = Qwen3Block.Dense(model, prefix, List(Text) + "ssm_out")
	let after = model.Values(prefix + "post_attention_norm.weight")
	let normed = model.Values(prefix + "attn_norm.weight")
	let biases = model.Values(prefix + "ssm_dt.bias")
	let headNorm = model.Values(prefix + "ssm_norm.weight")
	let feedForward = Qwen3Block.FeedForward(model, prefix)
	let shifted = Layer.Zeros(taps.Length / 4 * 3)
	DeltaBlock(normed, combined, taps, logarithms, biases, headNorm, projected, after, feedForward, shifted, zeros)
KeyHeads Number
	Tiny.KeyHeads is 2
	(convolution.Length / 4 / norm.Length - decays.Length) / 2
Combined(input Numbers) Numbers
	Tiny.Combined(Rows(1) + Rows(2)).Length is 64
	Batch(inputs.weights, inputs.biases).Sums(Qwen3Block.Normalized(input, 0, input.Length, attentionNorm))
Cached(combined Numbers) DeltaBlock
	Tiny.Cached(Tiny.Combined(Rows(1))).Output(Rows(1)).First.IsNearlyEqual(0.54408, 0.00001)
	Tiny.Cached(Tiny.Combined(Rows(1) + Rows(2))).Output(Rows(1) + Rows(2))(8).IsNearlyEqual(1.773538, 0.00001)
	let tokens = combined.Length / inputs.weights.Length
	let keyed = Keyed(Convolved(combined, tokens))
	let chunks = DeltaChunks(decays.Length, KeyHeads, norm.Length, 16, tokens, keyed, Decayed(combined, tokens), memory)
	let read = tokens is 1 then Stepped(chunks) else chunks.Read
	DeltaBlock(value, memory = read.memory, window = Shifted(combined, tokens), merged = Gated(read.reads, combined))
Rewound(combined Numbers) DeltaBlock
	Tiny.Rewound(Tiny.Combined(Rows(1))).memory is Tiny.Cached(Tiny.Combined(Rows(1))).memory
	Tiny.Rewound(Tiny.Combined(Rows(1) + Rows(2))).window is Tiny.Cached(Tiny.Combined(Rows(1) + Rows(2))).window
	let tokens = combined.Length / inputs.weights.Length
	let keyed = Keyed(Convolved(combined, tokens))
	let decayed = Decayed(combined, tokens)
	mutable current = value
	for tokens
		current = DeltaBlock(current, memory = current.Updated(keyed, decayed, current.Read(keyed, index, 1), index))
	DeltaBlock(current, window = Shifted(combined, tokens))
Stepped(chunks DeltaChunks) DeltaChunks
	Tiny.Stepped(DeltaChunks(4, 2, 2, 16, 1, Layer.Zeros(16), Layer.Zeros(8), Tiny.memory)).reads is Layer.Zeros(8)
	let updated = DeltaBlock(value, memory = Updated(chunks.keyed, chunks.decayed, Read(chunks.keyed, 0, 1), 0))
	DeltaChunks(chunks, memory = updated.memory, reads = updated.Read(chunks.keyed, 0, 0))
Convolved(combined Numbers, tokens Number) Numbers
	Tiny.Convolved(Layer.Zeros(64), 2) is Layer.Zeros(32)
	let channels = convolution.Length / 4
	let width = combined.Length / tokens
	for tokens * channels
		let token = (index / channels).Floor
		let channel = index % channels
		let older = Tapped(combined, width, token - 3, channel) * convolution(4 * channel)
		let old = older + Tapped(combined, width, token - 2, channel) * convolution(4 * channel + 1)
		let sum = old + Tapped(combined, width, token - 1, channel) * convolution(4 * channel + 2)
		let all = sum + Tapped(combined, width, token, channel) * convolution(4 * channel + 3)
		all / (1 + (0 - all).Exponential)
Tapped(combined Numbers, width Number, token Number, channel Number) Number
	Tiny.Tapped((1, 2, 3, 4), 2, 1, 0) is 3
	Tiny.Tapped((1, 2, 3, 4), 2, -1, 0) is 0
	token < 0 then window((3 + token) * convolution.Length / 4 + channel) else combined(token * width + channel)
Shifted(combined Numbers, tokens Number) Numbers
	Tiny.Cached(Tiny.Combined(Rows(1))).Cached(Tiny.Combined(Rows(2))).Output(Rows(2))(0).IsNearlyEqual(1.773538, 0.00001)
	Tiny.Shifted(Layer.Zeros(32), 1).Length is 48
	let channels = convolution.Length / 4
	for 3 * channels
		Tapped(combined, combined.Length / tokens, tokens - 3 + (index / channels).Floor, index % channels)
Keyed(mixed Numbers) Numbers
	Tiny.Keyed((3, 4, 0, 1, 6, 8, 0, 0, 5, 0, 0, 0, 0, 0, 0, 0))(3).IsNearlyEqual(0.7071064)
	Tiny.Keyed((3, 4, 0, 1, 6, 8, 0, 0, 5, 0, 0, 0, 0, 0, 0, 0))(5).IsNearlyEqual(0.8)
	let size = norm.Length
	let channels = convolution.Length / 4
	let keys = 2 * KeyHeads * size
	let epsilon = Qwen3Block.Epsilon / size
	for mixed
		let within = index % channels
		let query = within < keys / 2 then 1 / size else 1 / size.SquareRoot
		within >= keys then value else value * Qwen3Block.HeadScale(mixed, (index / size).Floor * size, size, epsilon) * query
Decayed(combined Numbers, tokens Number) Numbers
	Tiny.Decayed(Layer.Zeros(64), 2).Length is 16
	Tiny.Decayed(Layer.Zeros(32), 1)(4) is 0.5
	let heads = decays.Length
	let width = combined.Length / tokens
	let betas = convolution.Length / 4 + heads * norm.Length
	for 2 * tokens * heads
		let start = (index / (2 * heads)).Floor * width
		let head = index % heads
		let rate = combined(start + betas + head)
		let alpha = combined(start + betas + heads + head) + steps(head)
		let decay = decays(head) * (1 + alpha.Exponential).Logarithm
		index % (2 * heads) >= heads then 1 / (1 + (0 - rate).Exponential) else decay
Updated(keyed Numbers, decayed Numbers, remembered Numbers, token Number) Numbers
	Tiny.Updated(Layer.Zeros(16), (1, 1, 1, 1, 1, 1, 1, 1), Layer.Zeros(8), 0) is Layer.Zeros(16)
	let size = norm.Length
	let groups = KeyHeads
	let heads = decays.Length
	let start = token * convolution.Length / 4
	for memory
		let head = (index / (size * size)).Floor
		let column = head * size + index % size
		let decay = decayed(2 * token * heads + head).Exponential
		let change = keyed(start + 2 * groups * size + column) - remembered(column) * decay
		let key = keyed(start + (groups + head % groups) * size + (index / size).Floor % size)
		value * decay + key * change * decayed((2 * token + 1) * heads + head)
Read(keyed Numbers, token Number, part Number) Numbers
	Tiny.Read(Layer.Zeros(16), 0, 0) is Layer.Zeros(8)
	Tiny.Read(Layer.Zeros(16), 0, 1).Length is 8
	let size = norm.Length
	let groups = KeyHeads
	for decays.Length * size
		let head = (index / size).Floor
		let first = token * convolution.Length / 4 + (part * groups + (head % groups)) * size
		let column = head * size * size + (index % size)
		mutable sum = 0
		for size
			sum = sum + keyed(first + index) * memory(column + index * size)
		sum
Gated(raw Numbers, combined Numbers) Numbers
	Tiny.Gated(Layer.Zeros(8), Layer.Zeros(32)) is Layer.Zeros(8)
	let size = norm.Length
	let values = decays.Length * size
	let width = combined.Length * values / raw.Length
	for raw
		let gate = combined((index / values).Floor * width + convolution.Length / 4 + index % values)
		let scale = Qwen3Block.HeadScale(raw, (index / size).Floor * size, size, Qwen3Block.Epsilon)
		value * scale * norm(index % size) * gate / (1 + (0 - gate).Exponential)
Output(input Numbers) Numbers
	Tiny.Cached(Tiny.Combined(Rows(1))).Output(Rows(1)).Length is 8
	let attended = Batch(projection.weights, input).Sums(merged)
	experts.Added(Qwen3Block.Normalized(attended, 0, attended.Length, mlpNorm), attended)
