has router Layer
has expansions List(Layer)
has contractions List(Layer)
has used Number
has gateUps List(Numbers) = List(Numbers)
has downs List(Numbers) = List(Numbers)
constant Model = Gguf("NeuralNetworks/tinyqwen3moe.gguf")
constant Tiny = Experts.Loaded(Model, "blk.0.")
constant Single = Experts.Dense(Tiny.expansions.First, Tiny.contractions.First)
constant Probe = (0.5, -1, 1.5, 2, -0.25, 0.75, 1, -2)
constant Gating = Tiny.Gated(Tiny.Expanded((1, 3), Probe), 4)
constant Pairs = (1, 3, 0, 1)
constant Twice = Probe + Probe.Reverse
constant Sharing = Single.expansions + Single.contractions + Layer(List(Numbers) + Probe.Reverse, Layer.Unbiased)
Loaded(model Gguf, prefix Text) Experts
	Tiny.expansions.Length is 4
	Tiny.expansions.First.weights.Length is 8
	Tiny.used is 2
	let routed = Routed(model, prefix)
	let count = routed.router.weights.Length
	let joined = Flattened(Joined(model, prefix, count))
	let contracting = model.Rows(prefix + "ffn_down_exps.weight")
	Experts(routed.router, Stacked(joined, count), Stacked(contracting, count), routed.used, joined, contracting)
Routed(model Gguf, prefix Text) Experts
	Experts.Routed(Model, "blk.0.").router is Tiny.router
	Experts.Routed(Model, "blk.0.").expansions.Length is 0
	let architecture = model.Value("general.architecture")
	let count = model.Value(architecture + ".expert_count") to Number
	let routing = Layer(model.Rows(prefix + "ffn_gate_inp.weight"), Layer.Zeros(count))
	Experts(routing, List(Layer), List(Layer), model.Value(architecture + ".expert_used_count") to Number)
Dense(expansion Layer, contraction Layer) Experts
	Experts.Dense(Tiny.expansions.First, Tiny.contractions.First).Forward(Probe) is Tiny.Expert(0, Probe)
	Experts(Layer(List(Numbers), List(Number)), List(Layer) + expansion, List(Layer) + contraction, 1)
Stacked(rows List(Numbers), count Number) List(Layer)
	Tiny.Stacked(((1, 2), (3, 4), (5, 6), (7, 8)), 2).Last.weights is ((5, 6), (7, 8))
	let size = rows.Length / count
	let zeros = Layer.Zeros(size)
	for count
		Layer(rows.Slice(index * size, size), zeros)
Joined(model Gguf, prefix Text, count Number) List(Layer)
	Tiny.Joined(Model, "blk.0.", 4).First.weights.Length is 8
	let gates = Stacked(model.Rows(prefix + "ffn_gate_exps.weight"), count)
	let ups = Stacked(model.Rows(prefix + "ffn_up_exps.weight"), count)
	let zeros = gates.First.biases + ups.First.biases
	for gates
		Layer(value.weights + ups(index).weights, zeros)
Flattened(layers List(Layer)) List(Numbers)
	Tiny.Flattened(Tiny.contractions).Length is 32
	Tiny.Flattened(Tiny.expansions)(8) is Tiny.expansions(1).weights.First
	mutable rows = List(Numbers)
	for layers
		rows = rows + value.weights
	rows
Forward(input Numbers) Numbers
	Tiny.Forward(Probe).First.IsNearlyEqual(0.4825967035647183, 0.000001)
	Tiny.Forward(Probe).Last.IsNearlyEqual(-0.4171537353010468, 0.000001)
	Tiny.Forward(Probe + Probe).Last is Tiny.Forward(Probe).Last
	Tiny.Forward(Twice)(8).IsNearlyEqual(Tiny.Forward(Probe.Reverse).First, 0.000001)
	if router.weights.Length is 0
		return Expert(0, input)
	let scores = Batch(router.weights, router.biases).Sums(input)
	let chosen = Routing(scores, router.weights.Length).Chosen(used)
	if chosen.Length >= Grouping.Fewest
		return Mixed(scores, chosen, Grouped(chosen, input))
	let size = expansions.First.weights.Length / 2
	Mixed(scores, chosen, Contracted(chosen, Gated(Expanded(chosen, input), size), size))
Added(input Numbers, residual Numbers) Numbers
	Tiny.Added(Probe, Probe).First.IsNearlyEqual(0.9825967035647183, 0.000001)
	Single.Added(Probe, Probe) is Gpt2Block.Added(Probe, Tiny.Expert(0, Probe))
	if router.weights.Length > 0
		return Gpt2Block.Added(residual, Forward(input))
	let expanded = Batch(expansions.First.weights, expansions.First.biases).Sums(input)
	Batch(contractions.First.weights, residual).Sums(Gated(expanded, expansions.First.weights.Length / 2))
Shared(layers List(Layer), input Numbers) Numbers
	Tiny.Shared(Sharing, Probe).First.IsNearlyEqual(0.060086650174007626 * Tiny.Expert(0, Probe).First, 0.000001)
	Tiny.Shared(Sharing, Probe).Last.IsNearlyEqual(0.060086650174007626 * Tiny.Expert(0, Probe).Last, 0.000001)
	let scale = Activation.Sigmoid.Output(layers.Last.Sums(input).First)
	Experts.Dense(layers.First, layers(1)).Expert(0, input) * scale
Expanded(chosen Numbers, input Numbers) Numbers
	Tiny.Expanded((1, 3), Probe).Length is 16
	Tiny.Expanded((1, 3), Probe).Last is Tiny.expansions(3).Sums(Probe).Last
	let size = expansions.First.weights.Length
	let hidden = contractions.First.weights.Length
	for chosen.Length * size
		let slot = (index / size).Floor
		Batch.Dot(gateUps(chosen(slot) * size + index % size), 0, input, (slot / used).Floor * hidden)
Contracted(chosen Numbers, gated Numbers, size Number) Numbers
	Tiny.Contracted((1, 3), Gating, 4).Last.IsNearlyEqual(Tiny.Expert(3, Probe).Last)
	let hidden = contractions.First.weights.Length
	for chosen.Length * hidden
		let expert = (index / hidden).Floor
		Batch.Dot(downs(chosen(expert) * hidden + index % hidden), 0, gated, expert * size)
Grouped(chosen Numbers, input Numbers) Numbers
	Tiny.Grouped(Pairs, Twice) is Tiny.Contracted(Pairs, Tiny.Gated(Tiny.Expanded(Pairs, Twice), 4), 4)
	let grouping = Grouping(chosen, router.weights.Length, used, Batch.Tile)
	let starts = grouping.Starts
	let rows = grouping.Rows
	let positions = grouping.Positions(starts)
	let size = expansions.First.weights.Length
	let hidden = contractions.First.weights.Length
	let gathered = grouping.Gathered(input, grouping.Ordered(positions, rows))
	let expanded = Batch(gateUps, List(Number) + 0).Grouped(grouping.Bases(starts, rows, size), size, gathered)
	let gated = Gated(expanded, size / 2)
	let contracted = Batch(downs, List(Number) + 0).Grouped(grouping.Bases(starts, rows, hidden), hidden, gated)
	grouping.Unsorted(contracted, positions, hidden)
Mixed(scores Numbers, chosen Numbers, contracted Numbers) Numbers
	Tiny.Mixed((0, 1, 0, 1), (1, 3), (2, 2, 4, 4)) is (3, 3)
	Tiny.Mixed((0, 1, 0, 1, 1, 0, 0, 0), (1, 3, 0, 1), (2, 2, 4, 4, 1, 1, 3, 3)).Last.IsNearlyEqual(1.537883)
	let hidden = contracted.Length / chosen.Length
	let experts = scores.Length * used / chosen.Length
	for chosen.Length / used * hidden
		Blended(scores, chosen, contracted, (index / hidden).Floor, index % hidden, experts)
Blended(scores Numbers, chosen Numbers, contracted Numbers, token Number, output Number, experts Number) Number
	Tiny.Blended((0, 1, 0, 1), (1, 3), (2, 2, 4, 4), 0, 1, 4) is 3
	let hidden = contracted.Length / chosen.Length
	let top = scores(token * experts + chosen(token * used))
	mutable total = 0
	mutable sum = 0
	for used
		let share = (scores(token * experts + chosen(token * used + index)) - top).Exponential
		total = total + share
		sum = sum + share * contracted((token * used + index) * hidden + output)
	sum / total
Expert(chosen Number, input Numbers) Numbers
	Tiny.Expert(0, Probe).Length is 8
	let expanded = expansions(chosen).Sums(input)
	contractions(chosen).Sums(Gated(expanded, expanded.Length / 2))
Gated(expanded Numbers, size Number) Numbers
	Tiny.Gated((0, 1), 1) is List(Number) + 0
	Tiny.Gated((1, 2, 1, 3), 1).Last.IsNearlyEqual(2.193176)
	for expanded.Length / 2
		let first = (index / size).Floor * 2 * size + index % size
		expanded(first) / (1 + (-expanded(first)).Exponential) * expanded(first + size)
