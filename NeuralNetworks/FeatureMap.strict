has values Numbers
has width Number
has channels Number
has offsets Numbers
constant Square = FeatureMap((1, 2, 3, 4), 2, 1, List(Number) + 0)
constant Plain = (1, 0)
Height Number
	Square.Height is 2
	values.Length / width / channels
Padded(affine Numbers, swish Boolean) Numbers
	Square.Padded(Plain, false) is (0, 0, 0, 0, 0, 1, 2, 0, 0, 3, 4, 0, 0, 0, 0, 0)
	Square.Padded((2, 1), true)(10).IsNearlyEqual(8.9988895)
	FeatureMap((1, 2, 3, 4), 1, 2, (0, 0)).Padded((1, 1, 0, 0), false)(15) is 4
	let columns = width + 2
	for (Height + 2) * columns * channels
		let row = (index / (columns * channels)).Floor - 1
		let column = (index / channels).Floor % columns - 1
		let channel = index % channels
		let inside = row >= 0 and row < Height and column >= 0 and column < width
		let number = inside then values(index - (columns + 1 + 2 * row) * channels) else 0
		inside then Activated(number, affine(channel), affine(channels + channel), swish) else 0
Activated(number Number, scale Number, shift Number, swish Boolean) Number
	Square.Activated(2, 3, -5, false) is 1
	Square.Activated(0.5, 2, 0, true).IsNearlyEqual(0.7310585786300049)
	let normed = number * scale + shift
	swish then normed / (1 + (0 - normed).Exponential) else normed
Identity Numbers
	Square.Identity is (1, 0)
	FeatureMap((1, 2), 1, 2, (3, 4)).Identity is (1, 1, 3, 4)
	for 2 * channels
		index < channels then 1 else offsets(index - channels)
Plus(other FeatureMap) FeatureMap
	Square.Plus(FeatureMap((1, 1, 1, 1), 2, 1, List(Number) + 3)) is FeatureMap((2, 3, 4, 5), 2, 1, List(Number) + 3)
	FeatureMap(Gpt2Block.Added(values, other.values), width, channels, Gpt2Block.Added(offsets, other.offsets))
Applied(affine Numbers, swish Boolean) FeatureMap
	FeatureMap((1, 2), 1, 2, (0, 0)).Applied((2, 1, 0.5, 0), false) is FeatureMap((2.5, 2), 1, 2, (0, 0))
	FeatureMap(Activations(affine, swish), width, channels, Layer.Zeros(channels))
Activations(affine Numbers, swish Boolean) Numbers
	Square.Activations((2, 1), true)(1).IsNearlyEqual(4.9665330)
	for values
		Activated(value, affine(index % channels), affine(channels + index % channels), swish)
Completed Numbers
	FeatureMap((1, 2, 3, 4), 1, 2, (1, -1)).Completed is (2, 1, 4, 3)
	for values
		value + offsets(index % channels)
Runs Number
	Square.Runs is 1
	(values.Length / channels / 1024).Ceiling
Partials(groups Number, centers Numbers, squared Boolean) Numbers
	FeatureMap((1, 2, 3, 6), 1, 2, (0, 0)).Partials(2, (0, 0), false) is (4, 8)
	FeatureMap((1, 2, 3, 6), 1, 2, (0, 0)).Partials(2, (2, 4), true) is (2, 8)
	let size = channels / groups
	for Runs * channels
		let first = (index / channels).Floor * 1024
		let channel = index % channels
		let shift = offsets(channel) - centers((channel / size).Floor)
		Run(first * channels + channel, (values.Length / channels - first).Clamp(0, 1024), shift, squared)
Run(start Number, count Number, shift Number, squared Boolean) Number
	FeatureMap((1, 2, 3, 6), 1, 2, (0, 0)).Run(1, 2, -4, true) is 8
	mutable sum = 0
	for count
		let difference = values(start + index * channels) + shift
		sum = sum + difference * (squared then difference else 1)
	sum