has number
from(unrounded Number)
	Float32(1) is 1
	Float32(0.1) is 0.100000001490116119384765625
	Float32(16777217) is 16777216
	Float32(-300.5) is -300.5
	Float32(0) is 0
	Rounded(unrounded, 23)
Rounded(unrounded Number, mantissa Number) Number
	Float32.Rounded(1.00390625, 7) is 1
	Float32.Rounded(41473, 7) is 41472
	let exponent = unrounded is 0 then 0 else (unrounded.Absolute.Logarithm / 2.Logarithm).Floor
	let step = 2 ^ (exponent - mantissa)
	(unrounded / step).Counted("Even") * step
