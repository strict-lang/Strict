constant Prompt = "Alan Turing theorized that computers would one day become"
constant Tries = 3
Run(path Text, count Number, repeats = 1, batch = 1)
	if MachineUse.Weights("Gemma4Benchmark", path).IsAdmitted
		Benchmark(path, count, repeats, batch)
Benchmark(path Text, count Number, repeats Number, batch Number) slow
	tokenizer = GemmaTokens.Loaded(Gguf(path))
	started = Process.Elapsed
	model = Gemma4.Loaded(path)
	loaded = Process.Elapsed
	prompt = Qwen3Benchmark.Repeat(tokenizer.Encode(Prompt), repeats)
	logger.Log(Prompt + tokenizer.Decode(Generation(model.Prefilled(prompt, 0)).Continue(prompt.Length, count)))
	prefill = Fastest(model, prompt)
	prefilled = model.Prefilled(prompt, 0)
	durations = Durations(prefilled.Copies(batch), prefilled.Next, prompt.Length, count, batch)
	report = Qwen3Benchmark.Report(prompt.Length, prefill, durations, batch)
	logger.Log(report + ", loaded in " + (loaded - started).Round(1) + " s")
Fastest(model Gemma4, prompt Numbers) Number native
	Gemma4Benchmark.Fastest(Gemma4.Tiny, Gemma4.Prompt) > 0
	mutable fastest = 1000000
	for Tries
		before = Process.Elapsed
		first = model.Prefilled(prompt, 0).Next
		milliseconds = (Process.Elapsed - before) * 1000 / prompt.Length
		fastest = first >= 0 and milliseconds < fastest then milliseconds else fastest
	fastest
Durations(model Gemma4, token Number, start Number, count Number, batch Number) Numbers native
	Gemma4Benchmark.Durations(Gemma4.Tiny.Prefilled(Gemma4.Prompt, 0).Copies(2), 9, 3, 2, 2).Length is 2
	mutable current = model
	mutable chosen = Qwen3Benchmark.Repeat(List(Number) + token, batch)
	mutable last = Process.Elapsed
	for count
		current = current.Steps(chosen, Qwen3Benchmark.Repeat(List(Number) + (start + index), batch), batch)
		chosen = current.Nexts
		GpuMemory.Finished
		duration = (Process.Elapsed - last) * 1000
		last = last + duration / 1000
		duration