has path Text
has bits Number = 32
constant Tiny = Gguf("NeuralNetworks/tiny.gguf")
constant Quants = Gguf("NeuralNetworks/quants.gguf")
constant Split = Gguf("NeuralNetworks/tinysplit-00001-of-00003.gguf")
constant Mixture = Gguf("NeuralNetworks/experts.gguf")
constant Down = "blk.1.ffn_down_exps.weight"
constant Routed = Mixture.Values("blk.0.ffn_gate_inp.weight").Slice(0, 256)
constant Reversed = Routed.Reverse
constant Tokens = Routed + Reversed
Value(key Text) Text
	Tiny.Value("general.architecture") is "qwen3"
	Tiny.Value("qwen3.block_count") is "1"
	Tiny.Value("qwen3.rope.freq_base") is "1000000"
	Tiny.Value("tokenizer.ggml.tokens").Lines is ("a", "b", "c", "Ġ", "ab", "Ġc")
	Tiny.Value("missing") is ""
	Split.Value("general.architecture") is "qwen3"
	GgufFile.Value(path, key)
Shape(name Text) Numbers
	Tiny.Shape("m") is (2, 3)
	Tiny.Shape("missing").Length is 0
	GgufFile.Shape(path, name)
Values(name Text) Slow(Numbers)
	(Tiny.Values("v"), Split.Values("v")) is ((0.5, -1.5, 2.25), (0.5, -1.5, 2.25))
	(Tiny.Values("h"), Tiny.Values("b")) is ((1, 2, 3, 4, 5, 6), (1, 2, 3, 4, 5, 6))
	Tiny.Values("missing") is Error
	(Tiny.Values("k4").Sum, Tiny.Values("k6").Sum) is (31000.5, 238.25)
	(Tiny.Values("k4").First, Tiny.Values("k6").Last) is (55.75, 36.125)
	(Quants.Values("q5_1").Sum, Quants.Values("q5_1")(5), Quants.Values("q5_1")(37)) is (1237.5, 6.5, 3)
	(Quants.Values("q5_k").Sum, Quants.Values("q5_k")(5), Quants.Values("q5_k")(37)) is (2759.328125, 17.921875, 6.390625)
	(Quants.Values("iq4_nl").Sum, Quants.Values("iq4_nl")(5), Quants.Values("iq4_nl")(37)) is (26.5, 9.5, -11)
	(Quants.Values("ptq1_0").Sum, Quants.Values("ptq1_0")(81), Quants.Values("ptq1_0")(130)) is (4.5, 0.5, -1.5)
	Quants.Values("pq2_0") is Quants.Values("ptq1_0")
	(Quants.Values("q2_0")(64), Quants.Values("q2_0")(65), Quants.Values("q2_0").Last) is (-1.5, 1.5, 3)
	GgufFile.Values(path, name)
Rows(name Text) Slow(List(Numbers))
	Tiny.Rows("m") is ((1, 2, 3), (4, 5, 6))
	Split.Rows("r6") is Tiny.Rows("r6")
	Gguf("NeuralNetworks/tiny.gguf", 16).Rows("h") is ((1, 2, 3), (4, 5, 6))
	Gguf("NeuralNetworks/tiny.gguf", 8).Rows("q") is Tiny.Rows("q")
	Gguf("NeuralNetworks/tiny.gguf", 4).Rows("r4") is Tiny.Rows("r4")
	Gguf("NeuralNetworks/tiny.gguf", 4).Rows("r6") is Tiny.Rows("r6")
	Gguf("NeuralNetworks/tiny.gguf", 4).Rows("r2") is Tiny.Rows("r2")
	Gguf("NeuralNetworks/tiny.gguf", 4).Rows("p2") is Tiny.Rows("r2")
	Gguf("NeuralNetworks/tiny.gguf", 4).Rows("p3") is Gguf("NeuralNetworks/tiny.gguf", 8).Rows("p3")
	Gguf("NeuralNetworks/tiny.gguf", 2).Rows("r2") is Error
	Gguf("NeuralNetworks/tinyqwen3moe.gguf").Rows("blk.0.ffn_gate_exps.weight").Length is 16
	GgufFile.Rows(path, name, bits)
Picked(name Text, rows Numbers) Numbers
	Tiny.Picked("m", (1, 0)) is (4, 5, 6, 1, 2, 3)
	Mixture.Picked(Down, (300, 2)) is Mixture.Rows(Down)(300) + Mixture.Rows(Down)(2)
	Tiny.Picked("m", List(Number) + 2) is Error
	GgufFile.Picked(path, name, rows)
ExpertOutputs(prefix Text, chosen Numbers, input Numbers) Numbers
	Mixture.ExpertOutputs("blk.0.", (1, 0), Routed).Length is 512
	Mixture.ExpertOutputs("blk.0.", (1, 0), Routed)(5).IsNearlyEqual(-21.617, 0.05)
	Mixture.ExpertOutputs("blk.0.", (1, 0), Routed)(261).IsNearlyEqual(12.111, 0.05)
	Mixture.ExpertOutputs("blk.1.", (1, 0), Routed)(261).IsNearlyEqual(100.175, 0.05)
	Mixture.ExpertOutputs("blk.0.", (2), Routed) is Error
	Mixture.ExpertOutputs("blk.0.", (1, 0, 0, 1), Tokens)(773) is Mixture.ExpertOutputs("blk.0.", (0, 1), Reversed)(261)
	GgufFile.ExpertOutputs(path, prefix, chosen, input)
