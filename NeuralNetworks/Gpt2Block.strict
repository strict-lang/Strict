has attentionGain Numbers
has attentionBias Numbers
has attention Layer
has projection Layer
has mlpGain Numbers
has mlpBias Numbers
has expansion Layer
has contraction Layer
has keys Numbers = List(Number)
has values Numbers = List(Number)
has queries Numbers = List(Number)
constant Heads = 12
constant Weights = Safetensors("NeuralNetworks/tinygpt2.safetensors")
constant Tiny = Gpt2Block.Loaded(Weights, "h.0.")
constant Embedded = Weights.Rows("wte.weight").First
Loaded(weights Safetensors, prefix Text) Slow(Gpt2Block)
	Tiny.attention.weights.Length is 36
	Tiny.attention.weights.First.Length is 12
	let combine = Dense(weights, prefix + "attn.c_attn")
	let project = Dense(weights, prefix + "attn.c_proj")
	let first = (weights.Values(prefix + "ln_1.weight"), weights.Values(prefix + "ln_1.bias"))
	let second = (weights.Values(prefix + "ln_2.weight"), weights.Values(prefix + "ln_2.bias"))
	let expand = Dense(weights, prefix + "mlp.c_fc")
	let contract = Dense(weights, prefix + "mlp.c_proj")
	Gpt2Block(first(0), first(1), combine, project, second(0), second(1), expand, contract)
Dense(weights Safetensors, name Text) Slow(Layer)
	Tiny.Dense(Weights, "h.0.mlp.c_fc").biases.Length is 48
	Layer(weights.Columns(name + ".weight"), weights.Values(name + ".bias"))
Cached(input Numbers) Slow(Gpt2Block)
	Tiny.Cached(Embedded).keys.Length is 12
	Tiny.Cached(Embedded).Cached(Embedded).values.Length is 24
	let combined = attention.Sums(Normalized(input, attentionGain, attentionBias))
	let size = combined.Length / 3
	let keyed = Safetensors.Part(combined, size, size, 1)
	let valued = Safetensors.Part(combined, 2 * size, size, 1)
	Gpt2Block(value, keys = keys + keyed, values = values + valued, queries = Safetensors.Part(combined, 0, size, 1))
Output(input Numbers) Slow(Numbers)
	Tiny.Cached(Embedded).Output(Embedded).Length is 12
	let attended = Attended(input)
	Contracted(attended, Activated(attended))
Attended(input Numbers) Numbers
	Tiny.Cached(Embedded).Attended(Embedded).Length is 12
	let merged = Attention(queries, keys, values, Heads, Heads, queries.Length / Heads, 1).Merged
	Added(input, projection.Sums(merged))
Activated(attended Numbers) Numbers
	Tiny.Activated(Embedded).Length is 48
	Gelu(expansion.Sums(Normalized(attended, mlpGain, mlpBias)))
Contracted(attended Numbers, activated Numbers) Numbers
	Tiny.Contracted(Embedded, Tiny.Activated(Embedded)).Length is 12
	Added(attended, contraction.Sums(activated))
Vectors List(Numbers)
	Tiny.Vectors.Length is 8
	Tiny.Vectors(2).Length is 36
	let combined = (attentionGain, attentionBias, attention.biases, projection.biases)
	combined + (mlpGain, mlpBias, expansion.biases, contraction.biases)
Changed(vectors List(Numbers), first Number) Gpt2Block
	Tiny.Changed(Tiny.Vectors, 0).Vectors is Tiny.Vectors
	let combine = Layer(attention.weights, vectors(first + 2))
	let project = Layer(projection.weights, vectors(first + 3))
	let expand = Layer(expansion.weights, vectors(first + 6))
	let contract = Layer(contraction.weights, vectors(first + 7))
	let second = (vectors(first + 4), vectors(first + 5))
	Gpt2Block(vectors(first), vectors(first + 1), combine, project, second(0), second(1), expand, contract)
Normalized(input Numbers, gain Numbers, bias Numbers, epsilon = 0.00001) Numbers
	Tiny.Normalized((1, 2, 3), (1, 1, 1), (0, 0, 1)).First.IsNearlyEqual(-1.2247356859083902)
	Tiny.Normalized((1, 2, 3), (1, 1, 1), (0, 0, 1)).Last.IsNearlyEqual(2.2247356859083902)
	let size = gain.Length
	let centered = Centered(input, size)
	for centered.Length
		let first = (index / size).Floor * size
		let scale = Normalization.Scale(Normalization.Squared(centered, first, size), size, epsilon)
		gain(index % size) * centered(index) * scale + bias(index % size)
Centered(input Numbers, size Number) Numbers
	Tiny.Centered((1, 2, 4, 8), 2) is (-0.5, 0.5, -2, 2)
	for input.Length
		input(index) - Mean(input, (index / size).Floor * size, size)
Mean(input Numbers, first Number, size Number) Number
	Tiny.Mean((1, 2, 4, 8), 2, 2) is 6
	mutable sum = 0
	for size
		sum = sum + input(first + index)
	sum / size
Gelu(input Numbers) Numbers
	Tiny.Gelu((0, 1)).Last.IsNearlyEqual(0.8411919906082768)
	for input
		let inner = 0.7978845608028654 * (value + 0.044715 * value * value * value)
		0.5 * value * (1 + Activation.Tanh.Output(inner))
Added(left Numbers, right Numbers) Numbers
	Tiny.Added((1, 2), (3, 4)) is (4, 6)
	for left
		value + right(index)