has attentionGain Numbers
has attentionBias Numbers
has attention Layer
has projection Layer
has mlpGain Numbers
has mlpBias Numbers
has expansion Layer
has contraction Layer
has keys Numbers = List(Number)
has values Numbers = List(Number)
has queries Numbers = List(Number)
constant Heads = 12
constant Weights = Safetensors("NeuralNetworks/tinygpt2.safetensors")
constant Tiny = Gpt2Block.Loaded(Weights, "h.0.")
constant Embedded = Weights.Rows("wte.weight").First
Loaded(weights Safetensors, prefix Text) Gpt2Block slow
	Tiny.attention.weights.Length is 36
	Tiny.attention.weights.First.Length is 12
	combine = Dense(weights, prefix + "attn.c_attn")
	project = Dense(weights, prefix + "attn.c_proj")
	first = (weights.Values(prefix + "ln_1.weight"), weights.Values(prefix + "ln_1.bias"))
	second = (weights.Values(prefix + "ln_2.weight"), weights.Values(prefix + "ln_2.bias"))
	expand = Dense(weights, prefix + "mlp.c_fc")
	contract = Dense(weights, prefix + "mlp.c_proj")
	Gpt2Block(first(0), first(1), combine, project, second(0), second(1), expand, contract)
Dense(weights Safetensors, name Text) Layer slow
	Tiny.Dense(Weights, "h.0.mlp.c_fc").biases.Length is 48
	Layer(weights.Columns(name + ".weight"), weights.Values(name + ".bias"))
Cached(input Numbers) Gpt2Block slow
	Tiny.Cached(Embedded).keys.Length is 12
	Tiny.Cached(Embedded).Cached(Embedded).values.Length is 24
	combined = attention.Sums(Normalize(input, attentionGain, attentionBias))
	size = combined.Length / 3
	keyed = Safetensors.Part(combined, size, size, 1)
	valued = Safetensors.Part(combined, 2 * size, size, 1)
	Gpt2Block(value, keys = keys + keyed, values = values + valued, queries = Safetensors.Part(combined, 0, size, 1))
Output(input Numbers) Numbers slow
	Tiny.Cached(Embedded).Output(Embedded).Length is 12
	attended = Attend(input)
	Contract(attended, Activate(attended))
Attend(input Numbers) Numbers
	Tiny.Cached(Embedded).Attend(Embedded).Length is 12
	Add(input, projection.Sums(Attention(queries, keys, values, Heads, Heads, queries.Length / Heads, 1).Merged))
Activate(attended Numbers) Numbers
	Tiny.Activate(Embedded).Length is 48
	Gelu(expansion.Sums(Normalize(attended, mlpGain, mlpBias)))
Contract(attended Numbers, activated Numbers) Numbers
	Tiny.Contract(Embedded, Tiny.Activate(Embedded)).Length is 12
	Add(attended, contraction.Sums(activated))
Vectors List(Numbers)
	Tiny.Vectors.Length is 8
	Tiny.Vectors(2).Length is 36
	combined = (attentionGain, attentionBias, attention.biases, projection.biases)
	combined + (mlpGain, mlpBias, expansion.biases, contraction.biases)
Changed(vectors List(Numbers), first Number) Gpt2Block
	Tiny.Changed(Tiny.Vectors, 0).Vectors is Tiny.Vectors
	combine = Layer(attention.weights, vectors(first + 2))
	project = Layer(projection.weights, vectors(first + 3))
	expand = Layer(expansion.weights, vectors(first + 6))
	contract = Layer(contraction.weights, vectors(first + 7))
	second = (vectors(first + 4), vectors(first + 5))
	Gpt2Block(vectors(first), vectors(first + 1), combine, project, second(0), second(1), expand, contract)
Normalize(input Numbers, gain Numbers, bias Numbers, epsilon = 0.00001) Numbers
	Tiny.Normalize((1, 2, 3), (1, 1, 1), (0, 0, 1)).First.IsNearlyEqual(-1.2247356859083902)
	Tiny.Normalize((1, 2, 3), (1, 1, 1), (0, 0, 1)).Last.IsNearlyEqual(2.2247356859083902)
	size = gain.Length
	centered = Center(input, size)
	for centered.Length
		scale = Normalization.Scale(Normalization.Square(centered, (index / size).Floor * size, size), size, epsilon)
		gain(index % size) * centered(index) * scale + bias(index % size)
Center(input Numbers, size Number) Numbers
	Tiny.Center((1, 2, 4, 8), 2) is (-0.5, 0.5, -2, 2)
	for input.Length
		input(index) - Mean(input, (index / size).Floor * size, size)
Mean(input Numbers with value.Bits is 32, first Number, size Number) Number
	Tiny.Mean((1, 2, 4, 8), 2, 2) is 6
	mutable sum = 0
	for size
		sum = sum + input(first + index)
	sum / size
Gelu(input Numbers) Numbers
	Tiny.Gelu((0, 1)).Last.IsNearlyEqual(0.8411919906082768)
	for input
		inner = Activation.GeluScale * (value + Activation.GeluCubic * value * value * value)
		0.5 * value * (1 + Activation.Tanh.Output(inner))
Add(left Numbers, right Numbers) Numbers
	Tiny.Add((1, 2), (3, 4)) is (4, 6)
	for left
		value + right(index)