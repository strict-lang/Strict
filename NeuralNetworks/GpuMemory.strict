Trim
Evict
Yield
Finish
Held Number
	GpuMemory.Held >= 0
	0
Freed(bytes Number)
Address(numbers Numbers) Number
	GpuMemory.Address((1, 2, 3)) is 0
	numbers.Length * 0
Available Number
	GpuMemory.Available >= 0
	0
IsLockFree Boolean
	GpuMemory.IsLockFree or GpuMemory.IsLockFree is false
	true
HostAvailable Number
	GpuMemory.HostAvailable >= 0
	0
HostTotal Number
	GpuMemory.HostTotal >= 0
	0
Stamped Number
	GpuMemory.Stamped >= -1
	Number.NotFound
Elapse(first Number, last Number) Number
	GpuMemory.Elapse(-1, -1) is -1
	first < 0 or last < 0 then Number.NotFound else last - first
Tune(rows List(Numbers), downs Numbers, ups Numbers, scales Numbers) List(Numbers)
	GpuMemory.Tune(Safetensors.Bytes.Quantize("a"), List(Number), List(Number), List(Number)).Length is 4
	GpuMemory.Tune(Safetensors.Bytes.Quantize("a"), (1, 0), (1, 0), List(Number) + 1).Length is 0
	downs.Length is 0 and ups.Length is 0 and scales.Length is 0 then rows else List(Numbers)
