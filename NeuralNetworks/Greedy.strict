Largest(logits Numbers) Number
	Greedy.Largest((1, 3, 2)) is 1
	let best = Best(logits, 128, logits.Length)
	best(2 * Chosen(best, 0, best.Length / 2) + 1)
Best(scores Numbers, width Number, length Number) Numbers
	Greedy.Best((1, 3, 2, 0), 2, 4) is (3, 1, 2, 2)
	Greedy.Best((1, 3, 2), 2, 3) is (3, 1, 2, 2)
	Greedy.Best((1, 3, 2, 5, 4, 0), 2, 3) is (3, 1, 2, 2, 5, 3, 0, 5)
	let chunks = (length / width).Ceiling
	for 2 * chunks * scores.Length / length
		let chunk = (index / 2).Floor
		let start = (chunk / chunks).Floor * length + (chunk % chunks) * width
		let position = Position(scores, start, (length - (chunk % chunks) * width).Clamp(0, width))
		index % 2 is 1 then position else scores(position)
Position(scores Numbers, start Number, count Number) Number
	Greedy.Position((1, 3, 2, 5), 0, 3) is 1
	mutable largest = scores(start)
	mutable position = start
	for count
		position = Above(scores(start + index), largest, start + index, position)
		largest = Softmax.Larger(largest, scores(start + index))
	position
Maxima(pairs Numbers) Numbers
	Greedy.Maxima((3, 1, 2, 2)) is (3, 2)
	for pairs.Length / 2
		pairs(2 * index)
Above(number Number, limit Number, chosen Number, otherwise Number) Number
	Greedy.Above(2, 1, 5, 6) is 5
	Greedy.Above(1, 1, 5, 6) is 6
	number > limit then chosen else otherwise
Chosen(pairs Numbers, first Number, count Number) Number
	Greedy.Chosen((1, 0, 3, 1, 2, 2), 0, 3) is 1
	Greedy.Chosen((1, 0, 3, 1, 2, 2, 5, 3), 2, 2) is 3
	mutable chosen = first
	for count
		if pairs(2 * (first + index)) > pairs(2 * chosen)
			chosen = first + index
	chosen
Rows(logits Numbers, vocabulary Number) Numbers
	Greedy.Rows((1, 3, 2, 5, 4, 0), 3) is (1, 0)
	let width = vocabulary % 128 is 0 then 128 else vocabulary
	let best = Best(logits, width, vocabulary)
	let groups = vocabulary / width
	let second = Best(Maxima(best), 128, groups)
	let third = Best(Maxima(second), 128, (groups / 128).Ceiling)
	for logits.Length / vocabulary
		best(2 * second(2 * third(2 * index + 1) + 1) + 1) - index * vocabulary
Accepted(draft Numbers, predictions Numbers) Number
	Greedy.Accepted((4, 5, 6), (4, 5, 7, 9)) is 2
	Greedy.Accepted((4, 5), (3, 5, 1)) is 0
	mutable count = 0
	for draft
		count = (count is index) and (value is predictions(index)) then count + 1 else count
	count
