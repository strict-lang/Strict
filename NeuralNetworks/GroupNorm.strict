has weights Numbers
has biases Numbers
has groups Number
constant Epsilon = 0.000001
constant Pair = GroupNorm((1, 1), (0, 0), 2)
constant Column = FeatureMap((1, 2, 3, 6), 1, 2, (0, 0))
Affine(map FeatureMap) Float32s
	Pair.Affine(Column)(1).IsNearlyEqual(0.5)
	Pair.Affine(Column)(3).IsNearlyEqual(-2)
	GroupNorm((1, 1), (0, 0), 1).Affine(Column)(0).IsNearlyEqual(1 / 3.5.SquareRoot)
	GroupNorm((2, 1), (0.5, 0), 2).Affine(FeatureMap(Column.values, 1, 2, (1, 0)))(2).IsNearlyEqual(-3.499998)
	let means = Means(map)
	Scaled(means, Variances(map, means), map.offsets)
Scaled(means Numbers, variances Numbers, offsets Numbers) Float32s
	Pair.Scaled((2, 4), (1, 4), (0, 0))(3).IsNearlyEqual(-2)
	let perGroup = offsets.Length / groups
	for 2 * offsets.Length
		let channel = index % offsets.Length
		let group = (channel / perGroup).Floor
		let scale = weights(channel) / (variances(group) + Epsilon).SquareRoot
		index < offsets.Length then scale else biases(channel) + (offsets(channel) - means(group)) * scale
Means(map FeatureMap) Float32s
	Pair.Means(Column) is (2, 4)
	Pair.Means(FeatureMap(Column.values, 1, 2, (1, 0))) is (3, 4)
	Averages(map.Partials(groups, Layer.Zeros(groups), false), map.Runs, map.values.Length / groups)
Variances(map FeatureMap, means Numbers) Float32s
	Pair.Variances(Column, (2, 4)) is (1, 4)
	GroupNorm((1, 1), (0, 0), 1).Variances(Column, List(Number) + 3) is List(Number) + 3.5
	Averages(map.Partials(groups, means, true), map.Runs, map.values.Length / groups)
Averages(partials Numbers, rows Number, count Number) Float32s
	Pair.Averages((1, 2, 3, 6), 2, 2) is (2, 4)
	GroupNorm((1, 1), (0, 0), 1).Averages((1, 2, 3, 6), 2, 4) is List(Number) + 3
	let size = partials.Length / rows / groups
	for groups
		let group = index
		mutable sum = 0
		for rows
			let start = index * size * groups + group * size
			for size
				sum = sum + partials(start + index)
		sum / count
