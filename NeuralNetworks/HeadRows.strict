has size Number
has rotary Number
has heads Number
constant Partial = HeadRows(4, 2, 1)
Of(model Gguf, headSize Number, count Number) HeadRows
	HeadRows.Of(Gguf("NeuralNetworks/tinyqwen3.gguf"), 4, 2).rotary is 4
	HeadRows.Of(DeltaBlock.Model, 4, 2).rotary is 2
	let given = model.Value(model.Value("general.architecture") + ".rope.dimension_count")
	HeadRows(headSize, given is "" then headSize else given to Number, count)
Order(position Number) Number
	(HeadRows(8, 4, 1).Order(1), HeadRows(8, 4, 1).Order(2)) is (1, 4)
	(HeadRows(8, 4, 1).Order(4), HeadRows(8, 4, 1).Order(6)) is (2, 6)
	HeadRows(8, 8, 1).Order(5) is 5
	let half = size / 2
	let pairs = rotary / 2
	if position < pairs
		return position
	position < half then position + pairs else (position < half + pairs then position - half + pairs else position)
Permuted(rows List(Numbers)) List(Numbers)
	Partial.Permuted(((0), (1), (2), (3))) is ((0), (2), (1), (3))
	for rows.Length
		rows((index / size).Floor * size + Order(index % size))
Norm(values Numbers) Numbers
	Partial.Norm((5, 6, 7, 8)) is (5, 7, 6, 8)
	for values.Length
		values(Order(index))
Queries(rows List(Numbers)) List(Numbers)
	HeadRows(2, 2, 1).Queries(((1), (2), (3), (4))) is ((1), (2))
	Partial.Queries(((0), (1), (2), (3))) is ((0), (2), (1), (3))
	Permuted(rows.Length is 2 * heads * size then Picked(rows, 0) else rows)
Gates(rows List(Numbers)) List(Numbers)
	HeadRows(2, 2, 1).Gates(((1), (2), (3), (4))) is ((3), (4))
	Partial.Gates(((0), (1), (2), (3))).Length is 0
	rows.Length is 2 * heads * size then Picked(rows, 1) else List(Numbers)
Picked(rows List(Numbers), part Number) List(Numbers)
	HeadRows(1, 1, 2).Picked(((1), (2), (3), (4)), 1) is ((2), (4))
	for heads * size
		rows((index / size).Floor * 2 * size + part * size + index % size)
