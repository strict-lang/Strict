has layers List(DeltaBlock)
has entered Numbers = List(Number)
has gates Numbers = List(Number)
has inputs List(Numbers) = List(Numbers)
constant RewindableTokens = 16
constant None = Hybrid(List(DeltaBlock))
constant Tiny = Hybrid(List(DeltaBlock) + DeltaBlock.Tiny)
constant Block = DeltaBlock.Tiny
constant Single = Tiny.Prepared(Drafter.Rows(1))
Loaded(model Gguf, first Number, count Number, zeros Numbers, basis Basis) Hybrid slow
	Hybrid.Loaded(Drafter.Model, 0, 3, DeltaBlock.Tiny.memory, Basis.None).layers.Length is 3
	sigmoid = model.Value("general.architecture") is "qwen4exp"
	mutable loaded = List(Mutable(DeltaBlock))
	for count
		loaded.Add(DeltaBlock(DeltaBlock.Loaded(model, "blk." + (first + index) + ".", zeros, basis), sigmoidGate = sigmoid))
	Hybrid(loaded)
Memory(model Gguf) Numbers
	Hybrid.Memory(Drafter.Model) is DeltaBlock.Tiny.memory
	architecture = model.Value("general.architecture")
	heads = model.Value(architecture + ".ssm.time_step_rank")
	size = model.Value(architecture + ".ssm.state_size")
	Layer.Zeros(heads is "" then 0 else heads to Number * (size to Number) * (size to Number))
Rewound(before Hybrid, tokens Number) Hybrid
	Tiny.Prepared(Drafter.Pair).Rewound(Tiny, 1).layers(0).memory is Single.layers(0).memory
	mutable rewound = List(Mutable(DeltaBlock))
	for before.layers
		rewound.Add(value.Rewound(Safetensors.Part(inputs(index), 0, tokens * value.Width, 1)))
	Hybrid(value, layers = rewound, inputs = List(Numbers))
Prepared(input Numbers, sequences = 1) Hybrid
	None.Prepared((1, 2)).entered is (1, 2)
	Single.entered(0).IsNearlyEqual(0.54408, 0.00001)
	mutable hidden = input
	mutable stepped = List(Mutable(DeltaBlock))
	mutable combinations = List(Mutable(Numbers))
	for layers
		combined = value.Combine(hidden)
		cached = sequences is 1 then value.Cached(combined) else CacheAll(value, combined, sequences)
		hidden = cached.Output(hidden)
		stepped.Add(DeltaBlock(cached, merged = List(Number)))
		combinations.Add(combined.Length > RewindableTokens * value.Width then List(Number) else combined)
	Hybrid(stepped, hidden, inputs = combinations)
CacheAll(block DeltaBlock, combined Numbers, sequences Number) DeltaBlock
	Tiny.CacheAll(Block, Block.Combine(Drafter.Pair), 2).memory.Length is 2 * Block.memory.Length
	isStep = combined.Length is sequences * block.Width
	isStep then DeltaBatch(block, sequences).Step(combined) else CacheEach(block, combined, sequences)
CacheEach(block DeltaBlock, combined Numbers, sequences Number) DeltaBlock slow
	Tiny.CacheEach(Block, Block.Combine(Drafter.Pair), 2).memory.Length is 2 * Block.memory.Length
	rows = combined.Length / sequences
	memories = block.decays.Length * block.norm.Length * block.norm.Length
	windows = 3 * block.convolution.Length / 4
	mutable parts = List(Mutable(DeltaBlock))
	for sequences
		remembered = DeltaBlock(block, memory = Slot(block.memory, index, memories))
		windowed = DeltaBlock(remembered, window = Slot(block.window, index, windows))
		parts.Add(windowed.Cached(combined.Slice(index * rows, rows)))
	Join(block, parts)
Slot(state Numbers, sequence Number, size Number) Numbers
	Tiny.Slot((1, 2, 3, 4), 1, 2) is (3, 4) and Tiny.Slot((1, 2), 1, 2) is (1, 2)
	state.Length > size then state.Slice(sequence * size, size) else state
Join(block DeltaBlock, parts List(DeltaBlock)) DeltaBlock
	Tiny.Join(Block, (Block, Block)).memory.Length is 2 * Block.memory.Length
	mutable memories = List(Number)
	mutable windows = List(Number)
	mutable merged = List(Number)
	for parts
		memories = memories + value.memory
		windows = windows + value.window
		merged = merged + value.merged
	DeltaBlock(block, memory = memories, window = windows, merged = merged)
Copies(count Number) Hybrid
	Tiny.Copies(2).layers.First.memory.Length is 2 * Block.memory.Length
	mutable copied = List(Mutable(DeltaBlock))
	for layers
		copied.Add(DeltaBlock(value, memory = Repeat(value.memory, count), window = Repeat(value.window, count)))
	Hybrid(value, layers = copied)
Repeat(state Numbers, count Number) Numbers
	Tiny.Repeat((1, 2), 2) is (1, 2, 1, 2)
	for state.Length * count
		state(index % state.Length)
Opened(combined Numbers, tokens Number, start Number) Hybrid
	None.Opened((1, 2, 3, 4), 2, 1).gates is (2, 4)
	None.Opened((1, 2, 3, 4), 1, 4).gates.Length is 0
	width = combined.Length / tokens
	start is width then value else Hybrid(value, gates = Batch.Columns(combined, width, start, width - start))
Gate(merged Numbers) Numbers
	None.Gate((1, 2)) is (1, 2)
	Hybrid(List(DeltaBlock), gates = (0, 0)).Gate((1, 2)) is (0.5, 1)
	if gates.Length is 0
		return merged
	for merged
		value / (1 + (-gates(index)).Exponential)
