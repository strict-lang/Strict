has logger
constant Sample = ("variety", "5.1,3.5,1.4,.2,0", "7,3.2,4.7,1.4,1")
Run
	let rows = Rows(File("NeuralNetworks/iris.csv").ReadLines)
	let network = Trained(Network.Random((4, 8, 3)), Training(rows), 200)
	logger.Log("Iris test accuracy " + Accuracy(network, Testing(rows)) + " after 200 epochs")
Rows(lines Texts) List(Numbers)
	Iris.Rows(Sample).Length is 2
	for Range(1, lines.Length)
		Parsed(lines(value))
Parsed(line Text) Numbers
	Iris.Parsed("5.1,3.5,1.4,.2,0") is (5.1, 3.5, 1.4, 0.2, 0)
	for line.Split(",")
		value to Number
Training(rows List(Numbers)) List(Numbers)
	Iris.Training(Iris.Rows(Sample)).Length is 1
	for rows
		if index % 5 is not 0
			value
Testing(rows List(Numbers)) List(Numbers)
	Iris.Testing(Iris.Rows(Sample)).Length is 1
	for rows
		if index % 5 is 0
			value
Features(row Numbers) Numbers
	Iris.Features((4, 8, 2, 0, 1)) is (0.5, 1, 0.25, 0)
	for 4
		row(index) / 8
Target(row Numbers) Numbers
	Iris.Target((5, 3, 1, 0, 1)) is (0, 1, 0)
	for 3
		index is row(4) then 1 else 0
Best(output Numbers) Number
	Iris.Best((0.1, 0.7, 0.2)) is 1
	output.Index(output.Maximum)
Trained(network Network, rows List(Numbers), epochs Number) Network
	Iris.Accuracy(Iris.Trained(Network.Random((4, 3, 3)), Iris.Rows(Sample), 300), Iris.Rows(Sample)) is 1
	mutable trained = network
	for epochs * rows.Length
		let row = rows(index % rows.Length)
		trained = trained.Trained(Features(row), Target(row), 0.5)
	trained
Accuracy(network Network, rows List(Numbers)) Number
	Iris.Accuracy(Network.Random((4, 3, 3)), List(Numbers)) is 0
	mutable correct = 0
	for rows
		if Best(network.Predict(Features(value))) is value(4)
			correct = correct + 1
	rows.Length is 0 then 0 else correct / rows.Length