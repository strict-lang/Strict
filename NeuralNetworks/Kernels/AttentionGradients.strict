has attention Attention
has gradient Numbers
constant Pair = AttentionGradients(Attention((1, 0, 0, 1), (1, 0, 2, 1), (3, 4, 5, 6), 1, 1, 2), (0.1, 0.2, 0.3, 0.4))
Queries(scores Numbers) Numbers
	Pair.Queries(Pair.Score(Pair.Shares))(3).IsNearlyEqual(0.21895803516315468)
	Pair.Queries(Pair.Score(Pair.Shares))(0) is 0
	size = attention.size
	positions = Positions
	stride = attention.heads * size
	for attention.queries.Length
		row = (index / size).Floor
		start = index % size + (row % attention.heads) * size
		Softmax.Weight(scores, row * positions, positions, attention.keys, start, stride) / size.SquareRoot
Keys(scores Numbers) Numbers
	Pair.Keys(Pair.Score(Pair.Shares))(1).IsNearlyEqual(-0.2189580351631546)
	Pair.Keys(Pair.Score(Pair.Shares))(3).IsNearlyEqual(0.21895803516315468)
	Transpose(scores, attention.queries) / attention.size.SquareRoot
Values(shares Numbers) Numbers
	Pair.Values(Pair.Shares)(0).IsNearlyEqual(0.19907153520200294)
	Pair.Values(Pair.Shares)(3).IsNearlyEqual(0.26790461973066276)
	Transpose(shares, gradient)
Transpose(shares Numbers, numbers Numbers) Numbers
	Pair.Transpose((1, 0, 0.5, 0.5), (1, 2, 3, 4)) is (2.5, 4, 1.5, 2)
	width = attention.heads * attention.size
	positions = Positions
	stride = attention.heads * positions
	count = numbers.Length / width
	for attention.keys.Length
		head = (index / attention.size).Floor % attention.heads
		Stride(shares, head * positions + (index / width).Floor, stride, numbers, index % width, width, count)
Stride(left Numbers, leftStart Number, leftStride Number, right Numbers, rightStart Number, rightStride Number, count Number) Number
	Pair.Stride((1, 9, 2), 0, 2, (3, 9, 4), 0, 2, 2) is 11
	mutable sum = 0
	for count
		sum = sum + left(leftStart + index * leftStride) * right(rightStart + index * rightStride)
	sum
Shares Numbers
	Pair.Shares(1) is 0
	Pair.Shares(3).IsNearlyEqual(0.6697615493266569)
	Softmax.Shares(attention.Scores(Positions), Positions)
Positions Number
	Pair.Positions is 2
	attention.keys.Length / attention.groups / attention.size
Score(shares Numbers) Numbers
	Pair.Score((1, 0, 0.5, 0.5))(0) is 0
	weighed = Weigh(shares)
	positions = Positions
	for shares
		row = (index / positions).Floor
		value * (weighed(index) - Softmax.Weight(shares, row * positions, positions, weighed, row * positions, 1))
Weigh(shares Numbers) Numbers
	Pair.Weigh((1, 0, 0.5, 0.5))(3).IsNearlyEqual(3.9)
	size = attention.size
	positions = Positions
	for shares.Length
		row = (index / positions).Floor
		start = (index % positions) * attention.heads * size + (row % attention.heads) * size
		Softmax.Weight(gradient, row * size, size, attention.values, start, 1)
