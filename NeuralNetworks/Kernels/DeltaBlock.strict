has attentionNorm Numbers
has inputs Layer
has convolution Numbers
has decays Numbers
has steps Numbers
has norm Numbers
has projection Layer
has mlpNorm Numbers
has experts Experts
has window Numbers = List(Number)
has memory Numbers = List(Number)
has merged Numbers = List(Number)
has sigmoidGate Boolean = false
has rates Layer = Layer.None
constant Tiny = DeltaBlock.Loaded(Drafter.Model, "blk.0.", Layer.Zeros(16), Basis.None)
constant Pulse = (1, 2) + Layer.Zeros(30)
Loaded(model Gguf, prefix Text, zeros Numbers, basis Basis) DeltaBlock slow
	Tiny.inputs.weights.Length is 32
	mixing = Mixing(model, prefix, zeros, Experts(Qwen3Block.FeedForward(model, prefix), basis = basis))
	normed = model.Values(prefix + "attn_norm.weight")
	isApart = basis.IsFolded(prefix + "ssm_beta.weight") is false
	rating = 2 * mixing.decays.Length
	mixed = mixing.inputs.weights.Length - rating
	kept = isApart then Layer(mixing.inputs.weights.Slice(0, mixed), Layer.Unbiased) else mixing.inputs
	rated = isApart then Layer(mixing.inputs.weights.Slice(mixed, rating), Layer.Unbiased) else Layer.None
	after = model.Values(prefix + "post_attention_norm.weight")
	DeltaBlock(mixing, attentionNorm = normed, mlpNorm = after, inputs = kept, rates = rated)
Mixing(model Gguf, prefix Text, zeros Numbers, feedForward Experts) DeltaBlock slow
	DeltaBlock.Mixing(Drafter.Model, "blk.0.", Layer.Zeros(16), Tiny.experts).attentionNorm.Length is 0
	combined = Qwen3Block.Dense(model, prefix, ("attn_qkv", "attn_gate", "ssm_beta", "ssm_alpha"))
	taps = model.Values(prefix + "ssm_conv1d.weight")
	logarithms = model.Values(prefix + "ssm_a")
	projected = Qwen3Block.Dense(model, prefix, List(Text) + "ssm_out")
	biases = model.Values(prefix + "ssm_dt.bias")
	headNorm = model.Values(prefix + "ssm_norm.weight")
	shifted = Layer.Zeros(taps.Length / 4 * 3)
	none = List(Number)
	DeltaBlock(none, combined, taps, logarithms, biases, headNorm, projected, none, feedForward, shifted, zeros)
Width Number
	Tiny.Width is 32
	DeltaBlock(Tiny, rates = Layer.Halves).Width is 33
	inputs.weights.Length + rates.weights.Length
KeyHeads Number
	Tiny.KeyHeads is 2
	(convolution.Length / 4 / norm.Length - decays.Length) / 2
Combine(input Numbers) Numbers
	DeltaBlock(Tiny, rates = Layer(List(Numbers) + Layer.Zeros(8), Layer.Unbiased)).Combine(Drafter.Pair).Length is 66
	normed = Qwen3Block.Normalize(input, 0, input.Length, attentionNorm)
	mixed = experts.basis.Sums(inputs.weights, inputs.biases, normed)
	if rates.weights.Length is 0
		return mixed
	rated = Batch(rates.weights, rates.biases).Sums(normed)
	mixing = inputs.weights.Length
	rating = rates.weights.Length
	for rated.Length / rating * (mixing + rating)
		token = (index / (mixing + rating)).Floor
		at = index % (mixing + rating)
		at < mixing then mixed(token * mixing + at) else rated(token * rating + at - mixing)
Cached(combined Numbers) DeltaBlock slow
	Tiny.Cached(Tiny.Combine(Drafter.Rows(1))).Output(Drafter.Rows(1)).First.IsNearlyEqual(0.54408, 0.00001)
	Tiny.Cached(Tiny.Combine(Drafter.Pair)).Output(Drafter.Pair)(8).IsNearlyEqual(1.773538, 0.00001)
	tokens = combined.Length / Width
	keyed = Key(Convolve(combined, tokens))
	constant Chunk = 16
	chunks = DeltaChunks(decays.Length, KeyHeads, norm.Length, Chunk, tokens, keyed, Decay(combined, tokens), memory)
	read = tokens is 1 then chunks.Stepped(value) else chunks.Read
	DeltaBlock(value, memory = read.memory, window = Shift(combined, tokens), merged = Gate(read.reads, combined))
Rewound(combined Numbers) DeltaBlock slow
	Tiny.Rewound(Tiny.Combine(Drafter.Rows(1))).memory is Tiny.Cached(Tiny.Combine(Drafter.Rows(1))).memory
	Tiny.Rewound(Tiny.Combine(Drafter.Pair)).window is Tiny.Cached(Tiny.Combine(Drafter.Pair)).window
	tokens = combined.Length / Width
	keyed = Key(Convolve(combined, tokens))
	decayed = Decay(combined, tokens)
	mutable current = value
	for tokens
		current = DeltaBlock(current, memory = current.Update(keyed, decayed, current.Read(keyed, index, 1), index))
	DeltaBlock(current, window = Shift(combined, tokens))
Convolve(combined Numbers, tokens Number) Numbers
	Tiny.Convolve(Layer.Zeros(64), 2) is Layer.Zeros(32)
	channels = convolution.Length / 4
	width = combined.Length / tokens
	for tokens * channels
		token = (index / channels).Floor
		channel = index % channels
		old = Tap(combined, width, token - 3, channel, channels, 0) + Tap(combined, width, token - 2, channel, channels, 1)
		sum = old + Tap(combined, width, token - 1, channel, channels, 2)
		all = sum + Tap(combined, width, token, channel, channels, 3)
		all / (1 + (-all).Exponential)
Tap(combined Numbers, width Number, token Number, channel Number, channels Number, weight Number) Number
	Tiny.Tap((1, 2, 3, 4), 2, 1, 0, 1, 3) is 3 * Tiny.convolution(3)
	TapChannel(combined, width, token, channel, channels) * convolution(4 * channel + weight)
TapChannel(combined Numbers, width Number, token Number, channel Number, channels Number) Number
	Tiny.TapChannel((1, 2, 3, 4), 2, 1, 0, 1) is 3
	Tiny.TapChannel((1, 2, 3, 4), 2, -1, 0, 1) is 0
	Tiny.TapChannel((1, 2, 3, 4), 2, -9, 0, 1) is 0
	token < -3 then 0 else (token < 0 then window((3 + token) * channels + channel) else combined(token * width + channel))
Shift(combined Numbers, tokens Number) Numbers
	Hybrid.Single.Prepared(Drafter.Rows(2)).entered(0).IsNearlyEqual(1.773538, 0.00001)
	Tiny.Shift(Layer.Zeros(32), 1).Length is 48
	channels = convolution.Length / 4
	width = combined.Length / tokens
	for 3 * channels
		TapChannel(combined, width, tokens - 3 + (index / channels).Floor, index % channels, channels)
Key(mixed Numbers) Numbers
	Tiny.Key((3, 4, 0, 1, 6, 8, 0, 0, 5, 0, 0, 0, 0, 0, 0, 0))(3).IsNearlyEqual(0.7071064)
	Tiny.Key((3, 4, 0, 1, 6, 8, 0, 0, 5, 0, 0, 0, 0, 0, 0, 0))(5).IsNearlyEqual(0.8)
	size = norm.Length
	channels = convolution.Length / 4
	keys = 2 * KeyHeads * size
	for mixed
		within = index % channels
		query = within < keys / 2 then 1 / size else 1 / size.SquareRoot
		squares = Normalization.Square(mixed, (index / size).Floor * size, size)
		within >= keys then value else value * Normalization.Scale(squares, size, Qwen3Block.Epsilon / size) * query
Decay(combined Numbers, tokens Number) Numbers
	Tiny.Decay(Layer.Zeros(64), 2).Length is 16
	Tiny.Decay(Layer.Zeros(32), 1)(4) is 0.5
	heads = decays.Length
	width = combined.Length / tokens
	betas = convolution.Length / 4 + heads * norm.Length
	for 2 * tokens * heads
		start = (index / (2 * heads)).Floor * width
		head = index % heads
		rate = combined(start + betas + head)
		alpha = combined(start + betas + heads + head) + steps(head)
		decay = decays(head) * (1 + alpha.Exponential).Logarithm
		index % (2 * heads) >= heads then 1 / (1 + (-rate).Exponential) else decay
Update(keyed Numbers, decayed Numbers, remembered Numbers, token Number) Numbers
	Tiny.Update(Layer.Zeros(16), (1, 1, 1, 1, 1, 1, 1, 1), Layer.Zeros(8), 0) is Layer.Zeros(16)
	size = norm.Length
	groups = KeyHeads
	heads = decays.Length
	start = token * convolution.Length / 4
	for memory
		head = (index / (size * size)).Floor
		column = head * size + index % size
		decay = decayed(2 * token * heads + head).Exponential
		change = keyed(start + 2 * groups * size + column) - remembered(column) * decay
		key = keyed(start + (groups + head % groups) * size + (index / size).Floor % size)
		value * decay + key * change * decayed((2 * token + 1) * heads + head)
Read(keyed Numbers, token Number, part Number) Numbers
	Tiny.Read(Layer.Zeros(16), 0, 0) is Layer.Zeros(8)
	Tiny.Read(Layer.Zeros(16), 0, 1).Length is 8
	size = norm.Length
	groups = KeyHeads
	for decays.Length * size
		head = (index / size).Floor
		first = token * convolution.Length / 4 + (part * groups + (head % groups)) * size
		column = head * size * size + (index % size)
		mutable sum = 0
		for size
			sum = sum + keyed(first + index) * memory(column + index * size)
		sum
Gate(raw Numbers, combined Numbers) Numbers
	Tiny.Gate(Layer.Zeros(8), Layer.Zeros(32)) is Layer.Zeros(8)
	DeltaBlock(Tiny, sigmoidGate = true).Gate((3, 4), Layer.Zeros(32)).First.IsNearlyEqual(0.424264 * Tiny.norm.First)
	size = norm.Length
	values = decays.Length * size
	width = combined.Length * values / raw.Length
	for raw
		gate = combined((index / values).Floor * width + convolution.Length / 4 + index % values)
		squares = Normalization.Square(raw, (index / size).Floor * size, size)
		scaled = value * Normalization.Scale(squares, size, Qwen3Block.Epsilon) * norm(index % size)
		(sigmoidGate then scaled else scaled * gate) / (1 + (-gate).Exponential)
Output(input Numbers) Numbers
	Tiny.Cached(Tiny.Combine(Drafter.Rows(1))).Output(Drafter.Rows(1)).Length is 8
	grouped = experts.basis.Group(merged, norm.Length, KeyHeads, decays.Length)
	attended = experts.basis.Sums(projection.weights, input, grouped)
	experts.Add(Qwen3Block.Normalize(attended, 0, attended.Length, mlpNorm), attended)
