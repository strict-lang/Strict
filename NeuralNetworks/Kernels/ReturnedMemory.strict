constant Count = 25000000
constant Kept = 150000000
Anchor Numbers native
	ReturnedMemory.Anchor.Length is Count
	for Count
		1
Spike Numbers native
	ReturnedMemory.Spike.Length is Count
	for Count
		2
Used(values Numbers) Number
	ReturnedMemory.Used((1, 2)) is 2
	values.Length
Measure(anchor Numbers) Numbers native
	ReturnedMemory.Measure((1, 2))(1) is Count + 2
	(GpuMemory.HostAvailable, Used(Spike) + anchor.Length, GpuMemory.HostAvailable)
Recovered Boolean native
	ReturnedMemory.Recovered
	anchor = Anchor
	measured = Measure(anchor)
	Process.Collect
	left = measured(0) - GpuMemory.HostAvailable
	logger.Log("spike " + (measured(0) - measured(2)).Round + " left " + left.Round + " after " + measured(1) + " numbers")
	left < Kept and anchor.Last is 1
