has weights List(Numbers)
has biases Numbers
has activation = Activation.Sigmoid
has previousWeights List(Numbers) = List(Numbers)
has previousBiases Numbers = List(Number)
constant Momentum = 0.5
constant Unbiased = List(Number) + 0
constant None = Layer(List(Numbers), List(Number))
constant Halves = Layer(List(Numbers) + (0.5, 0.5), List(Number) + 0)
constant Fours = Layer(Gguf("NeuralNetworks/tiny.gguf", 4).Rows("r4"), (0, 0))
constant Sixes = Layer(Gguf("NeuralNetworks/tiny.gguf", 4).Rows("r6"), (0, 0))
constant Eights = Layer(Gguf("NeuralNetworks/tiny.gguf", 8).Rows("q"), (0, 0))
constant Twos = Layer(Gguf("NeuralNetworks/tiny.gguf", 4).Rows("r2"), (0, 0))
constant Codes = Layer(Gguf("NeuralNetworks/tiny.gguf", 2).Rows("r2"), (0, 0))
Random(inputs Number, outputs Number, function = Activation.Sigmoid) Layer
	Layer.Random(2, 3).weights.Length is 3
	Layer.Random(2, 3).weights.First.Length is 2
	Layer.Random(2, 3).biases is (0, 0, 0)
	Layer.Random(2, 3, Activation.Tanh).activation is Activation.Tanh
	Layer(Rows(inputs, outputs), Zeros(outputs), function)
Rows(inputs Number, outputs Number) List(Numbers)
	Halves.Rows(2, 3).Length is 3
	for outputs
		Weights(inputs)
Weights(count Number) Numbers
	Halves.Weights(3).Length is 3
	Halves.Weights(4).Maximum <= 0.5
	for count
		(2.Random - 1) / count.SquareRoot
Zeros(count Number) Numbers
	Halves.Zeros(2) is (0, 0)
	for count
		0
Forward(input Numbers) Numbers
	Halves.Forward((1, 1)) is List(Number) + 0.7310585786300049
	Halves.Forward((0, 0)) is List(Number) + 0.5
	for weights
		activation.Output(Summed(value, input) + biases(index))
Sums(input Numbers) Numbers
	Halves.Sums((1, 1)) is List(Number) + 1
	Fours.Sums(Gpt2Block.Added(Fours.weights.First, Sixes.weights.First)).First.IsNearlyEqual(3134903.8125, 6000)
	Sixes.Sums(Gpt2Block.Added(Fours.weights.First, Sixes.weights.First)).Last.IsNearlyEqual(-71957.5, 1000)
	Eights.Sums(Gpt2Block.Added(Eights.weights.First, Eights.weights.Last)).Last.IsNearlyEqual(25678.23355948925, 30)
	Twos.Sums(Gguf("NeuralNetworks/tiny.gguf", 32).Rows("r2").Last).Last.IsNearlyEqual(45.75, 0.01)
	Codes.Sums(Gguf("NeuralNetworks/tiny.gguf", 32).Rows("r2").Last).Last.IsNearlyEqual(45.75, 0.01)
	for weights
		Summed(value, input) + biases(index % biases.Length)
Summed(row Numbers, input Numbers) Number
	Halves.Summed((1, 2), (1, 3)) is 7
	mutable sum = 0
	for row
		sum = sum + value * input(index)
	sum
Spread(deltas Numbers) Numbers
	Halves.Spread(List(Number) + 2) is (1, 1)
	for weights.First.Length
		Back(deltas, index)
Back(deltas Numbers, input Number) Number
	Halves.Back(List(Number) + 2, 1) is 1
	mutable sum = 0
	for weights
		sum = sum + value(input) * deltas(index)
	sum
Updated(input Numbers, deltas Numbers, rate Number) Layer
	Halves.Updated((1, 0), List(Number) + 1, 0.5).weights is List(Numbers) + (0, 0.5)
	Halves.Updated((1, 0), List(Number) + 1, 0.5).biases is List(Number) + (0 - 0.5)
	Halves.Updated((1, 0), List(Number) + 1, 0.5).Updated((1, 0), (0), 0.5).biases is List(Number) + (0 - 0.75)
	Layer(Moved(input, deltas, rate), Shifted(deltas, rate), activation, weights, biases)
Moved(input Numbers, deltas Numbers, rate Number) List(Numbers)
	Halves.Moved((1, 0), List(Number) + 1, 0.5) is List(Numbers) + (0, 0.5)
	for weights
		Row(value, (index < previousWeights.Length then previousWeights(index) else value), rate * deltas(index), input)
Row(row Numbers, previous Numbers, scaled Number, input Numbers) Numbers
	Halves.Row((1, 1), (1, 1), 0.5, (1, 0)) is (0.5, 1)
	Halves.Row((1, 1), (0, 1), 0.5, (1, 0)) is (1, 1)
	for row
		value - scaled * input(index) + Momentum * (value - previous(index))
Shifted(deltas Numbers, rate Number) Numbers
	Halves.Shifted(List(Number) + 1, 0.5) is List(Number) + (0 - 0.5)
	let previous = previousBiases.Length is 0 then biases else previousBiases
	for biases
		value - rate * deltas(index) + Momentum * (value - previous(index))
Mutated(strength Number) Layer
	Halves.Mutated(0) is Halves
	(Halves.Mutated(0.1).weights.First.First - 0.5).Absolute <= 0.1
	mutable rows = List(Mutable(Numbers))
	for weights
		rows.Add(Noisy(value, strength))
	Layer(rows, Noisy(biases, strength), activation)
Noisy(values Numbers, strength Number) Numbers
	Halves.Noisy((1, 2), 0) is (1, 2)
	(Halves.Noisy(List(Number) + 1, 0.5).First - 1).Absolute <= 0.5
	for values
		value + (2.Random - 1) * strength