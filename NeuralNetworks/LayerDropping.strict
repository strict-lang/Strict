Run(path Text, count = 4)
	evaluation = Evaluation
	calibrating = evaluation.Calibration(2)
	heldout = evaluation.Heldout(8)
	tokenizer = Gpt2Tokens.Folder(path)
	mutable model = Gpt2.Loaded(path + "/model.safetensors", BFloat16.Bits)
	mutable kept = List(Mutable(Number)) + Dataset.Indices(model.blocks.Length)
	logger.Log(path + " with all " + kept.Length + " blocks: " + Reported(model, tokenizer, heldout))
	for count
		removed = Weakest(model, tokenizer, calibrating(0) + calibrating(1))
		model = model.Without(removed)
		logger.Log("without block " + kept(removed) + ": " + Reported(model, tokenizer, heldout))
		kept.Remove(kept(removed))
Weakest(model Gpt2, tokenizer Gpt2Tokens, texts Texts) Number slow
	LayerDropping.Weakest(Gpt2.Tiny, Gpt2Tokens.Tiny, "ab ab") is 0
	mutable weakest = 0
	mutable lowest = -1
	for model.blocks.Length
		loss = Perplexity(model.Without(index)).Report(tokenizer, texts)(0)
		weakest = lowest < 0 or loss < lowest then index else weakest
		lowest = lowest < 0 or loss < lowest then loss else lowest
	weakest
Reported(model Gpt2, tokenizer Gpt2Tokens, texts List(Texts)) Text slow
	LayerDropping.Reported(Gpt2.Tiny, Gpt2Tokens.Tiny, List(Texts) + ("ab ab")).StartsWith("English perplexity")
	reports = Perplexity(model).Reports(tokenizer, texts)
	evaluation = Evaluation
	strict = texts.Length > 1 then ", Strict " + evaluation.Described(reports(1)) else ""
	"English " + evaluation.Described(reports(0)) + strict