has attentionNorm Numbers
has postNorm Numbers
has mlpNorm Numbers
has postMlpNorm Numbers
has feedForward Experts
has convolution ShortConvolution = Unmixed
has attention Qwen3Block = Unattended
has gates Layer = Layer.None
has window Number = 0
has output Numbers = List(Number)
constant Epsilon = 0.00001
constant Unmixed = ShortConvolution(Layer.None, List(Number), Layer.None, 1)
constant Unattended = Qwen3Block(List(Number), Layer.None, Layer.None, List(Number), List(Number), List(Number), Experts.Single, 0, 0)
constant Feeding = Experts.Dense(Layer(((1, 0), (0, 1)), Layer.Unbiased), Layer(((1), (1)), Layer.Unbiased))
constant Passing = Lfm3Block(List(Number), List(Number), List(Number), List(Number), Feeding)
Loaded(model Gguf, prefix Text, heads Number, size Number) Lfm3Block slow
	let forward = Qwen3Block.FeedForward(model, prefix)
	let norms = (model.Values(prefix + "attn_norm.weight"), model.Values(prefix + "post_attention_norm.weight"))
	let mlp = (model.Values(prefix + "ffn_norm.weight"), model.Values(prefix + "post_ffw_norm.weight"))
	let block = Lfm3Block(norms(0), norms(1), mlp(0), mlp(1), forward, window = size)
	if model.Shape(prefix + "shortconv.conv.weight").Length > 0
		return Lfm3Block(block, convolution = ShortConvolution.Loaded(model, prefix))
	let attending = Qwen3Block.Attending(model, prefix, heads, forward)
	Lfm3Block(block, attention = attending, gates = Layer(model.Rows(prefix + "attn_gate.weight"), Layer.Unbiased))
Forwarded(input Numbers, rotation Numbers) Lfm3Block
	Passing.Forwarded((1, 2), List(Number)).output.Length is 2
	let mixing = Mixing(Normed(input, attentionNorm), rotation)
	let operated = IsConvolution then mixing.convolution.output else mixing.output
	let residual = Gpt2Block.Added(input, Normed(operated, postNorm))
	let fed = feedForward.Added(Normed(residual, mlpNorm), Layer.Zeros(residual.Length))
	Lfm3Block(mixing, output = Gpt2Block.Added(residual, Normed(fed, postMlpNorm)))
Mixing(normed Numbers, rotation Numbers) Lfm3Block
	Passing.Mixing((1, 2), List(Number)).output is (1, 2)
	IsConvolution then Lfm3Block(value, convolution = convolution.Mixed(normed)) else Attended(normed, rotation)
Attended(normed Numbers, rotation Numbers) Lfm3Block
	Passing.Attended(List(Number), List(Number)).output.Length is 0
	if attention.queryNorm.Length is 0
		return Lfm3Block(value, output = normed)
	let cached = attention.Cached(normed, rotation, 32)
	let gating = Basis.None.Sums(gates.weights, gates.biases, normed)
	let merged = Headed(cached.Merged(1), gating, cached.queryNorm.Length)
	let projected = Basis.None.Sums(cached.projection.weights, cached.projection.biases, merged)
	Lfm3Block(value, attention = Trimmed(cached), output = projected)
Trimmed(cached Qwen3Block) Qwen3Block
	Passing.Trimmed(Unattended) is Unattended
	let kept = window * cached.groups * cached.queryNorm.Length
	if window is 0 or cached.keys.Length <= kept
		return cached
	let keys = cached.keys.Slice(cached.keys.Length - kept, kept)
	Qwen3Block(cached, keys = keys, values = cached.values.Slice(cached.values.Length - kept, kept))
IsConvolution Boolean
	Passing.IsConvolution is false
	convolution.width > 1
Normed(input Numbers, weights Numbers) Numbers
	Passing.Normed((3, 4), (1, 2)).Last.IsNearlyEqual(2.2627409)
	Passing.Normed((3, 4), List(Number)) is (3, 4)
	if weights.Length is 0
		return input
	let size = weights.Length
	for input.Length
		let start = (index / size).Floor * size
		input(index) * weights(index % size) * Normalization.Scale(Normalization.Squared(input, start, size), size, Epsilon)
Headed(merged Numbers, gating Numbers, size Number) Numbers
	Passing.Headed((1, 2, 3, 4), (0, 1000), 2) is (0.5, 1, 3, 4)
	for merged.Length
		merged(index) / (1 + (-gating((index / size).Floor)).Exponential)
