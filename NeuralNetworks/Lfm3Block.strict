has attentionNorm Numbers
has postNorm Numbers
has mlpNorm Numbers
has postMlpNorm Numbers
has feedForward Experts
has convolution ShortConvolution = Unmixed
has attention Qwen3Block = Unattended
has gates Layer = Layer.None
has window Number = 0
has output Numbers = List(Number)
constant Epsilon = 0.00001
constant Unmixed = ShortConvolution(Layer.None, List(Number), Layer.None, 1)
constant Feeding = Experts.Dense(Layer(((1, 0), (0, 1)), Layer.Unbiased), Layer(((1), (1)), Layer.Unbiased))
constant Unattended = Qwen3Block(List(Number), Layer.None, Layer.None, List(Number), List(Number), List(Number), Feeding, 0, 0)
constant Windowed = Qwen3Block(Unattended, queryNorm = (1), groups = 1, keys = (1, 2, 3), values = (1, 2, 3), starts = (2))
constant Passing = Lfm3Block(List(Number), List(Number), List(Number), List(Number), Feeding)
Loaded(model Gguf, prefix Text, heads Number, size Number) Lfm3Block slow
	forward = Qwen3Block.FeedForward(model, prefix)
	norms = (model.Values(prefix + "attn_norm.weight"), Optional(model, prefix + "post_attention_norm.weight"))
	mlp = (model.Values(prefix + "ffn_norm.weight"), Optional(model, prefix + "post_ffw_norm.weight"))
	block = Lfm3Block(norms(0), norms(1), mlp(0), mlp(1), forward, window = size)
	if model.Shape(prefix + "shortconv.conv.weight").Length > 0
		return Lfm3Block(block, convolution = ShortConvolution.Loaded(model, prefix))
	attending = Qwen3Block.Attending(model, prefix, heads, forward)
	isGated = model.Shape(prefix + "attn_gate.weight").Length > 0
	gating = isGated then Layer(model.Rows(prefix + "attn_gate.weight"), Layer.Unbiased) else Layer.None
	Lfm3Block(block, attention = attending, gates = gating)
Forwarded(input Numbers, rotation Numbers, sequences = 1) Lfm3Block
	Passing.Forwarded((1, 2), List(Number)).output.Length is 2
	mixing = Mixing(Normed(input, attentionNorm), rotation, sequences)
	residual = Gpt2Block.Added(input, Normed(IsConvolution then mixing.convolution.output else mixing.output, postNorm))
	Lfm3Block(mixing, output = Gpt2Block.Added(residual, Normed(Fed(Normed(residual, mlpNorm)), postMlpNorm)))
Fed(normed Numbers) Numbers
	Passing.Fed((1, 2)).Length is 2
	feedForward.router.weights.Length > 0 then feedForward.Forward(normed) else feedForward.Added(normed, Layer.Unbiased)
Mixing(normed Numbers, rotation Numbers, sequences Number) Lfm3Block
	Passing.Mixing((1, 2), List(Number), 1).output is (1, 2)
	convolved = IsConvolution then convolution.Mixed(normed, sequences) else convolution
	IsConvolution then Lfm3Block(value, convolution = convolved) else Attended(normed, rotation, sequences)
Attended(normed Numbers, rotation Numbers, sequences Number) Lfm3Block
	Passing.Attended(List(Number), List(Number), 1).output.Length is 0
	if attention.queryNorm.Length is 0
		return Lfm3Block(value, output = normed)
	cached = attention.Cached(normed, rotation, 32, sequences)
	merged = Gated(cached.Merged(sequences), normed, cached.queryNorm.Length)
	projected = Basis.None.Sums(cached.projection.weights, cached.projection.biases, merged)
	Lfm3Block(value, attention = Trimmed(cached, sequences), output = projected)
Trimmed(cached Qwen3Block, sequences Number) Qwen3Block
	Passing.Trimmed(Unattended, 1) is Unattended
	Lfm3Block(Passing, window = 2).Trimmed(Windowed, 1).starts is (1)
	kept = window * cached.groups * cached.queryNorm.Length * sequences
	if window is 0 or cached.keys.Length <= kept
		return cached
	keys = cached.keys.Slice(cached.keys.Length - kept, kept)
	starts = Moved(cached.starts, (cached.keys.Length - kept) * window / kept)
	Qwen3Block(cached, keys = keys, values = cached.values.Slice(cached.values.Length - kept, kept), starts = starts)
Moved(starts Numbers, dropped Number) Numbers
	Passing.Moved((3, 0), 2) is (1, 0)
	for starts
		(value - dropped).Maximum(0)
Setting(model Gguf, key Text, fallback Number) Number
	Passing.Setting(Gguf("NeuralNetworks/tinyqwen3.gguf"), "rope.freq_base", 5) is 1000000
	Passing.Setting(Gguf("NeuralNetworks/tinyqwen3.gguf"), "missing", 5) is 5
	given = model.Value(model.Value("general.architecture") + "." + key)
	given is "" then fallback else given to Number
Optional(model Gguf, name Text) Numbers
	Passing.Optional(Gguf("NeuralNetworks/tinyqwen3.gguf"), "missing.weight").Length is 0
	Passing.Optional(Gguf("NeuralNetworks/tinyqwen3.gguf"), "output_norm.weight").Length > 0
	model.Shape(name).Length > 0 then model.Values(name) else List(Number)
Copied(count Number) Lfm3Block
	Passing.Copied(2).convolution.window.Length is 0
	Lfm3Block(value, convolution = convolution.Copied(count), attention = attention.Copies(count, 32))
IsConvolution Boolean
	Passing.IsConvolution is false
	convolution.width > 1
Normed(input Numbers, weights Numbers) Numbers
	Passing.Normed((3, 4), (1, 2)).Last.IsNearlyEqual(2.2627409)
	Passing.Normed((3, 4), List(Number)) is (3, 4)
	if weights.Length is 0
		return input
	size = weights.Length
	scales = Unattended.Scales(input, size, Epsilon)
	for input.Length
		input(index) * weights(index % size) * scales((index / size).Floor)
Gated(merged Numbers, normed Numbers, size Number) Numbers
	Passing.Gated((1, 2), (1, 2), 1) is (1, 2)
	Lfm3Block(Passing, gates = Layer(List(Numbers) + (0, 0), Layer.Unbiased)).Gated((1, 2), (1, 2), 2) is (0.5, 1)
	gates.weights.Length is 0 then merged else Headed(merged, Basis.None.Sums(gates.weights, gates.biases, normed), size)
Headed(merged Numbers, gating Numbers, size Number) Numbers
	Passing.Headed((1, 2, 3, 4), (0, 1000), 2) is (0.5, 1, 3, 4)
	for merged.Length
		merged(index) / (1 + (-gating((index / size).Floor)).Exponential)
