has logger
constant Pruning = MixturePruning(Logger)
Run(path Text, used = 6, dropped = "", count = 100)
	let tokenizer = Gpt2Tokens.Loaded(Gguf(path))
	let removed = dropped is "" then List(Number) else dropped.Split(",") to Numbers
	let model = Using(Without(Qwen3.Loaded(path, 4), removed), used)
	let benchmark = Qwen3Benchmark(logger)
	let prompt = tokenizer.Encoded(Qwen3Benchmark.Prompt)
	let prefilled = model.Prefilled(prompt, 0)
	let durations = benchmark.Durations(prefilled, prefilled.Next, prompt.Length, count, 1)
	let speed = benchmark.Report(prompt.Length, 1, durations, 1)
	logger.Log(path + " using " + used + " experts without layers (" + dropped + "): " + speed)
	let evaluation = Evaluation(logger)
	let reports = Perplexity(model).Reports(tokenizer, evaluation.Heldout(8))
	logger.Log("English " + evaluation.Described(reports(0)) + ", Strict " + evaluation.Described(reports(1)))
Using(model Qwen3, count Number) Slow(Qwen3)
	Pruning.Using(Qwen3.TinyMixture, 1).blocks.First.experts.used is 1
	Pruning.Using(Qwen3.TinyMixture, 1).Step(1, 0).Scored.Length is 6
	mutable blocks = List(Mutable(Qwen3Block))
	for model.blocks
		blocks.Add(Qwen3Block(value, experts = Experts(value.experts, used = count)))
	Qwen3(model, blocks = blocks)
Without(model Qwen3, dropped Numbers) Slow(Qwen3)
	Pruning.Without(Qwen3.TinyMixture, List(Number) + 0).blocks.Length is Qwen3.TinyMixture.blocks.Length - 1
	mutable blocks = List(Mutable(Qwen3Block))
	for model.blocks
		if index is not in dropped
			blocks.Add(value)
	Qwen3(model, blocks = blocks)
