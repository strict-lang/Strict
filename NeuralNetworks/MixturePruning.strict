constant Pruning = MixturePruning
Run(path Text, used = 6, dropped = "", count = 100)
	tokenizer = Gpt2Tokens.Loaded(Gguf(path))
	removed = dropped is "" then List(Number) else dropped.Split(",") to Numbers
	model = Using(Without(Qwen3.Loaded(path, 4), removed), used)
	benchmark = Qwen3Benchmark
	prompt = tokenizer.Encoded(Qwen3Benchmark.Prompt)
	prefilled = model.Prefilled(prompt, 0)
	durations = benchmark.Durations(prefilled, prefilled.Next, prompt.Length, count, 1)
	speed = benchmark.Report(prompt.Length, 1, durations, 1)
	logger.Log(path + " using " + used + " experts without layers (" + dropped + "): " + speed)
	evaluation = Evaluation
	reports = Perplexity(model).Reports(tokenizer, evaluation.Heldout(8))
	logger.Log("English " + evaluation.Described(reports(0)) + ", Strict " + evaluation.Described(reports(1)))
Using(model Qwen3, count Number) Qwen3 slow
	Pruning.Using(Qwen3.TinyMixture, 1).blocks.First.experts.used is 1
	Pruning.Using(Qwen3.TinyMixture, 1).Step(1, 0).Scored.Length is 6
	mutable blocks = List(Mutable(Qwen3Block))
	for model.blocks
		blocks.Add(Qwen3Block(value, experts = Experts(value.experts, used = count)))
	Qwen3(model, blocks = blocks)
Without(model Qwen3, dropped Numbers) Qwen3 slow
	Pruning.Without(Qwen3.TinyMixture, List(Number) + 0).blocks.Length is Qwen3.TinyMixture.blocks.Length - 1
	mutable blocks = List(Mutable(Qwen3Block))
	for model.blocks
		if index is not in dropped
			blocks.Add(value)
	Qwen3(model, blocks = blocks)
