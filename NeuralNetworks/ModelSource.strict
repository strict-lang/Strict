has path Text
constant Hub = "https://huggingface.co/"
constant Small = "ggml-org/Qwen3-0.6B-GGUF/resolve/main/Qwen3-0.6B-Q8_0.gguf"
constant Usual = "Qwen/Qwen3-8B-GGUF/resolve/main/Qwen3-8B-Q4_K_M.gguf"
constant Liquid = "LiquidAI/LFM3-1.7B-GGUF/resolve/main/LFM3-1.7B-Q8_0.gguf"
constant Coder = "unsloth/Qwen3-Coder-30B-A3B-Instruct-GGUF/resolve/main/Qwen3-Coder-30B-A3B-Instruct-Q4_K_M.gguf"
constant Addresses = (Small, Usual, Liquid, Coder)
constant Qwen = "NeuralNetworks/qwen3/"
constant Paths = (Qwen + "model.gguf", Qwen + "Qwen3-8B-Q4_K_M.gguf", "NeuralNetworks/lfm3/LFM3-1.7B-Q8_0.gguf")
constant Sizes = (804753632, 5027783488, 1846238496, 18556689568)
Known Number
	ModelSource("NeuralNetworks/qwen3/model.gguf").Known is 0
	ModelSource("../Strict/NeuralNetworks/qwen3/Qwen3-8B-Q4_K_M.gguf").Known is 1
	ModelSource("D:\\Models\\Qwen3-Coder-30B-A3B-Instruct-Q4_K_M.gguf").Known is 3
	ModelSource("NeuralNetworks/missing.gguf").Known is Number.NotFound
	slashed = path.Replace("\\", "/")
	for Paths + ("/" + Path(Coder).FileName)
		if slashed.EndsWith(value)
			return index
	Number.NotFound
Ensured Text slow
	ModelSource("NeuralNetworks/Gguf.strict").Ensured is "NeuralNetworks/Gguf.strict"
	ModelSource("NeuralNetworks/missing.gguf").Ensured is "NeuralNetworks/missing.gguf"
	File(path).Exists or Known is Number.NotFound then path else Downloaded
Downloaded Text slow
	ModelSource("NeuralNetworks/missing.gguf").Downloaded is Error
	if Known is Number.NotFound
		return Error("UnknownModel: " + path)
	address = Hub + Addresses(Known)
	logger.Log("Downloading " + Path(path).FileName + " from " + address + " to " + path)
	logger.Log("Size " + (Sizes(Known) / 1000000).Round + " MB, kept in " + path + ".part until it is complete")
	Directory.Create(Path(path).PathOnly.text)
	started = Process.Elapsed
	logger.Log("Downloaded " + Receive(address, Sizes(Known)) + " in " + (Process.Elapsed - started).Round + " s")
	path
Receive(address Text, size Number) Text slow
	ModelSource("obj/missing.gguf").Receive("https://huggingface.co/missing", 1) is Error
	part = path + ".part"
	exitCode = Process.Find("curl").Start("-fL --progress-bar -o \"" + part + "\" \"" + address + "\"")
	if exitCode is not 0 or File(part).Exists is false
		return Error("DownloadFailed: curl exit code " + exitCode + " for " + address)
	received = File(part).Length
	if received is not size
		File(part).Delete
		return Error("DownloadIncomplete: " + received + " of " + size + " bytes from " + address)
	File(part).Rename(path)
	path
