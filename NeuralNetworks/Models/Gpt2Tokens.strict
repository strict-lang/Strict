has tokens Texts
has ids Dictionary(Text, Number)
has ranks Dictionary(Number, Number)
has isQwen Boolean = false
has specials Dictionary(Text, Number) = Dictionary(Text, Number)
has digits Number = 1
constant Printable = 33
constant DeleteOffset = 94
constant SoftHyphenIndex = 67
constant SoftHyphen = 173
constant Mapped = Json("\"\\u0120\"") to Text
constant Spaced = "{\"b\": 0, \"a\": 1, \"ab\": 2, \" \": 3, \"" + Mapped + "\": 4}"
constant Tiny = Gpt2Tokens.Parsed("{\"a\": 0, \"b\": 1, \"\\u0120\": 2, \"ab\": 3, \"\\u0120ab\": 4}", ("#version: 0.2", "a b", Mapped + " ab"))
Parsed(vocabulary Text, merges Texts) Gpt2Tokens
	Tiny.tokens is ("a", "b", " ", "ab", " ab")
	Tiny.ids(" ab") is 4
	Gpt2Tokens.Parsed(Spaced, ("#version: 0.2", "a b")).Merge("ab") is (2)
	ordered = Vocabulary(vocabulary)
	mutable known = Dictionary(Text, Number)
	for ordered
		known(value) = index
	Gpt2Tokens(ordered, known, Rank(merges, known, ordered.Length))
Loaded(model Gguf) Gpt2Tokens
	Gpt2Tokens.Loaded(Gguf("NeuralNetworks/tiny.gguf")).Encode("ab c") is (4, 5)
	Gpt2Tokens.Loaded(Gguf("NeuralNetworks/tiny.gguf")).isQwen
	Gpt2Tokens.Loaded(Gguf("NeuralNetworks/tinyqwen4exp.gguf")).isQwen
	Gpt2Tokens.Loaded(Gguf("NeuralNetworks/tinyqwen4exp.gguf")).Encode("ab<pad>") is (27, 31)
	mutable raw = List(Mutable(Text))
	mutable known = Dictionary(Text, Number)
	for model.Value("tokenizer.ggml.tokens").Lines
		raw.Add(Raw(value))
		known(raw.Last) = index
	ranked = Rank(model.Value("tokenizer.ggml.merges").Lines, known, raw.Length)
	splitting = model.Value("tokenizer.ggml.pre")
	isQwenLike = splitting is in ("qwen2", "qwen35") or Digits(splitting) > 1
	Gpt2Tokens(raw, known, ranked, isQwenLike, Controls(model, raw), Digits(splitting))
Digits(splitting Text) Number
	Gpt2Tokens.Digits("lfm2") is 3 and Gpt2Tokens.Digits("llama-bpe") is 3 and Gpt2Tokens.Digits("qwen2") is 1
	splitting is in ("lfm2", "llama-bpe") then 3 else 1
Controls(model Gguf, names Texts) Dictionary(Text, Number)
	Gpt2Tokens.Controls(Gguf.Tiny, Tiny.tokens).Length is 0
	mutable found = Dictionary(Text, Number)
	for model.Value("tokenizer.ggml.token_type").Lines
		if value is in ("3", "4")
			found(names(index)) = index
	found
Folder(folder Text) Gpt2Tokens slow
	Gpt2Tokens.Folder("NeuralNetworks/missing").tokens.Length is 0
	Gpt2Tokens.Folder("NeuralNetworks/tinytokens").tokens is ("a", "b", " ", "ab", " ab")
	Gpt2Tokens.Folder("NeuralNetworks/tinytokens").Encode("<s>ab ab") is (5, 3, 4)
	Gpt2Tokens.Folder("NeuralNetworks/tinytokens").isQwen
	vocabulary = Text.Combine(File(folder + "/vocab.json").ReadLines, "\n")
	parsed = Gpt2Tokens.Parsed(vocabulary, File(folder + "/merges.txt").ReadLines)
	config = folder + "/tokenizer_config.json"
	if File(config).Exists is false
		return parsed
	settings = Json.Read(config)
	qwen = settings.get("tokenizer_class") to Text is "Qwen2Tokenizer"
	Gpt2Tokens(parsed, isQwen = qwen, specials = Specials(settings.get("added_tokens_decoder")))
Vocabulary(json Text) Texts
	Vocabulary("{\"\\\"\": 0, \"\\\\\": 1, \"\\u0120a\": 2}") is ("\"", "\\", " a")
	Vocabulary("{\n  \"a\": 0,\n  \"b\": 1\n}") is ("a", "b")
	Vocabulary("{\"a\":0,\"b\":1}") is ("a", "b")
	mutable parsed = List(Mutable(Text))
	colon = json.IndexOf("\": 0") >= 0 then "\": " else "\":"
	mutable start = json.IndexOf("\"") + 1
	mutable ending = json.IndexOf(colon + 0, start)
	for as long as ending >= 0
		parsed.Add(Unescape(json.Substring(start, ending - start)))
		start = json.IndexOf("\"", ending + (colon + (parsed.Length - 1)).Length) + 1
		ending = json.IndexOf(colon + parsed.Length, start)
	parsed
Unescape(key Text) Text
	Unescape("\\u0120a\\\"") is " a\""
	Unescape(Mapped + "a") is " a"
	Raw(key.IndexOf("\\") < 0 then key else Json("\"" + key + "\"") to Text)
Unmap(code Number) Number
	Unmap(97) is 97
	Unmap(288) is 32
	Unmap(289) is 127
	Unmap(323) is 173
	if code < Byte.Values
		return code
	skipped = code - Byte.Values
	skipped < Printable then skipped else skipped < SoftHyphenIndex then skipped + DeleteOffset else SoftHyphen
Rank(merges Texts, known Dictionary(Text, Number), width Number) Dictionary(Number, Number)
	Tiny.ranks(1) is 0
	Tiny.ranks(13) is 1
	mutable ranked = Dictionary(Number, Number)
	for merges
		if " " is in value and value.StartsWith("#version") is false
			parts = value.Split(" ")
			ranked(known(Raw(parts(0))) * width + known(Raw(parts(1)))) = index - 1
	ranked
Raw(mapped Text) Text
	Raw(Mapped + "ab") is " ab"
	Raw("ab") is "ab"
	Raw(Json("\"\\u0121\"") to Text)(0).number is Character.Delete
	mutable raw = List(Number)
	for mapped
		raw = raw + Unmap(value.number)
	Text.Utf8(raw)
Decode(tokenIds Numbers) Text
	Tiny.Decode((4, 2, 0)) is " ab a"
	for tokenIds
		tokens(value)
Encode(text Text) Numbers
	Tiny.Encode(" ab a") is (4, 2, 0)
	Gpt2Tokens(Tiny, specials = Dictionary(("<s>", 5))).Encode("ab<s> ab") is (3, 5, 4)
	special = Special(text)
	if special is not ""
		at = text.IndexOf(special)
		rest = text.Substring(at + special.Length, text.Length - at - special.Length)
		return (Encode(text.Substring(0, at)) + specials(special)) + Encode(rest)
	mutable encoded = List(Mutable(Number))
	for TokenSplitter(isQwen, digits).Words(text)
		encoded = encoded + Merge(value)
	encoded
Special(text Text) Text
	Gpt2Tokens(Tiny, specials = Dictionary(("<s>", 5), ("</s>", 6))).Special("a</s><s>") is "</s>"
	Tiny.Special("a<s>") is ""
	mutable earliest = ""
	mutable at = text.Length
	for specials
		found = text.IndexOf(value.Key)
		if found >= 0 and (found < at or found is at and value.Key.Length > earliest.Length)
			earliest = value.Key
			at = found
	earliest
Specials(added Json) Dictionary(Text, Number)
	Gpt2Tokens.Specials(Json("{\"5\": {\"content\": \"<s>\"}}"))("<s>") is 5
	mutable found = Dictionary(Text, Number)
	for added.Keys
		found(added.get(value).get("content") to Text) = value to Number
	found
Merge(word Text) Numbers
	Tiny.Merge(" ab") is (4)
	Tiny.Merge("ba") is (1, 0)
	Gpt2Tokens.Parsed("{\"\\u00c3\": 0, \"\\u00a9\": 1}", List(Text)).Merge(Text.Utf8((195, 169))) is (0, 1)
	mutable symbols = List(Mutable(Number))
	for word.Bytes
		symbols.Add(ids(Text.Utf8(value)))
	mutable best = Best(symbols)
	for as long as best >= 0
		symbols = Join(symbols, best)
		best = Best(symbols)
	symbols
Best(symbols Numbers) Number
	Tiny.Best((2, 0, 1)) is 1
	Tiny.Best((2, 0)) is -1
	mutable best = -1
	mutable lowest = ranks.Length
	for Range(1, symbols.Length)
		pair = symbols(value - 1) * tokens.Length + symbols(value)
		if pair is in ranks and ranks(pair) < lowest
			best = value - 1
			lowest = ranks(pair)
	best
Join(symbols Numbers, at Number) Numbers
	Tiny.Join((2, 0, 1), 1) is (2, 3)
	merged = ids(tokens(symbols(at)) + tokens(symbols(at + 1)))
	for symbols
		if index is not at + 1
			index is at then merged else value