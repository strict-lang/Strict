constant Weights = "NeuralNetworks/lfm3/LFM3-1.7B-Q8_0.gguf"
constant Prompts = ("The capital of France is", "Three side lengths form a valid triangle when")
constant Count = 32
constant Sequences = 32
Run
	Respond(Weights, 8)
Respond(weights Text, bits Number) slow
	file = Gguf(weights)
	tokenizer = Gpt2Tokens.Loaded(file)
	started = Process.Elapsed
	model = Lfm3(Lfm3.Loaded(weights, bits), bos = Lfm3.Unloaded.Beginning(file))
	logger.Log("Loaded in " + (Process.Elapsed - started) + " s")
	for Prompts
		before = Process.Elapsed
		prompt = model.Prompt(tokenizer.Encode(value))
		generated = Generate(model.Prefilled(prompt), prompt.Length)
		speed = ((Process.Elapsed - before) * 1000 / Count).Round
		logger.Log(value + tokenizer.Decode(generated) + " (" + speed + " ms per token)")
	RunBatch(model, tokenizer, Sequences)
	Each(model, tokenizer)
RunBatch(model Lfm3, tokenizer Gpt2Tokens, sequences Number)
	prompt = model.Prompt(tokenizer.Encode(Prompts.First))
	prefilled = model.Prefilled(prompt)
	started = Process.Elapsed
	tokens = Decode(prefilled.Copies(sequences), prefilled.Next, prompt.Length, sequences)
	speed = (sequences * Count / (Process.Elapsed - started)).Round
	logger.Log(sequences + " sequences: " + speed + " tokens per second, first:" + tokenizer.Decode(tokens))
Decode(copies Lfm3, first Number, length Number, sequences Number) Numbers slow
	mutable model = copies
	mutable nexts = Same(first, sequences)
	mutable firsts = List(Mutable(Number))
	for Count
		firsts.Add(nexts.First)
		model = model.Steps(nexts, Same(length + value, sequences))
		nexts = model.Nexts
	firsts
Each(model Lfm3, tokenizer Gpt2Tokens) slow
	prompts = Encode(model, tokenizer)
	tokens = Interleave(model.PrefilledEach(prompts), SequenceLength(prompts).Align(1), prompts.Length)
	for prompts
		single = Generate(model.Prefilled(value), value.Length)
		batched = Pick(tokens, index, prompts.Length)
		logger.Log((single is batched then "same batched: " else "DIFFERENT batched: ") + tokenizer.Decode(batched))
Encode(model Lfm3, tokenizer Gpt2Tokens) List(Numbers) slow
	for Prompts
		model.Prompt(tokenizer.Encode(value))
Interleave(state Lfm3, length Number, sequences Number) Numbers slow
	mutable model = state
	mutable nexts = model.Nexts
	mutable all = List(Number)
	for Count
		all = all + nexts
		model = model.Steps(nexts, Same(length + value, sequences))
		nexts = model.Nexts
	all
Pick(tokens Numbers, sequence Number, sequences Number) Numbers
	Lfm3Text.Pick((1, 2, 3, 4), 1, 2) is (2, 4)
	for tokens.Length / sequences
		tokens(index * sequences + sequence)
Same(number Number, count Number) Numbers
	Lfm3Text.Same(3, 2) is (3, 3)
	for count
		number
Generate(prefilled Lfm3, length Number) Numbers slow
	mutable model = prefilled
	mutable tokens = List(Mutable(Number))
	for Count
		next = model.Next
		tokens.Add(next)
		model = model.Step(next, length + value)
	tokens
