constant Weights = "Qwen3-Coder-30B-A3B-Instruct-Q4_K_M.gguf"
constant Prompt = "def fibonacci(n):"
constant Count = 24
Run(folder Text)
	if MachineUse.Weights("Qwen3CoderText", folder + "/" + Weights).IsAdmitted
		Generate(folder)
Generate(folder Text)
	path = folder + "/" + Weights
	started = Process.Elapsed
	tokenizer = Gpt2Tokens.Loaded(Gguf(path))
	model = Qwen3.Loaded(path, 4)
	loaded = Process.Elapsed
	generated = Generation(model).Generate(tokenizer.Encode(Prompt), Count)
	milliseconds = ((Process.Elapsed - loaded) * 1000 / Count).Round(1)
	logger.Log(Prompt + tokenizer.Decode(generated))
	logger.Log("Qwen3-Coder-30B-A3B loaded in " + (loaded - started).Round(1) + " s, " + milliseconds + " ms per token")
