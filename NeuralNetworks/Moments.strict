has first List(Numbers)
has second List(Numbers)
has firstBias Numbers
has secondBias Numbers
constant SquareBeta = 0.999
constant Tiny = 0.00000001
constant Start = Moments(List(Numbers) + (0, 0), List(Numbers) + (0, 0), List(Number) + 0, List(Number) + 0)
Zeros(layer Layer) Moments
	Moments.Zeros(Layer.Halves) is Start
	biases = layer.Zeros(layer.biases.Length)
	Moments(Zero(layer.weights), Zero(layer.weights), biases, biases)
Zero(rows List(Numbers)) List(Numbers)
	Start.Zero(List(Numbers) + (3, 4)) is List(Numbers) + (0, 0)
	for rows
		value * 0
Updated(deltas Numbers, input Numbers, beta Number) Moments
	Start.Updated(List(Number) + 2, (1, 0), 0.5).first is List(Numbers) + (1, 0)
	Start.Updated(List(Number) + 2, (1, 0), 0.5).secondBias.First.Round(3) is 0.004
	gradients = Gradients(deltas, input)
	firsts = Average(first, gradients, beta, false)
	seconds = Average(second, gradients, SquareBeta, true)
	Moments(firsts, seconds, Mix(firstBias, deltas, beta, false), Mix(secondBias, deltas, SquareBeta, true))
Gradients(deltas Numbers, input Numbers) List(Numbers)
	Start.Gradients((1, 2), (3, 4)) is ((3, 4), (6, 8))
	for deltas
		input * value
Average(old List(Numbers), gradients List(Numbers), beta Number, isSquared Boolean) List(Numbers)
	Start.Average(List(Numbers) + (0, 0), List(Numbers) + (2, 4), 0.5, true) is List(Numbers) + (2, 8)
	for old
		Mix(value, gradients(index), beta, isSquared)
Mix(old Numbers, gradients Numbers, beta Number, isSquared Boolean) Numbers
	Start.Mix((0, 0), (2, 4), 0.5, false) is (1, 2)
	for old
		beta * value + (1 - beta) * (isSquared then gradients(index) * gradients(index) else gradients(index))
Apply(layer Layer, rate Number) Layer
	Start.Apply(Layer.Halves, 0.1) is Layer.Halves
	Layer(Step(layer.weights, first, second, rate), Move(layer.biases, firstBias, secondBias, rate), layer.activation)
Step(rows List(Numbers), firsts List(Numbers), seconds List(Numbers), rate Number) List(Numbers)
	Start.Step(List(Numbers) + (1, 1), List(Numbers) + (1, 0), List(Numbers) + (1, 0), 0.5).First.First.Round(3) is 0.5
	for rows
		Move(value, firsts(index), seconds(index), rate)
Move(values Numbers, firsts Numbers, seconds Numbers, rate Number) Numbers
	Start.Move((1, 1), (1, 0), (1, 0), 0.5).Last is 1
	for values
		value - rate * firsts(index) / (seconds(index).SquareRoot + Tiny)