has logger
Run(path Text, count Number, drafts Number)
	let model = Qwen3(Qwen3.Loaded(path, 4), cacheBits = 32)
	let prompt = Gpt2Tokens.Loaded(Gguf(path)).Encoded(Qwen3Benchmark.Prompt)
	let gguf = Gguf(path, 4)
	let drafter = Drafter.Loaded(gguf, gguf.Value("qwen35.attention.head_count") to Number)
	let started = Speculation(model.Prefilled(prompt, 0), prompt, model.Prefilled(prompt, 0).Next, drafts, 0, drafter)
	logger.Log("warmed up: " + Timed(started, 8))
	logger.Log(Timed(started, count))
	let drafted = Safetensors.Part(started.Finished(count).context, prompt.Length, count, 1)
	logger.Log(Gpt2Tokens.Loaded(Gguf(path)).Decoded(drafted))
Timed(started Speculation, count Number) Slow(Text)
	MtpProbe(Logger).Timed(Speculation.Drafting, 2).EndsWith("tokens per step")
	let before = Process.Elapsed
	let finished = started.Finished(count)
	let milliseconds = ((Process.Elapsed - before) * 1000 / count).Round(2)
	milliseconds + " ms per token, " + (count / finished.steps).Round(2) + " tokens per step"
