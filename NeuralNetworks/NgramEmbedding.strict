has keyProjection Layer
has valueProjection Layer
has normKey Numbers
has normQuery Numbers
has normConv Numbers
has conv List(Numbers)
constant Keys = Layer(((1, 0), (0, 1), (1, 1), (1, -1), (0, 2), (2, 0), (1, 0), (0, 1)), Layer.Unbiased)
constant Values = Layer(((1, 0), (0, 1)), Layer.Unbiased)
constant Ones = (1, 1, 1, 1, 1, 1, 1, 1)
constant Kernel = ((0.5, 1, 1, 0.25), (1, 1, 1, 1))
constant Norm = HyperStreams.Tiny.norm
constant Tiny = NgramEmbedding(Keys, Values, Norm, Ones, Norm, Kernel + Kernel + Kernel + Kernel)
constant Zero = Layer.Zeros(8)
constant Silence = (Zero, Zero, Zero, Zero, Zero, Zero, Zero, Zero, Zero, Zero)
constant Sample = Tiny.Gate(HyperStreams.Streams, (3, 1))
Loaded(model Gguf, prefix Text) NgramEmbedding slow
	NgramEmbedding.Loaded(HyperStreams.Flash, "blk.1.").conv.Length is 256
	NgramEmbedding.Loaded(HyperStreams.Flash, "blk.1.").keyProjection.weights.Length is 256
	keyed = Layer(model.Rows(prefix + "ple_key.weight"), Layer.Unbiased)
	valued = Layer(model.Rows(prefix + "ple_value.weight"), Layer.Unbiased)
	norms = (model.Values(prefix + "ple_norm_key.weight"), model.Values(prefix + "ple_norm_query.weight"))
	taps = Gguf(model, bits = Number.SingleBits).Rows(prefix + "ple_conv1d.weight")
	NgramEmbedding(keyed, valued, norms(0), norms(1), model.Values(prefix + "ple_norm_conv.weight"), taps)
Group(values Numbers, weights Numbers) Numbers
	Tiny.Group(HyperStreams.Streams, Norm) is HyperStreams.Tiny.Normalize(HyperStreams.Streams)
	HyperStreams(weights, HyperStreams.Down, HyperStreams.Up, HyperStreams.Inject).Normalize(values)
Gates(keys Numbers, queries Numbers) Numbers
	Tiny.Gates((1, 2, 0, 0, 1, 2, 0, 0), (3, 4, 3, 4, -3, -4, 0, 0))(0).IsNearlyEqual(0.9420751133972743)
	Tiny.Gates((1, 2, 0, 0, 1, 2, 0, 0), (3, 4, 3, 4, -3, -4, 0, 0))(2).IsNearlyEqual(0.057924886602725566)
	width = keys.Length / HyperStreams.Count
	for HyperStreams.Count
		Ngrams.Flash.Gate(keys.Slice(index * width, width), queries.Slice(index * width, width))
Gate(hidden Numbers, embedding Numbers) Numbers
	Tiny.Gate(HyperStreams.Streams, (3, 1))(0).IsNearlyEqual(2.296576550080954)
	Tiny.Gate(HyperStreams.Streams, (3, 1))(3).IsNearlyEqual(0.7548562572496241)
	Tiny.Gate(HyperStreams.Streams, (3, 1))(7).IsNearlyEqual(0.7610222206595999)
	gates = Gates(Group(keyProjection.Sums(embedding), normKey), Group(hidden, normQuery))
	values = valueProjection.Sums(embedding)
	for values.Length * HyperStreams.Count
		values(index % values.Length) * gates((index / values.Length).Floor)
Shift(history List(Numbers), gated Numbers) List(Numbers)
	Tiny.Shift((Ones, Ones), Sample)(1)(3).IsNearlyEqual(0.4472135170150118)
	Ngrams.Flash.Shift(history, Group(gated, normConv))
Combine(hidden Numbers, gated Numbers, history List(Numbers)) Numbers
	Tiny.Combine(HyperStreams.Streams, Sample, Tiny.Shift(Silence, Sample))(0).IsNearlyEqual(3.4921458714006173)
	Tiny.Combine(HyperStreams.Streams, Sample, Tiny.Shift(Silence, Sample))(7).IsNearlyEqual(1.3958891357351382)
	convolved = Ngrams.Flash.Convolve(Ngrams.Flash.Taps(history), conv)
	for hidden
		value + gated(index) + convolved(index)
