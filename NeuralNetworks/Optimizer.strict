has network Network
has moments List(Moments)
has beta Number
has step Number = 0
constant Adam = 0.9
constant RmsProp = 0
constant Paired = Optimizer.Started(Network.Pair, Adam)
Started(untrained Network, decay Number) Optimizer
	Paired.moments.Length is 2
	mutable zeros = List(Mutable(Moments))
	for untrained.layers
		zeros.Add(Moments.Zeros(value))
	Optimizer(untrained, zeros, decay)
Trained(input Numbers, target Numbers, rate Number) Optimizer
	Paired.Trained((1, 1), List(Number) + 0, 0.1).network.Predict((1, 1)).First < 0.7
	let activations = network.Activations(input)
	let deltas = network.Deltas(activations, target)
	let scaled = rate * (1 - Moments.SquareBeta ^ (step + 1)).SquareRoot / (1 - beta ^ (step + 1))
	mutable layers = List(Mutable(Layer))
	mutable updated = List(Mutable(Moments))
	for network.layers
		let moment = moments(index).Updated(deltas(index), activations(index), beta)
		updated.Add(moment)
		layers.Add(moment.Applied(value, scaled))
	Optimizer(Network(layers), updated, beta, step + 1)