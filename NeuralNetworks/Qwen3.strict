has blocks List(Qwen3Block)
has tokens List(Numbers)
has outputs List(Numbers)
has norm Numbers
has theta Number
has hidden Numbers = List(Number)
has cacheBits Number = 32
has rotary Number = 0
has basis Basis = Basis.None
has progress = ""
constant Tiny = Qwen3.Loaded("NeuralNetworks/tinyqwen3.gguf", 32)
constant TinyMixture = Qwen3.Loaded("NeuralNetworks/tinyqwen3moe.gguf", 32)
constant Prompted = Tiny.Prefilled((1, 2), 0)
constant TinyHybrid = Qwen3.Loaded("NeuralNetworks/tinyqwen35.gguf", 32)
constant TinyBasis = Qwen3.Loaded("NeuralNetworks/tinyqwen35basis.gguf", 32)
constant Interleaved = 60
constant Uneven = ((1, 2), (1, 2, 3))
Loaded(path Text, bits = 8, isGenerating = true) Qwen3 slow
	Tiny.blocks.Length is 1
	Tiny.theta is 1000000
	TinyMixture.outputs is not TinyMixture.tokens
	Qwen3.Loaded("NeuralNetworks/tinyqwen3moe.gguf", 32, false).outputs is TinyMixture.tokens
	model = Gguf(path, bits)
	base = model.Value(model.Value("general.architecture") + ".rope.freq_base") to Number
	embedding = model.Rows("token_embd.weight")
	output = isGenerating and model.Shape("output.weight").Length > 0 then model.Rows("output.weight") else embedding
	normed = model.Values("output_norm.weight")
	folding = Basis.Loaded(model)
	Qwen3(Blocks(model, folding), embedding, output, normed, base, rotary = Rotary(model), basis = folding)
Rotary(model Gguf) Number slow
	Tiny.Rotary(Gguf("NeuralNetworks/tinyqwen3.gguf")) is 0
	Tiny.Rotary(Gguf("NeuralNetworks/tinyqwen35.gguf")) is 2
	dimensions = model.Value(model.Value("general.architecture") + ".rope.dimension_count")
	dimensions is "" then 0 else dimensions to Number
Blocks(model Gguf, folding Basis) List(Qwen3Block) slow
	Tiny.Blocks(Gguf("NeuralNetworks/tinyqwen3.gguf"), Basis.None).First.heads is 2
	TinyHybrid.blocks.First.hybrid.layers.Length is 3
	architecture = model.Value("general.architecture")
	heads = model.Value(architecture + ".attention.head_count") to Number
	given = model.Value(architecture + ".full_attention_interval")
	interval = given is "" then 1 else given to Number
	extra = model.Value(architecture + ".nextn_predict_layers")
	layers = (model.Value(architecture + ".block_count") to Number) - (extra is "" then 0 else extra to Number)
	memory = Hybrid.Memory(model)
	for layers / interval
		attention = Qwen3Block.Loaded(model, "blk." + (index * interval + interval - 1) + ".", heads, folding)
		Qwen3Block(attention, hybrid = Hybrid.Loaded(model, index * interval, interval - 1, memory, folding))
Rotations(positions Numbers, heights = List(Number), widths = List(Number)) Numbers slow
	Tiny.Rotations(List(Number) + 0) is (1, 1, 1, 1, 0, 0, 0, 0)
	Tiny.Rotations(List(Number) + 1)(4).IsNearlyEqual(-0.8414709848078965)
	Tiny.Rotations((0, 1))(13).IsNearlyEqual(-0.0009999998333333417)
	Qwen3(Tiny, rotary = 2).Rotations(List(Number) + 1)(1) is 1
	half = blocks.First.queryNorm.Length / 2
	pairs = rotary > 0 then rotary / 2 else half
	for positions.Length * 4 * half
		at = index % (4 * half)
		pair = at % half
		position = Place(pair, (index / (4 * half)).Floor, positions, heights, widths)
		angle = Radians(pair < pairs then position * theta ^ (-pair / pairs) else 0) to Degrees
		at < 2 * half then angle.Cos else (at < 3 * half then -angle.Sin else angle.Sin)
Step(token Number, position Number) Qwen3 slow
	Tiny.Step(1, 0).Scored.First.IsNearlyEqual(2.664049302641475)
	Tiny.Step(1, 0).Step(2, 1).Scored.Last.IsNearlyEqual(1.1076484232754447)
	TinyMixture.Step(1, 0).Scored.First.IsNearlyEqual(0.9534001625146007, 0.000001)
	TinyHybrid.Step(1, 0).Scored.First.IsNearlyEqual(0.307727, 0.000001)
	TinyHybrid.Step(1, 0).Step(2, 1).Scored.First.IsNearlyEqual(2.182707, 0.000001)
	TinyBasis.Step(1, 0).Step(2, 1).Scored.First.IsNearlyEqual(2.182707, 0.00001)
	TinyBasis.Prefilled((1, 2, 3), 0).Nexts is TinyHybrid.Prefilled((1, 2, 3), 0).Nexts
	Steps(List(Number) + token, List(Number) + position, 1)
Positions(start Number, count Number) Numbers
	Tiny.Positions(2, 3) is (2, 3, 4)
	TinyMixture.Prefilled((1, 2, 3), 0, 4).hidden.Length is 8
	for count
		start + index
Prefilled(prompt Numbers, start Number, chunk = 8192) Qwen3
	Prompted.Scored.Last.IsNearlyEqual(Tiny.Step(1, 0).Step(2, 1).Scored.Last)
	Prompted.Prefilled((3, 4), 2).Next is Tiny.Step(1, 0).Step(2, 1).Step(3, 2).Step(4, 3).Next
	TinyMixture.Prefilled((1, 2), 0).Next is TinyMixture.Step(1, 0).Step(2, 1).Next
	Tiny.Prefilled((1, 2, 3), 0, 2).hidden.Length is 8
	Tiny.Prefilled((1, 2, 3), 0, 2).Next is Tiny.Prefilled((1, 2, 3), 0).Next
	mutable current = value
	size = (chunk / blocks.First.experts.used).Ceiling
	for (prompt.Length / size).Ceiling
		first = index * size
		count = (prompt.Length - first).Clamp(0, size)
		current = current.Steps(Safetensors.Part(prompt, first, count, 1), Positions(start + first, count), 1)
	current
PrefilledBatch(prompts List(Numbers), start = 0, chunk = 8192) List(Numbers) native
	Tiny.PrefilledBatch(Uneven).Last.Last.IsNearlyEqual(Tiny.Prefilled((1, 2, 3), 0).hidden.Last, 0.0001)
	TinyHybrid.PrefilledBatch(Uneven).First.First.IsNearlyEqual(TinyHybrid.Prefilled((1, 2), 0).hidden.First, 0.0001)
	TinyHybrid.PrefilledBatch(Uneven).Last.Last.IsNearlyEqual(TinyHybrid.Prefilled((1, 2, 3), 0).hidden.Last, 0.0001)
	if prompts.Length < 2
		return prompts.Length is 0 then List(Numbers) else List(Numbers) + Prefilled(prompts.First, start).hidden
	seqLen = SequenceLength(prompts).Align(blocks.First.hybrid.layers.Length > 0 then 16 else 1)
	perBatch = (chunk / blocks.First.experts.used / seqLen).Floor.Clamp(1, prompts.Length)
	mutable results = List(Mutable(Numbers))
	for (prompts.Length / perBatch).Ceiling
		first = index * perBatch
		count = (prompts.Length - first).Clamp(0, perBatch)
		batched = RunBatch(prompts.Slice(first, count), seqLen, start)
		for count
			results.Add(batched.Slice(index * seqLen * norm.Length, prompts(first + index).Length * norm.Length))
	results
RunBatch(prompts List(Numbers), length Number, start Number) Numbers
	Tiny.RunBatch(Uneven, 3, 0).Length is 2 * 3 * Tiny.norm.Length
	part = SequenceLength(prompts)
	Steps(part.Padd(length), part.Positions(length, start), prompts.Length).hidden
Steps(chosen Numbers, positions Numbers, sequences Number) Qwen3
	Tiny.Steps(List(Number) + 1, List(Number) + 0, 1).hidden.Length is 8
	Prompted.Copies(2).Steps((3, 4), (2, 2), 2).hidden.Length is 16
	Forwarded(basis.Restore(Embedd(chosen), norm.Length), Rotations(positions), sequences, List(Numbers), List(Number))
Forwarded(input Numbers, rotation Numbers, sequences Number, deepstack List(Numbers), rows Numbers) Qwen3
	Tiny.Forwarded(Tiny.Embedd((1, 2)), Tiny.Rotations((0, 1)), 1, List(Numbers), List(Number)).hidden is Prompted.hidden
	mutable current = input
	mutable updated = List(Mutable(Qwen3Block))
	completion = Completion(progress, blocks.Length, Process.Elapsed)
	for blocks
		prepared = value.hybrid.Prepared(current, sequences)
		cached = Qwen3Block(value, hybrid = prepared).Cached(prepared.entered, rotation, cacheBits, sequences)
		output = cached.Output(prepared.entered, sequences)
		current = index < deepstack.Length then Stack(output, deepstack(index), rows) else output
		updated.Add(Qwen3Block(cached, queries = List(Number), hybrid = Hybrid(prepared.layers, inputs = prepared.inputs)))
		completion.Report(index + 1)
	Qwen3(value, blocks = updated, hidden = current)
Stack(numbers Numbers, features Numbers, rows Numbers) Numbers
	Qwen3(Tiny, norm = (1, 1)).Stack((1, 2, 3, 4, 5, 6), (10, 20), (-1, 0, -1)) is (1, 2, 13, 24, 5, 6)
	width = norm.Length
	for numbers
		row = rows((index / width).Floor)
		row < 0 then value else value + features(row * width + index % width)
Place(pair Number, row Number, positions Numbers, heights Numbers, widths Numbers) Number
	(Tiny.Place(1, 0, 5, 6, 7), Tiny.Place(2, 0, 5, 6, 7), Tiny.Place(3, 0, 5, 6, 7)) is (6, 7, 5)
	(Tiny.Place(1, 0, 5, List(Number), List(Number)), Tiny.Place(61, 0, 5, 6, 7)) is (5, 5)
	axis = heights.Length is 0 or pair >= Interleaved then 0 else pair % 3
	axis is 0 then positions(row) else (axis is 1 then heights(row) else widths(row))
Scored Numbers
	Tiny.Step(1, 0).Scored.Length is 6
	basis.Sums(outputs, Layer.Unbiased, Qwen3Block.Normalize(hidden, hidden.Length - norm.Length, norm.Length, norm))
Next Number
	Tiny.Step(1, 0).Next is 0
	Greedy.Largest(Scored)
Nexts Numbers
	Prompted.Copies(2).Steps((3, 4), (2, 2), 2).Nexts is (Prompted.Step(3, 2).Next, Prompted.Step(4, 2).Next)
	logits = basis.Sums(outputs, Layer.Unbiased, Qwen3Block.Normalize(hidden, 0, hidden.Length, norm))
	Greedy.Rows(logits, outputs.Length)
Embedd(chosen Numbers) Numbers
	Tiny.Embedd((1, 2)).Length is 16
	Tiny.Embedd((1, 2))(8) is Tiny.tokens(2).First
	width = norm.Length
	for chosen.Length * width
		tokens(chosen((index / width).Floor))(index % width)
Copies(count Number) Qwen3
	Prompted.Copies(2).blocks.First.keys.Length is 16
	mutable copied = List(Mutable(Qwen3Block))
	for blocks
		copied.Add(value.Copies(count, cacheBits))
	Qwen3(value, blocks = copied)
