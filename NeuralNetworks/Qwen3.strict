has blocks List(Qwen3Block)
has tokens List(Numbers)
has outputs List(Numbers)
has norm Numbers
has theta Number
has hidden Numbers = List(Number)
constant Tiny = Qwen3.Loaded("NeuralNetworks/tinyqwen3.gguf", 32)
constant TinyMixture = Qwen3.Loaded("NeuralNetworks/tinyqwen3moe.gguf", 32)
Loaded(path Text, bits = 8) Qwen3
	Tiny.blocks.Length is 1
	Tiny.theta is 1000000
	TinyMixture.outputs is not TinyMixture.tokens
	let model = Gguf(path, bits)
	let base = model.Value(model.Value("general.architecture") + ".rope.freq_base") to Number
	let embedding = model.Rows("token_embd.weight")
	let output = model.Shape("output.weight").Length > 0 then model.Rows("output.weight") else embedding
	Qwen3(Blocks(model), embedding, output, model.Values("output_norm.weight"), base)
Blocks(model Gguf) List(Qwen3Block)
	Tiny.Blocks(Qwen3Block.Weights).First.heads is 2
	let architecture = model.Value("general.architecture")
	let heads = model.Value(architecture + ".attention.head_count") to Number
	for model.Value(architecture + ".block_count") to Number
		Qwen3Block.Loaded(model, "blk." + index + ".", heads)
Angles(position Number) Numbers
	Tiny.Angles(1) is (Radians(1) to Degrees, Radians(0.001) to Degrees)
	let half = blocks.First.queryNorm.Length / 2
	for half
		Radians(position * theta ^ (-index / half)) to Degrees
Rotation(position Number) Numbers
	Tiny.Rotation(0) is (1, 1, 1, 1, 0, 0, 0, 0)
	let angles = Angles(position)
	let cosines = Cosines(angles)
	let sines = Sines(angles)
	cosines + cosines + sines * -1 + sines
Cosines(angles Numbers) Numbers
	Tiny.Cosines((0, 180)) is (1, -1)
	for angles
		Degrees(value).Cos
Sines(angles Numbers) Numbers
	Tiny.Sines((0, 90)) is (0, 1)
	for angles
		Degrees(value).Sin
Step(token Number, position Number) Qwen3
	Tiny.Step(1, 0).Scored.First.IsNearlyEqual(2.664049302641475)
	Tiny.Step(1, 0).Step(2, 1).Scored.Last.IsNearlyEqual(1.1076484232754447)
	TinyMixture.Step(1, 0).Scored.First.IsNearlyEqual(0.9534001625146007, 0.000001)
	Forwarded(tokens(token), Rotation(position))
Prefilled(prompt Numbers, start Number) Qwen3
	Tiny.Prefilled((1, 2), 0).Scored.Last.IsNearlyEqual(Tiny.Step(1, 0).Step(2, 1).Scored.Last)
	Tiny.Prefilled((1, 2), 0).Prefilled((3, 4), 2).Next is Tiny.Step(1, 0).Step(2, 1).Step(3, 2).Step(4, 3).Next
	TinyMixture.Prefilled((1, 2), 0).Next is TinyMixture.Step(1, 0).Step(2, 1).Next
	mutable state = List(Number)
	mutable rotation = List(Number)
	for prompt
		state = state + tokens(value)
		rotation = rotation + Rotation(start + index)
	Forwarded(state, rotation)
Forwarded(state Numbers, rotation Numbers) Qwen3
	Tiny.Forwarded(Tiny.tokens(1), Tiny.Rotation(0)).hidden.Length is 8
	mutable current = state
	mutable updated = List(Mutable(Qwen3Block))
	for blocks
		let cached = value.Cached(current, rotation)
		current = cached.Output(current)
		updated.Add(cached)
	Qwen3(value, blocks = updated, hidden = current)
Scored Numbers
	Tiny.Step(1, 0).Scored.Length is 6
	let normed = Qwen3Block.Normalized(hidden, hidden.Length - norm.Length, norm.Length, norm)
	for outputs
		Layer.Summed(value, normed)
Next Number
	Tiny.Step(1, 0).Next is 0
	Largest(Scored)
Largest(logits Numbers) Number
	Tiny.Largest((1, 3, 2)) is 1
	let best = Best(logits, 128)
	best(2 * Chosen(best) + 1)
Best(scores Numbers, width Number) Numbers
	Tiny.Best((1, 3, 2, 0), 2) is (3, 1, 2, 2)
	Tiny.Best((1, 3, 2), 2) is (3, 1, 2, 2)
	for 2 * (scores.Length / width).Ceiling
		let start = (index / 2).Floor * width
		let odd = index % 2
		mutable largest = scores(start)
		mutable position = start
		for (scores.Length - start).Clamp(0, width)
			position = Above(scores(start + index), largest, start + index, position)
			largest = Softmax.Larger(largest, scores(start + index))
		Above(odd, 0, position, largest)
Above(number Number, limit Number, chosen Number, otherwise Number) Number
	Tiny.Above(2, 1, 5, 6) is 5
	Tiny.Above(1, 1, 5, 6) is 6
	number > limit then chosen else otherwise
Chosen(pairs Numbers) Number
	Tiny.Chosen((1, 0, 3, 1, 2, 2)) is 1
	mutable chosen = 0
	for pairs.Length / 2
		if pairs(2 * index) > pairs(2 * chosen)
			chosen = index
	chosen