has blocks List(Qwen3Block)
has tokens List(Numbers)
has outputs List(Numbers)
has norm Numbers
has theta Number
has hidden Numbers = List(Number)
has cacheBits Number = 32
has rotary Number = 0
has basis Basis = Basis.None
constant Tiny = Qwen3.Loaded("NeuralNetworks/tinyqwen3.gguf", 32)
constant TinyMixture = Qwen3.Loaded("NeuralNetworks/tinyqwen3moe.gguf", 32)
constant Prompted = Tiny.Prefilled((1, 2), 0)
constant TinyHybrid = Qwen3.Loaded("NeuralNetworks/tinyqwen35.gguf", 32)
constant TinyBasis = Qwen3.Loaded("NeuralNetworks/tinyqwen35basis.gguf", 32)
constant Interleaved = 60
Loaded(path Text, bits = 8) Slow(Qwen3)
	Tiny.blocks.Length is 1
	Tiny.theta is 1000000
	TinyMixture.outputs is not TinyMixture.tokens
	let model = Gguf(path, bits)
	let architecture = model.Value("general.architecture")
	let base = model.Value(architecture + ".rope.freq_base") to Number
	let embedding = model.Rows("token_embd.weight")
	let output = model.Shape("output.weight").Length > 0 then model.Rows("output.weight") else embedding
	let normed = model.Values("output_norm.weight")
	let folding = Basis.Loaded(model)
	Qwen3(Blocks(model, folding), embedding, output, normed, base, rotary = Rotary(model), basis = folding)
Rotary(model Gguf) Slow(Number)
	Tiny.Rotary(Gguf("NeuralNetworks/tinyqwen3.gguf")) is 0
	Tiny.Rotary(Gguf("NeuralNetworks/tinyqwen35.gguf")) is 2
	let dimensions = model.Value(model.Value("general.architecture") + ".rope.dimension_count")
	dimensions is "" then 0 else dimensions to Number
Blocks(model Gguf, folding Basis) Slow(List(Qwen3Block))
	Tiny.Blocks(Gguf("NeuralNetworks/tinyqwen3.gguf"), Basis.None).First.heads is 2
	TinyHybrid.blocks.First.hybrid.layers.Length is 3
	let architecture = model.Value("general.architecture")
	let heads = model.Value(architecture + ".attention.head_count") to Number
	let given = model.Value(architecture + ".full_attention_interval")
	let interval = given is "" then 1 else given to Number
	let extra = model.Value(architecture + ".nextn_predict_layers")
	let layers = (model.Value(architecture + ".block_count") to Number) - (extra is "" then 0 else extra to Number)
	let memory = Hybrid.Memory(model)
	for layers / interval
		let attention = Qwen3Block.Loaded(model, "blk." + (index * interval + interval - 1) + ".", heads, folding)
		Qwen3Block(attention, hybrid = Hybrid.Loaded(model, index * interval, interval - 1, memory, folding))
Rotations(positions Numbers, heights = List(Number), widths = List(Number)) Slow(Numbers)
	Tiny.Rotations(List(Number) + 0) is (1, 1, 1, 1, 0, 0, 0, 0)
	Tiny.Rotations(List(Number) + 1)(4).IsNearlyEqual(-0.8414709848078965)
	Tiny.Rotations((0, 1))(13).IsNearlyEqual(-0.0009999998333333417)
	Qwen3(Tiny, rotary = 2).Rotations(List(Number) + 1)(1) is 1
	let half = blocks.First.queryNorm.Length / 2
	let pairs = rotary > 0 then rotary / 2 else half
	for positions.Length * 4 * half
		let at = index % (4 * half)
		let pair = at % half
		let position = Placed(pair, (index / (4 * half)).Floor, positions, heights, widths)
		let angle = Radians(pair < pairs then position * theta ^ (-pair / pairs) else 0) to Degrees
		at < 2 * half then angle.Cos else (at < 3 * half then 0 - angle.Sin else angle.Sin)
Step(token Number, position Number) Slow(Qwen3)
	Tiny.Step(1, 0).Scored.First.IsNearlyEqual(2.664049302641475)
	Tiny.Step(1, 0).Step(2, 1).Scored.Last.IsNearlyEqual(1.1076484232754447)
	TinyMixture.Step(1, 0).Scored.First.IsNearlyEqual(0.9534001625146007, 0.000001)
	TinyHybrid.Step(1, 0).Scored.First.IsNearlyEqual(0.307727, 0.000001)
	TinyHybrid.Step(1, 0).Step(2, 1).Scored.First.IsNearlyEqual(2.182707, 0.000001)
	TinyBasis.Step(1, 0).Step(2, 1).Scored.First.IsNearlyEqual(2.182707, 0.00001)
	TinyBasis.Prefilled((1, 2, 3), 0).Nexts is TinyHybrid.Prefilled((1, 2, 3), 0).Nexts
	Steps(List(Number) + token, List(Number) + position, 1)
Positions(start Number, count Number) Numbers
	Tiny.Positions(2, 3) is (2, 3, 4)
	TinyMixture.Prefilled((1, 2, 3), 0, 4).hidden.Length is 8
	for count
		start + index
Prefilled(prompt Numbers, start Number, chunk = 8192) Qwen3
	Prompted.Scored.Last.IsNearlyEqual(Tiny.Step(1, 0).Step(2, 1).Scored.Last)
	Prompted.Prefilled((3, 4), 2).Next is Tiny.Step(1, 0).Step(2, 1).Step(3, 2).Step(4, 3).Next
	TinyMixture.Prefilled((1, 2), 0).Next is TinyMixture.Step(1, 0).Step(2, 1).Next
	Tiny.Prefilled((1, 2, 3), 0, 2).hidden.Length is 8
	Tiny.Prefilled((1, 2, 3), 0, 2).Next is Tiny.Prefilled((1, 2, 3), 0).Next
	mutable current = value
	let size = (chunk / blocks.First.experts.used).Ceiling
	for (prompt.Length / size).Ceiling
		let first = index * size
		let count = (prompt.Length - first).Clamp(0, size)
		current = current.Steps(Safetensors.Part(prompt, first, count, 1), Positions(start + first, count), 1)
	current
Steps(chosen Numbers, positions Numbers, sequences Number) Qwen3
	Tiny.Steps(List(Number) + 1, List(Number) + 0, 1).hidden.Length is 8
	Prompted.Copies(2).Steps((3, 4), (2, 2), 2).hidden.Length is 16
	Forwarded(basis.Restored(Embedded(chosen), norm.Length), Rotations(positions), sequences, List(Numbers), List(Number))
Forwarded(input Numbers, rotation Numbers, sequences Number, deepstack List(Numbers), rows Numbers) Qwen3
	Tiny.Forwarded(Tiny.Embedded((1, 2)), Tiny.Rotations((0, 1)), 1, List(Numbers), List(Number)).hidden is Prompted.hidden
	mutable current = input
	mutable updated = List(Mutable(Qwen3Block))
	for blocks
		let prepared = value.hybrid.Prepared(current)
		let cached = Qwen3Block(value, hybrid = prepared).Cached(prepared.entered, rotation, cacheBits)
		current = cached.Output(prepared.entered, sequences)
		if index < deepstack.Length
			current = Stacked(current, deepstack(index), rows)
		updated.Add(Qwen3Block(cached, queries = List(Number), hybrid = Hybrid(prepared.layers, inputs = prepared.inputs)))
	Qwen3(value, blocks = updated, hidden = current)
Stacked(numbers Numbers, features Numbers, rows Numbers) Numbers
	Qwen3(Tiny, norm = (1, 1)).Stacked((1, 2, 3, 4, 5, 6), (10, 20), (-1, 0, -1)) is (1, 2, 13, 24, 5, 6)
	let width = norm.Length
	for numbers
		let row = rows((index / width).Floor)
		row < 0 then value else value + features(row * width + index % width)
Placed(pair Number, row Number, positions Numbers, heights Numbers, widths Numbers) Number
	(Tiny.Placed(1, 0, (5), (6), (7)), Tiny.Placed(2, 0, (5), (6), (7)), Tiny.Placed(3, 0, (5), (6), (7))) is (6, 7, 5)
	(Tiny.Placed(1, 0, (5), List(Number), List(Number)), Tiny.Placed(61, 0, (5), (6), (7))) is (5, 5)
	let axis = heights.Length is 0 or pair >= Interleaved then 0 else pair % 3
	axis is 0 then positions(row) else (axis is 1 then heights(row) else widths(row))
Scored Numbers
	Tiny.Step(1, 0).Scored.Length is 6
	basis.Sums(outputs, Layer.Unbiased, Qwen3Block.Normalized(hidden, hidden.Length - norm.Length, norm.Length, norm))
Next Number
	Tiny.Step(1, 0).Next is 0
	Greedy.Largest(Scored)
Nexts Numbers
	Prompted.Copies(2).Steps((3, 4), (2, 2), 2).Nexts is (Prompted.Step(3, 2).Next, Prompted.Step(4, 2).Next)
	let logits = basis.Sums(outputs, Layer.Unbiased, Qwen3Block.Normalized(hidden, 0, hidden.Length, norm))
	Greedy.Rows(logits, outputs.Length)
Embedded(chosen Numbers) Numbers
	Tiny.Embedded((1, 2)).Length is 16
	Tiny.Embedded((1, 2))(8) is Tiny.tokens(2).First
	let width = norm.Length
	for chosen.Length * width
		tokens(chosen((index / width).Floor))(index % width)
Copies(count Number) Qwen3
	Prompted.Copies(2).blocks.First.keys.Length is 16
	mutable copied = List(Mutable(Qwen3Block))
	for blocks
		copied.Add(value.Copies(count, cacheBits))
	Qwen3(value, blocks = copied)
