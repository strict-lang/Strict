constant Prompt = "Alan Turing theorized that computers would one day become"
constant TopK = 40
constant TopP = 0.95
constant TailShare = 0.95
Run(path Text, bits Number, count Number, repeats = 1, batch = 1, cacheBits = 32, temperature = 0)
	if MachineUse.Weights("Qwen3Benchmark", path).IsAdmitted
		Benchmark(path, bits, count, repeats, batch, cacheBits, temperature)
Benchmark(path Text, bits Number, count Number, repeats Number, batch Number, cacheBits Number, temperature Number) slow
	tokenizer = Gpt2Tokens.Loaded(Gguf(path))
	started = Process.Elapsed
	model = Qwen3(Qwen3.Loaded(path, bits), cacheBits = cacheBits)
	loaded = Process.Elapsed
	prompt = Repeat(tokenizer.Encode(Prompt), repeats)
	logger.Log(Prompt + tokenizer.Decode(Sample(model.Prefilled(prompt, 0), prompt.Length, count, temperature)))
	prefill = Fastest(model, prompt)
	prefilled = model.Prefilled(prompt, 0)
	first = prefilled.Next
	durations = Durations(batch is 1 then prefilled else prefilled.Copies(batch), first, prompt.Length, count, batch)
	logger.Log(Report(prompt.Length, prefill, durations, batch) + ", loaded in " + (loaded - started).Round(1) + " s")
Fastest(model Qwen3, prompt Numbers) Number slow
	Qwen3Benchmark.Fastest(Qwen3.Tiny, (1, 2)) > 0
	mutable fastest = 1000000
	for 3
		before = Process.Elapsed
		first = model.Prefilled(prompt, 0).Next
		milliseconds = (Process.Elapsed - before) * 1000 / prompt.Length
		fastest = first >= 0 and milliseconds < fastest then milliseconds else fastest
	fastest
Sample(model Qwen3, position Number, count Number, temperature Number) Numbers slow
	Qwen3Benchmark.Sample(Qwen3.Tiny.Step(1, 0), 1, 2, 1).Length is 2
	started = Process.Elapsed
	tokens = Generation(model, Sampling(temperature, TopK, TopP, PseudoRandom(1))).Continue(position, count)
	milliseconds = ((Process.Elapsed - started) * 1000 / count).Round(2)
	if temperature > 0
		logger.Log("sampled " + count + " tokens at temperature " + temperature + " in " + milliseconds + " ms per token")
	tokens
Repeat(tokens Numbers, repeats Number) Numbers
	Qwen3Benchmark.Repeat((1, 2), 2) is (1, 2, 1, 2)
	for tokens.Length * repeats
		tokens(index % tokens.Length)
Durations(model Qwen3, token Number, start Number, count Number, batch Number) Numbers slow
	Qwen3Benchmark.Durations(Qwen3.Tiny.Step(1, 0), 0, 1, 2, 1).Length is 2
	Qwen3Benchmark.Durations(Qwen3.Tiny.Step(1, 0).Copies(2), 0, 1, 2, 2).Length is 2
	mutable current = model
	mutable chosen = Repeat(List(Number) + token, batch)
	mutable last = Process.Elapsed
	for count
		current = current.Steps(chosen, Repeat(List(Number) + (start + index), batch), batch)
		chosen = current.Nexts
		GpuMemory.Finish
		duration = (Process.Elapsed - last) * 1000
		last = last + duration / 1000
		duration
Report(prompt Number, prefill Number, durations Numbers, batch Number) Text
	Qwen3Benchmark.Report(2, 4, (10, 20, 30), 1).StartsWith("prefill 2 tokens 4 ms (250 tokens/s)")
	Qwen3Benchmark.Report(2, 4, (10, 20, 30), 8).EndsWith("median 20 ms (400 tokens/s) mean 20 ms p95 30 ms")
	median = Quantile(durations, 0.5)
	mean = durations.Sum / durations.Length
	prefilled = "prefill " + prompt + " tokens " + prefill.Round(2) + " ms (" + (1000 / prefill).Round + " tokens/s), "
	steps = batch is 1 then durations.Length + " tokens" else durations.Length + " steps of " + batch + " tokens"
	decoded = "decode " + steps + " median " + median.Round(2) + " ms (" + (batch * 1000 / median).Round
	late = " ms p95 " + Quantile(durations, TailShare).Round(2) + " ms"
	prefilled + decoded + " tokens/s) mean " + mean.Round(2) + late
Quantile(numbers Numbers, share Number) Number
	Qwen3Benchmark.Quantile((3, 1, 2), 0.5) is 2
	Qwen3Benchmark.Quantile((4, 1, 3, 2), 0.5) is 3
	Qwen3Benchmark.Quantile((4, 1, 3, 2), 0.95) is 4
	Qwen3Benchmark.Quantile((1, 2, 2, 3), 0.5) is 2
	numbers.Sorted((numbers.Length * share).Floor)