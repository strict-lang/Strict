has attentionNorm Numbers
has attention Layer
has projection Layer
has queryNorm Numbers
has keyNorm Numbers
has mlpNorm Numbers
has experts Experts
has heads Number
has groups Number
has keys Numbers = List(Number)
has values Numbers = List(Number)
has queries Numbers = List(Number)
constant Epsilon = 0.000001
constant Weights = Gguf("NeuralNetworks/tinyqwen3.gguf")
constant Tiny = Qwen3Block.Loaded(Weights, "blk.0.", 2)
Loaded(model Gguf, prefix Text, queryHeads Number) Qwen3Block
	Tiny.attention.weights.Length is 16
	Tiny.experts.expansions.First.weights.Length is 32
	Tiny.groups is 1
	let attended = Dense(model, prefix, ("attn_q", "attn_k", "attn_v"))
	let projected = Dense(model, prefix, List(Text) + "attn_output")
	let norms = Norms(model, prefix)
	let keyHeads = (attended.weights.Length / norms(1).Length - queryHeads) / 2
	let feedForward = FeedForward(model, prefix)
	Qwen3Block(norms(0), attended, projected, norms(1), norms(2), norms(3), feedForward, queryHeads, keyHeads)
FeedForward(model Gguf, prefix Text) Experts
	Tiny.FeedForward(Weights, "blk.0.").used is 1
	Tiny.FeedForward(Experts.Model, "blk.0.").used is 2
	if model.Shape(prefix + "ffn_gate_inp.weight").Length > 0
		return Experts.Loaded(model, prefix)
	Experts.Dense(Dense(model, prefix, ("ffn_gate", "ffn_up")), Dense(model, prefix, List(Text) + "ffn_down"))
Dense(model Gguf, prefix Text, names Texts) Layer
	Tiny.Dense(Weights, "blk.0.", List(Text) + "ffn_down").weights.Length is 8
	Tiny.Dense(Weights, "blk.0.", List(Text) + "ffn_down").biases.Length is 8
	mutable rows = List(Numbers)
	for names
		rows = rows + model.Rows(prefix + value + ".weight")
	Layer(rows, Layer.Zeros(rows.Length))
Norms(model Gguf, prefix Text) List(Numbers)
	Tiny.Norms(Weights, "blk.0.").Length is 4
	for ("attn_norm", "attn_q_norm", "attn_k_norm", "ffn_norm")
		model.Values(prefix + value + ".weight")
Cached(input Numbers, rotation Numbers) Qwen3Block
	Tiny.Cached(Tiny.attentionNorm, (1, 1, 0, 0)).keys.Length is 4
	Tiny.Cached(Tiny.attentionNorm, (1, 1, 0, 0)).queries.Length is 8
	Tiny.Cached(Tiny.attentionNorm, (1, 1, 0, 0)).Cached(Tiny.attentionNorm, (1, 1, 0, 0)).values.Length is 8
	let combined = attention.Sums(Normalized(input, 0, input.Length, attentionNorm))
	let size = queryNorm.Length
	let queried = Rotated(Normalized(combined, 0, heads * size, queryNorm), rotation)
	let keyed = Rotated(Normalized(combined, heads * size, groups * size, keyNorm), rotation)
	let valued = Safetensors.Part(combined, (heads + groups) * size, groups * size, 1)
	Qwen3Block(value, keys = keys + keyed, values = values + valued, queries = queried)
Rotated(numbers Numbers, rotation Numbers) Numbers
	Tiny.Rotated((1, 2, 3, 4), (1, 1, 0, 0)) is (1, 2, 3, 4)
	Tiny.Rotated((1, 2, 3, 4), (0, 0, 1, 1)) is (-3, -4, 1, 2)
	Tiny.Rotated((1, 2, 3, 4, 5, 6, 7, 8), (0, 0, 1, 1)) is (-3, -4, 1, 2, -7, -8, 5, 6)
	let size = rotation.Length
	let half = size / 2
	for numbers
		let within = index % size
		let turn = within % half
		let sign = (within / half).Floor * 2 - 1
		value * rotation(turn) + sign * numbers(index - within + (within + half) % size) * rotation(half + turn)
Normalized(input Numbers, start Number, count Number, weights Numbers) Numbers
	Tiny.Normalized((3, 4), 0, 2, (1, 2)).First.IsNearlyEqual(0.848528) is true
	Tiny.Normalized((3, 4, 0, 1), 0, 4, (1, 2)).Last.IsNearlyEqual(2.828424) is true
	Tiny.Normalized((3, 4, 0, 1), 2, 2, (1, 2)).Last.IsNearlyEqual(2.828424) is true
	let size = weights.Length
	let scales = Scales(input, start, count, size)
	for count
		input(start + index) * weights(index % size) * scales((index / size).Floor)
Scales(input Numbers, start Number, count Number, size Number) Numbers
	Tiny.Scales((3, 4, 0, 1), 0, 4, 2).First.IsNearlyEqual(0.2828427) is true
	Tiny.Scales((3, 4, 0, 1), 2, 2, 2).Last.IsNearlyEqual(1.414213) is true
	for count / size
		let first = start + index * size
		mutable sum = 0
		for size
			sum = sum + input(first + index) * input(first + index)
		1 / (sum / size + Epsilon).SquareRoot
Output(input Numbers) Numbers
	Tiny.Cached(Tiny.attentionNorm, (1, 1, 0, 0)).Output(Tiny.attentionNorm).Length is 8
	let attended = Layer(projection.weights, input).Sums(Merged)
	experts.Added(Normalized(attended, 0, attended.Length, mlpNorm), attended)
Merged Numbers
	Tiny.Cached(Tiny.attentionNorm, (1, 1, 0, 0)).Merged.Length is 8
	Tiny.Cached(Tiny.attentionNorm, (1, 1, 0, 0)).Merged.Last is Tiny.Cached(Tiny.attentionNorm, (1, 1, 0, 0)).values.Last
	let size = queryNorm.Length
	let positions = keys.Length / groups / size
	let weights = Softmaxed(Scores(positions), positions)
	for heads * size
		let head = (index / size).Floor
		let start = (head * groups / heads).Floor * size + index % size
		mutable sum = 0
		for positions
			sum = sum + weights(head * positions + index) * values(start + index * groups * size)
		sum
Scores(positions Number) Numbers
	Tiny.Cached(Tiny.attentionNorm, (1, 1, 0, 0)).Scores(1).Length is 2
	let size = queryNorm.Length
	let scale = 1 / size.SquareRoot
	for heads * positions
		let head = (index / positions).Floor
		let keyStart = ((index % positions) * groups + (head * groups / heads).Floor) * size
		let queryStart = head * size
		mutable sum = 0
		for size
			sum = sum + queries(queryStart + index) * keys(keyStart + index)
		sum * scale
Softmaxed(scores Numbers, positions Number) Numbers
	Tiny.Softmaxed((1, 1, 0, 0), 2) is (0.5, 0.5, 0.5, 0.5)
	let largest = Largest(scores, positions)
	let totals = Totals(scores, largest, positions)
	for scores
		let head = (index / positions).Floor
		(value - largest(head)).Exponential / totals(head)
Largest(scores Numbers, positions Number) Numbers
	Tiny.Largest((1, 3, 2, 0), 2) is (3, 2)
	for scores.Length / positions
		let start = index * positions
		mutable largest = scores(start)
		for positions
			largest = Larger(largest, scores(start + index))
		largest
Larger(left Number, right Number) Number
	Tiny.Larger(1, 2) is 2
	Tiny.Larger(3, 2) is 3
	left > right then left else right
Totals(scores Numbers, largest Numbers, positions Number) Numbers
	Tiny.Totals((0, 0, 1, 1), (0, 1), 2) is (2, 2)
	for largest
		let start = index * positions
		let maximum = value
		mutable sum = 0
		for positions
			sum = sum + (scores(start + index) - maximum).Exponential
		sum
