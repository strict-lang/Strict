has attentionNorm Numbers
has attention Layer
has projection Layer
has queryNorm Numbers
has keyNorm Numbers
has mlpNorm Numbers
has experts Experts
has heads Number
has groups Number
has keys Numbers = List(Number)
has values Numbers = List(Number)
has queries Numbers = List(Number)
constant Epsilon = 0.000001
constant Weights = Gguf("NeuralNetworks/tinyqwen3.gguf")
constant Tiny = Qwen3Block.Loaded(Weights, "blk.0.", 2)
Loaded(model Gguf, prefix Text, queryHeads Number) Qwen3Block
	Tiny.attention.weights.Length is 16
	Tiny.experts.expansions.First.weights.Length is 32
	Tiny.groups is 1
	let attended = Dense(model, prefix, ("attn_q", "attn_k", "attn_v"))
	let projected = Dense(model, prefix, List(Text) + "attn_output")
	let norms = Norms(model, prefix)
	let keyHeads = (attended.weights.Length / norms(1).Length - queryHeads) / 2
	let feedForward = FeedForward(model, prefix)
	Qwen3Block(norms(0), attended, projected, norms(1), norms(2), norms(3), feedForward, queryHeads, keyHeads)
FeedForward(model Gguf, prefix Text) Experts
	Tiny.FeedForward(Weights, "blk.0.").used is 1
	Tiny.FeedForward(Experts.Model, "blk.0.").used is 2
	if model.Shape(prefix + "ffn_gate_inp.weight").Length > 0
		return Experts.Loaded(model, prefix)
	Experts.Dense(Dense(model, prefix, ("ffn_gate", "ffn_up")), Dense(model, prefix, List(Text) + "ffn_down"))
Dense(model Gguf, prefix Text, names Texts) Layer
	Tiny.Dense(Weights, "blk.0.", List(Text) + "ffn_down").weights.Length is 8
	Tiny.Dense(Weights, "blk.0.", List(Text) + "ffn_down").biases.Length is 8
	mutable rows = List(Numbers)
	for names
		rows = rows + model.Rows(prefix + value + ".weight")
	Layer(rows, Layer.Zeros(rows.Length))
Norms(model Gguf, prefix Text) List(Numbers)
	Tiny.Norms(Weights, "blk.0.").Length is 4
	for ("attn_norm", "attn_q_norm", "attn_k_norm", "ffn_norm")
		model.Values(prefix + value + ".weight")
Cached(input Numbers, rotation Numbers) Qwen3Block
	Tiny.Cached(Tiny.mlpNorm, Tiny.mlpNorm).keys.Length is 4
	Tiny.Cached(Tiny.mlpNorm, Tiny.mlpNorm).queries.Length is 8
	Tiny.Cached(Tiny.mlpNorm, Tiny.mlpNorm).Cached(Tiny.mlpNorm, Tiny.mlpNorm).values.Length is 8
	let combined = Batch(attention.weights, attention.biases).Sums(Normalized(input, 0, input.Length, attentionNorm))
	let size = queryNorm.Length
	let tokens = input.Length / attentionNorm.Length
	let queried = Rotated(combined, 0, tokens * heads * size, queryNorm, rotation)
	let keyed = Rotated(combined, heads * size, tokens * groups * size, keyNorm, rotation)
	let valued = Batch.Columns(combined, combined.Length / tokens, (heads + groups) * size, groups * size)
	Qwen3Block(value, keys = keys + keyed, values = values + valued, queries = queried)
Rotated(input Numbers, start Number, count Number, weights Numbers, rotation Numbers) Numbers
	Tiny.Rotated((3, 4, 0, 1), 0, 4, (1, 2), (1, 1, -1, 1)).First.IsNearlyEqual(-1.414214) is true
	let size = weights.Length
	let perToken = count * size * 2 / rotation.Length
	let stride = input.Length * size * 2 / rotation.Length
	for count
		let token = (index / perToken).Floor
		let within = index % size
		let first = token * stride + start + index - token * perToken - within
		let partner = (within + size / 2) % size
		let own = input(first + within) * weights(within) * rotation(token * 2 * size + within)
		let other = input(first + partner) * weights(partner) * rotation((token * 2 + 1) * size + within)
		(own + other) * HeadScale(input, first, size)
Normalized(input Numbers, start Number, count Number, weights Numbers) Numbers
	Tiny.Normalized((3, 4), 0, 2, (1, 2)).First.IsNearlyEqual(0.848528) is true
	Tiny.Normalized((3, 4, 0, 1), 0, 4, (1, 2)).Last.IsNearlyEqual(2.828424) is true
	Tiny.Normalized((3, 4, 0, 1), 2, 2, (1, 2)).Last.IsNearlyEqual(2.828424) is true
	let size = weights.Length
	let scales = Scales(input, start, count, size)
	for count
		input(start + index) * weights(index % size) * scales((index / size).Floor)
Scales(input Numbers, start Number, count Number, size Number) Numbers
	Tiny.Scales((3, 4, 0, 1), 0, 4, 2).First.IsNearlyEqual(0.2828427) is true
	Tiny.Scales((3, 4, 0, 1), 2, 2, 2).Last.IsNearlyEqual(1.414213) is true
	for count / size
		HeadScale(input, start + index * size, size)
HeadScale(input Numbers, first Number, size Number) Number
	Tiny.HeadScale((3, 4, 0, 1), 2, 2).IsNearlyEqual(1.414213) is true
	mutable sum = 0
	for size
		sum = sum + input(first + index) * input(first + index)
	1 / (sum / size + Epsilon).SquareRoot
Output(input Numbers) Numbers
	Tiny.Cached(Tiny.mlpNorm, Tiny.mlpNorm).Output(Tiny.attentionNorm).Length is 8
	let attended = Batch(projection.weights, input).Sums(Merged(keys.Length / groups / queryNorm.Length))
	experts.Added(Normalized(attended, 0, attended.Length, mlpNorm), attended)
Merged(positions Number) Numbers
	Tiny.Cached(Tiny.mlpNorm, Tiny.mlpNorm).Merged(1).Length is 8
	Tiny.Cached(Tiny.mlpNorm, Tiny.mlpNorm).Merged(1).Last is Tiny.Cached(Tiny.mlpNorm, Tiny.mlpNorm).values.Last
	let size = queryNorm.Length
	let scores = Scores(positions)
	for queries.Length
		let row = (index / size).Floor
		let start = ((row % heads) * groups / heads).Floor * size + index % size
		Softmax.Weighted(scores, row * positions, positions, values, start, groups * size)
Scores(positions Number) Numbers
	Tiny.Cached(Tiny.mlpNorm, Tiny.mlpNorm).Scores(1).Length is 2
	let size = queryNorm.Length
	let tokens = queries.Length / heads / size
	for tokens * heads * positions
		let row = (index / positions).Floor
		let keyStart = ((index % positions) * groups + ((row % heads) * groups / heads).Floor) * size
		let queryStart = row * size
		mutable sum = 0
		for size
			sum = sum + queries(queryStart + index) * keys(keyStart + index)
		Visible(sum / size.SquareRoot, index % positions, positions - tokens + (row / heads).Floor)
Visible(score Number, position Number, limit Number) Number
	Tiny.Visible(2, 1, 1) is 2
	Tiny.Visible(2, 2, 1) is -1000000000
	position > limit then -1000000000 else score
