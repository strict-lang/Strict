has attentionNorm Numbers
has attention Layer
has projection Layer
has queryNorm Numbers
has keyNorm Numbers
has mlpNorm Numbers
has experts Experts
has heads Number
has groups Number
has keys Numbers = List(Number)
has values Numbers = List(Number)
has queries Numbers = List(Number)
has hybrid Hybrid = Hybrid.None
constant Epsilon = 0.000001
constant Tiny = Qwen3Block.Loaded(Gguf("NeuralNetworks/tinyqwen3.gguf"), "blk.0.", 2)
Loaded(model Gguf, prefix Text, queryHeads Number) Qwen3Block
	Tiny.attention.weights.Length is 16
	Tiny.experts.expansions.First.weights.Length is 32
	Tiny.groups is 1
	let attending = Attending(model, prefix, queryHeads, FeedForward(model, prefix))
	let after = model.Shape(prefix + "ffn_norm.weight").Length > 0 then "ffn_norm" else "post_attention_norm"
	let normed = model.Values(prefix + "attn_norm.weight")
	Qwen3Block(attending, attentionNorm = normed, mlpNorm = model.Values(prefix + after + ".weight"))
Attending(model Gguf, prefix Text, queryHeads Number, feedForward Experts) Qwen3Block
	Tiny.Attending(Drafter.Model, "blk.3.", 2, Tiny.experts).queryNorm.Length is 4
	Tiny.Attending(Drafter.Model, "blk.3.", 2, Tiny.experts).attentionNorm.Length is 0
	let rows = HeadRows.Of(model, model.Shape(prefix + "attn_q_norm.weight").First, queryHeads)
	let queried = model.Rows(prefix + "attn_q.weight")
	let keyed = rows.Permuted(model.Rows(prefix + "attn_k.weight"))
	let attended = rows.Queries(queried) + keyed + model.Rows(prefix + "attn_v.weight") + rows.Gates(queried)
	let layer = Layer(attended, Layer.Unbiased)
	let projected = Dense(model, prefix, List(Text) + "attn_output")
	let queryNormed = rows.Norm(model.Values(prefix + "attn_q_norm.weight"))
	let keyNormed = rows.Norm(model.Values(prefix + "attn_k_norm.weight"))
	let keyHeads = keyed.Length / rows.size
	Qwen3Block(List(Number), layer, projected, queryNormed, keyNormed, List(Number), feedForward, queryHeads, keyHeads)
FeedForward(model Gguf, prefix Text) Experts
	Tiny.FeedForward(Gguf("NeuralNetworks/tinyqwen3.gguf"), "blk.0.").used is 1
	Tiny.FeedForward(Experts.Model, "blk.0.").used is 2
	if model.Shape(prefix + "ffn_gate_inp.weight").Length > 0
		return Experts.Loaded(model, prefix)
	Experts.Dense(Dense(model, prefix, ("ffn_gate", "ffn_up")), Dense(model, prefix, List(Text) + "ffn_down"))
Dense(model Gguf, prefix Text, names Texts) Layer
	Tiny.Dense(Gguf("NeuralNetworks/tinyqwen3.gguf"), "blk.0.", List(Text) + "ffn_down").weights.Length is 8
	Tiny.Dense(Gguf("NeuralNetworks/tinyqwen3.gguf"), "blk.0.", List(Text) + "ffn_down").biases is Layer.Unbiased
	mutable rows = List(Numbers)
	for names
		rows = rows + model.Rows(prefix + value + ".weight")
	Layer(rows, Layer.Unbiased)
Cached(input Numbers, rotation Numbers, bits Number) Qwen3Block
	Tiny.Cached(Tiny.mlpNorm, Tiny.mlpNorm, 32).keys.Length is 4
	Tiny.Cached(Tiny.mlpNorm, Tiny.mlpNorm, 32).queries.Length is 8
	Tiny.Cached(Tiny.mlpNorm, Tiny.mlpNorm, 8).Cached(Tiny.mlpNorm, Tiny.mlpNorm, 8).values.Length is 8
	let combined = Batch(attention.weights, attention.biases).Sums(Normalized(input, 0, input.Length, attentionNorm))
	let size = queryNorm.Length
	let tokens = input.Length / attention.weights.First.Length
	let queried = Rotated(combined, 0, tokens * heads * size, queryNorm, rotation)
	let keyed = Rotated(combined, heads * size, tokens * groups * size, keyNorm, rotation)
	let valued = Batch.Columns(combined, combined.Length / tokens, (heads + groups) * size, groups * size)
	let block = Qwen3Block(value, queries = queried, hybrid = hybrid.Opened(combined, tokens, (heads + 2 * groups) * size))
	Qwen3Block(block, keys = keys + Stored(keyed, bits), values = values + Stored(valued, bits))
Stored(numbers Numbers, bits Number) Numbers
	Tiny.Stored((0.5, 1.125), 8) is (0.5, 1.125)
	Tiny.Stored((0.3, 1), 32) is (0.3, 1)
	bits is 8 then Float8.Packed(numbers) else numbers
Copies(count Number, bits Number) Qwen3Block
	Tiny.Cached(Tiny.mlpNorm, Tiny.mlpNorm, 32).Copies(2, 32).keys.Length is 8
	Qwen3Block(value, keys = Stored(Interleaved(keys, count), bits), values = Stored(Interleaved(values, count), bits))
Interleaved(cache Numbers, count Number) Numbers
	Tiny.Interleaved((1, 2, 3, 4, 5, 6, 7, 8), 2) is (1, 2, 3, 4, 1, 2, 3, 4, 5, 6, 7, 8, 5, 6, 7, 8)
	let stride = groups * queryNorm.Length
	for cache.Length * count
		cache((index / (count * stride)).Floor * stride + index % stride)
Rotated(input Numbers, start Number, count Number, weights Numbers, rotation Numbers) Numbers
	Tiny.Rotated((3, 4, 0, 1), 0, 4, (1, 2), (1, 1, -1, 1)).First.IsNearlyEqual(-1.414214)
	let size = weights.Length
	let gap = (input.Length - count) * size * 2 / rotation.Length
	for count
		let head = (index / size).Floor
		let token = (head * rotation.Length / count / 2).Floor
		let within = index % size
		let first = token * gap + start + head * size
		let partner = (within + size / 2) % size
		let own = input(first + within) * weights(within) * rotation(token * 2 * size + within)
		let other = input(first + partner) * weights(partner) * rotation((token * 2 + 1) * size + within)
		(own + other) * HeadScale(input, first, size, Epsilon)
Normalized(input Numbers, start Number, count Number, weights Numbers) Numbers
	Tiny.Normalized((3, 4), 0, 2, (1, 2)).First.IsNearlyEqual(0.848528)
	Tiny.Normalized((3, 4, 0, 1), 0, 4, (1, 2)).Last.IsNearlyEqual(2.828424)
	Tiny.Normalized((3, 4, 0, 1), 2, 2, (1, 2)).Last.IsNearlyEqual(2.828424)
	Tiny.Normalized((3, 4, 0, 1), 2, 2, List(Number)) is (0, 1)
	let size = weights.Length
	let part = (start is 0) and (count is input.Length) then input else Safetensors.Part(input, start, count, 1)
	if size is 0
		return part
	let scales = Scales(part, size, Epsilon)
	for count
		part(index) * weights(index % size) * scales((index / size).Floor)
Scales(input Numbers, size Number, epsilon Number) Numbers
	Tiny.Scales((3, 4, 0, 1), 2, Epsilon)(1).IsNearlyEqual(1.414213)
	for input.Length / size
		HeadScale(input, index * size, size, epsilon)
HeadScale(input Numbers, first Number, size Number, epsilon Number) Number
	Tiny.HeadScale((3, 4, 0, 1), 2, 2, Epsilon).IsNearlyEqual(1.414213)
	mutable sum = 0
	for size
		sum = sum + input(first + index) * input(first + index)
	1 / (sum / size + epsilon).SquareRoot
Output(input Numbers, sequences Number) Numbers
	Tiny.Cached(Tiny.mlpNorm, Tiny.mlpNorm, 32).Output(Tiny.attentionNorm, 1).Length is 8
	let attended = Batch(projection.weights, input).Sums(Merged(sequences))
	experts.Added(Normalized(attended, 0, attended.Length, mlpNorm), attended)
Merged(sequences Number) Numbers
	Tiny.Cached(Tiny.mlpNorm, Tiny.mlpNorm, 32).Merged(1).Length is 8
	hybrid.Gated(Attention(queries, keys, values, heads, groups, queryNorm.Length, sequences).Merged)