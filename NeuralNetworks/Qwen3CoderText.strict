has logger
constant Weights = "Qwen3-Coder-30B-A3B-Instruct-Q4_K_M.gguf"
constant Address = "https://huggingface.co/unsloth/Qwen3-Coder-30B-A3B-Instruct-GGUF/resolve/main/"
constant Prompt = "def fibonacci(n):"
constant Count = 24
Run(folder Text)
	let path = folder + "/" + Weights
	if File(path).Exists is false
		Downloaded(path)
	if MachineUse.Weights(logger, "Qwen3CoderText", path).Admitted
		Ran(folder)
Ran(folder Text)
	let path = folder + "/" + Weights
	let started = Process.Elapsed
	let tokenizer = Gpt2Tokens.Loaded(Gguf(path))
	let model = Qwen3.Loaded(path, 4)
	let loaded = Process.Elapsed
	let generated = Generation(model).Generated(tokenizer.Encoded(Prompt), Count)
	let milliseconds = ((Process.Elapsed - loaded) * 1000 / Count).Round(1)
	logger.Log(Prompt + tokenizer.Decoded(generated))
	logger.Log("Qwen3-Coder-30B-A3B loaded in " + (loaded - started).Round(1) + " s, " + milliseconds + " ms per token")
Downloaded(path Text) slow
	if Process.RunTool("curl", "-sfL --create-dirs -o \"" + path + "\" \"" + Address + Weights + "\"").Failed
		return Error("DownloadFailed: " + Address + Weights)