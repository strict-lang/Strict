has file Safetensors
has rotary Number
has group Number = 256
has normOffset Number = 1
has label = ""
constant Tiny = QwenSafetensors(Safetensors("NeuralNetworks/tinyqwen35.safetensors", 32, "model.language_model."), 2, 4)
constant Opened = QwenSafetensors.Tiny.Load(10000)
constant Counted = (1, 2, 3)
constant Expected = Qwen3.TinyHybrid.Prefilled(Counted, 0).hidden
constant Linear = "layers.0.linear_attn."
constant Plain = QwenSafetensors(Safetensors("NeuralNetworks/tinyqwen3vl.safetensors", 32, "model."), 16, 0, 0)
Load(theta Number, picked = List(Number)) Qwen3 slow
	Opened.blocks.Length is 1
	Opened.blocks.First.hybrid.layers.Length is 3
	Opened.Prefilled((1, 2, 3), 0).hidden(0).IsNearlyEqual(Expected(0), 0.3)
	Opened.Prefilled((1, 2, 3), 0).hidden(20).IsNearlyEqual(Expected(20), 0.3)
	Tiny.Load(10000, Counted).Prefilled(Counted, 0).hidden.Sum.IsNearlyEqual(Opened.Prefilled(Counted, 0).hidden.Sum)
	Tiny.Load(10000, (1, 2, 3)).tokens(0).Length is 0
	Plain.Load(5000000).Prefilled((1, 2, 3), 0).hidden(0).IsNearlyEqual(-6.434468, 0.02)
	Plain.Load(5000000).Prefilled((1, 2, 3), 0).hidden(100).IsNearlyEqual(2.307147, 0.02)
	basis = Basis(Basis.None, grouped = true, convrot = group)
	width = file.Shape("embed_tokens.weight")(1)
	normed = file.Entry("norm.weight") is "" then Layer.Zeros(width) else Norm("norm.weight")
	Qwen3(Blocks(basis), file.Host("embed_tokens", picked), List(Numbers), normed, theta, rotary = rotary, basis = basis)
Blocks(basis Basis) List(Qwen3Block) slow
	completion = Completion(label, Layers, Process.Elapsed)
	mutable blocks = List(Mutable(Qwen3Block))
	mutable deltas = List(Mutable(DeltaBlock))
	for Layers
		layer = "layers." + index + "."
		isAttention = file.Entry(layer + "self_attn.q_proj.weight") is not ""
		if isAttention
			blocks.Add(Qwen3Block(Attending(layer, basis), hybrid = Hybrid(deltas)))
		deltas = isAttention then List(Mutable(DeltaBlock)) else deltas + Delta(layer, basis)
		completion.Report(index + 1)
	blocks
Layers Number
	Tiny.Layers is 4
	mutable count = 0
	for as long as file.Entry("layers." + count + ".input_layernorm.weight") is not ""
		count = count + 1
	count
Attending(layer Text, basis Basis) Qwen3Block slow
	Tiny.Attending("layers.3.", Basis.None).queryNorm.Length is 4
	Tiny.Attending("layers.3.", Basis.None).heads is 2
	Plain.Attending("layers.0.", Basis.None).inputs.Length is 64
	size = file.Shape(layer + "self_attn.q_norm.weight").First
	projected = Layer(AwqMatrix(file, layer + "self_attn.o_proj").Rows, Layer.Unbiased)
	rows = HeadRows(size, rotary, projected.weights.First.Length / size)
	queryNorm = rows.Norm(Norm(layer + "self_attn.q_norm.weight"))
	keyNorm = rows.Norm(Norm(layer + "self_attn.k_norm.weight"))
	normed = Norm(layer + "input_layernorm.weight")
	after = Norm(layer + "post_attention_layernorm.weight")
	keyHeads = file.Shape(layer + "self_attn.k_proj.weight").First / size
	feedForward = FeedForward(layer, basis)
	base = Qwen3Block(normed, Attend(layer, rows), projected, queryNorm, keyNorm, after, feedForward, rows.heads, keyHeads)
	Qwen3Block(base, inputs = AwqMatrix(file, layer + "self_attn.o_proj").Factors)
Attend(layer Text, rows HeadRows) Layer
	Tiny.Attend("layers.3.", HeadRows(4, 2, 2)).weights.Length is 24
	queried = file.Quantize(layer + "self_attn.q_proj", Number.SingleBits)
	keyed = rows.Permute(file.Quantize(layer + "self_attn.k_proj", Number.SingleBits))
	valued = file.Quantize(layer + "self_attn.v_proj", Number.SingleBits)
	Layer(rows.Queries(queried) + keyed + valued + rows.Gates(queried), Layer.Unbiased)
Delta(layer Text, basis Basis) DeltaBlock slow
	Tiny.Delta("layers.0.", Basis.None).decays.Length is 4
	mixing = Mixing(layer + "linear_attn.", FeedForward(layer, basis))
	normed = Norm(layer + "input_layernorm.weight")
	after = Norm(layer + "post_attention_layernorm.weight")
	window = Layer.Zeros(mixing.convolution.Length / 4 * 3)
	memory = Layer.Zeros(mixing.decays.Length * mixing.norm.Length * mixing.norm.Length)
	DeltaBlock(mixing, attentionNorm = normed, mlpNorm = after, window = window, memory = memory)
Mixing(prefix Text, feedForward Experts) DeltaBlock slow
	Tiny.Mixing(Linear, Experts.Single).steps.Length is 4
	keyHeads = KeyHeads(prefix)
	convolution = Convolution(prefix, keyHeads)
	decays = Decays(Tile(file.Values(prefix + "A_log"), 1, keyHeads))
	steps = Tile(file.Values(prefix + "dt_bias"), 1, keyHeads)
	projected = Layer(file.Quantize(prefix + "out_proj", Number.SingleBits), Layer.Unbiased)
	headNorm = file.Values(prefix + "norm.weight")
	none = List(Number)
	inputs = Inputs(prefix, keyHeads)
	mixed = DeltaBlock(none, inputs, convolution, decays, steps, headNorm, projected, none, feedForward)
	DeltaBlock(mixed, rates = Rates(prefix, keyHeads))
KeyHeads(prefix Text) Number
	Tiny.KeyHeads(Linear) is 2
	heads = file.Shape(prefix + "A_log").First
	size = file.Shape(prefix + "norm.weight").First
	(file.Shape(prefix + "in_proj_qkv.weight").First - heads * size) / size / 2
Inputs(prefix Text, keyHeads Number) Layer
	Tiny.Inputs(Linear, 2).weights.Length is 24
	size = file.Shape(prefix + "norm.weight").First
	qkv = file.Quantize(prefix + "in_proj_qkv", Number.SingleBits)
	keys = 2 * keyHeads * size
	values = TiledRows(qkv.Slice(keys, qkv.Length - keys), size, keyHeads)
	gates = TiledRows(file.Quantize(prefix + "in_proj_z", Number.SingleBits), size, keyHeads)
	Layer(qkv.Slice(0, keys) + values + gates, Layer.Unbiased)
Rates(prefix Text, keyHeads Number) Layer
	Tiny.Rates(Linear, 2).weights.Length is 8
	betas = TiledRows(file.Rows(prefix + "in_proj_b.weight"), 1, keyHeads)
	Layer(betas + TiledRows(file.Rows(prefix + "in_proj_a.weight"), 1, keyHeads), Layer.Unbiased)
Convolution(prefix Text, keyHeads Number) Numbers
	Tiny.Convolution(Linear, 2).Length is 64
	size = file.Shape(prefix + "norm.weight").First
	taps = file.Values(prefix + "conv1d.weight")
	keys = 2 * keyHeads * size * 4
	taps.Slice(0, keys) + Tile(taps.Slice(keys, taps.Length - keys), size * 4, keyHeads)
FeedForward(layer Text, basis Basis) Experts slow
	Tiny.FeedForward("layers.0.", Basis.None).used is 1
	Plain.FeedForward("layers.0.", Basis.None).used is 1
	gated = file.Quantize(layer + "mlp.gate_proj", Number.SingleBits)
	inputs = file.Entry(layer + "mlp.down_proj.pre_quant_scale")
	expansion = Layer(gated + Projection(layer, "mlp.up_proj", inputs), Layer.Unbiased)
	Experts(Experts.Dense(expansion, Layer(Projection(layer, "mlp.down_proj", ""), Layer.Unbiased)), basis = basis)
IsFolded(layer Text) Boolean
	Plain.IsFolded("layers.0.")
	Tiny.IsFolded("layers.0.") is false
	inputs = file.Entry(layer + "mlp.down_proj.pre_quant_scale")
	inputs is not "" and file.IsFours(layer + "mlp.up_proj") and file.IsFours(layer + "mlp.down_proj")
Projection(layer Text, kind Text, inputs Text) List(Numbers)
	Plain.Projection("layers.0.", "mlp.up_proj", "").Length is Plain.file.Shape("layers.0.mlp.up_proj.weight").First
	name = layer + kind
	IsFolded(layer) then file.Fold(name, inputs, Number.SingleBits) else file.Quantize(name, Number.SingleBits)
Norm(name Text) Numbers
	Tiny.Norm("norm.weight").Length is 8
	for file.Values(name)
		value + normOffset
Decays(logarithms Numbers) Numbers
	Tiny.Decays(List(Number) + 0) is List(Number) + -1
	for logarithms
		-value.Exponential
Tile(values Numbers, size Number, keyHeads Number) Numbers
	Tiny.Tile((0, 1, 2, 3), 1, 2) is (0, 2, 1, 3)
	repeats = values.Length / size / keyHeads
	for values.Length
		head = (index / size).Floor
		values(((head % keyHeads) * repeats + (head / keyHeads).Floor) * size + index % size)
TiledRows(rows List(Numbers), size Number, keyHeads Number) List(Numbers)
	Tiny.TiledRows(((0), (1), (2), (3)), 1, 2) is ((0), (2), (1), (3))
	repeats = rows.Length / size / keyHeads
	for rows.Length
		head = (index / size).Floor
		rows(((head % keyHeads) * repeats + (head / keyHeads).Floor) * size + index % size)
