has firstNorm Numbers
has firstShift Numbers
has attention Batch
has projection Batch
has secondNorm Numbers
has secondShift Numbers
has expansion Batch
has contraction Batch
has heads Number
constant Tiny = QwenVisionBlock.Loaded(QwenVision.Model, "blocks.0.", 2)
Loaded(file Safetensors, prefix Text, headCount Number) QwenVisionBlock
	Tiny.attention.weights.Length is 96
	combining = Batch(file.Rows(prefix + "attn.qkv.weight"), file.Values(prefix + "attn.qkv.bias"))
	projecting = Batch(file.Rows(prefix + "attn.proj.weight"), file.Values(prefix + "attn.proj.bias"))
	expanding = Batch(file.Rows(prefix + "mlp.linear_fc1.weight"), file.Values(prefix + "mlp.linear_fc1.bias"))
	contracting = Batch(file.Rows(prefix + "mlp.linear_fc2.weight"), file.Values(prefix + "mlp.linear_fc2.bias"))
	first = (file.Values(prefix + "norm1.weight"), file.Values(prefix + "norm1.bias"))
	second = (file.Values(prefix + "norm2.weight"), file.Values(prefix + "norm2.bias"))
	QwenVisionBlock(first(0), first(1), combining, projecting, second(0), second(1), expanding, contracting, headCount)
Forward(patches Numbers, rotations Numbers) Numbers slow
	Tiny.Forward(QwenVision.Reference.Values("reference.embedded"), QwenVision.Tiny.Rotations((4, 6))).Length is 768
	width = firstNorm.Length
	combined = attention.Sums(Gpt2Block.Normalize(patches, firstNorm, firstShift, 0.000001))
	queries = Rotate(Batch.Columns(combined, 3 * width, 0, width), rotations, width / heads)
	keys = Rotate(Batch.Columns(combined, 3 * width, width, width), rotations, width / heads)
	values = Batch.Columns(combined, 3 * width, 2 * width, width)
	merged = Attention(queries, keys, values, heads, heads, width / heads, causal = false).Merged
	attended = Gpt2Block.Add(patches, projection.Sums(merged))
	normed = Gpt2Block.Normalize(attended, secondNorm, secondShift, 0.000001)
	Gpt2Block.Add(attended, contraction.Sums(Gpt2Block.Gelu(expansion.Sums(normed))))
Rotate(values Numbers, rotations Numbers, size Number) Numbers
	Tiny.Rotate((1, 2, 3, 4), (1, 1, 1, 1, 0, 0, 0, 0), 4) is (1, 2, 3, 4)
	Tiny.Rotate((1, 2, 3, 4), (0, 0, 0, 0, 1, 1, 1, 1), 4) is (-3, -4, 1, 2)
	width = values.Length / (rotations.Length / 2 / size)
	for values
		at = index % size
		start = (index / width).Floor * 2 * size
		half = size / 2
		turned = at < half then -values(index + half) else values(index - half)
		value * rotations(start + at) + turned * rotations(start + size + at)
