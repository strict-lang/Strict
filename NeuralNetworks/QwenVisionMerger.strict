has norm Numbers
has shift Numbers
has expansion Batch
has projection Batch
constant Tiny = QwenVisionMerger.Loaded(QwenVision.Model, "merger.")
constant ErfScale = 0.3275911
constant ErfFirst = 0.254829592
constant ErfSecond = 0.284496736
constant ErfThird = 1.421413741
constant ErfFourth = 1.453152027
constant ErfFifth = 1.061405429
Loaded(file Safetensors, prefix Text) QwenVisionMerger
	Tiny.norm.Length is 32
	Tiny.projection.weights.Length is 64
	let expanding = Batch(file.Rows(prefix + "linear_fc1.weight"), file.Values(prefix + "linear_fc1.bias"))
	let projecting = Batch(file.Rows(prefix + "linear_fc2.weight"), file.Values(prefix + "linear_fc2.bias"))
	QwenVisionMerger(file.Values(prefix + "norm.weight"), file.Values(prefix + "norm.bias"), expanding, projecting)
Merged(patches Numbers) Slow(Numbers)
	Tiny.Merged(QwenVision.Reference.Values("reference.embedded")).Length is 6 * 64
	projection.Sums(Gelu(expansion.Sums(Gpt2Block.Normalized(patches, norm, shift, 0.000001))))
Gelu(values Numbers) Numbers
	Tiny.Gelu((1, -2))(0).IsNearlyEqual(0.841345, 0.000001)
	Tiny.Gelu((1, -2))(1).IsNearlyEqual(-0.0455003, 0.000001)
	for values
		0.5 * value * (1 + Erf(value / 2.SquareRoot))
Erf(number Number) Number
	Tiny.Erf(0).IsNearlyEqual(0, 0.0000002)
	Tiny.Erf(-0.5).IsNearlyEqual(-0.5204999, 0.0000002)
	let distance = 1 / (1 + ErfScale * number.Absolute)
	let fourth = (ErfFifth * distance - ErfFourth) * distance + ErfThird
	let second = (fourth * distance - ErfSecond) * distance + ErfFirst
	let magnitude = 1 - second * distance * (-number * number).Exponential
	number < 0 then -magnitude else magnitude
