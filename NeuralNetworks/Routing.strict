has scores Numbers
has experts Number
constant Sample = Routing((0.1, 0.5, 0.15, 0.25), 4)
constant Pair = Routing((0.1, 0.5, 0.15, 0.25, 0.9, 0.2, 0.3, 0.1), 4)
Chosen(used Number) Numbers
	Sample.Chosen(2) is (1, 3)
	Pair.Chosen(2) is (1, 3, 0, 2)
	for scores.Length / experts * used
		Picked((index / used).Floor * experts, index % used)
Picked(first Number, slot Number) Number
	Sample.Picked(0, 0) is 1
	Pair.Picked(4, 1) is 2
	Routing((0.2, 0.2), 2).Picked(0, 1) is 1
	mutable previous = -1
	mutable limit = 1 / 0
	for slot + 1
		previous = Next(first, limit, previous)
		limit = scores(first + previous)
	previous
Next(first Number, limit Number, previous Number) Number
	Sample.Next(0, 1 / 0, -1) is 1
	Sample.Next(0, 0.5, 1) is 3
	Sample.Next(0, 0.15, 2) is 0
	Routing((-0.2, -0.2), 2).Next(0, -0.2, 0) is 1
	mutable best = -1
	mutable top = 0
	for experts
		let score = scores(first + index)
		if ((score < limit) or (score is limit) and (index > previous)) and ((best < 0) or (score > top))
			best = index
			top = score
	best
