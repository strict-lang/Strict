has file Safetensors
constant Bytes = RowsAhead(Safetensors.Bytes)
Start(name Text) List(Numbers) slow
	Bytes.Finish(Bytes.Start("a")) is Safetensors.Bytes.Quantize("a")
	TensorFile.Start(file.path, file.Entry(name + ".weight"), file.Entry(name + ".weight_scale"), 8)
Finish(rows List(Numbers)) List(Numbers) slow
	Bytes.Finish(Safetensors.Bytes.Quantize("a")) is Safetensors.Bytes.Quantize("a")
	TensorFile.Finish(rows) is rows.Length then rows else List(Numbers)
Retune(rows List(Numbers), downs Numbers, ups Numbers, scales Numbers) List(Numbers) slow
	Bytes.Retune(Bytes.Start("a"), List(Number), List(Number), List(Number)) is Safetensors.Bytes.Quantize("a")
	GpuMemory.Tune(Finish(rows), downs, ups, scales)