has path Text
constant Tiny = Safetensors("NeuralNetworks/tiny.safetensors")
Entry(name Text) Text
	Tiny.Entry("b") is "\"dtype\":\"F32\",\"shape\":[3],\"data_offsets\":[24,36]"
	Tiny.Entry("missing") is ""
	let header = TensorFile.Header(path)
	let key = "\"" + name + "\":{"
	let start = header.IndexOf(key)
	if start < 0
		return ""
	let open = start + key.Length
	header.Substring(open, header.IndexOf("}", open) - open)
Bracketed(entry Text, key Text) Numbers
	Tiny.Bracketed(Tiny.Entry("a"), "shape") is (2, 3)
	Tiny.Bracketed(Tiny.Entry("b"), "data_offsets") is (24, 36)
	let start = entry.IndexOf("\"" + key + "\":[") + key.Length + 4
	for entry.Substring(start, entry.IndexOf("]", start) - start).Split(",")
		value to Number
Shape(name Text) Numbers
	Tiny.Shape("a") is (2, 3)
	Bracketed(Entry(name), "shape")
Values(name Text) Numbers
	Tiny.Values("b") is (0.5, -1.5, 2.25)
	Tiny.Values("a").Length is 6
	let entry = Entry(name)
	if entry.IndexOf("\"dtype\":\"F32\"") < 0
		return Error("OnlyFloat32TensorsAreSupported")
	let offsets = Bracketed(entry, "data_offsets")
	TensorFile.Floats(path, offsets(0), (offsets(1) - offsets(0)) / 4)
Rows(name Text) List(Numbers)
	Tiny.Rows("a") is ((1, 2, 3), (4, 5, 6))
	let columns = Shape(name).Last
	let values = Values(name)
	for values.Length / columns
		Part(values, index * columns, columns, 1)
Columns(name Text) List(Numbers)
	Tiny.Columns("a") is ((1, 4), (2, 5), (3, 6))
	let columns = Shape(name).Last
	let values = Values(name)
	for columns
		Part(values, index, values.Length / columns, columns)
Part(values Numbers, start Number, count Number, step Number) Numbers
	Tiny.Part((1, 2, 3, 4), 1, 2, 2) is (2, 4)
	for count
		values(start + index * step)