has prompts List(Numbers)
Aligned(align Number) Number
	SequenceLength(((1, 2), (1, 2, 3))).Aligned(1) is 3
	SequenceLength(((1, 2), (1, 2, 3))).Aligned(16) is 16
	SequenceLength(((1, 2, 3), (1))).Aligned(2) is 4
	mutable longest = 0
	for prompts
		if value.Length > longest
			longest = value.Length
	((longest + align - 1) / align).Floor * align
Padded(length Number) Numbers
	SequenceLength(((1, 2), (3, 4, 5))).Padded(4) is (1, 2, 1, 1, 3, 4, 5, 3)
	for prompts.Length * length
		prompt = prompts((index / length).Floor)
		at = index % length
		at < prompt.Length then prompt(at) else prompt.First
Positions(length Number, start Number) Numbers
	SequenceLength(((1), (2))).Positions(3, 1) is (1, 2, 3, 1, 2, 3)
	for prompts.Length * length
		start + index % length
Column(length Number, start Number, count Number) Numbers
	SequenceLength(((1), (0, 1))).Column(2, 0, 2) is (-1, 1, 0, 1)
	SequenceLength(((1), (0, 1))).Column(2, 1, 1) is (1, 1)
	for prompts.Length * count
		prompt = prompts((index / count).Floor)
		at = start + index % count - length + prompt.Length
		at < 0 then -1 else prompt(at)
Pads(length Number) Numbers
	SequenceLength(((1), (0, 1))).Pads(2) is (1, 0)
	for prompts
		length - value.Length
