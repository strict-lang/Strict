Weighted(scores Numbers, first Number, count Number, values Numbers, start Number, stride Number) Number
	Softmax.Weighted((0, 0), 0, 2, (1, 3), 0, 1) is 2
	Softmax.Weighted((5, 0, 0, 9), 1, 2, (7, 1, 3), 1, 1) is 2
	let largest = Largest(scores, first, count)
	mutable total = 0
	mutable sum = 0
	for count
		let share = (scores(first + index) - largest).Exponential
		total = total + share
		sum = sum + share * values(start + index * stride)
	sum / total
Largest(scores Numbers, start Number, count Number) Number
	Softmax.Largest((1, 3, 2, 0), 2, 2) is 2
	mutable largest = scores(start)
	for count
		largest = Larger(largest, scores(start + index))
	largest
Larger(left Number, right Number) Number
	Softmax.Larger(1, 2) is 2
	Softmax.Larger(3, 2) is 3
	left > right then left else right
