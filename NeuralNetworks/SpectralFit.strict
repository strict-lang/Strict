has degree Number = 4
has ridge Number = 0.1
has blend Number = 0.5
constant Quadratic = SpectralFit(2, 0.1, 0.5)
constant Line = SpectralFit(1, 0, 1)
constant History = (-1, -0.5, 0, 0.5)
Basis(coord Number) Numbers
	Quadratic.Basis(0) is (1, 0, -1)
	Quadratic.Basis(1) is (1, 1, 1)
	mutable previous = 1
	mutable current = coord
	for degree + 1
		let next = index is 0 then 1 else (index is 1 then coord else 2 * coord * current - previous)
		previous = index > 1 then current else previous
		current = index > 1 then next else current
		next
Weights(coords Numbers, target Number) Numbers
	Quadratic.Weights(History, 1).First.IsNearlyEqual(0.3152753108348134, 0.00000001)
	Quadratic.Weights(History, 1).Last.IsNearlyEqual(1.8814387211367674, 0.00000001)
	Line.Weights((-1, 0), 1) is (-1, 2)
	if (coords.Length < degree + 1) or (IsValid is false) or (target.IsFinite is false)
		return Error("Invalid spectral fit")
	let design = Design(coords)
	let solved = SpectralSolve(Gram(design), Basis(target)).Solved
	for coords.Length
		let fitted = Softmax.Weighted(design(index), 0, degree + 1, solved, 0, 1)
		blend * fitted + (1 - blend) * Linear(coords, target, index)
IsValid Boolean
	let order = (degree >= 0) and (degree <= 4) and (degree.Floor is degree)
	order and (ridge >= 0) and ridge.IsFinite and (blend >= 0) and (blend <= 1)
Design(coords Numbers) List(Numbers)
	for coords
		Basis(value)
Gram(design List(Numbers)) Numbers
	for (degree + 1) * (degree + 1)
		let row = (index / (degree + 1)).Floor
		let column = index % (degree + 1)
		Cell(design, row, column) + (row is column then ridge else 0)
Cell(design List(Numbers), row Number, column Number) Number
	mutable sum = 0
	for design
		sum = sum + value(row) * value(column)
	sum
Linear(coords Numbers, target Number, at Number) Number
	if coords.Length < 2
		return 1
	if at < coords.Length - 2
		return 0
	let spacing = coords.Last - coords(coords.Length - 2)
	let ratio = spacing.Absolute < 0.000000000001 then 0 else (target - coords.Last) / spacing
	at is coords.Length - 1 then 1 + ratio else 0 - ratio