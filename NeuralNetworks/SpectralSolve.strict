has matrix Numbers
has right Numbers
constant Pair = SpectralSolve((2, -1, -1, 1), (1, 1))
Solved Numbers
	Pair.Solved is (2, 3)
	SpectralSolve(List(Number) + 0, List(Number) + 1).Solved is Error("Singular spectral fit")
	mutable rows = Augmented
	for right.Length
		rows = Reduce(rows, index)
	for right.Length
		rows(index * (right.Length + 1) + right.Length)
Augmented Numbers
	Pair.Augmented is (2, -1, 1, -1, 1, 1)
	for right.Length * (right.Length + 1)
		row = (index / (right.Length + 1)).Floor
		column = index % (right.Length + 1)
		column is right.Length then right(row) else matrix(row * right.Length + column)
Reduce(rows Numbers, pivot Number) Numbers
	Pair.Reduce(Pair.Augmented, 0) is (1, -0.5, 0.5, 0, 0.5, 1.5)
	SpectralSolve((0, 0, 0, 0), (1, 1)).Reduce((0, 0, 1, 0, 0, 1), 0) is Error
	width = right.Length + 1
	start = pivot * width
	diagonal = rows(start + pivot)
	if diagonal.IsFinite is false or diagonal.Absolute < 0.000000000001
		return Error("Singular spectral fit")
	for rows.Length
		row = (index / width).Floor
		normalized = rows(start + index % width) / diagonal
		row is pivot then normalized else rows(index) - rows(row * width + pivot) * normalized