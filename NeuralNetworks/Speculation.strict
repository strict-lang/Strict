has model Qwen3
has context Numbers
has next Number
has drafts = 15
constant Longest = 15
has steps = 0
has drafter = Drafter.None
constant Started = Speculation(Qwen3.Tiny.Prefilled((1, 2, 3), 0), (1, 2, 3), Qwen3.Tiny.Prefilled((1, 2, 3), 0).Next)
constant Prompted = Qwen3.TinyHybrid.Prefilled((1, 2, 3), 0)
constant Verified = Prompted.Steps((5, 4, 1), Qwen3.Positions(3, 3), 1)
constant Drafting = Speculation(Prompted, (1, 2, 3), Prompted.Next, 3, 0, Drafter.Tiny)
constant Kept = Speculation(Prompted, (1, 2, 3), 5).Truncated(Verified, (5))
Generated(count Number) Numbers
	Started.Generated(6) is Generation(Qwen3.Tiny).Generated((1, 2, 3), 6)
	Started.Generated(1) is (2)
	Drafting.Generated(6) is Generation(Qwen3.TinyHybrid).Generated((1, 2, 3), 6)
	Safetensors.Part(Finished(count).context, context.Length, count, 1)
Finished(count Number) Speculation
	Started.Finished(6).context.Length >= 9
	mutable current = value
	for as long as current.context.Length < context.Length + count
		current = current.Advanced
	current
Advanced Speculation
	Started.Advanced.context is (1, 2, 3, 2)
	Started.Advanced.steps is 1
	let draft = Drafted
	let block = List(Number) + next + draft
	let positions = Qwen3.Positions(context.Length, block.Length)
	let verified = draft.Length is 0 then model.Step(next, context.Length) else model.Steps(block, positions, 1)
	let predictions = draft.Length is 0 then List(Number) + verified.Next else verified.Nexts
	let accepted = Accepted(draft, predictions)
	let kept = Safetensors.Part(block, 0, accepted + 1, 1)
	let truncated = accepted is draft.Length then verified else Truncated(verified, kept)
	let remembered = Remembered(verified, kept, predictions(accepted))
	Speculation(truncated, context + kept, predictions(accepted), Adapted(draft.Length, accepted), steps + 1, remembered)
Drafted Numbers
	Started.Drafted.Length is 0
	Drafting.Drafted.Length is 3
	let primed = drafter.Primed(model, context + next)
	drafter.headNorm.Length is 0 then Lookup(context + next) else primed.Drafts(model, context.Length, drafts)
Remembered(verified Qwen3, kept Numbers, following Number) Drafter
	Started.Remembered(Started.model, List(Number) + 2, 1).headNorm.Length is 0
	Drafting.Remembered(Verified, (5, 4), 1).blocks.First.keys.Length is 20
	if drafter.headNorm.Length is 0
		return drafter
	let rows = Safetensors.Part(verified.hidden, 0, kept.Length * drafter.embedNorm.Length, 1)
	let tokens = Safetensors.Part(kept, 1, kept.Length - 1, 1) + following
	let primed = drafter.Primed(model, context + next)
	primed.Extended(model, rows, tokens, Qwen3.Positions(context.Length + 1, kept.Length))
Adapted(drafted Number, accepted Number) Number
	Started.Adapted(0, 0) is Started.drafts
	Started.Adapted(15, 3) is 15
	Started.Adapted(15, 0) is 7
	Speculation(Started, drafts = 7).Adapted(7, 7) is 15
	Speculation(Started, drafts = 3).Adapted(3, 0) is 3
	Drafting.Adapted(3, 3) is 3
	if drafter.headNorm.Length > 0
		return drafts
	let longer = (2 * drafts + 1).Clamp(3, Longest)
	let shorter = ((drafts - 1) / 2).Clamp(3, Longest)
	drafted is 0 then drafts else (accepted is drafted then longer else (accepted is 0 then shorter else drafts))
Lookup(tokens Numbers) Numbers
	Started.Lookup((5, 6, 7, 8, 5, 6, 7)) is (8, 5, 6, 7)
	Started.Lookup((1, 2, 3, 4)).Length is 0
	for (6, 5, 4, 3)
		let at = Continuation(tokens, value)
		if at >= 0
			return Safetensors.Part(tokens, at, (tokens.Length - at).Clamp(0, drafts), 1)
	List(Number)
Continuation(tokens Numbers, length Number) Number
	Started.Continuation((5, 6, 7, 8, 5, 6, 7), 3) is 3
	Started.Continuation((5, 6, 7, 8, 5, 6, 7), 4) is -1
	mutable found = -1
	for tokens.Length - length
		found = IsMatch(tokens, index, length) then index + length else found
	found
IsMatch(tokens Numbers, start Number, length Number) Boolean
	Started.IsMatch((1, 2, 1, 2), 0, 2)
	Started.IsMatch((1, 2, 1, 3), 0, 2) is false
	let last = tokens.Length - length
	for length
		if tokens(start + index) is not tokens(last + index)
			return false
	true
Accepted(draft Numbers, predictions Numbers) Number
	Started.Accepted((4, 5, 6), (4, 5, 7, 9)) is 2
	Started.Accepted((4, 5), (3, 5, 1)) is 0
	mutable count = 0
	for draft
		count = (count is index) and (value is predictions(index)) then count + 1 else count
	count
Truncated(verified Qwen3, kept Numbers) Qwen3
	Speculation(Started, context = (1)).Truncated(Started.model, (5)).blocks.First.keys.Length is 2 * 4
	Kept.Step(2, 4).Scored.Last.IsNearlyEqual(Prompted.Step(5, 3).Step(2, 4).Scored.Last)
	Kept.hidden.Length is 8
	let length = context.Length + kept.Length
	mutable blocks = List(Mutable(Qwen3Block))
	for verified.blocks
		let width = length * value.groups * value.queryNorm.Length
		let keys = Safetensors.Part(value.keys, 0, width, 1)
		let hybrid = value.hybrid.Rewound(model.blocks(index).hybrid, kept.Length)
		blocks.Add(Qwen3Block(value, keys = keys, values = Safetensors.Part(value.values, 0, width, 1), hybrid = hybrid))
	Qwen3(verified, blocks = blocks, hidden = Safetensors.Part(verified.hidden, 0, kept.Length * verified.norm.Length, 1))