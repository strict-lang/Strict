has qwen Boolean
constant Gpt = TokenSplitter(false)
constant Qwen = TokenSplitter(true)
Words(text Text) Texts
	Gpt.Words("Hi there's  42!") is ("Hi", " there", "'s", " ", " 42", "!")
	Gpt.Words("a\n b ") is ("a", "\n", " b", " ")
	Qwen.Words("Hi there'S  42!(x") is ("Hi", " there", "'S", " ", " ", "4", "2", "!(", "x")
	Qwen.Words("a\n\n b ") is ("a", "\n\n", " b", " ")
	mutable words = List(Mutable(Text))
	mutable start = 0
	for as long as start < text.Length
		let ending = qwen then QwenEnd(text, start) else WordEnd(text, start)
		words.Add(text.Substring(start, ending - start))
		start = ending
	words
WordEnd(text Text, start Number) Number
	Gpt.WordEnd("it's", 2) is 4
	Gpt.WordEnd("  a", 0) is 1
	let contraction = Contracted(text, start)
	if contraction > start
		return contraction
	let first = (text(start) is " ") and (Kind(text, start + 1) > 0) then start + 1 else start
	let kind = Kind(text, first)
	let ending = Stretched(text, first + 1, kind)
	(kind is 0) and (Kind(text, ending) > 0) and (ending - start > 1) then ending - 1 else ending
QwenEnd(text Text, start Number) Number
	Qwen.QwenEnd("(hello", 0) is 6
	Qwen.QwenEnd(" 42", 0) is 1
	Qwen.QwenEnd(" !!\n\nx", 0) is 5
	let contraction = Contracted(text, start)
	if contraction > start
		return contraction
	if IsWordStart(text, start)
		return Stretched(text, start + 1, 1)
	if Kind(text, start) is 2
		return start + 1
	Punctuated(text, start)
IsWordStart(text Text, start Number) Boolean
	Qwen.IsWordStart("(a", 0) is true
	Qwen.IsWordStart("\na", 0) is false
	let kind = Kind(text, start)
	let isBreak = text(start) is in ("\r", "\n")
	(kind is 1) or ((kind is not 2) and (isBreak is false) and (Kind(text, start + 1) is 1))
Contracted(text Text, start Number) Number
	Gpt.Contracted("it's", 2) is 4
	Gpt.Contracted("it'S", 2) is 2
	Qwen.Contracted("we'LL", 2) is 5
	for ("'s", "'t", "'re", "'ve", "'m", "'ll", "'d")
		if text.StartsWith(value, start) or (qwen and text.StartsWith(value.Upper, start))
			return start + value.Length
	start
Punctuated(text Text, start Number) Number
	Qwen.Punctuated(" !!\n\nx", 0) is 5
	Qwen.Punctuated("  x", 0) is 1
	let first = text(start) is " " then start + 1 else start
	if Kind(text, first) is not 3
		return Spaced(text, start)
	mutable breaks = Stretched(text, first + 1, 3)
	for as long as (breaks < text.Length) and (text(breaks) is in ("\r", "\n"))
		breaks = breaks + 1
	breaks
Spaced(text Text, start Number) Number
	Qwen.Spaced("  \n\n  x", 0) is 4
	Qwen.Spaced("   x", 0) is 2
	Qwen.Spaced(" 4", 0) is 1
	let ending = Stretched(text, start + 1, 0)
	mutable lastBreak = -1
	for Range(start, ending)
		if text(value) is in ("\r", "\n")
			lastBreak = value
	if lastBreak >= 0
		return lastBreak + 1
	(ending < text.Length) and (ending - start > 1) then ending - 1 else ending
Stretched(text Text, first Number, kind Number) Number
	Gpt.Stretched("aab ", 1, 1) is 3
	mutable ending = first
	for as long as Kind(text, ending) is kind
		ending = ending + 1
	ending
Kind(text Text, index Number) Number
	Gpt.Kind("a 1!", 0) is 1
	Gpt.Kind("a 1!", 1) is 0
	Gpt.Kind("a 1!", 2) is 2
	Gpt.Kind("a 1!", 4) is -1
	if index >= text.Length
		return -1
	let code = text(index).number
	if (code is 32) or (code is in Range(9, 14))
		return 0
	if (code > 127) or (code is in Range(65, 91)) or (code is in Range(97, 123))
		return 1
	code is in Range(48, 58) then 2 else 3