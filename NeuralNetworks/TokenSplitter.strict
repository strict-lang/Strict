has qwen Boolean
has digits Number = 1
constant Gpt = TokenSplitter(false)
constant Qwen = TokenSplitter(true)
constant Llama = TokenSplitter(true, 3)
constant Whitespace = Range(9, 14)
constant Uppercase = Range(Character.UppercaseA, Character.UppercaseZ + 1)
constant Lowercase = Range(Character.LowercaseA, Character.LowercaseZ + 1)
constant Digits = Range(Character.zeroCharacter, Character.zeroCharacter + 10)
Words(text Text) Texts
	Gpt.Words("Hi there's  42!") is ("Hi", " there", "'s", " ", " 42", "!")
	Gpt.Words("a\n b ") is ("a", "\n", " b", " ")
	Qwen.Words("Hi there'S  42!(x") is ("Hi", " there", "'S", " ", " ", "4", "2", "!(", "x")
	Qwen.Words("a\n\n b ") is ("a", "\n\n", " b", " ")
	Llama.Words("is 12345!") is ("is", " ", "123", "45", "!")
	mutable words = List(Mutable(Text))
	mutable start = 0
	for as long as start < text.Length
		ending = qwen then QwenEnd(text, start) else WordEnd(text, start)
		words.Add(text.Substring(start, ending - start))
		start = ending
	words
WordEnd(text Text, start Number) Number
	Gpt.WordEnd("it's", 2) is 4
	Gpt.WordEnd("  a", 0) is 1
	contraction = Contract(text, start)
	if contraction > start
		return contraction
	first = text(start) is " " and Kind(text, start + 1) > 0 then start + 1 else start
	kind = Kind(text, first)
	ending = Stretch(text, first + 1, kind)
	kind is 0 and Kind(text, ending) > 0 and ending - start > 1 then ending - 1 else ending
QwenEnd(text Text, start Number) Number
	Qwen.QwenEnd("(hello", 0) is 6
	Qwen.QwenEnd(" 42", 0) is 1
	Qwen.QwenEnd(" !!\n\nx", 0) is 5
	contraction = Contract(text, start)
	if contraction > start
		return contraction
	if IsWordStart(text, start)
		return Stretch(text, start + 1, 1)
	Kind(text, start) is 2 then Group(text, start) else Punctuat(text, start)
Group(text Text, start Number) Number
	Llama.Group("12345", 0) is 3 and Llama.Group("12a", 0) is 2 and Qwen.Group("12", 0) is 1
	mutable ending = start + 1
	for as long as ending - start < digits and Kind(text, ending) is 2
		ending = ending + 1
	ending
IsWordStart(text Text, start Number) Boolean
	Qwen.IsWordStart("(a", 0)
	Qwen.IsWordStart("\na", 0) is false
	kind = Kind(text, start)
	isBreak = text(start) is in ("\r", "\n")
	kind is 1 or kind is not 2 and isBreak is false and Kind(text, start + 1) is 1
Contract(text Text, start Number) Number
	Gpt.Contract("it's", 2) is 4
	Gpt.Contract("it'S", 2) is 2
	Qwen.Contract("we'LL", 2) is 5
	for ("'s", "'t", "'re", "'ve", "'m", "'ll", "'d")
		if text.StartsWith(value, start) or qwen and text.StartsWith(value.Upper, start)
			return start + value.Length
	start
Punctuat(text Text, start Number) Number
	Qwen.Punctuat(" !!\n\nx", 0) is 5
	Qwen.Punctuat("  x", 0) is 1
	first = text(start) is " " then start + 1 else start
	if Kind(text, first) is not 3
		return Space(text, start)
	mutable breaks = Stretch(text, first + 1, 3)
	for as long as breaks < text.Length and text(breaks) is in ("\r", "\n")
		breaks = breaks + 1
	breaks
Space(text Text, start Number) Number
	Qwen.Space("  \n\n  x", 0) is 4
	Qwen.Space("   x", 0) is 2
	Qwen.Space(" 4", 0) is 1
	ending = Stretch(text, start + 1, 0)
	mutable lastBreak = -1
	for Range(start, ending)
		if text(value) is in ("\r", "\n")
			lastBreak = value
	lastBreak >= 0 then lastBreak + 1 else ending < text.Length and ending - start > 1 then ending - 1 else ending
Stretch(text Text, first Number, kind Number) Number
	Gpt.Stretch("aab ", 1, 1) is 3
	mutable ending = first
	for as long as Kind(text, ending) is kind
		ending = ending + 1
	ending
Kind(text Text, index Number) Number
	Gpt.Kind("a 1!", 0) is 1
	Gpt.Kind("a 1!", 1) is 0
	Gpt.Kind("a 1!", 2) is 2
	Gpt.Kind("a 1!", 4) is -1
	if index >= text.Length
		return Number.NotFound
	code = text(index).number
	if code is Character.Space or code is in Whitespace
		return 0
	code > Character.Delete or code is in Uppercase or code is in Lowercase then 1 else code is in Digits then 2 else 3