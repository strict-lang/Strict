has model Gpt2
has sums List(Numbers) = List(Numbers)
has count = 0
constant Rising = List(Numbers) + (1, 0, 0, 3)
Measured(tokenizer Gpt2Tokens, texts Texts) Activity slow
	Activity(Gpt2.Tiny).Measured(Gpt2Tokens.Tiny, ("ab ab", "ab")).sums.First.Length is 96
	Activity(Gpt2.Tiny).Measured(Gpt2Tokens.Tiny, ("ab ab", "ab")).count is 3
	mutable current = Activity(model, Zeros)
	for texts
		current = Activity(model, current.sums, current.count).Continued(tokenizer.Encode(value))
	current
Continued(tokens Numbers) Activity slow
	Activity(Gpt2.Tiny, Activity(Gpt2.Tiny).Zeros).Continued((1, 2)).count is 2
	mutable current = value
	for tokens
		current = current.Step(value, index)
	current
Step(token Number, position Number) Activity slow
	Activity(Gpt2.Tiny, Activity(Gpt2.Tiny).Zeros).Step(1, 0).sums.Length is 1
	mutable state = Gpt2Block.Add(model.tokens(token), model.positions(position))
	mutable updated = List(Mutable(Gpt2Block))
	mutable activations = List(Mutable(Numbers))
	for model.blocks
		cached = value.Cached(state)
		attended = cached.Attend(state)
		activations.Add(cached.Activate(attended))
		state = cached.Contract(attended, activations.Last)
		updated.Add(cached)
	Activity(Gpt2(model, blocks = updated, hidden = state), Accumulations(activations), count + 1)
Accumulations(activations List(Numbers)) List(Numbers) slow
	Activity(Gpt2.Tiny, Rising).Accumulations(List(Numbers) + (1, -2)) is List(Numbers) + (2, 4, 1, 1)
	for activations
		Accumulate(sums(index), value)
Zeros List(Numbers) slow
	Activity(Gpt2.Tiny).Zeros.First.Length is 96
	for model.blocks
		Layer.Halves.Zeros(2 * value.expansion.biases.Length)
Accumulate(previous Numbers, activated Numbers) Numbers slow
	Activity(Gpt2.Tiny).Accumulate((1, 0, 0, 3), (1, -2)) is (2, 4, 1, 1)
	for previous
		activation = activated(index % activated.Length)
		value + (index < activated.Length then activation * activation else activation)
Means(block Number) Numbers slow
	Activity(Gpt2.Tiny, List(Numbers) + (0, 0, 2, 4), 2).Means(0) is (1, 2)
	neurons = sums(block).Length / 2
	for neurons
		sums(block)(neurons + index) / count
Scores(block Number) Numbers
	Activity(Gpt2.Tiny, Activity(Gpt2.Tiny).Zeros).Continued((1, 2)).Scores(0).Length is 48
	Activity(Gpt2.Tiny, List(Numbers) + (2, 10, 2, 4), 2).Scores(0).First is 0
	Activity(Gpt2.Tiny, List(Numbers) + (2, 10, 2, 4), 2).Scores(0)(1) > 0
	weights = model.blocks(block).contraction.weights
	for Means(block)
		(sums(block)(index) - count * value * value) * ColumnSquares(weights, index)
ColumnSquares(rows List(Numbers), column Number) Number
	Activity(Gpt2.Tiny).ColumnSquares(((1, 2), (3, 4)), 1) is 20
	mutable squares = 0
	for rows
		squares = squares + value(column) * value(column)
	squares