has iterator
constant Epsilon = 0.00001
constant E = 2.718281828459045
constant Pi = 3.141592653589793
constant Phi = 1.618033988749895
to Text
	5 to Text is "5"
	10.1 to Text is "10.1"
	(-1 / 0) to Text is "-Infinity"
	for digits
		value to Character
digits Numbers
	1.digits is (1)
	123.digits is (1, 2, 3)
	let nextPart = (value / 10).Floor
	let currentDigit = value % 10
	nextPart is 0 then (currentDigit) else nextPart.digits + currentDigit
to Character
	5 to Character is "5"
	constant canOnlyConvertSingleDigit = Error
	10 to Character is canOnlyConvertSingleDigit
	value is in Range(0, 10) then Character(Character.zeroCharacter + value) else canOnlyConvertSingleDigit(value)
Floor Number
	1.Floor is 1
	2.4.Floor is 2
	(0 - 2.4).Floor is -3
	0.1.Floor is 0
	let fraction = value % 1
	fraction < 0 then value - fraction - 1 else value - fraction
Ceiling Number
	1.Ceiling is 1
	2.4.Ceiling is 3
	(0 - 2.4).Ceiling is -2
	let fraction = value % 1
	fraction > 0 then value - fraction + 1 else value - fraction
Round(decimals = 0) Number
	2.4.Round is 2
	2.6.Round is 3
	3.5.Round is 4
	3.14159.Round(2) is 3.14
	let scale = 10 ^ decimals
	(value * scale + 0.5).Floor / scale
Absolute Number
	-1.Absolute is 1
	1.Absolute is 1
	value < 0 then 0 - value else value
IsNearlyEqual(other, difference = Epsilon) Boolean
	2.30000001.IsNearlyEqual(2.3)
	(value - other).Absolute < difference
Clamp(minimum = 0, maximum = 1) Number
	1.7.Clamp(0.5, 1.5) is 1.5
	0.3.Clamp is 0.3
	-0.8.Clamp(-0.5, 0.5) is -0.5
	value > maximum then maximum else value < minimum then minimum else value
Lerp(other, percentage Number) Number
	1.Lerp(3, 0) is 1
	0.Lerp(1, 0.2) is 0.2
	-1.Lerp(1, 0.5) is 0
	-4.Lerp(-1, 1.5) is 0.5
	value * (1 - percentage) + other * percentage
is(other) Boolean
	1 is 1
	2 is not 3
	1 is Number
	2 is not Text
	value is other
+(other) Number
	3 + 4 is 7
	value + other
-(other) Number
	-1 * 5 is -5
	3 - 2 is 1
	value - other
/(other) Number
	0 / 50 is 0
	1 / 20 is 0.05
	value / other
*(other) Number
	3 * 4 is 12
	value * other
%(other) Number
	100 % 10 is 0
	7 % 4 is 3
	(0 - 7) % 3 is 0 - 1
	5.5 % 2 is 1.5
	value % other
^(other) Number
	2 ^ 2 is 4
	value ^ other
and(other) Number
	12 and 10 is 8
	(0 - 1) and 255 is 255
	let left = value < 0 then value + 2 ^ 53 else value
	let right = other < 0 then other + 2 ^ 53 else other
	mutable result = 0
	for 53
		let bit = 2 ^ index
		if ((left / bit).Floor % 2 is 1) and ((right / bit).Floor % 2 is 1)
			result = result + bit
	result >= 2 ^ 52 then result - 2 ^ 53 else result
or(other) Number
	12 or 10 is 14
	value + other - (value and other)
xor(other) Number
	12 xor 10 is 6
	(value or other) - (value and other)
>(other) Boolean
	0 > 0 is false
	3 > 1
	value > other
>=(other) Boolean
	0 >= 0
	value >= other
<(other) Boolean
	0 < 0 is false
	1 < 3
	value < other
<=(other) Boolean
	0 <= 0
	value <= other
Increment(amount = 1) Mutable(Number)
	Mutable(5).Increment.Decrement.Increment is 6
	Mutable(4).Increment(4) is 8
	value = value + amount
Decrement(amount = 1) Mutable(Number)
	Mutable(3).Decrement is 2
	Mutable(-2).Decrement(-7) is 5
	value = value - amount
IsFinite Boolean
	1.IsFinite
	(1 / 0).IsFinite is false
	(value is value) and (value - value is 0)
Exponential Number
	0.Exponential is 1
	1.Exponential is E
	E ^ value
Logarithm Number
	1.Logarithm is 0
	E.Logarithm is 1
	value
Random Number
	10.Random < 10
	10.Random >= 0
	value
SquareRoot Number
	4.SquareRoot is 2
	9.SquareRoot is 3
	value ^ 0.5