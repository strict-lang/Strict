	let fraction = value - floor
	let isEvenUp = (fraction > 0.5 + tolerance) or ((fraction - 0.5).Absolute <= tolerance) and ((floor % 2).Absolute is 1)
	floor + ((rounding is "Ceiling" then fraction > tolerance else (rounding is "Even") and isEvenUp) then 1 else 0)
