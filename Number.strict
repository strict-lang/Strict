	2.Fixed(1) is "2.0"
	-2.25.Fixed(1) is "-2.2"
	5.4.Fixed(0) is "5"
	mutable text = Round(decimals) to Text
	if decimals > 0 and text.IndexOf(".") < 0
		text = text + "."
	for decimals - (text.Length - text.IndexOf(".") - 1)
		text = text + "0"
	text
