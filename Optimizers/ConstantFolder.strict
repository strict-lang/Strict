has ops OpList
Optimize OpList
	ConstantFolder(OpList.Sample("Add", 3)).Optimize.At(0).amount is 8
	ConstantFolder(OpList.Sample("Equal", 3)).Optimize.Count is 3
	if ops.Count < 3
		return ops
	FoldIfSimple(ops.At(0), ops.At(1), ops.At(2))
FoldIfSimple(first OptimInstruction, second OptimInstruction, third OptimInstruction) OpList
	if (not first.IsLoadConstant) or (not second.IsLoadConstant)
		return ops
	if (not third.IsBinary) or third.IsCompare
		return ops
	if third.register is not first.register or third.amount is not second.register
		return ops
	let result = Compute(third.typeName, first.amount, second.amount)
	ops.Skip(3).Prepend(OptimInstruction.LoadConstant(third.ResultRegister, result))
Compute(opName Text, left Number, right Number) Number
	ConstantFolder(OpList.Empty).Compute("Multiply", 4, 3) is 12
	if opName is "Add"
		return left + right
	if opName is "Subtract"
		return left - right
	if opName is "Multiply"
		return left * right
	if opName is "Divide"
		return left / right
	if opName is "Modulo"
		return left % right
	left