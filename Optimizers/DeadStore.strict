has ops Bytecode/InstructionList
Optimize InstructionList
	DeadStore(InstructionList.Empty.With("StoreConstantToVariable", "x")).Optimize.Count is 0
	mutable next = List(Mutable(BytecodeInstruction))
	for ops.instructions
		if ShouldKeep(value)
			next.Add(value)
	InstructionList(next)
ShouldKeep(instruction BytecodeInstruction) Boolean
	if instruction.typeName is "StoreConstantToVariable"
		return IsLoaded(instruction.label)
	if instruction.typeName is "StoreRegisterToVariable"
		return instruction.label.IndexOf("(") is not -1 or IsLoaded(instruction.label)
	true
IsLoaded(name Text) Boolean
	DeadStore(InstructionList.Empty.With("LoadVariableToRegister", "x")).IsLoaded("x") is true
	for ops.instructions
		if (value.typeName is "LoadVariableToRegister") and (value.label is name)
			return true
	false