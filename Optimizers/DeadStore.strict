has ops OpList
Optimize OpList
	DeadStore(OpList.Empty.With("StoreConstantToVariable", "x")).Optimize.Count is 0
	DeadStore(OpList.Empty.With("StoreConstantToVariable", "x").With("LoadVariableToRegister", "x")).Optimize.Count is 2
	mutable next = List(Mutable(OptimInstruction))
	for ops.instructions
		if ShouldKeep(value)
			next.Add(value)
	OpList(next)
ShouldKeep(instruction OptimInstruction) Boolean
	if instruction.IsStoreConstant
		return IsLoaded(instruction.label)
	if instruction.IsStoreRegister
		return instruction.label.IndexOf("(") is not -1 or IsLoaded(instruction.label)
	true
IsLoaded(name Text) Boolean
	for ops.instructions
		if value.IsLoadVariable and (value.label is name)
			return true
	false