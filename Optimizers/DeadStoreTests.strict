has logger
Run
	constant dead = OptimInstruction.StoreConstant("unused", 42)
	constant live = OptimInstruction.StoreConstant("count", 1)
	constant load = OptimInstruction("LoadVariableToRegister", 0, 0, "count")
	constant ret = OptimInstruction.ReturnOp(0)
	constant ops = OpList.Empty.Append(dead).Append(live).Append(load).Append(ret)
	logger.Log(ops.Count)
	constant cleaned = DeadStore(ops).Optimize
	logger.Log(cleaned.Count)
	logger.Log(cleaned.At(0))