has logger
Run
	constant left = OpBuilder.LoadConstant(0, 5)
	constant right = OpBuilder.LoadConstant(1, 3)
	constant add = OpBuilder.BinaryOp("Add", 0, 1, 2)
	constant ret = OpBuilder.ReturnOp(2)
	constant ops = OpList.Empty.Append(left).Append(right).Append(add).Append(ret)
	logger.Log(ops.Count)
	constant folded = ConstantFolder.Empty.Optimize(ops)
	logger.Log(folded.Count)
	logger.Log(folded.At(0))
	logger.Log(folded.At(1))