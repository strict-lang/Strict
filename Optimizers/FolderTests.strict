has logger
Run
	constant left = BytecodeInstruction.LoadConstant(0, 5)
	constant right = BytecodeInstruction.LoadConstant(1, 3)
	constant add = BytecodeInstruction("Add", 0, 1, "2")
	constant ret = BytecodeInstruction.ReturnOp(2)
	constant ops = InstructionList.Empty.Append(left).Append(right).Append(add).Append(ret)
	logger.Log(ops.Count)
	constant folded = ConstantFolder(ops).Optimize
	logger.Log(folded.Count)
	logger.Log(folded.At(0))
	logger.Log(folded.At(1))