has logger
Run
	constant left = OptimInstruction.LoadConstant(0, 5)
	constant right = OptimInstruction.LoadConstant(1, 3)
	constant add = OptimInstruction.BinaryOp("Add", 0, 1, 2)
	constant ret = OptimInstruction.ReturnOp(2)
	constant ops = OpList.Empty.Append(left).Append(right).Append(add).Append(ret)
	logger.Log(ops.Count)
	constant folded = ConstantFolder(ops).Optimize
	logger.Log(folded.Count)
	logger.Log(folded.At(0))
	logger.Log(folded.At(1))