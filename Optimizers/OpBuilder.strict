has dummy Number
LoadConstant(reg Number, value Number) OptimInstruction
	LoadConstant(0, 5).IsLoadConstant is true
	OptimInstruction("LoadConstantToRegister", reg, value, "")
LoadVariable(reg Number, name Text) OptimInstruction
	LoadVariable(0, "x").label is "x"
	OptimInstruction("LoadVariableToRegister", reg, 0, name)
StoreRegister(reg Number, name Text) OptimInstruction
	StoreRegister(1, "result").IsStoreRegister is true
	OptimInstruction("StoreRegisterToVariable", reg, 0, name)
StoreConstant(name Text, value Number) OptimInstruction
	StoreConstant("n", 5).IsStoreConstant is true
	OptimInstruction("StoreConstantToVariable", 0, value, name)
BinaryOp(name Text, left Number, right Number, result Number) OptimInstruction
	BinaryOp("Add", 0, 1, 2).IsBinary is true
	OptimInstruction(name, left, right, result to Text)
ReturnOp(reg Number) OptimInstruction
	ReturnOp(0).IsReturn is true
	OptimInstruction("Return", reg, 0, "")
JumpOp(name Text, steps Number) OptimInstruction
	JumpOp("JumpIfFalse", 1).IsJump is true
	OptimInstruction(name, 0, steps, "")
JumpEnd OptimInstruction
	OptimInstruction("JumpEnd", 0, 0, "")
Empty OpBuilder
	OpBuilder(0)