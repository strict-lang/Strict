has instructions OptimInstructions
Count Number
	instructions.Length
IsEmpty Boolean
	OpList.Empty.IsEmpty is true
	instructions.Length is 0
At(index Number) OptimInstruction
	OpList.Empty.At(3).IsReturn is true
	if index < 0 or index >= instructions.Length
		return OptimInstruction.ReturnOp(0)
	instructions(index)
Append(instruction OptimInstruction) OpList
	OpList.Empty.Append(OptimInstruction.ReturnOp(1)).Count is 1
	mutable next = List(Mutable(OptimInstruction))
	for instructions
		next.Add(value)
	next.Add(instruction)
	OpList(next)
Prepend(instruction OptimInstruction) OpList
	OpList.Empty.Append(OptimInstruction.ReturnOp(1)).Prepend(OptimInstruction.ReturnOp(2)).At(0).register is 2
	mutable next = List(Mutable(OptimInstruction))
	next.Add(instruction)
	for instructions
		next.Add(value)
	OpList(next)
Skip(count Number) OpList
	OpList.Empty.Append(OptimInstruction.ReturnOp(1)).Append(OptimInstruction.ReturnOp(2)).Skip(1).At(0).register is 2
	mutable next = List(Mutable(OptimInstruction))
	for instructions
		if index >= count
			next.Add(value)
	OpList(next)
KeepPrefix(length Number) OpList
	OpList.Empty.Append(OptimInstruction.ReturnOp(1)).Append(OptimInstruction.ReturnOp(2)).KeepPrefix(1).Count is 1
	mutable next = List(Mutable(OptimInstruction))
	for instructions
		if index < length
			next.Add(value)
	OpList(next)
Empty OpList
	OpList.Empty.Count is 0
	constant noInstructions = List(OptimInstruction)
	OpList(noInstructions)
With(typeName Text, label Text) OpList
	OpList.Empty.With("JumpEnd", "").At(0).IsJumpEnd is true
	Append(OptimInstruction(typeName, 0, 0, label))
Sample(binaryName Text, right Number) OpList
	OpList.Sample("Add", 3).Count is 3
	let loads = OpList.Empty.Append(OptimInstruction.LoadConstant(0, 5)).Append(OptimInstruction.LoadConstant(1, right))
	loads.Append(OptimInstruction.BinaryOp(binaryName, 0, 1, 2))
to Text
	"ops=" + Count to Text