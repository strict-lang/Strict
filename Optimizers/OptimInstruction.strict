has typeName Text
has register Number
has amount Number
has label Text
to Text
	typeName + " r" + register to Text + " " + amount to Text + " " + label
IsLoadConstant Boolean
	typeName is "LoadConstantToRegister"
IsLoadVariable Boolean
	typeName is "LoadVariableToRegister"
IsStoreRegister Boolean
	typeName is "StoreRegisterToVariable"
IsStoreConstant Boolean
	typeName is "StoreConstantToVariable"
IsReturn Boolean
	typeName is "Return"
IsBinary Boolean
	OptimInstruction.BinaryOp("Modulo", 0, 1, 2).IsBinary is true
	if typeName is in ("Add", "Subtract", "Multiply", "Divide", "Modulo")
		return true
	IsCompare
IsCompare Boolean
	OptimInstruction("LessThan", 0, 1, "2").IsCompare is true
	typeName is in ("Equal", "NotEqual", "LessThan", "GreaterThan")
IsJump Boolean
	OptimInstruction("JumpIfFalse", 0, 1, "").IsJump is true
	typeName is in ("Jump", "JumpIfTrue", "JumpIfFalse", "JumpIfNotZero")
IsJumpEnd Boolean
	typeName is "JumpEnd"
ResultRegister Number
	OptimInstruction.BinaryOp("Add", 0, 1, 2).ResultRegister is 2
	if IsBinary
		return label to Number
	register
LoadConstant(reg Number, number Number) OptimInstruction
	OptimInstruction.LoadConstant(0, 5).IsLoadConstant is true
	OptimInstruction("LoadConstantToRegister", reg, number, "")
StoreConstant(name Text, number Number) OptimInstruction
	OptimInstruction.StoreConstant("n", 5).IsStoreConstant is true
	OptimInstruction("StoreConstantToVariable", 0, number, name)
BinaryOp(name Text, left Number, right Number, result Number) OptimInstruction
	OptimInstruction.BinaryOp("Add", 0, 1, 2).IsBinary is true
	OptimInstruction(name, left, right, result to Text)
ReturnOp(reg Number) OptimInstruction
	OptimInstruction.ReturnOp(0).IsReturn is true
	OptimInstruction("Return", reg, 0, "")