has logger
Run
	logger.Log(AllOptimizers.OptimizerCount)
	constant left = BytecodeInstruction.LoadConstant(0, 10)
	constant right = BytecodeInstruction.LoadConstant(1, 2)
	constant div = BytecodeInstruction("Divide", 0, 1, "2")
	constant ret = BytecodeInstruction.ReturnOp(2)
	constant ops = InstructionList.Empty.Append(left).Append(right).Append(div).Append(ret)
	constant optimized = AllOptimizers(ops).Optimize
	logger.Log(ops.Count)
	logger.Log(optimized.Count)
	logger.Log(optimized.At(0))