has logger
Run
	constant left = OptimInstruction.LoadConstant(0, 2)
	constant right = OptimInstruction.LoadConstant(1, 3)
	constant add = OptimInstruction.BinaryOp("Add", 0, 1, 2)
	constant ret = OptimInstruction.ReturnOp(2)
	constant dead = OptimInstruction.LoadConstant(3, 9)
	constant ops = OpList.Empty.Append(left).Append(right).Append(add).Append(ret).Append(dead)
	logger.Log(ops.Count)
	constant stats = AllOptimizers(ops).OptimizeWithStats
	logger.Log(stats)
	logger.Log(stats.HasRemoved)