has logger
Run
	constant left = BytecodeInstruction.LoadConstant(0, 2)
	constant right = BytecodeInstruction.LoadConstant(1, 3)
	constant add = BytecodeInstruction("Add", 0, 1, "2")
	constant ret = BytecodeInstruction.ReturnOp(2)
	constant dead = BytecodeInstruction.LoadConstant(3, 9)
	constant ops = InstructionList.Empty.Append(left).Append(right).Append(add).Append(ret).Append(dead)
	logger.Log(ops.Count)
	constant stats = AllOptimizers(ops).OptimizeWithStats
	logger.Log(stats)
	logger.Log(stats.HasRemoved)