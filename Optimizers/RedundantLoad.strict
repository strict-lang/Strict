has ops Bytecode/InstructionList
Optimize InstructionList
	RedundantLoad(InstructionList.Sample("Add", 5)).Optimize.Count is 3
	mutable next = List(Mutable(BytecodeInstruction))
	mutable previous = BytecodeInstruction.ReturnOp(-1)
	for ops.instructions
		if not IsRepeatedLoad(value, previous)
			next.Add(value)
		previous = value
	InstructionList(next)
IsRepeatedLoad(instruction BytecodeInstruction, previous BytecodeInstruction) Boolean
	IsRepeatedLoad(BytecodeInstruction.LoadConstant(0, 5), BytecodeInstruction.LoadConstant(0, 5)) is true
	IsRepeatedLoad(BytecodeInstruction.ReturnOp(1), BytecodeInstruction.ReturnOp(1)) is false
	if instruction is not previous
		return false
	instruction.typeName is in ("LoadConstantToRegister", "LoadVariableToRegister")