has ops OpList
Optimize OpList
	RedundantLoad(OpList.Empty.With("LoadVariableToRegister", "x").With("LoadVariableToRegister", "x")).Optimize.Count is 1
	mutable next = List(Mutable(OptimInstruction))
	mutable lastName = ""
	for ops.instructions
		if (not value.IsLoadVariable) or value.label is not lastName
			next.Add(value)
		lastName = NextName(value, lastName)
	OpList(next)
NextName(instruction OptimInstruction, lastName Text) Text
	RedundantLoad(OpList.Empty).NextName(OptimInstruction("Invoke", 0, 0, ""), "x") is ""
	if instruction.IsLoadVariable
		return instruction.label
	if instruction.IsStoreRegister or instruction.IsJump
		return ""
	if instruction.typeName is in ("Invoke", "LoopBegin", "LoopEnd")
		return ""
	lastName