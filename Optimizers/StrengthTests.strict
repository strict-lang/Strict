has logger
Run
	constant load = BytecodeInstruction("LoadVariableToRegister", 0, 0, "x")
	constant one = BytecodeInstruction.LoadConstant(1, 1)
	constant mul = BytecodeInstruction("Multiply", 0, 1, "2")
	constant ret = BytecodeInstruction.ReturnOp(2)
	constant ops = InstructionList.Empty.Append(load).Append(one).Append(mul).Append(ret)
	logger.Log(ops.Count)
	constant reduced = StrengthReduce(ops).Optimize
	logger.Log(reduced.Count)
	logger.Log(reduced.At(0))