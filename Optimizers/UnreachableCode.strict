has ops Bytecode/InstructionList
Optimize InstructionList
	UnreachableCode(InstructionList.Empty.With("Return", "").With("Return", "")).Optimize.Count is 1
	UnreachableCode(InstructionList.Empty.With("Return", "").With("JumpEnd", "if0").With("Return", "")).Optimize.Count is 3
	mutable next = List(Mutable(BytecodeInstruction))
	mutable isReachable = true
	for ops.instructions
		if value.typeName is "JumpEnd"
			isReachable = true
		if isReachable
			next.Add(value)
		if value.IsReturn
			isReachable = false
	InstructionList(next)