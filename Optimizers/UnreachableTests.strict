has logger
Run
	constant load = OptimInstruction.LoadConstant(0, 1)
	constant ret = OptimInstruction.ReturnOp(0)
	constant dead = OptimInstruction.LoadConstant(1, 99)
	constant more = OptimInstruction.ReturnOp(1)
	constant ops = OpList.Empty.Append(load).Append(ret).Append(dead).Append(more)
	logger.Log(ops.Count)
	constant cleaned = UnreachableCode(ops).Optimize
	logger.Log(cleaned.Count)
	logger.Log(cleaned.At(1))