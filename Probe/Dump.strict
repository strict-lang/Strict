has logger
Run(path Text, method Text)
	for FileCompiler(logger, true).Compiled(path, ".", false)
		let type = value
		for type.methods
			if (value.Name is method) and type.Name.EndsWith(Path(path).FileName.RemoveExtension.text)
				for value.instructions
					let decoder = PayloadDecoder(value)
					let called = " instance " + decoder.Instance + " arguments " + (decoder.Arguments to Text)
					let line = index + " " + value.kind + " " + (value.texts to Text) + " " + (value.payload to Text)
					logger.Log(line + (value.kind is InstructionType.Invoke then called else ""))
