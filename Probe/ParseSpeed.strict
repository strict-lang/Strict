has logger
constant Folder = "Compiler"
constant Nanoseconds = 1000000000
Lined(files Texts) Number slow
	ParseSpeed.Lined(List(Text)) is 0
	mutable lines = 0
	for files
		lines = lines + File(value).ReadLines.Length
	lines
All(files Texts) Texts slow
	ParseSpeed.All(List(Text)).Length is 0
	mutable lines = List(Text)
	for files
		lines = lines + File(value).ReadLines
	lines
Tokenized(lines Texts) Number
	ParseSpeed.Tokenized(("a + b", "c")) is 4
	mutable tokens = 0
	for lines
		tokens = tokens + Tokenizer(value).Tokens.Length
	tokens
Run
	let files = Directory.Files(Folder, "*.strict")
	let all = All(files)
	for 6
		let started = Process.Elapsed
		let lines = Lined(files)
		let read = Process.Elapsed - started
		let tokens = Tokenized(all)
		let spent = Process.Elapsed - started - read
		let perLine = " ms (" + (read * Nanoseconds / lines).Round(1) + " ns each), "
		let perToken = " ms (" + (spent * Nanoseconds / tokens).Round(1) + " ns each)"
		let reading = lines + " lines " + (read * 1000).Round(1) + perLine
		logger.Log(files.Length + " files, " + reading + tokens + " tokens " + (spent * 1000).Round(1) + perToken)
