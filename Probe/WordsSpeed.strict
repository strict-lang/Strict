has logger
constant Root = (".", "Binary", "Bytecode", "Compiler", "Compression", "Examples", "Expressions", "ImageProcessing", "Json")
constant Folders = Root + ("MachineLearning", "Math", "Networking", "NeuralNetworks", "Probe", "Runtime", "Validators", "Xml")
constant Nanoseconds = 1000000000
Paths Texts slow
	WordsSpeed.Paths.Length > 0
	mutable paths = List(Text)
	for Folders
		paths = paths + Directory.Files(value, "*.strict")
	paths
Loaded(paths Texts) Texts slow
	WordsSpeed.Loaded(List(Text)).Length is 0
	for paths
		Text.Combine(File(value).ReadLines, "\n")
Size(texts Texts) Number
	WordsSpeed.Size(("ab", "c")) is 3
	mutable size = 0
	for texts
		size = size + value.Length
	size
Words(texts Texts) Texts
	WordsSpeed.Words(("a b\nc", "d")) is ("a", "b", "c", "d")
	mutable words = List(Mutable(Text))
	for text, line, word in texts, text.Split("\n"), line.Split(" ")
		words.Add(word)
	words
Run
	let texts = Loaded(Paths)
	let megabytes = Size(texts) / 1000000
	logger.Log(texts.Length + " files, " + megabytes.Round(2) + " MB")
	for 8
		let begun = Process.Elapsed
		let words = Words(texts).Length
		let spent = Process.Elapsed - begun
		let rate = ", " + (megabytes / spent).Round(0) + " MB per second"
		let each = (spent * Nanoseconds / words).Round(1) + " ns each"
		logger.Log(words + " words in " + (spent * 1000).Round(1) + " ms, " + each + rate)
