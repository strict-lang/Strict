has executable Text
Find(name Text) Process
	Process(name)
IsAvailable Boolean
	if executable is ""
		return false
	true
Run(arguments Text) ProcessResult
	ProcessResult(1, "", "Process.Run is not available for: " + arguments)
RunTool(name Text, arguments Text) ProcessResult
	let tool = Find(name)
	if not tool.IsAvailable
		return ProcessResult(127, "", "tool not found: " + name)
	tool.Run(arguments)
OperatingSystem Text
	Process.OperatingSystem is in ("Windows", "Linux", "MacOS")
	"Unknown"
Current Process
	Process.Current.IsAvailable is true
	Process("")
Elapsed Number
	Process.Elapsed > 0 is true
	0
FilesRead Texts
	File("Process.strict").ReadLines.Length > 10 is true
	"Process.strict" is in Process.FilesRead
	List(Text)
Input Text
	""
Built Text
	Process.Current.Built.Length is 19
	""
to Text
	if executable is ""
		return "Process(missing)"
	"Process(" + executable + ")"