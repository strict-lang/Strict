has executable Text
constant NotFoundExitCode = 127
Find(name Text) Process
	Process(name)
IsAvailable Boolean
	Process("").IsAvailable is false
	Process("strict").IsAvailable
	executable is not ""
Run(arguments Text) ProcessResult slow
	ProcessResult(1, "", "Process.Run is not available for: " + arguments)
Started(arguments Text) Number slow
	Process.Find("missingStrictTool").Started("") is 127
	Error("Process.Started needs the native runtime to start " + executable + " " + arguments)
RunTool(name Text, arguments Text) ProcessResult slow
	let tool = Find(name)
	tool.IsAvailable then tool.Run(arguments) else ProcessResult(NotFoundExitCode, "", "tool not found: " + name)
RunTools(name Text, arguments Texts) List(ProcessResult) slow
	Process.RunTools("missingStrictTool", ("a", "b")).Length is 2
	Process.RunTools("missingStrictTool", ("a", "b")).Last.exitCode is 127
	Error("Process.RunTools needs the native runtime to run " + name + " " + (arguments to Text))
OperatingSystem Text
	Process.OperatingSystem is in ("Windows", "Linux", "MacOS")
	"Unknown"
Current Process
	Process.Current.IsAvailable
	Process("")
Wait(seconds Number) slow
Collected
Elapsed Number
	Process.Elapsed > 0
	0
MemoryUsed Number
	Process.MemoryUsed > 1000000
	0
Executed Numbers
	Process.Executed.Length is 5
	Process.Executed(0) >= 1
	(1, 0, 0, 0, 0)
FilesRead Texts
	File("Process.strict").ReadLines.Length > 10
	"Process.strict" is in Process.FilesRead
	List(Text)
Variable(name Text) Text
	Process.Variable("StrictVariableNeverSet") is ""
	Process.Variable("PATH").Length > 0
	Error("Process.Variable needs the native runtime to read " + name)
Input Text slow
	""
InputLine Text slow
	""
Built Text
	Process.Current.Built.Length is 19
	""
to Text
	executable is "" then "Process(missing)" else "Process(" + executable + ")"