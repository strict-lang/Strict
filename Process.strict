has executable Text
constant NotFoundExitCode = 127
constant TimedOutExitCode = 124
constant ToolSeconds = 600
Find(name Text) Process
	Process(name)
IsAvailable Boolean
	Process("").IsAvailable is false
	Process("strict").IsAvailable
	executable is not ""
Run(arguments Text, seconds = ToolSeconds) ProcessResult slow
	ProcessResult(1, "", "Process.Run is not available for: " + arguments + " within " + seconds + " s")
Start(arguments Text) Number slow
	Process.Find("missingStrictTool").Start("") is 127
	Error("Process.Start needs the native runtime to start " + executable + " " + arguments)
Launch(arguments Text) Number slow
	Process.Find("missingStrictTool").Launch("") is 0
	Error("Process.Launch needs the native runtime to start " + executable + " " + arguments)
RunTool(name Text, arguments Text, seconds = ToolSeconds) ProcessResult slow
	tool = Find(name)
	tool.IsAvailable then tool.Run(arguments, seconds) else ProcessResult(NotFoundExitCode, "", "tool not found: " + name)
RunTools(name Text, arguments Texts, seconds = ToolSeconds) List(ProcessResult) slow
	Process.RunTools("missingStrictTool", ("a", "b")).Length is 2
	Process.RunTools("missingStrictTool", ("a", "b")).Last.exitCode is 127
	Error("Process.RunTools needs the native runtime: " + name + " " + arguments.Length + " times, " + seconds + " s")
OperatingSystem Text
	Process.OperatingSystem is in ("Windows", "Linux", "MacOS")
	"Unknown"
Current Process
	Process.Current.IsAvailable
	Process("")
Wait(seconds Number) slow
Collect
Elapsed Number
	Process.Elapsed > 0
	0
Id Number
	Process.Id > 0
	0
MemoryUsed Number
	Process.MemoryUsed > 1000000
	0
Executed Numbers
	Process.Executed.Length is 6
	Process.Executed(0) >= 1
	(1, 0, 0, 0, 0, 0)
FilesRead Texts
	File("Process.strict").ReadLines.Length > 10
	"Process.strict" is in Process.FilesRead
	List(Text)
Variable(name Text) Text
	Process.Variable("StrictVariableNeverSet") is ""
	Process.Variable("PATH").Length > 0
	Error("Process.Variable needs the native runtime to read " + name)
Input Text slow
	""
InputLine Text slow
	""
Built Text
	Process.Current.Built.Length is 19
	""
to Text
	executable is "" then "Process(missing)" else "Process(" + executable + ")"