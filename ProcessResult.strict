has exitCode Number
has Output Text
has error Text
has Seconds Number = 0
has ProcessorSeconds Number = 0
HasSucceeded Boolean
	exitCode is 0
HasFailed Boolean
	exitCode is not 0
to Text
	ProcessResult(0, "", "") to Text is "ok exit=0"
	ProcessResult(2, "", "bad") to Text is "fail exit=2 bad"
	HasSucceeded then "ok exit=0" else "fail exit=" + exitCode to Text + " " + error