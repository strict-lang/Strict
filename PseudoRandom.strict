mutable high Number
mutable low Number = 521288629
constant LowMultiplier = 18000
constant HighMultiplier = 36969
constant HalfRange = 65536
constant UnitScale = 0.0000000002328306435454494
Next Number
	PseudoRandom(1).Next is 2697938338
	PseudoRandom(1).Skip(3) is 3019139328
	low = LowMultiplier * (low % HalfRange) + (low / HalfRange).Floor
	high = HighMultiplier * (high % HalfRange) + (high / HalfRange).Floor
	(high * HalfRange + low) % HashCode.UnsignedRange
Forked PseudoRandom
	PseudoRandom(1).Forked.Next is not PseudoRandom(1).Next
	mutable copy = value
	copy.Next
	copy
Get(minimum Number, maximum Number) Number
	PseudoRandom(1).Get(0, 10).Floor is 6
	PseudoRandom(1).Get(5, 5) is 5
	PseudoRandom(1).Get(10, 0) is Error("InvalidRange")
	PseudoRandom(1).Get(10, 20) is 16.28162719715311
	PseudoRandom(1).Get(0, 4294967296).Floor is 2697938337
	maximum < minimum then Error("InvalidRange") else (Next + 1) * UnitScale * (maximum - minimum) + minimum
Skip(count Number) Number
	PseudoRandom(1).Skip(2) is 1580277510
	mutable last = 0
	for count
		last = Next
	last
WeightedIndex(weights Numbers) Number
	PseudoRandom(1).WeightedIndex((1, 0, 3)) is 2
	PseudoRandom(1).WeightedIndex((3, 1)) is 0
	PseudoRandom(1).WeightedIndex(List(Number)) is -1
	let target = Get(0, weights.Sum)
	mutable sum = 0
	for weights
		sum = sum + value
		if target <= sum
			return index
	weights.Length - 1
