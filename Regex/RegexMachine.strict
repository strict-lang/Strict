has steps List(RegexStep)
has text Text
constant Plus = RegexMachine(RegexParser("a+b").Parsed, "xaab")
constant Grouped = RegexMachine(RegexParser("(a|b)c").Parsed, "zbc")
Find(start Number) Numbers
	Plus.Find(0) is (1, 4)
	Grouped.Find(0) is (1, 3, 1, 2)
	mutable threads = List(Numbers)
	mutable matched = List(Number)
	for Range(start, text.Length + 1)
		current = matched.Length is 0 then Add(threads, Fresh, value) else threads
		cut = MatchIndex(current)
		matched = cut < current.Length then current(cut).Slice(1, current(cut).Length - 1) else matched
		threads = Advance(current.Slice(0, cut), value)
		if threads.Length is 0 and matched.Length > 0
			return matched
	List(Number)
IsFound(start Number) Boolean
	RegexMachine(RegexParser("abc|a|d").Parsed, "abd").Find(0) is (0, 1)
	RegexMachine(RegexParser("ab|a").Parsed, "ab").Find(0) is (0, 2)
	RegexMachine(RegexParser("a+?").Parsed, "aaa").Find(0) is (0, 1)
	RegexMachine(RegexParser("a*b").Parsed, "aab").Find(0) is (0, 3)
	RegexMachine(RegexParser("^a").Parsed, "ab").IsFound(0)
	RegexMachine(RegexParser("^b").Parsed, "ab").IsFound(0) is false
	RegexMachine(RegexParser("a$").Parsed, "ab").IsFound(0) is false
	RegexMachine(RegexParser("b$").Parsed, "ab").Find(0) is (1, 2)
	RegexMachine(RegexParser("").Parsed, "x").Find(0) is (0, 0)
	Plus.Find(2) is (2, 4) and Plus.IsFound(4) is false
	Find(start).Length > 0
Fresh Numbers
	Plus.Fresh is (0, -1, -1)
	Grouped.Fresh.Length is 5
	mutable fresh = List(Number) + 0
	for Slots
		fresh = fresh + -1
	fresh
Slots Number
	Plus.Slots is 2
	Grouped.Slots is 4
	RegexMachine(RegexParser("a|bcdef").Parsed, "").Slots is 2
	mutable slots = 0
	for steps
		if value.Kind is RegexStep.Save and value.First >= slots
			slots = value.First + 1
	slots
MatchIndex(threads List(Numbers)) Number
	Plus.MatchIndex(List(Numbers) + (5, 0, 4)) is 0
	Plus.MatchIndex(List(Numbers) + (1, -1, -1)) is 1
	RegexMachine(RegexParser("a*").Parsed, "aa").Find(0) is (0, 2)
	for threads
		if steps(value(0)).Kind is RegexStep.Match
			return index
	threads.Length
Advance(threads List(Numbers), at Number) List(Numbers)
	Plus.Advance(List(Numbers) + (1, 1, -1), 1).Length is 3
	Plus.Advance(List(Numbers) + (1, 1, -1), 0).Length is 0
	Plus.Advance(List(Numbers) + (1, 1, -1), 4).Length is 0
	mutable next = List(Numbers)
	if at is text.Length
		return next
	code = text(at).number
	for threads
		if steps(value(0)).Accepts(code)
			next = Add(next, Move(value, value(0) + 1), at + 1)
	next
Add(threads List(Numbers), thread Numbers, at Number) List(Numbers)
	Plus.Add(List(Numbers), Plus.Fresh, 0).Length is 2
	Plus.Add(List(Numbers) + (0, -1, -1), Plus.Fresh, 0).Length is 1
	Has(threads, thread(0)) then threads else Follow(threads + thread, thread, at)
Follow(listed List(Numbers), thread Numbers, at Number) List(Numbers)
	Plus.Follow(List(Numbers), (2, 1, -1), 2).Length is 2
	RegexMachine(RegexParser("^a").Parsed, "ba").Follow(List(Numbers), (1, 1, -1), 1).Length is 0
	step = steps(thread(0))
	if step.Kind is RegexStep.Split
		return Add(Add(listed, Move(thread, thread(0) + step.First), at), Move(thread, thread(0) + step.Second), at)
	if step.Kind is RegexStep.Save
		return Add(listed, Move(Store(thread, step.First, at), thread(0) + 1), at)
	isBegun = step.Kind is RegexStep.Begin and at is 0
	isEnded = step.Kind is RegexStep.End and at is text.Length
	target = step.Kind is RegexStep.Jump then thread(0) + step.First else thread(0) + 1
	step.Kind is RegexStep.Jump or isBegun or isEnded then Add(listed, Move(thread, target), at) else listed
Move(thread Numbers, step Number) Numbers
	Plus.Move((1, 7), 4) is (4, 7)
	(List(Number) + step) + thread.Slice(1, thread.Length - 1)
Store(thread Numbers, slot Number, at Number) Numbers
	Plus.Store((1, -1, -1), 1, 9) is (1, -1, 9)
	for thread
		index is slot + 1 then at else value
Has(threads List(Numbers), step Number) Boolean
	Plus.Has(List(Numbers) + (1, 2), 1)
	Plus.Has(List(Numbers) + (1, 2), 2) is false
	for threads
		if value(0) is step
			return true
	false
