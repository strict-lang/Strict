has steps List(RegexStep)
has next Number
has groups Number
constant Letter = RegexPart(List(RegexStep) + RegexStep.Literal(97), 1, 0)
Branch(preferred Number, other Number, isLazy Boolean) RegexStep
	Letter.Branch(1, 3, false).Second is 3
	Letter.Branch(1, 3, true).First is 3
	Letter.Branch(1, 3, true).Second is 1
	RegexStep(RegexStep.Split, List(Number), false, isLazy then other else preferred, isLazy then preferred else other)
Save(slot Number) RegexStep
	Letter.Save(2).First is 2
	Letter.Save(2).Kind is RegexStep.Save
	RegexStep(RegexStep.Save, List(Number), false, slot)
Star(isLazy Boolean) List(RegexStep)
	Letter.Star(false)(0).Second is 3
	Letter.Star(false)(2).First is -2
	Letter.Star(true)(0).First is 3
	back = RegexStep(RegexStep.Jump, List(Number), false, -steps.Length - 1)
	((List(RegexStep) + Branch(1, steps.Length + 2, isLazy)) + steps) + back
Plus(isLazy Boolean) List(RegexStep)
	Letter.Plus(false)(1).First is -1
	Letter.Plus(true)(1).First is 1
	steps + Branch(-steps.Length, 1, isLazy)
Optional(isLazy Boolean) List(RegexStep)
	Letter.Optional(false)(0).Second is 2
	Letter.Optional(true)(0).First is 2
	Letter.Optional(false).Length is 2
	(List(RegexStep) + Branch(1, steps.Length + 1, isLazy)) + steps
Repeat(count Number) List(RegexStep)
	Letter.Repeat(3).Length is 3
	Letter.Repeat(0).Length is 0
	mutable repeated = List(Mutable(RegexStep))
	for count
		repeated = repeated + steps
	repeated
Capture(index Number) List(RegexStep)
	Letter.Capture(1)(0).First is 2
	Letter.Capture(1)(2).First is 3
	((List(RegexStep) + Save(index * 2)) + steps) + Save(index * 2 + 1)
Or(right RegexPart) RegexPart
	Letter.Or(Letter).steps(0).Second is 3
	Letter.Or(Letter).steps(2).First is 2
	Letter.Or(RegexPart(Letter, groups = 2)).groups is 2
	skip = RegexStep(RegexStep.Jump, List(Number), false, right.steps.Length + 1)
	left = (List(RegexStep) + Branch(1, steps.Length + 2, false)) + steps
	RegexPart((left + skip) + right.steps, right.next, right.groups)
