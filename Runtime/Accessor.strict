has machine Machine
constant Computed = -2
constant Listed = MemberEntry("numbers", "Strict/List(Number)", List(InstructionEntry), false)
constant NumbersMethod = MethodEntry("Numbers", List(MemberEntry), "Strict/List(Number)", (InstructionEntry.Named(InstructionType.LoadVariableToRegister, 0, "numbers"), InstructionEntry.Return(0)))
constant FirstMethod = MethodEntry("First", List(MemberEntry), "Strict/Number", (InstructionEntry.LoadNumber(0, 0), InstructionEntry(InstructionType.IndexCall, "numbers", (1, 0, -1)), InstructionEntry.Return(1)))
constant Holder = TypeEntry("Strict/Holder", (MemberEntry.LoggerMember, Listed), (NumbersMethod, FirstMethod))
constant FirstCall = InstructionEntry.Invoke(1, ("Strict/Holder", "First", "Strict/Number"), List(Number), 0)
constant HeadMethod = MethodEntry("Head", List(MemberEntry), "Strict/Number", (InstructionEntry.Named(InstructionType.LoadVariableToRegister, 0, "holder"), FirstCall, InstructionEntry.Return(1)))
constant Outer = TypeEntry("Strict/Outer", List(MemberEntry) + MemberEntry("holder", "Strict/Holder", List(InstructionEntry), false), List(MethodEntry) + HeadMethod)
constant OddMethods = (MethodEntry(NumbersMethod, parameters = Listed), MethodEntry(FirstMethod, instructions = InstructionEntry.Return(0)), MethodEntry(FirstMethod, instructions = FirstMethod.instructions + InstructionEntry.Return(1)))
constant Odd = TypeEntry(Holder.Name, Holder.members + MemberEntry.SevenMember, OddMethods)
constant Loading = InstructionEntry.Named(InstructionType.LoadVariableToRegister, 2, "holder")
constant Getting = Accessor(Machine((Holder, Outer, Odd)))
constant FirstResolved = Resolver(Getting.machine.types).Target(FirstCall)
constant Held = VmValue("Strict/Holder", 0, "", (VmValue.None, VmValue.OfList(VmValue.OfNumber(3), VmValue.OfNumber(5))))
Mark(target Numbers, count Number) Numbers
	Accessor(Machine(List(TypeEntry) + TypeEntry.Kept)).Mark((0, 0, 0), 0) is (Computed, 0)
	Getting.Mark((0, 0, 0), 0) is (0, 1)
	Accessor(Machine(List(TypeEntry) + TypeEntry.Kept)).Mark((0, 0, 0), 1).Length is 0
	Accessor(Machine(List(TypeEntry) + TypeEntry.Kept)).Mark((-1, 0, 0), 0).Length is 0
	Getting.Mark((0, 0, 1), 0).Length is 0
	Getting.Mark((-2, 0, 0), 0).Length is 0
	if target(0) < 0 or count > 0
		return Path(target, count, 0)
	type = machine.types(target(0))
	slot = type.ConstantSlot(type.methods(target(1)))
	slot < 0 then Path(target, count, 0) else (Computed, slot)
Path(target Numbers, count Number, depth Number) Numbers
	Getting.Path((0, 0, 0), 0, 0) is (0, 1)
	Getting.Path((1, 0, 0), 0, 0) is (1, 0, 0, 1, -1, 0)
	Getting.Path((0, 0, 0), 1, 0).Length is 0 and Getting.Path((2, 0, 0), 0, 0).Length is 0
	Getting.Path((-1, 0, 0), 0, 0).Length is 0 and Getting.Path((2, 1, 0), 0, 0).Length is 0
	Getting.Path((0, 0, 0), 0, 8).Length is 0 and Getting.Path((2, 2, 0), 0, 0).Length is 0
	if target(0) < 0 or target(2) is 1 or count > 0 or depth > 7
		return List(Number)
	method = machine.types(target(0)).methods(target(1))
	length = method.instructions.Length
	if method.parameters.Length > 0 or length < 2 or length > 3
		return List(Number)
	Follow(target(0), method.instructions, depth)
Follow(route Number, instructions List(InstructionEntry), depth Number) Numbers
	Getting.Follow(0, Holder.methods(1).instructions, 0) is (0, 1, -1, 0)
	Getting.Follow(0, List(InstructionEntry) + FirstCall + InstructionEntry.Return(1), 0).Length is 0
	first = instructions.First
	returned = instructions.Last
	if returned.kind is not InstructionType.Return
		return List(Number)
	if instructions.Length is 2
		return Load(route, first, returned.payload(0))
	middle = instructions(1)
	if middle.payload(0) is not returned.payload(0)
		return List(Number)
	middle.kind is InstructionType.IndexCall then ResolveAt(route, first, middle) else Chain(route, first, middle, depth)
Load(route Number, entry InstructionEntry, register Number) Numbers
	Getting.Load(0, Holder.methods(0).instructions.First, 0) is (0, 1)
	Getting.Load(0, Holder.methods(0).instructions.First, 1).Length is 0
	Getting.Load(0, Holder.methods(1).instructions(1), 1).Length is 0
	Getting.Follow(0, (Holder.methods(0).instructions.First, Holder.methods(0).instructions.First), 0).Length is 0
	Getting.Follow(1, (Outer.methods(0).instructions.First, FirstCall, InstructionEntry.Return(0)), 0).Length is 0
	isLoad = entry.kind is InstructionType.LoadVariableToRegister and entry.payload(0) is register
	member = isLoad then Member(route, entry.texts(0)) else -1
	member < 0 then List(Number) else (route, member)
Member(route Number, name Text) Number
	Getting.Member(0, "numbers") is 1
	Getting.Member(0, "missing") is -1
	Getting.Member(2, "a") is -1
	for machine.types(route).members
		if value.Name is name and value.IsConstant is false
			return index
	Number.NotFound
ResolveAt(route Number, first InstructionEntry, middle InstructionEntry) Numbers
	Getting.ResolveAt(0, Holder.methods(1).instructions.First, Holder.methods(1).instructions(1)) is (0, 1, -1, 0)
	Getting.ResolveAt(0, Holder.methods(0).instructions.First, Holder.methods(1).instructions(1)).Length is 0
	Getting.ResolveAt(0, InstructionEntry.LoadNumber(0, 1.5), Holder.methods(1).instructions(1)).Length is 0
	Getting.ResolveAt(0, InstructionEntry.LoadNumber(1, 0), Holder.methods(1).instructions(1)).Length is 0
	Getting.ResolveAt(1, InstructionEntry.LoadNumber(0, 0), Holder.methods(1).instructions(1)).Length is 0
	isConstant = first.kind is InstructionType.LoadConstantToRegister and first.payload(0) is middle.payload(1)
	loaded = isConstant then PayloadDecoder(first).Value(1) else VmValue.None
	member = Member(route, middle.texts(0))
	isWhole = loaded.kind is "Number" and loaded.number is loaded.number.Floor
	isWhole and member >= 0 then (route, member, -1, loaded.number) else List(Number)
Chain(route Number, first InstructionEntry, middle InstructionEntry, depth Number) Numbers
	Getting.Chain(1, Outer.methods(0).instructions.First, FirstCall, 0) is (1, 0, 0, 1, -1, 0)
	Getting.Chain(1, Outer.methods(0).instructions.First, FirstCall, 8).Length is 0
	Getting.Chain(1, Holder.methods(1).instructions.First, FirstCall, 0).Length is 0
	Getting.Chain(1, Outer.methods(0).instructions.First, Holder.methods(1).instructions(1), 0).Length is 0
	if middle.kind is not InstructionType.Invoke
		return List(Number)
	call = Invocation(middle, List(VmValue), VmValue.None)
	loaded = middle.payload(call.Flag) is 1 then Load(route, first, middle.payload(call.Flag + 1)) else List(Number)
	if loaded.Length is 0
		return loaded
	inner = Path(Routes(machine.types).Target(call), call.Count, depth + 1)
	inner.Length is 0 then inner else loaded + inner
Access(call Invocation) VmValue
	Getting.Access(Invocation(FirstResolved, List(VmValue), Held)).number is 3
	Getting.Access(Invocation(FirstCall, List(VmValue), Held)).kind is "None"
	payload = call.entry.payload
	at = call.Resolution + 3
	if payload.Length <= at
		return VmValue.None
	if payload(at) is Computed
		return Constants(machine).Value(payload(call.Resolution), payload(at + 1))
	mutable found = call.Instance
	for (payload.Length - at) / 2
		found = Step(found, payload(at + index * 2), payload(at + index * 2 + 1))
	found.kind is in ("Error", "Strict/Error") then VmValue.None else found
Step(instance VmValue, route Number, number Number) VmValue
	Getting.Step(Held, 0, 1).Length is 2
	Getting.Step(Held.items(1), -1, 1).number is 5
	Getting.Step(Held.items(1), -1, 2).kind is "None"
	if route >= 0
		return machine.MemberValue(machine.types(route), instance, number)
	wrapped = Wrap(instance, number)
	wrapped < 0 then VmValue.None else Item(instance, wrapped)
Wrap(collection VmValue, at Number) Number
	Getting.Wrap(VmValue.OfText("ab"), -1) is 1
	Getting.Wrap(VmValue.OfText("ab"), 2) is -1
	Getting.Wrap(VmValue.OfText("ab"), 0) is 0 and Getting.Wrap(VmValue.OfText("ab"), 1) is 1
	Getting.Wrap(VmValue.OfText("ab"), -4) is -1
	Getting.Wrap(VmValue.OfText("ab"), 0 / 0) is -1
	Getting.Chain(1, Loading, InstructionEntry.Invoke(1, FirstCall.texts, List(Number), 2), 0) is (1, 0, 0, 1, -1, 0)
	Getting.Chain(1, Loading, InstructionEntry.Invoke(2, FirstCall.texts, List(Number), -1), 0).Length is 0
	wrapped = at < 0 then at + collection.Length else at
	wrapped >= 0 and wrapped < collection.Length then wrapped else Number.NotFound
Item(collection VmValue, position Number) VmValue
	Getting.Item(VmValue.OfText("ab"), 1).text is "b"
	Getting.Item(Held.items(1), 0).number is 3
	collection.kind is "Text" then VmValue.OfText(collection.text(position) to Text) else collection.items(position)