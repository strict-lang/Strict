has left VmValue
has right VmValue
Compute(opName Text) VmValue
	ArithmeticExec(VmValue.FromNumber(6), VmValue.FromNumber(3)).Compute("Divide").number is 2
	ArithmeticExec(VmValue.FromNumber(6), VmValue.FromNumber(6)).Compute("Equal").IsTrue is true
	if opName is "Equal"
		return VmValue.FromBoolean(left.EqualsValue(right))
	if opName is "NotEqual"
		return VmValue.FromBoolean(left.EqualsValue(right) is false)
	if (not left.IsNumber) or (not right.IsNumber)
		return VmValue.None
	if opName is in ("GreaterThan", "LessThan")
		return Compare(opName is "GreaterThan")
	Calculate(opName)
Compare(isGreater Boolean) VmValue
	ArithmeticExec(VmValue.FromNumber(1), VmValue.FromNumber(2)).Compare(false).IsTrue is true
	if isGreater
		return VmValue.FromBoolean(left.number > right.number)
	VmValue.FromBoolean(left.number < right.number)
Calculate(opName Text) VmValue
	ArithmeticExec(VmValue.FromNumber(7), VmValue.FromNumber(4)).Calculate("Modulo").number is 3
	if opName is "Add"
		return VmValue.FromNumber(left.number + right.number)
	if opName is "Subtract"
		return VmValue.FromNumber(left.number - right.number)
	if opName is "Multiply"
		return VmValue.FromNumber(left.number * right.number)
	if opName is "Divide"
		return VmValue.FromNumber(left.number / right.number)
	if opName is "Modulo"
		return VmValue.FromNumber(left.number % right.number)
	VmValue.None