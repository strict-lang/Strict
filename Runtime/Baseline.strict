has mutants Mutants
constant Reader = MethodEntry("Read", List(MemberEntry), "None", List(InstructionEntry) + InstructionEntry.Invoke(0, ("Strict/File", "ReadLines", "Strict/List(Text)"), List(Number), -1))
constant Calling = MethodEntry("Call", List(MemberEntry), "None", List(InstructionEntry) + InstructionEntry.Invoke(0, ("Strict/T", "Read", "None"), List(Number), -1))
constant Reading = List(TypeEntry) + TypeEntry("Strict/T", List(MemberEntry), (Calling, Reader))
constant Libraries = Baseline(Mutants(Logger, "Library.strict"))
constant Sampled = Baseline(Mutants.Sample)
constant Rolled = InstructionEntry.Invoke(1, ("Strict/Number", "Random", "Strict/Number"), List(Number), 0)
constant Splitting = (InstructionEntry.LoadNumber(0, 0), Mutation.Marking, Rolled, InstructionEntry.LoadNumber(1, 1), InstructionEntry.Return(0))
constant Rolling = TypeEntry(Machine.Doubler, methods = (Mutants.Lined, MethodEntry(Mutants.Lined, Name = TestCodegen.Runner, instructions = Splitting)))
Kept(types List(TypeEntry)) List(MethodEntry)
	Baseline(Mutants.Sample).Kept(Mutants.Doubled).Length is 0
	Libraries.Kept(Execute(Logger).Loaded("Library.strict", ".")).Length is 0
	let methods = IsBase then List(MethodEntry) else Picked(Usable(types))
	let tested = mutants.Tested(types, mutants.Runner(types.First), methods)
	let limit = mutants.isWhole then 1 else 0.1
	for methods
		let reason = Reason(Execute(mutants.logger).Started(tested, mutants.path), TestCodegen.Runner + index, limit)
		if (reason is not "") and (mutants.part is "")
			mutants.logger.Log(mutants.path + ": " + value.Name + " is not mutated, " + reason)
		if (reason is "") and IsRun(tested, value, TestCodegen.Runner + index)
			value
Budgets(tested List(TypeEntry), count Number) Numbers
	Sampled.Budgets(Mutants.Doubled, 0).Length is 0
	Sampled.Budgets(Mutants.Doubled, 2).Length is 2
	for count
		Timed(Execute(mutants.logger).Started(tested, mutants.path), TestCodegen.Runner + index)
Timed(started Machine, runner Text) Number
	Sampled.Timed(Machine.Hello, TestCodegen.Runner) < Mutants.Sample.seconds
	Baseline(Mutants(Logger, "A.strict", 0)).Timed(Frame.Doubling, "Missing") is 0
	let begun = Process.Elapsed
	mutants.Passes(started, runner, mutants.seconds) then Budget(begun) else mutants.seconds
Budget(started Number) Number
	Baseline.Budget(Process.Elapsed) is 0.001
	Baseline.Budget(Process.Elapsed - 1) < 10.1
	((Process.Elapsed - started) * 10, 0.001).Maximum
Expired(begun Number, budget Number) Boolean
	Baseline.Expired(Process.Elapsed - 1, 0.5)
	Baseline.Expired(Process.Elapsed, 10) is false
	Process.Elapsed - begun >= budget
IsRun(tested List(TypeEntry), method MethodEntry, runner Text) Boolean
	Baseline(Mutants.Sample).IsRun(Mutants.Doubled, Mutants.Twice, TestCodegen.Runner) is false
	let failing = List(MethodEntry) + MethodEntry(method, instructions = Invocation.Failing.methods.First.instructions)
	let replaced = mutants.Replaced(tested, List(MethodEntry) + method, failing)
	let started = Execute(mutants.logger).Started(replaced, mutants.path)
	Machine(started, deadline = Process.Elapsed + 1).Tested(tested.First.Name, runner) > 0
Reaching(types List(TypeEntry)) Texts
	Baseline(Mutants.Sample).Reaching(Reading) is ("T.Read", "T.Call")
	mutable reaching = List(Mutable(Text))
	mutable count = -1
	for as long as count < reaching.Length
		count = reaching.Length
		for type, method in types, type.methods
			let name = TypeEntry.ShortName(type.Name) + "." + method.Name
			if (name is not in reaching) and IsReaching(method, reaching)
				reaching.Add(name)
	reaching
Usable(types List(TypeEntry)) List(MethodEntry)
	Baseline(Mutants.Sample).Usable(Mutants.Doubled).Length is 0
	Sampled.Usable(List(TypeEntry) + TypeEntry(Machine.Doubler, methods = List(MethodEntry) + Mutants.Lined)).Length is 1
	Sampled.Usable(List(TypeEntry) + Rolling).Length is 0
	let reaching = Reaching(types)
	let runner = mutants.Runner(types.First)
	for mutants.Mutated(types.First)
		let tests = MethodEntry(runner, instructions = Mutation(runner).Split(List(Text) + value.Name))
		let isInput = (TypeEntry.ShortName(types.First.Name) + "." + value.Name is in reaching) or IsReaching(tests, reaching)
		if isInput and (mutants.part is "")
			mutants.logger.Log(mutants.path + ": " + value.Name + " is not mutated, it or its tests use input or Random")
		if isInput is false
			value
IsReaching(method MethodEntry, reaching Texts) Boolean
	Sampled.IsReaching(Reader, List(Text)) and (Sampled.IsReaching(Calling, List(Text)) is false)
	Baseline(Mutants.Sample).IsReaching(Calling, List(Text) + "T.Read")
	Sampled.IsReaching(MethodEntry(Reader, instructions = List(InstructionEntry) + Rolled), List(Text))
	for method.instructions
		if (value.kind is InstructionType.Invoke) and (value.texts.Length > 1)
			let name = TypeEntry.ShortName(value.texts(0)) + "." + value.texts(1)
			if mutants.IsInput(value.texts(0)) or (value.texts(1) is "Random") or (name is in reaching)
				return true
	false
Picked(methods List(MethodEntry)) List(MethodEntry)
	Sampled.Picked((Reader, Calling, Reader, Calling)).Length is 3
	Baseline(Mutants(Logger, "a.strict", isWhole = true)).Picked((Reader, Calling, Reader, Calling)).Length is 4
	constant LightMethods = 3
	let isAll = mutants.isWhole or (methods.Length <= LightMethods)
	isAll then methods else methods.Shuffled(PseudoRandom(Byte.Values.Random)).Slice(0, LightMethods)
IsBase Boolean
	Baseline(Mutants(Logger, "Number.strict")).IsBase and Baseline(Mutants(Logger, "./Text.strict")).IsBase
	Baseline(Mutants(Logger, "Math/Size.strict")).IsBase is false
	let folder = Path(mutants.path).PathOnly.text
	File((folder is "" then "." else folder) + "/Strict.strict").Exists
Reason(started Machine, runner Text, limit Number) Text
	Baseline(Mutants.Sample).Reason(Machine.Hello, TestCodegen.Runner, 1) is ""
	Baseline(Mutants.Sample).Reason(Frame.Doubling, "Missing", 0) is "its tests fail or take over 0s"
	let read = Process.FilesRead.Length
	let begun = Process.Elapsed
	let failed = Machine(started, deadline = begun + limit).Tested(started.types.First.Name, runner)
	let slow = (failed > 0) or Expired(begun, limit) then "its tests fail or take over " + limit + "s" else ""
	Process.FilesRead.Length > read then "its tests read files" else slow
