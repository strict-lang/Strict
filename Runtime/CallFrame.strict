has names Texts
has kinds Texts
has numbers
has texts
Has(name Text) Boolean
	for names
		if value is name
			return true
	false
Get(name Text) VmValue
	mutable found = -1
	mutable index = 0
	for names
		if value is name
			found = index
		index = index + 1
	ValueFromFound(found)
ValueFromFound(found Number) VmValue
	if found is -1
		return VmValue.None
	ValueAt(found)
ValueAt(index Number) VmValue
	let kind = kinds(index)
	if kind is "Number"
		return VmValue("Number", numbers(index), "", false)
	if kind is "Boolean"
		return BoolAt(index)
	if kind is "Text"
		return VmValue("Text", 0, texts(index), false)
	VmValue.None
BoolAt(index Number) VmValue
	if texts(index) is "true"
		return VmValue("Boolean", 0, "true", true)
	VmValue("Boolean", 0, "false", false)
Set(name Text, slot VmValue) CallFrame
	CallFrame.Empty.Set("n", VmValue.FromNumber(3)).Count is 1
	Append(name, slot.kind, slot.number, TextSlot(slot))
Append(name Text, kind Text, amount Number, content Text) CallFrame
	CallFrame.Empty.Append("a", "Number", 1, "").Append("b", "Number", 2, "").Count is 2
	CallFrame(names + name, kinds + kind, numbers + amount, texts + content)
TextSlot(slot VmValue) Text
	if slot.kind is "Boolean"
		return slot.FlagText
	if slot.kind is "Text"
		return slot.text
	""
Count Number
	names.Length
Empty CallFrame
	constant emptyNames = List(Text)
	constant emptyKinds = List(Text)
	constant emptyNumbers = List(Number)
	constant emptyTexts = List(Text)
	CallFrame(emptyNames, emptyKinds, emptyNumbers, emptyTexts)
to Text
	"vars=" + Count to Text