has request TestRequest
constant Absent = CandidateBatch(TestRequest(("Missing.strict", ".", "candidates:Missing.txt")))
constant Head = "has a Number\nB Number\n\tS(5).B is 25"
Source(head Text, tail Text) Text
	Absent.Source(Head, "\ta\nconstant C = 1") is "has a Number\nconstant C = 1\nB Number\n\tS(5).B is 25\n\ta"
	lines = head.Lines
	end = TypeShape(lines).MembersEnd
	constants = Constants(tail.Lines)
	Text.Combine(lines.Slice(0, end) + constants + lines.Slice(end, lines.Length - end) + (tail.Lines - constants), "\n")
Serve(execute Execute) Answer slow
	Absent.Serve(Execute).code is 1
	Answer(Count(File(request.Candidates).ReadText, execute), execute.known)
Count(tails Text, execute Execute) Number slow
	Absent.Count("\tinput\n---\n\tinput * input", Execute) is 2
	failed = Test(tails.Split("\n---\n"), 0, execute, File(request.rest(0)).ReadText).Count(false)
	File(FileCompiler.Normalize(request.rest(0))).InMemory("")
	failed
Test(tails Texts, at Number, execute Execute, head Text) Booleans slow
	Absent.Test(("\t1", "\t2"), 2, Execute, Head).Length is 0
	if at >= tails.Length
		return List(Boolean)
	File(FileCompiler.Normalize(request.rest(0))).InMemory(Source(head, tails(at)))
	logger.Log("Candidate " + (at + 1))
	answer = execute.Serve(request.rest(0), request.rest(1))
	warm = Execute(execute, known = answer.known, inferred = answer.inferred)
	(List(Boolean) + (answer.code is 0)) + Test(tails, at + 1, warm, head)
Constants(lines Texts) Texts
	Absent.Constants(("\t1", "constant A = 1")) is ("constant A = 1")
	for lines
		if value.StartsWith("constant ")
			value
