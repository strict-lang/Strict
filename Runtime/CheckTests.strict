constant ToolSeconds = 90
constant ProbePath = "Bytecode/PolicyProbe.strict"
constant DeadlineName = "TestDurationMustNotExceedTwoHundredMilliseconds"
constant PauseLines = ("constant Seconds = 0.25", "Pause Number", "	let started = Process.Elapsed", "	mutable count = 0", "	for as long as Process.Elapsed - started < Seconds", "		count = count + 1", "	count > 0 then 1 else 0")
constant LazyHead = ("has logger", "constant Shared = Created", "Created Text", "	logger.Log(\"fixture computed\")", "	\"seven\"")
constant LazyTail = ("Check Text", "	LazyFixture.Check is \"seven\"", "	Shared is \"seven\"", "	Shared + Shared is \"sevenseven\"", "	false then Shared else \"seven\"")
constant SharedBudgetCode = ("constant Shared = TestWork.Pause", "Check Number", "	SharedBudget.Shared is 1", "	1")
constant SetupBudgetCode = ("Check Number", "	constant sample = TestWork.Pause", "	sample is 1", "	1")
constant DoubleCode = ("has number", "Doubled Number", "	Doubling(2).Doubled is 4", "	number * 2")
constant TripleCode = ("has number", "Tripled Number", "	Tripling(0).Tripled is 0", "	number + Doubling(number).Doubled")
constant SixCode = ("has number", "Sixfolded Number", "	Sixfold(2).Sixfolded is 12", "	Tripling(number).Tripled * 2")
constant HangLines = ("Spin Number", "	Hangs.Spin is 1", "	mutable count = 0", "	for as long as Process.Elapsed >= 0", "		count = count + 1", "	count")
constant PolicyHead = ("has logger", "constant Fixture = Policy.Value + 1", "Run Number", "	logger.Log(\"application\")", "	0", "Value Number slow", "	Policy.Value is 7", "	let started = Process.Elapsed")
constant PolicyMid = ("	mutable count = 0", "	for as long as Process.Elapsed - started < 0.04", "		count = count + 1", "	logger.Log(\"manual fixture\")", "	count > 0 then 7 else 0")
constant PolicyTail = ("Quick Number", "	Policy.Quick is 3", "	3", "FixtureUsed Number slow", "	Policy.Fixture is 8", "	Fixture")
constant WaitLines = ("Delay Number", "	Waiting.Delay is 1", "	let started = Process.Elapsed", "	mutable count = 0", "	for as long as Process.Elapsed - started < 0.04", "		count = count + 1", "	count > 0 then 1 else 0")
constant LoopLines = ("Spin Number slow", "	Loops.Spin is 1", "	started = Process.Elapsed", "	mutable count = 0", "	for as long as Process.Elapsed - started < 20", "		count = count + 1", "	count > 0 then 1 else 0")
constant Pooled = ("set STRICT_THREADS=8&& ", "STRICT_THREADS=8 ")
constant NoThreads = ("set STRICT_THREADS=& ", "env -u STRICT_THREADS ")
constant ShortDeadline = ("set STRICT_SERVER=0&& set STRICT_DEADLINE=2&& ", "STRICT_SERVER=0 STRICT_DEADLINE=2 ")
constant WindowsChild = "\"cmd\", \"/c ping -n 7 127.0.0.1 >nul && echo alive> "
constant LinuxChild = "\"sh\", \"-c 'sleep 6; echo alive > "
constant PassedLine = "Test passed: LazyFixture.Check is \"seven\""
Run Number
	folder = "obj/TestPolicy" + 1000000.Random.Floor
	for Directory.Directories("obj")
		if Path(value).FileName.text.StartsWith("TestPolicy")
			Directory.Delete("obj/" + Path(value).FileName.text)
	if Directory.Create(folder) is Error
		return Error("DirectoryNotCreated")
	Check(folder)
	Directory.Delete(folder)
	logger.Log("Cached passes, unit deadlines, Slow selection, internal packages, Run order and shares passed")
	0
Check(folder Text)
	CheckDeps(folder)
	CheckBudget(folder)
	CheckLazy(folder)
	CheckPolicy(folder)
	CheckWaiting(folder)
	CheckProbe
	CheckShares(folder)
CheckDeps(folder Text)
	File(folder + "/Doubling.strict").Write(DoubleCode)
	File(folder + "/Tripling.strict").Write(TripleCode)
	File(folder + "/Sixfold.strict").Write(SixCode)
	if RunTests("test " + folder + "/Sixfold.strict unit", Pooled).exitCode is not 0
		return Error("InitialDependencyChainFailed")
	File(folder + "/Doubling.strict").Write(("has number", "Doubled Number", "	Doubling(2).Doubled is 6", "	number * 3"))
	if RunTests("test " + folder + "/Tripling.strict unit", Pooled).exitCode is not 0
		return Error("UnchangedCallerFailed")
	if RunTests("test " + folder + "/Sixfold.strict unit", Pooled).exitCode is 0
		return Error("StaleCacheSurvivedChange")
CheckBudget(folder Text)
	File(folder + "/TestWork.strict").Write(PauseLines)
	File(folder + "/OverBudget.strict").Write(("Delay Number", "	OverBudget.Delay is 1", "	TestWork.Pause"))
	overSource = folder + "/OverBudget.strict"
	CheckFail(RunTests("test " + overSource + " unit", Pooled), DeadlineName, "OverBudgetVm")
	if File(folder + "/obj/OverBudget.strictbinary").Exists
		return Error("FailedUnitWasCached")
	CheckFail(RunTests("build " + overSource, Pooled), DeadlineName, "OverBudgetBuild")
	CheckFail(RunTests("test " + overSource + " unit native", Pooled), DeadlineName, "OverBudgetNative")
	CheckSharedBudget(folder)
CheckSharedBudget(folder Text)
	sharedSource = folder + "/SharedBudget.strict"
	File(sharedSource).Write(SharedBudgetCode)
	CheckPass(RunTests("test " + sharedSource + " unit", Pooled), "", "SharedVm")
	CheckPass(RunTests("test " + sharedSource + " unit native", Pooled), "", "SharedNative")
CheckLazy(folder Text)
	File(folder + "/LazyFixture.strict").Write(LazyHead + LazyTail)
	lazy = RunTests("test " + folder + "/LazyFixture.strict unit", Pooled)
	if lazy.exitCode is not 0 or lazy.Output.Split("fixture computed").Length is not 2
		return Error("LazyFixtureCountWrong: " + lazy.Output)
	if lazy.Output.IndexOf(PassedLine) >= lazy.Output.IndexOf("fixture computed")
		return Error("FixtureInitializedTooEarly: " + lazy.Output)
	File(folder + "/SetupBudget.strict").Write(SetupBudgetCode)
	CheckFail(RunTests("test " + folder + "/SetupBudget.strict unit", Pooled), DeadlineName, "SetupBudget")
	CheckHangs(folder)
CheckHangs(folder Text)
	hangs = folder + "/Hangs.strict"
	File(hangs).Write(HangLines)
	CheckFail(RunTests("test " + hangs + " unit", Pooled), DeadlineName, "HangsVm")
	CheckFail(RunTests("test " + hangs + " unit native", Pooled), DeadlineName, "HangsNative")
	CheckFail(RunTests("check " + folder, Pooled), DeadlineName, "HangsCheck")
CheckPolicy(folder Text)
	File(folder + "/Policy.strict").Write(PolicyHead + PolicyMid + PolicyTail)
	source = folder + "/Policy.strict"
	unit = RunTests("test " + source + " unit", Pooled)
	if unit.exitCode is not 0 or "manual fixture" is in unit.Output
		return Error("UnitRanSlowTest: " + unit.Output)
	CheckPass(RunTests("test " + source, Pooled), "manual fixture", "ExplicitSlow")
	selected = RunTests("test " + source + " Quick", Pooled)
	if selected.exitCode is not 0 or "manual fixture" is in selected.Output
		return Error("SelectedRanSlowTest: " + selected.Output)
	CheckPolicyRun(source)
CheckPolicyRun(source Text)
	ran = RunTests(source, Pooled)
	if ran.exitCode is not 0 or ran.Output.IndexOf("manual fixture") >= ran.Output.IndexOf("application")
		return Error("ManualRunOrderWrong: " + ran.Output)
	unitNat = RunTests("test " + source + " unit native", Pooled)
	slowNat = RunTests("test " + source + " native Value", Pooled)
	badUnit = unitNat.exitCode is not 0 or "manual fixture" is in unitNat.Output
	if badUnit or slowNat.exitCode is not 0 or "manual fixture" is not in slowNat.Output
		return Error("NativeSlowSelectionWrong")
CheckWaiting(folder Text)
	waitSource = folder + "/Waiting.strict"
	File(waitSource).Write(WaitLines)
	CheckPass(RunTests("test " + waitSource + " unit", Pooled), "", "WaitingVm")
	CheckPass(RunTests("test " + waitSource + " unit native", Pooled), "", "WaitingNative")
	broken = RunTests("test Runtime/broken unit", Pooled)
	if "All tests passed in Runtime/broken/Fine.strict" is not in broken.Output
		return Error("BrokenFileStoppedFolder: " + broken.Output)
	CheckFail(broken, "LoopBodyMissing", "BrokenFile")
CheckProbe
	File(ProbePath).Write(ProbeLines)
	unitRes = RunTests("test " + ProbePath + " unit", Pooled)
	natRes = RunTests("test " + ProbePath + " unit native", Pooled)
	full = RunTests("test " + ProbePath, Pooled)
	File(ProbePath).Delete
	File("Bytecode/obj/PolicyProbe.strictbinary").Delete
	badUnit = unitRes.exitCode is not 0 or "Test passed" is not in unitRes.Output
	if badUnit or natRes.exitCode is not 0 or "Test passed" is in natRes.Output
		return Error("InternalTestedAutomatically")
	CheckPass(full, "Test passed: PolicyProbe.Delay", "ExplicitInternalProbe")
ProbeLines Texts
	for WaitLines
		value.Replace("Waiting", "PolicyProbe").Replace("0.04", "0.15")
CheckShares(folder Text)
	isWin = Process.OperatingSystem is "Windows"
	tool = isWin then "cmd" else "sh"
	line = isWin then "/c echo %STRICT_THREADS%" else "-c 'echo $STRICT_THREADS'"
	callLine = "	for Process.RunTools(\"" + tool + "\", (\"" + line + "\", \"" + line + "\"))"
	sharesCode = ("has logger", "Run Number", callLine, "		logger.Log(\"threads \" + value.Output.Trim)", "	0")
	File(folder + "/Shares.strict").Write(sharesCode)
	shared = RunTests(folder + "/Shares.strict", NoThreads)
	if shared.exitCode is not 0 or SharedCount(shared.Output) is not 2
		return Error("ToolSharesWrong: " + shared.Output)
	kept = RunTests(folder + "/Shares.strict", Pooled)
	if kept.exitCode is not 0 or kept.Output.Split("threads 8").Length is not 3
		return Error("ExplicitThreadsNotKept: " + kept.Output)
	CheckDeadline(folder)
CheckDeadline(folder Text)
	File(folder + "/Loops.strict").Write(LoopLines)
	looped = RunTests("test " + folder + "/Loops.strict Spin", ShortDeadline)
	marker = folder + "/alive.txt"
	child = Process.OperatingSystem is "Windows" then WindowsChild + marker + "\")" else LinuxChild + marker + "'\")"
	File(folder + "/Orphan.strict").Write("result = Process.RunTool(" + child + "\nlogger.Log(result.exitCode to Text)")
	parent = RunTests("run " + folder + "/Orphan.strict", ShortDeadline)
	Process.Wait(8)
	if File(marker).Exists
		return Error("ChildOutlivedParent: " + parent.Output)
	CheckFail(looped, "ran past its limit of 2 s", "LoopingTestWithoutDeadline")
SharedCount(output Text) Number
	mutable count = 0
	for output.Lines
		if value.StartsWith("threads ") and value.Substring(8) to Number >= 2
			count = count + 1
	count
RunTests(arguments Text, variables Texts) ProcessResult
	win = Process.OperatingSystem is "Windows"
	exe = "\"" + Process.Find("strict").executable + "\" "
	cmd = variables(win then 0 else 1) + exe + arguments
	Process.RunTool(win then "cmd" else "sh", win then "/c " + cmd else "-c \"" + cmd + "\"", ToolSeconds)
CheckPass(res ProcessResult, needle Text, tag Text)
	if res.exitCode is not 0 or needle is not "" and needle is not in res.Output
		return Error(tag + " failed: " + res.Output + res.error)
CheckFail(res ProcessResult, needle Text, tag Text)
	if res.exitCode is 0 or needle is not in (res.Output + res.error)
		return Error(tag + " unexpectedly passed: " + res.Output + res.error)
