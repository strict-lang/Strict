constant ToolSeconds = 90
constant ProbePath = "Bytecode/PolicyProbe.strict"
constant DeadlineName = "TestDurationMustNotExceedTwoHundredMilliseconds"
constant PauseLines = ("constant Seconds = 0.25", "Pause Number", "	let started = Process.Elapsed", "	mutable count = 0", "	for as long as Process.Elapsed - started < Seconds", "		count = count + 1", "	count > 0 then 1 else 0")
constant LazyHead = ("has logger", "constant Shared = Created", "Created Text", "	logger.Log(\"fixture computed\")", "	\"seven\"")
constant LazyTail = ("Check Text", "	LazyFixture.Check is \"seven\"", "	Shared is \"seven\"", "	Shared + Shared is \"sevenseven\"", "	false then Shared else \"seven\"")
constant SharedBudgetCode = ("constant Shared = TestWork.Pause", "Check Number", "	SharedBudget.Shared is 1", "	1")
constant SetupBudgetCode = ("Check Number", "	constant sample = TestWork.Pause", "	sample is 1", "	1")
constant DoubleCode = ("has number", "Doubled Number", "	Doubling(2).Doubled is 4", "	number * 2")
constant TripleCode = ("has number", "Tripled Number", "	Tripling(0).Tripled is 0", "	number + Doubling(number).Doubled")
constant SixCode = ("has number", "Sixfolded Number", "	Sixfold(2).Sixfolded is 12", "	Tripling(number).Tripled * 2")
constant HangLines = ("Spin Number", "	Hangs.Spin is 1", "	mutable count = 0", "	for as long as Process.Elapsed >= 0", "		count = count + 1", "	count")
constant PolicyHead = ("has logger", "constant Fixture = Policy.Value + 1", "Run Number", "	logger.Log(\"application\")", "	0", "Value Number slow", "	Policy.Value is 7", "	let started = Process.Elapsed")
constant PolicyMid = ("	mutable count = 0", "	for as long as Process.Elapsed - started < 0.04", "		count = count + 1", "	logger.Log(\"manual fixture\")", "	count > 0 then 7 else 0")
constant PolicyTail = ("Quick Number", "	Policy.Quick is 3", "	3", "FixtureUsed Number slow", "	Policy.Fixture is 8", "	Fixture")
constant WaitLines = ("Delay Number", "	Waiting.Delay is 1", "	let started = Process.Elapsed", "	mutable count = 0", "	for as long as Process.Elapsed - started < 0.04", "		count = count + 1", "	count > 0 then 1 else 0")
constant PassedLine = "Test passed: LazyFixture.Check is \"seven\""
Run Number
	let folder = "Examples/TestPolicy" + 1000000.Random.Floor
	if Directory.Create(folder) is Error
		return Error("DirectoryNotCreated")
	let result = Checked(folder)
	Directory.Delete(folder)
	if result is Error
		return result
	logger.Log("Cached passes, unit deadlines, Slow selection, internal packages, Run order and shares passed")
	0
Checked(folder Text) Boolean
	let first = CheckDeps(folder) is Error then Error("DepsFailed") else CheckBudget(folder)
	if first is Error
		return first
	let second = CheckLazy(folder) is Error then Error("LazyFailed") else CheckPolicy(folder)
	if second is Error
		return second
	let third = CheckWaiting(folder) is Error then Error("WaitingFailed") else CheckProbe
	third is Error then third else CheckShares(folder)
CheckDeps(folder Text) Boolean
	File(folder + "/Doubling.strict").Write(DoubleCode)
	File(folder + "/Tripling.strict").Write(TripleCode)
	File(folder + "/Sixfold.strict").Write(SixCode)
	if Ran("test " + folder + "/Sixfold.strict unit").exitCode is not 0
		return Error("InitialDependencyChainFailed")
	File(folder + "/Doubling.strict").Write(("has number", "Doubled Number", "	Doubling(2).Doubled is 6", "	number * 3"))
	if Ran("test " + folder + "/Tripling.strict unit").exitCode is not 0
		return Error("UnchangedCallerFailed")
	Ran("test " + folder + "/Sixfold.strict unit").exitCode is 0 then Error("StaleCacheSurvivedChange") else true
CheckBudget(folder Text) Boolean
	File(folder + "/TestWork.strict").Write(PauseLines)
	File(folder + "/OverBudget.strict").Write(("Delay Number", "	OverBudget.Delay is 1", "	TestWork.Pause"))
	let overSource = folder + "/OverBudget.strict"
	let unit = CheckFail(Ran("test " + overSource + " unit"), DeadlineName, "OverBudgetVm")
	if unit is Error or File(folder + "/obj/OverBudget.strictbinary").Exists
		return Error("FailedUnitWasCachedOrPassed")
	let built = CheckFail(Ran("build " + overSource), DeadlineName, "OverBudgetBuild")
	let natCmd = "test " + overSource + " unit native"
	let nat = built is Error then built else CheckFail(Ran(natCmd), DeadlineName, "OverBudgetNative")
	nat is Error then nat else CheckSharedBudget(folder)
CheckSharedBudget(folder Text) Boolean
	let sharedSource = folder + "/SharedBudget.strict"
	File(sharedSource).Write(SharedBudgetCode)
	let vm = CheckPass(Ran("test " + sharedSource + " unit"), "", "SharedVm")
	vm is Error then vm else CheckPass(Ran("test " + sharedSource + " unit native"), "", "SharedNative")
CheckLazy(folder Text) Boolean
	File(folder + "/LazyFixture.strict").Write(LazyHead + LazyTail)
	let lazy = Ran("test " + folder + "/LazyFixture.strict unit")
	if lazy.exitCode is not 0 or lazy.Output.Split("fixture computed").Length is not 2
		return Error("LazyFixtureCountWrong: " + lazy.Output)
	if lazy.Output.IndexOf(PassedLine) >= lazy.Output.IndexOf("fixture computed")
		return Error("FixtureInitializedTooEarly: " + lazy.Output)
	File(folder + "/SetupBudget.strict").Write(SetupBudgetCode)
	let setup = CheckFail(Ran("test " + folder + "/SetupBudget.strict unit"), DeadlineName, "SetupBudget")
	setup is Error then setup else CheckHangs(folder)
CheckHangs(folder Text) Boolean
	let hangs = folder + "/Hangs.strict"
	File(hangs).Write(HangLines)
	let vm = CheckFail(Ran("test " + hangs + " unit"), DeadlineName, "HangsVm")
	let nat = vm is Error then vm else CheckFail(Ran("test " + hangs + " unit native"), DeadlineName, "HangsNative")
	nat is Error then nat else CheckFail(Ran("check " + folder), DeadlineName, "HangsCheck")
CheckPolicy(folder Text) Boolean
	File(folder + "/Policy.strict").Write(PolicyHead + PolicyMid + PolicyTail)
	let source = folder + "/Policy.strict"
	let unit = Ran("test " + source + " unit")
	if unit.exitCode is not 0 or "manual fixture" is in unit.Output
		return Error("UnitRanSlowTest: " + unit.Output)
	let full = CheckPass(Ran("test " + source), "manual fixture", "ExplicitSlow")
	let sel = Ran("test " + source + " Quick")
	if full is Error or sel.exitCode is not 0 or "manual fixture" is in sel.Output
		return Error("SelectedRanSlowTest: " + sel.Output)
	CheckPolicyRun(source)
CheckPolicyRun(source Text) Boolean
	let ran = Ran(source)
	if ran.exitCode is not 0 or ran.Output.IndexOf("manual fixture") >= ran.Output.IndexOf("application")
		return Error("ManualRunOrderWrong: " + ran.Output)
	let unitNat = Ran("test " + source + " unit native")
	let slowNat = Ran("test " + source + " native Value")
	let badUnit = unitNat.exitCode is not 0 or "manual fixture" is in unitNat.Output
	let bad = badUnit or slowNat.exitCode is not 0 or "manual fixture" is not in slowNat.Output
	bad then Error("NativeSlowSelectionWrong") else true
CheckWaiting(folder Text) Boolean
	let waitSource = folder + "/Waiting.strict"
	File(waitSource).Write(WaitLines)
	let unitRes = CheckPass(Ran("test " + waitSource + " unit"), "", "WaitingVm")
	unitRes is Error then unitRes else CheckPass(Ran("test " + waitSource + " unit native"), "", "WaitingNative")
CheckProbe Boolean
	File(ProbePath).Write(ProbeLines)
	let unitRes = Ran("test " + ProbePath + " unit")
	let natRes = Ran("test " + ProbePath + " unit native")
	let badUnit = unitRes.exitCode is not 0 or "Test passed" is in unitRes.Output
	let badNat = natRes.exitCode is not 0 or "Test passed" is in natRes.Output
	let passed = CheckPass(Ran("test " + ProbePath), "Test passed: PolicyProbe.Delay", "ExplicitInternalProbe")
	let res = badUnit or badNat then Error("InternalTestedAutomatically") else passed
	File(ProbePath).Delete
	File("Bytecode/obj/PolicyProbe.strictbinary").Delete
	res
ProbeLines Texts
	for WaitLines
		value.Replace("Waiting", "PolicyProbe").Replace("0.04", "0.15")
CheckShares(folder Text) Boolean
	let isWin = Process.OperatingSystem is "Windows"
	let tool = isWin then "cmd" else "sh"
	let line = isWin then "/c echo %STRICT_THREADS%" else "-c 'echo $STRICT_THREADS'"
	let callLine = "	for Process.RunTools(\"" + tool + "\", (\"" + line + "\", \"" + line + "\"))"
	let sharesCode = ("has logger", "Run Number", callLine, "		logger.Log(\"threads \" + value.Output.Trim)", "	0")
	File(folder + "/Shares.strict").Write(sharesCode)
	let shared = RanEnv(folder + "/Shares.strict", "")
	if shared.exitCode is not 0 or SharedCount(shared.Output) is not 2
		return Error("ToolSharesWrong: " + shared.Output)
	let kept = RanEnv(folder + "/Shares.strict", "8")
	let badKept = kept.exitCode is not 0 or kept.Output.Split("threads 8").Length is not 3
	badKept then Error("ExplicitThreadsNotKept: " + kept.Output) else true
SharedCount(output Text) Number
	mutable count = 0
	for output.Lines
		if value.StartsWith("threads ") and value.Substring(8) to Number >= 2
			count = count + 1
	count
Ran(arguments Text) ProcessResult
	RanEnv(arguments, "8")
RanEnv(arguments Text, threads Text) ProcessResult
	let win = Process.OperatingSystem is "Windows"
	let winEnv = threads is "" then "set STRICT_THREADS=& " else "set STRICT_THREADS=" + threads + "&& "
	let nixEnv = threads is "" then "env -u STRICT_THREADS " else "STRICT_THREADS=" + threads + " "
	let exe = "\"" + Process.Current.executable + "\" "
	let cmd = (win then winEnv else nixEnv) + exe + arguments
	Process.RunTool(win then "cmd" else "sh", win then "/c " + cmd else "-c \"" + cmd + "\"", ToolSeconds)
CheckPass(res ProcessResult, needle Text, tag Text) Boolean
	let bad = res.exitCode is not 0 or needle is not "" and needle is not in res.Output
	bad then Error(tag + " failed: " + res.Output + res.error) else true
CheckFail(res ProcessResult, needle Text, tag Text) Boolean
	let bad = res.exitCode is 0 or needle is not in (res.Output + res.error)
	bad then Error(tag + " unexpectedly passed: " + res.Output + res.error) else true
