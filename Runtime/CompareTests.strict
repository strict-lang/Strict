has logger
Run
	constant left = VmInstruction.LoadConstant(0, 5)
	constant right = VmInstruction.LoadConstant(1, 5)
	constant eq = VmInstruction.BinaryOp("Equal", 0, 1, 2)
	constant ret = VmInstruction.ReturnOp(2)
	constant ops = InstrList.Empty.Append(left).Append(right).Append(eq).Append(ret)
	constant state = VirtualMachine(ops).Run
	logger.Log(state.returnValue)