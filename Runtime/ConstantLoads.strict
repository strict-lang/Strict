has types List(TypeEntry)
has first Number
constant Cached = 8
constant Stored = InstructionEntry(InstructionType.StoreConstantToVariable, ("Strict/List(Number)", "a"), (6, -1, 1, 1, 2, -1, 0))
constant Both = MethodEntry("Both", List(MemberEntry), "Strict/List(Number)", (PayloadDecoder.Ones.entry, Stored, InstructionEntry.Return(0)))
constant Late = MethodEntry("Late", List(MemberEntry), "None", (InstructionEntry.LoadNumber(0, 7), PayloadDecoder.Ones.entry))
constant Ones = ConstantLoads(List(TypeEntry) + TypeEntry("Strict/Ones", List(MemberEntry), List(MethodEntry) + Constants.OnesMethod), 3)
constant Pair = ConstantLoads((TypeEntry("Strict/Ones", List(MemberEntry), (Constants.OnesMethod, Both)), TypeEntry("Strict/Twos", List(MemberEntry), List(MethodEntry) + Both)), 3)
Rewritten List(TypeEntry)
	Ones.Rewritten.First.methods.First.instructions.First.payload.Slice(0, 4) is (0, Cached, 3, 6)
	Ones.Rewritten.First.methods.First.instructions.Last is InstructionEntry.Return(0)
	Pair.Rewritten(1).methods.First.instructions(1).payload is (Cached, 7) + Stored.payload
	mutable next = first
	mutable rewritten = List(Mutable(TypeEntry))
	for types
		count = Count(value)
		rewritten.Add(count is 0 then value else TypeEntry(value, methods = Methods(value, next)))
		next = next + count
	rewritten
Methods(type TypeEntry, start Number) List(MethodEntry)
	Pair.Methods(Pair.types.First, 3)(1).instructions(1).payload(1) is 5
	mutable next = start
	mutable methods = List(Mutable(MethodEntry))
	for type.methods
		count = CountLoads(value)
		methods.Add(count is 0 then value else MethodEntry(value, instructions = Instructions(value, next)))
		next = next + count
	methods
Instructions(method MethodEntry, start Number) List(InstructionEntry)
	Ones.Instructions(Both, 4)(1).payload(1) is 5 and Ones.Instructions(Both, 4).Last is InstructionEntry.Return(0)
	Ones.Instructions(Late, 4)(1).payload(2) is 4
	mutable next = start
	mutable instructions = List(Mutable(InstructionEntry))
	for method.instructions
		at = At(value)
		instructions.Add(at < 0 then value else Mark(value, at, next))
		next = at < 0 then next else next + 1
	instructions
Mark(entry InstructionEntry, at Number, index Number) InstructionEntry
	Ones.Mark(Stored, 0, 4).payload is (Cached, 4) + Stored.payload
	rest = entry.payload.Slice(at, entry.payload.Length - at)
	InstructionEntry(entry, payload = entry.payload.Slice(0, at) + Cached + index + rest)
Decoded List(VmValue)
	Ones.Decoded.First to Text is "(1, 1.5)"
	Pair.Decoded.Length is 5 and Pair.Decoded(4) to Text is "(2)"
	for type, method, entry in types, type.methods, method.instructions
		if At(entry) >= 0
			PayloadDecoder(entry).Value(At(entry))
Count(type TypeEntry) Number
	Pair.Count(Pair.types.First) is 3
	mutable count = 0
	for type.methods
		count = count + CountLoads(value)
	count
CountLoads(method MethodEntry) Number
	Ones.CountLoads(Both) is 2 and Ones.CountLoads(Machine.TwiceMethod) is 0
	mutable count = 0
	for method.instructions
		count = At(value) < 0 then count else count + 1
	count
At(entry InstructionEntry) Number
	Ones.At(PayloadDecoder.Ones.entry) is 1 and Ones.At(Stored) is 0
	Ones.At(InstructionEntry.LoadNumber(0, 7)) is -1 and Ones.At(InstructionEntry.Return(6)) is -1
	Ones.At(InstructionEntry(InstructionType.Return, List(Text), List(Number))) is -1
	isLoad = entry.kind is InstructionType.LoadConstantToRegister
	at = isLoad then 1 else (entry.kind is InstructionType.StoreConstantToVariable then 0 else -1)
	at < 0 then Number.NotFound else (entry.payload(at) is in (3, 6) then at else Number.NotFound)
