has root Text = ""
mutable idleRam Number = 0
mutable idleVram Number = 0
mutable seenAt Number = -100
mutable wantsFree Boolean = false
mutable busyJob Text = ""
mutable busyLabel Text = ""
mutable isEnding Boolean = false
mutable busyVram Number = 0
constant LockNeed = 2147483648
constant LockHeld = 1073741824
constant StaleSeconds = 16
constant BeatSeconds = 5
constant NoSocket = 0
constant NoReply = ""
constant Sample = Coordinator
Place Text
	Coordinator("Compiler/output/coord").Place is "Compiler/output/coord"
	Coordinator.Place.EndsWith("/coordinator")
	if root is not ""
		return root
	home = Process.Variable(Process.OperatingSystem is "Windows" then "LOCALAPPDATA" else "HOME")
	home + (Process.OperatingSystem is "Windows" then "/Strict" else "/.cache/strict") + "/coordinator"
Opened Number
	Coordinator("Compiler/output/coord").Opened > 0
	server = Socket.Local(Peers.Port)
	bound = server is Error then Socket.Local(0) else server
	if bound is Error
		return bound
	Directory.Create(Path(Place).PathOnly.text)
	File(Place).Write(Socket.Port(bound) to Text)
	bound
Serve
	Sample.Take(0) is 0
	server = Opened
	if server is Error
		return server
	mutable idle = Process.Elapsed
	for as long as isEnding is false and Process.Elapsed - idle < Resident.IdleSeconds
		socket = Take(server)
		if socket > 0
			idle = HasReplied(socket) then Process.Elapsed else idle
			Socket.Close(socket)
	File(Place).Delete
	Socket.Close(server)
Take(server Number) Number
	Sample.Take(0) is 0
	waiting = Socket.Waiting(server, 1)
	waiting is Error or waiting is not 1 then 0 else Socket.Accept(server)
HasReplied(socket Number) Boolean
	Sample.Chosen(("hello", "a", "1", "b", "0")) is "ok"
	words = Resident("").Receive(socket, "\n").Trim.Split("\t")
	isEnding = words(0) is "exit" and (busyJob is "" or words.Last is busyJob)
	answer = words(0) is "exit" then (isEnding then "ok" else "busy") else Chosen(words)
	if Resident("").Send(socket, answer + "\n") is Error
		logger.Log("The client left before the result was sent")
	busyJob is not "" or Process.Elapsed - seenAt < StaleSeconds
Chosen(words Texts) Text
	Sample.Chosen("status") is "busy\t\t"
	Coordinator(busyLabel = "H3Image").Chosen("status") is "busy\t\t"
	if words.Length > 0 and words(0) is "holding"
		return Hold(words)
	if words.Length > 0 and (words(0) is "done" or JobCancel.Matches(words, busyJob))
		return Finish(words(0))
	if words.Length > 0 and words(0) is "need"
		return Admit(Need.Parsed(words), Seen)
	busy = "busy\t" + busyJob + "\t" + (busyJob is "" then "" else busyLabel)
	words.Length > 0 and words(0) is "status" then busy else RemoteRun.AnswerWords(words, Seen)
Finish(word Text) Text
	Coordinator(busyJob = "video", busyLabel = "H3Image").Finish("done") is "ok"
	wantsFree = word is not "done"
	busyJob = ""
	busyLabel = ""
	busyVram = 0
	seenAt = Process.Elapsed
	wantsFree then "free" else "ok"
Launcher(current Text) Text
	Sample.Launcher("C:/Release/Ben.exe") is Process.Find("strict").executable
	strict = Process.Find("strict")
	strict.IsAvailable then strict.executable else current
Hold(words Texts) Text
	Sample.Grant(("need", "job", "label", "4", "8", "2", "4", "0", "wait"), MachineView.Wide) is "go\tjob\t0"
	Coordinator(busyJob = "video", busyVram = LockNeed + 1).Hold(("holding", "0", LockHeld to Text)) is "free"
	Coordinator(busyJob = "video", busyVram = LockNeed).Hold(("holding", "0", LockHeld to Text)) is "ok"
	idleRam = words.Length > 1 then words(1) to Number else 0
	idleVram = words.Length > 2 then words(2) to Number else 0
	seenAt = Process.Elapsed
	isBlocking = busyJob is not "" and busyVram > LockNeed and idleVram >= LockHeld
	if (wantsFree or isBlocking) and (busyLabel is "exit" or idleRam > 0 or idleVram > 0)
		return busyLabel is "exit" then "exit" else "free"
	"ok"
Admit(need Need, seen MachineView) Text
	verdict = Admission.Verdict(need, seen)
	if verdict is "go"
		busyJob = need.job
		busyLabel = need.label
		busyVram = need.Vram
		wantsFree = false
		return "go\t" + need.job + "\t" + need.threads
	wantsFree = verdict is "free" or verdict is "refused" and Process.Elapsed - seenAt < StaleSeconds
	busyLabel = verdict is "refused" and wantsFree then "exit" else busyLabel
	refusal = "refused\t" + need.job + "\t"
	waiting = "wait\t" + need.job + "\t1\t" + need.label + "\t0\t0"
	verdict is "refused" and wantsFree is false then refusal + Admission.Reason(need, seen) else waiting
Grant(words Texts, seen MachineView) Text
	Sample.Grant(("need", "job", "label", "4", "8", "2", "4", "0", "wait"), MachineView.Wide) is "go\tjob\t0"
	mutable sample = Coordinator
	isHeld = sample.Hold(("holding", "4", "2")) is "ok" and sample.idleRam is 4
	isHeld then sample.Admit(Need.Parsed(words), seen) else "bad"
Seen MachineView slow
	Sample.Seen.freeRam >= 0
	video = MachineView.Vram("")
	idle = Process.Elapsed - seenAt < StaleSeconds then idleRam else 0
	device = Process.Elapsed - seenAt < StaleSeconds then idleVram else 0
	freeRam = MachineView.Force("STRICT_MACHINE_RAM", GpuMemory.HostAvailable)
	totalRam = MachineView.Force("STRICT_MACHINE_RAM", GpuMemory.HostTotal)
	MachineView(freeRam, video(1), totalRam, video(0), idle, device, busyJob is not "")
Send(line Text, isStarting = true) Text
	Coordinator("Compiler/output/MissingCoordinator").Send("status") is ""
	Coordinator("Compiler/output/MissingCoordinator").Send("exit\tH3Video", false) is ""
	socket = root is "" and isStarting then Linked else Connected
	if socket is NoSocket
		return NoReply
	if Resident("").Send(socket, line + "\n") is Error
		Socket.Close(socket)
		return NoReply
	reply = Resident("").Receive(socket, "\n")
	Socket.Close(socket)
	reply is Error then NoReply else reply.Trim
Resolve(line Text) Text
	Coordinator("Compiler/output/MissingCoordinator").Resolve("need") is ""
	mutable reply = Send(line)
	if reply.StartsWith("wait")
		logger.Log("Waiting for other programs to finish or to free the memory this run needs")
	for as long as reply.StartsWith("wait")
		Process.Wait(1)
		again = Send(line)
		reply = again is NoReply then Send(line) else again
	reply
Connected Number
	Coordinator("Compiler/output/MissingCoordinator").Connected is 0
	port = File(Place).Exists then File(Place).ReadLines.First to Number else 0
	if port is Error or port is 0
		return NoSocket
	socket = Socket.Connect("127.0.0.1", port)
	socket is Error then NoSocket else socket
Linked Number
	Coordinator("Compiler/output/MissingCoordinator").Connected is 0
	existing = Connected
	if existing is not NoSocket
		return existing
	for Range(0, Process(Launcher(Process.Current.executable)).Launch("coordinator") > 0 then BeatSeconds else 0)
		if File(Place).Exists
			return Connected
		Process.Wait(1)
	NoSocket
Report
	Coordinator("Compiler/output/MissingCoordinator").Report is not Error
	reply = Send("status")
	logger.Log(reply is NoReply then "No coordinator" else reply)
