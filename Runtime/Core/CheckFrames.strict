constant SourceHead = ("has logger", "Run Number", "	let method = MethodEntry(Frame.Twice.method, Slots = 32)", "	let started = Process.Elapsed")
constant SourceLoop = ("	for 10000", "		let slots = Frame.Doubling.Bound(Machine.Doubler, VmValue.OfNumber(index), method, List(VmValue), VmValue.None)")
constant SourceCheck = ("		if (slots.Length is not 32) or (slots.First.number is not index)", "			return 1", "	let elapsed = Process.Elapsed - started")
constant SourceTail = ("	logger.Log(\"Initialized 10,000 frames in \" + elapsed * 1000 + \" ms\")", "	elapsed < 0.02 then 0 else 2")
Run Number
	folder = "Examples/FrameCheck" + 1000000.Random.Floor
	result = Check(folder)
	Directory.Delete(folder)
	result is Error then result else 0
Check(folder Text) slow
	source = folder + "/FrameBudget.strict"
	extension = Process.OperatingSystem is "Windows" then ".exe" else ""
	if Directory.Create(folder) is Error
		return Error("DirectoryNotCreated")
	File(source).Write(SourceHead + SourceLoop + SourceCheck + SourceTail)
	built = Process.RunTool("strict", "build " + source)
	if built.exitCode is not 0
		return Error(built.Output + built.error)
	ran = Process.RunTool(folder + "/FrameBudget" + extension, "")
	logger.Log(ran.Output.Trim)
	if ran.exitCode is not 0
		return Error("FrameBudgetFailed: " + ran.exitCode + "\n" + ran.Output + ran.error)

