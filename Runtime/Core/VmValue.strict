has kind Text
has number
has text
has items List(VmValue)
constant None = VmValue("None", 0, "", List(VmValue))
constant TrueValue = VmValue("Boolean", 1, "", List(VmValue))
constant FalseValue = VmValue("Boolean", 0, "", List(VmValue))
constant EmptyList = VmValue("List", 0, "", List(VmValue))
constant ErrorKinds = ("Strict/Error", "Strict/ErrorWithValue")
constant Failed = VmValue("Strict/Error", 0, "", (OfText("x"), OfList(List(VmValue) + VmValue("Strict/Stacktrace", 0, "", (OfText("B.C"), OfText("B.strict"), OfNumber(7))))))
constant AnyError = VmValue("Strict/Error", 0, "", (OfText(""), OfList(List(VmValue))))
constant Numbered = VmValue("Strict/List(Number)", 0, "", (OfNumber(5), OfNumber(6)))
constant SmallNumbers = Integers
OfNumber(amount Number) VmValue
	OfNumber(3).number is 3
	OfNumber(2.5).number is 2.5
	Allocations.OfNumber(1023) < Allocations.OfNumber(1024)
	IsSmall(amount) then SmallNumbers(amount) else VmValue("Number", amount, "", List(VmValue))
IsSmall(amount Number) Boolean
	IsSmall(0) and IsSmall(1023)
	IsSmall(1024) is false
	IsSmall(-1 / (1 / 0))
	IsSmall(-3) is false
	IsSmall(2.5) is false
	amount < 1024 and amount >= 0 and amount % 1 is 0
Integers List(VmValue)
	VmValue.Integers(1023).number is 1023
	for 1024
		VmValue("Number", index, "", List(VmValue))
OfText(content Text) VmValue
	OfText("a").text is "a"
	VmValue("Text", 0, content, List(VmValue))
OfBoolean(condition Boolean) VmValue
	OfBoolean(true).IsTrue
	OfBoolean(false).IsTrue is false
	condition then TrueValue else FalseValue
OfList(elements List(VmValue)) VmValue
	OfList(OfNumber(1), OfNumber(2)).items.Length is 2
	VmValue("List", 0, "", elements)
OfError(name Text) VmValue
	OfError("Missing").items.First.text is "Missing"
	OfError("M").kind is "Strict/Error" and OfError("M").items.Length is 2
	VmValue("Strict/Error", 0, "", (OfText(name), OfList(List(VmValue))))
CountMatches(arguments List(VmValue)) Number
	OfList(OfNumber(1), OfNumber(2), OfNumber(1)).CountMatches(List(VmValue) + OfNumber(1)) is 2
	OfList(OfNumber(1)).CountMatches(List(VmValue)) is 1
	if arguments.Length is 0
		return Length
	for items
		if value is arguments.First
			1
Member(index Number) VmValue
	OfText("ab").Member(0).text is "ab"
	VmValue("Strict/Shape", 0, "", List(VmValue) + OfNumber(3)).Member(0).number is 3
	None.Member(1).kind is "None"
	OfNumber(3).Member(0).number is 3
	Numbered.Member(1).items.Length is 2
	if kind is in ("Text", "Number", "Boolean", "List") or kind.StartsWith("Strict/List(")
		return value
	isBase = TypeEntry.Base(kind) is in ("Text", "Number", "Boolean", "List")
	isBase then value else index < items.Length then items(index) else None
As(typeName Text) VmValue
	OfText("a").As("Strict/Number").number is 97 and OfList(OfText("c")).As("Strict/Number").items.Length is 1
	OfNumber(98).As("Strict/Character").text is "b" and OfNumber(5).As("Strict/Text").number is 5
	OfText("ab").As("Strict/List(Character)").text is "ab" and OfText("ab").As("Strict/Character").text is "ab"
	OfText("ab").As("Strict/Number").text is "ab" and VmValue("N", 0, "a", None.items).As("Strict/Number").number is 0
	OfList(OfText("c"), OfText("b")).As("Strict/Text").text is "cb" and OfText("a").As("Strict/Text").number is 0
	if kind is "Number"
		return typeName is in ("Strict/Character", "Character") then OfText(Character(number) to Text) else value
	if kind is "Text" and text.Length is 1
		return typeName is in ("Strict/Number", "Number") then OfNumber(Character(text).number) else value
	kind is "List" and typeName is in ("Strict/Text", "Text") then OfText(Concatenated) else value
IsTrue Boolean
	OfBoolean(false).IsTrue is false
	number is 1
Length Number
	OfText("abc").Length is 3
	OfList(OfNumber(1), OfNumber(2)).Length is 2
	kind is "Text" then text.Length else items.Length
to Text
	OfNumber(2.5) to Text is "2.5"
	OfBoolean(true) to Text is "true" and OfBoolean(false) to Text is "false"
	OfText("a") to Text is "a" and VmValue("P", 0, "", List(VmValue) + OfText("b")) to Text is "(b)"
	OfList(OfNumber(1), OfNumber(2)) to Text is "(1, 2)" and OfList(List(VmValue)) to Text is ""
	if kind is "Number"
		return number to Text
	if kind is "Boolean"
		return IsTrue then "true" else "false"
	kind is "List" then Joined else kind is in ("Text", "None") then text else Automatic
Joined Text
	OfList(OfNumber(1), OfNumber(2)).Joined is "(1, 2)"
	OfList(List(VmValue) + OfNumber(5)).Joined is "(5)"
	OfList(List(VmValue)).Joined is ""
	if items.Length is 0
		return ""
	mutable result = "(" + items(0) to Text
	for Range(1, items.Length)
		result = result + ", " + items(value) to Text
	result + ")"
Concatenated Text
	OfList(OfText("a"), OfText("b")).Concatenated is "ab"
	mutable result = ""
	for items
		result = result + value.text
	result
Automatic Text
	VmValue("Strict/Process", 0, "", List(VmValue) + OfText("a") + None).Automatic is "(a)"
	Failed.Automatic is "Error: x\n\tat B.C in B.strict:line 7"
	VmValue("P", 0, "", (OfText("a"), OfText("b"))).Automatic is "(a, b)"
	if kind is "Strict/Error"
		return "Error: " + items(0).text + Traces
	mutable result = ""
	for items
		if value.kind is not "None"
			shown = value to Text
			result = result is "" then shown else result + ", " + shown
	"(" + result + ")"
Traces Text
	Failed.Traces is "\n\tat B.C in B.strict:line 7"
	Failed.items(1).items.First.kind is "Strict/Stacktrace"
	OfList(None, OfList(None.items + OfList(OfText(""), OfText(""), OfNumber(3)))).Traces is "\n\t... (skipped 3 lines)"
	mutable result = ""
	for items(1).items
		file = value.items(1).text
		line = value.items(2).number
		at = "at " + value.items(0).text + " in " + file + ":line " + line
		result = result + "\n\t" + (file is "" then "... (skipped " + line + " lines)" else at)
	result
