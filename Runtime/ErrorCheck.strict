has entry Bytecode/InstructionEntry
constant Returning = ErrorCheck(InstructionEntry(InstructionType.CheckError, List(Text), List(Number) + 0, 0, 0))
constant Testing = ErrorCheck(InstructionEntry(InstructionType.CheckError, List(Text) + "tested", (0, 7, 8, 12)))
Next(position Number, checked VmValue, length Number) Number
	Returning.Next(3, VmValue.Failed, 10) is 10
	Testing.Next(3, VmValue.Failed, 10) is 12
	Returning.Next(3, VmValue.OfNumber(1), 10) is 4
	ErrorCheck(InstructionEntry.Return(0)).Next(3, VmValue.Failed, 10) is 4
	if entry.kind is not InstructionType.CheckError or checked.kind is not in VmValue.ErrorKinds
		return position + 1
	entry.texts.Length is 0 then length else entry.payload.Last
Value(checked VmValue, target VmValue, frame Frame, position Number) VmValue
	Returning.Value(VmValue.Failed, VmValue.Failed, Frame.Twice, 0).kind is "Strict/Error"
	Returning.Value(VmValue.OfNumber(1), VmValue.OfNumber(1), Frame.Twice, 0).number is 1
	if checked.kind is not in VmValue.ErrorKinds
		return target
	IsTracedIn(checked, frame) then checked else frame.Trace(checked, position, List(VmValue))
IsTracedIn(error VmValue, frame Frame) Boolean
	Returning.IsTracedIn(Frame.Twice.Trace(VmValue.OfError("a"), 0, List(VmValue)), Frame.Twice)
	Returning.IsTracedIn(VmValue.OfError("a"), Frame.Twice) is false
	traces = (error.kind is "Strict/ErrorWithValue" then error.items(0) else error).items(1).items
	if traces.Length is 0
		return false
	name = TypeEntry.ShortName(frame.owner) + "." + frame.method.Name
	traces.Last.items(0).text is name or traces.Last.items(0).text.StartsWith(name + "(")