has selection Text = ""
has isRecursive Boolean = true
has isMutating Boolean = false
has part Text = ""
has isFull Boolean = false
has known Dictionary(Text, TypeEntry) = Dictionary(Text, TypeEntry)
has cached Dictionary(Text, VmValue) = Dictionary(Text, VmValue)
has quietUntil Number = 0
has inferred InferenceCache = InferenceCache.None
has trial TrialMachine = TrialMachine.None
constant Adder = BinaryFile("./Examples/NativeAdd/Adder.strict")
constant AdderFiles = SourceFiles(".").Of(Adder.source)
constant Unstamped = BinarySources(List(Text))
Run(arguments Texts) Number
	paths = List(Text) + arguments(0)
	failed = Failures(paths, Stale(paths), arguments(1), true)
	if failed > 0
		return failed
	types = Load(arguments(0), arguments(1), false)
	if HasRun(types.First) is false
		logger.Log(Summary(0, arguments(0)))
		return 0
	mutable texts = List(Mutable(VmValue))
	for Range(2, arguments.Length)
		texts.Add(VmValue.OfText(arguments(value)))
	Start(types, arguments(0)).IsCompleted(types.First.Name, texts) then 0 else 1
Test(path Text, root Text, isQuiet = false, sources Texts = List(Text)) Number
	Execute.Test("Missing.strict", ".") is 1
	if File(path).Exists and Directory.Exists(path) is false
		return Failures(path, Stale(path), root, isQuiet, sources)
	Directory.Exists(path) then Folders.TestFolder(path, root, isRecursive, isMutating, isFull) else 1
Failures(paths Texts, stale Texts, root Text, isQuiet Boolean, sources Texts = List(Text)) Number
	files = Source(stale, root, sources)
	types = ResolveCheck.Inference(files)
	mutable host = value
	mutable failed = 0
	for paths
		hit = value is in stale then Answer(0, known) else Answer(Cache(value), known)
		got = value is in stale then host.Verify(value, root, isQuiet, files, types, stale.Length is 1) else hit
		host = value is in stale then Execute(host, known = got.known) else host
		if got.code is 0 and isQuiet is false and quietUntil is 0
			logger.Log(Summary(0, value))
		failed = failed + got.code
	failed
Cache(path Text) Number
	Execute.Cache("Missing.strict") is 0
	Execute(isMutating = true).Cache("Missing.strict") is 0
	cache = MutationCache(path)
	if isMutating is false or cache.IsCurrent is false
		return 0
	for cache.Survivors
		logger.Log(value)
	cache.Survivors.Length
Source(stale Texts, root Text, sources Texts) Texts
	Execute.Source(List(Text), ".", List(Text) + "A.strict").Length is 0
	Execute.Source(List(Text) + "Examples/Sum.strict", ".", List(Text) + "A.strict") is ("A.strict")
	"./Examples/Sum.strict" is in Execute.Source(List(Text) + "Examples/Sum.strict", ".", List(Text))
	if stale.Length is 0 or sources.Length > 0
		return stale.Length is 0 then List(Text) else sources
	SourceFiles(root).Of(FileCompiler.Normalize(stale.First), stale)
Stale(paths Texts) Texts
	if selection is not "" and selection is not "*"
		return paths
	for paths
		cache = BinaryFile(FileCompiler.Normalize(value))
		entries = cache.Unpack(File(cache.Path).ReadBytes)
		isCurrent = IsEdited(value) is false and cache.IsFresh(entries) and BinaryLinks(cache).IsTested(entries)
		if isCurrent is false or selection is "*" and SlowTests.IsPassed(value) is false
			value
IsEdited(path Text) Boolean
	Execute.IsEdited("Execute.strict") is false
	Execute.IsEdited("Missing.strict") is false
	source = FileCompiler.Normalize(path)
	File(source).Exists and File(source).Modified is 0
Keep(path Text, root Text) Number
	Execute.Keep("Missing.strict", ".") is 1
	if File(path).Exists is false
		return 1
	files = SourceFiles(root).Of(FileCompiler.Normalize(path))
	Verify(path, root, true, files, ResolveCheck.Inference(files), true, false).code
Serve(path Text, root Text, isQuiet = false, sources Texts = List(Text)) Answer
	Execute.Serve("Missing.strict", ".").code is 1
	Execute.Serve("Missing.strict", ".", true).Types.Length is 0
	isFile = File(path).Exists and Directory.Exists(path) is false and selection is in ("", "*")
	if isFile then Stale(path).Length is 0 else true
		return Answer(Test(path, root, isQuiet, sources), known)
	files = Source(path, root, sources)
	joined = inferred.Of(files, FileCompiler.Normalize(path))
	answer = Verify(path, root, isQuiet, files, joined.Result.joined, true)
	if answer.code is 0 and isQuiet is false and quietUntil is 0
		logger.Log(Summary(0, path))
	Answer(answer, inferred = joined)
Verify(path Text, root Text, isQuiet Boolean, files Texts, inference TypeInference, isOwn = false, isTested = true) Answer
	begun = Process.Elapsed
	cache = BinaryFile(FileCompiler.Normalize(path))
	linked = FileCompiler(isQuiet, selection).Build(path, root, true, files, inference, known)
	if linked is Error
		logger.Log(path + ": " + (linked to Text))
		return Answer(1, known)
	types = linked.entries
	if types.Length is 0
		return Answer(1, known)
	started = Process.Elapsed
	tested = isTested then TestTypes(types, path, isQuiet) else Answer(0, known, constants = cached)
	if tested.code is 0 and selection is "" and IsEdited(path) is false
		Store(cache, root, files, linked.linker.Sourced, isOwn, linked)
	survived = tested.code is 0 and isTested then Mutate(types, path, root, files, inference, started) else 0
	BuildProfile.Report("Verified " + path, begun)
	Answer(tested.code + survived, linked.Known(known), files = files, Types = types, constants = tested.constants)
Store(cache BinaryFile, root Text, files Texts, stamped BinarySources, isOwn Boolean, linked LinkRound)
	Execute.Store(BinaryFile.Probe, ".", List(Text), Unstamped, true, LinkRound.Greeting) is not Error
	File(BinaryFile.Probe.Path).Exists
	folder = Path(cache.source).PathOnly.text
	types = linked.entries
	links = BinaryLinks(cache).Lines(types, linked.TypeNames, linked.linker)
	kept = BinaryLinks(cache).Keep(types, links)
	own = BinaryLinks(cache).Claim(cache.Head(File(cache.Path).ReadBytes), stamped.Indexed)
	whole = TypeEntry(kept.First, methods = kept.First.methods + BinaryLinks(cache).Add(kept.First, own))
	names = BinarySources.Names(types) + LinkHomes(linked).SourceNames(cache.source, whole)
	header = Complete(cache, root, files, stamped, isOwn).Typed(kept, folder).Named(names).Header
	cache.Save(cache.Pack(header, (List(TypeEntry) + whole) + kept.Slice(1, kept.Length - 1), links - ""))
Complete(cache BinaryFile, root Text, files Texts, stamped BinarySources, isOwn = false) BinarySources slow
	Execute.Complete(Adder, ".", AdderFiles, BinarySources.Mixed).stamps is (1, 2, 3)
	Execute.Complete(Adder, ".", List(Text), BinarySources.Mixed, true).stamps is (1, 2, 3)
	if isOwn
		return stamped
	current = SourceFiles(root).Of(cache.source)
	current.Length is files.Length then stamped else BinarySources(current).Stamped
TestTypes(types List(TypeEntry), path Text, isQuiet = false) Answer
	home = Directory.Current
	machine = Constants(trial.Covers(types) then trial.Prepare(types, path) else Start(types, path)).SeedMachine(cached)
	failed = Machine(machine, isQuiet = isQuiet or quietUntil > 0, quietUntil = quietUntil).RunTests(types.First.Name)
	Directory.Change(home)
	if failed > 0
		logger.Log(Summary(failed, path))
	if failed is 0 and selection is "*" and IsEdited(path) is false
		SlowTests.Pass(path)
	Answer(failed, known, constants = Constants(machine).Record(cached))
Mutate(types List(TypeEntry), path Text, root Text, files Texts, inference TypeInference, started Number) Number
	home = Directory.Current
	mutants = Mutants(path, Baseline.Budget(started), part, selection is "*")
	survived = isMutating and selection is in ("", "*") then mutants.RunMutants(types, root, files, inference) else 0
	Directory.Change(home)
	survived
Load(path Text, root Text, withTests = true, sources Texts = List(Text)) List(TypeEntry)
	started = Process.Elapsed
	cache = BinaryFile(FileCompiler.Normalize(path))
	entries = cache.Unpack(File(cache.Path).ReadBytes)
	isReady = withTests and selection is "" and IsEdited(path) is false and BinaryLinks(cache).IsTested(entries)
	types = isReady then cache.Current(entries) else List(TypeEntry)
	BuildProfile.Report("Bytecode cache " + (types.Length > 0 then "hit" else "miss"), started)
	types.Length > 0 then types else FileCompiler(false, selection).Compile(path, root, withTests, sources)
HasRun(type TypeEntry) Boolean
	Execute.HasRun(TypeEntry.HelloLogger)
	Execute.HasRun(TypeEntry("A", List(MemberEntry), List(MethodEntry))) is false
	Execute.HasRun(TypeEntry("A", List(MemberEntry), List(MethodEntry) + MethodEntry.Logged)) is false
	for type.methods
		if value.Name is "Run"
			return true
	false
Summary(failed Number, path Text) Text
	Execute.Summary(0, "A.strict") is "All tests passed in A.strict"
	Execute.Summary(2, "A.strict") is "2 tests failed in A.strict"
	failed is 0 then "All tests passed in " + path else failed + " tests failed in " + path
Start(types List(TypeEntry), path Text, isTracing = false, isInlining = true, isSampling = false) Machine
	Execute.Start(List(TypeEntry) + TypeEntry.HelloLogger, "Examples/HelloLogger.strict").folder is "Examples"
	Execute.Start(List(TypeEntry) + TypeEntry.HelloLogger, "A.strict", true).isTracing
	Execute.Start(List(TypeEntry) + TypeEntry.HelloLogger, "A.strict", false, true, true).isSampling
	started = Process.Elapsed
	rewritten = isInlining then Inliner(types).Rewritten else TailCalls(types).Rewritten
	BuildProfile.Report("Machine inlining (" + types.Length + " types)", started)
	before = Process.Elapsed
	folder = Path(path).PathOnly.text
	resolved = Resolver(rewritten).Resolved
	machine = Machine(resolved, ConstantCache(List(VmValue)), folder, isTracing, isSampling = isSampling).Prepared
	BuildProfile.Report("Machine resolving and preparing", before)
	machine