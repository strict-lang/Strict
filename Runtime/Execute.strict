has logger
constant Adder = BinaryFile("./Examples/NativeAdd/Adder.strict")
constant AdderFiles = SourceFiles(".").Of(Adder.source)
Run(arguments Texts) Number
	let failed = Failures(List(Text) + arguments(0), arguments(1), true)
	if failed > 0
		return failed
	let types = Loaded(arguments(0), arguments(1))
	if HasRun(types.First) is false
		logger.Log(Summary(0, arguments(0)))
		return 0
	mutable texts = List(Mutable(VmValue))
	for Range(2, arguments.Length)
		texts.Add(VmValue.OfText(arguments(value)))
	Started(types, arguments(0)).Launch(types.First.Name, texts)
Test(path Text, root Text) Number
	Execute(Logger).Test("Missing.strict", ".") is 1
	if File(path).Exists and (Directory.Exists(path) is false)
		return Failures(List(Text) + path, root, false)
	Directory.Exists(path) then Folders(logger).Tested(path, root) else 1
Failures(paths Texts, root Text, isQuiet Boolean) Number
	let stale = Stale(paths)
	let files = stale.Length is 0 then List(Text) else SourceFiles(root).Of(FileCompiler.Normalized(stale.First))
	let inference = ResolveCheck.Inference(files)
	mutable failed = 0
	for paths
		let failures = value is in stale then Verified(value, root, isQuiet, files, inference) else 0
		if (failures is 0) and (isQuiet is false)
			logger.Log(Summary(0, value))
		failed = failed + failures
	if stale.Length > 1
		Compacted(stale, Owners(paths))
	failed
Compacted(paths Texts, owners List(TypeEntry)) Number
	Execute(Logger).Compacted(List(Text) + "Missing.strict", List(TypeEntry)) is 0
	mutable compacted = 0
	for paths
		let cache = BinaryFile(FileCompiler.Normalized(value))
		let entries = File(cache.Path).Exists then cache.Unpacked(File(cache.Path).ReadBytes) else List(ZipEntry)
		if cache.IsFresh(entries)
			cache.Saved(cache.Packed(ByteEncoder(entries.First.content).Integers, cache.Types(entries), owners))
			compacted = compacted + 1
	compacted
Owners(paths Texts) List(TypeEntry)
	Execute(Logger).Owners(List(Text) + "Missing.strict").Length is 0
	for paths
		let owner = BinaryFile(FileCompiler.Normalized(value)).Owned(Path(value).FileName.RemoveExtension.text)
		if owner.Name is not ""
			owner
Stale(paths Texts) Texts
	for paths
		let cache = BinaryFile(FileCompiler.Normalized(value))
		if IsEdited(value) or (cache.IsFresh(cache.Unpacked(File(cache.Path).ReadBytes)) is false)
			value
IsEdited(path Text) Boolean
	Execute(Logger).IsEdited("Execute.strict") is false
	Execute(Logger).IsEdited("Missing.strict") is false
	let source = FileCompiler.Normalized(path)
	File(source).Exists and (File(source).Modified is 0)
Kept(path Text, root Text) Number
	Execute(Logger).Kept("Missing.strict", ".") is 1
	if File(path).Exists is false
		return 1
	let files = SourceFiles(root).Of(FileCompiler.Normalized(path))
	Verified(path, root, true, files, ResolveCheck.Inference(files), false)
Verified(path Text, root Text, isQuiet Boolean, files Texts, inference TypeInference, isTested = true) Number
	let cache = BinaryFile(FileCompiler.Normalized(path))
	let ignored = DataFiles.Ignored((Directory.Current, root))
	let stamped = BinarySources(files + DataFiles(ignored).Selected(List(Text) + cache.source)).Stamped
	let types = FileCompiler(logger, isQuiet).Built(path, root, true, files, inference)
	if types.Length is 0
		return 1
	let before = Process.FilesRead.Length
	let failed = isTested then Tested(types, path) else 0
	if (failed is 0) and (IsEdited(path) is false)
		let header = Completed(cache, root, files, stamped, before).Kept(types).Header
		cache.Saved(cache.Packed(header, types, List(TypeEntry)))
	failed
Completed(cache BinaryFile, root Text, files Texts, stamped BinarySources, before Number) BinarySources
	Execute(Logger).Completed(Adder, ".", AdderFiles, BinarySources.Mixed, Process.FilesRead.Length).stamps is (1, 2, 3)
	let read = Read(before)
	let current = SourceFiles(root).Of(cache.source)
	let isSame = (current.Length is files.Length) and (read.Length is 0)
	let ignored = isSame then List(Text) else DataFiles.Ignored((Directory.Current, root))
	let data = isSame then List(Text) else DataFiles(ignored).Selected(List(Text) + cache.source)
	isSame then stamped else BinarySources(current + data + read).Stamped
Read(before Number) Texts
	Execute(Logger).Read(Process.FilesRead.Length).Length is 0
	let read = Process.FilesRead
	mutable found = List(Mutable(Text))
	for Range(before, read.Length)
		let path = read(value)
		if BinaryFile(path).IsInput(path) and (path.EndsWith(".strict") is false) and (path is not in found)
			found.Add(path)
	found
Tested(types List(TypeEntry), path Text) Number
	let failed = Started(types, path).Tested(types.First.Name)
	if failed > 0
		logger.Log(Summary(failed, path))
	failed
Loaded(path Text, root Text, withTests = true) List(TypeEntry)
	let cache = BinaryFile(FileCompiler.Normalized(path))
	let types = IsEdited(path) then List(TypeEntry) else cache.Current(cache.Unpacked(File(cache.Path).ReadBytes))
	types.Length > 0 then types else FileCompiler(logger).Compiled(path, root, withTests)
HasRun(type TypeEntry) Boolean
	Execute.HasRun(TypeEntry.HelloLogger)
	Execute.HasRun(TypeEntry("A", List(MemberEntry), List(MethodEntry))) is false
	for type.methods
		if value.Name is "Run"
			return true
	false
Summary(failed Number, path Text) Text
	Execute.Summary(0, "A.strict") is "All tests passed in A.strict"
	Execute.Summary(2, "A.strict") is "2 tests failed in A.strict"
	failed is 0 then "All tests passed in " + path else failed + " tests failed in " + path
Started(types List(TypeEntry), path Text, isTracing = false) Machine
	Execute(Logger).Started(List(TypeEntry) + TypeEntry.HelloLogger, "Examples/HelloLogger.strict").folder is "Examples"
	Execute(Logger).Started(List(TypeEntry) + TypeEntry.HelloLogger, "A.strict", true).isTracing
	let rewritten = TailCalls(Inliner(types).Inlined).Rewritten
	Machine(Resolver(rewritten).Resolved, logger, List(VmValue), Path(path).PathOnly.text, isTracing).Prepared