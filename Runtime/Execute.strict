has selection Text = ""
has isRecursive Boolean = true
has isMutating Boolean = false
has part Text = ""
has isFull Boolean = false
has known Dictionary(Text, TypeEntry) = Dictionary(Text, TypeEntry)
has cached Dictionary(Text, VmValue) = Dictionary(Text, VmValue)
has quietUntil Number = 0
has inferred InferenceCache = InferenceCache.None
constant Adder = BinaryFile("./Examples/NativeAdd/Adder.strict")
constant AdderFiles = SourceFiles(".").Of(Adder.source)
constant Unstamped = BinarySources(List(Text))
Run(arguments Texts) Number
	paths = List(Text) + arguments(0)
	failed = Failures(paths, Stale(paths), arguments(1), true)
	if failed > 0
		return failed
	types = Loaded(arguments(0), arguments(1), false)
	if HasRun(types.First) is false
		logger.Log(Summary(0, arguments(0)))
		return 0
	mutable texts = List(Mutable(VmValue))
	for Range(2, arguments.Length)
		texts.Add(VmValue.OfText(arguments(value)))
	Started(types, arguments(0)).Completed(types.First.Name, texts) then 0 else 1
Test(path Text, root Text, isQuiet = false, sources Texts = List(Text)) Number
	Execute.Test("Missing.strict", ".") is 1
	if File(path).Exists and Directory.Exists(path) is false
		return Failures(path, Stale(path), root, isQuiet, sources)
	Directory.Exists(path) then Folders.Tested(path, root, isRecursive, isMutating, isFull) else 1
Failures(paths Texts, stale Texts, root Text, isQuiet Boolean, sources Texts = List(Text)) Number
	files = Sourced(stale, root, sources)
	types = ResolveCheck.Inference(files)
	mutable host = value
	mutable failed = 0
	for paths
		hit = value is in stale then Answer(0, known) else Answer(Cached(value), known)
		got = value is in stale then host.Verified(value, root, isQuiet, files, types, stale.Length is 1) else hit
		host = value is in stale then Execute(host, known = got.known) else host
		if got.code is 0 and isQuiet is false and quietUntil is 0
			logger.Log(Summary(0, value))
		failed = failed + got.code
	failed
Cached(path Text) Number
	Execute.Cached("Missing.strict") is 0
	Execute(isMutating = true).Cached("Missing.strict") is 0
	cache = MutationCache(path)
	if isMutating is false or cache.IsCurrent is false
		return 0
	for cache.Survivors
		logger.Log(value)
	cache.Survivors.Length
Sourced(stale Texts, root Text, sources Texts) Texts
	Execute.Sourced(List(Text), ".", List(Text) + "A.strict").Length is 0
	Execute.Sourced(List(Text) + "Examples/Sum.strict", ".", List(Text) + "A.strict") is ("A.strict")
	"./Examples/Sum.strict" is in Execute.Sourced(List(Text) + "Examples/Sum.strict", ".", List(Text))
	if stale.Length is 0 or sources.Length > 0
		return stale.Length is 0 then List(Text) else sources
	SourceFiles(root).Of(FileCompiler.Normalized(stale.First), stale)
Stale(paths Texts) Texts
	if selection is not "" and selection is not "*"
		return paths
	for paths
		cache = BinaryFile(FileCompiler.Normalized(value))
		entries = cache.Unpacked(File(cache.Path).ReadBytes)
		isCurrent = IsEdited(value) is false and cache.IsFresh(entries) and BinaryLinks(cache).IsTested(entries)
		if isCurrent is false or selection is "*" and SlowTests.IsPassed(value) is false
			value
IsEdited(path Text) Boolean
	Execute.IsEdited("Execute.strict") is false
	Execute.IsEdited("Missing.strict") is false
	source = FileCompiler.Normalized(path)
	File(source).Exists and File(source).Modified is 0
Kept(path Text, root Text) Number
	Execute.Kept("Missing.strict", ".") is 1
	if File(path).Exists is false
		return 1
	files = SourceFiles(root).Of(FileCompiler.Normalized(path))
	Verified(path, root, true, files, ResolveCheck.Inference(files), true, false).code
Served(path Text, root Text, isQuiet = false, sources Texts = List(Text)) Answer
	Execute.Served("Missing.strict", ".").code is 1
	Execute.Served("Missing.strict", ".", true).Types.Length is 0
	isFile = File(path).Exists and Directory.Exists(path) is false and selection is in ("", "*")
	if isFile then Stale(path).Length is 0 else true
		return Answer(Test(path, root, isQuiet, sources), known)
	files = Sourced(path, root, sources)
	joined = inferred.Of(files, FileCompiler.Normalized(path))
	answer = Verified(path, root, isQuiet, files, joined.Result.joined, true)
	if answer.code is 0 and isQuiet is false and quietUntil is 0
		logger.Log(Summary(0, path))
	Answer(answer, inferred = joined)
Verified(path Text, root Text, isQuiet Boolean, files Texts, inference TypeInference, isOwn = false, isTested = true) Answer
	cache = BinaryFile(FileCompiler.Normalized(path))
	linked = FileCompiler(isQuiet, selection).Built(path, root, true, files, inference, known)
	if linked is Error
		logger.Log(path + ": " + (linked to Text))
		return Answer(1, known)
	types = linked.entries
	if types.Length is 0
		return Answer(1, known)
	started = Process.Elapsed
	tested = isTested then Tested(types, path, isQuiet) else Answer(0, known, constants = cached)
	if tested.code is 0 and selection is "" and IsEdited(path) is false
		Stored(cache, root, files, linked.linker.Sourced, isOwn, linked)
	survived = tested.code is 0 and isTested then Mutated(types, path, root, files, inference, started) else 0
	Answer(tested.code + survived, linked.Known(known), files = files, Types = types, constants = tested.constants)
Stored(cache BinaryFile, root Text, files Texts, stamped BinarySources, isOwn Boolean, linked LinkRound)
	Execute.Stored(BinaryFile.Probe, ".", List(Text), Unstamped, true, LinkRound.Greeting) is not Error
	File(BinaryFile.Probe.Path).Exists
	folder = Path(cache.source).PathOnly.text
	types = linked.entries
	links = BinaryLinks(cache).Lines(types, linked.TypeNames, linked.linker)
	kept = BinaryLinks(cache).Kept(types, links)
	own = BinaryLinks(cache).Owned(cache.Head(File(cache.Path).ReadBytes), stamped.Indexed)
	whole = TypeEntry(kept.First, methods = kept.First.methods + BinaryLinks(cache).Added(kept.First, own))
	names = BinarySources.Names(types) + LinkHomes(linked).SourceNames(cache.source, whole)
	header = Completed(cache, root, files, stamped, isOwn).Typed(kept, folder).Named(names).Header
	cache.Saved(cache.Packed(header, (List(TypeEntry) + whole) + kept.Slice(1, kept.Length - 1), links - ""))
Completed(cache BinaryFile, root Text, files Texts, stamped BinarySources, isOwn = false) BinarySources slow
	Execute.Completed(Adder, ".", AdderFiles, BinarySources.Mixed).stamps is (1, 2, 3)
	Execute.Completed(Adder, ".", List(Text), BinarySources.Mixed, true).stamps is (1, 2, 3)
	if isOwn
		return stamped
	current = SourceFiles(root).Of(cache.source)
	current.Length is files.Length then stamped else BinarySources(current).Stamped
Tested(types List(TypeEntry), path Text, isQuiet = false) Answer
	home = Directory.Current
	machine = Constants(Started(types, path)).Seeded(cached)
	failed = Machine(machine, isQuiet = isQuiet or quietUntil > 0, quietUntil = quietUntil).Tested(types.First.Name)
	Directory.Change(home)
	if failed > 0
		logger.Log(Summary(failed, path))
	if failed is 0 and selection is "*" and IsEdited(path) is false
		SlowTests.Passed(path)
	Answer(failed, known, constants = Constants(machine).Recorded(cached))
Mutated(types List(TypeEntry), path Text, root Text, files Texts, inference TypeInference, started Number) Number
	home = Directory.Current
	mutants = Mutants(path, Baseline.Budget(started), part, selection is "*")
	survived = isMutating and selection is in ("", "*") then mutants.Ran(types, root, files, inference) else 0
	Directory.Change(home)
	survived
Loaded(path Text, root Text, withTests = true, sources Texts = List(Text)) List(TypeEntry)
	started = Process.Elapsed
	cache = BinaryFile(FileCompiler.Normalized(path))
	entries = cache.Unpacked(File(cache.Path).ReadBytes)
	isReady = withTests and selection is "" and IsEdited(path) is false and BinaryLinks(cache).IsTested(entries)
	types = isReady then cache.Current(entries) else List(TypeEntry)
	BuildProfile.Reported("Bytecode cache " + (types.Length > 0 then "hit" else "miss"), started)
	types.Length > 0 then types else FileCompiler(false, selection).Compiled(path, root, withTests, sources)
HasRun(type TypeEntry) Boolean
	Execute.HasRun(TypeEntry.HelloLogger)
	Execute.HasRun(TypeEntry("A", List(MemberEntry), List(MethodEntry))) is false
	Execute.HasRun(TypeEntry("A", List(MemberEntry), List(MethodEntry) + MethodEntry.Logged)) is false
	for type.methods
		if value.Name is "Run"
			return true
	false
Summary(failed Number, path Text) Text
	Execute.Summary(0, "A.strict") is "All tests passed in A.strict"
	Execute.Summary(2, "A.strict") is "2 tests failed in A.strict"
	failed is 0 then "All tests passed in " + path else failed + " tests failed in " + path
Started(types List(TypeEntry), path Text, isTracing = false, isInlining = true, isSampling = false) Machine
	Execute.Started(List(TypeEntry) + TypeEntry.HelloLogger, "Examples/HelloLogger.strict").folder is "Examples"
	Execute.Started(List(TypeEntry) + TypeEntry.HelloLogger, "A.strict", true).isTracing
	Execute.Started(List(TypeEntry) + TypeEntry.HelloLogger, "A.strict", false, true, true).isSampling
	rewritten = TailCalls(isInlining then Inliner(types).Inlined else types).Rewritten
	folder = Path(path).PathOnly.text
	resolved = Resolver(rewritten).Resolved
	Machine(resolved, ConstantCache(List(VmValue)), folder, isTracing, isSampling = isSampling).Prepared