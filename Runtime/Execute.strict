has logger
has selection Text = ""
has isRecursive Boolean = true
has isMutating Boolean = false
has part Text = ""
has isFull Boolean = false
has known Dictionary(Text, TypeEntry) = Dictionary(Text, TypeEntry)
constant Adder = BinaryFile("./Examples/NativeAdd/Adder.strict")
constant AdderFiles = SourceFiles(".").Of(Adder.source)
Run(arguments Texts) Number
	let failed = Failures(List(Text) + arguments(0), arguments(1), true)
	if failed > 0
		return failed
	let types = Loaded(arguments(0), arguments(1), false)
	if HasRun(types.First) is false
		logger.Log(Summary(0, arguments(0)))
		return 0
	mutable texts = List(Mutable(VmValue))
	for Range(2, arguments.Length)
		texts.Add(VmValue.OfText(arguments(value)))
	Started(types, arguments(0)).Launch(types.First.Name, texts)
Test(path Text, root Text, isQuiet = false) Number
	Execute(Logger).Test("Missing.strict", ".") is 1
	if File(path).Exists and (Directory.Exists(path) is false)
		return Failures(List(Text) + path, root, isQuiet)
	Directory.Exists(path) then Folders(logger).Tested(path, root, isRecursive, isMutating, isFull) else 1
Failures(paths Texts, root Text, isQuiet Boolean) Number
	let stale = selection is "" then Stale(paths) else paths
	let files = stale.Length is 0 then List(Text) else SourceFiles(root).Of(FileCompiler.Normalized(stale.First), stale)
	let inference = ResolveCheck.Inference(files)
	mutable failed = 0
	for paths
		let failures = value is in stale then Verified(value, root, isQuiet, files, inference, stale.Length is 1).code else 0
		if (failures is 0) and (isQuiet is false)
			logger.Log(Summary(0, value))
		failed = failed + failures
	if stale.Length > 1
		Compacted(stale, Owners(paths))
	failed
Compacted(paths Texts, owners List(TypeEntry)) Number
	Execute(Logger).Compacted(List(Text) + "Missing.strict", List(TypeEntry)) is 0
	mutable compacted = 0
	for paths
		let cache = BinaryFile(FileCompiler.Normalized(value))
		let entries = File(cache.Path).Exists then cache.Unpacked(File(cache.Path).ReadBytes) else List(ZipEntry)
		if cache.IsFresh(entries)
			cache.Saved(cache.Packed(ByteEncoder(entries.First.content).Integers, cache.Types(entries), owners))
			compacted = compacted + 1
	compacted
Owners(paths Texts) List(TypeEntry)
	Execute(Logger).Owners(List(Text) + "Missing.strict").Length is 0
	for paths
		let owner = BinaryFile(FileCompiler.Normalized(value)).Owned(Path(value).FileName.RemoveExtension.text)
		if owner.Name is not ""
			owner
Stale(paths Texts) Texts
	for paths
		let cache = BinaryFile(FileCompiler.Normalized(value))
		if IsEdited(value) or (cache.IsFresh(cache.Unpacked(File(cache.Path).ReadBytes)) is false)
			value
IsEdited(path Text) Boolean
	Execute(Logger).IsEdited("Execute.strict") is false
	Execute(Logger).IsEdited("Missing.strict") is false
	let source = FileCompiler.Normalized(path)
	File(source).Exists and (File(source).Modified is 0)
Kept(path Text, root Text) Number
	Execute(Logger).Kept("Missing.strict", ".") is 1
	if File(path).Exists is false
		return 1
	let files = SourceFiles(root).Of(FileCompiler.Normalized(path))
	Verified(path, root, true, files, ResolveCheck.Inference(files), true, false).code
Served(path Text, root Text) Answer
	Execute(Logger).Served("Missing.strict", ".").code is 1
	if Directory.Exists(path) or (File(path).Exists is false) or (selection is not "") or (Stale((path)).Length is 0)
		return Answer(Test(path, root), known)
	let files = SourceFiles(root).Of(FileCompiler.Normalized(path), (path))
	let answer = Verified(path, root, false, files, ResolveCheck.Inference(files), true)
	if answer.code is 0
		logger.Log(Summary(0, path))
	answer
Verified(path Text, root Text, isQuiet Boolean, files Texts, inference TypeInference, isOwn = false, isTested = true) Answer
	let cache = BinaryFile(FileCompiler.Normalized(path))
	let stamped = BinarySources(files).Stamped
	let linked = FileCompiler(logger, isQuiet, selection).Built(path, root, true, files, inference, known)
	let types = linked.entries
	if types.Length is 0
		return Answer(1, known)
	let failed = isTested then Tested(types, path, root, files, inference) else 0
	if (failed is 0) and (selection is "") and (IsEdited(path) is false)
		let folder = Path(cache.source).PathOnly.text
		let header = Completed(cache, root, files, stamped, isOwn).Typed(types, folder).Kept(types).Header
		cache.Saved(cache.Packed(header, types, List(TypeEntry)))
	Answer(failed, linked.Known(known), "", Dictionary(Text, Number), files)
Completed(cache BinaryFile, root Text, files Texts, stamped BinarySources, isOwn = false) Slow(BinarySources)
	Execute(Logger).Completed(Adder, ".", AdderFiles, BinarySources.Mixed).stamps is (1, 2, 3)
	Execute(Logger).Completed(Adder, ".", List(Text), BinarySources.Mixed, true).stamps is (1, 2, 3)
	if isOwn
		return stamped
	let current = SourceFiles(root).Of(cache.source)
	current.Length is files.Length then stamped else BinarySources(current).Stamped
Tested(types List(TypeEntry), path Text, root Text, files Texts, inference TypeInference) Number
	let started = Process.Elapsed
	let failed = Started(types, path).Tested(types.First.Name)
	if failed > 0
		logger.Log(Summary(failed, path))
		return failed
	let mutants = Mutants(logger, path, Baseline.Budget(started), part, selection is "*")
	isMutating and (selection is in ("", "*")) then mutants.Ran(types, root, files, inference) else 0
Loaded(path Text, root Text, withTests = true, sources Texts = List(Text)) List(TypeEntry)
	let started = Process.Elapsed
	let cache = BinaryFile(FileCompiler.Normalized(path))
	let bypass = IsEdited(path) or (selection is not "") or (withTests is false)
	let types = bypass then List(TypeEntry) else cache.Current(cache.Unpacked(File(cache.Path).ReadBytes))
	let status = types.Length > 0 then "hit" else "miss"
	BuildProfile(logger).Reported("Bytecode cache " + status, started)
	types.Length > 0 then types else FileCompiler(logger, false, selection).Compiled(path, root, withTests, sources)
HasRun(type TypeEntry) Boolean
	Execute.HasRun(TypeEntry.HelloLogger)
	Execute.HasRun(TypeEntry("A", List(MemberEntry), List(MethodEntry))) is false
	Execute.HasRun(TypeEntry("A", List(MemberEntry), List(MethodEntry) + MethodEntry.Logged)) is false
	for type.methods
		if value.Name is "Run"
			return true
	false
Summary(failed Number, path Text) Text
	Execute.Summary(0, "A.strict") is "All tests passed in A.strict"
	Execute.Summary(2, "A.strict") is "2 tests failed in A.strict"
	failed is 0 then "All tests passed in " + path else failed + " tests failed in " + path
Started(types List(TypeEntry), path Text, isTracing = false) Machine
	Execute(Logger).Started(List(TypeEntry) + TypeEntry.HelloLogger, "Examples/HelloLogger.strict").folder is "Examples"
	Execute(Logger).Started(List(TypeEntry) + TypeEntry.HelloLogger, "A.strict", true).isTracing
	let rewritten = TailCalls(Inliner(types).Inlined).Rewritten
	let folder = Path(path).PathOnly.text
	Machine(Resolver(rewritten).Resolved, logger, ConstantCache(List(VmValue)), folder, isTracing).Prepared