has logger
Run(arguments Texts) Number
	let failed = Failures(List(Text) + arguments(0), arguments(1), true)
	if failed > 0
		return failed
	let types = Loaded(arguments(0), arguments(1))
	if HasRun(types.First) is false
		logger.Log("All tests passed in " + arguments(0))
		return 0
	mutable texts = List(Mutable(VmValue))
	for Range(2, arguments.Length)
		texts.Add(VmValue.OfText(arguments(value)))
	Machine(Resolver(types).Resolved, logger).Launch(types.First.Name, texts)
	0
Test(path Text, root Text) Number
	let paths = Directory.Exists(path) then Directory.Files(path, "*.strict") else List(Text) + path
	Failures(paths, root, false)
Failures(paths Texts, root Text, isQuiet Boolean) Number
	let stale = Stale(paths)
	let files = stale.Length is 0 then List(Text) else SourceFiles(root).Of(FileCompiler.Normalized(stale.First))
	if FileCompiler(logger).Parsed(files) is false
		return stale.Length
	let inference = ResolveCheck.Inference(files)
	mutable failed = 0
	for paths
		let failures = value is in stale then Verified(value, root, isQuiet, files, inference) else 0
		if (failures is 0) and (isQuiet is false)
			logger.Log("All tests passed in " + value)
		failed = failed + failures
	failed
Stale(paths Texts) Texts
	for paths
		let cache = BinaryFile(FileCompiler.Normalized(value))
		if cache.IsFresh(cache.Unpacked(File(cache.Path).ReadBytes)) is false
			value
Verified(path Text, root Text, isQuiet Boolean, files Texts, inference TypeInference) Number
	let cache = BinaryFile(FileCompiler.Normalized(path))
	let header = cache.Header(files + cache.Data(cache.source))
	let types = FileCompiler(logger, isQuiet).Built(path, root, true, files, inference)
	if types.Length is 0
		return 1
	let failed = Tested(types, path)
	if failed is 0
		File(cache.Path).Write(cache.Packed(header, types))
	failed
Tested(types List(TypeEntry), path Text) Number
	let failed = Machine(Resolver(types).Resolved, logger).Tested(types.First.Name)
	if failed > 0
		logger.Log(failed to Text + " tests failed in " + path)
	failed
Loaded(path Text, root Text) List(TypeEntry)
	let cache = BinaryFile(FileCompiler.Normalized(path))
	let types = cache.Types(cache.Unpacked(File(cache.Path).ReadBytes))
	types.Length > 0 then types else FileCompiler(logger).Compiled(path, root, true)
HasRun(type TypeEntry) Boolean
	Execute.HasRun(TypeEntry.HelloLogger) is true
	Execute.HasRun(TypeEntry("A", List(MemberEntry), List(MethodEntry))) is false
	for type.methods
		if value.Name is "Run"
			return true
	false