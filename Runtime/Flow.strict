has frame
has entry InstructionEntry
constant SkipFirst = InstructionEntry.Jump(InstructionType.JumpToIdIfFalse, 0)
constant Branch = Frame(MethodEntry("Run", List(MemberEntry), "None", (SkipFirst, InstructionEntry.Return(0), InstructionEntry.Jump(InstructionType.JumpEnd, 0), InstructionEntry.Return(1))), 0, (VmValue.OfNumber(3), VmValue.OfNumber(4)), Locals.Empty)
constant Copying = Frame(MethodEntry("Run", List(MemberEntry), "None", (InstructionEntry(InstructionType.CopyList, "a", -1), InstructionEntry.Return(0))), 0, List(VmValue), Locals.Empty)
Step Frame
	Flow(Branch, SkipFirst).Step.position is 2
	Flow(Branch.At(1), Branch.At(1).Instruction).Step.Local("#result").number is 3
	Flow(Copying, Copying.Instruction).Step.position is 1
	if entry.kind is InstructionType.Return
		return frame.WithLocal("#result", frame.Register(entry.payload(0))).At(frame.method.instructions.Length)
	if (entry.kind is InstructionType.JumpEnd) or (entry.kind is InstructionType.CopyList)
		return frame.Next
	if entry.kind >= InstructionType.JumpToIdIfFalse
		return Jumped
	entry.kind is InstructionType.LoopBegin then Looping(frame).Begin else Looping(frame).End
Jumped Frame
	Flow(Branch.WithLocal("#flag", VmValue.OfBoolean(true)), SkipFirst).Jumped.position is 1
	let isTaken = frame.Local("#flag").IsTrue is (entry.kind is InstructionType.JumpToIdIfTrue)
	isTaken then frame.At(JumpEnd(PayloadDecoder(entry).SevenBit(0))) else frame.Next
JumpEnd(id Number) Number
	Flow(Branch, SkipFirst).JumpEnd(0) is 2
	for frame.method.instructions
		if (value.kind is InstructionType.JumpEnd) and (PayloadDecoder(value).SevenBit(0) is id)
			return index
	frame.method.instructions.Length