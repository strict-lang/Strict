constant Batch = 128
constant CrashExitCode = 128
constant PendingPath = "./Compiler/output/Pending/Go.strict"
constant PendingFile = BinaryFile(PendingPath)
constant PendingSource = PtxCache("Compiler/output/Pending/Go").Save(".strict", "from") is not Error
constant PendingHeader = PendingSource then BinarySources(List(Text) + PendingPath).Stamped.Header else List(Number)
constant PendingBytes = PendingFile.Pack(PendingHeader, List(TypeEntry) + BinaryLinks.Tested, List(Text))
TestFolder(folder Text, root Text, isRecursive = true, isMutating = false, isFull = false) Number
	Folders.TestFolder("Missing", ".") is 0
	files = NativeFolder(isRecursive = isRecursive).Files(folder)
	pending = Pending(files, isMutating)
	mutable failed = 0
	if pending.Length > 0
		if isMutating is false and isFull is false
			failed = Execute.Failures(pending, pending, root, false)
		else
			failed = RunFolders(Commands("test", pending, root, isMutating, isFull))
	for files - pending
		failed = failed + Execute(isMutating = isMutating).Cache(value)
	failed
Pending(files Texts, isMutating Boolean) Texts slow
	Folders.Pending(List(Text) + "Missing.strict", false) is ("Missing.strict")
	PendingFile.Save(PendingBytes) is not Error
	Folders.Pending(List(Text) + PendingPath, false).Length is 0
	for files
		if IsChanged(value) or isMutating and MutationCache(value).IsCurrent is false
			value
IsChanged(path Text) Boolean slow
	Folders.IsChanged("Missing.strict")
	cache = BinaryFile(FileCompiler.Normalize(path))
	entries = cache.Head(File(cache.Path).ReadBytes)
	isTested = cache.IsCurrent(entries) and BinaryLinks(cache).IsTested(entries)
	Execute.IsEdited(path) or isTested is false
Nightly(folder Text, root Text) Number slow
	Folders.Nightly("Missing", ".") is 0
	RunFolders(Commands("test", Execute("*").Stale(NativeFolder.Files(folder)), root, false, false, true))
Commands(command Text, paths Texts, root Text, isMutating = false, isFull = false, isNightly = false) Texts
	Folders.Commands("test", List(Text) + "a.strict", ".") is ("test \"a.strict\" \".\" unit")
	Folders.Commands("test", List(Text) + "a.strict", ".", true) is ("test \"a.strict\" \".\" unit mutations")
	Folders.Commands("test", List(Text) + "a.strict", ".", true, true) is ("test \"a.strict\" \".\" mutations")
	Folders.Commands("test", List(Text) + "a", ".", false, false, true) is ("test \"a\" \".\" nightly")
	checked = (command is "test" and isFull is false then " unit" else "") + (isMutating then " mutations" else "")
	options = isNightly then " nightly" else checked
	for paths
		command + " \"" + value + "\" \"" + root + "\"" + options
Clean(folder Text) Number
	Folders.Clean("Missing") is 0
	Directory.Create("Compiler/output/Clean") is not Error
	Directory.Create("Compiler/output/Clean/obj") is not Error
	Directory.Exists("Compiler/output/Clean/obj")
	Folders.Clean("Compiler/output/Clean") is 0
	Directory.Exists("Compiler/output/Clean/obj") is false
	mutable removed = 0
	for Directory.Directories(folder)
		name = Path(value).FileName.text
		removed = removed + (name is "obj" then Remove(value) else (name is in (".git", "Tools") then 0 else Clean(value)))
	removed
IsKept(file Text) Boolean
	Folders.IsKept("./obj/strict.ptx")
	Folders.IsKept("./obj/strict.mlir") is false
	Folders.IsKept("Compiler/obj/Missing.ptx") is false
	name = Path(file).FileName.text
	program = Path(Path(file).PathOnly.text).PathOnly.text + "/" + name.Split(".").First
	isDevice = ("." + name.Split(".").Last) is in (".ptx", ".fatbin", ".hsaco", ".metal")
	isDevice and (File(program + ".exe").Exists or File(program).Exists)
Remove(folder Text) Number
	Folders.Remove("Missing") is 0
	mutable removed = 0
	for Directory.Files(folder)
		if IsKept(value) is false
			File(value).Delete
			removed = removed + 1
	for Directory.Directories(folder)
		removed = removed + Remove(value)
	Directory.Delete(folder)
	removed
RunFolders(arguments Texts) Number
	Folders.RunFolders(List(Text)) is 0
	mutable failed = 0
	for Range(0, ((arguments.Length + Batch - 1) / Batch).Floor)
		start = value * Batch
		count = arguments.Length - start < Batch then arguments.Length - start else Batch
		for Process.RunTools(Process.Current.executable, arguments.Slice(start, count))
			logger.Log((value.Output + value.error).Replace("\r", "").Trim)
			if value.exitCode is not 0
				logger.Log("strict " + arguments(start + index) + " exited with " + value.exitCode)
			failed = failed + Fail(value.exitCode)
	failed
Fail(exitCode Number) Number
	Folders.Fail(3) is 3
	Folders.Fail(-1073741819) is 1
	Folders.Fail(0) is 0 and Folders.Fail(200) is 1
	exitCode >= 0 and exitCode < CrashExitCode then exitCode else 1