has logger
constant Batch = 128
constant CrashExitCode = 128
Tested(folder Text, root Text, isRecursive = true, isMutating = false, isFull = false) Number
	Folders(Logger).Tested("Missing", ".") is 0
	let files = NativeFolder(logger, isRecursive = isRecursive).Files(folder)
	let pending = Pending(files, isMutating)
	mutable failed = Ran(Commands("test", pending, root, isMutating, isFull))
	for files - pending
		failed = failed + Execute(logger, isMutating = isMutating).Cached(value)
	failed
Pending(files Texts, isMutating Boolean) Texts slow
	Folders(Logger).Pending(List(Text) + "Missing.strict", false) is ("Missing.strict")
	Execute(Logger).Kept("Examples/Sum.strict", ".") is 0
	Folders(Logger).Pending(List(Text) + "Examples/Sum.strict", false).Length is 0
	for files
		if IsChanged(value) or (isMutating and (MutationCache(value).IsCurrent is false))
			value
IsChanged(path Text) Boolean slow
	Folders(Logger).IsChanged("Missing.strict")
	let cache = BinaryFile(FileCompiler.Normalized(path))
	let entries = cache.Head(File(cache.Path).ReadBytes)
	let isTested = cache.IsCurrent(entries) and BinaryLinks(cache).IsTested(entries)
	Execute(logger).IsEdited(path) or (isTested is false)
Commands(command Text, paths Texts, root Text, isMutating = false, isFull = false) Texts
	Folders(Logger).Commands("test", List(Text) + "a.strict", ".") is ("test \"a.strict\" \".\" unit")
	Folders(Logger).Commands("test", List(Text) + "a.strict", ".", true) is ("test \"a.strict\" \".\" unit mutations")
	Folders(Logger).Commands("test", List(Text) + "a.strict", ".", true, true) is ("test \"a.strict\" \".\" mutations")
	let isUnit = (command is "test") and (isFull is false)
	let options = (isUnit then " unit" else "") + (isMutating then " mutations" else "")
	for paths
		command + " \"" + value + "\" \"" + root + "\"" + options
Cleaned(folder Text) Number
	Folders(Logger).Cleaned("Missing") is 0
	Directory.Create("Compiler/output/Clean") is not Error
	Directory.Create("Compiler/output/Clean/obj") is not Error
	Directory.Exists("Compiler/output/Clean/obj")
	Folders(Logger).Cleaned("Compiler/output/Clean") is 0
	Directory.Exists("Compiler/output/Clean/obj") is false
	mutable removed = 0
	for Directory.Directories(folder)
		let name = Path(value).FileName.text
		removed = removed + (name is "obj" then Removed(value) else (name is in (".git", "Tools") then 0 else Cleaned(value)))
	removed
IsKept(file Text) Boolean
	Folders(Logger).IsKept("./obj/strict.ptx")
	Folders(Logger).IsKept("./obj/strict.mlir") is false
	Folders(Logger).IsKept("Compiler/obj/Missing.ptx") is false
	let name = Path(file).FileName.text
	let program = Path(Path(file).PathOnly.text).PathOnly.text + "/" + name.Split(".").First
	let isDevice = ("." + name.Split(".").Last) is in (".ptx", ".fatbin", ".hsaco", ".metal")
	isDevice and (File(program + ".exe").Exists or File(program).Exists)
Removed(folder Text) Number
	Folders(Logger).Removed("Missing") is 0
	mutable removed = 0
	for Directory.Files(folder)
		if IsKept(value) is false
			File(value).Delete
			removed = removed + 1
	for Directory.Directories(folder)
		removed = removed + Removed(value)
	Directory.Delete(folder)
	removed
Ran(arguments Texts) Number
	Folders(Logger).Ran(List(Text)) is 0
	mutable failed = 0
	for Range(0, ((arguments.Length + Batch - 1) / Batch).Floor)
		let start = value * Batch
		let count = arguments.Length - start < Batch then arguments.Length - start else Batch
		for Process.RunTools(Process.Current.executable, arguments.Slice(start, count))
			logger.Log((value.Output + value.error).Replace("\r", "").Trim)
			if value.exitCode is not 0
				logger.Log("strict " + arguments(start + index) + " exited with " + value.exitCode)
			failed = failed + Failed(value.exitCode)
	failed
Failed(exitCode Number) Number
	Folders.Failed(3) is 3
	Folders.Failed(-1073741819) is 1
	Folders.Failed(0) is 0 and Folders.Failed(200) is 1
	(exitCode >= 0) and (exitCode < CrashExitCode) then exitCode else 1