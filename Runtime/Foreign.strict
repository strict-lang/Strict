has call Invocation
has types List(TypeEntry)
has folder Text = ""
constant Add = MethodEntry("Add", (MemberEntry("left", "Strict/Number", List(InstructionEntry), false), MemberEntry("right", "Strict/Number", List(InstructionEntry), false)), "Strict/Number", List(InstructionEntry))
constant Defaulted = MethodEntry("Add", Add.parameters + MemberEntry.SevenMember, "Strict/Number", List(InstructionEntry))
constant Adder = TypeEntry("Strict/Examples/NativeAdd/Adder", List(MemberEntry), List(MethodEntry) + Add)
constant Adding = Foreign(Invocation(InstructionEntry.Invoke(3, ("Strict/Examples/NativeAdd/Adder", "Add", "Strict/Number", "left", "right"), (0, 0), -1), (VmValue.OfNumber(1), VmValue.OfNumber(2)), VmValue.None), List(TypeEntry) + Adder)
constant Shorter = TypeEntry("Adder", List(MemberEntry), List(MethodEntry))
constant Framing = TypeEntry("Strict/Math/Frame", List(MemberEntry), List(MethodEntry) + Add)
constant Missing = VmValue("Strict/Library", 0, "", List(VmValue) + VmValue.OfText("missing.dll"))
constant Calling = Foreign(Invocation(InstructionEntry.Invoke(2, ("Strict/Library", "Call", "Strict/Number", "symbol", "arguments"), (0, 0), 0), (VmValue.OfText("Add"), VmValue.OfList(VmValue.OfNumber(0))), Missing), List(TypeEntry))
constant Counter = ForeignMethod.Counter
constant Framed = Foreign(Invocation(InstructionEntry.Invoke(3, ("Strict/Math/Frame", "Add", "Strict/Number", "left", "right"), (0, 0), -1), (VmValue.OfNumber(1), VmValue.OfNumber(2)), VmValue.None), List(TypeEntry) + Framing)
constant Counting = Foreign(Invocation(InstructionEntry.Invoke(1, (Counter.Name, "Next", "Strict/Number"), List(Number), 0), List(VmValue), VmValue.OfNumber(7).As(Counter.Name)), List(TypeEntry) + Counter)
Called VmValue
	Foreign(Invocation.AddCall, List(TypeEntry)).Called.items.First.text is "Unsupported native call T.Add"
	Framed.Called.items.First.text.StartsWith("TraitHasNoImplementation")
	type = Natives(types).TypeOf(call.TypeName)
	built = IsForeign(type) then Build(type) else "Unsupported native call " + call.TypeName + "." + call.MethodName
	if built.StartsWith("Built ") is false
		return VmValue.OfError(built)
	library = Library(built.Substring(6, built.Length - 6))
	method = Method(type)
	bits = library.Call(type.JustName + "_" + call.MethodName, Arguments(library, method))
	failure = library.Failure(bits)
	failure is "" then Convert(library, method.returnType, bits) else VmValue.OfError(failure)
Construct(type TypeEntry) VmValue
	Adding.Construct(Adder) is Adding.Called
	IsForeign(type) then Called else Rounding.Single.Build(type, call, Natives(types, folder), type.IsStruct, VmValue.None)
Build(type TypeEntry) Text
	Adding.Build(Framing).StartsWith("TraitHasNoImplementation: Frame.Add has no body")
	native = Folder(type)
	if Directory.Exists(native) is false
		return ForeignMethod(type, Method(type)).Unimplemented
	entered = TestBudget.Entered
	library = LibraryBuilder.Build(native)
	TestBudget.Left(entered)
	library
IsForeign(type TypeEntry) Boolean
	Adding.IsForeign(Adder)
	Adding.IsForeign(TypeEntry("Strict/Shape", List(MemberEntry), List(MethodEntry))) is false
	Adding.IsForeign(TypeEntry(Adder.Name, List(MemberEntry), List(MethodEntry) + MethodEntry(Add, Name = "Sub"))) is false
	for type.methods
		if value.Name is call.MethodName
			return ForeignMethod(type, value).IsForeign
	false
Method(type TypeEntry) MethodEntry
	Adding.Method(Adder).Name is "Add"
	Adding.Method(TypeEntry("T", List(MemberEntry), (ForeignMethod.Next, Add))) is Add
	Defaulted.parameters is (Add.parameters(0), Add.parameters(1), MemberEntry.SevenMember)
	Defaulted.Name is "Add" and Defaulted.returnType is "Strict/Number"
	for type.methods
		if value.Name is call.MethodName
			return value
	type.methods.First
Arguments(library Library, method MethodEntry) Numbers
	Adding.Arguments(Library("missing.dll"), Add) is (0, 1, 2)
	Counting.Arguments(Library("missing.dll"), ForeignMethod.Next) is (7)
	Adding.Arguments(Library("missing.dll"), Defaulted) is (0, 1, 2, 7)
	mutable arguments = List(Number) + (call.entry.payload(call.Flag) is 1 then call.Instance.number else 0)
	for method.parameters
		given = index < call.Arguments.Length then call.Arguments(index) else Natives(types).Initial(value)
		kind = value.typeName
		number = kind.EndsWith("Text") then library.TextSlot(given.text) else given.number
		arguments = arguments + (ForeignMethod.IsNumbers(kind) then library.NumbersSlot(Numbers(given.items)) else number)
	arguments
Convert(library Library, returnType Text, bits Number) VmValue
	Adding.Convert(Library("missing.dll"), "Strict/Number", 3).number is 3
	Adding.Convert(Library("missing.dll"), "Strict/Boolean", 0).kind is "Boolean"
	if returnType.EndsWith("Boolean")
		return VmValue.OfBoolean(bits is not 0)
	if returnType.EndsWith("Text")
		return VmValue.OfText(library.TextResult(bits))
	if ForeignMethod.IsRows(returnType)
		return Rows(library, bits)
	ForeignMethod.IsNumbers(returnType) then Elements(library.NumbersResult(bits)) else VmValue.OfNumber(bits)
Rows(library Library, bits Number) VmValue
	Adding.Rows(Library("missing.dll"), Library("missing.dll").NumbersSlot(List(Number))).items.Length is 0
	Adding.call.TypeName is "Strict/Examples/NativeAdd/Adder"
	Adding.call.ParameterNames is ("left", "right")
	Adding.call.MethodName is "Add"
	Adding.call.ReturnType is "Strict/Number"
	Adding.types is (Adder)
	mutable rows = List(Mutable(VmValue))
	for library.NumbersResult(bits)
		rows.Add(Elements(library.NumbersResult(value)))
	VmValue.OfList(rows)
Elements(numbers Numbers) VmValue
	Adding.Elements((1, 2)).items.Length is 2
	Framed.types is (Framing)
	Framed.call.ParameterNames is ("left", "right")
	Framed.call.ReturnType is "Strict/Number"
	Calling.call.Arguments is (VmValue.OfText("Add"), VmValue.OfList(VmValue.OfNumber(0)))
	mutable items = List(Mutable(VmValue))
	for numbers
		items.Add(VmValue.OfNumber(value))
	VmValue.OfList(items)
Folder(type TypeEntry) Text
	Adding.Folder(Adder) is "Examples/NativeAdd/native"
	Foreign(Invocation.AddCall, List(TypeEntry), "Examples/NativeAdd").Folder(Shorter) is "Examples/NativeAdd/native"
	parent = Path(type.Name.IndexOf("/") < 0 then folder + "/" + type.Source else type.Source).PathOnly.text
	native = parent is "" then "native" else parent + "/native"
	Directory.Exists(native) or TypeSource.Root is "." then native else TypeSource.Root + "/" + native
Numbers(values List(VmValue)) Numbers
	Adding.Numbers((VmValue.OfNumber(1), VmValue.OfNumber(2))) is (1, 2)
	Missing.kind is "Strict/Library"
	Missing.items is (VmValue.OfText("missing.dll"))
	Counter is ForeignMethod.Counter
	Counting.types is (ForeignMethod.Counter)
	Counting.call.MethodName is "Next"
	Counting.call.ReturnType is "Strict/Number"
	for values
		value.number
Hosted VmValue
	Calling.Hosted.number is not 3
	Calling.Hosted.kind is "Strict/Error"
	library = Library(call.Instance.Member(0).text)
	name = call.MethodName
	if name is not in ("Call", "TextSlot", "NumbersSlot")
		return Copy(library, name, call.Arguments.First.number)
	result = Raw(library, name)
	result is Error then VmValue.OfError(result.Name.text) else VmValue.OfNumber(result)
Raw(library Library, name Text) Number
	Calling.Raw(Library("missing.dll"), "Call") is Error
	argument = call.Arguments.First
	if name is "Call"
		return library.Call(argument.text, Numbers(call.Arguments.Last.items))
	name is "TextSlot" then library.TextSlot(argument.text) else library.NumbersSlot(Numbers(argument.items))
Copy(library Library, name Text, bits Number) VmValue
	Adding.Copy(Library("missing.dll"), "Failure", 3).text is ""
	if name is "TextResult"
		return VmValue.OfText(library.TextResult(bits))
	name is "Failure" then VmValue.OfText(library.Failure(bits)) else Elements(library.NumbersResult(bits))