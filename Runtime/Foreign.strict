has call Invocation
has types List(TypeEntry)
has folder Text = ""
constant Add = MethodEntry("Add", (MemberEntry("left", "Strict/Number", List(InstructionEntry), false), MemberEntry("right", "Strict/Number", List(InstructionEntry), false)), "Strict/Number", List(InstructionEntry))
constant Adder = TypeEntry("Strict/Examples/NativeAdd/Adder", List(MemberEntry), List(MethodEntry) + Add)
constant Adding = Foreign(Invocation(InstructionEntry.Invoke(3, ("Strict/Examples/NativeAdd/Adder", "Add", "Strict/Number", "left", "right"), (0, 0), -1), (VmValue.OfNumber(1), VmValue.OfNumber(2)), VmValue.None), List(TypeEntry) + Adder)
constant Shorter = TypeEntry("Adder", List(MemberEntry), List(MethodEntry))
constant Framing = TypeEntry("Strict/Math/Frame", List(MemberEntry), List(MethodEntry) + Add)
constant Missing = VmValue("Strict/Library", 0, "", List(VmValue) + VmValue.OfText("missing.dll"))
constant Calling = Foreign(Invocation(InstructionEntry.Invoke(2, ("Strict/Library", "Call", "Strict/Number", "symbol", "arguments"), (0, 0), 0), (VmValue.OfText("Add"), VmValue.OfList(VmValue.OfNumber(0))), Missing), List(TypeEntry))
constant Counter = TypeEntry(MlirForeign.Counter.Name, MlirForeign.Counter.members, List(MethodEntry) + MlirForeign.Next)
constant Counting = Foreign(Invocation(InstructionEntry.Invoke(1, (Counter.Name, "Next", "Strict/Number"), List(Number), 0), List(VmValue), VmValue.OfNumber(7).As(Counter.Name)), List(TypeEntry) + Counter)
Called VmValue
	Foreign(Invocation.AddCall, List(TypeEntry)).Called.text is "Unsupported native call T.Add"
	let type = Natives(types).TypeOf(call.TypeName)
	if IsForeign(type) is false
		return VmValue("Error", 0, "Unsupported native call " + call.TypeName + "." + call.MethodName, List(VmValue))
	let built = Built(type)
	if built.StartsWith("Built ") is false
		return VmValue("Error", 0, built, List(VmValue))
	let library = Library(built.Substring(6, built.Length - 6))
	let method = Method(type)
	let bits = library.Call(type.JustName + "_" + call.MethodName, Arguments(library, method))
	let failure = library.Failure(bits)
	failure is "" then Converted(library, method.returnType, bits) else VmValue.OfError(failure)
Built(type TypeEntry) Text
	Adding.Built(Framing).StartsWith("TraitHasNoImplementation: Frame.Add has no body") is true
	let native = Folder(type)
	if Directory.Exists(native) is false
		return MlirForeign(MlirFunction(types, type, Method(type))).Unimplemented
	NativeSources(List(Text) + native).Library(Platform.Current, TypeSource.Root)
IsForeign(type TypeEntry) Boolean
	Adding.IsForeign(Adder) is true
	Adding.IsForeign(TypeEntry("Strict/Shape", List(MemberEntry), List(MethodEntry))) is false
	for type.methods
		if value.Name is call.MethodName
			return MlirForeign(MlirFunction(types, type, value)).IsForeign
	false
Method(type TypeEntry) MethodEntry
	Adding.Method(Adder).Name is "Add"
	for type.methods
		if value.Name is call.MethodName
			return value
	type.methods.First
Arguments(library Library, method MethodEntry) Numbers
	Adding.Arguments(Library("missing.dll"), Add) is (0, 1, 2)
	Counting.Arguments(Library("missing.dll"), MlirForeign.Next) is (7)
	mutable arguments = List(Number) + (call.entry.payload(call.Flag) is 1 then call.Instance.number else 0)
	for call.Arguments
		let kind = method.parameters(index).typeName
		let number = kind.EndsWith("Text") then library.TextSlot(value.text) else value.number
		arguments = arguments + (MlirForeign.IsNumbers(kind) then library.NumbersSlot(Numbers(value.items)) else number)
	arguments
Converted(library Library, returnType Text, bits Number) VmValue
	Adding.Converted(Library("missing.dll"), "Strict/Number", 3).number is 3
	Adding.Converted(Library("missing.dll"), "Strict/Boolean", 0).kind is "Boolean"
	if returnType.EndsWith("Boolean")
		return VmValue.OfBoolean(bits is not 0)
	if returnType.EndsWith("Text")
		return VmValue.OfText(library.TextResult(bits))
	if MlirForeign.IsRows(returnType)
		return Rows(library, bits)
	MlirForeign.IsNumbers(returnType) then Elements(library.NumbersResult(bits)) else VmValue.OfNumber(bits)
Rows(library Library, bits Number) VmValue
	Adding.Rows(Library("missing.dll"), Library("missing.dll").NumbersSlot(List(Number))).items.Length is 0
	mutable rows = List(Mutable(VmValue))
	for library.NumbersResult(bits)
		rows.Add(Elements(library.NumbersResult(value)))
	VmValue.OfList(rows)
Elements(numbers Numbers) VmValue
	Adding.Elements((1, 2)).items.Length is 2
	mutable items = List(Mutable(VmValue))
	for numbers
		items.Add(VmValue.OfNumber(value))
	VmValue.OfList(items)
Folder(type TypeEntry) Text
	Adding.Folder(Adder) is "Examples/NativeAdd/native"
	Foreign(Invocation.AddCall, List(TypeEntry), "Examples/NativeAdd").Folder(Shorter) is "Examples/NativeAdd/native"
	let file = type.Name.IndexOf("/") < 0 then folder + "/" + type.Source else type.Source
	let parent = Path(file).PathOnly.text
	parent is "" then "native" else parent + "/native"
Numbers(values List(VmValue)) Numbers
	Adding.Numbers((VmValue.OfNumber(1), VmValue.OfNumber(2))) is (1, 2)
	for values
		value.number
Hosted VmValue
	Calling.Hosted.number is not 3
	Calling.Hosted.kind is "Strict/Error"
	let library = Library(call.Instance.Member(0).text)
	let name = call.MethodName
	if name is not in ("Call", "TextSlot", "NumbersSlot")
		return Copied(library, name, call.Arguments.First.number)
	let result = Raw(library, name)
	if result is Error
		return VmValue.OfError(result.Name.text)
	VmValue.OfNumber(result)
Raw(library Library, name Text) Number
	Calling.Raw(Library("missing.dll"), "Call") is Error
	let argument = call.Arguments.First
	if name is "Call"
		return library.Call(argument.text, Numbers(call.Arguments.Last.items))
	name is "TextSlot" then library.TextSlot(argument.text) else library.NumbersSlot(Numbers(argument.items))
Copied(library Library, name Text, bits Number) VmValue
	Adding.Copied(Library("missing.dll"), "Failure", 3).text is ""
	if name is "TextResult"
		return VmValue.OfText(library.TextResult(bits))
	name is "Failure" then VmValue.OfText(library.Failure(bits)) else Elements(library.NumbersResult(bits))