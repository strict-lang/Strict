has logger
has root Text
constant Sample = Forwarding(Logger, "Compiler/output")
constant Server = Resident("Compiler/output")
constant Missing = Forwarding(Logger, "Compiler/output/Missing")
constant Dropped = -3
constant Output = "/server.log"
constant Errors = "/server.errors.log"
constant Previous = "/server.previous"
constant Starting = "-NoProfile -Command Start-Process -FilePath cmd -ArgumentList '/c "
constant Quote = "\\\""
constant Finding = "-NoProfile -Command Get-CimInstance Win32_Process | Where-Object { $_.ExecutablePath -eq '"
constant Serving = "' -and $_.CommandLine -like '* serve*' } | ForEach-Object { taskkill /F /T /PID $_.ProcessId }"
constant Searching = "-c 'for found in $(pgrep -f \""
constant Ending = " [s]erve\"); do pkill -KILL -P $found; kill -KILL $found; done'"
Forwarded(arguments Texts) Number
	Sample.Forwarded(List(Text) + "format") is -1
	if IsForwarded(arguments) is false
		return -1
	arguments(0) is Resident.Stopping then Stopped else Slotted(arguments, 0)
Slotted(arguments Texts, slot Number) Number
	Missing.Slotted(List(Text) + "test", Resident.Servers) is -1
	if slot >= Resident.Servers
		return -1
	let server = Resident(root, slot is 0 then "" else slot to Text)
	let stamp = File(server.Stamped)
	let stamped = stamp.Exists then stamp.ReadLines.First to Number else 0
	let port = stamped is Error then 0 else stamped
	if File(server.Freed).Exists and (port > 0)
		return Answered(server, port, arguments)
	let isDead = (port is 0) or IsDead(port)
	isDead then Started(server.slot) else Slotted(arguments, slot + 1)
IsDead(port Number) Boolean
	Sample.IsDead(0)
	let socket = Socket.Connect("127.0.0.1", port)
	if socket is Error
		return true
	Socket.Close(socket)
	false
Answered(server Resident, port Number, arguments Texts) Number
	Sample.Answered(Server, 0, List(Text) + "test") is -1
	let socket = Socket.Connect("127.0.0.1", port)
	if socket is Error
		File(server.Stamped).Delete
		return -1
	let claim = Claimed(server, socket)
	let request = Resident.Request(Directory.Current, arguments, Resident.Variables, claim)
	let code = (claim is not "") and Greeted(socket) and Server.Sent(socket, request) then Streamed(socket) else -1
	Socket.Close(socket)
	if (code is -1) and (claim is not "")
		File(server.Freed + "." + claim).Rename(server.Freed)
	code is Dropped then Interrupted(server, port) else code
Interrupted(server Resident, port Number) Number
	Missing.Interrupted(Resident("Compiler/output/Missing"), 0) is 1
	let stamp = File(server.Stamped)
	if stamp.Exists and (stamp.ReadLines.First is (port to Text))
		return -1
	logger.Log("strict stop ended this request")
	1
Stopped Number
	Missing.Stopped is 0
	Directory.Files(root + "/obj", "strict.server*").Length is 0 then 0 else Killed
Killed Number
	let isWindows = Process.OperatingSystem is "Windows"
	for Directory.Files(root + "/obj", "strict.server*")
		File(value).Delete
	Process.RunTool(isWindows then "powershell" else "sh", Killing(Process.Current.executable, isWindows))
	for Directory.Files(root + "/obj", "strict.server*") + Directory.Files(root + "/obj", "strict.free*")
		File(value).Delete
	0
Killing(executable Text, isWindows Boolean) Text
	Forwarding.Killing("C:/a/strict.exe", true) is Finding + "C:\\a\\strict.exe" + Serving
	Forwarding.Killing("/a/strict", false) is Searching + "/a/strict" + Ending
	isWindows then Finding + executable.Replace("/", "\\") + Serving else Searching + executable + Ending
IsForwarded(arguments Texts) Boolean
	Sample.IsForwarded(List(Text) + "format") is false
	Sample.IsForwarded(("build", "a.strict")) or (Process.Variable("STRICT_SERVER") is "0")
	Sample.IsForwarded(List(Text) + "stop")
	Sample.IsForwarded(("test", "a.strict")) or (Process.Variable("STRICT_SERVER") is "0")
	Sample.IsForwarded(("test", "a.strict", "native")) is false
	let command = arguments.Length > 0 then arguments(0) else ""
	let isLocal = ("native" is in arguments) or ("lines" is in arguments) or ("-" is in arguments)
	let isOptedOut = Process.Variable("STRICT_SERVER") is "0"
	let isServed = (command is in ("test", "check", "build")) and (isLocal is false) and (isOptedOut is false)
	(command is Resident.Stopping) or isServed
Started(slot Text) Number
	let executable = Process.Current.executable
	let isWindows = Process.OperatingSystem is "Windows"
	let served = " serve " + slot + Logged(root + "/obj", isWindows, slot)
	let hidden = Starting + Quote + Quote + executable + Quote + served + Quote + "' -WindowStyle Hidden"
	let detached = isWindows then hidden else "-c \"nohup '" + executable + "'" + served + " &\""
	Process.RunTool(isWindows then "powershell" else "sh", detached)
	-1
Logged(objects Text, isWindows Boolean, slot Text) Text
	Sample.Logged("Compiler", true, "").EndsWith(" 2>" + Quote + "Compiler/server.errors.log" + Quote)
	Sample.Logged("Compiler", false, "2") is " >'Compiler/server2.log' 2>'Compiler/server2.errors.log'"
	let hasObjects = Directory.Exists(objects) or Directory.Create(objects)
	let output = Output.Replace("server", "server" + slot)
	let errors = Errors.Replace("server", "server" + slot)
	Kept(objects, output)
	Kept(objects, errors)
	if hasObjects is false
		return isWindows then "" else " >/dev/null 2>&1"
	let mark = isWindows then Quote else "'"
	" >" + mark + objects + output + mark + " 2>" + mark + objects + errors + mark
Kept(objects Text, log Text) Boolean
	Missing.Kept("Compiler/output/Missing", Output) is false
	let previous = objects + log.Replace("/server", Previous)
	File(previous).Delete
	File(objects + log).Exists and File(objects + log).Rename(previous)
Claimed(server Resident, socket Number) Text
	Sample.Claimed(Server, 0) is ""
	let port = Socket.Port(socket)
	if port is Error
		return ""
	File(server.Freed).Rename(server.Freed + "." + port)
	File(server.Freed + "." + port).Exists then port to Text else ""
Greeted(socket Number) Boolean
	Sample.Greeted(0) is false
	let waited = Socket.Waiting(socket, Resident.GreetingSeconds)
	if (waited is Error) or (waited is not 1)
		return false
	let greeting = Resident.Greeting
	ByteEncoder(Socket.Receive(socket, greeting.Length)).Spelled(0, greeting.Length) is greeting
Streamed(socket Number) Number
	Sample.Streamed(0) is Dropped
	let exiting = Resident.Exiting
	mutable code = -2
	for as long as code is -2
		let block = Server.Received(socket, "\n")
		code = block.EndsWith("\n") then code else Dropped
		for block.Split("\n")
			let isExit = value.StartsWith(exiting)
			if (isExit is false) and (index < block.Split("\n").Length - 1)
				logger.Log(value)
			code = isExit then value.Substring(exiting.Length, value.Length - exiting.Length) to Number else code
	code
Loopback Slow(Number)
	let server = Socket.Local(0)
	let client = Socket.Connect("127.0.0.1", Socket.Port(server))
	let accepted = Socket.Accept(server)
	Server.Sent(client, Resident.Request(Directory.Current, ("test", "a.strict")))
	let isRequested = Resident.Arguments(Server.Requested(accepted)) is ("test", "a.strict")
	Server.Finished(accepted, 3)
	let code = isRequested and Greeted(client) then Streamed(client) else 1
	Socket.Close(client)
	Socket.Close(server)
	code
