has method Bytecode/MethodEntry
has position Number
has registers List(VmValue)
has locals
constant Start = Frame(MethodEntry.HelloRun, 0, List(VmValue), Locals.Empty)
constant Looped = Start.WithLocal("#loop", VmValue.OfList(VmValue.None, VmValue.None, VmValue.None, VmValue.OfNumber(2), VmValue.OfNumber(7)))
Instruction InstructionEntry
	Start.Instruction.kind is InstructionType.Print
	method.instructions(position)
Register(number Number) VmValue
	Start.WithRegister(1, VmValue.OfNumber(5)).Register(1).number is 5
	Start.Register(3).kind is "None"
	number < registers.Length then registers(number) else VmValue.None
WithRegister(number Number, entry VmValue) Frame
	Start.WithRegister(0, VmValue.OfNumber(5)).registers.Length is 1
	Frame(method, position, locals.Replaced(registers, number, entry), locals)
WithLocal(name Text, entry VmValue) Frame
	Start.WithLocal("a", VmValue.OfNumber(5)).locals.Get("a").number is 5
	Frame(method, position, registers, locals.With(name, entry))
NextWithRegister(number Number, entry VmValue) Frame
	Start.NextWithRegister(1, VmValue.OfNumber(5)).Register(1).number is 5
	Frame(method, position + 1, locals.Replaced(registers, number, entry), locals)
NextWithLocal(name Text, entry VmValue) Frame
	Start.NextWithLocal("a", VmValue.OfNumber(5)).position is 1
	Frame(method, position + 1, registers, locals.With(name, entry))
At(target Number) Frame
	Start.At(1).position is 1
	Frame(method, target, registers, locals)
Next Frame
	Start.Next.position is 1
	Frame(method, position + 1, registers, locals)
Local(name Text) VmValue
	Start.WithLocal("b", VmValue.OfText("x")).Local("b").text is "x"
	Looped.Local("outer").number is 7
	Looped.Local("outer.index").number is 2
	let found = locals.Get(name)
	if (found.kind is not "None") or (name.StartsWith("outer") is false)
		return found
	locals.Get("#loop").items(name is "outer" then 4 else 3)