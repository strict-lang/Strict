has machine Machine
has method Bytecode/MethodEntry
has owner Text = ""
has depth Number = 0
constant ThisSlot = 0
constant ValueSlot = 1
constant ResultSlot = 2
constant FlagSlot = 3
constant LoopSlot = 4
constant IndexSlot = 5
constant MembersSlot = 6
constant Doubling = Machine(Resolver(List(TypeEntry) + Machine.Doubler).Resolved)
constant Twice = Frame(Doubling, Doubling.types.First.methods.First, "Strict/Doubler")
constant Calling = Frame(Machine(Resolver(List(TypeEntry) + Invocation.Failing).Resolved), MethodEntry("Run", List(MemberEntry), "None", List(InstructionEntry) + InstructionEntry.Invoke(0, ("Strict/Failing", "Fail", "Strict/Number"), List(Number), -1)), "Strict/Caller")
constant Listed = (VmValue.OfText("ab"), VmValue.OfText("a"), VmValue.None, VmValue.OfBoolean(true), Looping.Counting, VmValue.None, VmValue.OfNumber(1), VmValue.OfList(VmValue.OfNumber(10), VmValue.OfNumber(20)), VmValue.OfNumber(5))
Finished(arguments List(VmValue)) List(VmValue)
	Twice.Finished(Listed).Index(VmValue.OfNumber(42)) is ResultSlot
	mutable slots = List(VmValue) + arguments
	mutable position = 0
	let instructions = method.instructions
	for Machine.MaxSteps
		if position >= instructions.Length
			return slots
		let entry = instructions(position)
		let target = entry.Target
		slots(target) = Value(entry, position, slots)
		position = entry.kind < InstructionType.Return then position + 1 else Next(entry, position, slots)
	slots
Value(entry InstructionEntry, position Number, slots List(VmValue)) VmValue
	Twice.Value(InstructionEntry(InstructionType.LoadVariableToRegister, "a", (6, 8)), 0, Listed).number is 5
	Twice.Value(InstructionEntry.Binary(InstructionType.LessThan, (6, 8)), 0, Listed).IsTrue
	if entry.kind is InstructionType.LoadVariableToRegister
		return Local(entry.payload(1), slots)
	if entry.kind < InstructionType.StoreSeparator
		return Stored(entry, slots, position)
	if entry.kind < InstructionType.BinaryOperatorsSeparator
		return Operations.Result(entry.kind, slots(entry.payload(1)), slots(entry.payload(2)))
	Other(entry, slots, position)
Next(entry InstructionEntry, position Number, slots List(VmValue)) Number
	Twice.Next(InstructionEntry(InstructionType.JumpToIdIfTrue, List(Text), (0, 7)), 1, Listed) is 7
	if (entry.kind < InstructionType.Return) or (entry.kind > InstructionType.JumpToIdIfTrue)
		return ErrorCheck(entry).Next(position, slots, method.instructions.Length)
	if entry.kind is InstructionType.Return
		return method.instructions.Length
	if entry.kind is InstructionType.LoopBegin
		return Entered(entry, slots, position)
	let linked = entry.payload.Last
	if entry.kind is InstructionType.LoopEnd
		return Looping.Next(slots(LoopSlot), position, linked)
	let isTaken = slots(FlagSlot).IsTrue is (entry.kind is InstructionType.JumpToIdIfTrue)
	(entry.kind >= InstructionType.JumpToIdIfFalse) and isTaken then linked else position + 1
Stored(entry InstructionEntry, slots List(VmValue), position Number) VmValue
	Twice.Stored(Twice.method.instructions(0), Listed, 0).number is 21
	Twice.Stored(InstructionEntry(InstructionType.StoreRegisterToVariable, "a", (6, 8)), Listed, 0).number is 1
	if entry.kind is InstructionType.LoadConstantToRegister
		return entry.payload(1) is 1 then VmValue.OfNumber(entry.payload(2)) else PayloadDecoder(entry).Value(1)
	if entry.kind is InstructionType.StoreConstantToVariable
		return entry.payload(0) is 1 then VmValue.OfNumber(entry.payload(1)) else PayloadDecoder(entry).Value(0)
	if entry.kind is InstructionType.IndexCall
		return Indexed(entry, slots, position)
	entry.payload.Length < 3 then slots(entry.payload(0)) else Written(entry, slots)
Written(entry InstructionEntry, slots List(VmValue)) VmValue
	Twice.Written(Storage.StoreSecond, Listed).items(1).number is 1
	let index = entry.payload(2)
	let position = index is Resolver.LiteralIndex then entry.payload(3) else Local(index, slots).number
	let target = PayloadDecoder(entry).ElementParts.First
	Storage(machine.types).Written(slots(entry.payload(1)), target, position, slots(entry.payload(0)))
Local(slot Number, slots List(VmValue)) VmValue
	Twice.Local(ResultSlot, Listed).kind is "None"
	Twice.Local(IndexSlot, Listed).number is 0
	Twice.Local(Resolver.OuterSlot, Listed).text is "a"
	if (slot > IndexSlot) or ((slot >= 0) and (slot is not ValueSlot) and (slot is not IndexSlot))
		return slots(slot)
	let state = slots(LoopSlot)
	let isIndex = (slot is IndexSlot) or (slot is Resolver.OuterIndexSlot)
	if (slot > 0) and (state.items.Length > 0)
		return state.items(isIndex then 2 else 3)
	Looping.Current(state, slot < 0, isIndex, slots(isIndex then IndexSlot else ValueSlot))
Indexed(entry InstructionEntry, slots List(VmValue), position Number) VmValue
	Twice.Indexed(InstructionEntry(InstructionType.IndexCall, "list", (6, 6, 7)), Listed, 0).number is 20
	Twice.Indexed(InstructionEntry(InstructionType.IndexCall, "a", (6, 8, 7)), Listed, 0).Traces.Length > 0
	let collection = Local(entry.payload(2), slots)
	let wrapped = Accessor(machine).Wrapped(collection, slots(entry.payload(1)).number)
	wrapped < 0 then Traced(VmValue.OfError("IndexOutOfRange"), position) else Accessor(machine).Item(collection, wrapped)
Invoked(entry InstructionEntry, slots List(VmValue), position Number) VmValue
	Calling.Invoked(Calling.method.instructions.First, Listed, 0).Traces.IndexOf("at Caller.Run") > 0
	let call = Called(entry, slots)
	let accessed = Accessor(machine).Accessed(call)
	let result = accessed.kind is "None" then machine.Call(call) else accessed
	if result.kind is "Error"
		machine.Logged(result.text)
	result.kind is in VmValue.ErrorKinds then Traced(result, position) else result
Called(entry InstructionEntry, slots List(VmValue)) Invocation
	Twice.Called(Invocation.AddCall.entry, (VmValue.OfNumber(3), VmValue.OfNumber(4))).Instance.number is 4
	Twice.Called(Invocation.AddCall.entry, (VmValue.OfNumber(3), VmValue.OfNumber(4))).Arguments.First.number is 3
	let count = 5 + entry.payload(3)
	let flag = count + 1 + entry.payload(count)
	let instance = entry.payload(flag) is 1 then slots(entry.payload(flag + 1)) else slots(ThisSlot)
	mutable arguments = List(Mutable(VmValue))
	for entry.payload(count)
		arguments.Add(slots(entry.payload(count + 1 + index)))
	Invocation(entry, arguments, instance, depth + 1)
Traced(error VmValue, position Number) VmValue
	Twice.Traced(VmValue.OfError("a"), 0).Traces.IndexOf("at Doubler.Twice in Doubler.strict:line") > 0
	Twice.Traced(Twice.Traced(VmValue.OfError("a"), 0), 0).items(1).items.Length is 1
	if error.kind is "Strict/ErrorWithValue"
		return VmValue(error.kind, error.number, error.text, (Traced(error.items(0), position), error.items(1)))
	let called = VmValue.OfText(TypeEntry.ShortName(owner) + "." + method.Name)
	let source = TypeSource(TypeEntry(owner, List(MemberEntry), List(MethodEntry)))
	let file = VmValue.OfText(owner is in machine.sources then machine.sources(owner) else source.Located(machine.folder))
	let trace = VmValue("Strict/Stacktrace", 0, "", (called, file, VmValue.OfNumber(method.instructions(position).line)))
	let traces = error.items(1).items
	let isKept = (traces.Length >= Invocation.MaxTraces) or (traces.Length > 0) and (traces.Last is trace)
	let traced = isKept then error.items(1) else VmValue.OfList(traces + trace)
	VmValue(error.kind, error.number, error.text, (error.items(0), traced))
Looped(entry InstructionEntry, slots List(VmValue), position Number) VmValue
	Twice.Looped(InstructionEntry.LoopBegin(6, 8), Listed, 0).items(3).number is 1
	Twice.Looped(MethodEntry.CountingLoop.instructions(1), Listed, 1).items(2).number is 1
	if entry.kind is InstructionType.LoopEnd
		return Looping.Ended(slots(LoopSlot), (-1 is in entry.payload) and (slots(FlagSlot).IsTrue is false))
	Looping.Begun(slots(LoopSlot), slots(entry.payload(0)), Ending(entry, slots), position)
Entered(entry InstructionEntry, slots List(VmValue), position Number) Number
	Twice.Entered(InstructionEntry.LoopBegin(2, -1), Listed, 0) is 4
	Twice.Entered(MethodEntry.CountingLoop.instructions(0), Listed, 0) is 1
	let isEmpty = Looping.IsEmpty(slots(entry.payload(0)), Ending(entry, slots))
	isEmpty then method.LoopEndOf(position) + 1 else position + 1
Ending(entry InstructionEntry, slots List(VmValue)) VmValue
	Twice.Ending(InstructionEntry.LoopBegin(6, 8), Listed).number is 5
	Twice.Ending(InstructionEntry.LoopBegin(6, -1), Listed).kind is "None"
	entry.payload(1) is 1 then slots(entry.payload(2)) else VmValue.None
Other(entry InstructionEntry, slots List(VmValue), position Number) VmValue
	Twice.Other(InstructionEntry.Return(8), Listed, 0).number is 5
	if entry.kind is InstructionType.Invoke
		return Invoked(entry, slots, position)
	if (entry.kind is InstructionType.LoopBegin) or (entry.kind is InstructionType.LoopEnd)
		return Looped(entry, slots, position)
	if entry.kind is InstructionType.Return
		return slots(entry.payload(0))
	if entry.kind is InstructionType.CheckError
		return ErrorCheck(entry).Value(slots, value, position)
	entry.kind is InstructionType.FieldLoad then machine.Field(entry, slots(entry.payload(1))) else Changed(entry, slots)
Changed(entry InstructionEntry, slots List(VmValue)) VmValue
	Twice.Changed(InstructionEntry(InstructionType.InvokeWriteToList, "list", (8, 7)), Listed).Length is 3
	Twice.Changed(InstructionEntry.Jump(InstructionType.JumpEnd, 0), Listed).kind is "None"
	if entry.kind is InstructionType.InvokeWriteToList
		return VmValue.OfList(slots(entry.payload(1)).items + slots(entry.payload(0)))
	if entry.kind is InstructionType.InvokeRemove
		return Operations.Removed(slots(entry.payload(1)), slots(entry.payload(0)))
	if entry.kind is InstructionType.Print
		return machine.Logged(entry.texts(0) + (entry.payload(1) is 1 then slots(entry.payload(2)) to Text else ""))
	VmValue.None