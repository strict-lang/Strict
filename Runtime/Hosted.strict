has call Invocation
constant SystemCall = Invocation(InstructionEntry.Invoke(0, ("Strict/Process", "OperatingSystem", "Strict/Text"), List(Number), -1), Frame(MethodEntry.HelloRun, 0, List(VmValue), Locals.Empty))
constant Current = Frame(MethodEntry.HelloRun, 0, List(VmValue) + VmValue.OfText("."), Locals.Empty)
constant Existing = Invocation(InstructionEntry.Invoke(1, ("Strict/Directory", "Exists", "Strict/Boolean", "path"), 0, -1), Current)
constant Listing = Invocation(InstructionEntry.Invoke(1, ("Strict/Directory", "Directories", "Strict/List(Text)", "path"), 0, -1), Current)
constant Reading = Invocation(InstructionEntry.Invoke(1, ("Strict/File", "ReadBytes", "Strict/List(Byte)"), List(Number), 0), Current.WithRegister(0, VmValue("Strict/File", 0, "", List(VmValue) + VmValue.OfText("Any.strict"))))
constant Dating = Invocation(InstructionEntry.Invoke(1, ("Strict/File", "Modified", "Strict/Number"), List(Number), 0), Reading.frame)
constant Probing = Invocation(InstructionEntry.Invoke(1, ("Strict/File", "Exists", "Strict/Boolean"), List(Number), 0), Current)
constant Timing = Invocation(InstructionEntry.Invoke(0, ("Strict/Process", "Elapsed", "Strict/Number"), List(Number), -1), Current)
constant Logging = Invocation(InstructionEntry.Invoke(1, ("Strict/Number", "Logarithm", "Strict/Number"), List(Number), 0), Current.WithRegister(0, VmValue.OfNumber(1)))
constant Sine = Invocation(InstructionEntry.Invoke(1, ("Strict/Math/Degrees", "Sin", "Strict/Math/Ratio"), List(Number), 0), Current.WithRegister(0, VmValue.OfNumber(90)))
constant Methods = ("File.ReadLines", "File.Exists", "File.Write", "File.Delete", "File.ReadBytes", "File.WriteLines", "File.WriteBytes", "File.Modified", "Directory.Files", "Directory.Directories", "Directory.Exists", "Directory.Create", "Process.Find", "Process.RunTool", "Process.OperatingSystem", "Process.Current", "Process.Built", "Process.Elapsed", "Number.Logarithm", "Number.Random", "Degrees.Sin", "Degrees.Cos", "Degrees.Tan", "Ratio.Asin", "Ratio.Acos", "Ratio.Atan", "Vector2.Atan")
IsHosted Boolean
	Hosted(SystemCall).IsHosted is true
	Hosted(Invocation.AddCall).IsHosted is false
	TypeEntry.ShortName(call.TypeName) + "." + call.MethodName is in Methods
Result VmValue
	Hosted(SystemCall).Result.text is in ("Windows", "Linux", "MacOS", "Unknown")
	Hosted(Existing).Result.IsTrue is true
	Hosted(Timing).Result.number > 0 is true
	let type = TypeEntry.ShortName(call.TypeName)
	if type is "Process"
		return Processed
	if type is not in ("File", "Directory")
		return Measured
	call.MethodName is in ("ReadLines", "ReadBytes", "Files", "Directories") then Entries else Stored
Processed VmValue
	Hosted(SystemCall).Processed.text is in ("Windows", "Linux", "MacOS", "Unknown")
	let name = call.MethodName
	if name is "Elapsed"
		return VmValue.OfNumber(Process.Elapsed)
	if name is in ("OperatingSystem", "Built")
		return VmValue.OfText(name is "Built" then Process(call.Instance.Member(0).text).Built else Process.OperatingSystem)
	let first = name is "Current" then Process.Current.executable else call.Arguments.First.text
	if name is in ("Find", "Current")
		return VmValue("Strict/Process", 0, "", List(VmValue) + VmValue.OfText(Process.Find(first).executable))
	let result = Process.RunTool(first, call.Arguments.Last.text)
	let code = VmValue.OfNumber(result.exitCode)
	VmValue("Strict/ProcessResult", 0, "", (code, VmValue.OfText(result.Output), VmValue.OfText(result.error)))
Stored VmValue
	Hosted(Existing).Stored.IsTrue is true
	let path = Location
	if call.MethodName is "Write"
		if "bytes" is in call.ParameterNames
			File(path).Write(BytesOf(call.Arguments.First))
		else
			File(path).Write(TextsOf(call.Arguments.First))
	if call.MethodName is "Delete"
		File(path).Delete
	if call.MethodName is "Create"
		Directory.Create(path)
	Answered(path)
Answered(path Text) VmValue
	Hosted(Existing).Answered(".").IsTrue is true
	Hosted(Probing).Answered(".").IsTrue is false
	Hosted(Dating).Answered("Any.strict").number > 1.7e9 is true
	if call.MethodName is "Modified"
		return VmValue.OfNumber(File(path).Modified)
	let exists = call.TypeName is "Strict/Directory" then Directory.Exists(path) else File(path).Exists
	call.MethodName is "Exists" then VmValue.OfBoolean(exists) else VmValue.None
Entries VmValue
	Hosted(Listing).Entries.Length > 0 is true
	Hosted(Reading).Entries.items.First.number is 102
	let path = Location
	if call.MethodName is "ReadLines"
		return Values(File(path).ReadLines)
	if call.MethodName is "ReadBytes"
		return ByteValues(File(path).ReadBytes)
	let pattern = call.Arguments.Length > 1 then call.Arguments.Last.text else ""
	Values(call.MethodName is "Files" then Directory.Files(path, pattern) else Directory.Directories(path))
Values(texts Texts) VmValue
	Hosted(Listing).Values(("a", "b")).Length is 2
	mutable values = List(Mutable(VmValue))
	for texts
		values.Add(VmValue.OfText(value))
	VmValue.OfList(values)
ByteValues(bytes Bytes) VmValue
	Hosted(Listing).ByteValues(List(Byte) + Byte(7)).items.First.number is 7
	mutable values = List(Mutable(VmValue))
	for bytes
		values.Add(VmValue.OfNumber(value.number))
	VmValue.OfList(values)
BytesOf(content VmValue) Bytes
	Hosted(Listing).BytesOf(VmValue.OfList(List(VmValue) + VmValue.OfNumber(7))) is List(Byte) + Byte(7)
	for content.items
		Byte(value.number)
TextsOf(content VmValue) Texts
	Hosted(Listing).TextsOf(VmValue.OfList(List(VmValue) + VmValue.OfText("a"))) is ("a")
	for content.items
		value.text
Location Text
	Hosted(Existing).Location is "."
	TypeEntry.ShortName(call.TypeName) is "File" then call.Instance.Member(0).text else call.Arguments.First.text
Measured VmValue
	Hosted(Sine).Measured.number is 1
	Hosted(Logging).Measured.number is 0
	let type = TypeEntry.ShortName(call.TypeName)
	let number = call.Instance.number
	if type is "Number"
		return VmValue.OfNumber(call.MethodName is "Logarithm" then number.Logarithm else number.Random)
	if type is "Degrees"
		return VmValue.OfNumber(Turned(Degrees(number)).number)
	if type is "Vector2"
		return VmValue.OfNumber(Aimed(Vector2(call.Instance.items.First.number, call.Instance.items.Last.number)))
	VmValue.OfNumber(Inverted(Ratio(number)).number)
Turned(angle Math/Degrees) Math/Ratio
	Hosted(Sine).Turned(Degrees(90)).number is 1
	call.MethodName is "Sin" then angle.Sin else call.MethodName is "Cos" then angle.Cos else angle.Tan
Inverted(ratio Math/Ratio) Math/Degrees
	Hosted(Sine).Inverted(Ratio(1)).number is 45
	call.MethodName is "Asin" then ratio.Asin else call.MethodName is "Acos" then ratio.Acos else ratio.Atan
Aimed(vector Math/Vector2) Number
	Hosted(Sine).Aimed(Vector2(1, 0)) is 90
	vector.Atan.number
