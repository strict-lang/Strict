has call Invocation
constant SystemCall = Invocation(InstructionEntry.Invoke(0, ("Strict/Process", "OperatingSystem", "Strict/Text"), List(Number), -1), List(VmValue), VmValue.None)
constant Current = List(VmValue) + VmValue.OfText(".")
constant Existing = Invocation(InstructionEntry.Invoke(1, ("Strict/Directory", "Exists", "Strict/Boolean", "path"), 0, -1), Current, VmValue.None)
constant Listing = Invocation(InstructionEntry.Invoke(1, ("Strict/Directory", "Directories", "Strict/List(Text)", "path"), 0, -1), Current, VmValue.None)
constant AnyFile = VmValue("Strict/File", 0, "", List(VmValue) + VmValue.OfText("Any.strict"))
constant Reading = Invocation(InstructionEntry.Invoke(1, ("Strict/File", "ReadBytes", "Strict/List(Byte)"), List(Number), 0), List(VmValue), AnyFile)
constant Dating = Invocation(InstructionEntry.Invoke(1, ("Strict/File", "Modified", "Strict/Number"), List(Number), 0), List(VmValue), AnyFile)
constant Probing = Invocation(InstructionEntry.Invoke(1, ("Strict/File", "Exists", "Strict/Boolean"), List(Number), 0), List(VmValue), VmValue.OfText("."))
constant Timing = Invocation(InstructionEntry.Invoke(0, ("Strict/Process", "Elapsed", "Strict/Number"), List(Number), -1), List(VmValue), VmValue.None)
constant Logging = Invocation(InstructionEntry.Invoke(1, ("Strict/Number", "Logarithm", "Strict/Number"), List(Number), 0), List(VmValue), VmValue.OfNumber(1))
constant Sine = Invocation(InstructionEntry.Invoke(1, ("Strict/Math/Degrees", "Sin", "Strict/Math/Ratio"), List(Number), 0), List(VmValue), VmValue.OfNumber(90))
constant Aiming = Invocation(InstructionEntry.Invoke(1, ("Strict/Math/Vector2", "Atan", "Strict/Number"), List(Number), 0), List(VmValue), VmValue("Strict/Math/Vector2", 0, "", (VmValue.OfNumber(1), VmValue.OfNumber(0))))
constant Deleting = Invocation(InstructionEntry.Invoke(1, ("Strict/File", "Delete", "None"), List(Number), 0), List(VmValue), VmValue("Strict/File", 0, "", List(VmValue) + VmValue.OfText("Runtime/missing")))
constant Methods = ("File.ReadLines", "File.Exists", "File.Write", "File.Delete", "File.Rename", "File.ReadBytes", "File.WriteLines", "File.WriteBytes", "File.Modified", "File.Length", "Directory.Files", "Directory.Directories", "Directory.Exists", "Directory.Create", "Directory.Current", "File.InMemory", "Process.Input", "Process.InputLine", "Process.Find", "Process.RunTool", "Process.RunTools", "Process.Started", "Process.OperatingSystem", "Process.Current", "Process.Built", "Process.Elapsed", "Process.Wait", "Process.FilesRead", "Time.Now", "Number.Logarithm", "Number.Random", "Degrees.Sin", "Degrees.Cos", "Degrees.Tan", "Ratio.Asin", "Ratio.Acos", "Ratio.Atan", "Vector2.Atan", "Library.Call", "Library.TextSlot", "Library.NumbersSlot", "Library.TextResult", "Library.NumbersResult", "Library.Failure", "BuildProfile.Detailed", "TestBudget.Started", "TestBudget.Finished", "TestBudget.Extended", "ConstantCache.At", "ConstantCache.Stored")
IsHosted Boolean
	Hosted(SystemCall).IsHosted
	Hosted(Invocation.AddCall).IsHosted is false
	"Process.InputLine" is in Hosted.Methods
	TypeEntry.ShortName(call.TypeName) + "." + call.MethodName is in Methods
Result VmValue
	Hosted(SystemCall).Result.text is in ("Windows", "Linux", "MacOS", "Unknown")
	Hosted(Existing).Result.IsTrue
	Hosted(Timing).Result.number > 0
	let type = TypeEntry.ShortName(call.TypeName)
	if (call.MethodName is in ("Input", "InputLine")) or (type is "Directory") and (call.MethodName is "Current")
		return VmValue.OfText(Read(call.MethodName))
	if type is in ("Process", "Library", "BuildProfile", "TestBudget", "ConstantCache")
		return type is "Library" then Foreign(call, List(TypeEntry)).Hosted else HostedProcess(call).Result
	if type is not in ("File", "Directory")
		return type is "Time" then VmValue.OfNumber(Time.Now) else Measured
	call.MethodName is in ("ReadLines", "ReadBytes", "Files", "Directories") then Entries else Stored
Read(name Text) Text
	Hosted(SystemCall).Read("Current") is Directory.Current
	if name is "Input"
		return Process.Input
	name is "InputLine" then Process.InputLine else Directory.Current
Processed VmValue
	Hosted(SystemCall).Processed.text is in ("Windows", "Linux", "MacOS", "Unknown")
	let name = call.MethodName
	if name is "Detailed"
		return VmValue.OfBoolean(BuildProfile.Detailed)
	if name is in ("Elapsed", "FilesRead")
		return name is "Elapsed" then VmValue.OfNumber(Process.Elapsed) else Values(Process.FilesRead)
	if name is in ("OperatingSystem", "Built")
		return VmValue.OfText(name is "Built" then Process(call.Instance.Member(0).text).Built else Process.OperatingSystem)
	let first = name is "Current" then Process.Current.executable else call.Arguments.First.text
	if name is in ("Find", "Current")
		return VmValue("Strict/Process", 0, "", List(VmValue) + VmValue.OfText(Process.Find(first).executable))
	HostedProcess(call).Resulted(Process.RunTool(first, call.Arguments.Last.text))
Stored VmValue
	Hosted(Existing).Stored.IsTrue
	if call.MethodName is "Write"
		if "bytes" is in call.ParameterNames
			File(Location).Write(BytesOf(call.Arguments.First))
		else
			File(Location).Write(TextsOf(call.Arguments.First))
	if call.MethodName is in ("Delete", "Rename", "InMemory")
		return Moved
	if call.MethodName is "Create"
		let created = Directory.Create(Location)
		return created is Error then VmValue.OfError("DirectoryNotCreated") else VmValue.OfBoolean(created)
	Answered(Location)
Moved VmValue
	Hosted(Deleting).Moved.IsTrue is false
	if call.MethodName is "Delete"
		File(Location).Delete
	else if call.MethodName is "InMemory"
		File(Location).InMemory(call.Arguments.First.text)
	else
		File(Location).Rename(call.Arguments.First.text)
	Answered(Location)
Answered(path Text) VmValue
	Hosted(Existing).Answered(".").IsTrue
	Hosted(Probing).Answered(".").IsTrue is false
	Hosted(Dating).Answered("Any.strict").number > 1.7e9
	File("Any.strict").Length is File("Any.strict").ReadBytes.Length
	if call.MethodName is in ("Modified", "Length")
		return VmValue.OfNumber(call.MethodName is "Modified" then File(path).Modified else File(path).Length)
	let exists = call.TypeName is "Strict/Directory" then Directory.Exists(path) else File(path).Exists
	call.MethodName is "Exists" then VmValue.OfBoolean(exists) else VmValue.None
Entries Slow(VmValue)
	Hosted(Listing).Entries.Length > 0
	Hosted(Reading).Entries.items.First.number is 102
	let path = Location
	if call.MethodName is "ReadLines"
		return Values(File(path).ReadLines)
	if call.MethodName is "ReadBytes"
		return ByteValues(File(path).ReadBytes)
	let pattern = call.Arguments.Length > 1 then call.Arguments.Last.text else ""
	Values(call.MethodName is "Files" then Directory.Files(path, pattern) else Directory.Directories(path))
Values(texts Texts) VmValue
	Hosted(Listing).Values(("a", "b")).Length is 2
	mutable values = List(Mutable(VmValue))
	for texts
		values.Add(VmValue.OfText(value))
	VmValue.OfList(values)
ByteValues(bytes Bytes) VmValue
	Hosted(Listing).ByteValues(List(Byte) + Byte(7)).items.First.number is 7
	mutable values = List(Mutable(VmValue))
	for bytes
		values.Add(VmValue.OfNumber(value.number))
	VmValue.OfList(values)
BytesOf(content VmValue) Bytes
	Hosted(Listing).BytesOf(VmValue.OfList(List(VmValue) + VmValue.OfNumber(7))) is List(Byte) + Byte(7)
	for content.items
		Byte(value.number)
TextsOf(content VmValue) Texts
	Hosted(Listing).TextsOf(VmValue.OfList(List(VmValue) + VmValue.OfText("a"))) is ("a")
	for content.items
		value.text
Location Text
	Hosted(Existing).Location is "."
	TypeEntry.ShortName(call.TypeName) is "File" then call.Instance.Member(0).text else call.Arguments.First.text
Measured VmValue
	Hosted(Sine).Measured.number is 1
	Hosted(Logging).Measured.number is 0
	Hosted(Aiming).Measured.number is 90
	let type = TypeEntry.ShortName(call.TypeName)
	let number = call.Instance.number
	if type is "Number"
		return VmValue.OfNumber(call.MethodName is "Logarithm" then number.Logarithm else number.Random)
	if type is "Degrees"
		return VmValue.OfNumber(Turned(Degrees(number)).number)
	if type is "Vector2"
		return VmValue.OfNumber(Vector2(call.Instance.items.First.number, call.Instance.items.Last.number).Atan.number)
	VmValue.OfNumber(Inverted(Ratio(number)).number)
Turned(angle Math/Degrees) Math/Ratio
	Hosted(Sine).Turned(Degrees(90)).number is 1
	call.MethodName is "Sin" then angle.Sin else call.MethodName is "Cos" then angle.Cos else angle.Tan
Inverted(ratio Math/Ratio) Math/Degrees
	Hosted(Sine).Inverted(Ratio(1)).number is 45
	call.MethodName is "Asin" then ratio.Asin else call.MethodName is "Acos" then ratio.Acos else ratio.Atan