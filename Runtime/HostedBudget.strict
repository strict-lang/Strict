has call Invocation
constant Overran = HostedBudget(Invocation(InstructionEntry.Invoke(2, ("Strict/Runtime/Core/TestBudget", "Overran", "Strict/Text", "elapsed", "place"), (0, 1), -1), List(VmValue), VmValue.None))
constant Busy = HostedBudget(Invocation(InstructionEntry.Invoke(2, ("Strict/Runtime/Core/TestBudget", "Busy", "Strict/Number", "depth", "step"), (0, 1), -1), List(VmValue), VmValue.None))
constant Overrun = HostedBudget(Invocation(InstructionEntry.Invoke(1, ("Strict/Runtime/Core/TestBudget", "Overrun", "Strict/Number", "elapsed"), 0, -1), List(VmValue), VmValue.None))
constant Finished = HostedBudget(Invocation(InstructionEntry.Invoke(1, ("Strict/Runtime/Core/TestBudget", "Finish", "Strict/Number", "started"), 0, -1), List(VmValue), VmValue.None))
Result VmValue
	TestBudget.Finish(TestBudget.Start("a", false) + TestBudget.Finish(0) * 0) < 9 + TestBudget.Start("", true) * 0
	arguments = call.Arguments
	if call.MethodName is in ("Start", "Watch")
		return VmValue.OfNumber(TestBudget.Watch(arguments(0).text, arguments(1).IsTrue))
	if call.MethodName is "Entered"
		return VmValue.OfNumber(TestBudget.Entered)
	if call.MethodName is "Expired"
		return VmValue.OfText(TestBudget.Expired)
	if call.MethodName is "Left"
		TestBudget.Left(arguments(0).number)
		return VmValue.None
	Measure(arguments)
Measure(arguments List(VmValue)) VmValue
	Overran.Measure((VmValue.OfNumber(5), VmValue.OfText("A"))).text is ""
	Busy.Measure((VmValue.OfNumber(0), VmValue.OfNumber(1))).number is 0
	Overrun.Measure(List(VmValue) + VmValue.OfNumber(5)).number is 0
	Finished.Measure(List(VmValue) + VmValue.OfNumber(0)).kind is "Number"
	if call.MethodName is "Overran"
		return VmValue.OfText(SlowTests.Overran(arguments(0).number, arguments(1).text))
	if call.MethodName is "Busy"
		return VmValue.OfNumber(TestBudget.Busy(arguments(0).number, arguments(1).number))
	elapsed = arguments(0).number
	VmValue.OfNumber(call.MethodName is "Overrun" then SlowTests.Overrun(elapsed) else TestBudget.Finish(elapsed))