has call Invocation
Result VmValue
	TestBudget.Finished(TestBudget.Started("a", false) + TestBudget.Finished(0) * 0) < 9 + TestBudget.Started("", true) * 0
	arguments = call.Arguments
	if call.MethodName is in ("Started", "Watched")
		return VmValue.OfNumber(TestBudget.Watched(arguments(0).text, arguments(1).IsTrue))
	if call.MethodName is "Entered"
		return VmValue.OfNumber(TestBudget.Entered)
	if call.MethodName is "Expired"
		return VmValue.OfText(TestBudget.Expired)
	if call.MethodName is "Left"
		TestBudget.Left(arguments(0).number)
		return VmValue.None
	Measure(arguments)
Measure(arguments List(VmValue)) VmValue
	if call.MethodName is "Overran"
		return VmValue.OfText(SlowTests.Overran(arguments(0).number, arguments(1).text))
	if call.MethodName is "Busy"
		return VmValue.OfNumber(TestBudget.Busy(arguments(0).number, arguments(1).number))
	elapsed = arguments(0).number
	VmValue.OfNumber(call.MethodName is "Overrun" then SlowTests.Overrun(elapsed) else TestBudget.Finished(elapsed))