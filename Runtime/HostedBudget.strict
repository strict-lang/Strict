has call Invocation
Result VmValue
	let arguments = call.Arguments
	if call.MethodName is "Extended"
		return VmValue.OfNumber(TestBudget.Extended(arguments(0).text))
	if call.MethodName is "Started"
		let place = arguments(0).text
		let slow = arguments(1).IsTrue
		let extended = (slow is false) and TestBudget.IsVmException(place)
		return VmValue.OfNumber(extended then TestBudget.Extended(place) else TestBudget.Started(place, slow))
	VmValue.OfNumber(TestBudget.Finished(arguments(0).number))