has call Invocation
constant RunToolsCall = InstructionEntry.Invoke(2, ("Strict/Process", "RunTools", "Strict/List(ProcessResult)", "name", "arguments"), (0, 1), -1)
constant Running = Invocation(RunToolsCall, (VmValue.OfText("missingStrictTool"), VmValue.OfList((VmValue.OfText("a"), VmValue.OfText("b")))), VmValue.None)
constant Directed = ("TestBudget", "ConstantCache", "Memo", "Sampler", "FrameSlots", "Logger", "Strict")
constant Uncaptured = Invocation(InstructionEntry.Invoke(1, ("Strict/Logger", "Capture", "Strict/Text", "isCapturing"), 0, -1), VmValue.OfBoolean(false), VmValue("Strict/Logger", 0, "", VmValue.OfText("")))
constant Starting = Invocation(InstructionEntry.Invoke(1, ("Strict/Process", "Start", "Strict/Number", "arguments"), 0, -1), VmValue.OfText(""), VmValue("Strict/Process", 0, "", VmValue.OfText("")))
constant Sampling = Invocation(InstructionEntry.Invoke(1, ("Strict/Runtime/Sampler", "IsTaken", "Strict/Boolean", "tick"), List(Number) + 0, -1), List(VmValue) + VmValue.OfNumber(-5), VmValue.None)
constant Rooting = Invocation(InstructionEntry.Invoke(1, ("Strict/Runtime/FrameSlots", "Rooted", "Strict/List(VmValue)", "slots"), List(Number) + 0, -1), List(VmValue) + Frame.Listed(7), VmValue.None)
constant Collecting = Invocation(InstructionEntry.Invoke(0, ("Strict/Process", "Collect", "None"), List(Number), -1), List(VmValue), VmValue.None)
Seconds Number
	HostedProcess(Running).Seconds is Process.ToolSeconds
	Process.RunTool("strict", "-c Process.Wait(3)", 1).exitCode is Process.TimedOutExitCode
	HostedProcess(Invocation(RunToolsCall, Running.Arguments + VmValue.OfNumber(2), VmValue.None)).Seconds is 2
	call.Arguments.Length > 2 then call.Arguments(2).number else Process.ToolSeconds
Result VmValue
	HostedProcess(Hosted.SystemCall).Result.text is in ("Windows", "Linux", "MacOS", "Unknown")
	HostedProcess(Running).Result.items.Last.items.First.number is 127
	Process.Find("strict").Launch("version") > 0
	if TypeEntry.ShortName(call.TypeName) is in Directed
		return Direct
	if call.MethodName is in ("Start", "Launch")
		return Spawned
	if call.MethodName is in ("Wait", "Collect")
		return Paused
	if call.MethodName is "RunTools"
		return WrapResults(Process.RunTools(call.Arguments.First.text, Hosted(call).TextsOf(call.Arguments(1)), Seconds))
	Hosted(call).Processed
Spawned VmValue
	HostedProcess(Starting).Spawned.number is 127
	process = Process(call.Instance.Member(0).text)
	arguments = call.Arguments.First.text
	VmValue.OfNumber(call.MethodName is "Start" then process.Start(arguments) else process.Launch(arguments))
Direct VmValue
	HostedProcess(Sampling).Direct.kind is not "None" and HostedProcess(Sampling).Direct.IsTrue is false
	HostedProcess(Rooting).Direct is Frame.Listed(7)
	if TypeEntry.ShortName(call.TypeName) is "FrameSlots"
		return call.Arguments.First
	if TypeEntry.ShortName(call.TypeName) is "Memo"
		return Memoized
	if TypeEntry.ShortName(call.TypeName) is "Sampler"
		return VmValue.OfBoolean(Sampler.IsTaken(call.Arguments.First.number))
	if TypeEntry.ShortName(call.TypeName) is in ("Logger", "Strict")
		return Captured
	call.MethodName is in ("At", "Stored") then ConstantCache.Host(call) else HostedBudget(call).Result
Captured VmValue
	HostedProcess(Uncaptured).Captured.text is ""
	isLogger = TypeEntry.ShortName(call.TypeName) is "Logger"
	given = call.Arguments.First
	VmValue.OfText(isLogger then logger.Capture(given.IsTrue) else TrialRun(Trial(given.text)).Tested)
Memoized VmValue
	HostedProcess(Collecting).Memoized.kind is "Strict/Error"
	if call.Arguments.Length < 2
		return VmValue.OfError("Memo needs file and kind")
	file = call.Arguments(0).text
	kind = call.Arguments(1).text
	if call.MethodName is "Has"
		return VmValue.OfBoolean(Memo.Has(file, kind))
	if call.MethodName is "Texts"
		return Hosted(call).Values(Memo.Texts(file, kind))
	if kind.Length is 0
		return VmValue.OfError("Memo needs a kind for " + file)
	Hosted(call).Values(Memo.Keep(file, kind, Hosted(call).TextsOf(call.Arguments(2))))
Paused VmValue
	HostedProcess(Collecting).Paused.kind is "None"
	if call.MethodName is "Wait"
		Process.Wait(call.Arguments.First.number)
	VmValue.None
Texted Text
	HostedProcess(Hosted.SystemCall).Texted is in ("Windows", "Linux", "MacOS", "Unknown")
	if call.MethodName is "Variable"
		return Process.Variable(call.Arguments.First.text)
	call.MethodName is "Built" then Process(call.Instance.Member(0).text).Built else Process.OperatingSystem
WrapResults(results List(ProcessResult)) VmValue
	HostedProcess(Running).WrapResults(List(ProcessResult) + ProcessResult(1, "a", "b")).items.First.items(2).text is "b"
	mutable values = List(Mutable(VmValue))
	for results
		values.Add(WrapResult(value))
	VmValue.OfList(values)
WrapResult(result ProcessResult) VmValue
	HostedProcess(Running).WrapResult(ProcessResult(2, "a", "b")).items.First.number is 2
	HostedProcess(Running).WrapResult(ProcessResult(2, "a", "b")).kind is "Strict/ProcessResult"
	HostedProcess(Running).WrapResult(ProcessResult(2, "a", "b", 1.5, 0.5)).items.Last.number is 0.5
	Process.RunTool("strict", "version").Seconds > 0
	code = VmValue.OfNumber(result.exitCode)
	timing = (VmValue.OfNumber(result.Seconds), VmValue.OfNumber(result.ProcessorSeconds))
	VmValue("Strict/ProcessResult", 0, "", (code, VmValue.OfText(result.Output), VmValue.OfText(result.error)) + timing)