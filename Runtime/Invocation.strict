has entry InstructionEntry
has Arguments List(VmValue)
has Instance VmValue
has Depth Number = 0
has Resolved Number = -1
constant MaxDepth = 20000
constant MaxSteps = 1000000000000000
constant FirstTraces = 40
constant LastTraces = 10
constant AddCall = Invocation(InstructionEntry.Invoke(2, ("T", "Add", "Strict/Number", "x"), 0, 1), List(VmValue) + VmValue.OfNumber(3), VmValue.OfNumber(4))
constant Parsing = Invocation(InstructionEntry.Invoke(1, ("Strict/Text", "to", "Strict/Number"), List(Number), 0), List(VmValue), VmValue.OfText("5"))
constant Uppered = Invocation(InstructionEntry.Invoke(1, ("Strict/Text", "Upper", "Strict/Text"), List(Number), 0), List(VmValue), VmValue.OfText("ab"))
constant Coding = Invocation(InstructionEntry.Invoke(1, ("Strict/Character", "from", "Strict/Character", "text"), 0, -1), List(VmValue) + VmValue.OfNumber(65), VmValue.None)
constant Held = Invocation(InstructionEntry.HolderFrom, List(VmValue) + VmValue.OfNumber(5), VmValue.None)
constant Failing = TypeEntry("Strict/Failing", List(MemberEntry), List(MethodEntry) + MethodEntry("Fail", List(MemberEntry), "Strict/Number", (InstructionEntry(InstructionType.IndexCall, "list", (0, 0, 6)), InstructionEntry.Return(0))))
TypeName Text
	AddCall.TypeName is "T"
	PayloadDecoder(entry).Text(1)
MethodName Text
	AddCall.MethodName is "Add"
	PayloadDecoder(entry).Text(2)
ReturnType Text
	AddCall.ReturnType is "Strict/Number"
	Invocation(StructLanes.Constructed, List(VmValue), VmValue.None).ReturnType is "Pair"
	PayloadDecoder(entry).Text(4 + entry.payload(3))
ParameterNames Texts
	AddCall.ParameterNames is ("x")
	PayloadDecoder(entry).Names
Count Number
	AddCall.Count is 1
	(AddCall.Arguments.First.number is 3) and (Parsing.Instance.text is "5")
	entry.payload(5 + entry.payload(3))
IsNativeConversion Boolean
	Parsing.IsNativeConversion
	AddCall.IsNativeConversion is false
	IsConversion(TypeEntry.ShortName(TypeName), MethodName, ReturnType)
IsConversion(source Text, method Text, target Text) Boolean
	Parsing.IsConversion("Number", "to", "Strict/Text") and Parsing.IsConversion("Character", "to", "Strict/Text")
	Parsing.IsConversion("Boolean", "to", "Strict/Text") and Parsing.IsConversion("Text", "to", "Strict/Text")
	Parsing.IsConversion("List(Number)", "to", "Strict/Text") and Parsing.IsConversion("Text", "to", "Strict/Number")
	Parsing.IsConversion("Color", "to", "Strict/Text") is false
	Parsing.IsConversion("Text", "Upper", "Strict/Text") is false
	Parsing.IsConversion("Number", "to", "Strict/Number") is false
	Parsing.IsConversion("Text", "to", "Strict/Boolean") is false
	let isBase = (source is in ("Number", "Character", "Boolean", "Text")) or source.StartsWith("List(")
	let isTextual = (target is "Strict/Text") and isBase
	(method is "to") and (isTextual or ((target is "Strict/Number") and (source is "Text")))
IsMemberValue(type TypeEntry) Boolean
	Coding.IsMemberValue(TypeEntry.CharacterEntry)
	Parsing.IsMemberValue(TypeEntry.CharacterEntry) is false
	if IsWrapping(type) is false
		return false
	let kind = TypeEntry.ShortName(Arguments.First.kind)
	IsMemberKind(kind, TypeEntry.ShortName(type.Name), TypeEntry.ShortName(type.Changing.First.typeName))
IsMemberKind(kind Text, typeName Text, member Text) Boolean
	Coding.IsMemberKind("Character", "Character", "Number") and Coding.IsMemberKind("Number", "Character", "Number")
	Coding.IsMemberKind("List", "Character", "List(Number)")
	Coding.IsMemberKind("Text", "Character", "Number") is false
	Coding.IsMemberKind("List", "Character", "ListNumber") is false
	(kind is typeName) or (member is kind) or member.StartsWith(kind + "(")
Flag Number
	AddCall.Flag is 8
	6 + entry.payload(3) + Count
Resolution Number
	AddCall.Resolution is 10
	Invocation(AddCall.entry, List(VmValue), VmValue.None, 0, 4).Resolution is 4
	Invocation(AddCall.entry, List(VmValue), VmValue.None, 0, 0).Resolution is 0
	if Resolved >= 0
		return Resolved
	let flag = Flag
	flag + 1 + entry.payload(flag)
IsResolved Boolean
	AddCall.IsResolved is false
	Invocation(AddCall.entry, List(VmValue), VmValue.None, 0, 4).IsResolved
	entry.payload.Length > Resolution
IsWrapping(type TypeEntry) Boolean
	Coding.IsWrapping(TypeEntry.CharacterEntry)
	AddCall.IsWrapping(TypeEntry.CharacterEntry) is false
	Coding.IsWrapping(TypeEntry.Numbers) is false
	Invocation(StructLanes.Constructed, List(VmValue), VmValue.None).IsWrapping(TypeEntry.CharacterEntry) is false
	(MethodName is "from") and (type.Changing.Length is 1) and (Count is 1)
Kept(traces List(VmValue), trace VmValue) List(VmValue)
	AddCall.Kept(List(VmValue), VmValue.None).Length is 1
	let last = LastTraces - 1
	if traces.Length < FirstTraces + LastTraces
		return traces + trace
	let skipped = traces.Length > FirstTraces + LastTraces then traces(FirstTraces).items(2).number + 1 else 1
	let gap = VmValue("Strict/Stacktrace", 0, "", (VmValue.OfText("..."), VmValue.OfText(""), VmValue.OfNumber(skipped)))
	traces.Slice(0, FirstTraces) + gap + traces.Slice(traces.Length - last, last) + trace