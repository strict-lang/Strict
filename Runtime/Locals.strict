has names Texts
has values List(VmValue)
constant Empty = Locals(List(Text), List(VmValue))
constant One = Locals(List(Text) + "a", List(VmValue) + VmValue.OfNumber(1))
Get(name Text) VmValue
	One.Get("a").number is 1
	One.Get("b").kind is "None"
	let position = names.Index(name)
	position < 0 then VmValue.None else values(position)
With(name Text, entry VmValue) Locals
	One.With("a", VmValue.OfNumber(2)).Get("a").number is 2
	One.With("b", VmValue.OfNumber(3)).names.Length is 2
	let position = names.Index(name)
	if position < 0
		return Locals(names + name, values + entry)
	Locals(names, Replaced(values, position, entry))
Replaced(elements List(VmValue), position Number, entry VmValue) List(VmValue)
	Empty.Replaced((VmValue.OfNumber(1), VmValue.OfNumber(2)), 1, VmValue.None).Last.kind is "None"
	Empty.Replaced(List(VmValue), 2, VmValue.None).Length is 3
	let length = position + 1 > elements.Length then position + 1 else elements.Length
	mutable result = List(Mutable(VmValue))
	for length
		result.Add(index is position then entry else index < elements.Length then elements(index) else VmValue.None)
	result