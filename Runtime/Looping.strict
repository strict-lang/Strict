constant Counting = Begun(VmValue.None, VmValue.OfNumber(3), VmValue.None, 7)
constant Ranged = Begun(VmValue.None, VmValue.OfNumber(5), VmValue.OfNumber(2), 7)
constant Listed = Begun(VmValue.None, VmValue.OfList(VmValue.OfNumber(4), VmValue.OfNumber(6)), VmValue.None, 7)
Begun(state VmValue, iterable VmValue, ending VmValue, begin Number) VmValue
	Counting.number is 0 and Counting.items(0).kind is "Loop"
	Read(Ranged, false).number is 5 and Ranged.items(0).items(4).number is 3
	Begun(Counting, VmValue.OfNumber(0), VmValue.None, 9) is Counting
	Listed.items(0).number is 1 and Begun(VmValue.None, VmValue.OfText("ab"), VmValue.None, 7).items(0).number is 2
	start = Start(iterable, ending)
	end = End(iterable, ending)
	if start is end
		return state
	bounds = (VmValue.OfNumber(start), VmValue.OfNumber(end), VmValue.OfNumber(begin))
	count = VmValue.OfNumber((end - start).Absolute)
	code = iterable.kind is "List" then 1 else iterable.kind is "Text" then 2 else 0
	Iterate(VmValue("Loop", code, "", List(VmValue) + iterable + bounds + count + state), 0)
Iterate(loop VmValue, iteration Number) VmValue
	Read(Iterate(Counting.items(0), 2), false).number is 2
	Read(Iterate(Ranged.items(0), 1), true).number is 4 and Read(Iterate(Listed.items(0), 1), true).number is 1
	Read(Iterate(VmValue("Loop", 2, "", List(VmValue) + VmValue.OfText("ab")), 1), false).text is "b"
	VmValue("Iteration", iteration, "", List(VmValue) + loop)
EndLoop(state VmValue, isStopped Boolean) VmValue
	EndLoop(Counting, false).number is 1 and EndLoop(Counting, false).items is Counting.items
	EndLoop(EndLoop(EndLoop(Counting, false), false), false).kind is "None"
	EndLoop(Counting, true).kind is "None"
	EndLoop(Iterate(Counting.items(0), 5), false).kind is "None"
	loop = state.items(0)
	next = state.number + 1
	isStopped or next >= loop.items(4).number then loop.items(5) else VmValue(state, number = next)
Next(state VmValue, position Number, begin Number) Number
	Next(Counting, 9, 7) is 8
	Next(VmValue.None, 9, 7) is 10
	Next(Counting, 9, 3) is 10
	state.items.Length > 0 and state.items(0).items(3).number is begin then begin + 1 else position + 1
Current(state VmValue, isOuter Boolean, isIndex Boolean, fallback VmValue) VmValue
	Current(Counting, false, true, VmValue.None).number is 0
	Current(Counting, true, false, VmValue.OfText("a")).text is "a"
	Current(VmValue.None, false, true, VmValue.OfNumber(4)).number is 4
	Current(VmValue.None, true, true, VmValue.OfNumber(4)).number is 4
	Current(Listed, false, false, VmValue.None).number is 4 and Current(Listed, false, true, VmValue.None).number is 0
	current = isOuter and state.items.Length > 0 then state.items(0).items(5) else state
	current.items.Length is 0 then fallback else Read(current, isIndex)
Read(state VmValue, isIndex Boolean) VmValue
	Read(EndLoop(Listed, false), false).number is 6 and Read(EndLoop(Listed, false), true).number is 1
	Read(EndLoop(Ranged, false), true).number is 4
	loop = state.items(0)
	isIndex and loop.number > 0 then VmValue.OfNumber(state.number) else Element(loop, state.number)
IsEmpty(iterable VmValue, ending VmValue) Boolean
	IsEmpty(VmValue.OfNumber(0), VmValue.None)
	IsEmpty(VmValue.OfText("a"), VmValue.None) is false
	Start(iterable, ending) is End(iterable, ending)
Start(iterable VmValue, ending VmValue) Number
	Start(VmValue.OfNumber(5), VmValue.OfNumber(2)) is 5
	ending.kind is "None" then 0 else iterable.number
End(iterable VmValue, ending VmValue) Number
	End(VmValue.OfText("abc"), VmValue.None) is 3
	ending.kind is "None" then Count(iterable) else ending.number
Element(loop VmValue, iteration Number) VmValue
	Element(Counting.items(0), 2).number is 2
	Element(Ranged.items(0), 1).number is 4
	Element(Listed.items(0), 1).number is 6
	Element(VmValue("Loop", 2, "", List(VmValue) + VmValue.OfText("ab")), 1).text is "b"
	iterable = loop.items(0)
	if loop.number is 1
		return iterable.items(iteration)
	if loop.number is 2
		return VmValue.OfText(iterable.text(iteration) to Text)
	start = loop.items(1).number
	VmValue.OfNumber(loop.items(2).number < start then start - iteration else start + iteration)
Count(iterable VmValue) Number
	Count(VmValue.OfNumber(2.5)) is 2
	Count(VmValue.OfText("abc")) is 3
	Count(VmValue.OfNumber(-2)) is 0
	iterable.kind is "Number" then (iterable.number < 0 then 0 else iterable.number.Floor) else iterable.Length
Fail(iterable VmValue, ending VmValue) VmValue
	Fail(VmValue.OfError("a"), VmValue.None).kind is "Strict/Error"
	Fail(VmValue.OfNumber(3), VmValue.OfError("b")).items.First.text is "b"
	Fail(VmValue.OfNumber(3), VmValue.OfNumber(5)).kind is "None"
	failing = iterable.kind is in VmValue.ErrorKinds then iterable else ending
	failing.kind is in VmValue.ErrorKinds then failing else VmValue.None
ReturnSlots(slots List(VmValue)) List(VmValue)
	ReturnSlots(Frame.Broken)(Frame.ResultSlot).kind is "Strict/Error"
	ReturnSlots(Frame.Listed) is Frame.Listed
	if slots(Frame.LoopSlot).kind is not in VmValue.ErrorKinds
		return slots
	mutable failed = slots
	failed(Frame.ResultSlot) = slots(Frame.LoopSlot)
	failed