constant Counting = Begun(VmValue.None, VmValue.OfNumber(3), VmValue.None, 7)
constant Ranged = Begun(VmValue.None, VmValue.OfNumber(5), VmValue.OfNumber(2), 7)
Begun(state VmValue, iterable VmValue, ending VmValue, begin Number) VmValue
	Counting.items(2).number is 0
	Ranged.items(3).number is 5
	Begun(Counting, VmValue.OfNumber(0), VmValue.None, 9) is Counting
	let start = Start(iterable, ending)
	let end = End(iterable, ending)
	if start is end
		return state
	let bounds = (VmValue.OfNumber(start), VmValue.OfNumber(end), VmValue.OfNumber(begin))
	let count = VmValue.OfNumber((end - start).Absolute)
	let code = iterable.kind is "List" then 1 else iterable.kind is "Text" then 2 else 0
	Iterated(VmValue("Loop", code, "", List(VmValue) + iterable + bounds + count + state), 0)
Iterated(loop VmValue, iteration Number) VmValue
	Iterated(Counting.items(0), 2).items(3).number is 2
	Iterated(VmValue("Loop", 2, "", List(VmValue) + VmValue.OfText("ab")), 1).items(3).text is "b"
	let counted = VmValue.OfNumber(iteration)
	let element = Element(loop, iteration)
	VmValue.OfList(loop, counted, loop.number > 0 then counted else element, element)
Ended(state VmValue, isStopped Boolean) VmValue
	Ended(Counting, false).items(2).number is 1
	Ended(Ended(Ended(Counting, false), false), false).kind is "None"
	Ended(Counting, true).kind is "None"
	let loop = state.items(0)
	let next = state.items(1).number + 1
	isStopped or (next >= loop.items(4).number) then loop.items(5) else Iterated(loop, next)
Next(state VmValue, position Number, begin Number) Number
	Next(Counting, 9, 7) is 8
	Next(VmValue.None, 9, 7) is 10
	(state.items.Length > 0) and (state.items(0).items(3).number is begin) then begin + 1 else position + 1
Current(state VmValue, isOuter Boolean, isIndex Boolean, fallback VmValue) VmValue
	Current(Counting, false, true, VmValue.None).number is 0
	Current(Counting, true, false, VmValue.OfText("a")).text is "a"
	Current(VmValue.None, false, true, VmValue.OfNumber(4)).number is 4
	let current = isOuter and (state.items.Length > 0) then state.items(0).items(5) else state
	current.items.Length is 0 then fallback else current.items(isIndex then 2 else 3)
IsEmpty(iterable VmValue, ending VmValue) Boolean
	IsEmpty(VmValue.OfNumber(0), VmValue.None) is true
	IsEmpty(VmValue.OfText("a"), VmValue.None) is false
	Start(iterable, ending) is End(iterable, ending)
Start(iterable VmValue, ending VmValue) Number
	Start(VmValue.OfNumber(5), VmValue.OfNumber(2)) is 5
	ending.kind is "None" then 0 else iterable.number
End(iterable VmValue, ending VmValue) Number
	End(VmValue.OfText("abc"), VmValue.None) is 3
	ending.kind is "None" then Count(iterable) else ending.number
Element(loop VmValue, iteration Number) VmValue
	Element(Counting.items(0), 2).number is 2
	Element(Ranged.items(0), 1).number is 4
	let iterable = loop.items(0)
	if loop.number is 1
		return iterable.items(iteration)
	if loop.number is 2
		return VmValue.OfText(iterable.text.Substring(iteration, 1))
	let start = loop.items(1).number
	VmValue.OfNumber(loop.items(2).number < start then start - iteration else start + iteration)
Count(iterable VmValue) Number
	Count(VmValue.OfNumber(2.5)) is 2
	Count(VmValue.OfText("abc")) is 3
	if iterable.kind is "Number"
		return iterable.number < 0 then 0 else iterable.number.Floor
	iterable.Length