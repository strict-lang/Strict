has types List(TypeEntry)
has logger
has prototypes List(VmValue) = List(VmValue)
has folder Text = ""
has isTracing = false
has sources Dictionary(Text, Text) = Dictionary(Text, Text)
constant MaxSteps = 1000000000000000
constant Hello = Machine(List(TypeEntry) + TypeEntry.HelloLogger)
constant Doubler = TypeEntry("Strict/Doubler", List(MemberEntry), List(MethodEntry) + MethodEntry("Twice", List(MemberEntry), "Strict/Number", (InstructionEntry.LoadNumber(0, 21), InstructionEntry.Binary(InstructionType.Add, (0, 0, 1)), InstructionEntry.Return(1))))
constant Texts = TypeEntry("Strict/Text", List(MemberEntry) + MemberEntry("characters", "Strict/List(Character)", List(InstructionEntry), false), List(MethodEntry))
constant Defaulted = MethodEntry("Add", List(MemberEntry) + MemberEntry.SevenMember, "Strict/Number", List(InstructionEntry))
constant Wrapper = TypeEntry("Strict/Wrapper", (MemberEntry.LoggerMember, MemberEntry.SevenMember), List(MethodEntry))
constant Coded = InstructionEntry(InstructionType.FieldLoad, ("number", "Character"), (1, 0, -1, -2))
constant Paired = TypeEntry("Strict/Pair", (MemberEntry.LoggerMember, MemberEntry("b", "Strict/Number", List(InstructionEntry), false)), List(MethodEntry) + MethodEntry.Initializing)
constant Pairing = Machine(List(TypeEntry) + Paired)
Launch(typeName Text, arguments List(VmValue)) Number
	let main = Natives(types).TypeOf(typeName)
	let exact = main.Callee("Run", arguments.Length, "None", List(Text))
	let run = exact.instructions.Length > 0 then exact else main.Callee("Run", 1, "None", List(Text))
	let instance = Natives(types).Fresh(main)
	let result = Execute(run, Bound(main, instance, run, Typed(run.parameters, arguments), instance), main.Name)
	if result.kind is in VmValue.ErrorKinds
		logger.Log(result to Text)
		return 1
	0
Typed(parameters List(MemberEntry), arguments List(VmValue)) List(VmValue)
	Hello.Typed(List(MemberEntry) + Paired.members.Last, List(VmValue) + VmValue.OfText("5")).First.number is 5
	Hello.Typed(List(MemberEntry) + MemberEntry.LoggerMember, List(VmValue) + VmValue.OfText("a")).First.text is "a"
	Hello.Typed(List(MemberEntry) + MemberEntry.NumbersMember, List(VmValue) + VmValue.OfText("5")).First.items.Length is 1
	mutable typed = List(Mutable(VmValue))
	for arguments
		let parameter = index < parameters.Length then parameters(index) else parameters.Last
		let isNumber = parameter.typeName is in ("Strict/Number", "Strict/List(Number)")
		typed.Add(isNumber then VmValue.OfNumber(value.text to Number) else value)
	let isListed = (parameters.Length is 1) and parameters.First.typeName.StartsWith("Strict/List(")
	isListed then List(VmValue) + VmValue.OfList(typed) else typed
Tested(typeName Text) Number
	Hello.Tested("HelloLogger") is 0
	let main = Natives(types).TypeOf(typeName)
	let tests = main.Callee(TestCodegen.Runner, 0, "None", List(Text))
	let instance = Natives(types).Fresh(main)
	Execute(tests, Bound(main, instance, tests, List(VmValue), instance), main.Name).number
Prepared Machine
	Hello.Prepared.prototypes.First.kind is "HelloLogger"
	Hello.Prepared.sources("HelloLogger") is "HelloLogger.strict"
	mutable created = List(Mutable(VmValue))
	mutable located = Dictionary(Text, Text)
	for types
		created.Add(Natives(types).Fresh(value))
		located(value.Name) = TypeSource(value).Located(folder)
	Constants(Machine(types, logger, created, folder, isTracing, located)).Computed
Bound(type TypeEntry, instance VmValue, method MethodEntry, arguments List(VmValue), prototype VmValue) List(VmValue)
	Hello.Bound(Doubler, VmValue.OfNumber(2), Doubler.methods.First, List(VmValue), VmValue.None).First.number is 2
	Hello.Bound(Doubler, VmValue.None, Defaulted, List(VmValue), VmValue.None).Last.number is 7
	Frame.Doubling.Bound(Doubler, VmValue.None, Frame.Twice.method, List(VmValue), VmValue.None).Length is 9
	Hello.Bound(Texts, VmValue.OfText("ab"), Doubler.methods.First, List(VmValue), VmValue.None).Last.text is "ab"
	let start = Frame.MembersSlot + type.members.Length
	let end = start + method.parameters.Length
	let isSame = type.Name is instance.kind
	let ownership = isSame then 2 else IsOwned(type, instance.kind) then 1 else 0
	let indexed = Indexed(method, arguments)
	for end > method.Slots then end else method.Slots
		let found = index < start then Member(type, instance, index, ownership, prototype) else VmValue.None
		index is Frame.IndexSlot then indexed else index < start then found else Argument(method, arguments, index - start)
Member(type TypeEntry, instance VmValue, slot Number, ownership Number, prototype VmValue) VmValue
	Hello.Member(Wrapper, VmValue.OfError("a"), 6, 0, VmValue.None).kind is "Strict/Error"
	Hello.Member(Wrapper, VmValue.OfError("a"), 7, 0, VmValue.None).number is 7
	Hello.Member(Wrapper, VmValue.OfError("a"), 7, 0, Natives(List(TypeEntry)).Fresh(Wrapper)).number is 7
	if slot < Frame.MembersSlot
		return slot < 2 then instance else VmValue.None
	let position = slot - Frame.MembersSlot
	if (ownership is 2) and (position < instance.items.Length)
		return instance.items(position)
	let member = type.members(position)
	if member.IsConstant
		return position < prototype.items.Length then prototype.items(position) else Natives.Initial(member)
	ownership > 0 then instance.Member(position) else instance.As(member.typeName)
Argument(method MethodEntry, arguments List(VmValue), position Number) VmValue
	Hello.Argument(Defaulted, List(VmValue), 0).number is 7
	Hello.Argument(Defaulted, List(VmValue) + VmValue.OfNumber(2), 0).number is 2
	Hello.Argument(Defaulted, List(VmValue), 1).kind is "None"
	if position >= method.parameters.Length
		return VmValue.None
	position < arguments.Length then arguments(position) else Natives(types).Initial(method.parameters(position))
Indexed(method MethodEntry, arguments List(VmValue)) VmValue
	Hello.Indexed(MethodEntry.Indexing, List(VmValue) + VmValue.OfNumber(4)).number is 4
	Hello.Indexed(Defaulted, List(VmValue)).kind is "None"
	for method.parameters
		if value.Name is "index"
			return index < arguments.Length then arguments(index) else Natives(types).Initial(value)
	VmValue.None
MemberValue(owner TypeEntry, instance VmValue, index Number) VmValue
	Hello.MemberValue(Wrapper, VmValue.OfError("a"), 0).kind is "Strict/Error"
	Hello.MemberValue(Wrapper, VmValue.OfError("a"), 1).number is 7
	Hello.MemberValue(TypeEntry.CharacterEntry, VmValue.OfText("a"), 0).number is 97
	Hello.MemberValue(Paired, VmValue("Strict/Pair(Number)", 0, "", (VmValue.None, VmValue.OfNumber(2))), 1).number is 2
	let member = owner.members(index)
	if member.IsConstant
		return Natives(types).Initial(member)
	if owner.Name is instance.kind
		return instance.Member(index)
	IsOwned(owner, instance.kind) then instance.Member(index) else instance.As(member.typeName)
IsOwned(type TypeEntry, kind Text) Boolean
	Hello.IsOwned(Paired, "Strict/Pair(Number)")
	Hello.IsOwned(Paired, "Strict/Other") is false
	Hello.IsOwned(Paired, "List")
	if kind is "List"
		return true
	TypeEntry.ShortName(type.Name).Split("(").First is TypeEntry.ShortName(kind).Split("(").First
Execute(method MethodEntry, locals List(VmValue), owner Text) VmValue
	Frame.Doubling.Execute(Frame.Twice.method, Frame.Listed, "Strict/Doubler").number is 42
	Machine(Frame.Doubling, isTracing = true).Execute(Frame.Twice.method, Frame.Listed, "D").number is 42
	let frame = Frame(value, method, owner)
	let slots = isTracing then TracedFrame(frame).Finished(locals) else frame.Finished(locals)
	slots(Frame.ResultSlot)
Call(call Invocation) VmValue
	Machine(List(TypeEntry) + Doubler).Call(Invocation.AddCall).kind is "Error"
	Hello.Call(Invocation.Uppered).text is "AB"
	let at = call.Resolution
	let entry = call.entry.payload.Length > at then call.entry else Resolver(types).Targeted(call.entry)
	let route = entry.payload(at)
	if route is Resolver.Hosting
		return Hosted(call).Result
	if route is Resolver.Searching
		return Natives(types).Searched(call.MethodName, call.Instance.text, call.Arguments)
	if (route < 0) or ((entry.payload(at + 2) is 1) and call.IsMemberValue(types(route)))
		return Natives(types, folder).Result(call)
	Executed(route, types(route).methods(entry.payload(at + 1)), call)
Executed(route Number, method MethodEntry, call Invocation) VmValue
	Pairing.Executed(0, Resolver.Doubling.Methods(Paired).First, Invocation.AddCall).items.First.number is 7
	let type = types(route)
	let prototype = route < prototypes.Length then prototypes(route) else Natives(types).Fresh(type)
	let isInitializer = method.Name is "from" then type.IsStruct and method.IsInitializer(type.Changing) else false
	if isInitializer is false
		return Execute(method, Bound(type, call.Instance, method, call.Arguments, prototype), type.Name)
	let finished = Frame(value, method, type.Name).Finished(Bound(type, prototype, method, call.Arguments, prototype))
	let result = finished(Frame.ResultSlot)
	mutable values = List(Mutable(VmValue))
	for type.members
		values.Add(finished(Frame.MembersSlot + index))
	result.kind is in VmValue.ErrorKinds then result else VmValue(type.Name, 0, "", values)
Field(entry InstructionEntry, instance VmValue) VmValue
	Hello.Field(InstructionEntry(InstructionType.FieldLoad, "characters", (1, 0, -1)), VmValue.OfText("ab")).text is "ab"
	Hello.Field(InstructionEntry(InstructionType.FieldLoad, "c", (1, 0, -1)), VmValue.OfError("a")).kind is "Strict/Error"
	Machine(List(TypeEntry) + TypeEntry.CharacterEntry).Field(Coded, VmValue.OfText("a")).number is 97
	let owner = Natives(types).TypeOf(entry.texts.Length > 1 then entry.texts.Last else instance.kind)
	mutable found = instance
	for owner.members
		if value.Name is entry.texts(0)
			found = MemberValue(owner, instance, index)
	found
Logged(message Text) VmValue
	Hello.Logged("Hi").kind is "None"
	logger.Log(message)
	VmValue.None