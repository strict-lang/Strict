has types List(TypeEntry)
has logger
constant MaxSteps = 10000000
constant Hello = Machine(List(TypeEntry) + TypeEntry.HelloLogger)
constant Doubler = TypeEntry("Strict/Doubler", List(MemberEntry), List(MethodEntry) + MethodEntry("Twice", List(MemberEntry), "Strict/Number", (InstructionEntry.LoadNumber(0, 21), InstructionEntry.Binary(InstructionType.Add, (0, 0, 1)), InstructionEntry.Return(1))))
constant Uppered = Invocation(InstructionEntry.Invoke(1, ("Strict/Text", "Upper", "Strict/Text"), List(Number), 0), Frame(MethodEntry.HelloRun, 0, List(VmValue) + VmValue.OfText("ab"), Locals.Empty))
constant Characters = Frame(MethodEntry("Run", List(MemberEntry), "None", List(InstructionEntry) + InstructionEntry(InstructionType.FieldLoad, "characters", (1, 0, -1))), 0, List(VmValue) + VmValue.OfText("ab"), Locals.Empty)
constant Texts = TypeEntry("Strict/Text", List(MemberEntry) + MemberEntry("characters", "Strict/List(Character)", List(InstructionEntry), false), List(MethodEntry))
constant Defaulted = MethodEntry("Add", List(MemberEntry) + MemberEntry.SevenMember, "Strict/Number", List(InstructionEntry))
constant Listing = Frame(MethodEntry("Run", List(MemberEntry), "None", List(InstructionEntry) + InstructionEntry(InstructionType.IndexCall, "list", (0, 0, -1))), 0, List(VmValue) + VmValue.OfNumber(1), Locals(("list"), (VmValue.OfList(VmValue.OfNumber(10), VmValue.OfNumber(20)))))
Launch(typeName Text, arguments List(VmValue))
	let main = Natives(types).TypeOf(typeName)
	let exact = main.Callee("Run", arguments.Length, "None")
	let isExact = exact.instructions.Length > 0
	let run = isExact then exact else main.Callee("Run", 1, "None")
	let bound = isExact then arguments else List(VmValue) + VmValue.OfList(arguments)
	Execute(run, Bound(main, Natives(types).Fresh(main), run, bound))
Tested(typeName Text) Number
	Hello.Tested("HelloLogger") is 0
	let main = Natives(types).TypeOf(typeName)
	let tests = main.Callee(TestCodegen.Runner, 0, "None")
	Execute(tests, Bound(main, Natives(types).Fresh(main), tests, List(VmValue))).number
Bound(type TypeEntry, instance VmValue, method MethodEntry, arguments List(VmValue)) Locals
	Hello.Bound(Doubler, VmValue.OfNumber(2), Doubler.methods.First, List(VmValue)).Get("value").number is 2
	Hello.Bound(Texts, VmValue.OfText("ab"), MethodEntry.HelloRun, List(VmValue)).Get("characters").text is "ab"
	Hello.Bound(Doubler, VmValue.None, Defaulted, List(VmValue)).Get("a").number is 7
	mutable locals = Locals.Empty.With("#this", instance).With("value", instance)
	if instance.IsBase or Natives(types).IsNamed(type, instance.kind)
		for type.members
			locals = locals.With(value.Name, instance.Member(index))
	for method.parameters
		locals = locals.With(value.Name, (index < arguments.Length then arguments(index) else Natives(types).Initial(value)))
	locals
Execute(method MethodEntry, locals Locals) VmValue
	Machine(List(TypeEntry) + Doubler).Execute(Doubler.methods.First, Locals.Empty).number is 42
	mutable current = Frame(method, 0, List(VmValue), locals)
	for MaxSteps
		if current.position >= current.method.instructions.Length
			return current.Local("#result")
		current = Step(current)
	logger.Log("Stopped " + method.Name + " after " + MaxSteps + " steps")
	current.Local("#result")
Step(frame Frame) Frame
	Hello.Step(Frame(Doubler.methods.First, 0, List(VmValue), Locals.Empty)).Register(0).number is 21
	let entry = frame.Instruction
	let kind = entry.kind
	if kind <= InstructionType.StoreRegisterToVariable or (kind is InstructionType.InvokeWriteToList)
		return Storage(frame, entry).Step
	if kind < InstructionType.BinaryOperatorsSeparator
		return kind is InstructionType.IndexCall then Indexed(frame) else Operations(frame, entry).Step
	if kind is InstructionType.Invoke
		return Invoked(frame)
	if kind is InstructionType.Print
		return Printed(frame)
	kind is InstructionType.FieldLoad then Field(frame) else Flow(frame, entry).Step
Invoked(frame Frame) Frame
	Machine(List(TypeEntry) + Doubler).Invoked(Frame(MethodEntry.GoRun, 0, List(VmValue), Locals.Empty)).position is 1
	let result = Call(Invocation(frame.Instruction, frame))
	if result.kind is "Error"
		logger.Log(result.text)
	frame.NextWithRegister(frame.Instruction.payload(0), result)
Call(call Invocation) VmValue
	Machine(List(TypeEntry) + Doubler).Call(Invocation.AddCall).kind is "Error"
	Hello.Call(Uppered).text is "AB"
	constant hosted = ("Find", "RunTool", "Run", "OperatingSystem")
	if (call.TypeName is "Strict/Process") and (call.MethodName is in hosted)
		return Natives(types).Hosted(call)
	if (call.TypeName is "Strict/Text") and (call.MethodName is in Natives.TextMethods)
		return Natives(types).Searched(call.MethodName, call.Instance.text, call.Arguments)
	let method = Natives(types).TypeOf(call.TypeName).Callee(call.MethodName, call.Arguments.Length, call.ReturnType)
	if (method.instructions.Length is 0) or call.IsNativeConversion
		return Natives(types).Result(call)
	Execute(method, Bound(Natives(types).TypeOf(call.TypeName), call.Instance, method, call.Arguments))
Indexed(frame Frame) Frame
	Hello.Indexed(Listing).Register(0).number is 20
	Hello.Indexed(Listing.WithRegister(0, VmValue.OfNumber(5))).Register(0) is VmValue.OfError("Run")
	let entry = frame.Instruction
	let collection = frame.Local(entry.texts(0))
	let position = frame.Register(entry.payload(1)).number
	let wrapped = position < 0 then position + collection.Length else position
	if (wrapped < 0) or (wrapped >= collection.Length)
		return frame.NextWithRegister(entry.payload(0), VmValue.OfError(frame.method.Name))
	let isText = collection.kind is "Text"
	let element = isText then VmValue.OfText(collection.text.Substring(wrapped, 1)) else collection.items(wrapped)
	frame.NextWithRegister(entry.payload(0), element)
Printed(frame Frame) Frame
	Hello.Printed(Frame(MethodEntry.HelloRun, 0, List(VmValue), Locals.Empty)).position is 1
	let entry = frame.Instruction
	let shown = entry.payload(1) is 1 then frame.Register(entry.payload(2)) to Text else ""
	logger.Log(entry.texts(0) + shown)
	frame.Next
Field(frame Frame) Frame
	Hello.Field(Frame(MethodEntry.HelloRun, 0, List(VmValue), Locals.Empty)).position is 1
	Hello.Field(Characters).Register(1).text is "ab"
	let entry = frame.Instruction
	let instance = frame.Register(entry.payload(1))
	if instance.IsBase
		return frame.NextWithRegister(entry.payload(0), instance)
	mutable found = VmValue.None
	for Natives(types).TypeOf(instance.kind).members
		if value.Name is entry.texts(0)
			found = instance.items(index)
	frame.NextWithRegister(entry.payload(0), found)