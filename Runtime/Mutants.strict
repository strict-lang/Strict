has logger
has path Text
has seconds Number = 0.2
has part Text = ""
has isWhole Boolean = false
constant Starting = ("Strict/Runtime/TestBudget", "Started")
constant Budget = InstructionEntry.Invoke(2, Starting + ("Strict/Number", "place", "isSlow"), (0, 1), -1)
constant Budgeted = (InstructionEntry.LoadBoolean(1, false), Budget)
constant Twice = Machine.Doubler.methods.First
constant Doubled = List(TypeEntry) + Machine.Doubler
constant Sample = Mutants(Logger, "Examples/Fibonacci.strict")
constant Lined = MethodEntry(Twice, instructions = List(InstructionEntry) + InstructionEntry(InstructionEntry.Return(0), line = 2))
constant Valued = TypeEntry(Machine.Doubler, members = List(MemberEntry) + MemberEntry("Twice", "Strict/Number", List(InstructionEntry), true), methods = List(MethodEntry) + Lined)
constant Inputs = ("/File", "/Memo", "/Directory", "/Process", "/Logger", "/TextWriter", "/Time", "/Library", "/Http", "/Socket", "/Random", "/GpuMemory")
constant Hint = " kept passing all tests, improve the tests!"
constant Wave = 8
Survivors(types List(TypeEntry)) Number
	Sample.Survivors(Doubled) is 0
	Mutants(Logger, "Compiler/output/Cached.strict", 0).Survivors(Doubled) is 0
	let cache = MutationCache(path, isWhole)
	let isCached = (part is "") and cache.IsCurrent
	if (isCached is false) and (seconds is 0)
		return 0
	let survivors = isCached then cache.Survivors else Lines(types)
	for survivors
		logger.Log(Shown(value))
	if isWhole and (part is "") and (isCached is false)
		cache.Saved(survivors)
	survivors.Length
Ran(types List(TypeEntry), root Text, files Texts, inference TypeInference) Number
	let cache = MutationCache(path, isWhole)
	let held = part is "" then cache.Held(TypeSource.Root + "/obj") else List(Text)
	let isFresh = (part is not "") or (cache.IsCurrent is false)
	let unoptimized = FileCompiler(logger, true, isWhole then "*" else "", false)
	let plain = isFresh then unoptimized.Built(path, root, true, files, inference).entries else types
	let survivors = Survivors(plain)
	cache.Released(held)
	survivors
Lines(types List(TypeEntry)) Texts
	Sample.Lines(Doubled).Length is 0
	let kept = Baseline(value).Kept(types)
	let methods = Baseline(value).Methods(kept)
	let tested = Tested(types, Runner(types.First), methods)
	let budgets = Baseline(value).Budgets(kept)
	let rounds = Mutation.Picked(part, Mutation.Rounds(methods), isWhole)
	let waves = Range(0, (rounds.Length / Wave).Ceiling)
	for wave, found, survivor in waves, Rounds(tested, methods, budgets, rounds, wave), found
		survivor
Rounds(types List(TypeEntry), methods List(MethodEntry), budgets Numbers, rounds Numbers, wave Number) List(Texts)
	Sample.Rounds(Doubled, List(MethodEntry), List(Number), (0, 1), 0).Length is 2
	Sample.Rounds(Doubled, List(MethodEntry), List(Number), Mutation.Picked("", Wave + 6, true), 1).Length is 6
	for rounds.Slice(wave * Wave, (rounds.Length - wave * Wave).Clamp(0, Wave))
		Round(types, methods, budgets, value)
Shown(survivor Text) Text
	Sample.Shown(Sample.path + ": MutationTestingFailed") is Sample.path + ": MutationTestingFailed"
	Sample.Shown(Sample.path + ":line 3: MutationSurvived").Lines.Length > 2
	Sample.Shown(Sample.path + ":line 3") is Sample.path + ":line 3"
	Mutants(Logger, Sample.path, part = "1/2").Shown(Sample.path + ":line 3: MutationSurvived").Lines.Length is 1
	let start = survivor.IndexOf(":line ")
	let end = start < 0 then -1 else survivor.IndexOf(": ", start)
	if (part is not "") or (end < 0)
		return survivor
	let line = survivor.Substring(start + 6, end - start - 6) to Number
	survivor + "\n" + Text.Combine(Mutation.Source(File(path).ReadLines, line), "\n")
Mutated(type TypeEntry) List(MethodEntry)
	Sample.Mutated(Machine.Doubler).Length is 0
	Sample.Mutated(TypeEntry(Machine.Doubler, methods = List(MethodEntry) + Lined)).Length is 1
	Sample.Mutated(Valued).Length is 0
	for type.methods
		if IsMutated(value) and (type.ConstantSlot(value) < 0)
			value
Runner(type TypeEntry) MethodEntry
	Sample.Runner(Machine.Doubler) is Twice
	Sample.Runner(TypeEntry(Machine.Doubler, methods = (Twice, MethodEntry(Twice, Name = "$Tests")))).Name is "$Tests"
	for type.methods
		if value.Name is TestCodegen.Runner
			return value
	type.methods.First
Round(types List(TypeEntry), methods List(MethodEntry), budgets Numbers, round Number) Texts
	mutable survivors = List(Mutable(Text))
	for methods
		let candidates = Mutation(value).Candidates
		if candidates.Length > round
			let mutant = List(MethodEntry) + Mutation(value).Mutant(candidates(round))
			let alone = Execute(logger).Started(Replaced(types, List(MethodEntry) + value, mutant), path, false, false)
			let isPassing = Passes(alone, TestCodegen.Runner + index, budgets(index))
			if isPassing and Passes(alone, TestCodegen.Runner + methods.Length, seconds)
				let lines = File(path).ReadLines
				if MutationFlow(value).IsKept(candidates(round), lines, Mutation(value).Line(candidates(round)))
					survivors.Add(Survivor(value, candidates(round)))
	survivors
Passes(started Machine, runner Text, budget Number, isRetried = false) Boolean
	Sample.Passes(Machine.Hello, TestCodegen.Runner, 1)
	Mutants(Logger, "A.strict", 0).Passes(Frame.Doubling, "Missing", 0) is false
	let begun = Process.Elapsed
	let failed = Machine(started, deadline = begun + budget).Tested(started.types.First.Name, runner)
	if (failed is not 0) and (isRetried is false) and Baseline.Expired(begun, budget)
		return Passes(started, runner, budget, true)
	(failed is not Error) and (failed is 0)
Survivor(method MethodEntry, code Number) Text
	Sample.Survivor(Twice, 13) is Sample.path + ":line 0: MutationSurvived: Twice: replaced + with -" + Hint
	let mutation = Mutation(method)
	path + ":line " + mutation.Line(code) + ": MutationSurvived: " + method.Name + ": " + mutation.Described(code) + Hint
Tested(types List(TypeEntry), runner MethodEntry, methods List(MethodEntry)) List(TypeEntry)
	Sample.Tested(List(TypeEntry) + Machine.Doubler, Twice, List(MethodEntry) + Twice).First.methods.Length is 3
	mutable runners = List(Mutable(MethodEntry))
	mutable names = List(Mutable(Text))
	for methods
		names.Add(value.Name)
		let instructions = Silent(Mutation(runner).Split(List(Text) + value.Name))
		runners.Add(MethodEntry(runner, Name = TestCodegen.Runner + index, instructions = instructions))
	let whole = Silent(Mutation(runner).Split(names))
	runners.Add(MethodEntry(runner, Name = TestCodegen.Runner + methods.Length, instructions = whole))
	mutable changed = types
	changed(0) = TypeEntry(types.First, methods = types.First.methods + runners)
	changed
IsMutated(method MethodEntry) Boolean
	Sample.IsMutated(Twice) is false
	Sample.IsMutated(MethodEntry(Twice, Name = TestCodegen.Runner)) is false
	let last = Mutation(method).Lines
	let isSkipped = method.IsSlow and (isWhole is false)
	if method.Name.StartsWith(TestCodegen.Runner) or isSkipped or (last is 0) or (last > File(path).ReadLines.Length)
		return false
	for method.instructions
		if (value.kind is InstructionType.Invoke) and (value.texts.Length > 1) and IsInput(value.texts(0))
			return false
	true
IsInput(type Text) Boolean
	Sample.IsInput("Strict/File")
	Sample.IsInput("Strict/Number") is false
	for Inputs
		if type.EndsWith(value) or (type.IndexOf(value + "/") >= 0)
			return true
	false
Replaced(types List(TypeEntry), methods List(MethodEntry), replacements List(MethodEntry)) List(TypeEntry)
	Sample.Replaced(Doubled, (Twice), (Mutation.Twice.Mutant(13))).First.methods.First is Mutation.Twice.Mutant(13)
	mutable changed = types
	mutable replaced = List(Mutable(MethodEntry))
	for types.First.methods
		let at = methods.Index(value)
		replaced.Add(at >= 0 then replacements(at) else value)
	changed(0) = TypeEntry(types.First, methods = replaced)
	changed
Silent(instructions List(InstructionEntry)) List(InstructionEntry)
	Mutants.Silent(Budgeted).First is InstructionEntry.LoadBoolean(1, true)
	for instructions
		if value.kind is not InstructionType.Print
			IsBudgetFlag(instructions, index) then InstructionEntry.LoadBoolean(value.payload(0), true) else value
IsBudgetFlag(instructions List(InstructionEntry), position Number) Boolean
	Mutants.IsBudgetFlag(Budgeted.Reverse, 0) is false
	let next = position + 1 < instructions.Length then instructions(position + 1) else instructions(position)
	let isStarted = next.texts.Length > 2 then next.texts.Slice(0, 2) is Starting else false
	(next.kind is InstructionType.Invoke) and isStarted
