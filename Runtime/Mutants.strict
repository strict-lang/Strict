has logger
has path Text
has seconds Number = 0.2
has root Text = "."
has part Text = ""
has isWhole Boolean = false
constant Starting = ("Strict/Runtime/TestBudget", "Started")
constant Budget = InstructionEntry.Invoke(2, Starting + ("Strict/Number", "place", "isSlow"), (0, 1), -1)
constant Budgeted = (InstructionEntry.LoadBoolean(1, false), Budget)
constant Twice = Machine.Doubler.methods.First
constant Doubled = List(TypeEntry) + Machine.Doubler
constant Sample = Mutants(Logger, "Examples/Fibonacci.strict")
constant Inputs = ("/File", "/Directory", "/Process", "/Logger", "/TextWriter", "/Time", "/Library", "/Http", "/Random")
constant Crashed = ", its rounds were not tested: run strict test on this file to see the error"
constant Hint = " keeps all tests passing: add a test that fails without it or remove the code"
Survivors(types List(TypeEntry)) Number
	Sample.Survivors(Execute(Logger).Loaded("Examples/Fibonacci.strict", ".")) is 0
	Mutants(Logger, "Compiler/output/Cached.strict", 0).Survivors(Doubled) is 0
	let cache = MutationCache(path, isWhole)
	let isCached = (part is "") and cache.IsCurrent
	if (isCached is false) and (seconds is 0)
		return 0
	let survivors = isCached then cache.Survivors else Lines(types)
	for survivors
		logger.Log(Shown(value))
	if (part is "") and (isCached is false)
		cache.Saved(survivors)
	survivors.Length
Lines(types List(TypeEntry)) Texts
	Sample.Lines(Doubled).Length is 0
	let methods = Baseline(value).Kept(types)
	let rounds = Mutation.Rounds(methods)
	let isStrict = Path(Process.Current.executable).FileName.text.Lower.StartsWith("strict")
	if (part is "") and (rounds > 16) and isStrict
		return Spawned(rounds)
	let tested = Tested(types, Runner(types.First), methods)
	mutable survivors = List(Mutable(Text))
	for Range(0, rounds)
		if Mutation.IsMine(part, value)
			survivors = survivors + Round(tested, methods, value)
	survivors
Spawned(rounds Number) Texts
	Sample.Commands(4).Last is "test \"Examples/Fibonacci.strict\" \".\" unit mutations rounds:1/2"
	mutable survivors = List(Mutable(Text))
	let results = Process.RunTools(Process.Current.executable, Commands(rounds))
	for result, line in results, result.Output.Lines
		if line.IndexOf("MutationSurvived") >= 0
			survivors.Add(line.Replace("\r", ""))
	for results
		let isCrashed = (value.exitCode < 0) or (value.exitCode >= 128) or (("\n" + value.Output).IndexOf("\nError: ") >= 0)
		if isCrashed
			survivors.Add(path + ": MutationTestingFailed: a worker ended with exit code " + value.exitCode + Crashed)
	survivors
Commands(rounds Number) Texts
	Sample.Commands(40).Length is 10
	Mutants(Logger, "A.strict", 0.1, ".", "", true).Commands(4).Last.EndsWith(" mutations rounds:1/2")
	let parts = (rounds / 4).Ceiling.Clamp(2, 16)
	let options = isWhole then " mutations rounds:" else " unit mutations rounds:"
	for parts
		"test \"" + path + "\" \"" + root + "\"" + options + index + "/" + parts
Shown(survivor Text) Text
	Sample.Shown(Sample.path + ": MutationTestingFailed") is Sample.path + ": MutationTestingFailed"
	Sample.Shown(Sample.path + ":line 3: MutationSurvived").Lines.Length > 2
	Mutants(Logger, Sample.path, part = "1/2").Shown(Sample.path + ":line 3: MutationSurvived").Lines.Length is 1
	let start = survivor.IndexOf(":line ")
	if (part is not "") or (start < 0)
		return survivor
	let line = survivor.Substring(start + 6, survivor.IndexOf(": ", start) - start - 6) to Number
	survivor + "\n" + Text.Combine(Mutation.Source(File(path).ReadLines, line), "\n")
Mutated(type TypeEntry) List(MethodEntry)
	Sample.Mutated(Machine.Doubler).Length is 0
	for type.methods
		if IsMutated(value)
			value
Runner(type TypeEntry) MethodEntry
	Sample.Runner(Machine.Doubler) is Twice
	Sample.Runner(TypeEntry(Machine.Doubler, methods = (Twice, MethodEntry(Twice, Name = "$Tests")))).Name is "$Tests"
	for type.methods
		if value.Name is TestCodegen.Runner
			return value
	type.methods.First
Round(types List(TypeEntry), methods List(MethodEntry), round Number) Texts
	let started = Execute(logger).Started(Replaced(types, methods, Changed(methods, round)), path)
	mutable survivors = List(Mutable(Text))
	for methods
		let candidates = Mutation(value).Candidates
		let machine = Machine(started, deadline = Process.Elapsed + seconds)
		let runner = TestCodegen.Runner + index
		if (candidates.Length > round) and (machine.Tested(types.First.Name, runner) is 0)
			let mutant = List(MethodEntry) + Mutation(value).Mutant(candidates(round))
			let alone = Execute(logger).Started(Replaced(types, List(MethodEntry) + value, mutant), path)
			if Machine(alone, deadline = Process.Elapsed + seconds).Tested(types.First.Name, runner) is 0
				survivors.Add(Survivor(value, candidates(round)))
	survivors
Changed(methods List(MethodEntry), round Number) List(MethodEntry)
	Sample.Changed(List(MethodEntry) + Twice, 0).First.instructions(1).kind is InstructionType.Subtract
	Sample.Changed((Twice), 5).First is Twice
	for methods
		let candidates = Mutation(value).Candidates
		candidates.Length > round then Mutation(value).Mutant(candidates(round)) else value
Survivor(method MethodEntry, code Number) Text
	Sample.Survivor(Twice, 13) is Sample.path + ":line 0: MutationSurvived: Twice with + and - or * and / swapped" + Hint
	let mutation = Mutation(method)
	let described = mutation.Described(code) + mutation.Position(code)
	path + ":line " + mutation.Line(code) + ": MutationSurvived: " + method.Name + " " + described + Hint
Tested(types List(TypeEntry), runner MethodEntry, methods List(MethodEntry)) List(TypeEntry)
	Sample.Tested(List(TypeEntry) + Machine.Doubler, Twice, List(MethodEntry) + Twice).First.methods.Length is 2
	mutable runners = List(Mutable(MethodEntry))
	for methods
		let instructions = Silent(Mutation(runner).Split(value.Name))
		runners.Add(MethodEntry(runner, Name = TestCodegen.Runner + index, instructions = instructions))
	mutable changed = types
	changed(0) = TypeEntry(types.First, methods = types.First.methods + runners)
	changed
IsMutated(method MethodEntry) Boolean
	Sample.IsMutated(Twice) is false
	Sample.IsMutated(MethodEntry(Twice, Name = TestCodegen.Runner)) is false
	let last = Mutation(method).Lines
	let isSkipped = method.IsSlow and (isWhole is false)
	if method.Name.StartsWith(TestCodegen.Runner) or isSkipped or (last is 0) or (last > File(path).ReadLines.Length)
		return false
	for method.instructions
		if (value.kind is InstructionType.Invoke) and (value.texts.Length > 1) and IsInput(value.texts(0))
			return false
	true
IsInput(type Text) Boolean
	Sample.IsInput("Strict/File")
	Sample.IsInput("Strict/Number") is false
	for Inputs
		if type.EndsWith(value) or (type.IndexOf(value + "/") >= 0)
			return true
	false
Replaced(types List(TypeEntry), methods List(MethodEntry), replacements List(MethodEntry)) List(TypeEntry)
	Sample.Replaced(Doubled, (Twice), Sample.Changed((Twice), 0)).First.methods.First is Mutation.Twice.Mutant(13)
	mutable changed = types
	mutable replaced = List(Mutable(MethodEntry))
	for types.First.methods
		let at = methods.Index(value)
		replaced.Add(at >= 0 then replacements(at) else value)
	changed(0) = TypeEntry(types.First, methods = replaced)
	changed
Silent(instructions List(InstructionEntry)) List(InstructionEntry)
	Mutants.Silent(Budgeted).First is InstructionEntry.LoadBoolean(1, true)
	for instructions
		if value.kind is not InstructionType.Print
			IsBudgetFlag(instructions, index) then InstructionEntry.LoadBoolean(value.payload(0), true) else value
IsBudgetFlag(instructions List(InstructionEntry), position Number) Boolean
	Mutants.IsBudgetFlag(Budgeted.Reverse, 0) is false
	let next = position + 1 < instructions.Length then instructions(position + 1) else instructions(position)
	let isStarted = next.texts.Length > 2 then next.texts.Slice(0, 2) is Starting else false
	(next.kind is InstructionType.Invoke) and isStarted
