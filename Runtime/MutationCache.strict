has path Text
has isWhole Boolean = false
constant Steps = 100000
constant Version = 24
constant MaxRuns = 26
constant RunWait = 90
constant Accepting = Invocation(InstructionEntry.Invoke(0, ("Strict/Networking/Socket", "Accept", "Strict/Number"), List(Number), -1), List(VmValue), VmValue.None)
constant Sample = MutationCache("Compiler/output/Cached.strict")
Stamp Text
	Sample.Stamp.StartsWith("unit ")
	Sample.Stamp.EndsWith(" " + Version)
	MutationCache("Compiler/output/Cached.strict", true).Stamp.StartsWith("whole ")
	let source = File(path).Exists then Text.Combine(File(path).ReadLines, "\n") else ""
	(isWhole then "whole " else "unit ") + HashCode(source).number + " " + Version
Location Text
	Sample.Location.EndsWith("Cached.mutations")
	BinaryFile(FileCompiler.Normalized(path)).Path.Replace(".strictbinary", ".mutations")
IsCurrent Boolean
	Sample.Saved(List(Text) + "line 1: MutationSurvived") and Sample.IsCurrent
	MutationCache("Compiler/output/Cached.strict", true).IsCurrent is false
	let lines = File(Location).Exists then File(Location).ReadLines else List(Text)
	let whole = "whole " + Stamp.Substring(Stamp.IndexOf(" ") + 1, Stamp.Length - Stamp.IndexOf(" ") - 1)
	(lines.Length > 0) and ((lines.First is Stamp) or (lines.First is whole))
Survivors Texts
	Sample.Saved(List(Text) + "line 1: MutationSurvived") and (Sample.Survivors is ("line 1: MutationSurvived"))
	let lines = File(Location).ReadLines
	lines.Slice(1, lines.Length - 1)
Saved(survivors Texts) Boolean
	Sample.Saved(List(Text))
	File(Location).Write(Text.Combine(List(Text) + Stamp + survivors, "\n"))
	File(Location).Exists
Held(slots Text) Texts
	MutationCache("Compiler/output/Missing/Waiting.strict", true).Held("Compiler/output/Missing/Deeper").Length is 0
	Sample.Saved(List(Text)) and (Sample.Held("Compiler/output/Missing/Deeper").Length is 0)
	let whole = isWhole and (IsCurrent is false) then Claimed(List(Text) + Lock) else List(Text)
	if IsCurrent
		return Released(whole) then List(Text) else whole
	whole + Claimed(Slotted(slots))
Lock Text
	Sample.Lock is Sample.Location + "." + HashCode(Sample.Stamp).number + ".lock"
	Location + "." + HashCode(Stamp).number + ".lock"
Claimed(locks Texts) Texts
	MutationCache.Claimed(List(Text) + "Compiler/output/Missing/Deeper/Waiting.lock").Length is 0
	MutationCache.Claimed(List(Text) + ("Compiler/output/Claimed" + Process.Elapsed + ".lock")).Length is 1
	let folder = Path(locks.First).PathOnly.text
	if (Directory.Exists(folder) is false) and Directory.Exists(Path(folder).PathOnly.text)
		Directory.Create(folder)
	let started = Process.Elapsed
	for as long as Directory.Exists(folder) and (Process.Elapsed - started < RunWait)
		for locks
			if File(value).Locked
				return List(Text) + value
		Process.Wait(0.1)
	List(Text)
Released(locks Texts) Boolean
	MutationCache.Released(MutationCache.Claimed(List(Text) + ("Compiler/output/Released" + Process.Elapsed + ".lock")))
	for locks
		File(value).Delete
	for locks
		if File(value).Exists
			return false
	true
Slotted(folder Text) Texts
	MutationCache.Slotted("obj").Length is MaxRuns
	MutationCache.Slotted("obj").Last is "obj/mutation25.slot"
	for Range(0, MaxRuns)
		folder + "/mutation" + value + ".slot"
Exhausted(slots List(VmValue)) List(VmValue)
	MutationCache.Exhausted(Frame.Listed)(Frame.ResultSlot).kind is "Strict/Error"
	mutable exhausted = slots
	exhausted(Frame.ResultSlot) = VmValue.OfError("Timeout")
	exhausted
