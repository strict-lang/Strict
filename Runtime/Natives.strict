has types List(TypeEntry)
has folder Text = ""
constant Width = MemberEntry("width", "Strict/Number", List(InstructionEntry), false)
constant Shape = TypeEntry("Strict/Shape", (Width, MemberEntry.LoggerMember), List(MethodEntry))
constant Shapes = Natives(List(TypeEntry) + Shape)
constant NewShape = Invocation(InstructionEntry.Invoke(1, ("Strict/Shape", "from", "Strict/Shape", "width"), 0, -1), List(VmValue) + VmValue.OfNumber(3), VmValue.None)
constant Degree = TypeEntry("Strict/Degree", List(MemberEntry) + Width, List(MethodEntry))
constant NewDegree = Invocation(InstructionEntry.Invoke(1, ("Strict/Degree", "from", "Strict/Degree", "width"), 0, -1), NewShape.Arguments, VmValue.None)
constant Single = TypeEntry("Strict/Single", List(MemberEntry) + MemberEntry("width", "Strict/Number", List(InstructionEntry), false, 32), List(MethodEntry))
constant Byted = TypeEntry("Strict/Byte", (MemberEntry("number", "Strict/Number", List(InstructionEntry), false, 8), MemberEntry("Max", "Strict/Number", List(InstructionEntry), true)), List(MethodEntry))
constant Pixel = TypeEntry("Strict/Pixel", (MemberEntry("Red", "Strict/Byte", List(InstructionEntry), false), MemberEntry("Green", "Strict/Byte", List(InstructionEntry), false)), List(MethodEntry))
constant NewPixel = Invocation(InstructionEntry.Invoke(1, ("Strict/Pixel", "from", "Strict/Pixel", "Red", "Green"), 0, -1), (VmValue.OfNumber(127.5), VmValue.OfNumber(3)), VmValue.None)
constant NewSingle = Invocation(InstructionEntry.Invoke(1, ("Strict/Single", "from", "Strict/Single", "width"), 0, -1), List(VmValue) + VmValue.OfNumber(0.1), VmValue.None)
constant Pairs = VmValue.OfList(VmValue.OfList(VmValue.OfNumber(1), VmValue.OfNumber(3)), VmValue.OfList(VmValue.OfNumber(2), VmValue.OfNumber(4)))
constant BcTwo = (VmValue.OfText("bc"), VmValue.OfNumber(2))
constant Either = MethodEntry("from", List(MemberEntry) + MemberEntry("input", "Strict/Number or Text", List(InstructionEntry), false), "Strict/Character", List(InstructionEntry))
constant Cut = VmValue.OfError("SubstringOutOfRange")
constant TextMethods = ("StartsWith", "EndsWith", "IndexOf", "LastIndexOf", "Substring", "Upper", "Lower", "Capitalize", "Trim", "TrimStart", "TrimEnd", "Bytes", "Utf8")
Result(call Invocation) VmValue
	Shapes.Result(NewShape).items.First.number is 3 and Shapes.Result(Invocation.Parsing).number is 5
	name = call.MethodName
	if name is "from"
		type = TypeOf(call.TypeName)
		if type.members.Length is 1 and type.methods.Length > 0
			return Foreign(call, types, folder).Construct(type)
		return Rounding.Single.Build(type, call, value, type.IsStruct)
	if name is in ("to", "Code")
		return name is "to" then Convert(call.Instance, call.ReturnType) else VmValue.OfText(ValueCode(call.Instance).Code)
	if name is in ("Length", "Count")
		return VmValue.OfNumber(call.Instance.CountMatches(call.Arguments))
	name is in ("not", "and", "or", "xor") then Logical(name, call.Instance, call) else Query(name, call.Instance, call)
Key(name Text, pairs VmValue, arguments List(VmValue)) VmValue
	Shapes.Key("get", Pairs, List(VmValue) + VmValue.OfNumber(2)).number is 4
	Shapes.Key("Add", Pairs, (VmValue.OfNumber(2), VmValue.OfNumber(5))) is VmValue.OfError("DuplicateKey")
	Shapes.Key("Remove", Pairs, List(VmValue) + VmValue.OfNumber(1)).Length is 1
	Shapes.Key("set", Pairs, (VmValue.OfNumber(2), VmValue.OfNumber(5))).items.Last.items.Last.number is 5
	found = ValueSearch(pairs.items).Key(arguments.First)
	if name is "in"
		return VmValue.OfBoolean(found >= 0)
	if name is "get"
		return found >= 0 then pairs.items(found).items.Last else VmValue.OfError("KeyNotFound")
	if found < 0
		return name is "Remove" then pairs else VmValue.OfList(pairs.items + VmValue.OfList(arguments))
	name is "Add" then VmValue.OfError("DuplicateKey") else Change(name, pairs, found, arguments)
Change(name Text, pairs VmValue, position Number, arguments List(VmValue)) VmValue
	Shapes.Initial(Byted.members(1)) is VmValue.None
	Shapes.Initial(MemberEntry("flag", "Strict/Boolean", List(InstructionEntry), false)) is VmValue.FalseValue
	Shapes.Change("Remove", Pairs, 0, List(VmValue) + VmValue.OfNumber(1)).items.First.items.First.number is 2
	Shapes.Change("set", Pairs, 0, (VmValue.OfNumber(1), VmValue.OfNumber(5))).items.First.items.Last.number is 5
	if name is "set"
		return VmValue.OfList(Storage(types).Replace(pairs.items, position, VmValue.OfList(arguments)))
	mutable kept = List(Mutable(VmValue))
	for pairs.items
		if index is not position
			kept.Add(value)
	VmValue.OfList(kept)
Convert(instance VmValue, target Text) VmValue
	Shapes.Convert(VmValue.OfText("5"), "Strict/Number").number is 5
	Shapes.Convert(VmValue.OfList(VmValue.OfNumber(6)), "Strict/List(Number)").items.First.number is 6
	Shapes.Convert(VmValue.OfNumber(2), "Strict/Text").text is "2"
	Shapes.Convert(VmValue.OfNumber(75), "Strict/Character").text is "7"
	Shapes.Convert(VmValue.OfText(""), "Strict/Character").text is ""
	Shapes.Convert(VmValue.OfText("ab"), "Strict/Character").kind is in VmValue.ErrorKinds
	if target.StartsWith("Strict/List(")
		mutable converted = List(Mutable(VmValue))
		for instance.items
			converted.Add(Convert(value, target is "Strict/List(Text)" then "Strict/Text" else "Strict/Number"))
		return VmValue.OfList(converted)
	if target is "Strict/Number"
		return instance.kind is "Number" then instance else Parse(instance.text)
	text = instance to Text
	if target is "Strict/Character" and instance.kind is "Text" and text.Length > 1
		return VmValue.OfError("InvalidCharacter")
	VmValue.OfText(target is "Strict/Character" then text.Substring(0, text.Length is 0 then 0 else 1) else text)
Parse(text Text) VmValue
	Shapes.Parse("5").number is 5
	Shapes.Parse("abc").items.First.text is "InvalidNumber: abc"
	Shapes.Search("EndsWith", "abbc", BcTwo).IsTrue and Shapes.Search("EndsWith", "ab", BcTwo).IsTrue is false
	number = text to Number
	number is Error then VmValue.OfError("InvalidNumber: " + TraceEntry.Cut(text)) else VmValue.OfNumber(number)
Logical(name Text, left VmValue, call Invocation) VmValue
	Shapes.Logical("not", VmValue.OfBoolean(true), NewShape).IsTrue is false
	Shapes.Logical("and", VmValue.TrueValue, NewShape).IsTrue is false
	if name is "not"
		return VmValue.OfBoolean(left.IsTrue is false)
	right = call.Arguments.First
	if call.TypeName.EndsWith("Number") then TypeEntry.ShortName(call.TypeName) is "Number" else false
		return VmValue.OfNumber(Bitwise(name, left.number, right.number))
	isLeft = left.IsTrue
	isRight = right.IsTrue
	if name is "xor"
		return VmValue.OfBoolean(isLeft is not isRight)
	VmValue.OfBoolean(name is "and" then isLeft and isRight else isLeft or isRight)
Bitwise(name Text, left Number, right Number) Number
	Shapes.Logical("not", VmValue.FalseValue, NewShape) is VmValue.TrueValue
	Shapes.Logical("and", VmValue.TrueValue, Invocation(NewShape.entry, VmValue.TrueValue, Pairs)).IsTrue
	Shapes.Logical("or", VmValue.FalseValue, Invocation(NewShape.entry, VmValue.TrueValue, Pairs)).IsTrue
	Shapes.Logical("or", VmValue.TrueValue, NewShape).IsTrue and Shapes.Logical("xor", VmValue.TrueValue, NewShape).IsTrue
	Shapes.Logical("xor", VmValue.TrueValue, Invocation(NewShape.entry, VmValue.TrueValue, Pairs)) is VmValue.FalseValue
	Shapes.Logical("or", VmValue.OfNumber(8), Invocation(HostedMath.Logging.entry, NewShape.Arguments, Pairs)).number is 11
	Shapes.Bitwise("xor", 12, 10) is 6
	Shapes.Bitwise("and", 12, 10) is 8
	Shapes.Bitwise("or", 12, 10) is 14
	name is "and" then left and right else name is "or" then left or right else left xor right
Query(name Text, instance VmValue, call Invocation) VmValue
	Shapes.Query("in", VmValue.OfList(VmValue.OfNumber(3)), NewShape).IsTrue
	Shapes.Query("Index", VmValue.Numbered, NewShape).number is -1
	Shapes.Query("Fail", VmValue.None, NewShape).kind is "Strict/Error"
	if call.TypeName.StartsWith("Strict/Dictionary(")
		return Key(name, instance, call.Arguments)
	position = name is in ("in", "Index") then ValueSearch(instance.items).Index(call.Arguments.First) else -1
	if name is "in"
		return VmValue.OfBoolean(position >= 0)
	name is "Index" then VmValue.OfNumber(position) else Foreign(call, types, folder).Called
Search(name Text, text Text, arguments List(VmValue)) VmValue
	Shapes.Search("StartsWith", "abbc", BcTwo).IsTrue and Shapes.Search("IndexOf", "bcbcbc", BcTwo).number is 2
	Shapes.Search("Substring", "abc", BcTwo).text is "ab" and Shapes.Search("Substring", "a", BcTwo) is Cut
	Shapes.Search("Substring", "abc", List(VmValue) + VmValue.OfNumber(1)).text is "bc"
	if arguments.Length is 0 or name is "Utf8"
		return name is in ("Bytes", "Utf8") then ByteTexts(name, text, arguments) else Edit(name, text)
	first = arguments.First
	second = arguments.Length > 1 then arguments(1).number else name is "Substring" then Text.End else 0
	if name is "Substring"
		part = text.Substring(first.number, second)
		return part is Error then Cut else VmValue.OfText(part)
	if name is in ("StartsWith", "EndsWith")
		return VmValue.OfBoolean(name is "EndsWith" then text.EndsWith(first.text) else text.StartsWith(first.text, second))
	VmValue.OfNumber(name is "IndexOf" then text.IndexOf(first.text, second) else text.LastIndexOf(first.text))
ByteTexts(name Text, text Text, arguments List(VmValue)) VmValue
	Shapes.ByteTexts("Bytes", "ab", List(VmValue)).items.Last.number is 98
	Shapes.ByteTexts("Bytes", "", List(VmValue)).items.Length is 0
	Shapes.ByteTexts("Utf8", "", List(VmValue) + Shapes.ByteTexts("Bytes", "ab", List(VmValue))).text is "ab"
	mutable numbers = List(VmValue)
	for text.Bytes
		numbers = numbers + VmValue.OfNumber(value)
	if name is "Bytes"
		return VmValue.OfList(numbers)
	mutable bytes = List(Number)
	for arguments.First.items
		bytes = bytes + value.number
	VmValue.OfText(Text.Utf8(bytes))
Edit(name Text, text Text) VmValue
	Shapes.Edit("Capitalize", "ab").text is "Ab" and Shapes.Edit("Trim", " a ").text is "a"
	Shapes.Edit("TrimEnd", " a ").text is " a" and Shapes.Edit("TrimStart", " a ").text is "a "
	Shapes.Edit("Upper", "ab").text is "AB" and Shapes.Edit("Lower", "AB").text is "ab"
	if name is "Upper"
		return VmValue.OfText(text.Upper)
	if name is "Lower"
		return VmValue.OfText(text.Lower)
	if name is "Capitalize"
		return VmValue.OfText(text.Capitalize)
	if name is "Trim"
		return VmValue.OfText(text.Trim)
	VmValue.OfText(name is "TrimStart" then text.TrimStart else text.TrimEnd)
Construct(call Invocation) VmValue
	Shapes.Initial(MemberEntry("list", "Strict/List(Number)", List(InstructionEntry), false)).kind is "List"
	Shapes.Construct(Shape, Frame.Listed).items.Last is Frame.Listed(7)
	Natives((TypeEntry("Strict/X/Shape", List(MemberEntry), List(MethodEntry)), Shape)).TypeOf("Strict/Shape") is Shape
	Shapes.Construct(NewShape).kind is "Strict/Shape"
	Natives(List(TypeEntry) + Degree).Construct(NewDegree).number is 3
	Natives(List(TypeEntry) + Single).Construct(NewSingle).number is 0.10000000149011612
	Natives((Byted, Pixel)).Construct(NewPixel).items.First.number is 127
	type = TypeOf(call.TypeName)
	Rounding.Single.Build(type, call, value, type.IsStruct)
Fresh(type TypeEntry) VmValue
	Shapes.Key("in", Pairs, List(VmValue) + VmValue.OfNumber(2)) is VmValue.TrueValue
	Shapes.Key("in", Pairs, List(VmValue) + VmValue.OfNumber(7)) is VmValue.FalseValue
	Shapes.Key("get", Pairs, List(VmValue) + VmValue.OfNumber(7)) is VmValue.OfError("KeyNotFound")
	Shapes.Key("Remove", Pairs, List(VmValue) + VmValue.OfNumber(7)) is Pairs
	Shapes.Key("Add", Pairs, (VmValue.OfNumber(7), VmValue.OfNumber(8))).items.Last.items.Last.number is 8
	Shapes.Fresh(Shape).items.First.number is 0
	mutable values = List(Mutable(VmValue))
	for type.members
		values.Add(Initial(value))
	VmValue(type.Name, 0, "", values)
Construct(type TypeEntry, finished List(VmValue)) VmValue
	Shapes.Construct(Shape, Frame.Listed).items.First.number is 1
	Shapes.Construct(Shape, (VmValue.None, VmValue.None, VmValue.OfError("a"))).kind is "Strict/Error"
	result = finished(Frame.ResultSlot)
	if result.kind is in VmValue.ErrorKinds
		return result
	natives = value
	mutable values = List(Mutable(VmValue))
	for type.members
		values.Add(Rounding.Single.RoundedValue(value, finished(Frame.MembersSlot + index), natives))
	built = VmValue(type.Name, 0, "", values)
	changed = result.kind is "Changing" then result.items.Slice(1, result.items.Length - 1) else List(VmValue)
	changed.Length is 0 then built else VmValue(result, items = (List(VmValue) + built) + changed)
Initial(member MemberEntry) VmValue
	Shapes.Initial(Width).number is 0 and Shapes.Initial(Width).kind is "Number"
	Shapes.Initial(MemberEntry.SevenMember).number is 7 and Shapes.Initial(MemberEntry.LoggerMember).kind is "None"
	Shapes.Initial(MemberEntry("t", "Strict/Text", List(InstructionEntry), false)).kind is "Text"
	Shapes.Initial(MemberEntry("table", "Strict/Dictionary(Number, Number)", List(InstructionEntry), false)).kind is "List"
	if member.IsConstant or member.initial.Length > 0
		return member.initial.Length is 0 then VmValue.None else PayloadDecoder(member.initial.First).Value(0)
	if member.typeName is "Strict/Number"
		return VmValue.OfNumber(0)
	if member.typeName is in ("Strict/Text", "Strict/Boolean")
		return member.typeName is "Strict/Text" then VmValue.OfText("") else VmValue.OfBoolean(false)
	isList = member.typeName.StartsWith("Strict/List") or member.typeName.StartsWith("Strict/Dictionary")
	isList then VmValue.OfList(List(VmValue)) else VmValue.None
IsMemberCall(call Invocation, type TypeEntry, chosen MethodEntry) Boolean
	Shapes.Convert(VmValue.OfList(VmValue.OfNumber(1)), "Strict/List(Text)") is VmValue.OfList(VmValue.OfText("1"))
	Shapes.Convert(VmValue.OfNumber(75), "Strict/Text").text is "75"
	Shapes.Search("Upper", "ab", List(VmValue)).text is "AB"
	Shapes.Search("StartsWith", "abc", List(VmValue) + VmValue.OfText("ab")) is VmValue.TrueValue
	Shapes.Search("IndexOf", "abab", (VmValue.OfText("a"), VmValue.OfNumber(1))).number is 2
	Shapes.Search("LastIndexOf", "abab", List(VmValue) + VmValue.OfText("b")).number is 3
	Natives(TypeEntry.Holding).IsMemberCall(Invocation.Coding, TypeEntry.Rounded, TypeEntry.Rounded.methods.First) is false
	Natives(TypeEntry.Holding).IsMemberCall(Invocation.Coding, TypeEntry.CharacterEntry, TypeEntry.ToNumber)
	Natives(TypeEntry.Holding).IsMemberCall(Invocation.Coding, TypeEntry.CharacterEntry, Either) is false
	declared = chosen.parameters.Length is 1 then chosen.parameters.First.typeName else ""
	parameter = TypeOf(declared)
	kind = parameter.Wrapped is "" then TypeEntry.ShortName(parameter.Name) else parameter.Wrapped
	isEither = declared.IndexOf(" or ") > 0
	call.IsWrapping(type) and kind is not TypeEntry.ShortName(type.Changing.First.typeName) and isEither is false
TypeOf(name Text) TypeEntry
	Shapes.TypeOf("Strict/Shape").members.Length is 2
	Shapes.TypeOf("Strict/Other").members.Length is 0
	Shapes.TypeOf("Shape").Name is "Strict/Shape"
	for types
		if value.Name is name
			return value
	short = name.Substring(name.LastIndexOf("/") + 1, name.Length - name.LastIndexOf("/") - 1)
	qualified = "/" + short
	for types
		if IsNamed(value, name, short, qualified)
			return value
	TypeEntry(name, List(MemberEntry), List(MethodEntry))
IsNamed(type TypeEntry, name Text, short Text, qualified Text) Boolean
	Shapes.IsNamed(Shape, "Shape", "Shape", "/Shape")
	Shapes.IsNamed(Shape, "Strict/Other", "Other", "/Other") is false
	Shapes.IsNamed(TypeEntry("Shape", List(MemberEntry), List(MethodEntry)), "Strict/A/Shape", "Shape", "/Shape")
	Shapes.IsNamed(Shape, "Strict/Shape", "X", "/X")
	Shapes.IsNamed(Shape, "X/Shape", "Shape", "/Shape")
	Shapes.IsNamed(Shape, "B/ape", "ape", "/ape") is false
	type.Name is name or type.Name is short or type.Name.EndsWith(qualified)