has types List(TypeEntry)
constant Width = MemberEntry("width", "Strict/Number", List(InstructionEntry), false)
constant Shape = TypeEntry("Strict/Shape", (Width, MemberEntry.LoggerMember), List(MethodEntry))
constant Shapes = Natives(List(TypeEntry) + Shape)
constant NewShape = Invocation(InstructionEntry.Invoke(1, ("Strict/Shape", "from", "Strict/Shape", "width"), 0, -1), List(VmValue) + VmValue.OfNumber(3), VmValue.None)
constant Degree = TypeEntry("Strict/Degree", List(MemberEntry) + Width, List(MethodEntry))
constant NewDegree = Invocation(InstructionEntry.Invoke(1, ("Strict/Degree", "from", "Strict/Degree", "width"), 0, -1), NewShape.Arguments, VmValue.None)
constant Pairs = VmValue.OfList(VmValue.OfList(VmValue.OfNumber(1), VmValue.OfNumber(3)), VmValue.OfList(VmValue.OfNumber(2), VmValue.OfNumber(4)))
constant TextMethods = ("StartsWith", "IndexOf", "LastIndexOf", "Substring", "Upper", "Lower", "Capitalize", "Trim", "TrimStart", "TrimEnd")
Result(call Invocation) VmValue
	Shapes.Result(NewShape).items.First.number is 3
	let name = call.MethodName
	if name is "from"
		return Constructed(call)
	let instance = call.Instance
	if name is "to"
		return Converted(instance, call.ReturnType)
	if name is in ("Length", "Count")
		return VmValue.OfNumber(instance.Counted(call.Arguments))
	if name is in ("not", "and", "or", "xor")
		return Logical(name, instance, call)
	Queried(name, instance, call)
Keyed(name Text, pairs VmValue, arguments List(VmValue)) VmValue
	Shapes.Keyed("get", Pairs, List(VmValue) + VmValue.OfNumber(2)).number is 4
	Shapes.Keyed("Add", Pairs, (VmValue.OfNumber(2), VmValue.OfNumber(5))) is VmValue.OfError("DuplicateKey")
	Shapes.Keyed("Remove", Pairs, List(VmValue) + VmValue.OfNumber(1)).Length is 1
	let found = pairs.KeyIndex(arguments.First)
	if name is "in"
		return VmValue.OfBoolean(found >= 0)
	if name is "get"
		return found >= 0 then pairs.items(found).items.Last else VmValue.OfError("KeyNotFound")
	if name is "Remove"
		return found >= 0 then Unpaired(pairs, found) else pairs
	found >= 0 then VmValue.OfError("DuplicateKey") else VmValue.OfList(pairs.items + VmValue.OfList(arguments))
Unpaired(pairs VmValue, position Number) VmValue
	Shapes.Unpaired(Pairs, 0).items.First.items.First.number is 2
	mutable kept = List(Mutable(VmValue))
	for pairs.items
		if index is not position
			kept.Add(value)
	VmValue.OfList(kept)
Converted(instance VmValue, target Text) VmValue
	Shapes.Converted(VmValue.OfNumber(2), "Strict/Text").text is "2"
	Shapes.Converted(VmValue.OfText("5"), "Strict/Number").number is 5
	Shapes.Converted(VmValue.OfNumber(75), "Strict/Character").text is "7"
	Shapes.Converted(VmValue.OfList(VmValue.OfText("1")), "Strict/List(Number)").items.First.number is 1
	if target.StartsWith("Strict/List(")
		mutable converted = List(Mutable(VmValue))
		for instance.items
			converted.Add(Converted(value, target is "Strict/List(Text)" then "Strict/Text" else "Strict/Number"))
		return VmValue.OfList(converted)
	if target is "Strict/Number"
		return VmValue.OfNumber(instance.text to Number)
	VmValue.OfText(target is "Strict/Character" then (instance to Text).Substring(0, 1) else instance to Text)
Logical(name Text, left VmValue, call Invocation) VmValue
	Shapes.Logical("not", VmValue.OfBoolean(true), NewShape).IsTrue is false
	if name is "not"
		return VmValue.OfBoolean(left.IsTrue is false)
	let right = call.Arguments.First
	if TypeEntry.ShortName(call.TypeName) is "Number"
		return VmValue.OfNumber(Bitwise(name, left.number, right.number))
	let isLeft = left.IsTrue
	let isRight = right.IsTrue
	if name is "xor"
		return VmValue.OfBoolean(isLeft is not isRight)
	VmValue.OfBoolean(name is "and" then isLeft and isRight else isLeft or isRight)
Bitwise(name Text, left Number, right Number) Number
	Shapes.Bitwise("xor", 12, 10) is 6
	name is "and" then left and right else name is "or" then left or right else left xor right
Queried(name Text, instance VmValue, call Invocation) VmValue
	Shapes.Queried("in", VmValue.OfList(VmValue.OfNumber(3)), NewShape).IsTrue is true
	if call.TypeName.StartsWith("Strict/Dictionary(")
		return Keyed(name, instance, call.Arguments)
	if name is "in"
		return VmValue.OfBoolean(call.Arguments.First is in instance.items)
	if name is "Index"
		return VmValue.OfNumber(instance.items.Index(call.Arguments.First))
	VmValue("Error", 0, "Unsupported native call " + call.TypeName + "." + name, List(VmValue))
Searched(name Text, text Text, arguments List(VmValue)) VmValue
	Shapes.Searched("StartsWith", "abc", (VmValue.OfText("bc"), VmValue.OfNumber(1))).IsTrue is true
	Shapes.Searched("Substring", "abc", (VmValue.OfNumber(1), VmValue.OfNumber(2))).text is "bc"
	Shapes.Searched("IndexOf", "abc", List(VmValue) + VmValue.OfText("c")).number is 2
	if arguments.Length is 0
		return Edited(name, text)
	let first = arguments.First
	let second = arguments.Length > 1 then arguments(1).number else 0
	if name is "Substring"
		return VmValue.OfText(text.Substring(first.number, second))
	if name is "StartsWith"
		return VmValue.OfBoolean(text.StartsWith(first.text, second))
	VmValue.OfNumber(name is "IndexOf" then text.IndexOf(first.text, second) else text.LastIndexOf(first.text))
Edited(name Text, text Text) VmValue
	Shapes.Edited("Capitalize", "ab").text is "Ab"
	Shapes.Edited("TrimEnd", " a ").text is " a"
	if name is "Upper"
		return VmValue.OfText(text.Upper)
	if name is "Lower"
		return VmValue.OfText(text.Lower)
	if name is "Capitalize"
		return VmValue.OfText(text.Capitalize)
	if name is "Trim"
		return VmValue.OfText(text.Trim)
	VmValue.OfText(name is "TrimStart" then text.TrimStart else text.TrimEnd)
Constructed(call Invocation) VmValue
	Shapes.Constructed(NewShape).kind is "Strict/Shape"
	Natives(List(TypeEntry) + Degree).Constructed(NewDegree).number is 3
	let type = TypeOf(call.TypeName)
	let arguments = call.Arguments
	if (type.members.Length is 0) or (type.IsStruct is false)
		return arguments.Length > 0 then arguments.First.As(call.TypeName) else VmValue.None
	mutable values = List(Mutable(VmValue))
	for type.members
		let argument = call.ParameterNames.Index(value.Name)
		let chosen = argument < 0 then index else argument
		values.Add((value.IsConstant is false) and (chosen < arguments.Length) then arguments(chosen) else Initial(value))
	VmValue(call.TypeName, 0, "", values)
Fresh(type TypeEntry) VmValue
	Shapes.Fresh(Shape).items.First.number is 0
	mutable values = List(Mutable(VmValue))
	for type.members
		values.Add(Initial(value))
	VmValue(type.Name, 0, "", values)
Initial(member MemberEntry) VmValue
	Shapes.Initial(Width).number is 0
	Shapes.Initial(MemberEntry.SevenMember).number is 7
	if member.initial.Length > 0
		return PayloadDecoder(member.initial.First).Value(0)
	if member.typeName is "Strict/Number"
		return VmValue.OfNumber(0)
	if member.typeName is "Strict/Text"
		return VmValue.OfText("")
	if member.typeName is "Strict/Boolean"
		return VmValue.OfBoolean(false)
	member.typeName.StartsWith("Strict/List") then VmValue.OfList(List(VmValue)) else VmValue.None
TypeOf(name Text) TypeEntry
	Shapes.TypeOf("Strict/Shape").members.Length is 2
	Shapes.TypeOf("Strict/Other").members.Length is 0
	Shapes.TypeOf("Shape").Name is "Strict/Shape"
	for types
		if value.Name is name
			return value
	let short = Path(name).FileName.text
	for types
		if IsNamed(value, name, short)
			return value
	TypeEntry(name, List(MemberEntry), List(MethodEntry))
IsNamed(type TypeEntry, name Text, short Text) Boolean
	Shapes.IsNamed(Shape, "Shape", "Shape") is true
	Shapes.IsNamed(Shape, "Strict/Other", "Other") is false
	Shapes.IsNamed(TypeEntry("Shape", List(MemberEntry), List(MethodEntry)), "Strict/A/Shape", "Shape") is true
	if (type.Name is name) or (type.Name is short)
		return true
	let start = type.Name.Length - short.Length - 1
	type.Name.EndsWith(short) and (start >= 0) and (type.Name.Substring(start, 1) is "/")