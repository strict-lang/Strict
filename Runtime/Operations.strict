constant OneTwo = VmValue.OfList(VmValue.OfNumber(1), VmValue.OfNumber(2))
constant DimensionError = VmValue.OfError("listsHaveDifferentDimensions")
constant Hashed = VmValue("Strict/HashCode(Type)", 0, "", List(VmValue) + VmValue.OfNumber(5))
constant Letter = VmValue("Strict/Character", 0, "", List(VmValue) + VmValue.OfNumber(97))
constant Detailed = VmValue("Strict/ErrorWithValue", 0, "", (DimensionError, OneTwo))
constant Wrapped = VmValue.OfList(List(VmValue) + Letter)
constant EmptyTextList = VmValue.OfList(List(VmValue) + VmValue.OfText(""))
constant Undefined = VmValue.OfNumber(0 / 0)
Result(kind Number, left VmValue, right VmValue) VmValue
	Result(InstructionType.Add, VmValue.OfNumber(3), VmValue.OfNumber(4)).number is 7
	Result(InstructionType.LessThan, VmValue.OfNumber(3), VmValue.OfNumber(4)).IsTrue
	Result(InstructionType.Subtract, OneTwo, Letter).Length is 2
	Result(InstructionType.Modulo, Letter, DimensionError) is DimensionError
	Result(InstructionType.Add, VmValue.OfText("a"), DimensionError).kind is "Text"
	Result(InstructionType.Multiply, OneTwo, VmValue.OfNumber(2)).items.Last.number is 4
	Result(InstructionType.Divide, OneTwo, VmValue.OfList(List(VmValue) + VmValue.OfNumber(2))).items.Last.number is 1
	Result(InstructionType.Divide, VmValue.OfList(List(VmValue) + VmValue.OfNumber(2)), OneTwo).Length is 2
	Result(InstructionType.NotEqual, VmValue.OfText("a"), VmValue.OfText("b")).IsTrue
	if kind > InstructionType.ArithmeticSeparator
		return VmValue.OfBoolean(IsComparison(kind, left, right))
	Calculated(kind, left, right)
IsComparison(kind Number, left VmValue, right VmValue) Boolean
	IsComparison(InstructionType.GreaterThan, VmValue.OfNumber(3), VmValue.OfNumber(1))
	IsComparison(InstructionType.Equal, VmValue.OfText("a"), VmValue.OfText("a"))
	IsComparison(InstructionType.Equal, Detailed, DimensionError)
	IsComparison(InstructionType.Equal, Hashed, VmValue("Strict/HashCode(Texts)", 0, "", Hashed.items))
	IsComparison(InstructionType.Equal, Detailed, VmValue.OfError(""))
	IsComparison(InstructionType.NotEqual, VmValue.OfNumber(1), VmValue.OfError(""))
	IsComparison(InstructionType.GreaterThan, VmValue.OfNumber(1), VmValue.OfNumber(3)) is false
	IsComparison(InstructionType.NotEqual, VmValue.OfNumber(1), VmValue.OfNumber(1)) is false
	IsComparison(InstructionType.Equal, VmValue.OfNumber(1), VmValue.OfNumber(2)) is false
	IsComparison(InstructionType.OfType, VmValue.OfText("a"), VmValue.OfText("Text"))
	if kind is InstructionType.Equal or kind is InstructionType.NotEqual
		return IsSame(left, right) is (kind is InstructionType.Equal)
	if kind is InstructionType.OfType
		return KindName(left.kind) is right.text
	IsOrdered(kind is InstructionType.LessThan, left, right)
IsOrdered(isLess Boolean, left VmValue, right VmValue) Boolean
	IsOrdered(false, Letter, VmValue.OfNumber(10))
	IsOrdered(true, VmValue.OfText("a"), VmValue.OfText("b"))
	IsOrdered(false, VmValue.OfText("b"), VmValue.OfText("ab"))
	IsOrdered(true, VmValue.OfNumber(10), Letter)
	IsOrdered(true, VmValue.OfNumber(2), VmValue.OfNumber(1)) is false
	IsOrdered(false, VmValue.OfNumber(1), VmValue.OfNumber(2)) is false
	if left.kind is "Text"
		return isLess then left.text < right.text else right.text < left.text
	leftNumber = left.items.Length is 0 then left.number else Comparable(left).number
	rightNumber = right.items.Length is 0 then right.number else Comparable(right).number
	isLess then leftNumber < rightNumber else leftNumber > rightNumber
KindName(kind Text) Text
	KindName("Strict/List(Number)") is "List" and KindName("Number") is "Number"
	KindName("Strict/Examples/Pair") is "Pair"
	IsComparison(InstructionType.OfType, Letter, VmValue.OfText("Text")) is false
	kind.Split("(").First.Split("/").Last
IsSame(left VmValue, right VmValue) Boolean
	IsSame(DimensionError, VmValue.OfError("")) and IsSame(VmValue.OfNumber(1), VmValue.OfNumber(1))
	IsSame(VmValue.OfNumber(1), VmValue.OfError("")) is false and IsSame(DimensionError, VmValue.OfError("x")) is false
	IsSame(VmValue.OfError(""), DimensionError) and IsSame(VmValue.OfNumber(0), VmValue.OfText("x")) is false
	IsSame(EmptyTextList, DimensionError) is false and IsSame(DimensionError, EmptyTextList) is false
	if left.kind is right.kind and left.kind is in ("Number", "Text", "Boolean", "None")
		return left.kind is "Text" then left.text is right.text else left.number is right.number
	compared = Comparable(left)
	other = Comparable(right)
	isError = compared.kind is "Strict/Error" and other.kind is "Strict/Error"
	isLeftAny = compared.items.Length > 0 and compared.items.First.text is ""
	isAny = isLeftAny or other.items.Length > 0 and other.items.First.text is ""
	isError and isAny or compared is other
Comparable(operand VmValue) VmValue
	Comparable(Detailed) is DimensionError
	Comparable(VmValue.Failed) is VmValue.OfError("x")
	Comparable(VmValue("Strict/Degree", 0, "", List(VmValue) + VmValue.OfNumber(7))) is VmValue.OfNumber(7)
	Comparable(VmValue("Strict/Pair(Number)", 0, "", OneTwo.items)).kind is "Strict/Pair"
	Comparable(Wrapped).kind is "List" and Comparable(VmValue("A(B)", 0, "", List(VmValue))).kind is "A(B)"
	compared = operand.kind is "Strict/ErrorWithValue" then operand.items.First else operand
	if compared.kind is "Strict/Error"
		return VmValue.OfError(compared.items.First.text)
	if compared.items.Length is 1 and compared.kind is not in ("List", "Text", "Number", "Boolean", "None")
		return Comparable(compared.items.First)
	open = compared.items.Length is 0 then -1 else compared.kind.IndexOf("(")
	open > 0 then VmValue(compared.kind.Substring(0, open), compared.number, compared.text, compared.items) else compared
Calculated(kind Number, left VmValue, right VmValue) VmValue
	Calculated(InstructionType.Modulo, VmValue.OfNumber(7), VmValue.OfNumber(4)).number is 3
	Calculated(InstructionType.Multiply, OneTwo, OneTwo).Length is 2
	Calculated(InstructionType.Divide, OneTwo, VmValue.OfNumber(2)).Length is 2
	Calculated(InstructionType.Modulo, VmValue.OfNumber(7), Undefined) is VmValue.OfError("ModuloByZero")
	Calculated(InstructionType.Add, VmValue.OfNumber(3), OneTwo).Length is 3
	Calculated(InstructionType.Divide, OneTwo, VmValue.OfList(List(VmValue))) is DimensionError
	if left.kind is "Number" and right.kind is "Number"
		if kind <= InstructionType.Multiply
			return VmValue.OfNumber(QuickNumeric(kind, left.number, right.number))
		return Computed(kind, left.number, right.number)
	Mixed(kind, left, right)
QuickNumeric(kind Number, left Number, right Number) Number
	QuickNumeric(InstructionType.Add, 2, 3) is 5
	QuickNumeric(InstructionType.Multiply, 2, 3) is 6
	QuickNumeric(InstructionType.Subtract, 2, 3) is -1
	kind is InstructionType.Add then left + right else kind is InstructionType.Subtract then left - right else left * right
Mixed(kind Number, left VmValue, right VmValue) VmValue
	Mixed(InstructionType.Add, DimensionError, VmValue.OfText("a")).kind is "Text"
	Mixed(InstructionType.Add, VmValue.OfNumber(1), VmValue.OfNumber(2)).number is 3
	Mixed(InstructionType.Multiply, VmValue.OfNumber(2), VmValue.OfNumber(3)).number is 6
	Mixed(InstructionType.Subtract, OneTwo, VmValue.OfNumber(1)).Length is 1
	isValue = left.kind is not in ("Text", "List") and right.kind is not in ("Text", "List")
	if isValue and (left.kind is "Strict/Error" or right.kind is "Strict/Error")
		return left.kind is "Strict/Error" then left else right
	if kind is InstructionType.Add
		return Added(left, right)
	if left.kind is "List"
		return kind is InstructionType.Subtract then Removed(left, right) else Zipped(kind, left, right)
	Computed(kind, left.number, right.number)
Computed(kind Number, left Number, right Number) VmValue
	Computed(InstructionType.Divide, 6, 4).number is 1.5
	number = Numeric(kind, left, right)
	number is Error then VmValue.OfError(number.Name.text) else VmValue.OfNumber(number)
Numeric(kind Number, left Number, right Number) Number
	Numeric(InstructionType.Modulo, 7, 4) is 3
	Calculated(InstructionType.Modulo, DimensionError, VmValue.OfNumber(1)) is DimensionError
	Calculated(InstructionType.Modulo, VmValue.OfNumber(7), VmValue.OfNumber(0)) is VmValue.OfError("ModuloByZero")
	Numeric(InstructionType.Subtract, 7, 4) is 3 and Numeric(InstructionType.Multiply, 7, 4) is 28
	Numeric(InstructionType.Divide, 8, 4) is 2 and Numeric(InstructionType.Power, 2, 3) is 8
	if kind is InstructionType.Subtract
		return left - right
	if kind is InstructionType.Multiply
		return left * right
	if kind is InstructionType.Divide
		return left / right
	kind is InstructionType.Modulo then left % right else left ^ right
Added(left VmValue, right VmValue) VmValue
	Added(VmValue.OfText("a"), VmValue.OfNumber(1)).text is "a1"
	Added(VmValue.OfList(List(VmValue)), VmValue.OfNumber(1)).Length is 1 and Added(OneTwo, OneTwo).Length is 4
	Added(OneTwo, VmValue.OfNumber(3)).items.Last.number is 3 and Added(Letter, OneTwo).items.First is Letter
	Added(VmValue.OfNumber(1), VmValue.OfText("b")).text is "1b" and Added(Letter, OneTwo).Length is 3
	Added(VmValue.OfList(List(VmValue) + VmValue.OfText("a")), OneTwo).items.Last.kind is "Text"
	if left.kind is "List"
		return Concatenated(left, right.kind is "List" then right.items else List(VmValue) + right)
	if right.kind is "List"
		return VmValue.OfList(List(VmValue) + left + right.items)
	if left.kind is "Text" or right.kind is "Text"
		return VmValue.OfText(left to Text + right to Text)
	VmValue.OfNumber(left.number + right.number)
Removed(elements VmValue, element VmValue) VmValue
	Removed(OneTwo, VmValue.OfNumber(1)).items.First.number is 2
	Removed(OneTwo, OneTwo).Length is 0
	unwanted = element.kind is "List" then element.items else List(VmValue) + element
	mutable remaining = List(Mutable(VmValue))
	for elements.items
		if value is not in unwanted
			remaining.Add(value)
	VmValue.OfList(remaining)
Concatenated(left VmValue, others List(VmValue)) VmValue
	Concatenated(OneTwo, OneTwo.items).Length is 4
	Concatenated(OneTwo, List(VmValue) + VmValue.OfText("a")).kind is "Strict/Error"
	Concatenated(Wrapped, List(VmValue) + VmValue.OfText("a")).kind is "List"
	Concatenated(VmValue.OfList(List(VmValue)), List(VmValue) + VmValue.OfText("a")).Length is 1
	Concatenated(OneTwo, List(VmValue)).Length is 2 and Concatenated(OneTwo, OneTwo.items).kind is "List"
	if left.items.Length > 0 and left.items.First.kind is "Number" and others.Length > 0 and others.First.kind is "Text"
		return VmValue.OfError("Cannot downcast Text to Number for list: Text \"" + others.First.text + "\"")
	VmValue.OfList(left.items + Matching(left, others))
Matching(elements VmValue, others List(VmValue)) List(VmValue)
	Matching(VmValue.OfList(List(VmValue) + VmValue.OfText("a")), OneTwo.items).First.kind is "Text"
	Matching(VmValue.OfList(List(VmValue)), OneTwo.items).First.kind is "Number"
	Matching(OneTwo, OneTwo.items).First.kind is "Number"
	if elements.items.Length is 0 or elements.items.First.kind is not "Text"
		return others
	for others
		VmValue.OfText(value to Text)
Zipped(kind Number, left VmValue, right VmValue) VmValue
	Zipped(InstructionType.Multiply, OneTwo, OneTwo).items.Last.number is 4
	Zipped(InstructionType.Multiply, VmValue.OfList(List(VmValue)), VmValue.OfNumber(0.5)).items.Length is 0
	Zipped(InstructionType.Multiply, OneTwo, VmValue.OfList(List(VmValue) + VmValue.OfNumber(1))) is DimensionError
	others = right.kind is "List" then right.items else List(VmValue) + right
	spreads = kind is InstructionType.Divide or right.kind is not "List"
	if left.items.Length is not others.Length and (spreads and 1 is in (left.items.Length, others.Length)) is false
		return DimensionError
	length = left.items.Length is 0 or left.items.Length > others.Length then left.items.Length else others.Length
	mutable results = List(Mutable(VmValue))
	for length
		results.Add(Computed(kind, Element(left.items, index).number, Element(others, index).number))
	VmValue.OfList(results)
Element(items List(VmValue), position Number) VmValue
	Element(OneTwo.items, 1).number is 2
	items(items.Length is 1 then 0 else position)