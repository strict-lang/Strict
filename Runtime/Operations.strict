constant OneTwo = VmValue.OfList(VmValue.OfNumber(1), VmValue.OfNumber(2))
constant DimensionError = VmValue.OfError("listsHaveDifferentDimensions")
constant Hashed = VmValue("Strict/HashCode(Type)", 0, "", List(VmValue) + VmValue.OfNumber(5))
constant Detailed = VmValue("Strict/ErrorWithValue", 0, "", (DimensionError, OneTwo))
Result(kind Number, left VmValue, right VmValue) VmValue
	Result(InstructionType.Add, VmValue.OfNumber(3), VmValue.OfNumber(4)).number is 7
	Result(InstructionType.LessThan, VmValue.OfNumber(3), VmValue.OfNumber(4)).IsTrue is true
	if kind > InstructionType.ArithmeticSeparator
		return VmValue.OfBoolean(Comparison(kind, left, right))
	Calculated(kind, left, right)
Comparison(kind Number, left VmValue, right VmValue) Boolean
	Comparison(InstructionType.GreaterThan, VmValue.OfNumber(3), VmValue.OfNumber(1)) is true
	Comparison(InstructionType.Equal, VmValue.OfText("a"), VmValue.OfText("a")) is true
	Comparison(InstructionType.Equal, Detailed, DimensionError) is true
	Comparison(InstructionType.Equal, Hashed, VmValue("Strict/HashCode(Texts)", 0, "", Hashed.items)) is true
	if kind is InstructionType.Equal
		return Comparable(left) is Comparable(right)
	if kind is InstructionType.NotEqual
		return Comparable(left) is not Comparable(right)
	kind is InstructionType.LessThan then left.number < right.number else left.number > right.number
Comparable(operand VmValue) VmValue
	Comparable(Detailed) is DimensionError
	Comparable(VmValue.Failed) is VmValue.OfError("x")
	let compared = operand.kind is "Strict/ErrorWithValue" then operand.items.First else operand
	if compared.kind is "Strict/Error"
		return VmValue.OfError(compared.items.First.text)
	let open = compared.items.Length is 0 then -1 else compared.kind.IndexOf("(")
	open > 0 then VmValue(compared.kind.Substring(0, open), compared.number, compared.text, compared.items) else compared
Calculated(kind Number, left VmValue, right VmValue) VmValue
	Calculated(InstructionType.Modulo, VmValue.OfNumber(7), VmValue.OfNumber(4)).number is 3
	Calculated(InstructionType.Multiply, OneTwo, OneTwo).Length is 2
	Calculated(InstructionType.Divide, OneTwo, VmValue.OfNumber(2)).Length is 2
	Calculated(InstructionType.Modulo, DimensionError, VmValue.OfNumber(1)) is DimensionError
	let isValue = (left.kind is not in ("Text", "List")) and (right.kind is not in ("Text", "List"))
	if isValue and ((left.kind is "Strict/Error") or (right.kind is "Strict/Error"))
		return left.kind is "Strict/Error" then left else right
	if kind is InstructionType.Add
		return Added(left, right)
	if left.kind is "List"
		return kind is InstructionType.Subtract then Removed(left, right) else Zipped(kind, left, right)
	VmValue.OfNumber(Numeric(kind, left.number, right.number))
Numeric(kind Number, left Number, right Number) Number
	Numeric(InstructionType.Modulo, 7, 4) is 3
	if kind is InstructionType.Subtract
		return left - right
	if kind is InstructionType.Multiply
		return left * right
	if kind is InstructionType.Divide
		return left / right
	kind is InstructionType.Modulo then left % right else left ^ right
Added(left VmValue, right VmValue) VmValue
	Added(VmValue.OfText("a"), VmValue.OfNumber(1)).text is "a1"
	Added(VmValue.OfList(List(VmValue)), VmValue.OfNumber(1)).Length is 1
	Added(VmValue.OfList(List(VmValue) + VmValue.OfText("a")), OneTwo).items.Last.kind is "Text"
	if left.kind is "List"
		return Concatenated(left, right.kind is "List" then right.items else List(VmValue) + right)
	if right.kind is "List"
		return VmValue.OfList(List(VmValue) + left + right.items)
	if (left.kind is "Text") or (right.kind is "Text")
		return VmValue.OfText(left to Text + right to Text)
	VmValue.OfNumber(left.number + right.number)
Removed(elements VmValue, element VmValue) VmValue
	Removed(OneTwo, VmValue.OfNumber(1)).items.First.number is 2
	Removed(OneTwo, OneTwo).Length is 0
	let unwanted = element.kind is "List" then element.items else List(VmValue) + element
	mutable remaining = List(Mutable(VmValue))
	for elements.items
		if value is not in unwanted
			remaining.Add(value)
	VmValue.OfList(remaining)
Concatenated(left VmValue, others List(VmValue)) VmValue
	Concatenated(OneTwo, OneTwo.items).Length is 4
	Concatenated(OneTwo, List(VmValue) + VmValue.OfText("a")).kind is "Strict/Error"
	let isNumbers = (left.items.Length > 0) and (left.items.First.kind is "Number")
	if isNumbers and (others.Length > 0) and (others.First.kind is "Text")
		return VmValue.OfError("Cannot downcast Text to Number for list: Text \"" + others.First.text + "\"")
	VmValue.OfList(left.items + Matching(left, others))
Matching(elements VmValue, others List(VmValue)) List(VmValue)
	Matching(VmValue.OfList(List(VmValue) + VmValue.OfText("a")), OneTwo.items).First.kind is "Text"
	if (elements.items.Length is 0) or (elements.items.First.kind is not "Text")
		return others
	for others
		VmValue.OfText(value to Text)
Zipped(kind Number, left VmValue, right VmValue) VmValue
	Zipped(InstructionType.Multiply, OneTwo, OneTwo).items.Last.number is 4
	Zipped(InstructionType.Multiply, OneTwo, VmValue.OfList(List(VmValue) + VmValue.OfNumber(1))) is DimensionError
	let others = right.kind is "List" then right.items else List(VmValue) + right
	let spreads = (kind is InstructionType.Divide) or (right.kind is not "List")
	let isSingle = (left.items.Length is 1) or (others.Length is 1)
	if (left.items.Length is not others.Length) and ((spreads and isSingle) is false)
		return DimensionError
	let length = left.items.Length > others.Length then left.items.Length else others.Length
	mutable results = List(Mutable(VmValue))
	for length
		results.Add(VmValue.OfNumber(Numeric(kind, Element(left.items, index).number, Element(others, index).number)))
	VmValue.OfList(results)
Element(items List(VmValue), position Number) VmValue
	Element(OneTwo.items, 1).number is 2
	items(items.Length is 1 then 0 else position)