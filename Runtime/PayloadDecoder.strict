has entry Bytecode/InstructionEntry
constant Ones = PayloadDecoder(InstructionEntry(InstructionType.LoadConstantToRegister, ("Strict/List(Number)"), (0, 6, -1, 2, 1, 1, 3, 0, 0, 0, 0, 0, 0, 248, 63)))
constant ElementStore = InstructionEntry.Named(InstructionType.StoreRegisterToVariable, 0, "list(index)")
constant Paired = PayloadDecoder(InstructionEntry.Invoke(1, ("Strict/Vector", "Scaled", "Strict/Number", "x", "y"), (0, 0), -1))
constant Scaled = PayloadDecoder(InstructionEntry.Invoke(1, ("Strict/Vector", "*", "Strict/Vector", "scale"), List(Number) + 0, -1))
Value(position Number) VmValue
	PayloadDecoder(InstructionEntry.LoadNumber(0, 7)).Value(1).number is 7
	PayloadDecoder(InstructionEntry.LoadText(0, "a")).Value(1).text is "a"
	PayloadDecoder(InstructionEntry.LoadBoolean(0, true)).Value(1).IsTrue
	let kind = entry.payload(position)
	if kind is 1
		return VmValue.OfNumber(entry.payload(position + 1))
	if kind is 3
		return VmValue.OfNumber(Double(position + 1))
	if kind is 4
		return VmValue.OfText(Text(position + 1))
	kind is 5 then VmValue.OfBoolean(entry.payload(position + 1) is 1) else Elements(position)
End(position Number) Number
	Ones.End(1) is 15
	let kind = entry.payload(position)
	if kind is 3
		return position + 9
	if kind is not 6
		return position + 2
	mutable next = position + 3
	for entry.payload(position + 2)
		next = End(next)
	next
Elements(position Number) VmValue
	Ones.Elements(1) to Text is "(1, 1.5)"
	mutable elements = List(Mutable(VmValue))
	mutable next = position + 3
	for entry.payload(position + 2)
		elements.Add(Value(next))
		next = End(next)
	VmValue.OfList(elements)
Double(position Number) Number
	PayloadDecoder(InstructionEntry.LoadNumber(0, 1.5)).Double(2) is 1.5
	PayloadDecoder(InstructionEntry.LoadNumber(0, -1000)).Double(2) is -1000
	let top = entry.payload(position + 7)
	let sixth = entry.payload(position + 6)
	let exponent = (top % ByteEncoder.SignBit) * ByteEncoder.ExponentLowBits + (sixth / ByteEncoder.ExponentLowBits).Floor
	mutable mantissa = sixth % ByteEncoder.ExponentLowBits
	for 6
		mantissa = mantissa * Byte.Values + entry.payload(position + 5 - index)
	let scaled = mantissa / 2 ^ ByteEncoder.MantissaBits
	let fraction = exponent is 0 then scaled else 1 + scaled
	let magnitude = fraction * 2 ^ ((exponent is 0 then 1 else exponent) - ByteEncoder.ExponentBias)
	top < ByteEncoder.SignBit then magnitude else -magnitude
ElementParts Texts
	PayloadDecoder(ElementStore).ElementParts is ("list", "index")
	PayloadDecoder(InstructionEntry.Named(InstructionType.StoreRegisterToVariable, 0, "list")).ElementParts.Length is 0
	let open = entry.texts(0).IndexOf("(")
	let name = entry.texts(0)
	open < 0 then List(Text) else (name.Substring(0, open), name.Substring(open + 1, name.Length - open - 2))
Names Texts
	PayloadDecoder(Invocation.AddCall.entry).Names is ("x")
	for entry.payload(3)
		Text(4 + index)
ReturnType Text
	Paired.ReturnType is "Strict/Number"
	Text(4 + entry.payload(3))
Text(position Number) Text
	PayloadDecoder(InstructionEntry.LoadText(0, "a")).Text(2) is "a"
	entry.texts(-1 - entry.payload(position))
Callee(type TypeEntry) MethodEntry
	Scaled.Callee(TypeEntry.Scaling).parameters.First.Name is "scale"
	type.Callee(Text(2), ArgumentCount, ReturnType, Names)
ArgumentCount Number
	Scaled.ArgumentCount is 1
	PayloadDecoder(InstructionEntry.Invoke(1, ("T", "Run", "N"), List(Number), -1)).ArgumentCount is 0
	entry.payload(5 + entry.payload(3))
Arguments Numbers
	Scaled.Arguments is (0)
	PayloadDecoder(InstructionEntry.Invoke(1, ("T", "Run", "N"), (3, 4), 5)).Arguments is (3, 4)
	entry.payload.Slice(6 + entry.payload(3), ArgumentCount)
Instance Number
	Scaled.Instance is -1
	PayloadDecoder(Invocation.AddCall.entry).Instance is 1
	let flagPosition = 6 + entry.payload(3) + ArgumentCount
	entry.payload(flagPosition) is 1 then entry.payload(flagPosition + 1) else -1
SevenBit(position Number) Number
	PayloadDecoder(InstructionEntry.Jump(InstructionType.LoopEnd, 300)).SevenBit(0) is 300
	mutable result = 0
	mutable scale = 1
	for Range(position, entry.payload.Length)
		result = result + (entry.payload(value) % ByteEncoder.SevenBitBase) * scale
		if entry.payload(value) < ByteEncoder.SevenBitBase
			return result
		scale = scale * ByteEncoder.SevenBitBase
	result