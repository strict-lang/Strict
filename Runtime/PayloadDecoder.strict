has entry Bytecode/Binary/InstructionEntry
constant Ones = PayloadDecoder(InstructionEntry(InstructionType.LoadConstantToRegister, "Strict/List(Number)", (0, 6, -1, 2, 1, 1, 3, 0, 0, 0, 0, 0, 0, 248, 63)))
constant ElementStore = InstructionEntry.Named(InstructionType.StoreRegisterToVariable, 0, "list(index)")
constant Paired = PayloadDecoder(InstructionEntry.Invoke(1, ("Strict/Vector", "Scaled", "Strict/Number", "x", "y"), (0, 0), -1))
constant Scaled = PayloadDecoder(InstructionEntry.Invoke(1, ("Strict/Vector", "*", "Strict/Vector", "scale"), List(Number) + 0, -1))
constant CachedSeven = PayloadDecoder(InstructionEntry(InstructionType.LoadConstantToRegister, List(Text), (0, ConstantLoads.Cached, 3, 1, 7)))
constant Listed = PayloadDecoder(Constants.Listing.types.First.methods.First.instructions.First)
constant Infinite = 2047
constant Undefined = PayloadDecoder(InstructionEntry.LoadNumber(0, 0 / 0)).Double(2)
Value(position Number) VmValue
	PayloadDecoder(InstructionEntry.LoadNumber(0, 7)).Value(1).number is 7
	PayloadDecoder(InstructionEntry.LoadText(0, "a")).Value(1).text is "a"
	PayloadDecoder(InstructionEntry.LoadBoolean(0, true)).Value(1).IsTrue
	PayloadDecoder(InstructionEntry.LoadAnyError(0)).Value(1) is VmValue.AnyError
	CachedSeven.Value(1).number is 7 and Ones.Value(1) to Text is "(1, 1.5)"
	kind = entry.payload(position)
	if kind is ConstantLoads.Cached
		return Value(position + 2)
	if kind is 4
		return VmValue.OfText(entry.texts(-1 - entry.payload(position + 1)))
	kind is 6 then Elements(position) else Scalar(kind, position)
Scalar(kind Number, position Number) VmValue
	PayloadDecoder(InstructionEntry.LoadNumber(0, 1.5)).Scalar(3, 1).number is 1.5
	PayloadDecoder(InstructionEntry.LoadAnyError(0)).Scalar(7, 1) is VmValue.AnyError
	PayloadDecoder(InstructionEntry.LoadBoolean(0, false)).Scalar(5, 1) is VmValue.FalseValue
	if kind is 1
		return VmValue.OfNumber(entry.payload(position + 1))
	if kind is 5
		return entry.payload(position + 1) is 1 then VmValue.TrueValue else VmValue.FalseValue
	kind is 3 then VmValue.OfNumber(Double(position + 1)) else VmValue.AnyError
End(position Number) Number
	Ones.End(1) is 15
	kind = entry.payload(position)
	if kind is 3
		return position + 9
	if kind is not 6
		return position + 2
	mutable next = position + 3
	for entry.payload(position + 2)
		next = End(next)
	next
Cache(position Number, cache ConstantCache) VmValue
	Listed.Cache(1, Constants.Listing.prototypes) to Text is "(1, 1.5)"
	Ones.Cache(1, ConstantCache(List(VmValue))) to Text is "(1, 1.5)"
	CachedSeven.Cache(1, ConstantCache(List(VmValue))).number is 7
	PayloadDecoder(InstructionEntry.LoadNumber(0, 5)).Cache(1, ConstantCache(List(VmValue))).number is 5
	kind = entry.payload(position)
	if kind is 1
		return VmValue.OfNumber(entry.payload(position + 1))
	index = kind is ConstantLoads.Cached then entry.payload(position + 1) else cache.entries.Length
	index < cache.entries.Length then cache.At(index) else Value(position)
Elements(position Number) VmValue
	Ones.Elements(1) to Text is "(1, 1.5)"
	count = entry.payload(position + 2)
	if count is 0
		return VmValue.EmptyList
	mutable elements = List(Mutable(VmValue))
	mutable next = position + 3
	for count
		elementKind = entry.payload(next)
		elements.Add(Value(next))
		next = elementKind is 6 then End(next) else (elementKind is 3 then next + 9 else next + 2)
	VmValue.OfList(elements)
Double(position Number) Number
	PayloadDecoder(InstructionEntry.LoadNumber(0, 1.5)).Double(2) is 1.5
	PayloadDecoder(InstructionEntry.LoadNumber(0, -1000)).Double(2) is -1000
	Undefined.IsFinite is false and Undefined is not 1 / 0
	top = entry.payload(position + 7)
	sixth = entry.payload(position + 6)
	exponent = (top % ByteEncoder.SignBit) * ByteEncoder.ExponentLowBits + (sixth / ByteEncoder.ExponentLowBits).Floor
	mutable mantissa = sixth % ByteEncoder.ExponentLowBits
	for 6
		mantissa = mantissa * Byte.Values + entry.payload(position + 5 - index)
	fraction = (exponent is 0 then 0 else 1) + mantissa / 2 ^ ByteEncoder.MantissaBits
	magnitude = fraction * 2 ^ ((exponent is 0 then 1 else exponent) - ByteEncoder.ExponentBias)
	exponent < Infinite or mantissa is 0 then (top < ByteEncoder.SignBit then magnitude else -magnitude) else 0 / 0
ElementParts Texts
	PayloadDecoder(ElementStore).ElementParts is ("list", "index")
	PayloadDecoder(InstructionEntry.Named(InstructionType.StoreRegisterToVariable, 0, "list")).ElementParts.Length is 0
	open = entry.texts(0).IndexOf("(")
	name = entry.texts(0)
	open < 0 then List(Text) else (name.Substring(0, open), name.Substring(open + 1, name.Length - open - 2))
Names Texts
	PayloadDecoder(Invocation.AddCall.entry).Names is ("x")
	for entry.payload(3)
		Text(4 + index)
ReturnType Text
	Paired.ReturnType is "Strict/Number"
	Text(4 + entry.payload(3))
Text(position Number) Text
	PayloadDecoder(InstructionEntry.LoadText(0, "a")).Text(2) is "a"
	entry.texts(-1 - entry.payload(position))
Callee(type TypeEntry) MethodEntry
	Scaled.Callee(TypeEntry.Scaling).parameters.First.Name is "scale"
	type.Callee(Text(2), ArgumentCount, ReturnType, Names)
ArgumentCount Number
	Scaled.ArgumentCount is 1
	PayloadDecoder(InstructionEntry.Invoke(1, ("T", "Run", "N"), List(Number), -1)).ArgumentCount is 0
	entry.payload(5 + entry.payload(3))
Arguments Numbers
	Scaled.Arguments is (0)
	PayloadDecoder(InstructionEntry.Invoke(1, ("T", "Run", "N"), (3, 4), 5)).Arguments is (3, 4)
	for LoadReuse(List(InstructionEntry)).InvokeReads(entry).Slice(0, ArgumentCount)
		entry.payload(value)
Instance Number
	Scaled.Instance is -1
	PayloadDecoder(Invocation.AddCall.entry).Instance is 1
	reads = LoadReuse(List(InstructionEntry)).InvokeReads(entry)
	reads.Length > ArgumentCount then entry.payload(reads.Last) else Number.NotFound
SevenBit(position Number) Number
	PayloadDecoder(InstructionEntry.Jump(InstructionType.LoopEnd, 300)).SevenBit(0) is 300
	mutable result = 0
	mutable scale = 1
	for Range(position, entry.payload.Length)
		result = result + (entry.payload(value) % ByteEncoder.SevenBitBase) * scale
		if entry.payload(value) < ByteEncoder.SevenBitBase
			return result
		scale = scale * ByteEncoder.SevenBitBase
	result