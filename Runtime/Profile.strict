has selection Text = ""
constant Lines = ("$Sample A.Run line 2", "x", "$Sample A.Run line 2", "$Sample A.Go line 5")
constant Shown = 20
constant Padding = 1000000
Run(path Text, root Text) Number
	Profile.Run("Missing.strict", ".") is 2
	if File(path).Exists is false
		return 2
	let mode = selection is "" then "unit" else (selection is "*" then "" else selection)
	let result = ToolRunner(Process.Current.executable).Execute("test \"" + path + "\" \"" + root + "\" sampled " + mode)
	let lines = result.Output.Lines
	for ValueTrace.Plain(lines) + Report(lines)
		logger.Log(value)
	result.exitCode
Sampled(path Text, root Text) Number
	Profile.Sampled("Missing.strict", ".") is 2
	if File(path).Exists is false
		return 2
	let types = FileCompiler(true, selection).Compiled(path, root, true)
	types.Length is 0 then 1 else Execute.Started(types, path, false, true, true).Tested(types.First.Name)
Report(lines Texts) Texts
	Profile.Report(Lines).First is "3 ms sampled, slowest lines:"
	Profile.Report(Lines).Slice(1, 2) is ("  66.7 % 2 ms A.Run line 2", "  33.3 % 1 ms A.Go line 5")
	Profile.Report(Lines).Slice(3, 3) is ("slowest methods:", "  66.7 % 2 ms A.Run", "  33.3 % 1 ms A.Go")
	let places = Places(lines)
	let header = places.Length + " ms sampled, slowest lines:"
	(List(Text) + header) + Ranked(places, places.Length) + "slowest methods:" + Ranked(Methods(places), places.Length)
Places(lines Texts) Texts
	Profile.Places(Lines) is ("A.Run line 2", "A.Run line 2", "A.Go line 5")
	for lines
		if value.StartsWith("$Sample ")
			value.Substring(8)
Methods(places Texts) Texts
	Profile.Methods(("A.Run line 2", "B.Go line 15")) is ("A.Run", "B.Go")
	for places
		value.Substring(0, value.LastIndexOf(" line "))
Ranked(places Texts, total Number) Texts
	Profile.Ranked(("a", "b", "a"), 3) is ("  66.7 % 2 ms a", "  33.3 % 1 ms b")
	Profile.Ranked("a,b,c,d,e,f,g,h,i,j,k,l,m,n,o,p,q,r,s,t,u".Split(","), 21).Length is Shown
	mutable counts = Dictionary(Text, Number)
	for places
		counts(value) = (value is in counts then counts(value) else 0) + 1
	mutable ordered = List(Mutable(Text))
	for counts
		ordered.Add((Padding + value.Value) + "|" + value.Key)
	for ordered.Sorted.Reverse
		if index < Shown
			Line(value, total)
Line(ordered Text, total Number) Text
	Profile.Line("1000002|a", 3) is "  66.7 % 2 ms a"
	let separator = ordered.IndexOf("|")
	let count = (ordered.Substring(0, separator) to Number) - Padding
	let place = ordered.Substring(separator + 1, ordered.Length - separator - 1)
	"  " + (count * 100 / total).Round(1) + " % " + count + " ms " + place
