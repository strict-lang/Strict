Start(words Texts) Text
	RemoteRun.Start(("run", "AiServer")) is "1"
	if words.Length < 3
		return "1"
	ran = Process.RunTool(words(2), Text.Combine(words.Slice(3, words.Length - 3), " "))
	logger.Log(ran.Output)
	ran.exitCode to Text
AnswerWords(words Texts, seen MachineView) Text
	RemoteRun.AnswerWords("hello", MachineView.Wide) is "ok"
	if words.Length > 0 and words(0) is "run"
		return Start(words)
	words.Length > 0 and words(0) is "fit" then Admission.Verdict(Need.Parsed(words), seen) else "ok"
