has root Text
has slot Text = ""
constant Version = "strict 3"
constant Greeting = "ready\n"
constant Ending = "\n\n"
constant Stopping = "stop"
constant Exiting = "strict exit "
constant Stamp = "/obj/strict.server"
constant Free = "/obj/strict.free"
constant IdleSeconds = 300
constant WakeSeconds = 5
constant Servers = 4
constant GreetingSeconds = 1
constant Settings = ("STRICT_THREADS", "STRICT_GPU", "STRICT_BUILD_PROFILE", "STRICT_EMISSION_CHECK", "STRICT_GC_LOG", "STRICT_RC", "STRICT_RC_CHECK", "STRICT_RC_DEAD", "STRICT_HEAP", "STRICT_YOUNG")
constant Sample = Resident("Compiler/output")
constant Unaccepted = Error("NoConnection")
constant Refused = -1
constant Unrequested = ""
Request(folder Text, arguments Texts, variables = "", claim = "") Text
	Resident.Request("C:/a", ("test", "a.strict"), "1", "7") is "strict 3\nC:/a\ntest\ta.strict\n1\n7\n\n"
	Version + "\n" + folder + "\n" + Text.Combine(arguments, "\t") + "\n" + variables + "\n" + claim + Ending
Variables Text
	Resident.Variables.Split("\t").Length is Settings.Length
	mutable values = List(Mutable(Text))
	for Settings
		values.Add(Process.Variable(value))
	Text.Combine(values, "\t")
IsCurrent(request Text, expected = "") Boolean
	Resident.IsCurrent(Resident.Request("C:/a", List(Text) + "test", Resident.Variables))
	Resident.IsCurrent(Resident.Request("C:/a", List(Text) + "test", "other")) is false
	Resident.IsCurrent(Resident.Request("C:/a", List(Text) + "test", "expected"), "expected")
	lines = request.Split("\n")
	lines.Length > 3 and lines(3) is (expected is "" then Variables else expected)
Arguments(request Text) Texts
	Resident.Arguments(Resident.Request("C:/a", ("test", "a.strict"))) is ("test", "a.strict")
	Resident.Arguments("strict 1\nC:/a\ntest\n\n") is List(Text)
	Resident.Arguments(Version + "\nC:/a") is List(Text)
	lines = request.Split("\n")
	lines.Length < 3 or lines(0) is not Version then List(Text) else lines(2).Split("\t")
Folder(request Text) Text
	Resident.Folder(Resident.Request("C:/a", List(Text) + "test")) is "C:/a"
	Resident.Folder("broken") is ""
	lines = request.Split("\n")
	lines.Length < 3 then "" else lines(1)
Claim(request Text) Text
	Resident.Claim(Resident.Request("C:/a", List(Text) + "test", "1", "7")) is "7"
	Resident.Claim("broken") is ""
	lines = request.Split("\n")
	lines.Length < 5 then "" else lines(4)
Stamped Text
	Sample.Stamped is "Compiler/output/obj/strict.server"
	Resident("Compiler/output", "2").Stamped is "Compiler/output/obj/strict.server2"
	root + Stamp + slot
Freed Text
	Resident("Compiler/output", "2").Freed is "Compiler/output/obj/strict.free2"
	root + Free + slot
FreePort(request Text)
	Resident("Compiler/output/Missing").FreePort(Resident.Request("C:/a", List(Text) + "test", "1", "7")) is not Error
	Resident("Compiler/output/Missing").FreePort("broken") is not Error
	port = Claim(request) to Number
	if port is not Error
		File(Freed + "." + port).Rename(Freed)
Send(socket Number, text Text)
	Sample.Send(0, "a") is Error
	Socket.Send(socket, ByteEncoder(List(Number)).UnicodeBytes(text))
Receive(socket Number, ending Text) Text
	Sample.Receive(0, "\n") is ""
	mutable gathered = ""
	mutable isOpen = true
	for as long as isOpen and gathered.EndsWith(ending) is false
		available = Socket.Pending(socket)
		isOpen = (available is Error) is false
		chunk = isOpen then Socket.Receive(socket, available > 0 then available else 1) else List(Number)
		isOpen = isOpen and chunk is Error is false
		gathered = isOpen then gathered + ByteEncoder(chunk).Spelled(0, chunk.Length) else gathered
	gathered
Opened Number
	server = Socket.Local(0)
	if server is Error
		return server
	port = Socket.Port(server) to Text
	File(Stamped).Write(port)
	File(Freed).Write(port)
	server
Accept(server Number, built Number, limit = IdleSeconds) Number
	Sample.Accept(0, -1) is Unaccepted
	Sample.Accept(Socket.Local(0), File(Process.Current.executable).Modified, 0) is Unaccepted
	Sample.Accept(Socket.Local(0), File(Process.Current.executable).Modified, WakeSeconds) is Unaccepted
	mutable idle = 0
	own = File(Process.Current.executable)
	stamp = File(Stamped)
	for as long as idle < limit and own.Modified is built and Socket.Port(server) to Text is in stamp.ReadLines
		waited = Socket.Waiting(server, WakeSeconds)
		if waited is not 0
			return waited is Error then Unaccepted else Take(server, built)
		idle = idle + WakeSeconds
	Unaccepted
Take(server Number, built Number) Number
	socket = Socket.Accept(server)
	if File(Process.Current.executable).Modified is built
		return socket
	End(socket, Refused)
	Unaccepted
ReadRequest(socket Number) Text
	Forwarding.Sample.Loopback(3) is 3
	Forwarding.Sample.Loopback(Refused) is Forwarding.Unserved
	Send(socket, Greeting) is not Error then Receive(socket, Ending) else Unrequested
Finish(socket Number, code Number)
	Sample.Finish(0, 1) is Error
	if Send(socket, Exiting + code + "\n") is Error
		Socket.Close(socket)
		return Error("SendFailed")
	Socket.Close(socket)
End(socket Number, code Number)
	Sample.End(0, 1) is not Error
	if Finish(socket, code) is Error
		Socket.Close(socket)
Close(server Number)
	Resident("Compiler/output/Missing").Close(0) is not Error
	Sample.Opened > 0
	Sample.Close(Socket.Local(0)) is not Error
	File(Sample.Stamped).Exists
	stamp = File(Stamped)
	if stamp.Exists and stamp.ReadLines.First is (Socket.Port(server) to Text)
		stamp.Delete
		File(Freed).Delete
	Socket.Close(server)
