has root Text
has slot Text = ""
constant Version = "strict 3"
constant Greeting = "ready\n"
constant Ending = "\n\n"
constant Stopping = "stop"
constant Exiting = "strict exit "
constant Stamp = "/obj/strict.server"
constant Free = "/obj/strict.free"
constant IdleSeconds = 300
constant WakeSeconds = 5
constant Servers = 4
constant GreetingSeconds = 1
constant Settings = ("STRICT_THREADS", "STRICT_GPU", "STRICT_BUILD_PROFILE", "STRICT_GC_LOG", "STRICT_RC", "STRICT_RC_CHECK", "STRICT_RC_DEAD", "STRICT_HEAP", "STRICT_YOUNG")
constant Sample = Resident("Compiler/output")
Request(folder Text, arguments Texts, variables = "", claim = "") Text
	Resident.Request("C:/a", ("test", "a.strict"), "1", "7") is "strict 3\nC:/a\ntest\ta.strict\n1\n7\n\n"
	Version + "\n" + folder + "\n" + Text.Combine(arguments, "\t") + "\n" + variables + "\n" + claim + Ending
Variables Text
	Resident.Variables.Split("\t").Length is Settings.Length
	mutable values = List(Mutable(Text))
	for Settings
		values.Add(Process.Variable(value))
	Text.Combine(values, "\t")
IsCurrent(request Text) Boolean
	Resident.IsCurrent(Resident.Request("C:/a", List(Text) + "test", Resident.Variables))
	Resident.IsCurrent(Resident.Request("C:/a", List(Text) + "test", "other")) is false
	let lines = request.Split("\n")
	(lines.Length > 3) and (lines(3) is Variables)
Arguments(request Text) Texts
	Resident.Arguments(Resident.Request("C:/a", ("test", "a.strict"))) is ("test", "a.strict")
	Resident.Arguments("strict 1\nC:/a\ntest\n\n") is List(Text)
	Resident.Arguments(Version + "\nC:/a") is List(Text)
	let lines = request.Split("\n")
	(lines.Length < 3) or (lines(0) is not Version) then List(Text) else lines(2).Split("\t")
Folder(request Text) Text
	Resident.Folder(Resident.Request("C:/a", List(Text) + "test")) is "C:/a"
	Resident.Folder("broken") is ""
	let lines = request.Split("\n")
	lines.Length < 3 then "" else lines(1)
Claim(request Text) Text
	Resident.Claim(Resident.Request("C:/a", List(Text) + "test", "1", "7")) is "7"
	Resident.Claim("broken") is ""
	let lines = request.Split("\n")
	lines.Length < 5 then "" else lines(4)
Stamped Text
	Sample.Stamped is "Compiler/output/obj/strict.server"
	Resident("Compiler/output", "2").Stamped is "Compiler/output/obj/strict.server2"
	root + Stamp + slot
Freed Text
	Resident("Compiler/output", "2").Freed is "Compiler/output/obj/strict.free2"
	root + Free + slot
Released(request Text)
	Resident("Compiler/output/Missing").Released(Resident.Request("C:/a", List(Text) + "test", "1", "7")) is not Error
	Resident("Compiler/output/Missing").Released("broken") is not Error
	let port = Claim(request) to Number
	if port is not Error
		File(Freed + "." + port).Rename(Freed)
Send(socket Number, text Text)
	Sample.Send(0, "a") is Error
	Socket.Send(socket, ByteEncoder(List(Number)).UnicodeBytes(text))
Received(socket Number, ending Text) Text
	Sample.Received(0, "\n") is ""
	mutable gathered = ""
	mutable isOpen = true
	for as long as isOpen and (gathered.EndsWith(ending) is false)
		let available = Socket.Pending(socket)
		isOpen = (available is Error) is false
		let chunk = isOpen then Socket.Receive(socket, available > 0 then available else 1) else List(Number)
		isOpen = isOpen and ((chunk is Error) is false)
		gathered = isOpen then gathered + ByteEncoder(chunk).Spelled(0, chunk.Length) else gathered
	gathered
Opened Number
	let server = Socket.Local(0)
	if server is Error
		return 0
	let port = Socket.Port(server) to Text
	File(Stamped).Write(port)
	File(Freed).Write(port)
	server
Accepted(server Number, built Number) Number
	Sample.Accepted(0, -1) is 0
	mutable idle = 0
	for as long as (idle < IdleSeconds) and (File(Process.Current.executable).Modified is built)
		let waited = Socket.Waiting(server, WakeSeconds)
		if waited is Error
			return 0
		if waited is 1
			return Taken(server, built)
		idle = idle + WakeSeconds
	0
Taken(server Number, built Number) Number
	let socket = Socket.Accept(server)
	if File(Process.Current.executable).Modified is built
		return socket
	Ended(socket, -1)
	0
Requested(socket Number) Text
	Forwarding.Sample.Loopback is 3
	(Send(socket, Greeting) is not Error) then Received(socket, Ending) else ""
Finished(socket Number, code Number)
	Sample.Finished(0, 1) is Error
	if Send(socket, Exiting + code + "\n") is Error
		Socket.Close(socket)
		return Error("SendFailed")
	Socket.Close(socket)
Ended(socket Number, code Number)
	Sample.Ended(0, 1) is not Error
	if Finished(socket, code) is Error
		Socket.Close(socket)
Closed(server Number)
	Resident("Compiler/output/Missing").Closed(0) is not Error
	Sample.Opened > 0
	Sample.Closed(Socket.Local(0)) is not Error
	File(Sample.Stamped).Exists
	let stamp = File(Stamped)
	if stamp.Exists and (stamp.ReadLines.First is (Socket.Port(server) to Text))
		stamp.Delete
		File(Freed).Delete
	Socket.Close(server)
