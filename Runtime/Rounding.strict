has bits Number
constant Single = Rounding(32)
constant Counter = TypeEntry("Strict/Counter", List(MemberEntry) + MemberEntry("count", "Strict/Number", InstructionEntry(InstructionType.Set, List(Text), (1, 7, 0)), false), List(MethodEntry))
constant Empty = TypeEntry("Strict/Empty", List(MemberEntry), List(MethodEntry))
constant Bytes = Natives(List(TypeEntry) + Natives.Byted)
constant Swapped = Invocation(InstructionEntry.Invoke(2, ("Strict/Shape", "from", "Strict/Shape", "logger", "width"), 0, -1), (VmValue.OfNumber(3), VmValue.OfNumber(5)), VmValue.None)
constant ByteCall = Invocation(Natives.NewShape.entry, (VmValue.OfNumber(3), VmValue.OfNumber(9)), VmValue.None)
constant PlainTypes = ("Strict/Number", "Strict/Text", "Strict/Boolean", "Strict/Logger", "Strict/Texts", "Strict/Numbers", "Strict/Bytes", "Number", "Text", "Boolean")
Of(original VmValue) VmValue
	Single.Of(VmValue.OfNumber(0.1)).number is 0.10000000149011612
	Single.Of(VmValue.OfList(VmValue.OfNumber(0.1), VmValue.OfNumber(1))).items.First.number is 0.10000000149011612
	Single.Of(VmValue.OfError("a")).kind is "Strict/Error"
	Rounding(8).Of(VmValue("Strict/Byte", 127.5, "", List(VmValue))).number is 127
	if bits is in (0, Number.DoubleBits) or original.kind is in VmValue.ErrorKinds
		return original
	if original.items.Length is 0
		return VmValue(original.kind, Round(original.number), original.text, original.items)
	mutable rounded = List(Mutable(VmValue))
	for original.items
		rounded.Add(Of(value))
	VmValue(original.kind, original.number, original.text, rounded)
Round(number Number) Number
	Rounding(8).Round(127.5) is 127
	Rounding(8).Round(256) is 0
	Rounding(8).Round(-1) is 255
	Single.Round(0.1) is 0.10000000149011612
	(Single.Of(VmValue.OfList((VmValue.OfNumber(0.1), VmValue.OfNumber(1)))).items.First.number is 0.1) is false
	Single.Of(VmValue("Strict/Error", 0.1, "", List(VmValue))).number is 0.1 and Single.bits is 32
	Single.Of(VmValue("Strict/ErrorWithValue", 0.1, "", List(VmValue))).number is 0.1 and Single.bits is 32
	bits is 8 then (number.Floor % Byte.Values + Byte.Values) % Byte.Values else number.Rounded(bits)
Bits(member MemberEntry, natives Natives) Number
	Single.Bits(Natives.Width, Natives.Shapes) is 64
	Single.Bits(Natives.Pixel.members.First, Natives(List(TypeEntry) + Natives.Byted)) is 8
	Single.Bits(MemberEntry("x", "Strict/Byte", List(InstructionEntry), false, 32), Bytes) is 32
	if member.Bits > 0
		return member.Bits
	if member.typeName is in PlainTypes or member.typeName.StartsWith("Strict/List")
		return Number.DoubleBits
	if member.typeName.StartsWith("Strict/Dictionary")
		return Number.DoubleBits
	type = natives.TypeOf(member.typeName)
	own = type.Changing.Length is 1 then type.Changing.First.Bits else 0
	own is 0 then Number.DoubleBits else own
RoundedValue(member MemberEntry, raw VmValue, natives Natives) VmValue
	Single.RoundedValue(Natives.Width, VmValue.OfNumber(3), Natives.Shapes).number is 3
	if raw.kind is in ("Text", "Boolean", "None") or IsPlainStruct(member, raw)
		return raw
	if member.Bits is 0 and member.typeName is "Strict/Number"
		return raw
	bitWidth = Bits(member, natives)
	bitWidth is in (0, Number.DoubleBits) then raw else Rounding(bitWidth).Of(raw)
IsPlainStruct(member MemberEntry, raw VmValue) Boolean
	Single.IsPlainStruct(Natives.Width, VmValue.OfNumber(3)) is false
	if member.Bits > 0 or raw.kind is "List" or raw.items.Length > 1
		return member.Bits is 0 and (raw.kind is "List" or raw.items.Length > 1)
	raw.items.Length is 1 then raw.items.First.kind is in ("Text", "Boolean", "None", "List") else false
Build(type TypeEntry, call Invocation, natives Natives, isStruct Boolean) VmValue
	Single.Build(Natives.Single, Natives.NewSingle, Natives.Shapes, false).number is 0.10000000149011612
	Single.Build(Natives.Shape, Natives.NewShape, Natives.Shapes, true).kind is "Strict/Shape"
	Single.Build(Natives.Shape, Natives.NewShape, Natives.Shapes, false).number is 3
	if type.members.Length is 0 or isStruct is false
		return Wrap(type, call)
	VmValue(call.TypeName, 0, "", Members(type, call, natives))
Wrap(type TypeEntry, call Invocation) VmValue
	Single.Wrap(Natives.Single, Natives.NewSingle).number is 0.10000000149011612
	Single.Wrap(Natives.Degree, Natives.NewDegree).number is 3
	Single.Wrap(Counter, Invocation(Natives.NewDegree.entry, List(VmValue), VmValue.None)).number is 7
	(Single.Wrap(Natives.Single, Natives.NewSingle).number is 0.1) is false
	Single.Wrap(Empty, Natives.NewSingle).number is 0.1 and Single.bits is 32
	Single.Wrap(Empty, Invocation(Natives.NewDegree.entry, List(VmValue), VmValue.None)).kind is "None"
	if call.Arguments.Length is 0
		return type.members.Length is 0 then VmValue.None else Natives(List(TypeEntry)).Initial(type.members.First)
	memberBits = type.members.Length is 0 then Number.DoubleBits else type.members.First.Bits
	argument = call.Arguments.First
	(memberBits is in (0, Number.DoubleBits) then argument else Rounding(memberBits).Of(argument)).As(call.TypeName)
Members(type TypeEntry, call Invocation, natives Natives) List(VmValue)
	Single.Members(Natives.Shape, Natives.NewShape, Natives.Shapes).First.number is 3
	Single.Members(Natives.Shape, Swapped, Natives.Shapes).First.number is 5
	Single.Members(Natives.Byted, ByteCall, Bytes)(1).kind is "None" and Single.bits is 32
	Single.Members(Natives.Byted, ByteCall, Bytes).First.number is 3 and Single.bits is 32
	Single.Members(Natives.Shape, ByteCall, Natives.Shapes)(1).number is 9
	arguments = call.Arguments
	names = arguments.Length > 0 then call.ParameterNames else List(Text)
	for type.members
		chosen = value.IsConstant then arguments.Length else Positional(names, value.Name, index)
		chosen < arguments.Length then RoundedValue(value, arguments(chosen), natives) else natives.Initial(value)
Positional(names Texts, name Text, position Number) Number
	Single.Positional(("a", "b"), "b", 1) is 1
	Single.Positional(("a", "b"), "b", 0) is 1
	if position < names.Length
		if names(position) is name
			return position
	found = names.Index(name)
	found < 0 then position else found
