has bits Number
constant Single = Rounding(32)
constant Counter = TypeEntry("Strict/Counter", List(MemberEntry) + MemberEntry("count", "Strict/Number", InstructionEntry(InstructionType.Set, List(Text), (1, 7, 0)), false), List(MethodEntry))
Of(original VmValue) VmValue
	Single.Of(VmValue.OfNumber(0.1)).number is 0.10000000149011612
	Single.Of(VmValue.OfList(VmValue.OfNumber(0.1), VmValue.OfNumber(1))).items.First.number is 0.10000000149011612
	Single.Of(VmValue.OfError("a")).kind is "Strict/Error"
	Rounding(8).Of(VmValue("Strict/Byte", 127.5, "", List(VmValue))).number is 127
	if (bits is 64) or (original.kind is in VmValue.ErrorKinds)
		return original
	if original.items.Length is 0
		return VmValue(original.kind, Rounded(original.number), original.text, original.items)
	mutable rounded = List(Mutable(VmValue))
	for original.items
		rounded.Add(Of(value))
	VmValue(original.kind, original.number, original.text, rounded)
Rounded(number Number) Number
	Rounding(8).Rounded(127.5) is 127
	Rounding(8).Rounded(256) is 0
	Rounding(8).Rounded(-1) is 255
	Single.Rounded(0.1) is 0.10000000149011612
	bits is 8 then (number.Floor % 256 + 256) % 256 else number.Rounded(bits)
Bits(member MemberEntry, natives Natives) Number
	Single.Bits(Natives.Width, Natives.Shapes) is 64
	Single.Bits(Natives.Pixel.members.First, Natives(List(TypeEntry) + Natives.Byted)) is 8
	let type = natives.TypeOf(member.typeName)
	(member.Bits is not 64) or (type.Changing.Length is not 1) then member.Bits else type.Changing.First.Bits
Wrapped(type TypeEntry, call Invocation) VmValue
	Single.Wrapped(Natives.Single, Natives.NewSingle).number is 0.10000000149011612
	Single.Wrapped(Natives.Degree, Natives.NewDegree).number is 3
	Single.Wrapped(Counter, Invocation(Natives.NewDegree.entry, List(VmValue), VmValue.None)).number is 7
	if call.Arguments.Length is 0
		return type.members.Length is 0 then VmValue.None else Natives(List(TypeEntry) + type).Initial(type.members.First)
	let memberBits = type.members.Length is 0 then 64 else type.members.First.Bits
	Rounding(memberBits).Of(call.Arguments.First).As(call.TypeName)
Members(type TypeEntry, call Invocation, natives Natives) List(VmValue)
	Single.Members(Natives.Shape, Natives.NewShape, Natives.Shapes).First.number is 3
	let arguments = call.Arguments
	for type.members
		let argument = call.ParameterNames.Index(value.Name)
		let chosen = argument < 0 then index else argument
		let isGiven = (value.IsConstant is false) and (chosen < arguments.Length)
		isGiven then Rounding(Bits(value, natives)).Of(arguments(chosen)) else natives.Initial(value)
