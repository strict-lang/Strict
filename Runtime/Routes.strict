has types List(TypeEntry)
constant Doubling = Routes(List(TypeEntry) + Machine.Doubler)
constant Placeholding = Routes(List(TypeEntry) + TypeEntry("Strict/Process", List(MemberEntry), List(MethodEntry) + InlineRules.Adding + MethodEntry(InlineRules.Placeholder, Name = "OperatingSystem", declaredType = "Strict/Text")))
constant Leading = Routes(List(TypeEntry) + TypeEntry("Strict/Process", List(MemberEntry), List(MethodEntry) + MethodEntry(InlineRules.Placeholder, Name = "OperatingSystem", declaredType = "Strict/Text")))
constant Computing = Routes(List(TypeEntry) + TypeEntry("Strict/Process", List(MemberEntry), List(MethodEntry) + MethodEntry(InlineRules.Adding, Name = "OperatingSystem", declaredType = "Strict/Text")))
constant Unnamed = Routes(List(TypeEntry) + TypeEntry("Strict/Process", List(MemberEntry), List(MethodEntry) + InlineRules.Placeholder))
constant Trimming = Invocation(Resolver.Twice, entry = InstructionEntry.Invoke(0, ("B", "Trim", "B"), 0, -1))
constant Constructing = MethodEntry(InlineRules.Placeholder, instructions = (InstructionEntry.LoadNumber(0, 0), InstructionEntry.Invoke(1, ("Strict/Degrees", "from", "Strict/Degrees"), List(Number) + 0, -1), InstructionEntry.Return(1)))
constant Reading = MethodEntry(InlineRules.Placeholder, instructions = (InstructionEntry.Named(InstructionType.LoadVariableToRegister, 0, "key"), InstructionEntry.Return(0)))
constant Fielding = MethodEntry(InlineRules.Placeholder, instructions = (InstructionEntry(InstructionType.FieldLoad, "x", (0, 0, -1)), InstructionEntry.Return(0)))
constant Failing = MethodEntry(InlineRules.Placeholder, instructions = (InstructionEntry.Named(InstructionType.LoadVariableToRegister, 0, "name"), Inliner.MadeError, InstructionEntry.Return(0)))
constant Membered = MethodEntry(Failing, instructions = (Fielding.instructions(0), Inliner.MadeError, Failing.instructions(2)))
constant Jumping = InstructionEntry(InstructionType.Jump, "", (0, 0, -1))
constant Branching = MethodEntry(Failing, instructions = (Failing.instructions(0), Jumping, Inliner.MadeError, InstructionEntry.Return(0)))
constant Ticking = Routes((TypeEntry(Machine.Doubler, members = TypeEntry.Holding(0).members), TypeEntry.Holding(1)))
constant Holder = TypeEntry(TypeEntry.Holding(1), methods = TypeEntry.Holding(1).methods + Machine.Doubler.methods(0))
constant Wrapper = TypeEntry("Strict/Wrapper", List(MemberEntry) + MemberEntry("inner", "Strict/Holder", List(InstructionEntry), false), List(MethodEntry))
constant Redirecting = Routes((Wrapper, Holder))
constant TwoMembers = TypeEntry(Holder, members = (TypeEntry.Holding(0).members.First, Holder.members.First))
constant WrapperTwice = Invocation(InstructionEntry.Invoke(0, ("Strict/Wrapper", "Twice", "Strict/Number"), List(Number), -1), List(VmValue), VmValue.None)
constant WrapperFrom = Invocation(InstructionEntry.Invoke(1, ("Strict/Wrapper", "from", "Strict/Wrapper", "counter"), 0, -1), List(VmValue) + VmValue.OfNumber(5), VmValue.None)
constant Defaulting = Routes(List(TypeEntry) + TypeEntry(Machine.Doubler, methods = Machine.Doubler.methods + Machine.Defaulted))
constant Returning = List(InstructionEntry) + InstructionEntry.Return(0)
constant Textual = Routes(List(TypeEntry) + TypeEntry("Strict/Text", List(MemberEntry), List(MethodEntry) + MethodEntry(TypeEntry.ToNumber, instructions = Returning)))
constant Texted = List(MemberEntry) + MemberEntry("text", "Strict/Text", List(InstructionEntry), false)
constant Other = List(MemberEntry) + MemberEntry("other", "Strict/Generic", List(InstructionEntry), false)
constant Lists = TypeEntry("Strict/List(Text)", List(MemberEntry), List(MethodEntry) + MethodEntry("in", Other, "Strict/Boolean", Reading.instructions))
constant Searching = Invocation(InstructionEntry.Invoke(1, ("Strict/List(Text)", "in", "Strict/Boolean", "other"), List(Number) + 0, -1), List(VmValue), VmValue.None)
constant Searchable = Routes((Machine.Doubler, Lists))
constant Appending = Invocation(Searching, entry = InstructionEntry.Invoke(1, ("Strict/List(Text)", "Add", "Strict/List(Text)", "other"), List(Number) + 0, -1))
constant Containing = Invocation(Searching, entry = InstructionEntry.Invoke(1, ("Strict/Range", "in", "Strict/Boolean", "other"), List(Number) + 0, -1))
constant Characters = Routes(List(TypeEntry) + TypeEntry(TypeEntry.CharacterEntry, methods = List(MethodEntry) + MethodEntry("from", Texted, "Strict/Character", Returning)))
constant DefaultAdd = Invocation(InstructionEntry.Invoke(0, ("Strict/Doubler", "Add", "Strict/Number"), List(Number) + 0, -1), List(VmValue) + VmValue.OfNumber(1), VmValue.None)
constant Checking = MethodEntry(Failing, instructions = Failing.instructions.Slice(0, 2) + InstructionEntry(InstructionType.CheckError, List(Text), List(Number) + 0) + Failing.instructions.Last)
constant JsonOnly = Routes(List(TypeEntry) + TypeEntry("Json", List(MemberEntry), List(MethodEntry)))
Target(call Invocation) Numbers
	Doubling.Target(Trimming) is (Resolver.Native, 0, 0)
	Doubling.Target(Invocation.Parsing) is (Resolver.Native, 0, 0)
	Doubling.Target(Invocation.Uppered) is (Resolver.Searching, 0, 0)
	Doubling.Target(Hosted.SystemCall) is (Resolver.Hosting, 0, 0)
	Doubling.Target(HostedJson.Getting) is (Resolver.Hosting, 0, 0)
	JsonOnly.Target(HostedJson.Getting)(0) is Resolver.Native and Searchable.Target(Searching)(0) is Resolver.Native
	Textual.Call(Invocation.Parsing) is (Resolver.Native, 0, 0)
	Characters.Call(Invocation.Coding) is (0, 0, 1)
	if Hosted(call).IsHosted and IsSourceRun(call) is false
		return (Resolver.Hosting, 0, 0)
	isText = call.TypeName is "Strict/Text" and call.MethodName is in Natives.TextMethods
	IsSearch(call) then (Resolver.Native, 0, 0) else isText then (Resolver.Searching, 0, 0) else Call(call)
IsSearch(call Invocation) Boolean
	Doubling.IsSearch(Searching)
	Routes(List(TypeEntry) + Lists).IsSearch(Searching) is false
	Doubling.IsSearch(Appending) is false and Doubling.IsSearch(Containing) is false
	isList = call.TypeName is in ("Strict/List(Text)", "Strict/List(Number)")
	isList and call.MethodName is in ("in", "Index") then IsSourceRun(call) is false else false
IsSourceRun(call Invocation) Boolean
	JsonOnly.IsSourceRun(HostedJson.Getting)
	Doubling.IsSourceRun(Hosted.SystemCall) is false
	Placeholding.IsSourceRun(Hosted.SystemCall) is false and Leading.IsSourceRun(Hosted.SystemCall) is false
	Computing.IsSourceRun(Hosted.SystemCall) and Unnamed.IsSourceRun(Hosted.SystemCall)
	type = Natives(types).TypeOf(call.TypeName)
	method = type.Chosen(call.MethodName, call.Count, call.ReturnType, call.ParameterNames)
	isPlaceholder = method >= 0 and IsPlaceholder(type.methods(method))
	TypeEntry.ShortName(call.TypeName) is TypeEntry.ShortName(types.First.Name) and isPlaceholder is false
IsPlaceholder(method MethodEntry) Boolean
	Doubling.IsPlaceholder(InlineRules.Placeholder) and Doubling.IsPlaceholder(Constructing)
	Doubling.IsPlaceholder(InlineRules.Adding) is false and Doubling.IsPlaceholder(Reading) is false
	Doubling.IsPlaceholder(Fielding) is false
	Doubling.IsPlaceholder(Failing) and Doubling.IsPlaceholder(Branching) is false
	IsFailing(method) or IsInert(method)
IsInert(method MethodEntry) Boolean
	for method.instructions
		isRead = value.kind is InstructionType.LoadVariableToRegister and value.texts.First is not "value"
		kind = value.kind
		isComputed = kind > InstructionType.StoreSeparator and kind < InstructionType.BinaryOperatorsSeparator
		if isRead or isComputed or value.kind is in (InstructionType.IndexCall, InstructionType.FieldLoad)
			return false
	true
IsFailing(method MethodEntry) Boolean
	Doubling.IsFailing(Failing)
	Doubling.IsFailing(MethodEntry(Failing, instructions = List(InstructionEntry))) is false
	Doubling.IsFailing(Checking) and Doubling.IsFailing(Membered)
	Doubling.IsFailing(Branching) is false and Doubling.IsFailing(Constructing) is false
	checked = method.instructions.Length > 2 then method.instructions(-2).kind is InstructionType.CheckError else false
	count = checked then method.instructions.Length - 1 else method.instructions.Length
	if count < 2 or method.instructions(count - 2).kind is not InstructionType.Invoke
		return false
	for method.instructions
		if value.kind > InstructionType.Return and value.kind < InstructionType.InvokeWriteToList
			return false
	method.instructions(count - 2).texts.First is "Strict/Error"
Call(call Invocation) Numbers
	Doubling.Call(Resolver.Twice) is (0, 0, 0) and Doubling.Call(Invocation.AddCall)(0) is Resolver.Native
	Routes(TypeEntry.Holding).Call(Invocation.Held) is (1, 0, 0) and Redirecting.Call(WrapperTwice)(0) is 1
	Ticking.Call(Resolver.Twice) is (0, 0, 0) and Redirecting.Call(WrapperFrom) is (-1, 1, 0)
	Defaulting.Call(DefaultAdd) is (Resolver.Native, 0, 0)
	name = call.MethodName
	own = Natives(types).TypeOf(call.TypeName)
	isMissing = own.Chosen(name, call.Count, call.ReturnType, call.ParameterNames) < 0 and name is not "from"
	type = isMissing and own.Changing.Length is 1 then Natives(types).TypeOf(own.Changing.First.typeName) else own
	method = type.Chosen(name, call.Count, call.ReturnType, call.ParameterNames)
	if method < 0 or call.IsNativeConversion or type.methods(method).instructions.Length is 0
		return (Resolver.Native, name is "from" then ConstructionSlot(type) else 0, IsStructBuilt(type, name))
	(Resolver(types).Position(type), method, Natives(types).IsMemberCall(call, type, type.methods(method)) then 1 else 0)
IsStructBuilt(type TypeEntry, name Text) Number
	Doubling.IsStructBuilt(Natives.Shape, "from") is 1 and Doubling.IsStructBuilt(Natives.Shape, "Twice") is 0
	Doubling.IsStructBuilt(Holder, "from") is 0
	name is "from" then (type.IsStruct then 1 else 0) else 0
ConstructionSlot(type TypeEntry) Number
	Doubling.ConstructionSlot(Machine.Doubler) is 1
	Redirecting.ConstructionSlot(Wrapper) is 1
	Redirecting.ConstructionSlot(Holder) is 0
	Ticking.ConstructionSlot(Ticking.types.First) is 1
	Routes(List(TypeEntry) + TwoMembers).ConstructionSlot(TwoMembers) is 1
	if type.members.Length is 1
		for type.methods
			if value.Name is "from"
				return 0
	Resolver(types).Position(type) + 1