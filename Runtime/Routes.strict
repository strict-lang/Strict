has types List(TypeEntry)
constant Doubling = Routes(List(TypeEntry) + Machine.Doubler)
constant Placeholding = Routes(List(TypeEntry) + TypeEntry("Strict/Process", List(MemberEntry), List(MethodEntry) + InlineRules.Adding + MethodEntry(InlineRules.Placeholder, Name = "OperatingSystem", declaredType = "Strict/Text")))
constant Leading = Routes(List(TypeEntry) + TypeEntry("Strict/Process", List(MemberEntry), List(MethodEntry) + MethodEntry(InlineRules.Placeholder, Name = "OperatingSystem", declaredType = "Strict/Text")))
constant Computing = Routes(List(TypeEntry) + TypeEntry("Strict/Process", List(MemberEntry), List(MethodEntry) + MethodEntry(InlineRules.Adding, Name = "OperatingSystem", declaredType = "Strict/Text")))
constant Unnamed = Routes(List(TypeEntry) + TypeEntry("Strict/Process", List(MemberEntry), List(MethodEntry) + InlineRules.Placeholder))
constant Trimming = Invocation(Resolver.Twice, entry = InstructionEntry.Invoke(0, ("B", "Trim", "B"), 0, -1))
constant Constructing = MethodEntry(InlineRules.Placeholder, instructions = (InstructionEntry.LoadNumber(0, 0), InstructionEntry.Invoke(1, ("Strict/Degrees", "from", "Strict/Degrees"), List(Number) + 0, -1), InstructionEntry.Return(1)))
constant Reading = MethodEntry(InlineRules.Placeholder, instructions = (InstructionEntry.Named(InstructionType.LoadVariableToRegister, 0, "key"), InstructionEntry.Return(0)))
constant Fielding = MethodEntry(InlineRules.Placeholder, instructions = (InstructionEntry(InstructionType.FieldLoad, "x", (0, 0, -1)), InstructionEntry.Return(0)))
constant JsonOnly = Routes(List(TypeEntry) + TypeEntry("Json", List(MemberEntry), List(MethodEntry)))
Target(call Invocation) Numbers
	Doubling.Target(Trimming) is (Resolver.Native, 0, 0)
	Doubling.Target(Invocation.Parsing) is (Resolver.Native, 0, 0)
	Doubling.Target(Invocation.Uppered) is (Resolver.Searching, 0, 0)
	Doubling.Target(Hosted.SystemCall) is (Resolver.Hosting, 0, 0)
	Doubling.Target(HostedJson.Getting) is (Resolver.Hosting, 0, 0)
	JsonOnly.Target(HostedJson.Getting) is (Resolver.Native, 0, 0)
	if Hosted(call).IsHosted and (IsSourceRun(call) is false)
		return (Resolver.Hosting, 0, 0)
	let isText = (call.TypeName is "Strict/Text") and (call.MethodName is in Natives.TextMethods)
	isText then (Resolver.Searching, 0, 0) else Called(call)
IsSourceRun(call Invocation) Boolean
	JsonOnly.IsSourceRun(HostedJson.Getting)
	Doubling.IsSourceRun(Hosted.SystemCall) is false
	(Placeholding.IsSourceRun(Hosted.SystemCall) is false) and (Leading.IsSourceRun(Hosted.SystemCall) is false)
	Computing.IsSourceRun(Hosted.SystemCall) and Unnamed.IsSourceRun(Hosted.SystemCall)
	let type = Natives(types).TypeOf(call.TypeName)
	let method = type.Chosen(call.MethodName, call.Count, call.ReturnType, call.ParameterNames)
	let isPlaceholder = (method >= 0) and IsPlaceholder(type.methods(method))
	(TypeEntry.ShortName(call.TypeName) is TypeEntry.ShortName(types.First.Name)) and (isPlaceholder is false)
IsPlaceholder(method MethodEntry) Boolean
	Doubling.IsPlaceholder(InlineRules.Placeholder) and Doubling.IsPlaceholder(Constructing)
	(Doubling.IsPlaceholder(InlineRules.Adding) is false) and (Doubling.IsPlaceholder(Reading) is false)
	Doubling.IsPlaceholder(Fielding) is false
	for method.instructions
		let isRead = (value.kind is InstructionType.LoadVariableToRegister) and (value.texts.First is not "value")
		let kind = value.kind
		let isComputed = (kind > InstructionType.StoreSeparator) and (kind < InstructionType.BinaryOperatorsSeparator)
		if isRead or isComputed or (value.kind is in (InstructionType.IndexCall, InstructionType.FieldLoad))
			return false
	true
Called(call Invocation) Numbers
	Doubling.Called(Resolver.Twice) is (0, 0, 0)
	Doubling.Called(Invocation.AddCall) is (Resolver.Native, 0, 0)
	Routes(TypeEntry.Holding).Called(Invocation.Held) is (1, 0, 0)
	let name = call.MethodName
	let own = Natives(types).TypeOf(call.TypeName)
	let isMissing = (own.Chosen(name, call.Count, call.ReturnType, call.ParameterNames) < 0) and (name is not "from")
	let type = isMissing and (own.Changing.Length is 1) then Natives(types).TypeOf(own.Changing.First.typeName) else own
	let method = type.Chosen(name, call.Count, call.ReturnType, call.ParameterNames)
	if (method < 0) or call.IsNativeConversion or (type.methods(method).instructions.Length is 0)
		return (Resolver.Native, 0, 0)
	(Resolver(types).Position(type), method, Natives(types).IsMemberCall(call, type, type.methods(method)) then 1 else 0)