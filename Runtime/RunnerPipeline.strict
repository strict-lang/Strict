has ops Bytecode/InstructionList
constant StageCount = 4
Run VmValue
	RunnerPipeline(InstructionList.Returning("Add", 3)).Run.number is 8
	VirtualMachine(ops).Run.returnValue
Stored(name Text, amount Number) RunnerPipeline
	RunnerPipeline.Stored("n", 7).Run.number is 7
	let store = InstructionList.Empty.Append(BytecodeInstruction.StoreConstant(name, amount))
	RunnerPipeline(store.Append(BytecodeInstruction.LoadVariable(0, name)).Append(BytecodeInstruction.ReturnOp(0)))
to Text
	"pipeline"