has root Text = ""
has folder Text = ""
has files Texts = List(Text)
has generics Texts = List(Text)
has inference TypeInference = ResolveCheck.Counting
has known Dictionary(Text, TypeEntry) = Dictionary(Text, TypeEntry)
has rawTypes List(TypeEntry) = List(TypeEntry)
has resolvedTypes List(TypeEntry) = List(TypeEntry)
has signatures Texts = List(Text)
has targets Texts = List(Text)
has typeNames Texts = List(Text)
has machine Machine = Machine.Hello.Prepared
has code Number = 0
has fullNames Texts = List(Text)
has stamps Numbers = List(Number)
constant Empty = ScriptCache
constant ReturnOne = MethodEntry("Run", List(MemberEntry), "None", (InstructionEntry.LoadNumber(0, 1), InstructionEntry.Return(0)))
constant ScratchRun = List(TypeEntry) + TypeEntry("Strict/Scratch", List(MemberEntry), ReturnOne)
constant SampleTargets = List(Text) + "Strict/B.Go"
constant SampleNames = ("Strict/Logger", "Strict/Number")
constant Numbers = List(Text) + "./Number.strict"
constant SampleBase = ScriptCache(".", ".", Numbers, List(Text), ResolveCheck.Counting, stamps = KeptInference.Empty.Stamps(Numbers))
constant Sample = ScriptCache(SampleBase, rawTypes = List(TypeEntry) + TypeEntry.HelloLogger, resolvedTypes = ScratchRun, targets = SampleTargets, typeNames = SampleNames)
IsFresh(currentRoot Text, currentFolder Text) Boolean
	Empty.IsFresh(".", ".") is false
	Sample.IsFresh(".", ".")
	ScriptCache(Sample, stamps = List(Number) + 1).IsFresh(".", ".") is false
	files.Length > 0 and root is currentRoot and folder is currentFolder and KeptInference.Empty.Stamps(files) is stamps
IsBuiltIn(target Text) Boolean
	Sample.IsBuiltIn("Strict/Scratch.Helper")
	Sample.IsBuiltIn("Strict/Number.to")
	Sample.IsBuiltIn("Strict/B.Go") is false
	Sample.IsBuiltIn("Strict/Error.from") is false
	dot = target.LastIndexOf(".")
	type = target.Substring(0, dot)
	method = target.Substring(dot + 1, target.Length - dot - 1)
	simple = method is in ("from", "in", "Index", "to", "to Text", "to Type") and type is in typeNames
	target.StartsWith("Strict/Scratch.") or simple or Linker.Sample.IsNative(type, method)
IsHit(entry TypeEntry) Boolean
	Empty.IsHit(TypeEntry.HelloLogger) is false
	Sample.IsHit(TypeEntry("Strict/Scratch", List(MemberEntry), MethodEntry.GoRun))
	if resolvedTypes.Length is 0
		return false
	for Linker.Sample.Targets(List(TypeEntry) + entry)
		if value is not in targets and IsBuiltIn(value) is false
			return false
	for entry.UsedTypes
		if value is not entry.Name and value.IndexOf("(") < 0 and value is not in typeNames
			return false
	true
BaseRaw List(TypeEntry)
	rawTypes.Length > 1 then rawTypes.Slice(1, rawTypes.Length - 1) else List(TypeEntry)
BaseResolved List(TypeEntry)
	resolvedTypes.Length > 1 then resolvedTypes.Slice(1, resolvedTypes.Length - 1) else List(TypeEntry)
GenericsOf(knownTypes KnownTypes) Texts
	for knownTypes.names
		if "Generic" is in knownTypes.members(index).types or "Generic" is in knownTypes.methods(index).types
			value
WithBase(baseFiles Texts, currentRoot Text, currentFolder Text) ScriptCache
	stamped = KeptInference.Empty.Stamps(baseFiles)
	nextInference = ResolveCheck.Inference(baseFiles)
	names = FileCompiler.FullNames(baseFiles, currentRoot) + "Strict/Scratch"
	found = GenericsOf(nextInference.types)
	ScriptCache(currentRoot, currentFolder, baseFiles, found, nextInference, fullNames = names, stamps = stamped)
BaseOnly(discovered Texts, skip = "") Texts
	Empty.BaseOnly((Scripted.Path, "./A.strict", "./B.strict"), "./A.strict") is (List(Text) + "./B.strict")
	for discovered
		if value is not Scripted.Path and value is not skip
			value
BaseLoaded(lines Texts, currentRoot Text, logger Logger, skip = "") ScriptCache
	ScriptCache(Sample, folder = Directory.Current, code = 1).BaseLoaded(("Run", "\t1"), ".", Logger).code is 0
	currentFolder = Directory.Current
	if IsFresh(currentRoot, currentFolder) and Mentions(lines).Missing(files).Length is 0
		return code is 0 then value else ScriptCache(value, code = 0)
	File(Scripted.Path).InMemory(Text.Combine(lines, "\n"))
	discovered = SourceFiles(currentRoot).Of(Scripted.Path)
	missing = Mentions(lines).Missing(discovered)
	if missing.Length > 0
		logger.Log(ResolveCheck.Located(Scripted.Path, FileCompiler.LineOf(lines, missing.First), missing.First))
	File(Scripted.Path).InMemory("")
	clean = BaseOnly(discovered, skip)
	missing.Length > 0 then ScriptCache(value, code = 1) else WithBase(clean, currentRoot, currentFolder)
MergedInference(lines Texts) TypeInference
	Sample.MergedInference(("Run", "\t1")).types.IsKnown("Scratch")
	shape = TypeShape(lines)
	types = inference.types
	mutable positions = types.positions
	positions("Scratch") = types.names.Length
	members = types.members + shape.MemberScope.Indexed.Owned("Scratch")
	typedMethods = ShapeTyping(inference).Typed(shape, shape.MethodScope, "Scratch").Indexed.Owned("Scratch")
	params = types.parameters + shape.CallScope(generics)
	merged = KnownTypes(types.names + "Scratch", members, types.methods + typedMethods, params, positions)
	TypeInference(merged, inference.constants + shape.ConstantScope)
EntryNames(entries List(TypeEntry)) Texts
	for entries
		value.Name
MethodTargets(entries List(TypeEntry)) Texts
	mutable result = List(Mutable(Text))
	for entries.Slice(1, entries.Length - 1)
		entryName = value.Name
		for value.methods
			result.Add(entryName + "." + value.Name)
	result
Linked(entry TypeEntry, main TypeCodegen) ScriptCache
	fast = Linker(root, main, known, Linker.Unsourced, isFast = true)
	round = fast.Linked((List(TypeEntry) + entry) + BaseRaw, signatures)
	if round.entries.Length is 0
		return ScriptCache(value, code = 1)
	nextMachine = outer.Execute.Started(round.entries, Scripted.Path, false, true)
	mutable nextKnown = known
	for round.signatures
		nextKnown(value) = round.entries(index + 1)
	Cached(round, entry, nextMachine, nextKnown)
Cached(round LinkRound, entry TypeEntry, nextMachine Machine, nextKnown Dictionary(Text, TypeEntry)) ScriptCache
	invoked = Linker.Sample.Targets(List(TypeEntry) + entry)
	nextTargets = (MethodTargets(round.entries) + invoked + round.Targets).Unique
	nextNames = (typeNames + EntryNames(round.entries) + entry.UsedTypes).Unique
	updated = ScriptCache(value, known = nextKnown, rawTypes = round.entries, code = 0)
	wired = ScriptCache(updated, resolvedTypes = nextMachine.types, signatures = round.signatures)
	ScriptCache(wired, targets = nextTargets, typeNames = nextNames, machine = nextMachine)
IsExecuted(entry TypeEntry, arguments List(VmValue)) Boolean
	Sample.IsExecuted(TypeEntry("Strict/Scratch", List(MemberEntry), ReturnOne), List(VmValue))
	rewritten = TailCalls(List(TypeEntry) + entry).Rewritten.First
	base = BaseResolved
	methods = Resolver((List(TypeEntry) + rewritten) + base).Methods(rewritten)
	resolved = TypeEntry(rewritten.Name, rewritten.members, methods)
	nextTypes = (List(TypeEntry) + resolved) + base
	if machine.prototypes.entries.Length is 0
		return Machine(nextTypes, ConstantCache(List(VmValue)), folder).Prepared.IsCompleted(entry.Name, arguments)
	machine.prototypes.Stored(0, Natives(nextTypes).Fresh(resolved))
	prepared = Machine(nextTypes, machine.prototypes, folder, false, machine.sources)
	machine.prototypes.Stored(0, Constants(prepared).Filled(0))
	prepared.IsCompleted(entry.Name, arguments)
Ran(entry TypeEntry, main TypeCodegen, arguments List(VmValue)) ScriptCache
	if IsHit(entry)
		return ScriptCache(value, code = IsExecuted(entry, arguments) then 0 else 1)
	built = Linked(entry, main)
	isCompleted = built.machine.IsCompleted(entry.Name, arguments)
	built.code > 0 then built else ScriptCache(built, code = isCompleted then 0 else 1)
IsValidated(lines Texts, merged TypeInference, logger Logger) Boolean
	Sample.IsValidated(("Run", "\tmissing"), Sample.MergedInference(("Run", "\tmissing")), Logger) is false
	broken = FileCompiler.Unparsable(lines)
	if broken >= 0
		logger.Log(ResolveCheck.Located(Scripted.Path, broken + 1, FileCheck.Problem(lines, broken)))
		return false
	knownNames = merged.types.names + ("value", "index", "outer") + merged.types.ShapeScope("Scratch").names
	bodies = MethodBodies("Scratch", TypeShape(lines), merged)
	issues = ResolveCheck.Found(FileCheck(merged, knownNames), bodies, lines, Scripted.Path)
	for issues
		logger.Log(value)
	issues.Length is 0
RanLines(lines Texts, texts List(VmValue), currentRoot Text, logger Logger, path = "") ScriptCache
	base = BaseLoaded(lines, currentRoot, logger, path is "" then "" else FileCompiler.Normalized(path))
	if base.code > 0
		return ScriptCache(value, code = 1)
	merged = base.MergedInference(lines)
	if IsValidated(lines, merged, logger) is false
		return ScriptCache(base, code = 1)
	main = TypeCodegen("Strict/Scratch", lines, merged, base.fullNames, false)
	base.Ran(main.Entry, main, texts)
