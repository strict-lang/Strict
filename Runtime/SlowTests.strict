constant Slowest = 1000
Overran(elapsed Number, place Text) Text
	SlowTests.Overran(1200, "a").StartsWith("Test failed: a took 1200 ms on the VM")
	SlowTests.Overran(500, "a") is ""
	let limit = " ms on the VM, slow tests may take " + Slowest + " ms at most: mark the method native"
	elapsed > Slowest then "Test failed: " + place + " took " + elapsed.Round + limit else ""
Overrun(elapsed Number) Number
	SlowTests.Overrun(1200) is 1
	SlowTests.Overrun(5) is 0
	elapsed > Slowest then 1 else 0
