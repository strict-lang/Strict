has types List(TypeEntry)
constant Pair = TypeEntry("Strict/Pair", (MemberEntry.LoggerMember, MemberEntry("b", "Strict/List(Number)", List(InstructionEntry), false)), List(MethodEntry))
constant StoreSecond = InstructionEntry(InstructionType.StoreRegisterToVariable, "list(1)", (6, 7, Resolver.LiteralIndex, 1))
constant Pairing = Storage(List(TypeEntry) + Pair)
constant OneTwo = VmValue.OfList(VmValue.OfNumber(1), VmValue.OfNumber(2))
constant Paired = VmValue("Strict/Pair", 0, "", (VmValue.None, OneTwo))
Write(owner VmValue, target Text, position Number, element VmValue) VmValue
	Pairing.Write(OneTwo, "list", 1, VmValue.OfNumber(7)).items is (VmValue.OfNumber(1), VmValue.OfNumber(7))
	Pairing.Write(Paired, "pair.b", 0, VmValue.OfNumber(7)).items(1).items is (VmValue.OfNumber(7), VmValue.OfNumber(2))
	Pairing.Write(Paired, "b", 0, VmValue.OfNumber(7)).items(0).number is 7
	dot = target.IndexOf(".")
	found = dot > 0 then Member(owner, target.Substring(dot + 1, target.Length - dot - 1)) else -1
	list = found < 0 then owner else owner.items(found)
	at = position < 0 then position + list.items.Length else position
	isOutside = at < 0 or at >= list.items.Length
	changed = isOutside then VmValue.OfError("IndexOutOfRange") else VmValue.OfList(Replace(list.items, at, element))
	if found < 0 or isOutside
		return changed
	VmValue(owner.kind, owner.number, owner.text, Replace(owner.items, found, changed))
Member(owner VmValue, name Text) Number
	Pairing.Member(Paired, "b") is 1
	Pairing.Member(Paired, "c") is -1
	Pairing.Write(OneTwo, "list", -1, VmValue.OfNumber(7)) is Pairing.Write(OneTwo, "list", 1, VmValue.OfNumber(7))
	Pairing.Write(OneTwo, "list", 2, VmValue.OfNumber(7)) is VmValue.OfError("IndexOutOfRange")
	Pairing.Replace(OneTwo.items, -1, VmValue.None) is OneTwo.items
	Pairing.Replace(List(VmValue), 1, VmValue.OfNumber(5)) is (VmValue.None, VmValue.OfNumber(5))
	Pairing.Replace(OneTwo.items, 2, VmValue.OfNumber(5)).Last.number is 5
	for Natives(types).TypeOf(owner.kind).members
		if value.Name is name
			return index
	Number.NotFound
Replace(elements List(VmValue), slot Number, entry VmValue) List(VmValue)
	Pairing.Replace((VmValue.OfNumber(1), VmValue.OfNumber(2)), 1, VmValue.None).Last.kind is "None"
	Pairing.Replace(List(VmValue), 2, VmValue.None).Length is 3
	Pairing.Replace(List(VmValue) + VmValue.OfNumber(1), -1, VmValue.None).First.number is 1
	if slot < 0
		return elements
	mutable result = elements
	for slot - elements.Length
		result = result + VmValue.None
	if slot >= elements.Length
		return result + entry
	result(slot) = entry
	result