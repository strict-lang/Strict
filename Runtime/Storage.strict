has types List(TypeEntry)
constant Pair = TypeEntry("Strict/Pair", (MemberEntry.LoggerMember, MemberEntry("b", "Strict/List(Number)", List(InstructionEntry), false)), List(MethodEntry))
constant StoreSecond = InstructionEntry(InstructionType.StoreRegisterToVariable, "list(1)", (6, 7, Resolver.LiteralIndex, 1))
constant Pairing = Storage(List(TypeEntry) + Pair)
constant OneTwo = VmValue.OfList(VmValue.OfNumber(1), VmValue.OfNumber(2))
constant Paired = VmValue("Strict/Pair", 0, "", (VmValue.None, OneTwo))
Written(owner VmValue, target Text, position Number, element VmValue) VmValue
	Pairing.Written(OneTwo, "list", 1, VmValue.OfNumber(7)).items(1).number is 7
	Pairing.Written(Paired, "pair.b", 0, VmValue.OfNumber(7)).items(1).items(0).number is 7
	let dot = target.IndexOf(".")
	let found = dot > 0 then Member(owner, target.Substring(dot + 1, target.Length - dot - 1)) else -1
	let list = found < 0 then owner else owner.items(found)
	let changed = VmValue.OfList(Replaced(list.items, position, element))
	if found < 0
		return changed
	VmValue(owner.kind, owner.number, owner.text, Replaced(owner.items, found, changed))
Member(owner VmValue, name Text) Number
	Pairing.Member(Paired, "b") is 1
	Pairing.Member(Paired, "c") is -1
	for Natives(types).TypeOf(owner.kind).members
		if value.Name is name
			return index
	-1
Replaced(elements List(VmValue), slot Number, entry VmValue) List(VmValue)
	Pairing.Replaced((VmValue.OfNumber(1), VmValue.OfNumber(2)), 1, VmValue.None).Last.kind is "None"
	Pairing.Replaced(List(VmValue), 2, VmValue.None).Length is 3
	Pairing.Replaced(List(VmValue) + VmValue.OfNumber(1), -1, VmValue.None).First.number is 1
	if slot < 0
		return elements
	mutable result = elements
	for slot - elements.Length
		result = result + VmValue.None
	if slot >= elements.Length
		return result + entry
	result(slot) = entry
	result