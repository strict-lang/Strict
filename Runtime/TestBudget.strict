Start(place Text, isSlow Boolean) Number
	TestBudget.Start("", false) is Error and TestBudget.Start("", true) is not Error
	isSlow is false and place.Length is 0 then Error("Unit test must have a description") else Process.Elapsed
Finish(started Number) Number
	(Process.Elapsed - started) * 1000
Entered Number
	Process.Elapsed
Left(entered Number)
Expired Text
	""
Overran(elapsed Number, place Text) Text
Overrun(elapsed Number) Number
Watch(place Text, isSlow Boolean) Number
Busy(depth Number, step Number) Number
Limit(seconds Number, message Text)
