has trial Trial
constant Sample = Trial("has numbers Numbers\nWarmed Number\n\tWarmUp((1, 2, 3)).Warmed is 20\n\tnumbers.Sum + numbers.Length + numbers.Reverse.First + numbers.Maximum + (numbers.First - 5).Absolute + (numbers.First < 2 then 1 else 0)")
constant Warm = TrialRun(Sample).Warmed
constant Prepared = TrialMachine.Prepared(Warm.Types, FileCompiler.Normalize(Sample.Located))
Tested Text slow
	"Test passed: AddTwoNumbers(2, 3) is 5" is in TrialRun(Trial.Adding).Tested
	if trial.Name is ""
		return ""
	warm = Warm
	prepared = Prepared
	Place
	started = logger.Capture(true)
	answer = RunTrial(warm, prepared)
	output = started + logger.Capture(false)
	answer is Error then output + answer to Text else output
Warmed Answer slow
	Place
	started = logger.Capture(true)
	answer = RunTrial(Answer(0, Dictionary(Text, TypeEntry)), TrialMachine.None)
	output = started + logger.Capture(false)
	if answer is Error or answer.code is not 0
		logger.Log(output)
	answer
RunTrial(last Answer, machine TrialMachine) Answer slow
	request = TestRequest((trial.Located, TypeSource.Root, "unit"))
	Execute(request.Executing(last.known, last.inferred), trial = machine).Serve(trial.Located, TypeSource.Root)
Place slow
	TrialRun(Trial.Adding).Place is not Error and Execute.IsEdited(Trial.Adding.Located)
	trial.Write
	File(FileCompiler.Normalize(trial.Located)).InMemory(trial.source)
