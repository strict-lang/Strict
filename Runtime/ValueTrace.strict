has logger
constant Events = ("$Hit Strict/Examples/Sum|2", "$Set Strict/Examples/Sum|2|a|7", "$Hit Strict/Examples/Sum|2", "$Set Strict/Examples/Sum|2|a|7", "$Hit Sum|3", "$Set Sum|3|b|1", "$Hit Sum|3", "$Set Sum|3|b|2")
Run(path Text, root Text) Number
	ValueTrace(Logger).Run("Missing.strict", ".") is 2
	if File(path).Exists is false
		return 2
	let result = ToolRunner(Process.Current.executable).Execute("test " + path + " " + root + " trace")
	let lines = result.Output.Lines
	for Plain(lines) + Valued(lines, Path(path).PathOnly.text)
		logger.Log(value)
	if (result.exitCode >= 0) and (result.exitCode < 128)
		logger.Log(Execute.Summary(result.exitCode, path))
	result.exitCode
Plain(lines Texts) Texts
	ValueTrace.Plain(("a", "$Hit A|1")) is ("a")
	for lines
		if value.StartsWith("$") is false
			value
Traced(path Text, root Text) Number
	ValueTrace(Logger).Traced("Missing.strict", ".") is 2
	if File(path).Exists is false
		return 2
	let types = FileCompiler(logger).Compiled(path, root, true)
	types.Length is 0 then 1 else Execute(logger).Started(types, path, true).Tested(types.First.Name)
Valued(lines Texts, folder Text) Texts
	ValueTrace(Logger).Valued(Events, "Examples").First.EndsWith("line 2 hit 2 times") is true
	ValueTrace(Logger).Valued(Events, "Examples").Last.EndsWith("line 3 hit 2 times") is true
	let shown = Shown(lines)
	for Counts(lines)
		Line(value.Key, value.Value, shown, folder)
Counts(lines Texts) Dictionary(Text, Number)
	ValueTrace(Logger).Counts(Events)("Sum|3") is 2
	mutable counts = Dictionary(Text, Number)
	for lines
		if value.StartsWith("$Hit ")
			let place = value.Substring(5, value.Length - 5)
			counts(place) = (place is in counts then counts(place) else 0) + 1
	counts
Shown(lines Texts) Dictionary(Text, Text)
	ValueTrace(Logger).Shown(Events)("Strict/Examples/Sum|2|a") is "7"
	ValueTrace(Logger).Shown(Events)("Sum|3|b") is ""
	ValueTrace(Logger).Shown(List(Text) + "$Set A|2|text|\"a|b\"")("A|2|text") is "\"a|b\""
	mutable shown = Dictionary(Text, Text)
	for lines
		if value.StartsWith("$Set ")
			let parts = value.Split("|")
			let key = parts(0).Substring(5, parts(0).Length - 5) + "|" + parts(1) + "|" + parts(2)
			let start = parts(0).Length + parts(1).Length + parts(2).Length + 3
			let assigned = value.Substring(start, value.Length - start)
			shown(key) = (key is in shown) and (shown(key) is not assigned) then "" else assigned
	shown
Line(place Text, count Number, shown Dictionary(Text, Text), folder Text) Text
	ValueTrace(Logger).Line("Sum|3", 1, Dictionary(Text, Text), "Examples").EndsWith("line 3 hit 1 times") is true
	let parts = place.Split("|")
	let file = TypeSource(TypeEntry(parts(0), List(MemberEntry), List(MethodEntry))).Located(folder)
	let start = "Value " + file + ":line " + parts(1) + " hit " + count + " times"
	let source = File(file).ReadLines
	let number = parts(1) to Number
	let named = number <= source.Length then Assigned(source(number - 1)) else List(Text)
	let key = named.Length is 2 then place + "|" + named(0) else ""
	let assigned = key is in shown then shown(key) else ""
	assigned is "" then start else start + ": " + named(1) + " = " + assigned
Assigned(line Text) Texts
	ValueTrace.Assigned("\tlet scale = 10 ^ decimals") is ("scale", "scale")
	ValueTrace.Assigned("\t\tcount = count + 1") is ("count", "count")
	ValueTrace.Assigned("\tfor Range(1, 16)") is ("for", "Range(1, 16)")
	ValueTrace.Assigned("has number with value >= -1").Length is 0
	let code = line.Trim
	if code.StartsWith("for ")
		return ("for", code.Substring(4, code.Length - 4))
	let words = code.Split(" ")
	let at = words.First is in ("let", "mutable") then 1 else 0
	(words.Length > at + 2) and (words(at + 1) is "=") then (words(at), words(at)) else List(Text)