has logger
Run
	constant left = InstrBuilder.LoadConstant(0, 2)
	constant right = InstrBuilder.LoadConstant(1, 3)
	constant add = InstrBuilder.BinaryOp("Add", 0, 1, 2)
	constant ret = InstrBuilder.ReturnOp(2)
	constant ops = InstrList.Empty.Append(left).Append(right).Append(add).Append(ret)
	constant state = VirtualMachine.Empty.Run(ops)
	logger.Log(state.didReturn)
	logger.Log(state.returnValue)