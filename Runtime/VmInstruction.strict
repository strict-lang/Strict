has typeName Text
has register Number
has amount Number
has label Text
to Text
	typeName + " r" + register to Text + " " + amount to Text + " " + label
IsLoadConstant Boolean
	typeName is "LoadConstantToRegister"
IsLoadVariable Boolean
	typeName is "LoadVariableToRegister"
IsStoreRegister Boolean
	typeName is "StoreRegisterToVariable"
IsStoreConstant Boolean
	typeName is "StoreConstantToVariable"
IsReturn Boolean
	typeName is "Return"
IsBinary Boolean
	VmInstruction.BinaryOp("Modulo", 0, 1, 2).IsBinary is true
	if typeName is in ("Add", "Subtract", "Multiply", "Divide", "Modulo")
		return true
	IsCompare
IsCompare Boolean
	VmInstruction("LessThan", 0, 1, "2").IsCompare is true
	typeName is in ("Equal", "NotEqual", "LessThan", "GreaterThan")
IsJump Boolean
	VmInstruction("JumpIfTrue", 0, 1, "").IsJump is true
	typeName is in ("Jump", "JumpIfTrue", "JumpIfFalse")
ResultRegister Number
	VmInstruction.BinaryOp("Add", 0, 1, 2).ResultRegister is 2
	if IsBinary
		return label to Number
	register
LoadConstant(reg Number, number Number) VmInstruction
	VmInstruction.LoadConstant(0, 5).IsLoadConstant is true
	VmInstruction("LoadConstantToRegister", reg, number, "")
LoadVariable(reg Number, name Text) VmInstruction
	VmInstruction.LoadVariable(0, "x").label is "x"
	VmInstruction("LoadVariableToRegister", reg, 0, name)
StoreConstant(name Text, number Number) VmInstruction
	VmInstruction.StoreConstant("n", 5).IsStoreConstant is true
	VmInstruction("StoreConstantToVariable", 0, number, name)
BinaryOp(name Text, left Number, right Number, result Number) VmInstruction
	VmInstruction.BinaryOp("Add", 0, 1, 2).IsBinary is true
	VmInstruction(name, left, right, result to Text)
ReturnOp(reg Number) VmInstruction
	VmInstruction.ReturnOp(0).IsReturn is true
	VmInstruction("Return", reg, 0, "")