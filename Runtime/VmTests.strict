has logger
Run
	constant left = InstrBuilder.LoadConstant(0, 6)
	constant right = InstrBuilder.LoadConstant(1, 7)
	constant mul = InstrBuilder.BinaryOp("Multiply", 0, 1, 2)
	constant ret = InstrBuilder.ReturnOp(2)
	constant ops = InstrList.Empty.Append(left).Append(right).Append(mul).Append(ret)
	constant state = VirtualMachine.Empty.Run(ops)
	logger.Log(state.didReturn)
	logger.Log(state.returnValue)