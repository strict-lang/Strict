has kind Text
has number
has text
has items List(VmValue)
constant None = VmValue("None", 0, "", List(VmValue))
constant TrueValue = VmValue("Boolean", 1, "", List(VmValue))
constant FalseValue = VmValue("Boolean", 0, "", List(VmValue))
constant ErrorKinds = ("Strict/Error", "Strict/ErrorWithValue")
constant Failed = VmValue("Strict/Error", 0, "", (OfText("x"), OfList(List(VmValue) + VmValue("Strict/Stacktrace", 0, "", (OfText("B.C"), OfText("B.strict"), OfNumber(7))))))
constant Numbered = VmValue("Strict/List(Number)", 0, "", (OfNumber(5), OfNumber(6)))
OfNumber(amount Number) VmValue
	OfNumber(3).number is 3
	VmValue("Number", amount, "", List(VmValue))
OfText(content Text) VmValue
	OfText("a").text is "a"
	VmValue("Text", 0, content, List(VmValue))
OfBoolean(condition Boolean) VmValue
	OfBoolean(true).IsTrue
	OfBoolean(false).IsTrue is false
	condition then TrueValue else FalseValue
OfList(elements List(VmValue)) VmValue
	OfList(OfNumber(1), OfNumber(2)).items.Length is 2
	VmValue("List", 0, "", elements)
OfError(name Text) VmValue
	OfError("Missing").items.First.text is "Missing"
	VmValue("Strict/Error", 0, "", (OfText(name), OfList(List(VmValue))))
KeyIndex(key VmValue) Number
	OfList(OfList(OfNumber(1), OfNumber(3)), OfList(OfNumber(2), OfNumber(4))).KeyIndex(OfNumber(2)) is 1
	OfList(OfList(OfNumber(1), OfNumber(3))).KeyIndex(OfNumber(5)) is -1
	for items
		if value.items.First is key
			return index
	-1
Counted(arguments List(VmValue)) Number
	OfList(OfNumber(1), OfNumber(2), OfNumber(1)).Counted(List(VmValue) + OfNumber(1)) is 2
	OfList(OfNumber(1)).Counted(List(VmValue)) is 1
	if arguments.Length is 0
		return Length
	for items
		if value is arguments.First
			1
Member(index Number) VmValue
	OfText("ab").Member(0).text is "ab"
	VmValue("Strict/Shape", 0, "", List(VmValue) + OfNumber(3)).Member(0).number is 3
	None.Member(1).kind is "None"
	OfNumber(3).Member(0).number is 3
	Numbered.Member(1).items.Length is 2
	let isBase = TypeEntry.ShortName(kind).Split("(").First is in ("Text", "Number", "Boolean", "List")
	isBase then value else index < items.Length then items(index) else None
As(typeName Text) VmValue
	OfText("a").As("Strict/Number").number is 97
	OfNumber(98).As("Strict/Character").text is "b"
	OfText("ab").As("Strict/List(Character)").text is "ab"
	OfText("ab").As("Strict/Number").text is "ab"
	if (kind is not "Number") and (kind is not "Text")
		return value
	let target = TypeEntry.ShortName(typeName)
	if (kind is "Number") and (target is "Character")
		return OfText(Character(number) to Text)
	(kind is "Text") and (target is "Number") and (text.Length is 1) then OfNumber(Character(text).number) else value
IsTrue Boolean
	OfBoolean(false).IsTrue is false
	number is 1
Length Number
	OfText("abc").Length is 3
	OfList(OfNumber(1), OfNumber(2)).Length is 2
	kind is "Text" then text.Length else items.Length
to Text
	OfNumber(2.5) to Text is "2.5"
	OfBoolean(true) to Text is "true"
	OfText("a") to Text is "a"
	OfList(OfNumber(1), OfNumber(2)) to Text is "(1, 2)"
	if kind is "Number"
		return number to Text
	if kind is "Boolean"
		return IsTrue then "true" else "false"
	if kind is "List"
		return Joined
	kind is in ("Text", "None") then text else Automatic
Joined Text
	OfList(OfNumber(1), OfNumber(2)).Joined is "(1, 2)"
	OfList(List(VmValue) + OfNumber(5)).Joined is "(5)"
	OfList(List(VmValue)).Joined is ""
	if items.Length is 0
		return ""
	mutable result = "(" + items(0) to Text
	for Range(1, items.Length)
		result = result + ", " + items(value) to Text
	result + ")"
Automatic Text
	VmValue("Strict/Process", 0, "", List(VmValue) + OfText("a") + None).Automatic is "(a)"
	Failed.Automatic is "Error: x\n\tat B.C in B.strict:line 7"
	if kind is "Strict/Error"
		return "Error: " + items(0).text + Traces
	mutable result = ""
	for items
		if value.kind is not "None"
			let shown = value to Text
			result = result is "" then shown else result + ", " + shown
	"(" + result + ")"
Traces Text
	Failed.Traces is "\n\tat B.C in B.strict:line 7"
	mutable result = ""
	for items(1).items
		let file = value.items(1).text
		let line = value.items(2).number
		let at = "at " + value.items(0).text + " in " + file + ":line " + line
		result = result + "\n\t" + (file is "" then "... (skipped " + line + " lines)" else at)
	result
