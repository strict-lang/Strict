has kind Text
has number
has text
has items List(VmValue)
constant None = VmValue("None", 0, "", List(VmValue))
OfNumber(amount Number) VmValue
	OfNumber(3).number is 3
	VmValue("Number", amount, "", List(VmValue))
OfText(content Text) VmValue
	OfText("a").text is "a"
	VmValue("Text", 0, content, List(VmValue))
OfBoolean(condition Boolean) VmValue
	OfBoolean(true).IsTrue is true
	VmValue("Boolean", (condition then 1 else 0), "", List(VmValue))
OfList(elements List(VmValue)) VmValue
	OfList(OfNumber(1), OfNumber(2)).items.Length is 2
	VmValue("List", 0, "", elements)
OfError(name Text) VmValue
	OfError("Missing").items.First.text is "Missing"
	VmValue("Strict/Error", 0, "", (OfText(name), OfList(List(VmValue))))
KeyIndex(key VmValue) Number
	OfList(OfList(OfNumber(1), OfNumber(3)), OfList(OfNumber(2), OfNumber(4))).KeyIndex(OfNumber(2)) is 1
	OfList(OfList(OfNumber(1), OfNumber(3))).KeyIndex(OfNumber(5)) is -1
	for items
		if value.items.First is key
			return index
	-1
Counted(arguments List(VmValue)) Number
	OfList(OfNumber(1), OfNumber(2), OfNumber(1)).Counted(List(VmValue) + OfNumber(1)) is 2
	OfList(OfNumber(1)).Counted(List(VmValue)) is 1
	if arguments.Length is 0
		return Length
	for items
		if value is arguments.First
			1
IsTrue Boolean
	OfBoolean(false).IsTrue is false
	number is 1
Length Number
	OfText("abc").Length is 3
	OfList(OfNumber(1), OfNumber(2)).Length is 2
	kind is "Text" then text.Length else items.Length
to Text
	OfNumber(2.5) to Text is "2.5"
	OfBoolean(true) to Text is "true"
	OfText("a") to Text is "a"
	OfList(OfNumber(1), OfNumber(2)) to Text is "(1, 2)"
	if kind is "Number"
		return number to Text
	if kind is "Boolean"
		return IsTrue then "true" else "false"
	if kind is "List"
		return Joined
	kind is in ("Text", "None") then text else Automatic
Joined Text
	OfList(OfNumber(1), OfNumber(2)).Joined is "(1, 2)"
	OfList(List(VmValue)).Joined is ""
	if items.Length < 2
		return items.Length is 0 then "" else items(0) to Text
	mutable result = "(" + items(0) to Text
	for Range(1, items.Length)
		result = result + ", " + items(value) to Text
	result + ")"
Automatic Text
	VmValue("Strict/Process", 0, "", List(VmValue) + OfText("a") + None).Automatic is "(a)"
	mutable result = ""
	for items
		if value.kind is not "None"
			let shown = value to Text
			result = result is "" then shown else result + ", " + shown
	"(" + result + ")"