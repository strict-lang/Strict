has logger
constant Version = "1.0"
constant Commands = ("build", "test", "check", "update", "format")
constant Informing = ("version", "--version", "help", "--help")
constant Help = ("strict <file> [arguments]  run the Run method on the Strict VM, the fastest, everything stays in memory", "strict build <file>        run the tests, then compile a native executable (Name.test without a Run method)", "strict test <file>         run the inline tests of every method on the Strict VM", "strict test <file> lines   run them natively and print how often and how long each line ran (with and without callees)", "strict check <folder>      validate the .strict files: type rules, unused members, limits", "strict format <file>       print the file in its canonical form, each method body as the parser reads it", "strict update <folder>     refresh the packages copied into the folder (.origin) from their clone or GitHub", "strict version             show the version number and when this strict executable was built")
Run(arguments Texts) Number
	let command = arguments.Length > 0 then arguments(0) else "help"
	let rest = Rooted(command is in Commands then Rest(arguments) else arguments)
	let message = Message(command, rest)
	if message is not ""
		logger.Log(message)
		return command is in Informing then 0 else 2
	if command is in ("check", "update", "format")
		return Tool(command, rest)
	if command is "test"
		return Tested(rest)
	command is "build" then Built(NativeBuild(logger), rest(0), rest(1)) else Execute(logger).Run(rest)
Message(command Text, rest Texts) Text
	Strict.Message("version", List(Text)).StartsWith(Version + " 20") is true
	Strict.Message("help", List(Text)).StartsWith("strict <file> [arguments]  run") is true
	Strict.Message("test", ("a.strict", ".")) is "a.strict not found"
	Strict.Message("test", ("Compiler", ".")) is ""
	Strict.Message("check", ("Compiler", ".")) is ""
	if command is in ("version", "--version")
		return Version + " " + Process.Current.Built.Substring(0, 16)
	if (command is in Informing) or (rest.Length < 2)
		return Text.Combine(Help, "\n")
	let isFolder = (command is "test") and Directory.Exists(rest(0))
	(command is in ("check", "update")) or isFolder or File(rest(0)).Exists then "" else rest(0) + " not found"
Tested(rest Texts) Number
	Strict.Tested(("Examples/HelloLogger.strict", ".")) is 0
	let option = rest.Length > 2 then rest(2) else ""
	option is "lines" then NativeBuild(logger).Compile(rest(0), rest(1), true) else Execute(logger).Test(rest(0), rest(1))
Rooted(arguments Texts) Texts
	Strict.Rooted(List(Text) + "a.strict") is ("a.strict", ".")
	Strict.Rooted(("a.strict", "Compiler")) is ("a.strict", "Compiler")
	Strict.Rooted(("a.strict", "5")) is ("a.strict", ".", "5")
	if (arguments.Length is 0) or ((arguments.Length > 1) and Directory.Exists(arguments(1)))
		return arguments
	(List(Text) + arguments(0) + Root) + Rest(arguments)
Root Text
	Strict.Root is "."
	File("Any.strict").Exists then "." else Path(Process.Current.executable.Replace("\\", "/")).PathOnly.text
Rest(arguments Texts) Texts
	Strict.Rest(("test", "a", "b")) is ("a", "b")
	for Range(1, arguments.Length)
		arguments(value)
Tool(command Text, rest Texts) Number
	if command is "format"
		return Format(rest(0))
	command is "check" then Checked(ValidateCheck(logger), rest(0), rest(1)) else Updated(Repositories(logger), rest(0))
Checked(checker Validators/ValidateCheck, folder Text, root Text) Number
	checker.Run(folder, root)
Updated(updater Bytecode/Repositories, folder Text) Number
	logger.Log("Updated " + updater.Updated(folder) + " packages in " + folder)
	0
Built(builder Compiler/NativeBuild, path Text, root Text) Number
	builder.Built(path, root)
Format(path Text) Number
	Strict.Format("Examples/HelloLogger.strict") is 0
	let lines = RoundTrip(logger).Tabbed(File(path).ReadLines)
	let broken = FileCompiler.Unparsable(lines)
	if broken >= 0
		logger.Log(FileCheck.Problem(lines, broken) + " in " + FileCompiler.Normalized(path) + ":" + (broken + 1))
		return 1
	logger.Log(Text.Combine(RoundTrip(logger).Formatted(lines), "\n"))
	0