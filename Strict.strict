has logger
constant Version = "1.0"
constant Commands = ("build", "test", "check", "update", "format", "suggest")
constant BuildWait = 90
constant Informing = ("version", "--version", "help", "--help")
constant RunHelp = List(Text) + "strict <file or Type> [arguments]  run the program natively (built first when outdated); a type without Run runs its native tests, not again while they passed and nothing changed"
constant BuildHelp = ("strict build <file or Type>  compile a native executable without running tests (Name.test without Run)", "strict build [platform]    build the program named like this folder (in FractalZoomer/: FractalZoomer.strict)")
constant PlatformHelp = ("strict build <file> linux  also the Linux executable (on Windows through WSL)", "strict build <file> web  build Name.html, .js and .wasm for the browser (Emscripten in Tools/emsdk)")
constant AppHelp = ("strict build <file> android  build an arm64-v8a shared library and stage Release/Android (Android NDK)", "strict build <file> ios    build an arm64 iOS static archive and stage Release/iOS (native packages need Xcode)")
constant BuildModeHelp = ("strict build <file> library  build a shared library of its public methods and a C# binding", "strict build <file> fast   quick build for this computer, GPU loops run on the CPU (not for NeuralNetworks or games)")
constant TestHelp = ("strict test <file>         run the inline tests of every method on the Strict VM", "strict test <file> native  build and run its native tests explicitly")
constant TestInputHelp = ("strict test <folder> --no-recursive  test only files directly in folder", "strict test <file> -       test the source read from standard input as <file>, nothing is written")
constant LinesHelp = List(Text) + "strict test <file> lines   run them natively and print how often and how long each line ran (a folder: one build)"
constant ValuesHelp = List(Text) + "strict test <file> values  run them on the Strict VM and print how often each line ran and the value it set"
constant FullHelp = ("strict test <folder> full  remove its obj/ folders, then retest everything with Slow tests and all mutants", "strict build <file> full   remove the obj/ folders of its folder, then build everything again")
constant SourceHelp = ("strict check <folder>      validate the .strict files: type rules, unused members, limits", "strict format <file>       print the file in its canonical form, each method body as the parser reads it")
constant MaintenanceHelp = ("strict update <folder>     refresh the packages copied into the folder (.origin) from their clone or GitHub", "strict version             show the version number and when this strict executable was built")
constant SuggestHelp = List(Text) + "strict suggest <file> <method>  print bodies passing its tests; add - to read unsaved source"
constant Help = RunHelp + BuildHelp + PlatformHelp + AppHelp + BuildModeHelp + TestHelp + TestInputHelp + LinesHelp + ValuesHelp + FullHelp + SourceHelp + MaintenanceHelp + SuggestHelp
constant FirstTraceLines = 3
constant LastTraceLines = 3
constant LongTrace = "Error: A\n\t1\n\t2\n\t3\n\t4\n\t5\n\t6\n\tat Strict.Logged in Strict.strict:line 66"
Run(arguments Texts) Number
	let resident = Resident(Path(Process.Current.executable).PathOnly.text)
	let command = arguments.Length > 0 then arguments(0) else ""
	if command is "coordinator"
		mutable coordinator = Coordinator(logger)
		return coordinator.Served
	if command is in ("serve", "linked", "status")
		Hosted(command, arguments, resident)
		return 0
	let forwarded = Forwarding(logger, resident.root).Forwarded(arguments)
	forwarded >= 0 then forwarded else Logged(arguments).code
Hosted(command Text, arguments Texts, resident Resident)
	if command is "serve"
		return Served(arguments.Length > 1 then Resident(resident.root, arguments(1)) else resident)
	if command is "status"
		return Coordinator(logger).Reported
	let rest = arguments.Slice(1, arguments.Length - 1)
	NativeChunks(logger, rest(2)).Saved(rest(0), rest(1), rest.Slice(3, rest.Length - 3))
Served(resident Resident)
	let server = resident.Opened
	if server is 0
		return Error("ServerNotOpened")
	let built = File(Process.Current.executable).Modified
	mutable socket = resident.Accepted(server, built)
	mutable answer = Answer(0, Dictionary(Text, TypeEntry))
	for as long as socket > 0
		let request = resident.Requested(socket)
		let stopping = resident.Arguments(request) is (Resident.Stopping)
		answer = Replied(resident, request, socket, stopping, answer)
		socket = stopping then 0 else resident.Accepted(server, built)
	resident.Closed(server)
Replied(resident Resident, request Text, socket Number, isStopping Boolean, last Answer) Answer
	let started = Time.Now
	let isAnswered = resident.IsCurrent(request) and (isStopping is false)
	let answer = isAnswered then Answered(resident, request, socket, last).Stamped(started) else last
	resident.Released(request)
	resident.Ended(socket, isAnswered then answer.code else (isStopping then 0 else -1))
	answer
Answered(resident Resident, request Text, socket Number, last Answer) Answer
	let home = Directory.Current
	let folder = resident.Folder(request)
	let isMoved = folder is not home
	if isMoved
		Directory.Change(folder)
	Socket.Output(socket)
	let answer = Logged(resident.Arguments(request), last.Fresh(folder))
	Socket.Output(0)
	if isMoved
		Directory.Change(home)
	Answer(answer.code, answer.known, folder, answer.stamps, answer.files).Carried(last)
Logged(arguments Texts, known = Dictionary(Text, TypeEntry)) Answer
	let answer = Ran(arguments, known)
	if answer is Error
		logger.Log(Shortened(answer to Text))
		return Answer(1, known)
	answer
Shortened(trace Text) Text
	Strict.Shortened("Error: A\n\t1") is "Error: A\n\t1"
	Strict.Shortened(LongTrace) is "Error: A\n\t1\n\t2\n\t... (skipped 1 lines)\n\t4\n\t5\n\t6"
	let logged = trace.LastIndexOf("\n\tat Strict.Logged ")
	let lines = (logged < 0 then trace else trace.Substring(0, logged)).Split("\n")
	if lines.Length <= FirstTraceLines + LastTraceLines
		return Text.Combine(lines, "\n")
	let gap = "\t... (skipped " + (lines.Length - FirstTraceLines - LastTraceLines) + " lines)"
	Text.Combine(lines.Slice(0, FirstTraceLines) + gap + lines.Slice(lines.Length - LastTraceLines, LastTraceLines), "\n")
Ran(arguments Texts, known = Dictionary(Text, TypeEntry)) Answer
	let folder = Directory.Current
	let given = Projected(Mained(arguments))
	let command = given.Length > 0 then given(0) else "help"
	let rooted = Rooted(command is in Commands then Rest(given) else given)
	let rest = "full" is in rooted then Cleaned(command, rooted) else rooted
	let message = Message(command, rest)
	if message is not ""
		logger.Log(message)
		return Answer(command is in Informing then 0 else 2, known)
	if command is in ("build", "check", "update", "format", "suggest")
		return command is "build" then Answer(Native(command, rest), known) else Tool(command, rest, known)
	command is "test" then Tested(rest, known) else Answer(Launched(rest, folder), known)
Cleaned(command Text, rest Texts) Texts
	Strict(Logger).Cleaned("build", ("Compiler/output/Clean/A.strict", ".", "full")).Last is "."
	Strict(Logger).Cleaned("test", ("Compiler/output/Clean", ".", "full")).Last is "full"
	let folder = Directory.Exists(rest(0)) then rest(0) else Path(rest(0)).PathOnly.text
	let target = folder is "" then "." else folder
	logger.Log("Removed " + Folders(logger).Cleaned(target) + " files in the obj folders of " + target)
	command is "build" then rest - "full" else rest
Message(command Text, rest Texts) Text
	Strict.Message("version", List(Text)).StartsWith(Version + " 20")
	Strict.Message("help", List(Text)).StartsWith("strict <file or Type> [arguments]  run")
	Strict.Message("test", ("a.strict", ".")) is "a.strict not found"
	(Strict.Message("test", ("Compiler", ".")) is "") and (Strict.Message("check", ("Compiler", ".")) is "")
	Strict.Message("suggest", ("Strict.strict", ".")).StartsWith("strict <file or Type> [arguments]  run")
	constant DateAndMinuteLength = 16
	if command is in ("version", "--version")
		return Version + " " + Process.Current.Built.Substring(0, DateAndMinuteLength)
	if (command is in Informing) or (rest.Length < (command is "suggest" then 3 else 2))
		return Text.Combine(Help, "\n")
	let isFolder = (command is "test") and Directory.Exists(rest(0))
	(command is in ("check", "update")) or isFolder or File(rest(0)).Exists then "" else rest(0) + " not found"
Tested(rest Texts, known = Dictionary(Text, TypeEntry)) Answer
	Strict.Tested(("Missing.strict", ".")).code is 1
	let request = TestRequest(rest)
	if request.Message is not ""
		logger.Log(request.Message)
		return Answer(2, known)
	if request.Option is "-"
		File(FileCompiler.Normalized(rest(0))).InMemory(Process.Input)
	if request.Option is in ("values", "trace")
		return Answer(Traced(request, rest), known)
	let selection = request.Selection
	let execute = Execute(logger, selection, request.IsRecursive, request.IsMutating, request.Part, request.IsFull, known)
	request.Option is in ("lines", "native") then Answer(Native("test", rest), known) else execute.Served(rest(0), rest(1))
Traced(request TestRequest, rest Texts) Number
	let trace = ValueTrace(logger, request.Selection)
	request.Option is "values" then trace.Run(rest(0), rest(1)) else trace.Traced(rest(0), rest(1))
Rooted(arguments Texts) Texts
	Strict.Rooted(List(Text) + "a.strict") is ("a.strict", ".")
	Strict.Rooted(("a.strict", ".")) is ("a.strict", ".")
	Strict.Rooted(("a.strict", "Compiler")) is ("a.strict", ".", "Compiler")
	Strict.Rooted(("a.strict", "5")) is ("a.strict", ".", "5")
	if (arguments.Length is 0) or ((arguments.Length > 1) and File(arguments(1) + "/Any.strict").Exists)
		return arguments
	(List(Text) + arguments(0) + TypeSource.Root) + Rest(arguments)
Mained(arguments Texts) Texts
	Strict.Mained(("build", "web")) is ("build", "Strict.strict", "web")
	Strict.Mained(List(Text) + "build") is ("build", "Strict.strict")
	Strict.Mained(("build", "Examples/Sum.strict")) is ("build", "Examples/Sum.strict")
	Strict.Mained(("test", "Math")) is ("test", "Math")
	Strict(Logger).Projected(Strict.Mained(("build", "strict"))) is ("build", "Strict.strict")
	if (arguments.Length is 0) or (arguments(0) is not "build")
		return arguments
	let named = TypeSource.Cased(Path(Directory.Current.Replace("\\", "/")).FileName.text)
	let main = File(named).Exists then named else "Strict.strict"
	let given = arguments.Length > 1 then arguments(1) else ""
	let isSource = (given is not "") and (File(TypeSource.Cased(given)).Exists or Directory.Exists(given))
	isSource or (File(main).Exists is false) then arguments else (List(Text) + "build" + main) + Rest(arguments)
Projected(arguments Texts) Texts
	Strict(Logger).Projected(("test", "Examples/Sum.strict")) is ("test", "Examples/Sum.strict")
	Strict(Logger).Projected(("Examples/Sum", "5")) is ("Examples/Sum.strict", "5")
	Strict(Logger).Projected(("build", "Examples/Sum", "web")) is ("build", "Examples/Sum.strict", "web")
	let at = (arguments.Length > 0) and (arguments(0) is in Commands) then 1 else 0
	let source = TypeSource.Cased(arguments.Length > at then arguments(at) else "")
	let project = source.EndsWith(".strict") or Directory.Exists(source) then TypeSource.Project(source) else ""
	let full = TypeSource.Absolute(source)
	if project is not ""
		Directory.Change(project)
	for arguments
		index is at then (project is "" then source else TypeSource.Relative(full)) else value
Joined(arguments Texts) Text
	Strict.Joined(("a b", "c")) is " \"a b\" c"
	mutable joined = ""
	for arguments
		joined = joined + " " + (value.IndexOf(" ") >= 0 then "\"" + value + "\"" else value)
	joined
Launched(rest Texts, folder Text) Number
	if NativeBuild.IsProgram(rest(0)) is false
		return Native("test", (rest(0), rest(1), "native"))
	let tested = Execute(logger, "*").Served(rest(0), rest(1)).code
	if tested is not 0
		return tested
	let base = NativeBuild.Output(rest(0), true)
	let extension = Toolchain(Platform.Current, rest(1)).Extension
	let cache = NativeCache("build", (rest(0), rest(1)))
	Started(rest, folder, BuildOutput.Fresh(base, extension, cache.Inputs(cache.Files)))
Compiled(rest Texts, fresh Text) Number
	if fresh is not ""
		return 0
	NativeCache("build", (rest(0), rest(1))).IsCurrent then 0 else Native("build", (rest(0), rest(1)))
Started(rest Texts, folder Text, fresh Text) Number
	let base = NativeBuild.Output(rest(0), true)
	let tools = Toolchain(Platform.Current, rest(1))
	let built = Compiled(rest, fresh)
	if built is not 0
		return built
	if fresh is not ""
		logger.Log("Up to date: " + fresh)
	Directory.Change(folder)
	let program = fresh is "" then tools.Executable(base) else fresh
	Process(TypeSource.Absolute(program)).Started(Joined(rest.Slice(2, rest.Length - 2)).Trim)
Rest(arguments Texts) Texts
	Strict.Rest(("test", "a", "b")) is ("a", "b")
	for Range(1, arguments.Length)
		arguments(value)
Tool(command Text, rest Texts, known = Dictionary(Text, TypeEntry)) Answer
	if command is "format"
		logger.Log(Formatted(rest(0)))
	if command is "update"
		Updated(Repositories(logger, "."), rest(0))
	let checked = command is "check" then Checked(ValidateCheck(logger), rest(0), rest(1)) else 0
	Answer(command is "suggest" then Suggested(rest) else checked, known)
Checked(checker Validators/ValidateCheck, folder Text, root Text) Number
	checker.Run(folder, root)
Updated(updater Bytecode/Repositories, folder Text)
	logger.Log("Updated " + updater.Updated(folder) + " packages in " + folder)
Native(command Text, rest Texts) Number
	Strict(Logger).Native("test", ("Missing.strict", ".", "values", "other")) is 2
	NativeCompiler(logger).Ran((List(Text) + command) + rest)
Formatted(path Text) Slow(Text)
	Strict.Formatted("Examples/HelloLogger.strict").StartsWith("has logger")
	let lines = RoundTrip(logger).Tabbed(File(path).ReadLines)
	let broken = FileCompiler.Unparsable(lines)
	if broken >= 0
		return Error(FileCheck.Problem(lines, broken) + " in " + FileCompiler.Normalized(path) + ":" + (broken + 1))
	Text.Combine(RoundTrip(logger).Formatted(lines), "\n")
Suggested(rest Texts) Number
	let source = FileCompiler.Normalized(rest(0))
	if (rest.Length > 3) and (rest(3) is "-")
		File(source).InMemory(Process.Input)
	let files = SourceFiles(rest(1)).Of(source)
	Suggestions(source, rest(1), File(source).ReadLines, ResolveCheck.Inference(files)).Run(rest(2), files)