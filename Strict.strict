has logger
constant Version = "1.0"
constant Commands = ("build", "test", "check", "update", "format", "suggest")
constant MaxWait = 300
constant Informing = ("version", "--version", "help", "--help")
constant Help = ("strict <file or Type> [arguments]  run the program natively (built first when outdated); a type without Run runs its native tests, not again while they passed and nothing changed", "strict build <file or Type>  compile a native executable without running tests (Name.test without Run)", "strict build [platform]    build the program named like this folder (in FractalZoomer/: FractalZoomer.strict)", "strict build <file> linux  also the Linux executable (on Windows through WSL)", "strict build <file> web  build Name.html, .js and .wasm for the browser (Emscripten in Tools/emsdk)", "strict build <file> android  build an arm64-v8a shared library and stage Release/Android (Android NDK)", "strict build <file> ios    build an arm64 iOS static archive and stage Release/iOS (native packages need Xcode)", "strict build <file> library  build a shared library of its public methods and a C# binding", "strict build <file> fast   quick build for this computer, GPU loops run on the CPU (not for NeuralNetworks or games)", "strict test <file>         run the inline tests of every method on the Strict VM", "strict test <file> native  build and run its native tests explicitly", "strict test <folder> --no-recursive  test only files directly in folder", "strict test <file> -       test the source read from standard input as <file>, nothing is written", "strict test <file> lines   run them natively and print how often and how long each line ran (a folder: one build)", "strict test <file> values  run them on the Strict VM and print how often each line ran and the value it set", "strict test <folder> full  remove its obj/ folders, then retest everything with Slow tests and all mutants", "strict build <file> full   remove the obj/ folders of its folder, then build everything again", "strict check <folder>      validate the .strict files: type rules, unused members, limits", "strict format <file>       print the file in its canonical form, each method body as the parser reads it", "strict update <folder>     refresh the packages copied into the folder (.origin) from their clone or GitHub", "strict version             show the version number and when this strict executable was built", "strict suggest <file> <method>  print bodies passing its tests; add - to read unsaved source")
Run(arguments Texts) Number
	let folder = Directory.Current
	let given = Projected(Mained(arguments))
	let command = given.Length > 0 then given(0) else "help"
	let rooted = Rooted(command is in Commands then Rest(given) else given)
	let rest = "full" is in rooted then Cleaned(command, rooted) else rooted
	let message = Message(command, rest)
	if message is not ""
		logger.Log(message)
		return command is in Informing then 0 else 2
	if command is in ("check", "update", "format", "suggest")
		return Tool(command, rest)
	command is "test" then Tested(rest) else (command is "build" then Native(command, rest) else Launched(rest, folder))
Cleaned(command Text, rest Texts) Texts
	Strict(Logger).Cleaned("build", ("Compiler/output/Clean/A.strict", ".", "full")).Last is "."
	Strict(Logger).Cleaned("test", ("Compiler/output/Clean", ".", "full")).Last is "full"
	let folder = Directory.Exists(rest(0)) then rest(0) else Path(rest(0)).PathOnly.text
	let target = folder is "" then "." else folder
	logger.Log("Removed " + Folders(logger).Cleaned(target) + " files in the obj folders of " + target)
	command is "build" then rest - "full" else rest
Message(command Text, rest Texts) Text
	Strict.Message("version", List(Text)).StartsWith(Version + " 20")
	Strict.Message("help", List(Text)).StartsWith("strict <file or Type> [arguments]  run")
	Strict.Message("test", ("a.strict", ".")) is "a.strict not found"
	Strict.Message("test", ("Compiler", ".")) is ""
	Strict.Message("check", ("Compiler", ".")) is ""
	constant DateAndMinuteLength = 16
	if command is in ("version", "--version")
		return Version + " " + Process.Current.Built.Substring(0, DateAndMinuteLength)
	if (command is in Informing) or (rest.Length < 2)
		return Text.Combine(Help, "\n")
	let isFolder = (command is "test") and Directory.Exists(rest(0))
	(command is in ("check", "update")) or isFolder or File(rest(0)).Exists then "" else rest(0) + " not found"
Tested(rest Texts) Number
	Strict.Tested(("Missing.strict", ".")) is 1
	let request = TestRequest(rest)
	if request.Message is not ""
		logger.Log(request.Message)
		return 2
	if request.Option is "-"
		File(FileCompiler.Normalized(rest(0))).InMemory(Process.Input)
	if request.Option is in ("values", "trace")
		let trace = ValueTrace(logger, request.Selection)
		return request.Option is "values" then trace.Run(rest(0), rest(1)) else trace.Traced(rest(0), rest(1))
	let execute = Execute(logger, request.Selection, request.IsRecursive, request.IsMutating, request.Part, request.IsFull)
	request.Option is in ("lines", "native") then Native("test", rest) else execute.Test(rest(0), rest(1))
Rooted(arguments Texts) Texts
	Strict.Rooted(List(Text) + "a.strict") is ("a.strict", ".")
	Strict.Rooted(("a.strict", ".")) is ("a.strict", ".")
	Strict.Rooted(("a.strict", "Compiler")) is ("a.strict", ".", "Compiler")
	Strict.Rooted(("a.strict", "5")) is ("a.strict", ".", "5")
	if (arguments.Length is 0) or ((arguments.Length > 1) and File(arguments(1) + "/Any.strict").Exists)
		return arguments
	(List(Text) + arguments(0) + TypeSource.Root) + Rest(arguments)
Mained(arguments Texts) Texts
	Strict.Mained(("build", "web")) is ("build", "Strict.strict", "web")
	Strict.Mained(List(Text) + "build") is ("build", "Strict.strict")
	Strict.Mained(("build", "Examples/Sum.strict")) is ("build", "Examples/Sum.strict")
	Strict.Mained(("test", "Math")) is ("test", "Math")
	if (arguments.Length is 0) or (arguments(0) is not "build")
		return arguments
	let main = Path(Directory.Current.Replace("\\", "/")).FileName.text + ".strict"
	let given = arguments.Length > 1 then arguments(1) else ""
	let isSource = (given is not "") and (File(given).Exists or File(given + ".strict").Exists or Directory.Exists(given))
	isSource or (File(main).Exists is false) then arguments else (List(Text) + "build" + main) + Rest(arguments)
Projected(arguments Texts) Texts
	Strict(Logger).Projected(("test", "Examples/Sum.strict")) is ("test", "Examples/Sum.strict")
	Strict(Logger).Projected(("Examples/Sum", "5")) is ("Examples/Sum.strict", "5")
	Strict(Logger).Projected(("build", "Examples/Sum", "web")) is ("build", "Examples/Sum.strict", "web")
	let at = (arguments.Length > 0) and (arguments(0) is in Commands) then 1 else 0
	let named = arguments.Length > at then arguments(at) else ""
	let source = File(named + ".strict").Exists then named + ".strict" else named
	let project = source.EndsWith(".strict") then TypeSource.Project(source) else ""
	let full = TypeSource.Absolute(source)
	let isMoved = (project is not "") and Directory.Change(project)
	for arguments
		index is at then (isMoved then TypeSource.Relative(full) else source) else value
Joined(arguments Texts) Text
	Strict.Joined(("a b", "c")) is " \"a b\" c"
	mutable joined = ""
	for arguments
		joined = joined + " " + (value.IndexOf(" ") >= 0 then "\"" + value + "\"" else value)
	joined
Launched(rest Texts, folder Text) Number
	if NativeBuild.IsProgram(rest(0)) is false
		return Native("test", (rest(0), rest(1), "native"))
	let built = Native("build", (rest(0), rest(1)))
	let program = TypeSource.Absolute(Toolchain(Platform.Current, rest(1)).Executable(NativeBuild.Output(rest(0), true)))
	if built is not 0
		return built
	Directory.Change(folder)
	Process(program).Started(Joined(rest.Slice(2, rest.Length - 2)).Trim)
Rest(arguments Texts) Texts
	Strict.Rest(("test", "a", "b")) is ("a", "b")
	for Range(1, arguments.Length)
		arguments(value)
Tool(command Text, rest Texts) Number
	if command is "suggest"
		return Suggested(rest)
	if command is "format"
		return Format(rest(0))
	let updater = Repositories(logger, ".")
	command is "check" then Checked(ValidateCheck(logger), rest(0), rest(1)) else Updated(updater, rest(0))
Checked(checker Validators/ValidateCheck, folder Text, root Text) Number
	checker.Run(folder, root)
Updated(updater Bytecode/Repositories, folder Text) Number
	logger.Log("Updated " + updater.Updated(folder) + " packages in " + folder)
	0
Native(command Text, rest Texts, compiler = "") Number
	Strict(Logger).Native("test", List(Text), "Missing.exe") is 2
	let path = compiler is "" then NativeCompiler.Executable(TypeSource.Root) else compiler
	if File(path).Exists is false
		logger.Log(path + " not found, build it with Compiler/Bootstrap.cmd or sh Compiler/bootstrap.sh")
		return 2
	let refreshed = compiler is "" then Refreshed(path, rest) else 0
	refreshed is not 0 then refreshed else Started(command, rest, path)
Started(command Text, rest Texts, path Text) Number
	let cache = NativeCache(command, rest)
	if BuildProfile(logger).Current(cache, "CLI build cache")
		logger.Log(cache.Message)
		return 0
	Process(path).Started(NativeCompiler.Arguments(command, rest))
Refreshed(compiler Text, rest Texts) Number
	Strict(Logger).Refreshed("Missing.exe", ("Compiler/NativeCompiler.strict", ".")) is 0
	if rest(0).Replace("\\", "/").EndsWith("Compiler/NativeCompiler.strict") or IsCompiled(compiler, TypeSource.Root)
		return 0
	let lock = Path(compiler).RemoveExtension.text + ".building"
	Directory.Create(lock) is false then Waited(compiler, lock) else Rebuilt(compiler, lock)
Rebuilt(compiler Text, lock Text) Number
	let source = TypeSource.Root + "/Compiler/NativeCompiler.strict"
	logger.Log(compiler + " is older than the compiler sources, building it again first")
	let built = Process(compiler).Started(NativeCompiler.Arguments("build", (source, TypeSource.Root)))
	if built is 0
		File(Checked(compiler)).Write("built from the compiler sources newer than " + compiler)
	Directory.Delete(lock)
	built
Waited(compiler Text, lock Text) Slow(Number)
	Strict(Logger).Waited("Missing.exe", "Missing.building") is 1
	let started = Process.Elapsed
	for as long as Directory.Exists(lock) and (Process.Elapsed - started < MaxWait)
		Process.Wait(0.1)
	if IsCompiled(compiler, TypeSource.Root)
		return 0
	logger.Log(compiler + " was not built by the other strict (" + lock + "), remove it if no build is running")
	1
Checked(compiler Text) Text
	Strict.Checked("Compiler/NativeCompiler.exe") is "Compiler/NativeCompiler.checked"
	Path(compiler).RemoveExtension.text + ".checked"
CompilerSources(root Text) Slow(Texts)
	Strict.CompilerSources(".").Length > 100
	"./Compiler/NativeRuntime.mlir" is in Strict.CompilerSources(".")
	"./Bytecode/TestCodegen.strict" is in Strict.CompilerSources(".")
	Strict.CompilerSources(".").Index("./Compiler/NativeCompiler.mlir") is -1
	mutable sources = List(Text)
	for ("Compiler", "Bytecode", "Expressions")
		sources = sources + Directory.Files(root + "/" + value, "*.strict")
	for Directory.Files(root + "/Compiler", "*.mlir")
		if Path(value).FileName.text.StartsWith("NativeRuntime")
			sources = sources + value
	sources
IsCompiled(compiler Text, root Text) Boolean
	Strict.IsCompiled("Missing.exe", ".") is false
	let sources = CompilerSources(root)
	let builds = NativeSources(List(Text))
	builds.IsCurrent(compiler, sources) or builds.IsCurrent(Checked(compiler), sources)
Format(path Text) Slow(Number)
	Strict.Format("Examples/HelloLogger.strict") is 0
	let lines = RoundTrip(logger).Tabbed(File(path).ReadLines)
	let broken = FileCompiler.Unparsable(lines)
	if broken >= 0
		logger.Log(FileCheck.Problem(lines, broken) + " in " + FileCompiler.Normalized(path) + ":" + (broken + 1))
		return 1
	logger.Log(Text.Combine(RoundTrip(logger).Formatted(lines), "\n"))
	0
Suggested(rest Texts) Number
	if rest.Length < 3
		return 2
	let source = FileCompiler.Normalized(rest(0))
	if (rest.Length > 3) and (rest(3) is "-")
		File(source).InMemory(Process.Input)
	let files = SourceFiles(rest(1)).Of(source)
	Suggestions(source, rest(1), File(source).ReadLines, ResolveCheck.Inference(files)).Run(rest(2), files)