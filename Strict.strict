has logger
constant Version = "1.0"
constant Commands = ("build", "test", "check", "run")
constant Informing = ("version", "--version", "help", "--help")
constant Help = ("Usage: strict [command] <file or folder> [root folder, default .] [arguments]", "  build    compile a .strict file into a native executable, the default without a command", "  test     compile the inline tests of a .strict file into an executable and run them", "  check    validate the .strict files of a folder: type rules, unused members, limits", "  run      run the Run method of a .strict file on the Strict VM, run test runs its tests there", "  version  show the Strict version and when this strict was built", "  help     show this help")
Run(arguments Texts) Number
	let command = arguments.Length > 0 then arguments(0) else "help"
	let rest = Rooted(command is in Commands then Rest(arguments) else arguments)
	if (command is in Informing) or (rest.Length < 2)
		return Informed(command)
	if command is "test"
		return Test(rest(0), rest(1))
	if command is "check"
		return Checked(ValidateCheck(logger), rest(0), rest(1))
	command is "run" then Execute(logger).Run(rest) else Compiling(rest)
Informed(command Text) Number
	Strict(Logger).Informed("version") is 0
	Strict(Logger).Informed("help") is 0
	Strict(Logger).Informed("test") is 2
	let isVersion = command is in ("version", "--version")
	logger.Log(isVersion then "strict version " + Version + " " + Process.Current.Built else Text.Combine(Help, "\n"))
	isVersion or (command is in ("help", "--help")) then 0 else 2
Rooted(arguments Texts) Texts
	Strict.Rooted(List(Text) + "a.strict") is ("a.strict", ".")
	Strict.Rooted(("a.strict", "b")) is ("a.strict", "b")
	Strict.Rooted(("test", "a.strict")) is ("test", "a.strict", ".")
	let isTest = (arguments.Length is 2) and (arguments(0) is "test")
	(arguments.Length is 1) or isTest then arguments + "." else arguments
Checked(checker Validators/ValidateCheck, folder Text, root Text) Number
	Strict.Checked(ValidateCheck(Logger), "Compiler/output", ".") is 0
	checker.Run(folder, root)
Rest(arguments Texts) Texts
	Strict.Rest(("test", "a", "b")) is ("a", "b")
	for Range(1, arguments.Length)
		arguments(value)
Compiling(arguments Texts) Number
	Strict.Compiling(("Compiler/output/missing.strict")) is 2
	if arguments.Length < 2
		return 2
	Compile(arguments(0), arguments(1))
	0
Test(path Text, root Text) Number
	let program = MlirModule(FileCompiler(logger).Compiled(path, root, true), TestCodegen.Runner).Text
	let unsupported = Unsupported(program)
	if unsupported is not -1
		logger.Log("Tests of " + path + " not compiled, " + program.Substring(unsupported, program.Length - unsupported))
		return 1
	let base = Base(path, root) + ".test"
	File(base + ".mlir").Write(Mlir(program, root, Platform.Current))
	let built = Toolchain(Platform.Current, root).Built(base)
	if built.StartsWith("Built ") is false
		logger.Log(built)
		return 1
	Tested(Toolchain(Platform.Current, root).Executable(base), path)
Tested(executable Text, path Text) Number
	Strict.Tested("Compiler/output/missing.exe", "a") is 127
	let result = ToolRunner(executable).Execute("")
	logger.Log(result.Output + Summary(result.exitCode, path) + (result.error is "" then "" else " " + result.error))
	IsCrash(result.exitCode) then 128 else result.exitCode
Summary(code Number, path Text) Text
	Strict.Summary(0, "a") is "All tests passed in a"
	Strict.Summary(2, "a") is "2 failed in a"
	Strict.Summary(139, "a") is "Tests crashed with exit code 139 in a"
	if code is 0
		return "All tests passed in " + path
	IsCrash(code) then "Tests crashed with exit code " + code + " in " + path else code to Text + " failed in " + path
IsCrash(code Number) Boolean
	Strict.IsCrash(139) is true
	Strict.IsCrash(127) is false
	(code > 128) or (code < 0)
Compile(path Text, root Text)
	let program = MlirModule(FileCompiler(logger).Compiled(path, root, false), "Run").Text
	let unsupported = Unsupported(program)
	let tools = Toolchain(Platform.Current, root)
	let missing = tools.Missing(Toolchain.Needed)
	if unsupported is not -1
		logger.Log("Native compilation failed, " + program.Substring(unsupported, program.Length - unsupported))
	else if missing.Length > 0
		logger.Log(tools.Installing(missing))
	else
		Build(Base(path, root), program, tools)
Build(base Text, program Text, tools Compiler/Toolchain)
	File(base + ".mlir").Write(Mlir(program, tools.root, Platform.Current))
	logger.Log(tools.Built(base))
	if Platform.Current is Platform.Windows
		File(base + ".linux.mlir").Write(Mlir(program, tools.root, Platform.Linux))
		logger.Log(tools.CrossBuilt(base))
Base(path Text, root Text) Text
	Strict.Base("Character.strict", ".") is "./Character"
	Strict.Base("C:/s/A.strict", "C:/s") is "C:/s/A"
	let source = FileCompiler.Normalized(path, root)
	source.Substring(0, source.Length - 7)
Mlir(program Text, root Text, platform Number) Text
	Strict.Mlir("module {\n}", ".", Platform.Linux).Length > 100000 is true
	let runtime = Text.Combine(File(root + "/Compiler/NativeRuntime.mlir").ReadLines, "\n")
	let system = File(root + "/Compiler/NativeRuntime" + Platform.NameOf(platform) + ".mlir").ReadLines
	program.Substring(0, program.Length - 1) + runtime + "\n" + Text.Combine(system, "\n") + "\n}"
Unsupported(mlir Text) Number
	Strict.Unsupported("a\nunsupported: x") is 2
	Strict.Unsupported("unsupported: x") is 0
	Strict.Unsupported("@c(\"unsupported: x\")") is -1
	("\n" + mlir).IndexOf("\nunsupported:")