constant Version = "1.0"
constant Commands = ("build", "test", "check", "update", "format", "suggest")
constant BuildWait = 90
constant QuietSeconds = 5
constant Informing = ("version", "--version", "help", "--help")
constant RunHelp = List(Text) + "strict <file or Type> [arguments]  run the program natively (built first when outdated); a type without Run runs its native tests, not again while they passed and nothing changed"
constant CodeHelp = ("strict run -c <code> [arguments]  run these lines on the Strict VM (short: strict -c <code>)", "strict run <file.strict> [args]   run a single .strict script file on the Strict VM")
constant BuildHelp = ("strict build <file or Type>  compile a native executable without running tests (Name.test without Run)", "strict build [platform]    build the program named like this folder (in FractalZoomer/: FractalZoomer.strict)")
constant PlatformHelp = ("strict build <file> linux  also the Linux executable (on Windows through WSL)", "strict build <file> web  build Name.html, .js and .wasm for the browser (Emscripten in Tools/emsdk)")
constant AppHelp = ("strict build <file> android  build an arm64-v8a shared library and stage Release/Android (Android NDK)", "strict build <file> ios    build an arm64 iOS static archive and stage Release/iOS (native packages need Xcode)")
constant BuildModeHelp = ("strict build <file> library  build a shared library of its public methods and a C# binding", "strict build <file> fast   quick build for this computer, GPU loops run on the CPU (not for NeuralNetworks or games)")
constant TestHelp = ("strict test <file>         run the inline tests of every method on the Strict VM", "strict test <file> native  build and run its native tests explicitly")
constant TestInputHelp = ("strict test <folder> --no-recursive  test only files directly in folder", "strict test <file> -       test the source read from standard input as <file>, nothing is written")
constant LinesHelp = List(Text) + "strict test <file> lines   run them natively and print how often and how long each line ran (a folder: one build)"
constant ValuesHelp = List(Text) + "strict test <file> values  run them on the Strict VM and print how often each line ran and the value it set"
constant FullHelp = ("strict test <folder> full  remove its obj/ folders, then retest everything with Slow tests and all mutants", "strict build <file> full   remove the obj/ folders of its folder, then build everything again")
constant SourceHelp = ("strict check <folder>      validate the .strict files: type rules, unused members, limits", "strict format <file>       print the file in its canonical form, each method body as the parser reads it")
constant MaintenanceHelp = ("strict update <folder>     refresh the packages copied into the folder (.origin) from their clone or GitHub", "strict version             show the version number and when this strict executable was built")
constant SuggestHelp = List(Text) + "strict suggest <file> <method>  print bodies passing its tests; add - to read unsaved source"
constant Help = RunHelp + CodeHelp + BuildHelp + PlatformHelp + AppHelp + BuildModeHelp + TestHelp + TestInputHelp + LinesHelp + ValuesHelp + FullHelp + SourceHelp + MaintenanceHelp + SuggestHelp
constant FirstTraceLines = 3
constant LastTraceLines = 3
constant LongTrace = "Error: A\n\t1\n\t2\n\t3\n\t4\n\t5\n\t6\n\tat Strict.Logged in Strict.strict:line 66"
Run(arguments Texts) Number
	resident = Resident(Path(Process.Current.executable).PathOnly.text)
	command = arguments.Length > 0 then arguments(0) else ""
	if command is in ("coordinator", "serve", "linked", "status")
		Hosted(command, arguments, resident)
		return 0
	rebuilt = SelfBuild(resident.root, Process.Current.executable).Rebuilt(arguments)
	if rebuilt is not SelfBuild.Current
		return rebuilt
	passed = CommandLimit(Scripted.Packed(arguments)).Armed
	forwarded = Forwarding(resident.root).Forwarded(passed)
	forwarded is Forwarding.Ended then 1 else forwarded is Error then Logged(passed).code else forwarded
Hosted(command Text, arguments Texts, resident Resident) slow
	if command is "coordinator"
		mutable coordinator = Coordinator
		return coordinator.Served
	if command is "serve"
		return Served(arguments.Length > 1 then Resident(resident.root, arguments(1)) else resident)
	if command is "status"
		return Coordinator.Reported
	rest = arguments.Slice(1, arguments.Length - 1)
	NativeChunks(rest(2)).Saved(rest(0), rest(1), rest.Slice(3, rest.Length - 3))
Served(resident Resident) slow
	server = resident.Opened
	if server is Error
		return server
	built = File(Process.Current.executable).Modified
	mutable socket = resident.Accepted(server, built)
	mutable answer = Answer(0, Dictionary(Text, TypeEntry))
	for as long as socket is not Error
		request = resident.Requested(socket)
		arguments = resident.Arguments(request)
		answer = Replied(resident, request, socket, arguments, Resident.Variables, answer)
		socket = arguments is (Resident.Stopping) then Resident.Unaccepted else resident.Accepted(server, built)
	resident.Closed(server)
Replied(resident Resident, request Text, socket Number, arguments Texts, variables Text, last Answer) Answer slow
	isStopping = arguments is (Resident.Stopping)
	isAnswered = isStopping is false and resident.IsCurrent(request, variables)
	started = isAnswered and Scripted.IsRun(arguments) is false then Time.Now else 0
	answer = isAnswered then Answered(resident, request, socket, arguments, last) else last
	stamped = isAnswered and started > 0 then answer.Stamped(started) else answer
	resident.Released(request)
	code = isAnswered then stamped.code else (isStopping then 0 else Resident.Refused)
	logger.Log(Time(Time.Now).Iso8601 + " " + Text.Combine(arguments, " ") + " exit " + code)
	resident.Ended(socket, code)
	stamped
Answered(resident Resident, request Text, socket Number, arguments Texts, last Answer) Answer slow
	home = Directory.Current
	folder = resident.Folder(request)
	isMoved = folder is not home
	if isMoved
		Directory.Change(folder)
	Socket.Output(socket)
	isCode = Scripted.IsRun(arguments)
	answer = Logged(CommandLimit(arguments).Armed, isCode then last else Answer(last, known = last.Fresh(folder)))
	TestBudget.Limited(0, "")
	Socket.Output(0)
	if isMoved
		Directory.Change(home)
	isCode then answer else Answer(answer, folder = folder).Carried(last)
Logged(arguments Texts, last = Answer(0, Dictionary(Text, TypeEntry))) Answer slow
	answer = Scripted.IsRun(arguments) then Coded(arguments, last) else Ran(arguments, last.known, last.inferred)
	if answer is Error
		logger.Log(Shortened(answer to Text))
		return Answer(1, last.known, last.folder, last.stamps, last.files, last.Types, last.script)
	answer
Coded(arguments Texts, last Answer) Answer slow
	if Scripted.IsCode(arguments)
		return Scripted(arguments(2)).RanWith(arguments, TypeSource.Root, last)
	given = arguments(1)
	path = File(given).Exists then given else TypeSource.Cased(given)
	if File(path).Exists is false
		logger.Log(given + " not found")
		return Answer(2, last.known, last.folder, last.stamps, last.files, last.Types, last.script)
	Scripted(File(path).ReadText).RanWith(arguments, TypeSource.Root, last, path)
Shortened(trace Text) Text
	Strict.Shortened("Error: A\n\t1") is "Error: A\n\t1"
	Strict.Shortened(LongTrace) is "Error: A\n\t1\n\t2\n\t... (skipped 1 lines)\n\t4\n\t5\n\t6"
	logged = trace.LastIndexOf("\n\tat Strict.Logged ")
	lines = (logged < 0 then trace else trace.Substring(0, logged)).Split("\n")
	if lines.Length <= FirstTraceLines + LastTraceLines
		return Text.Combine(lines, "\n")
	gap = "\t... (skipped " + (lines.Length - FirstTraceLines - LastTraceLines) + " lines)"
	Text.Combine(lines.Slice(0, FirstTraceLines) + gap + lines.Slice(lines.Length - LastTraceLines, LastTraceLines), "\n")
Ran(arguments Texts, known = Dictionary(Text, TypeEntry), inferred = InferenceCache.None) Answer slow
	folder = Directory.Current
	head = arguments.Length > 0 then arguments(0) else ""
	given = head is in Informing then List(Text) + head else Projected(Mained(arguments))
	command = given.Length > 0 then given(0) else "help"
	rest = Cleaned(command, Rooted(command is in Commands then Rest(given) else given))
	message = Message(command, rest)
	if message is not ""
		logger.Log(message)
		return Answer(command is in Informing then 0 else 2, known)
	if command is in ("build", "check", "update", "format", "suggest")
		return command is "build" then Answer(Native(command, rest), known) else Tool(command, rest, known)
	command is "test" then Examined(rest, known, inferred) else Answer(Launched(rest, folder), known)
Cleaned(command Text, rest Texts) Texts slow
	Strict.Cleaned("build", ("Compiler/output/Clean/A.strict", ".", "full")).Last is "."
	Strict.Cleaned("test", ("Compiler/output/Clean", ".", "full")).Last is "full"
	if "full" is not in rest
		return rest
	folder = Directory.Exists(rest(0)) then rest(0) else Path(rest(0)).PathOnly.text
	target = folder is "" then "." else folder
	logger.Log("Removed " + Folders.Cleaned(target) + " files in the obj folders of " + target)
	command is "build" then rest - "full" else rest
Message(command Text, rest Texts) Text slow
	Strict.Message("version", List(Text)).StartsWith(Version + " 20")
	Strict.Message("help", List(Text)).StartsWith("strict <file or Type> [arguments]  run")
	Strict.Message("test", ("a.strict", ".")) is "a.strict not found"
	Strict.Message("test", ("Compiler", ".")) is "" and Strict.Message("check", ("Compiler", ".")) is ""
	Strict.Message("suggest", ("Strict.strict", ".")).StartsWith("strict <file or Type> [arguments]  run")
	constant DateAndMinuteLength = 16
	if command is in ("version", "--version")
		return Version + " " + Process.Current.Built.Substring(0, DateAndMinuteLength)
	if command is in Informing or rest.Length < (command is "suggest" then 3 else 2)
		return Text.Combine(Help, "\n")
	isFolder = command is "test" and Directory.Exists(rest(0))
	command is in ("check", "update") or isFolder or File(rest(0)).Exists then "" else rest(0) + " not found"
Examined(rest Texts, known Dictionary(Text, TypeEntry), inferred InferenceCache) Answer slow
	"nightly" is in rest then Answer(Nightly(rest), known) else Testing(rest, known, inferred)
Nightly(rest Texts) Number slow
	if File(rest(0)).Exists is false
		return Folders.Nightly(rest(0), rest(1)) + Native("test", (rest(0), rest(1), "native"))
	unit = Execute.Served(rest(0), rest(1), true).code
	unit > 0 then unit else Execute("*").Served(rest(0), rest(1), true).code
Testing(rest Texts, known = Dictionary(Text, TypeEntry), inferred = InferenceCache.None) Answer slow
	Strict.Testing(("Missing.strict", ".")).code is 1
	request = TestRequest(rest)
	if request.Message is not ""
		logger.Log(request.Message)
		return Answer(2, known)
	if request.Option is "-"
		File(FileCompiler.Normalized(rest(0))).InMemory(Process.Input)
	if request.Option is in ("values", "trace", "profile", "sampled")
		return Answer(Traced(request, rest), known)
	execute = request.Executing(known, inferred)
	request.Option is in ("lines", "native") then Answer(Native("test", rest), known) else execute.Served(rest(0), rest(1))
Test(text Text) Text slow
	Trial(text).Tested
Traced(request TestRequest, rest Texts) Number slow
	trace = ValueTrace(request.Selection)
	profile = Profile(request.Selection)
	if request.Option is in ("profile", "sampled")
		return request.Option is "profile" then profile.Run(rest(0), rest(1)) else profile.Sampled(rest(0), rest(1))
	request.Option is "values" then trace.Run(rest(0), rest(1)) else trace.Traced(rest(0), rest(1))
Rooted(arguments Texts) Texts slow
	Strict.Rooted(List(Text) + "a.strict") is ("a.strict", ".")
	Strict.Rooted(("a.strict", ".")) is ("a.strict", ".")
	Strict.Rooted(("a.strict", "Compiler")) is ("a.strict", ".", "Compiler")
	Strict.Rooted(("a.strict", "5")) is ("a.strict", ".", "5")
	if arguments.Length is 0 or arguments.Length > 1 and File(arguments(1) + "/Any.strict").Exists
		return arguments
	(List(Text) + arguments(0) + TypeSource.Root) + Rest(arguments)
Main(folder Text) Text slow
	Strict.Main(".") is "Strict.strict"
	Strict.Main("Missing") is ""
	isCurrent = folder is "" or folder is "."
	target = (isCurrent then Directory.Current else folder).Replace("\\", "/")
	clean = target.EndsWith("/") and target.Length > 1 then target.Substring(0, target.Length - 1) else target
	named = TypeSource.Cased((isCurrent then "" else clean + "/") + Path(clean).FileName.text)
	if File(named).Exists
		return named
	files = Directory.Files(isCurrent then "." else clean, "*.strict")
	isCurrent and File("Strict.strict").Exists then "Strict.strict" else (files.Length is 1 then files.First else "")
Mained(arguments Texts) Texts slow
	Strict.Mained(("build", "web")) is ("build", "Strict.strict", "web")
	Strict.Mained(List(Text) + "build") is ("build", "Strict.strict")
	Strict.Mained(("build", ".", "windows")) is ("build", "Strict.strict", "windows")
	Strict.Mained(("build", "Examples/Sum.strict")) is ("build", "Examples/Sum.strict")
	Strict.Mained(("test", "Math")) is ("test", "Math")
	Strict.Mained(("test", "native")) is ("test", "Strict.strict", "native")
	Strict.Projected(Strict.Mained(("build", "strict"))) is ("build", "Strict.strict")
	main = Main(".")
	if arguments.Length is 0
		return main is "" or main is "Strict.strict" then arguments else List(Text) + main
	arguments(0) is in ("build", "test") then Resolved(arguments, main) else arguments
Resolved(arguments Texts, main Text) Texts slow
	Strict.Resolved(("build", "."), "Strict.strict") is ("build", "Strict.strict")
	Strict.Resolved(("test", "."), "Strict.strict") is ("test", ".")
	Strict.Resolved(List(Text) + "test", "Strict.strict") is ("test", "Strict.strict")
	given = arguments.Length > 1 then arguments(1) else ""
	if arguments(0) is "build" and (given is "." or Directory.Exists(given))
		folder = Main(given)
		return folder is "" then arguments else List(Text) + "build" + folder + arguments.Slice(2, arguments.Length - 2)
	isSource = given is not "" and (File(TypeSource.Cased(given)).Exists or Directory.Exists(given))
	target = arguments(0) is "test" and main is "" then "." else main
	isSource or target is "" then arguments else List(Text) + arguments(0) + target + Rest(arguments)
Projected(arguments Texts) Texts slow
	Strict.Projected(("test", "Examples/Sum.strict")) is ("test", "Examples/Sum.strict")
	Strict.Projected(("Examples/Sum", "5")) is ("Examples/Sum.strict", "5")
	Strict.Projected(("build", "Examples/Sum", "web")) is ("build", "Examples/Sum.strict", "web")
	at = arguments.Length > 0 and arguments(0) is in Commands then 1 else 0
	source = TypeSource.Cased(arguments.Length > at then arguments(at) else "")
	project = source.EndsWith(".strict") or Directory.Exists(source) then TypeSource.Project(source) else ""
	full = TypeSource.Absolute(source)
	if project is not ""
		Directory.Change(project)
	for arguments
		index is at then (project is "" then source else TypeSource.Relative(full)) else value
Joined(arguments Texts) Text
	Strict.Joined(("a b", "c")) is " \"a b\" c"
	mutable joined = ""
	for arguments
		joined = joined + " " + (value.IndexOf(" ") >= 0 then "\"" + value + "\"" else value)
	joined
Launched(rest Texts, folder Text) Number slow
	if NativeBuild.IsProgram(rest(0)) is false
		return Native("test", (rest(0), rest(1), "native"))
	base = NativeBuild.Output(rest(0), true)
	extension = Toolchain(Platform.Current, rest(1)).Extension
	cache = NativeCache("build", (rest(0), rest(1)))
	fresh = cache.IsCurrent then BuildOutput.Fresh(base, extension, List(Text)) else ""
	if fresh is ""
		tested = Retested(rest)
		if tested is not 0
			return tested
	Started(rest, folder, fresh)
Retested(rest Texts) Number slow
	quietUntil = Process.Elapsed + QuietSeconds
	tested = Execute("", quietUntil = quietUntil).Served(rest(0), rest(1)).code
	if tested is 0 and Process.Elapsed >= quietUntil
		logger.Log(Execute.Summary(0, rest(0)))
	tested
Compiled(rest Texts, fresh Text) Number slow
	if fresh is not ""
		return 0
	NativeCache("build", (rest(0), rest(1))).IsCurrent then 0 else Native("build", (rest(0), rest(1)))
Started(rest Texts, folder Text, fresh Text) Number slow
	base = NativeBuild.Output(rest(0), true)
	tools = Toolchain(Platform.Current, rest(1))
	built = Compiled(rest, fresh)
	if built is not 0
		return built
	if fresh is not ""
		logger.Log("Up to date: " + fresh)
	target = TypeSource.Absolute(fresh is "" then tools.Executable(base) else fresh)
	Directory.Change(folder)
	Process(target).Started(Joined(rest.Slice(2, rest.Length - 2)).Trim)
Rest(arguments Texts) Texts
	Strict.Rest(("test", "a", "b")) is ("a", "b")
	for Range(1, arguments.Length)
		arguments(value)
Tool(command Text, rest Texts, known = Dictionary(Text, TypeEntry)) Answer slow
	if command is "format"
		logger.Log(Formatted(rest(0)))
	if command is "update"
		Updated(Repositories("."), rest(0))
	checked = command is "check" then Checked(ValidateCheck, rest(0), rest(1)) else 0
	Answer(command is "suggest" then Suggested(rest) else checked, known)
Checked(checker Validators/ValidateCheck, folder Text, root Text) Number slow
	checker.Run(folder, root)
Updated(updater Bytecode/Repositories, folder Text) slow
	logger.Log("Updated " + updater.Updated(folder) + " packages in " + folder)
Native(command Text, rest Texts) Number slow
	Strict.Native("test", ("Missing.strict", ".", "values", "other")) is 2
	NativeCompiler.Ran((List(Text) + command) + rest)
Formatted(path Text) Text slow
	Strict.Formatted("Examples/HelloLogger.strict").StartsWith("has logger")
	lines = RoundTrip.Tabbed(File(path).ReadLines)
	broken = FileCompiler.Unparsable(lines)
	if broken >= 0
		return Error(ResolveCheck.Located(FileCompiler.Normalized(path), broken + 1, FileCheck.Problem(lines, broken)))
	Text.Combine(RoundTrip.Formatted(lines), "\n")
Suggested(rest Texts) Number slow
	source = FileCompiler.Normalized(rest(0))
	if rest.Length > 3 and rest(3) is "-"
		File(source).InMemory(Process.Input)
	files = SourceFiles(rest(1)).Of(source)
	Suggestions(source, rest(1), File(source).ReadLines, ResolveCheck.Inference(files)).Run(rest(2), files)