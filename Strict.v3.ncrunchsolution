<SolutionConfiguration>
  <Settings>
    <AllowParallelTestExecution>True</AllowParallelTestExecution>
    <EnableRDI>False</EnableRDI>
    <HotSpotsLineExclusionList />
    <MetricsExclusionList>
      <Value>Program.cs:Strict.Language.Tests\Strict.Language.Tests.csproj</Value>
    </MetricsExclusionList>
    <RdiConfigured>True</RdiConfigured>
    <SolutionConfigured>True</SolutionConfigured>
    <TestsToExecuteAutomatically>(DoesNotHaveCategory 'Slow' AND DoesNotHaveCategory 'Nightly' AND DoesNotHaveCategory 'Manual')</TestsToExecuteAutomatically>
  </Settings>
</SolutionConfiguration>