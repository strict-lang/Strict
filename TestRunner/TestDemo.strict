has logger
Run
	constant method = MethodUnderTest("Run", ("5 is 5", "2 is 2", "5 is 6"))
	constant other = MethodUnderTest("Other", ("1 is 1", "3 is 3"))
	constant type = TypeUnderTest("Demo", (method, other))
	constant runner = TestInterpreter.Empty.RunAllTestsInType(type)
	logger.Log(runner)
	logger.Log(runner.statistics)
	for runner.results
		logger.Log(value)
