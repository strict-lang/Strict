has characters
+(other) Text
	"" + "more" is "more"
	"Hey" + " " + "you" is "Hey you"
	characters + other.characters
+(number) Text
	"" + 1 is "1"
	"Your age is " + 18 is "Your age is 18"
	characters + number to Text
to Number
	"5" to Number is 5
	"123" to Number is 123
	"-17" to Number is -17
	"1.3" to Number is 1.3
	"1e10" to Number is 1e10
	for characters.Reverse
		value to Number * 10 ^ index
in(text) Boolean
	"hi" is not in "hello there"
	"lo" is in "hello there"
	"re" is in "hello there"
	for Length - text.Length + 1
		StartsWith(text, index)
Combine(texts Texts, separator = ", ") Text
	Combine(("a", "b", "c")) is "a, b, c"
	Combine(("a", "b"), "") is "ab"
	Combine(("hi", "there"), Character.NewLine) is "hi\nthere"
	for texts
		(index is 0 then "" else separator) + value
EndsWith(text) Boolean
	"hello".EndsWith("llo")
	"hello".EndsWith("hel") is false
	"lo".EndsWith("hello") is false
	StartsWith(text, Length - text.Length)
StartsWith(text, start = 0) Boolean
	"hello".StartsWith("hel")
	"hello".StartsWith("hel", 1) is false
	"yo mama".StartsWith("mama") is false
	"hi".StartsWith("hello") is false
	if start < 0 or start + text.Length > Length
		return false
	for Range(start, start + text.Length)
		if outer(index) is not text(index - start)
			return false
	true
Split(separator Text) Texts
	"a,b".Split(",") is ("a", "b")
	"abc".Split(",") is ("abc")
	"a,,b,".Split(",") is ("a", "", "b", "")
	mutable parts = List(Mutable(Text))
	mutable start = 0
	mutable found = separator is "" then -1 else IndexOf(separator)
	for as long as found >= 0
		parts.Add(Substring(start, found - start))
		start = found + separator.Length
		found = IndexOf(separator, start)
	parts + Substring(start, Length - start)
Lines Texts
	"a\nb".Lines is ("a", "b")
	"a\n\nb\n".Lines is ("a", "", "b")
	constant unixText = Replace("\r", "")
	if unixText is ""
		return Texts
	let parts = unixText.Split("\n")
	if parts.Last is not ""
		return parts
	for Range(0, parts.Length - 1)
		parts(value)
Trim Text
	" hi ".Trim is "hi"
	"noSpaces".Trim is "noSpaces"
	"\thi\n".Trim is "hi"
	TrimStart.TrimEnd
TrimStart Text
	" hi ".TrimStart is "hi "
	mutable startIndex = 0
	for characters
		if value is in (" ", "\t", "\n", "\r")
			startIndex = startIndex + 1
		else
			return Substring(startIndex, Length - startIndex)
	""
TrimEnd Text
	" hi ".TrimEnd is " hi"
	mutable endIndex = characters.Length
	for characters.Reverse
		if value is in (" ", "\t", "\n", "\r")
			endIndex = endIndex - 1
		else
			return Substring(0, endIndex)
	""
Capitalize Text
	"logger".Capitalize is "Logger"
	"a".Capitalize is "A"
	Length is 0 then "" else Substring(0, 1).Upper + Substring(1, Length - 1)
IndexOf(text Text, startIndex = 0) Number
	"hello".IndexOf("he") is 0
	"hello".IndexOf("ll") is 2
	"hello".IndexOf("lo") is 3
	"hello".IndexOf("no") is -1
	for Range(startIndex, Length - text.Length + 1)
		if StartsWith(text, index)
			return index
	-1
LastIndexOf(text Text) Number
	"hello".LastIndexOf("l") is 3
	"hello".LastIndexOf("x") is -1
	"hello".LastIndexOf("o") is 4
	"a".LastIndexOf("abc") is -1
	for Range(0, Length - text.Length + 1).Reverse
		if StartsWith(text, index)
			return index
	-1
Substring(start Number, length Number) Text
	"hello".Substring(1, 3) is "ell"
	"hello".Substring(3, 10) is "lo"
	for Range(start, start + length)
		if index < Length
			characters(index)
Replace(searchFor Text, replaceWith Text) Text
	"a,b,c".Replace(",", ";") is "a;b;c"
	let separatorIndex = IndexOf(searchFor)
	if separatorIndex is -1
		return value
	let rest = Range(separatorIndex + searchFor.Length, characters.Length)
	let prefix = Substring(0, separatorIndex) + replaceWith
	prefix + Substring(rest.Start, rest.Length).Replace(searchFor, replaceWith)
Upper Text
	"HeLlo".Upper is "HELLO"
	for
		Upper
Lower Text
	"HeLlo".Lower is "hello"
	for
		Lower
Count(character) Number
	"".Count("1") is 0
	"abc".Count("a") is 1
	"hello".Count("l") is 2
	for
		if value is character
			1
Code Text
	"ab".Code is "\"ab\""
	"say \"hi\"".Code is "\"say \\\"hi\\\"\""
	"a\nb\\".Code is "\"a\\nb\\\\\""
	let escaped = Replace("\\", "\\\\").Replace("\"", "\\\"").Replace("\n", "\\n").Replace("\t", "\\t")
	"\"" + escaped + "\""
ToBrackets Text
	"".ToBrackets is ""
	"Hi".ToBrackets is "(Hi)"
	"1, 2, 3".ToBrackets is "(1, 2, 3)"
	Length > 0 then "(" + value + ")" else value
is(other) Boolean
	"A" is "A"
	"Hi" is not "hi"
	value is other