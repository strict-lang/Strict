has root Text
constant Rule = "PackageDependenciesMustNotCycle"
Issues(folders Texts) ValidationIssues slow
	AcyclicDependencies(".").Issues(List(Text) + "Math").Length is 0
	CycleIssues(Edges(folders))
CycleIssues(edges Texts) ValidationIssues
	AcyclicDependencies(".").CycleIssues(List(Text) + "A->B").Length is 0
	AcyclicDependencies(".").CycleIssues(("A->B", "B->A")).First to Text is Rule + ": Cycle involves A->B"
	for CycleEdges(edges)
		ValidationIssue(Rule, "Cycle involves " + value, 1)
CycleEdges(edges Texts) Texts
	AcyclicDependencies(".").CycleEdges(("A->B", "B->C")).Length is 0
	AcyclicDependencies(".").CycleEdges(("A->B", "B->A")) is ("A->B", "B->A")
	AcyclicDependencies(".").CycleEdges(("A->B", "B->C", "C->A")).Length is 3
	adjacency = Adjacency(edges)
	for edges
		parts = value.Split("->")
		if IsReachable(adjacency, parts.Last, parts.First)
			value
Adjacency(edges Texts) Dictionary(Text, Texts)
	AcyclicDependencies(".").Adjacency(("A->B", "A->C"))("A") is ("B", "C")
	mutable map = Dictionary(Text, Texts)
	for edges
		parts = value.Split("->")
		existing = parts.First is in map then map(parts.First) else List(Text)
		map(parts.First) = existing + parts.Last
	map
IsReachable(adjacency Dictionary(Text, Texts), start Text, target Text) Boolean
	AcyclicDependencies(".").IsReachable(AcyclicDependencies(".").Adjacency(("A->B", "B->C")), "A", "C")
	AcyclicDependencies(".").IsReachable(AcyclicDependencies(".").Adjacency(("A->B", "B->C")), "C", "A") is false
	mutable queue = List(Mutable(Text)) + start
	mutable seen = Dictionary(Text, Boolean)
	for as long as queue.Length > 0
		node = queue.First
		queue = queue.Slice(1, queue.Length - 1)
		if node is not in seen
			seen(node) = true
			queue = queue + (node is in adjacency then adjacency(node) else List(Text))
	target is in seen
Edges(folders Texts) Texts slow
	AcyclicDependencies(".").Edges(List(Text) + "Math").Length is 0
	owners = Owners(folders)
	mutable raw = List(Mutable(Text))
	for folders
		raw = raw + FolderEdges(value, owners)
	raw.Unique
FolderEdges(source Text, owners Dictionary(Text, Text)) Texts slow
	AcyclicDependencies(".").FolderEdges("Math", Dictionary(("Number", "."))).Length > 0
	mutable result = List(Mutable(Text))
	for Directory.Files(source, "*.strict")
		result = result + EdgeKeys(source, value, owners)
	result
EdgeKeys(source Text, file Text, owners Dictionary(Text, Text)) Texts slow
	AcyclicDependencies(".").EdgeKeys("Math", "Math/Vector2.strict", Dictionary(("Number", "."))).First is "Math->."
	mutable result = List(Mutable(Text))
	for Used(file)
		if value is in owners
			target = owners(value)
			if target is not source
				result.Add(source + "->" + target)
	result
Used(file Text) Texts slow
	"Degrees" is in AcyclicDependencies(".").Used("Math/Vector2.strict")
	constant kind = "productionTypes"
	cached = Memo.Texts(file, kind)
	if cached.Length > 0
		return cached.Slice(1, cached.Length - 1)
	found = ProductionTypes(File(file).ReadLines)
	Memo.Keep(file, kind, List(Text) + "" + found).Slice(1, found.Length)
Owners(folders Texts) Dictionary(Text, Text) slow
	AcyclicDependencies(".").Owners(List(Text) + "Math")("Vector2") is "Math"
	mutable owners = Dictionary(Text, Text)
	for folders
		folder = value
		for Directory.Files(folder, "*.strict")
			owners(Path(value).FileName.RemoveExtension.text) = folder
	owners
ProductionTypes(lines Texts) Texts
	AcyclicDependencies(".").ProductionTypes(("Run Number", "\t1 is 1", "\tVector2(1, 2).X")) is ("Number", "Vector2")
	shape = TypeShape(lines)
	mutable kept = List(Mutable(Text))
	mutable isTest = false
	for lines
		keep = value.StartsWith("\t") is false or isTest is false or IsLeadingTest(lines, index) is false
		isTest = value.StartsWith("\t") is false then shape.IsMethodHeader(value) else keep is false
		if keep
			kept.Add(value)
	Mentions(kept).Types
IsLeadingTest(lines Texts, index Number) Boolean
	AcyclicDependencies(".").IsLeadingTest(("Run", "\t1 is 1", "\t2"), 1)
	AcyclicDependencies(".").IsLeadingTest(("Run", "\t1 is 1"), 1) is false
	index + 1 < lines.Length and lines(index + 1).StartsWith("\t") and Duplicates.IsTest(lines(index).Trim)