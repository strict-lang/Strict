has lines Texts
constant Larger = BaseCalls(("Rest Text", "	Rest is \"b\"", "	text.Substring(start, text.Length - start)"))
constant Extremes = (("$a", ">", "$b", "then", "$a", "else", "$b"), ("$a", ">", "$b", "then", "$b", "else", "$a"), ("$a", "<", "$b", "then", "$a", "else", "$b"), ("$a", "<", "$b", "then", "$b", "else", "$a"))
constant Inclusive = (("$a", ">=", "$b", "then", "$a", "else", "$b"), ("$a", ">=", "$b", "then", "$b", "else", "$a"), ("$a", "<=", "$b", "then", "$a", "else", "$b"), ("$a", "<=", "$b", "then", "$b", "else", "$a"))
constant Rest = List(Texts) + ("$a", ".", "Substring", "(", "$b", ",", "$a", ".", "Length", "-", "$b", ")")
constant Bit = List(Texts) + ("(", "$a", "/", "2", "^", "$b", ")", ".", "Floor", "%", "2", "is", "1")
constant Others = (("$a", "+", "(", "$b", "-", "$a", ")", "*", "$c"), ("$a", ".", "Round", "(", "0", ")"), ("$a", "^", "0.5"), ("$a", "<", "$b", "or", "$a", ">", "$b"))
constant Patterns = Rest + Bit + Others + Extremes + Inclusive
constant Extreme = ("$a.Maximum($b)", "$a.Minimum($b)", "$a.Minimum($b)", "$a.Maximum($b)")
constant Templates = (List(Text) + "$a.Substring($b)" + "$a.IsBitSet($b)" + ("$a.Lerp($b, $c)", "$a.Round", "$a.SquareRoot", "$a is not $b")) + Extreme + Extreme
constant Suggestion = "BaseMethodMustBeUsed: text . Substring ( start , text . Length - start ), use text.Substring(start)"
constant Stronger = (".", "*", "/", "%", "^", "-", "(", "and", "or", "not")
constant Continuing = (".", "(", "+", "-", "*", "/", "%", "^")
constant Keys = ("Substring", "Floor", ") *", "Round(0)", "^ 0.5", " or ", "then", "then", "then", "then", "then", "then", "then", "then")
Issues List(ValidationIssue)
	Larger.Issues.First to Text is Suggestion
	Larger.Issues.First.Line is 3 and BaseCalls(("A", "	A is 1", "	b + c")).Issues.Length is 0
	shape = TypeShape(lines)
	mutable issues = List(Mutable(ValidationIssue))
	for lines
		if shape.IsMethodHeader(value)
			issues = issues + Body(index)
	issues
Body(header Number) List(ValidationIssue)
	Larger.Body(0).Length is 1
	BaseCalls(("Lerp(other Number) Number", "	1.Lerp(3) is 2", "	value + (other - value) * 0.5")).Body(0).Length is 0
	code = ErrorDrops(lines).Code(header)
	start = FileCheck.LastLine(lines, header) - code.Length + 2
	own = "." + Tokenizer(lines(header)).Tokens.First + "("
	for code
		suggestion = Suggest(value)
		if suggestion is not "" and suggestion.IndexOf(own) < 0
			ValidationIssue("BaseMethodMustBeUsed", suggestion, start + index)
Suggest(code Text) Text
	Larger.Suggest("let rest = text.Substring(start, text.Length - start)").EndsWith("use text.Substring(start)")
	Larger.Suggest("(flags / 2 ^ bit).Floor % 2 is 1").EndsWith("use flags.IsBitSet(bit)")
	Larger.Suggest("start + (end - start) * amount").EndsWith("use start.Lerp(end, amount)")
	Larger.Suggest("x.Round(0)").EndsWith("use x.Round") and Larger.Suggest("2 ^ 0.5").EndsWith("2.SquareRoot")
	Larger.Suggest("a < b then a else b").EndsWith("use a.Minimum(b)")
	Larger.Suggest("x < low then low else x").EndsWith("use x.Maximum(low)")
	Larger.Suggest("width >= height then width else height").EndsWith("use width.Maximum(height)")
	Larger.Suggest("value < limit and value > below then value else below") is ""
	Larger.Suggest("x < a or x > a").EndsWith("use x is not a") and Larger.Suggest("width + height") is ""
	Larger.Suggest("y * a + (b - a) * t") is ""
	tokens = Tokenizer(code).Tokens
	for Patterns
		pattern = value
		template = Templates(index)
		for code.IndexOf(Keys(index)) < 0 then List(Text) else tokens
			bindings = Match(tokens, index, pattern)
			if bindings.Length > 0
				return Text.Combine(tokens.Slice(index, pattern.Length), " ") + ", use " + Fill(template, bindings)
	""
Match(tokens Texts, start Number, pattern Texts) Dictionary(Text, Text)
	Larger.Match(("a", ">", "b"), 0, ("$a", ">", "$b"))("$b") is "b"
	Larger.Match(("a", ">", "b"), 0, ("$a", "<", "$b")).Length is 0
	Larger.Match(("a", ">", "b"), 1, ("$a", ">", "$b")).Length is 0
	if IsFree(tokens, start, pattern.Length) is false
		return Dictionary(Text, Text)
	mutable bindings = Dictionary(Text, Text)
	for pattern
		token = tokens(start + index)
		isBound = value.StartsWith("$") and IsOperand(token)
		if isBound is false and value is not token or (value is in bindings then bindings(value) else token) is not token
			return Dictionary(Text, Text)
		bindings(value) = token
	bindings
IsFree(tokens Texts, start Number, length Number) Boolean
	Larger.IsFree(("a", "b"), 0, 2) and Larger.IsFree(("a", "b"), 1, 2) is false
	Larger.IsFree(("*", "b"), 1, 1) is false and Larger.IsFree(("a", "b", "+"), 0, 2) is false
	isEnded = start + length >= tokens.Length then true else tokens(start + length) is not in Continuing
	start + length <= tokens.Length and (start is 0 then true else tokens(start - 1) is not in Stronger) and isEnded
IsOperand(token Text) Boolean
	Larger.IsOperand("width") and Larger.IsOperand("2")
	Larger.IsOperand("(") is false and Larger.IsOperand(">") is false
	token(0).Lower is not token(0).Upper or Tokenizer.IsDigit(token(0)) or token(0) is "\""
Fill(template Text, bindings Dictionary(Text, Text)) Text
	Larger.Fill("($a, $b).Maximum", Dictionary(("$a", "x"), ("$b", "y"))) is "(x, y).Maximum"
	mutable filled = template
	for bindings
		filled = filled.Replace(value.Key, value.Value)
	filled
