has node Expressions/SyntaxNode
Collapse(code Text) Text
	Collapse("1 + 2 * 3") is "7"
	ConstantCollapser(StatementParser(Tokenizer(code).Tokens).ParseStatement).Collapsed to Text
Collapsed SyntaxNode
	Collapse("\"5\" to Number + 1") is "6"
	Collapse("let a = 5 to Text + \"yo\"") is "let a = \"5yo\""
	if node.Kind is "Binary"
		return CollapsedBinary
	node.children.Length is 0 then node else SyntaxNode(node.Kind, node.text, CollapsedChildren)
CollapsedChildren SyntaxNodes
	Collapse("Add(1 + 1, 2)") is "Add(2, 2)"
	for node.children
		ConstantCollapser(value).Collapsed
CollapsedBinary SyntaxNode
	Collapse("x + 1 * 2") is "x + 2"
	let left = ConstantCollapser(node.children(0)).Collapsed
	let right = ConstantCollapser(node.children(1)).Collapsed
	let folded = node.text is "to" then Converted(left, right.text) else Folded(left, node.text, right)
	folded.Kind is "Missing" then SyntaxNode("Binary", node.text, (left, right)) else folded
Folded(left SyntaxNode, operator Text, right SyntaxNode) SyntaxNode
	Collapse("6 / 3 - 1") is "1"
	Collapse("true and false or true") is "true"
	if (left.Kind is "Number") and (right.Kind is "Number") and (operator is in ("+", "-", "*", "/"))
		return SyntaxNode("Number", Calculated(left.text to Number, operator, right.text to Number) to Text)
	if (operator is "+") and (left.Kind is "Text") and (right.Kind is in ("Text", "Number", "Boolean"))
		return SyntaxNode("Text", left.text.Substring(0, left.text.Length - 1) + Inner(right) + "\"")
	if (left.Kind is "Boolean") and (right.Kind is "Boolean") and (operator is in ("and", "or"))
		return SyntaxNode("Boolean", Logical(left.text is "true", operator, right.text is "true") to Text)
	SyntaxNode("Missing", "")
Converted(operand SyntaxNode, typeName Text) SyntaxNode
	Collapse("true to Text") is "\"true\""
	if (operand.Kind is "Text") and (typeName is "Number")
		return SyntaxNode("Number", Inner(operand))
	if (operand.Kind is in ("Number", "Boolean")) and (typeName is "Text")
		return SyntaxNode("Text", "\"" + operand.text + "\"")
	SyntaxNode("Missing", "")
Calculated(left Number, operator Text, right Number) Number
	Calculated(2, "*", 3) is 6
	if operator is "+"
		return left + right
	if operator is "-"
		return left - right
	operator is "*" then left * right else left / right
Logical(left Boolean, operator Text, right Boolean) Boolean
	Logical(true, "or", false) is true
	operator is "and" then left and right else left or right
Inner(literal SyntaxNode) Text
	Inner(SyntaxNode("Text", "\"a\"")) is "a"
	literal.Kind is "Text" then literal.text.Substring(1, literal.text.Length - 2) else literal.text