has line Text
DeclaredName Text
	DeclarationRules("let count = 1").DeclaredName is "count"
	DeclarationRules("mutable total = 0").DeclaredName is "total"
	constant withoutKeyword = WithoutKeyword
	constant equalsIndex = withoutKeyword.IndexOf(" = ")
	if equalsIndex is -1
		return withoutKeyword.Trim
	withoutKeyword.Substring(0, equalsIndex).Trim
WithoutKeyword Text
	DeclarationRules("constant x = 1").WithoutKeyword is "x = 1"
	if line.StartsWith("let ")
		return line.Substring(4, line.Length - 4)
	if line.StartsWith("constant ")
		return line.Substring(9, line.Length - 9)
	if line.StartsWith("mutable ")
		return line.Substring(8, line.Length - 8).Trim
	line
IsDeclaration Boolean
	DeclarationRules("let x = 1").IsDeclaration is true
	DeclarationRules("x = 1").IsDeclaration is false
	line.StartsWith("let ") or line.StartsWith("constant ") or IsMutableDeclaration
IsMutableDeclaration Boolean
	line.StartsWith("mutable ")
IsReassignmentOf(name Text) Boolean
	DeclarationRules("count = 1").IsReassignmentOf("count") is true
	DeclarationRules("let count = 1").IsReassignmentOf("count") is false
	if IsDeclaration
		return false
	line.StartsWith(name + " = ")