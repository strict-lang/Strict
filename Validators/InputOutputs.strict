has inference Expressions/TypeInference = TypeInference.NoInference
constant Slowly = List(Text) + "slow"
constant Natively = ("slow", "native")
constant Kinds = ("File", "Directory", "Process", "Socket", "Http")
constant Traits = ("TextReader", "TextWriter", "BytesReader", "BytesWriter")
constant Flagged = "InputOutputMustBeSlow: Reader.Loaded does file, directory, process or network input or output, end its header with slow"
constant Hint = " does file, directory, process or network input or output, end its header with slow"
constant Loading = ("Loaded(path Text) Texts", "\tLoaded(\"a\").Length is 0", "\tFile(path).ReadLines", "Run", "\tLoaded(\"b\")")
constant Readers = KnownTypes(("Reader", "File"), (KnownTypes.NoMembers, KnownTypes.NoMembers), (Scope(("Loaded", "Run"), ("Texts", "None")), Scope("ReadLines", "Texts")), (KnownTypes.NoMembers, KnownTypes.NoMembers))
constant Reading = InputOutputs(TypeInference(Readers, (KnownTypes.NoMembers, KnownTypes.NoMembers)))
constant Checking = ("Checked Boolean", "\tLoaded(\"a\").Length is 0", "\tlet loaded = Loaded(\"b\")", "\tloaded.Length is 1", "\tloaded.Length > 0", "IsLoaded Boolean", "\tLoaded(\"c\").Length > 0")
constant Checks = MethodBodies("Reader", TypeShape(Checking), Reading.inference)
constant Flags = ("Checked Boolean", "\tLoaded(\"a\").Length is 0", "\tlet isLoaded = Loaded(\"b\").Length > 0", "\tisLoaded")
constant Flagging = MethodBodies("Reader", TypeShape(Flags), Reading.inference)
constant Constants = BodyParser(("Run", "\tconstant a = true", "\tconstant b = 1"))
constant Reversed = ("Reader.Shown||Reader.Loaded", "Reader.Loaded||File.ReadLines", "File.ReadLines|slow|")
constant Reached = ("File.ReadLines|slow|", "Reader.Loaded||File.ReadLines", "Reader.Shown||Reader.Loaded", "Reader.Twice||Number.+")
Collect(paths Texts, markers Texts) Texts slow
	InputOutputs.Collect(List(Text), Slowly).Length is 0
	mutable records = List(Mutable(Text))
	for Parse(paths, Read(paths))
		records = records + value
	Settle(records, markers)
Read(paths Texts) List(Texts) slow
	InputOutputs.Read(List(Text) + "Validators/InputOutputs.strict").First.First.StartsWith("has inference")
	for paths
		File(value).ReadLines
Parse(paths Texts, contents List(Texts)) List(Texts)
	Reading.Parse(List(Text) + "Demo/Reader.strict", List(Texts) + Loading).First is Reading.Records("Reader", Loading)
	Reading.Parse(List(Text) + "Demo/TextReader.strict", List(Texts) + Loading).First.First.StartsWith("File.Loaded")
	"Reader.Loaded" is in Reading.Used(Flagging, Flagging.Statements, Flags, 0)
	for paths
		name = Path(value).FileName.RemoveExtension.text
		Records(name is in Traits then "File" else name, contents(index))
Records(type Text, lines Texts) Texts
	Reading.Records("Reader", Loading) is ("Reader.Loaded||File.ReadLines", "Reader.Run||Reader.Loaded")
	InputOutputs.Records("File", ("Name Text", "Exists Boolean slow")) is ("File.Name|native|", "File.Exists|slow|")
	InputOutputs.Records("Reader", "Exists Boolean slow") is ("Reader.Exists|native|")
	InputOutputs.Records("Window", ("Size Number", "	1")) is ("Window.Size||")
	Reading.Records("Reader", Checking)(1) is "Reader.IsLoaded||List.Length,Reader.Loaded"
	shape = TypeShape(lines)
	bodies = MethodBodies(type, shape, inference)
	statements = bodies.Statements
	for lines
		if shape.IsMethodHeader(value)
			isSeed = HeaderTokens(Tokenizer(value).Tokens).ReturnsSlow and type is in Kinds
			isNative = FileCheck.LastLine(lines, index) is index
			marker = isSeed then "|slow|" else isNative then "|native|" else "||"
			type + "." + Tokenizer(value).Tokens.First + marker + Text.Combine(Used(bodies, statements, lines, index), ",")
Used(bodies MethodBodies, statements ScopedStatements, lines Texts, header Number) Texts
	Reading.Used(Checks, Checks.Statements, Checking, 0).Length is 3
	"Reader.Loaded" is in Reading.Used(Checks, Checks.Statements, Checking, 0)
	Reading.Used(Checks, Checks.Statements, Checking, 5).Length is 2
	last = FileCheck.LastLine(lines, header)
	mutable isTesting = true
	mutable keys = List(Mutable(Text))
	for statements
		if value.line > header and value.line <= last
			isTesting = isTesting and value.line < last and IsTest(bodies, value)
			if isTesting is false
				keys = keys + SureCalls(inference).Calls(bodies.typeName, value.statement, value.scope)
	keys
IsTest(bodies MethodBodies, scoped ScopedStatement) Boolean
	Reading.IsTest(Flagging, Flagging.Statements.First) and Reading.IsTest(Flagging, Flagging.Statements(1)) is false
	Reading.IsTest(Flagging, ScopedStatement(Constants.Statement(1, 1), KnownTypes.NoMembers, 1))
	Reading.IsTest(Flagging, ScopedStatement(Constants.Statement(2, 1), KnownTypes.NoMembers, 2)) is false
	isConstant = scoped.statement.text.StartsWith("constant ")
	(scoped.statement.Kind is not "Declaration" or isConstant) and bodies.StatementType(scoped) is "Boolean"
Settle(records Texts, markers Texts) Texts
	InputOutputs.Settle(Reached, Slowly) is ("File.ReadLines", "Reader.Loaded", "Reader.Shown")
	InputOutputs.Settle(List(Text) + "Reader.Loaded||File.ReadLines", Slowly).Length is 0
	InputOutputs.Settle(Reversed, Slowly) is ("File.ReadLines", "Reader.Loaded", "Reader.Shown")
	InputOutputs.Settle(("A.Draw|native|", "B.Render||A.Draw"), Natively) is ("A.Draw", "B.Render")
	InputOutputs.Settle(("A.Draw|native|", "B.Render||A.Draw"), Slowly).Length is 0
	Spread(Callers(records), Seeds(records, markers))
Callers(records Texts) Dictionary(Text, Texts)
	InputOutputs.Callers(Reached)("Reader.Loaded") is ("Reader.Shown")
	"Reader.Twice" is not in InputOutputs.Callers(Reached)
	mutable callers = Dictionary(Text, Texts)
	for records
		caller = SureMethods.Key(value)
		for SureMethods.CallList(value)
			callers(value) = (value is in callers then callers(value) else List(Text)) + caller
	callers
Spread(callers Dictionary(Text, Texts), seeds Texts) Texts
	InputOutputs.Spread(InputOutputs.Callers(Reversed), List(Text) + "File.ReadLines").Length is 3
	mutable reaching = seeds
	mutable seen = SourceFiles.Seen(seeds)
	mutable position = 0
	for as long as position < reaching.Length
		for reaching(position) is in callers then callers(reaching(position)) else List(Text)
			if value is not in seen
				seen(value) = true
				reaching = reaching + value
		position = position + 1
	reaching
Seeds(records Texts, markers Texts) Texts
	InputOutputs.Seeds(Reached, Slowly) is ("File.ReadLines")
	for records
		if value.Split("|")(1) is in markers
			SureMethods.Key(value)
Issues(path Text, lines Texts, reaching Texts) List(ValidationIssue)
	InputOutputs.Issues("Demo/Reader.strict", Loading, ("Reader.Loaded", "Reader.Run")).Length is 1
	InputOutputs.Issues("Demo/Reader.strict", Loading, "Reader.Loaded").First to Text is Flagged
	InputOutputs.Issues("Demo/Reader.strict", Loading, "Reader.Loaded").First.Line is 1
	InputOutputs.Issues("Demo/Reader.strict", Loading, "Reader.Loaded").Length is 1
	InputOutputs.Issues("Compiler/Reader.strict", Loading, "Reader.Loaded").Length is 0
	InputOutputs.Issues("Demo/Reader.strict", "has logger", "Reader.has").Length is 0
	isInternal = Path(Path(path).PathOnly.text).FileName.text is in TypeSource.InternalPackages
	type = Path(path).FileName.RemoveExtension.text
	shape = TypeShape(lines)
	for lines
		if isInternal is false and shape.IsMethodHeader(value) and IsUnmarked(type, value, reaching)
			ValidationIssue("InputOutputMustBeSlow", type + "." + Tokenizer(value).Tokens.First + Hint, index + 1)
IsUnmarked(type Text, line Text, reaching Texts) Boolean
	InputOutputs.IsUnmarked("Reader", "Loaded Texts", "Reader.Loaded")
	InputOutputs.IsUnmarked("Reader", "Loaded Texts slow", "Reader.Loaded") is false
	InputOutputs.IsUnmarked("Reader", "Run", "Reader.Run") is false
	InputOutputs.IsUnmarked("Reader", "Shown Texts", "Reader.Loaded") is false
	header = HeaderTokens(Tokenizer(line).Tokens)
	header.tokens(0) is not "Run" and header.ReturnsSlow is false and type + "." + header.tokens(0) is in reaching
