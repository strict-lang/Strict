has lines Texts
has isBase Boolean
has scale Number = 1
constant MaxCharacters = 120
constant MaxMethodLines = 13
constant MaxMethods = 16
constant MaxMembers = 15
constant ExtraConstants = 2
constant MinusPrecedence = SyntaxNode("Binary", "-").Precedence
constant OnlyConstants = Limits(("constant A", "constant B", "constant C", "constant D", "constant E", "constant F", "constant G", "constant H", "constant I", "constant J", "constant K", "constant L", "constant M", "constant N", "constant O", "constant P"), false)
constant Sample = Limits(("has number", "Run", "\t\t\t\t\t\t1", "  2"), false)
constant Long = Limits(("Run", "\t1", "\t2", "\t3", "\t4", "\t5", "\t6", "\t7", "\t8", "\t9", "\t10", "\t11", "\t12", "\t13"), false)
constant Twice = Limits(Long.lines, false, 2)
constant Wide = " xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
constant Indent = ValidationIssue("ExtraWhitespacesFoundAtBeginningOfLine", "indent with tabs", 5)
constant Methods = Limits(("A", "B", "C", "D", "E", "F", "G", "H", "I", "J", "K", "L", "M", "N", "O", "P", "Q"), false)
constant Lengthy = (ValidationIssue("MethodLengthMustNotExceedTwelve", "Run", 1), ValidationIssue("MethodLengthMustNotExceedTwelve", "Run", 17))
Issues ValidationIssues
	Sample.Issues.Length is 2
	Limits(("has number", "Run", "\t1"), false).Issues.Length is 0
	Limits(Long.lines, false, 10).Issues.Length is 0
	Limits(OnlyConstants.lines + OnlyConstants.lines + OnlyConstants.lines, false, 10).Issues.Length is 0
	Methods.Issues.Length is 1
	Long.Issues.Length is 1
	Limits(("Run", "\tlet a = 0 - b"), false).Issues.Length is 1
	mutable issues = List(Mutable(ValidationIssue))
	for lines
		issues = issues + LineIssues(value, index) + NegationIssues(value, index)
	issues + MethodIssues + CountIssues + OrderIssues
OrderIssues ValidationIssues
	Limits(("Run", "\t1", "has a"), false).OrderIssues.First to Text is "MembersMustComeBeforeMethods: has a"
	Limits(("has a", "Run", "\t1"), false).OrderIssues.Length is 0
	let shape = TypeShape(lines)
	for Range(shape.MembersEnd, lines.Length)
		if shape.IsMemberLine(lines(value))
			ValidationIssue("MembersMustComeBeforeMethods", lines(value), value + 1)
LineIssues(line Text, number Number) ValidationIssues
	Sample.LineIssues("\t\t\t\t\t\t1", 2).First.Line is 3 and Sample.LineIssues(Wide, 4) is (Indent)
	Sample.LineIssues(" a", 0).First to Text is "ExtraWhitespacesFoundAtBeginningOfLine: indent with tabs"
	Limits(Long.lines, false, 10).LineIssues(RoundTrip.Packed + RoundTrip.Packed, 0).Length is 0
	Sample.LineIssues("\t\t\t\t\t\t1", 2).First to Text is "NestingMoreThanFiveLevelsIsNotAllowed: more than five levels"
	Sample.LineIssues("\t\t\t\t\t\t" + Wide, 0).Length is 2
	mutable issues = LengthIssues(line, number)
	if line.StartsWith("\t\t\t\t\t\t")
		issues.Add(ValidationIssue("NestingMoreThanFiveLevelsIsNotAllowed", "more than five levels", number + 1))
	if line.StartsWith(" ")
		issues.Add(ValidationIssue("ExtraWhitespacesFoundAtBeginningOfLine", "indent with tabs", number + 1))
	issues
LengthIssues(line Text, number Number) ValidationIssues
	Sample.LengthIssues("\t1", 0).Length is 0 and Sample.LengthIssues(Wide, 0).Length is 0
	Sample.LengthIssues("\t" + Wide, 2).First to Text is "CharacterCountMustBeWithinLimit: 251 > 120"
	Sample.LengthIssues("\t" + Wide, 2).First.Line is 3
	Limits(Long.lines, false, 10).LengthIssues("\t" + Wide, 0).Length is 0
	mutable issues = List(Mutable(ValidationIssue))
	let length = line.Length to Text + " > " + MaxCharacters * scale
	if line.StartsWith("\t") and (line.Length > MaxCharacters * scale)
		issues.Add(ValidationIssue("CharacterCountMustBeWithinLimit", length, number + 1))
	issues
NegationIssues(line Text, number Number) ValidationIssues
	Sample.NegationIssues("\tlet a = 0 - b.Y", 0).First to Text is "ZeroMinusMustBeNegation: write -b.Y instead of 0 - b.Y"
	Sample.NegationIssues("\tlet a = b - 0 - c", 0).Length is 0
	Sample.NegationIssues("\tlet a = \"0 - b\"", 0).Length is 0
	mutable issues = List(Mutable(ValidationIssue))
	if "0 - " is in line
		let tokens = Tokenizer(line.Trim).Tokens
		for tokens.Length - 2
			if IsZeroMinus(tokens, index)
				let operand = Operand(tokens, index + 2)
				let detail = "write -" + operand + " instead of 0 - " + operand
				issues.Add(ValidationIssue("ZeroMinusMustBeNegation", detail, number + 1))
	issues
IsZeroMinus(tokens Texts, index Number) Boolean
	Sample.IsZeroMinus(("a", "=", "0", "-", "b"), 2)
	Sample.IsZeroMinus(("a", "-", "0", "-", "b"), 2) is false
	Sample.IsZeroMinus(("10", "-", "b"), 0) is false
	Sample.IsZeroMinus(("0", "-", "b"), 0)
	Sample.IsZeroMinus(("b", "0", "-", "c"), 1) is false
	Sample.IsZeroMinus(("b", "is", "0", "-", "c"), 2)
	Sample.IsZeroMinus(("=", "0", "+", "b"), 1) is false
	Sample.IsZeroMinus(("return", "0", "-", "b"), 1)
	let before = index is 0 then "(" else tokens(index - 1)
	let precedence = SyntaxNode("Binary", before).Precedence
	let opening = before is in ("(", ",", "=", "not", "return", "if") or (precedence > 0 and precedence < MinusPrecedence)
	tokens(index) is "0" and tokens(index + 1) is "-" and opening
Operand(tokens Texts, start Number) Text
	Sample.Operand(("b", ".", "Y", "*", "2"), 0) is "b.Y"
	Sample.Operand(("x", "a", ".", "b"), 1) is "a.b"
	Sample.Operand(("x", "a", ".", "b", ".", "c"), 1) is "a.b.c"
	Sample.Operand(("x", "=", "a", ".", "b", "*", "c"), 2) is "a.b"
	Sample.NegationIssues("\tlet a = 0-b", 0).Length is 0
	mutable text = tokens(start)
	for tokens.Length - start - 1
		if tokens(start + index + 1) is not "." and (text.EndsWith(".") is false)
			return text
		text = text + tokens(start + index + 1)
	text
MethodIssues ValidationIssues
	Twice.MethodIssues.Length is 0 and Long.MethodIssues.First to Text is "MethodLengthMustNotExceedTwelve: Run"
	Limits(Long.lines + ("Run", "\t1") + Long.lines, false).MethodIssues is Lengthy and Long.MethodIssues.First.Line is 1
	Limits(OnlyConstants.lines, false).MethodIssues.Length is 0
	Limits(Long.lines - "\t13" + "", false).MethodIssues.Length is 0
	let shape = TypeShape(lines)
	mutable issues = List(Mutable(ValidationIssue))
	mutable start = -1
	for lines.Length + 1
		if IsTooLong(start, index)
			issues.Add(ValidationIssue("MethodLengthMustNotExceedTwelve", lines(start), start + 1))
		start = Started(shape, start, index)
	issues
IsHeader(index Number) Boolean
	Long.IsHeader(0) and Long.IsHeader(14)
	Long.IsHeader(3) is false
	(index is lines.Length) or (lines(index).StartsWith("\t") is false)
IsTooLong(start Number, index Number) Boolean
	Long.IsTooLong(0, 14)
	Long.IsTooLong(0, 13) is false
	Long.IsTooLong(-1, 14) is false
	Long.IsTooLong(1, 14) is false
	Twice.IsTooLong(0, 14) is false
	Limits(Long.lines + Long.lines, false).IsTooLong(0, 15) is false
	IsHeader(index) and (start >= 0) and (index - start > MaxMethodLines * scale)
Started(shape TypeShape, start Number, index Number) Number
	Long.Started(TypeShape(Long.lines), 5, 0) is 0
	Long.Started(TypeShape(Long.lines), 5, 3) is 5
	Long.Started(TypeShape(Long.lines), 5, 14) is 5
	Sample.Started(TypeShape(Sample.lines), 5, 0) is 5
	if (index < lines.Length) and (lines(index) is "")
		return -1
	(index < lines.Length) and shape.IsMethodHeader(lines(index)) then index else start
CountIssues ValidationIssues
	Limits(("has a Number", "has b Number"), false).CountIssues.Length is 0 and Methods.CountIssues.Length is 1
	Limits(OnlyConstants.lines, false).CountIssues.Length is 0 and Limits(Methods.lines, true).CountIssues.Length is 0
	Limits(OnlyConstants.lines + "constant Q" + "constant R" + "Run", false).CountIssues.First.target is "18 > 17"
	Methods.CountIssues.First to Text is "MethodCountMustNotExceedLimit: 17 > 16"
	Limits(Methods.lines, false, 2).CountIssues.Length is 0
	let shape = TypeShape(lines)
	mutable methods = 0
	for lines
		methods = methods + (shape.IsMethodHeader(value) then 1 else 0)
	let members = Count("has ") + Count("constant ")
	let methodIssues = Counted("MethodCountMustNotExceedLimit", isBase then 0 else methods, MaxMethods * scale)
	methodIssues + Counted("MemberCountShouldNotExceedLimit", members, MemberLimit(methods, members))
MemberLimit(methods Number, members Number) Number
	OnlyConstants.MemberLimit(0, 16) is 40 and OnlyConstants.MemberLimit(1, 16) is 17
	OnlyConstants.MemberLimit(0, 3) is 17 and (Sample.MemberLimit(1, 1) is 15)
	Sample.MemberLimit(0, 0) is 40
	Twice.MemberLimit(0, 0) is 80 and Twice.MemberLimit(1, 0) is 30
	constant OnlyConstantsLimit = 40
	let extra = Count("constant ").Clamp(0, ExtraConstants)
	((methods is 0) and (members is Count("constant ")) then OnlyConstantsLimit else MaxMembers + extra) * scale
Count(start Text) Number
	OnlyConstants.Count("constant ") is 16
	Sample.Count("has ") is 1
	Long.Count("\t1") is 5
	mutable count = 0
	for lines
		count = count + (value.StartsWith(start) then 1 else 0)
	count
Counted(rule Text, count Number, limit Number) ValidationIssues
	Sample.Counted("A", 16, 15).First to Text is "A: 16 > 15"
	Sample.Counted("A", 15, 15).Length is 0
	if count <= limit
		return List(ValidationIssue)
	List(ValidationIssue) + ValidationIssue(rule, count to Text + " > " + limit, 1)
Scale(path Text) Number
	Limits.Scale("Games/Generated/Atlas.strict") is 10
	Limits.Scale("Games\\Atlas.strict") is 1
	Limits.Scale("Content/SheetCatalog.strict") is 2
	Limits.Scale("Games\\Generated\\Atlas.strict") is 10
	let folder = Path(Path(path).PathOnly.text).FileName.text
	folder is "Generated" then 10 else (folder is "Content" then 2 else 1)