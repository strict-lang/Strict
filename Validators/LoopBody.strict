has loop SyntaxNode
has constants Texts
has isNested Boolean = true
has isShort Boolean = true
constant Body = ("Run(steps Number, values Numbers, range Number, isGray Boolean) Number", "\tfor steps + 1")
constant Edged = LoopBody(BodyParser(Body + "\t\tindex is steps then 0 else index / steps").Block(1, 1).children.First, List(Text))
constant Hoisting = LoopBody(BodyParser(Body + "\t\tindex * (1000 / steps)").Block(1, 1).children.First, List(Text))
constant Guarding = LoopBody(BodyParser(Body + "\t\trange is 0 then 0 else (value - steps) / range").Block(1, 1).children.First, List(Text))
constant Plain = ("\t\tlet moded = isGray then value else value * 2", "\t\tlet random = 1.Random < 0.5 then 0 else value")
constant Clean = LoopBody(BodyParser(Body + Plain + "\t\t\"Step \" + steps + \": \" + value * (steps - 1)").Block(1, 1).children.First, List(Text))
constant FirstHint = " is only true in the first iteration: handle the first element before the loop and loop over the rest"
constant LastHint = " is only true in the last iteration: loop over the other elements and add the last one after the loop"
constant GuardHint = " does not change in the loop: check it once before the loop"
constant InvariantHint = " does not change in the loop: compute it once with a let before the loop"
Issues List(ValidationIssue)
	Edged.Issues.First to Text is "LoopEdgeMustBeOutsideLoop: index is steps" + LastHint
	Edged.Issues.First.Line is 3
	Hoisting.Issues.First to Text is "LoopInvariantMustBeOutsideLoop: 1000 / steps" + InvariantHint
	Guarding.Issues.First to Text is "LoopGuardMustBeOutsideLoop: range is 0" + GuardHint
	Clean.Issues.Length is 0
	LoopBody(Edged.loop, List(Text), false).Issues.Length is 0
	LoopBody(Hoisting.loop, List(Text), true, false).Issues.Length is 0
	Clean.loop.children.Last.children.Length is 3
	Found(loop.children.Last, loop.line, LoopNames.Of(loop, constants, List(Text)))
Found(node SyntaxNode, line Number, names LoopNames) List(ValidationIssue)
	Hoisting.Found(SyntaxNode("Identifier", "steps"), 1, LoopNames.Steps).Length is 0
	Hoisting.Found(Hoisting.loop, 1, LoopNames.Steps).Length is 0
	Hoisting.Found(Hoisting.loop.children.Last, 7, LoopNames.Steps).First.Line is 3
	Edged.Found(Edged.loop.children.Last, 7, LoopNames(List(Text), List(Text))).Length is 1
	let at = node.line > 0 then node.line else line
	let own = Issue(node, at, names)
	if own.Length > 0
		return own
	mutable found = List(Mutable(ValidationIssue))
	for node.Kind is "For" then List(SyntaxNode) else node.children
		found = found + Found(value, at, names)
	found
Issue(node SyntaxNode, at Number, names LoopNames) List(ValidationIssue)
	Hoisting.Issue(SyntaxNode("Number", "1"), 1, LoopNames.Steps).Length is 0
	(Guarding.Issues.Length is 1) and (Clean.Issues.Length is 0)
	Edged.Issue(SyntaxNode("Binary", "+", Edged.loop.children.Last.children(0).children), 1, LoopNames.Steps).Length is 0
	Edged.Issue(SyntaxNode("If", "if", Edged.loop.children.Last.children), 1, LoopNames.Steps).Length is 1
	Hoisting.Issue(SyntaxNode("Binary", "else", Hoisting.loop.children), 1, LoopNames.Steps).Length is 0
	Edged.Issue(SyntaxNode("Call", "else", Edged.loop.children.Last.children(0).children), 1, LoopNames.Steps).Length is 0
	Hoisting.Issue(StatementParser(Tokenizer("x then y else 0").Tokens).ParseStatement, 1, LoopNames.Steps).Length is 1
	if (node.Kind is "Binary") and (node.text is "else") and (node.children(0).text is "then")
		return Conditional(node.children(0).children(0), (node.children(0).children(1), node.children(1)), at, names)
	if node.Kind is "If"
		return Conditional(node.children(0), node.children.Last.children, at, names)
	Hoisted(node, at, names)
Hoisted(node SyntaxNode, at Number, names LoopNames) List(ValidationIssue)
	Hoisting.Issues(0).target is "1000 / steps" + InvariantHint
	(Clean.Issues.Length is 0) and (LoopBody(Hoisting.loop, List(Text), true, false).Issues.Length is 0)
	LoopBody(Guarding.loop, List(Text), false).Issues.Length is 0
	Hoisting.Hoisted(StatementParser(Tokenizer("1000 / 8").Tokens).ParseStatement, 1, LoopNames.Steps).Length is 0
	Hoisting.Hoisted(SyntaxNode("Call", "*", (SyntaxNode("Identifier", "steps"))), 1, LoopNames.Steps).Length is 0
	let isArithmetic = (node.Kind is "Binary") and (node.text is in ("+", "-", "*", "/", "%", "^"))
	let isNumeric = ((node to Text).IndexOf("\"") < 0) and IsCostly(node)
	let isHoisted = isShort and isArithmetic and isNumeric and names.IsInvariant(node) and LoopNames.HasName(node)
	let issue = ValidationIssue("LoopInvariantMustBeOutsideLoop", node to Text + InvariantHint, at)
	isHoisted then List(ValidationIssue) + issue else List(ValidationIssue)
Conditional(condition SyntaxNode, branches SyntaxNodes, at Number, names LoopNames) List(ValidationIssue)
	Hoisting.Conditional(SyntaxNode("Identifier", "steps"), List(SyntaxNode), 1, LoopNames.Steps).Length is 0
	(Guarding.Issues(0).target is "range is 0" + GuardHint) and (Edged.Issues.Length is 1) and (Clean.Issues.Length is 0)
	LoopBody(SyntaxNode("For", "for as long as", Guarding.loop.children), List(Text)).Issues.Length is 0
	Hoisting.Conditional(SyntaxNode("Number", "0"), (SyntaxNode("Number", "0")), 1, LoopNames.Steps).Length is 0
	if isNested is false
		return List(ValidationIssue)
	let edge = Edge(condition)
	if edge is not ""
		return List(ValidationIssue) + ValidationIssue("LoopEdgeMustBeOutsideLoop", edge, at)
	let isInvariant = (loop.text is not "for as long as") and names.IsInvariant(condition) and LoopNames.HasName(condition)
	let issue = ValidationIssue("LoopGuardMustBeOutsideLoop", condition to Text + GuardHint, at)
	isInvariant and IsGuarding(branches) then List(ValidationIssue) + issue else List(ValidationIssue)
IsCostly(node SyntaxNode) Boolean
	Hoisting.IsCostly(SyntaxNode("Binary", "/"))
	Hoisting.IsCostly(SyntaxNode("Binary", "-", (SyntaxNode("Identifier", "steps"), SyntaxNode("Number", "1")))) is false
	Hoisting.IsCostly(SyntaxNode("Binary", "%")) and Hoisting.IsCostly(SyntaxNode("Binary", "^"))
	Hoisting.IsCostly(SyntaxNode("Binary", "*"))
	Hoisting.IsCostly(SyntaxNode("Binary", "+")) is false
	Hoisting.IsCostly(StatementParser(Tokenizer("(steps - 1) + 2").Tokens).ParseStatement)
	Hoisting.IsCostly(StatementParser(Tokenizer("2 + (steps - 1)").Tokens).ParseStatement)
	let first = node.children.Length > 0 then node.children.First.Kind else ""
	let last = node.children.Length > 0 then node.children.Last.Kind else ""
	(node.text is in ("*", "/", "%", "^")) or (first is "Binary") or (last is "Binary")
IsGuarding(branches SyntaxNodes) Boolean
	Hoisting.IsGuarding(List(SyntaxNode) + SyntaxNode("Number", "0"))
	Hoisting.IsGuarding(List(SyntaxNode) + SyntaxNode("Identifier", "value")) is false
	for branches
		if value.Kind is in ("Number", "Text", "Boolean", "Return")
			return true
	false
Edge(node SyntaxNode) Text
	Guarding.Issue(StatementParser(Tokenizer("index then 0 else 1").Tokens).ParseStatement, 1, LoopNames.Steps).Length is 0
	Hoisting.Edge(SyntaxNode("Identifier", "index")) is ""
	Edged.Edge(Edged.loop.children.Last) is "index is steps" + LastHint
	Edged.Edge(StatementParser(Tokenizer("index is 0").Tokens).ParseStatement) is "index is 0" + FirstHint
	let edges = LoopEdge(loop)
	let edge = edges.Found(node)
	edge.Kind is "Missing" then "" else edge to Text + (edges.IsFirst(edge) then FirstHint else LastHint)
