has lines Texts
constant NoMethods = Scope(List(Text), List(Text))
constant Upper = MagicNumbers(("Upper Character", "	Character(\"a\").Upper is \"A\"", "	if number is in Range(97, 123)", "		return Character(number - 32)", "	value"))
constant Plain = MagicNumbers(("Run Number", "	Run is 300", "	constant Width = 320", "	let total = 3 + 100", "	total * 1000 + 0.5 + Width"))
Issues List(ValidationIssue)
	Upper.Issues.Length is 2
	Upper.Issues.First to Text is "NumberMustBeNamedConstant: 97, name it with a constant"
	Upper.Issues.Last.Line is 3
	Plain.Issues.Length is 0
	mutable issues = List(Mutable(ValidationIssue))
	for lines
		if TypeShape(lines).IsMethodHeader(value)
			issues = issues + Body(index)
	issues
Body(header Number) List(ValidationIssue)
	Upper.Body(0).Length is 2
	MagicNumbers(("Run", "	Run is 300", "	300")).Body(0).Length is 1
	mutable issues = List(Mutable(ValidationIssue))
	let last = FileCheck.LastLine(lines, header)
	let methods = TypeShape(lines).MethodScope
	mutable isTest = true
	for Range(header + 1, last + 1)
		let code = lines(value).Trim
		isTest = isTest and (value < last) and Duplicates.IsTest(code) and (IsPlainCall(code, methods) is false)
		if (isTest is false) and (code.StartsWith("constant ") is false)
			issues = issues + Numbers(code, value + 1)
	issues
IsPlainCall(code Text, methods Scope) Boolean
	MagicNumbers(("Run", "	Label(97)", "	1")).Body(0).Length is 1
	MagicNumbers(("IsOdd(number Number) Boolean", "	IsOdd(97)", "	number")).Body(0).Length is 0
	(Plain.IsPlainCall("Label(97).IsShown", NoMethods) or Plain.IsPlainCall("A(1) is A(1)", NoMethods)) is false
	(Plain.IsPlainCall("A(1) < A(2)", NoMethods) or Plain.IsPlainCall("A(1) > A(2)", NoMethods)) is false
	(Plain.IsPlainCall("Label", NoMethods) or Plain.IsPlainCall("A.B(1)", NoMethods)) is false
	Plain.IsPlainCall("A(1) + 2", NoMethods) is false
	let tokens = Tokenizer(code).Tokens
	let isCompared = (" is " is in code) or (" < " is in code) or (" > " is in code) or (")." is in code)
	if isCompared or (tokens.Length < 3) or (tokens(1) is not "(") or (tokens.Last is not ")")
		return false
	methods.TypeOf(tokens(0)) is not "Boolean"
Numbers(code Text, line Number) List(ValidationIssue)
	Plain.Numbers("x + 97", 2).First.Line is 2
	Plain.Numbers("\"97\" + 10", 2).Length is 0
	for Tokenizer(code).Tokens
		if IsMagic(value)
			ValidationIssue("NumberMustBeNamedConstant", value + ", name it with a constant", line)
IsMagic(token Text) Boolean
	Plain.IsMagic("97") and Plain.IsMagic("96") and Plain.IsMagic("0.25") and Plain.IsMagic("11")
	(Plain.IsMagic("7") or Plain.IsMagic("10") or Plain.IsMagic("1000") or Plain.IsMagic("0.5")) is false
	(Plain.IsMagic("32") or Plain.IsMagic("65536") or Plain.IsMagic("4194304")) is false
	(Plain.IsMagic("0.001") or Plain.IsMagic("x") or Plain.IsMagic("\"97\"")) is false
	if Tokenizer.IsDigit(token(0)) is false
		return false
	((token.Length is 1) or (token is "0.5") or IsPowerOfTen(token) or IsPowerOfTwo(token to Number)) is false
IsPowerOfTen(token Text) Boolean
	Plain.IsPowerOfTen("100") and Plain.IsPowerOfTen("0.01") and (Plain.IsPowerOfTen("101") is false)
	MagicNumbers(("Run Boolean", "	value is 97")).Body(0).Length is 1
	MagicNumbers(("Run", "	Run is 300", "	let a = 33", "	a is 97", "	a")).Body(0).Length is 2
	Plain.IsMagic("Width") is false
	let digits = token.Replace(".", "")
	digits.Replace("0", "") is "1"
IsPowerOfTwo(number Number) Boolean
	Plain.IsPowerOfTwo(64) and Plain.IsPowerOfTwo(4294967296) and Plain.IsPowerOfTwo(16)
	(Plain.IsPowerOfTwo(96) or Plain.IsPowerOfTwo(0.25) or Plain.IsPowerOfTwo(24)) is false
	(Plain.IsPowerOfTwo(4294967297) or Plain.IsPowerOfTwo(1)) is false
	(number > 1) and ((2 ^ (number.Logarithm / 2.Logarithm).Round) is number)
