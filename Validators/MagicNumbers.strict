has lines Texts
constant Upper = MagicNumbers(("Upper Character", "	Character(\"a\").Upper is \"A\"", "	if number is in Range(97, 123)", "		return Character(number - 32)", "	value"))
constant Plain = MagicNumbers(("Run Number", "	Run is 300", "	constant Width = 320", "	let total = 3 + 100", "	total * 1000 + 0.5 + Width"))
Issues List(ValidationIssue)
	Upper.Issues.Length is 3
	Upper.Issues.First to Text is "NumberMustBeNamedConstant: 97, name it with a constant"
	Upper.Issues.Last.Line is 4
	Plain.Issues.Length is 0
	mutable issues = List(Mutable(ValidationIssue))
	for lines
		if TypeShape(lines).IsMethodHeader(value)
			issues = issues + Body(index)
	issues
Body(header Number) List(ValidationIssue)
	Upper.Body(0).Length is 3
	MagicNumbers(("Run", "	Run is 300", "	300")).Body(0).Length is 1
	mutable issues = List(Mutable(ValidationIssue))
	let last = FileCheck.LastLine(lines, header)
	mutable isTest = true
	for Range(header + 1, last + 1)
		let code = lines(value).Trim
		isTest = isTest and (value < last) and Duplicates.IsTest(code)
		if (isTest is false) and (code.StartsWith("constant ") is false)
			issues = issues + Numbers(code, value + 1)
	issues
Numbers(code Text, line Number) List(ValidationIssue)
	Plain.Numbers("x + 97", 2).First.Line is 2
	Plain.Numbers("\"97\" + 10", 2).Length is 0
	for Tokenizer(code).Tokens
		if IsMagic(value)
			ValidationIssue("NumberMustBeNamedConstant", value + ", name it with a constant", line)
IsMagic(token Text) Boolean
	Plain.IsMagic("97") and Plain.IsMagic("32") and Plain.IsMagic("0.25") and Plain.IsMagic("11")
	(Plain.IsMagic("7") or Plain.IsMagic("10") or Plain.IsMagic("1000") or Plain.IsMagic("0.5")) is false
	(Plain.IsMagic("0.001") or Plain.IsMagic("x") or Plain.IsMagic("\"97\"")) is false
	if Tokenizer.IsDigit(token.Substring(0, 1)) is false
		return false
	let isSmall = (token.Length is 1) or (token is "10")
	(isSmall or (token is "0.5") or IsPowerOfTen(token)) is false
IsPowerOfTen(token Text) Boolean
	Plain.IsPowerOfTen("100") and Plain.IsPowerOfTen("0.01") and (Plain.IsPowerOfTen("101") is false)
	MagicNumbers(("Run Boolean", "	value is 97")).Body(0).Length is 1
	MagicNumbers(("Run", "	Run is 300", "	let a = 32", "	a is 97", "	a")).Body(0).Length is 2
	Plain.IsMagic("Width") is false
	let digits = token.Replace(".", "")
	digits.Replace("0", "") is "1"
