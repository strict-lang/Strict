has lines Texts
has scale Number = 1
has typeName Text = ""
constant MaxTests = 10
constant MaxLets = 10
constant MaxProduction = 10
constant VmLoops = List(Text) + "Frame.Finished"
constant MaxVmLoop = 12
constant Tested = MethodBudgets(("Run Number", "	Run is 1", "	constant one = 1", "	Run > 0", "	let a = 1", "	if a > 0", "		let b = 2", "		return b", "	a"))
constant Looping = ("Finished", "	a", "	b", "	c", "	d", "	e", "	f", "	g", "	h", "	i", "	j", "	k", "	l")
constant Busy = MethodBudgets(("Run", "	a", "	b", "	c", "	d", "	e", "	f", "	g", "	h", "	i", "	j", "	k"))
Issues List(ValidationIssue)
	Busy.Issues.First to Text is "ProductionLinesMustNotExceedTen: Run has 11"
	Busy.Issues.First.Line is 1 and Tested.Issues.Length is 0 and MethodBudgets(Busy.lines, 2).Issues.Length is 0
	MethodBudgets(Looping, 1, "Frame").Issues.Length is 0 and MethodBudgets(Looping, 1, "Other").Issues.Length is 1
	shape = TypeShape(lines)
	mutable issues = List(Mutable(ValidationIssue))
	for lines
		if shape.IsMethodHeader(value)
			issues = issues + Exceeded(index, Counts(index))
	issues
Exceeded(header Number, counts Numbers) List(ValidationIssue)
	Busy.Exceeded(0, (11, 11, 1)).First to Text is "TestLinesMustNotExceedTen: Run has 11"
	Busy.Exceeded(0, (11, 11, 1)).Last to Text is "LetLinesMustNotExceedTen: Run has 11"
	Busy.Exceeded(0, (10, 10, 10)).Length is 0
	name = Tokenizer(lines(header)).Tokens.First
	constant rules = ("TestLinesMustNotExceedTen", "LetLinesMustNotExceedTen", "ProductionLinesMustNotExceedTen")
	limits = (MaxTests, MaxLets, typeName + "." + name is in VmLoops then MaxVmLoop else MaxProduction)
	for counts
		if value > limits(index) * scale
			ValidationIssue(rules(index), name + " has " + value, header + 1)
Counts(header Number) Numbers
	Tested.Counts(0) is (2, 2, 4) and Busy.Counts(0) is (0, 0, 11)
	last = FileCheck.LastLine(lines, header)
	tests = Tests(header, last)
	lets = Lets(header, last).Length
	(tests, lets, last - header - tests - lets)
Tests(header Number, last Number) Number
	Tested.Tests(0, 8) is 2 and Busy.Tests(0, 11) is 0
	mutable tests = 0
	mutable isTesting = true
	for Range(header + 1, last + 1)
		code = lines(value).Trim
		isConstant = code.StartsWith("constant ")
		isTesting = isTesting and value < last and (isConstant or Duplicates.IsTest(code))
		tests = tests + (isTesting and isConstant is false then 1 else 0)
	tests
Lets(header Number, last Number) Numbers
	Tested.Lets(0, 8) is (2, 4) and Busy.Lets(0, 11).Length is 0
	MethodBudgets(("Run", "\tmutable count = 1", "\tcount = count + 1", "\tcount")).Lets(0, 3).Length is 0
	for Range(header + 1, last + 1)
		code = lines(value).Trim
		tokens = Tokenizer(code).Tokens
		isLet = tokens.Length > 1 and tokens(1) is "=" and IsMutable(header, tokens(0)) is false or code.StartsWith("let ")
		if code.StartsWith("constant ") or lines(value).StartsWith("\t\t") is false and isLet
			value
IsMutable(header Number, name Text) Boolean
	Tested.IsMutable(0, "a") is false
	MethodBudgets(("Run", "\tmutable count = 1", "\tcount")).IsMutable(0, "count")
	for Range(header + 1, FileCheck.LastLine(lines, header) + 1)
		if lines(value).Trim.StartsWith("mutable " + name + " ")
			return true
	false
