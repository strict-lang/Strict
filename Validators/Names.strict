has lines Texts
constant Looping = Names(("Filled(value Number) Numbers", "\tfor 3", "\t\tvalue"))
constant Sample = Names(("has from Text", "constant Number = 3", "ListNumbers Number", "\tlet constant = 1", "\t1"))
constant Nested = Names(("Pairs Numbers", "\tfor 2", "\t\tfor value + 1", "\t\t\tindex"))
constant Shared = Names(("Run", "\tfor 2", "\t\tfor 3", "\t\t\t1", "\t\t2"))
constant Tripled = Names(("Run", "\tfor 2", "\t\tfor y, x in 3, 4", "\t\t\tfor value + 5", "\t\t\t\t1"))
constant Ordinals = ("first", "second", "third", "fourth", "fifth")
Issues ValidationIssues
	Sample.Issues.Length is 3
	Names(("has text", "Run(count Number) Number", "\tlet total = count", "\ttotal")).Issues.Length is 0
	Nested.Issues.Length is 1
	mutable issues = List(Mutable(ValidationIssue))
	for lines
		issues = issues + LineIssues(value, index) + LoopIssues(index)
	issues
LoopIssues(at Number) ValidationIssues
	Nested.LoopIssues(1).First to Text is "NestedLoopsMustNameIterators: for first, second in 2, first + 1"
	Nested.LoopIssues(1).First.Line is 2
	Nested.LoopIssues(2).Length is 0
	Shared.LoopIssues(1).Length is 0
	Tripled.LoopIssues(1).First to Text is "NestedLoopsMustNameIterators: for first, y, x, fourth in 2, 3, 4, x + 5"
	Tripled.LoopIssues(2).Length is 0
	if (IsNested(at) is false) or (at > 0) and IsNested(at - 1)
		return List(ValidationIssue)
	List(ValidationIssue) + ValidationIssue("NestedLoopsMustNameIterators", Merged(at, List(Text), List(Text)), at + 1)
IsNested(at Number) Boolean
	Nested.IsNested(1)
	Nested.IsNested(2) is false
	Shared.IsNested(1) is false
	let isLoop = (at + 1 < lines.Length) and (Iterated(lines(at)).Length > 0) and (Iterated(lines(at + 1)).Length > 0)
	isLoop and (BodyParser.Indent(lines(at + 1)) is BodyParser.Indent(lines(at)) + 1) and (IsShared(at) is false)
Iterated(line Text) Texts
	Nested.Iterated("\tfor 2") is ("2")
	Nested.Iterated("\tfor y, x in 2, Range(0, 3)") is ("2", "Range(0, 3)")
	Nested.Iterated("\tfor width, height in sizes").Length is 0
	Nested.Iterated("\tfor as long as true").Length is 0
	Nested.Iterated("for Iterator(Number)").Length is 0
	let code = line.Trim
	if (line.StartsWith("\t") is false) or (code.StartsWith("for ") is false) or code.StartsWith("for as long as ")
		return List(Text)
	if StatementParser(Tokenizer(code).Tokens).IsNamed is false
		return List(Text) + code.Substring(4, code.Length - 4)
	let parts = Callees.Parts(code.Substring(code.IndexOf(" in ") + 4, code.Length - code.IndexOf(" in ") - 4))
	parts.Length > 1 then parts else List(Text)
Merged(at Number, names Texts, iterables Texts) Text
	Nested.Merged(1, List(Text), List(Text)) is "for first, second in 2, first + 1"
	Tripled.Merged(1, List(Text), List(Text)) is "for first, y, x, fourth in 2, 3, 4, x + 5"
	let tokens = Tokenizer(lines(at).Trim).Tokens
	let isNamed = StatementParser(tokens).IsNamed
	let named = names + (isNamed then StatementParser(tokens).IteratorNames else List(Text) + Ordinal(names.Length))
	let own = isNamed then Iterated(lines(at)) else List(Text) + Rewritten(Iterated(lines(at)).First, names)
	if IsNested(at)
		return Merged(at + 1, named, iterables + own)
	"for " + Text.Combine(named) + " in " + Text.Combine(iterables + own)
Rewritten(iterable Text, names Texts) Text
	Nested.Rewritten("value + 1", List(Text) + "first") is "first + 1"
	Nested.Rewritten("value + 1", List(Text)) is "value + 1"
	names.Length is 0 then iterable else SyntaxParser(Renamed(Tokenizer(iterable).Tokens, names.Last)).Parse to Text
Ordinal(position Number) Text
	Nested.Ordinal(1) is "second"
	Nested.Ordinal(9) is "iterator10"
	position < Ordinals.Length then Ordinals(position) else "iterator" + (position + 1)
IsShared(at Number) Boolean
	Nested.IsShared(1) is false
	Shared.IsShared(1)
	let depth = BodyParser.Indent(lines(at))
	for Range(at + 2, lines.Length)
		let indent = BodyParser.Indent(lines(value))
		if indent <= depth + 1
			return indent is depth + 1
	false
Renamed(tokens Texts, name Text) Texts
	Nested.Renamed(("value", "+", "1"), "first") is ("first", "+", "1")
	Nested.Renamed(("x", ".", "value"), "first") is ("x", ".", "value")
	for tokens
		let before = index is 0 then "" else tokens(index - 1)
		(value is "value") and (before is not ".") then name else value
LineIssues(line Text, number Number) ValidationIssues
	Sample.LineIssues("\tlet constant = 1", 3).First.Line is 4
	Looping.LineIssues(Looping.lines.First, 0).First to Text is "LoopNameMustNotBeDeclared: value"
	let isHeader = TypeShape(lines).IsMethodHeader(line)
	mutable issues = List(Mutable(ValidationIssue))
	for DeclaredNames(line)
		issues = issues + NameIssues(line, value, isHeader and (index is 0), number + 1)
	issues
NameIssues(line Text, name Text, isMethod Boolean, number Number) ValidationIssues
	Sample.NameIssues("has from Text", "from", false, 1).First to Text is "CannotUseKeywordsAsName: from"
	Sample.NameIssues("in(other) Boolean", "in", true, 2).Length is 0
	mutable issues = List(Mutable(ValidationIssue))
	if (isMethod is false) and (name is in DefaultCheck.Keywords)
		issues.Add(ValidationIssue("CannotUseKeywordsAsName", name, number))
	if IsListPrefixed(line, name)
		issues.Add(ValidationIssue("ListPrefixIsNotAllowedUseImplementationTypeNameInPlural", name, number))
	if IsMisnamedConstant(line, name)
		issues.Add(ValidationIssue("ConstantNameMustNotBeATypeOrMethodName", name, number))
	if (name is in DefaultCheck.LoopVariables) and DefaultCheck.HasLoop(lines, number - 1)
		issues.Add(ValidationIssue("LoopNameMustNotBeDeclared", name, number))
	issues
IsListPrefixed(line Text, name Text) Boolean
	Sample.IsListPrefixed("ListNumbers Number", "ListNumbers")
	Sample.IsListPrefixed("Listen(port Number) Number", "Listen") is false
	Sample.IsListPrefixed("\tlet listed = 1", "listed") is false
	let isTyped = TypeShape(lines).IsMethodHeader(line) or line.StartsWith("has ") or line.StartsWith("mutable ")
	let isListed = (name.StartsWith("List") or name.StartsWith("list")) and (name.Length > 4)
	let next = isListed then name.Substring(4, 1) else ""
	isTyped and isListed and (next.Upper is next) and (next is not "(")
IsMisnamedConstant(line Text, name Text) Boolean
	Sample.IsMisnamedConstant("constant Number = 3", "Number") is false
	Sample.IsMisnamedConstant("constant ListNumbers = 1", "ListNumbers")
	line.StartsWith("constant ") and IsMethodName(name)
IsMethodName(name Text) Boolean
	Sample.IsMethodName("ListNumbers")
	Sample.IsMethodName("Number") is false
	let shape = TypeShape(lines)
	for lines
		if shape.IsMethodHeader(value) and (Tokenizer(value).Tokens.First is name)
			return true
	false
DeclaredNames(line Text) Texts
	Sample.DeclaredNames("\tlet constant = 1") is ("constant")
	Sample.DeclaredNames("Add(first Number, from Text) Number") is ("Add", "first", "from")
	Sample.DeclaredNames("\t1").Length is 0
	Looping.DeclaredNames("\tfor value, x in 2, 3") is ("value", "x")
	let tokens = Tokenizer(line.Trim).Tokens
	if line.StartsWith("\t") and StatementParser(tokens).IsNamed
		return StatementParser(tokens).IteratorNames
	if (tokens.Length > 1) and (tokens(0) is in ("let", "constant", "mutable", "has"))
		return List(Text) + (line.StartsWith("\t") then tokens(1) else HeaderTokens(tokens).MemberName)
	if TypeShape(lines).IsMethodHeader(line) is false
		return List(Text)
	(List(Text) + tokens(0)) + HeaderTokens(tokens).ParameterNames