has lines Texts
constant Searching = NotFoundResults(("Find(name Text) Number", "	Find(\"a\") is -1", "	name is \"b\" then 0 else -1"))
constant Returning = NotFoundResults(("Find(name Text) Number", "	Find(\"a\") is -1", "	if name is \"a\"", "		return -1", "	0"))
constant Signing = NotFoundResults(("Sign Number", "	Sign is 1", "	value > 0 then 1 else value < 0 then -1 else 0"))
Issues List(ValidationIssue)
	Searching.Issues.First to Text is "NotFoundMustBeNamed: Find returns -1, use Number.NotFound"
	Searching.Issues.First.Line is 3 and Returning.Issues.First.Line is 4 and Signing.Issues.Length is 0
	codes = StatusCodes(lines)
	mutable issues = List(Mutable(ValidationIssue))
	for lines
		if codes.IsNumbered(index)
			issues = issues + Found(codes, index)
	issues
Found(codes StatusCodes, header Number) List(ValidationIssue)
	Searching.Found(StatusCodes(Searching.lines), 0).Length is 1
	Signing.Found(StatusCodes(Signing.lines), 0).Length is 0
	name = Tokenizer(lines(header)).Tokens.First
	for codes.Results(header)
		literals = codes.Literals(value)
		if "-1" is in literals and "1" is not in literals
			ValidationIssue("NotFoundMustBeNamed", name + " returns -1, use Number.NotFound", header + index + 2)
