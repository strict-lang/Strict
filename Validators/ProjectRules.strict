has root Text
constant Fixture = "Examples/ProjectRule/"
Check(folder Text) Number slow
	ProjectRules(".").Check(Fixture) is 0
	if File("./Any.strict").Exists
		return 0
	mutable files = List(Mutable(Text))
	for ResolveCheck.Tree(folder)
		files = files + Directory.Files(value, "*.strict")
	Issues("./Validators", files)
Issues(rules Text, files Texts) Number native
	ProjectRules(".").Issues(Fixture + "Validators", List(Text) + (Fixture + "Crate.strict")) is 1
	ProjectRules(".").Issues("Examples/Missing", List(Text) + (Fixture + "Crate.strict")) is 0
	mutable issues = 0
	for Directory.Exists(rules) then Directory.Files(rules, "*.strict") else List(Text)
		issues = issues + Count(rules, value, files)
	issues
Count(rules Text, rule Text, files Texts) Number native
	ProjectRules(".").Count(Fixture + "Validators", Fixture + "Validators/GetPrefix.strict", List(Text)) is 0
	File(Fixture + "Validators/obj/GetPrefix.strict.stamp").Exists
	key = ValidateCheck.Stamp(files + rule, List(Text))
	stamp = File(rules + "/obj/" + Path(rule).FileName.text + ".stamp")
	isCurrent = stamp.Exists then stamp.ReadText is key else false
	found = isCurrent then 0 else RunRule(rule, files)
	if found is 0 and isCurrent is false
		Directory.Create(rules + "/obj")
		stamp.Write(key)
	found
RunRule(rule Text, files Texts) Number native
	ProjectRules(".").RunRule(Fixture + "Validators/GetPrefix.strict", List(Text)) is 0
	ProjectRules(".").RunRule(Fixture + "Validators/GetPrefix.strict", List(Text) + (Fixture + "Crate.strict")) is 1
	types = Execute.Load(rule, root, false)
	if types.Length is 0
		return Error("ProjectRuleNotCompiled: " + rule)
	result = ProgramRun(Execute.Start(types, rule)).Result(types.First.Name, Arguments(files))
	isFailed = result.kind is in VmValue.ErrorKinds
	isFailed then Error("ProjectRuleFailed: " + rule + ", " + (result to Text)) else result.number
Arguments(files Texts) List(VmValue)
	ProjectRules(".").Arguments(List(Text) + "A.strict").First.text is "A.strict"
	for files
		VmValue.OfText(value)
