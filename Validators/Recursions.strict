has lines Texts
has typeName Text
constant Looping = Recursions(("has name Text", "constant Blood = Parsed(\"blood\")", "Parsed(line Text) Splash", "\tSplash.Parsed(\"a\").name is \"a\"", "\tSplash(Blood.name)"), "Splash")
constant Hint = ", the only line is the body, write the body after the test"
constant LetHint = ", a let ends the tests, so this line is the body and calls the method again: write the call into each test line"
constant Measuring = Recursions(("has number", "constant Sample = Shape(1)", "Area Number", "	let area = Sample.Area", "	area is 1"), "Shape")
constant Counting = Recursions(("Count(number) Number", "\tRecursions(1).Count(5000) is 5000", "\tnumber is 0 then 0 else 1 + Count(number - 1)"), "Recursions")
constant DeepHint = ", more than 1000 nested calls overflow the stack: use a loop or make it the only call of a line"
constant Tailing = Recursions(("Count(number) Number", "\tRecursions(1).Count(5000) is 5000", "\tnumber is 0 then 0 else Count(number - 1)"), "Recursions")
constant Operators = ("+", "-", "*", "/", "(", ",", "and", "or")
constant Placing = Recursions(("Placed Boolean", "\tRecursions(1).Placed", "Run", "\tPlaced"), "Recursions")
Issues List(ValidationIssue)
	Looping.Issues.Length is 1
	Constants + Endless + Lets + Deep
Endless List(ValidationIssue)
	Placing.Endless.First to Text is "OnlyLineCallsItself: Placed" + Hint
	Looping.Endless.Length is 0
	Recursions(("+(other) Path", "\tPath(text + other)"), "Path").Endless.Length is 0
	Recursions(("Loaded(path Text) Terrain", "\tTerrain(Mesh.Loaded(path))"), "Terrain").Endless.Length is 0
	for lines
		if TypeShape(lines).IsMethodHeader(value) and (FileCheck.LastLine(lines, index) is index + 1)
			let method = Tokenizer(value).Tokens.First
			let only = Tokenizer(lines(index + 1).Trim).Tokens
			let isNamed = method.Substring(0, 1).Lower is not method.Substring(0, 1)
			if isNamed and (method is in Called(only)) and ("then" is not in only)
				ValidationIssue("OnlyLineCallsItself", method + Hint, index + 2)
Deep List(ValidationIssue)
	Counting.Deep.First to Text is "DeepRecursion: Count nests 5000 calls" + DeepHint
	Placing.Deep.Length is 0
	Tailing.Deep.Length is 0
	for lines
		if TypeShape(lines).IsMethodHeader(value)
			let method = Tokenizer(value).Tokens.First
			let step = Step(method, Tokenizer(Duplicates.Implementation(lines, index).Replace("\n", " ")).Tokens)
			let depth = step > 0 then Deepest(method) / step else 0
			if depth > 1000
				ValidationIssue("DeepRecursion", method + " nests " + depth + " calls" + DeepHint, index + 1)
Step(method Text, tokens Texts) Number
	Counting.Step("Count", ("1", "+", "Count", "(", "number", "-", "2", ")")) is 2
	Counting.Step("Count", ("else", "Count", "(", "number", "-", "1", ")")) is 0
	Counting.Step("Count", ("1", "+", "Count", "(", "number", "/", "2", ")")) is 0
	for tokens
		let isNested = (index > 0) and (tokens(index - 1) is in Operators)
		let isCall = (index + 4 < tokens.Length) and (tokens(index + 1) is "(")
		let isStepping = isNested and isCall and (tokens(index + 3) is "-")
		if (value is method) and isStepping
			return tokens(index + 4) to Number
	0
Deepest(method Text) Number
	Counting.Deepest("Count") is 5000
	Counting.Deepest("Other") is 0
	mutable deepest = 0
	for lines
		let argument = Argument(method, Tokenizer(value.Trim).Tokens)
		if argument > deepest
			deepest = argument
	deepest
Argument(method Text, tokens Texts) Number
	Counting.Argument("Count", ("Count", "(", "5000", ")")) is 5000
	Counting.Argument("Count", ("Count", "(", "number", ")")) is 0
	for tokens
		let isLiteral = (index + 3 < tokens.Length) and (tokens(index + 1) is "(") and (tokens(index + 3) is ")")
		if (value is method) and isLiteral and (tokens(index + 2).Substring(0, 1) is in "0123456789")
			return tokens(index + 2) to Number
	0
Constants List(ValidationIssue)
	Looping.Constants.First to Text is "ConstantUsesItself: Blood calls Parsed, which uses Blood"
	Recursions(Duplicates.Copy, "Copy").Constants.Length is 0
	for lines
		if value.StartsWith("constant ")
			let tokens = Tokenizer(value).Tokens
			let user = Using(tokens(1), tokens, List(Text))
			if user is not ""
				ValidationIssue("ConstantUsesItself", tokens(1) + " calls " + user + ", which uses " + tokens(1), index + 1)
Using(name Text, tokens Texts, visited Texts) Text
	Looping.Using("Blood", ("Parsed", "(", ")"), List(Text)) is "Parsed"
	Looping.Using("Blood", List(Text) + "name", List(Text)) is ""
	Looping.Using("Blood", ("Other", ".", "Parsed"), List(Text)) is ""
	let called = Called(tokens)
	for lines
		if TypeShape(lines).IsMethodHeader(value) and (Tokenizer(value).Tokens.First is in called)
			let method = Tokenizer(value).Tokens.First
			let body = Tokenizer(Duplicates.Implementation(lines, index).Replace("\n", " ")).Tokens
			if (method is not in visited) and ((name is in Called(body)) or (Using(name, body, visited + method) is not ""))
				return method
	""
Called(tokens Texts) Texts
	"Parsed" is not in Looping.Called(("Other", ".", "Parsed", "Make"))
	"Blood" is in Looping.Called(("Splash", ".", "Blood"))
	for tokens
		if IsOwn(tokens, index)
			value
IsOwn(tokens Texts, position Number) Boolean
	Looping.IsOwn(("Splash", "(", "1", ")", ".", "Blood"), 5)
	Looping.IsOwn(("Other", ".", "Blood"), 2) is false
	Looping.IsOwn(("Character", "(", "8", ")", "to", "Text"), 4) is false
	let isConverted = (position > 0) and (tokens(position) is "to")
	if (isConverted is false) and ((position is 0) or (tokens(position - 1) is not "."))
		return true
	let instance = tokens(position - (isConverted then 1 else 2))
	(instance is typeName) or (instance is ")") and (tokens.First is typeName)
Lets List(ValidationIssue)
	Measuring.Lets.First to Text is "LetCallsItself: Area" + LetHint
	Placing.Lets.Length is 0
	mutable method = ""
	mutable issues = List(Mutable(ValidationIssue))
	for lines
		if TypeShape(lines).IsMethodHeader(value)
			method = Tokenizer(value).Tokens.First
		if value.Trim.StartsWith("let ") and IsThroughSample(value, method)
			issues.Add(ValidationIssue("LetCallsItself", method + LetHint, index + 1))
	issues
IsThroughSample(line Text, method Text) Boolean
	Measuring.IsThroughSample("	let area = Sample.Area", "Area")
	Measuring.IsThroughSample("	let area = Other.Area", "Area") is false
	Measuring.IsThroughSample("	let area = Other.Sample.Area", "Area") is false
	let tokens = Tokenizer(line.Trim).Tokens
	for tokens
		let isOwn = (index > 1) and (tokens(index - 2) is in Samples) and ((index < 3) or (tokens(index - 3) is not "."))
		if (value is method) and isOwn and (tokens(index - 1) is ".")
			return true
	false
Samples Texts
	Measuring.Samples is ("Sample")
	for lines
		if value.StartsWith("constant ") and (value.IndexOf(" = " + typeName + "(") > 0)
			Tokenizer(value).Tokens(1)
