has lines Texts
constant Filed = RepeatedCalls(("Read Texts", "	Read is (\"a\")", "	File(path).Exists and File(path).Exists then File(path).ReadLines else List(Text)"))
constant Written = RepeatedCalls(("Write", "	File(path).Write(\"a\")", "	File(path).Write(\"b\")"))
constant Typed = RepeatedCalls(("Read Texts", "	let empty = List(Text)", "	path is \"\" then List(Text) else empty"))
constant Fixed = RepeatedCalls(("Fixed Number", "	Fixed is 1", "	mutable text = \"a\"", "	if text.IndexOf(\".\") < 0", "		text = text + \".\"", "	text.IndexOf(\".\")"))
constant Rounded = RepeatedCalls(("Sum(a Number) Number", "	Sum(1) is 2", "	a.Round(1) + a.Round(1)"))
constant Recreated = RepeatedCalls(("Make Boolean", "	Make is true", "	if Directory.Exists(folder)", "		return true", "	Directory.Create(folder) is Error then false else Directory.Exists(folder)"))
constant Reads = ("Exists", "ReadLines", "ReadText", "ReadBytes", "Length", "Modified", "IsLocked", "Files", "Directories", "Find", "Variable")
Issues List(ValidationIssue)
	Filed.Issues.First to Text is "SameCallTwiceMustBeLet: File(path).Exists, keep it in a let"
	Filed.Issues.First.Line is 3 and Typed.Issues.Length is 0
	shape = TypeShape(lines)
	mutable issues = List(Mutable(ValidationIssue))
	for lines
		if shape.IsMethodHeader(value)
			issues = issues + Repeat(index)
	issues
Repeat(header Number) List(ValidationIssue)
	Filed.Repeat(0).Length is 1 and Typed.Repeat(0).Length is 0 and Fixed.Repeat(0).Length is 0
	Rounded.Repeat(0).Length is 0 and Written.Repeat(0).Length is 0 and Recreated.Repeat(0).Length is 0
	code = ErrorDrops(lines).Code(header)
	Repeats(code, FileCheck.LastLine(lines, header) - code.Length + 2, Changing(code))
Repeats(code Texts, start Number, changing Texts) List(ValidationIssue)
	Recreated.Repeats(("Directory.Exists(a)", "Directory.Exists(a)"), 3, List(Text)).First.Line is 4
	mutable seen = Dictionary(Text, Boolean)
	mutable issues = List(Mutable(ValidationIssue))
	for code
		lookups = Lookups(Tokenizer(value).Tokens)
		seen = "" is in lookups then Dictionary(Text, Boolean) else seen
		for lookups - Unsteady(lookups, changing) - ""
			if value is in seen and seen(value)
				issues.Add(ValidationIssue("SameCallTwiceMustBeLet", value + ", keep it in a let", start + outer.index))
			seen(value) = value is not in seen
	issues
Changing(code Texts) Texts
	Fixed.Changing(("mutable text = \"a\"", "text.IndexOf(\".\")")) is ("text")
	Fixed.Changing(List(Text) + "let a = 1").Length is 0
	for code
		if value.StartsWith("mutable ")
			Tokenizer(value).Tokens(1)
Unsteady(calls Texts, changing Texts) Texts
	Fixed.Unsteady(("text.IndexOf(\".\")", "File(path)"), List(Text) + "text") is ("text.IndexOf(\".\")")
	for calls
		if IsChanging(Tokenizer(value).Tokens, changing)
			value
IsChanging(tokens Texts, changing Texts) Boolean
	Fixed.IsChanging(("text", "."), List(Text) + "text")
	Fixed.IsChanging(List(Text) + "path", List(Text) + "text") is false
	for changing
		if value is in tokens
			return true
	false
Lookups(tokens Texts) Texts
	Filed.Lookups(("File", "(", "path", ")", ".", "Exists")) is ("File(path).Exists")
	Filed.Lookups(("Directory", ".", "Exists", "(", "folder", ")")) is ("Directory.Exists(folder)")
	Filed.Lookups(("File", "(", "path", ")", ".", "Write", "(", "a", ")")) is ("")
	for tokens
		if value is in InputOutputs.Kinds
			Lookup(tokens, index)
Lookup(tokens Texts, at Number) Text
	Filed.Lookup(("File", "(", "value", ")", ".", "Exists"), 0) is ""
	Filed.Lookup(("File", "."), 0) is ""
	isStatic = at + 3 < tokens.Length and tokens(at + 1) is "." and tokens(at + 3) is "("
	open = isStatic then at + 3 else at + 1
	close = open < tokens.Length and tokens(open) is "(" then Close(tokens, open) else -1
	if close < 0 or "value" is in tokens.Slice(open, close - open) or "index" is in tokens.Slice(open, close - open)
		return ""
	isRead = close + 2 < tokens.Length and tokens(close + 1) is "." and tokens(close + 2) is in Reads
	end = isStatic then close else close + 2
	(isStatic then tokens(at + 2) is in Reads else isRead) then Text.Combine(tokens.Slice(at, end - at + 1), "") else ""
IsName(token Text) Boolean
	Filed.IsName("File") and Filed.IsName("(") is false and Filed.IsName("\"a\"") is false
	token.Length > 0 and token(0).Lower is not token(0).Upper
Close(tokens Texts, open Number) Number
	Filed.Close(("F", "(", "G", "(", "1", ")", ")"), 1) is 6 and Filed.Close(("F", "(", "a"), 1) is -1
	mutable depth = 0
	for Range(open, tokens.Length)
		depth = tokens(value) is "(" then depth + 1 else tokens(value) is ")" then depth - 1 else depth
		if depth is 0
			return value
	Number.NotFound
