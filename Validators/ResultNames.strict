has lines Texts
has typeName Text = ""
constant Rule = "MethodNameMustFitItsResult"
constant Irregular = ("Ran", "Run", "Built", "Build", "Sent", "Send", "Made", "Make", "Found", "Find", "Kept", "Keep", "Written", "Write", "Shown", "Show", "Taken", "Take", "Held", "Hold", "Got", "Get")
constant Hosting = ResultNames(("Hosted(command Text)", "\tlogger.Log(command)"), "Strict")
Issues List(ValidationIssue)
	Hosting.Issues.First to Text is Rule + ": Hosted returns nothing, an action is named with its verb: Host"
	ResultNames(("Shortened(trace Text) Text", "\ttrace")).Issues.First.target.EndsWith("name it with a verb: Shorten")
	ResultNames(("Sorted(key Number) Sizes", "\tvalues"), "Sizes").Issues.Length is 0
	ResultNames(("Sorted Numbers", "\tvalues")).Issues.Length is 0
	ResultNames(("IsDone Boolean", "\ttrue")).Issues.Length is 0
	ResultNames(("Hosted(command Text)", "\tLog(command)"), "Number").Issues.Length is 0
	if typeName is in Assertions.Plain
		return List(ValidationIssue)
	shape = TypeShape(lines)
	for lines
		if shape.IsMethodHeader(value) and Misnamed(value) is not ""
			ValidationIssue(Rule, Misnamed(value), index + 1)
Misnamed(header Text) Text
	Hosting.Misnamed("Hosted(command Text)") is "Hosted returns nothing, an action is named with its verb: Host"
	Hosting.Misnamed("Elapsed Number") is "" and Hosting.Misnamed("Speed(value Number) Number") is ""
	tokens = HeaderTokens(Tokenizer(header).Tokens)
	name = Tokenizer(header).Tokens.First
	verb = Verb(name)
	returned = tokens.ReturnType
	if verb is "" or returned is "Boolean" or TypeEntry.ShortName(returned) is TypeEntry.ShortName(typeName)
		return ""
	if returned is "None"
		return name + " returns nothing, an action is named with its verb: " + verb
	called = name + " is called with arguments and returns " + returned + ", name it with a verb: " + verb
	tokens.ParameterNames.Length > 0 then called else ""
Verb(name Text) Text
	Hosting.Verb("Hosted") is "Host" and Hosting.Verb("Replied") is "Reply" and Hosting.Verb("Stopped") is "Stop"
	Hosting.Verb("Served") is "Serve" and Hosting.Verb("Examined") is "Examine" and Hosting.Verb("Joined") is "Join"
	Hosting.Verb("Ran") is "Run" and Hosting.Verb("Added") is "Add"
	Hosting.Verb("Speed") is "" and Hosting.Verb("Red") is ""
	Hosting.Verb("Captured") is "Capture" and Hosting.Verb("Stored") is "Store" and Hosting.Verb("Raised") is "Raise"
	Hosting.Verb("Named") is "Name" and Hosting.Verb("Declared") is "Declare" and Hosting.Verb("Parsed") is "Parse"
	Hosting.Verb("Edited") is "Edit" and Hosting.Verb("Opened") is "Open" and Hosting.Verb("Lowered") is "Lower"
	Hosting.Verb("Counted") is "Count" and Hosting.Verb("Started") is "Start" and Hosting.Verb("Passed") is "Pass"
	at = Irregular.Index(name)
	if at >= 0 and at % 2 is 0
		return Irregular(at + 1)
	if name.Length < 5 or name.EndsWith("ed") is false or name.EndsWith("eed")
		return ""
	if name.EndsWith("ied")
		return name.Substring(0, name.Length - 3) + "y"
	stem = name.Substring(0, name.Length - 2)
	Stem(stem, stem(stem.Length - 1) to Text)
Stem(stem Text, last Text) Text
	Hosting.Stem("Stopp", "p") is "Stop" and Hosting.Stem("Add", "d") is "Add" and Hosting.Stem("Trac", "c") is "Trace"
	if last is stem(stem.Length - 2) to Text and "bgmnprt".IndexOf(last) >= 0
		return stem.Substring(0, stem.Length - 1)
	isSibilant = last is "s" and stem.EndsWith("ss") is false
	"vczu".IndexOf(last) >= 0 or isSibilant or IsSingleVowel(stem) then stem + "e" else stem
IsSingleVowel(stem Text) Boolean
	Hosting.IsSingleVowel("Stor") and Hosting.IsSingleVowel("Examin")
	Hosting.IsSingleVowel("Join") is false and Hosting.IsSingleVowel("Edit") is false
	vowel = stem(stem.Length - 2) to Text
	before = stem.Length > 2 then stem(stem.Length - 3) to Text else "a"
	last = stem(stem.Length - 1) to Text
	"aiou".IndexOf(vowel) >= 0 and "aeiou".IndexOf(before) < 0 and "wxy".IndexOf(last) < 0 and vowel + last is not "it"
