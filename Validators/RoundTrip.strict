has logger
constant Digits = "1,2,3,4,5,6,7,8,9,1,2,3,4,5,6,7,8,9,1,2,3,4,5,6,7,8,9,1,2"
constant Packed = "\t(" + Digits + "," + Digits + ")"
Formatted(lines Texts) Texts
	RoundTrip.Formatted(("Run", "	let x=(1,2)")) is ("Run", "	let x = (1, 2)")
	RoundTrip.Formatted(("has number ", "Twice Number", "	number*2")) is ("has number", "Twice Number", "	number * 2")
	(RoundTrip.Formatted(("Run", "\t1", "")) is ("Run", "\t1")) and (RoundTrip.Formatted(("has x", "\t1")) is ("has x"))
	let shape = TypeShape(lines)
	let end = Ended(lines)
	mutable formatted = List(Mutable(Text))
	for lines
		if (value.StartsWith("	") is false) and (index < end)
			formatted.Add(value.Trim)
			if shape.IsMethodHeader(value)
				formatted = formatted + Body(lines, index + 1)
	formatted
Ended(lines Texts) Number
	RoundTrip.Ended(("Run", "\t1", "", "")) is 2
	mutable end = 0
	for lines
		if value.Trim is not ""
			end = index + 1
	end
Body(lines Texts, start Number) Texts slow
	RoundTrip.Body(("Run", "\t(1,2)"), 1) is ("\t(1, 2)")
	RoundTrip.Body(("Run", Packed), 1) is (Packed)
	RoundTrip.Body(("Run", "\t1", Packed), 1) is ("\t1", Packed)
	for BodyParser(lines).Block(start, 1).Lines("	")
		value.Length > Limits.MaxCharacters then lines(start + index) else value
Tabbed(lines Texts) Texts
	RoundTrip.Tabbed(("Run", "    1")) is ("Run", "\t1")
	RoundTrip.Tabbed(("    Run", "        1")) is ("Run", "\t1")
	RoundTrip.Tabbed(("    Run", "", "        1")) is ("Run", "", "\t1")
	mutable indented = List(Mutable(Text))
	for lines
		indented.Add(Indented(value))
	let shared = Shared(indented)
	for indented
		value.Length < shared then "" else value.Substring(shared, value.Length - shared)
Shared(lines Texts) Number
	RoundTrip.Shared(("\tRun", "\t\t1", "")) is 1
	RoundTrip.Shared(("Run", "\t1")) is 0
	mutable shared = 1000
	for lines
		if value.Trim is not ""
			shared = (shared, value.Length + 1 - (value + "x").Trim.Length).Minimum
	shared
Indented(line Text) Text
	RoundTrip.Indented("    a") is "\ta"
	RoundTrip.Indented("\t      b") is "\t\t\tb"
	RoundTrip.Indented("a  b") is "a  b"
	RoundTrip.Indented("   a") is "\ta"
	RoundTrip.Indented(" a") is "\ta"
	if line.StartsWith("\t")
		return "\t" + Indented(line.Substring(1, line.Length - 1))
	if line.StartsWith(" ") is false
		return line
	let wide = line.StartsWith("    ") then 4 else (line.StartsWith("   ") then 3 else 2)
	let spaces = line.StartsWith("  ") then wide else 1
	"\t" + Indented(line.Substring(spaces, line.Length - spaces))