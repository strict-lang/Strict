constant Digits = "1,2,3,4,5,6,7,8,9,1,2,3,4,5,6,7,8,9,1,2,3,4,5,6,7,8,9,1,2"
constant Packed = "\t(" + Digits + "," + Digits + ")"
Format(lines Texts) Texts
	RoundTrip.Format(("Run", "	let x=(1,2)")) is ("Run", "	let x = (1, 2)")
	RoundTrip.Format(("has number ", "Twice Number", "	number*2")) is ("has number", "Twice Number", "	number * 2")
	RoundTrip.Format(("Run", "\t1", "")) is ("Run", "\t1") and RoundTrip.Format(("has x", "\t1")) is ("has x")
	shape = TypeShape(lines)
	end = End(lines)
	mutable formatted = List(Mutable(Text))
	for lines
		if value.StartsWith("	") is false and index < end
			formatted.Add(value.Trim)
			if shape.IsMethodHeader(value)
				formatted = formatted + Body(lines, index + 1)
	formatted
End(lines Texts) Number
	RoundTrip.End(("Run", "\t1", "", "")) is 2
	mutable end = 0
	for lines
		if value.Trim is not ""
			end = index + 1
	end
Body(lines Texts, start Number) Texts slow
	RoundTrip.Body(("Run", "\t(1,2)"), 1) is ("\t(1, 2)")
	RoundTrip.Body(("Run", Packed), 1) is (Packed)
	RoundTrip.Body(("Run", "\t1", Packed), 1) is ("\t1", Packed)
	for BodyParser(lines).Block(start, 1).Lines("	")
		value.Length > Limits.MaxCharacters then lines(start + index) else value
Tab(lines Texts) Texts
	RoundTrip.Tab(("Run", "    1")) is ("Run", "\t1")
	RoundTrip.Tab(("    Run", "        1")) is ("Run", "\t1")
	RoundTrip.Tab(("    Run", "", "        1")) is ("Run", "", "\t1")
	mutable indented = List(Mutable(Text))
	for lines
		indented.Add(Indent(value))
	shared = Share(indented)
	for indented
		value.Length < shared then "" else value.Substring(shared)
Share(lines Texts) Number
	RoundTrip.Share(("\tRun", "\t\t1", "")) is 1
	RoundTrip.Share(("Run", "\t1")) is 0
	mutable shared = 1000
	for lines
		if value.Trim is not ""
			shared = (shared, value.Length + 1 - (value + "x").Trim.Length).Minimum
	shared
Indent(line Text) Text
	RoundTrip.Indent("    a") is "\ta"
	RoundTrip.Indent("\t      b") is "\t\t\tb"
	RoundTrip.Indent("a  b") is "a  b"
	RoundTrip.Indent("   a") is "\ta"
	RoundTrip.Indent(" a") is "\ta"
	if line.StartsWith("\t")
		return "\t" + Indent(line.Substring(1, line.Length - 1))
	if line.StartsWith(" ") is false
		return line
	wide = line.StartsWith("    ") then 4 else (line.StartsWith("   ") then 3 else 2)
	spaces = line.StartsWith("  ") then wide else 1
	"\t" + Indent(line.Substring(spaces, line.Length - spaces))