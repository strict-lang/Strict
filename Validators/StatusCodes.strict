has lines Texts
constant Stopping = StatusCodes(("StopAll Number", "\tEmpty.Stopped(1) is 0", "\tStopped(1)", "\t0"))
constant Counting = StatusCodes(("Count(list Numbers) Number", "\tif list.Length is 0", "\t\treturn 0", "\tlist.Length"))
constant Freeing = StatusCodes(("Freed Number", "\tlet told = Sent", "\tReleased(2)", "\ttold is Error then 2 else -1"))
constant Yielding = StatusCodes(("Numbers Numbers", "\tfor 3", "\t\tLog(value)"))
constant Waiting = StatusCodes(("Wait Number", "\tfor as long as true", "\t\tLog(1)", "\t0"))
constant Flagged = StatusCodes(("IsOn Number", "	IsOn is 1", "	state > 0 then 1 else 0"))
constant Masked = StatusCodes(("HasMask Number", "	HasMask is 6", "	(a then 2 else 0) + (b then 4 else 0)"))
constant Sized = StatusCodes(("Margin Number", "	Margin is 2", "	hasBorder then 2 else 0"))
constant Native = StatusCodes(("IsDebug Number", "Open Number"))
constant BooleanHint = ", return a Boolean (or Booleans) instead of numbers for true and false"
constant Comparisons = ("is", "<", ">", "<=", ">=", "and", "or", "not", "=")
constant Hint = ", return nothing, a Boolean, an Error or an enum instead of a status number"
Issues ValidationIssues
	Stopping.Issues.First to Text is "StatusNumberMustNotBeReturned: StopAll returns 0" + Hint
	Stopping.Issues.First.Line is 4 and Counting.Issues.Length is 0 and Freeing.Issues.Length is 2
	StatusCodes(("Run Number", "\tLog(1)", "\t0")).Issues.Length is 0 and Waiting.Issues.Length is 1
	mutable issues = List(Mutable(ValidationIssue))
	for lines
		if IsNumbered(index)
			issues = issues + (IsWriting(index) then CheckReturns(index) else List(ValidationIssue)) + Booleans(index)
	issues
IsNumbered(at Number) Boolean
	Flagged.IsNumbered(0) and StatusCodes(("Run Number", "	0")).IsNumbered(0) is false and Flagged.IsNumbered(1) is false
	if TypeShape(lines).IsMethodHeader(lines(at)) is false
		return false
	tokens = Tokenizer(lines(at).Trim).Tokens
	tokens.First is not "Run" and HeaderTokens(tokens).ReturnType is "Number"
IsStatus(at Number) Boolean
	Stopping.IsStatus(0) and Counting.IsStatus(0) is false and Stopping.IsStatus(2) is false
	StatusCodes(("Run Number", "\tLog(1)", "\t0")).IsStatus(0) is false
	StatusCodes(("Stop Text", "\tLog(1)", "\t\"\"")).IsStatus(0) is false
	StatusCodes(("A", "\tB Number", "\tLog(1)", "\t0")).IsStatus(1) is false
	IsNumbered(at) and IsWriting(at)
End(at Number) Number
	Stopping.End(0) is 4 and StatusCodes(("A", "\t1", "B", "\t2")).End(0) is 2
	for Range(at + 1, lines.Length)
		if lines(value).StartsWith("\t") is false
			return value
	lines.Length
IsWriting(at Number) Boolean
	Stopping.IsWriting(0) and Counting.IsWriting(0) is false
	StatusCodes(("A Number", "\tLog(1)")).IsWriting(0) is false
	StatusCodes(List(Text) + "A Number").IsWriting(0) is false
	StatusCodes(("A Number", "\tLog(1)", "\t0")).IsWriting(0)
	end = End(at)
	for Range(at + 1, end)
		if value < end - 1 and IsStatement(value)
			return true
	false
IsStatement(at Number) Boolean
	Stopping.IsStatement(2) and Stopping.IsStatement(1) is false and Counting.IsStatement(1) is false
	Yielding.IsStatement(2) is false and Waiting.IsStatement(2) and Freeing.IsStatement(2)
	Freeing.IsStatement(1) is false and StatusCodes(("A", "\tx = Log(1)")).IsStatement(1) is false
	StatusCodes(("A", "\tx.Log")).IsStatement(1) and StatusCodes(("A", "\tx")).IsStatement(1) is false
	StatusCodes(("A", "\treturn Log(1)")).IsStatement(1) is false
	StatusCodes(("A Number", "", "\t0")).IsStatement(1) is false
	tokens = Tokenizer(lines(at).Trim).Tokens
	isCall = "(" is in tokens or "." is in tokens
	isCall and tokens.First is not in Inlines.Keywords and IsComparing(tokens) is false and IsYielded(at) is false
IsComparing(tokens Texts) Boolean
	Stopping.IsComparing(("a", "is", "1")) and Stopping.IsComparing(("Log", "(", "a", "is", "1", ")")) is false
	Stopping.IsComparing(("Log", "(", "a", ")", "=", "1"))
	Stopping.IsComparing(("Sinc", "(", "1", ")", ".", "IsNearlyEqual", "(", "1", ")"))
	mutable depth = 0
	for tokens
		depth = value is "(" then depth + 1 else value is ")" then depth - 1 else depth
		if depth is 0 and value is in Comparisons
			return true
	IsChecking(tokens)
IsChecking(tokens Texts) Boolean
	Stopping.IsChecking(("a", ".", "EndsWith", "(", "b", ")")) and Stopping.IsChecking(("File", ".", "Exists"))
	Stopping.IsChecking(("Log", "(", "IsDone", ")")) is false and Stopping.IsChecking(("Issued", "(", ")")) is false
	Stopping.IsChecking(("x", ".", "HasA")) and Stopping.IsChecking(("Is", "(", ")")) is false
	Stopping.IsChecking(("x", ".", "LogA")) is false
	mutable depth = 0
	mutable name = ""
	for tokens
		depth = value is "(" then depth + 1 else value is ")" then depth - 1 else depth
		name = depth is 0 and value(0).Lower is not value(0) then value else name
	IsQuestion(name) or name.EndsWith("With") or name is "Exists"
IsYielded(at Number) Boolean
	Yielding.IsYielded(2) and Stopping.IsYielded(2) is false and Waiting.IsYielded(2) is false
	StatusCodes(("A", "\tfor 3", "\t\tif value is 1", "\t\t\tLog(value)")).IsYielded(3)
	StatusCodes(("A", "\tfor 3", "\t\t1", "\tif x", "\t\tLog(1)")).IsYielded(4) is false
	mutable indent = BodyParser.Indent(lines(at))
	for Range(0, at).Reverse
		trimmed = lines(value).Trim
		if BodyParser.Indent(lines(value)) < indent
			if trimmed.StartsWith("for ") and trimmed.StartsWith("for as long as ") is false
				return true
			indent = BodyParser.Indent(lines(value))
	false
CheckReturns(at Number) ValidationIssues
	Stopping.CheckReturns(0).Length is 1 and Counting.CheckReturns(0).First.Line is 3
	Freeing.CheckReturns(0).Length is 2 and Freeing.CheckReturns(0).First.Line is 4
	StatusCodes(("A Number", "\tfor 2", "\t\t0")).CheckReturns(0).Length is 0
	StatusCodes(("A Number", "\t0", "\tLog(1)", "\t2")).CheckReturns(0).Length is 1
	mutable issues = List(Mutable(ValidationIssue))
	name = Tokenizer(lines(at)).Tokens.First
	for Results(at)
		issues = issues + Issue(name, Literals(value), at + index + 2)
	issues
Results(at Number) Texts
	Stopping.Results(0) is ("", "", "0") and Freeing.Results(0).Last is "told is Error then 2 else -1"
	for Range(at + 1, End(at))
		trimmed = lines(value).Trim
		isLast = value is End(at) - 1 and BodyParser.Indent(lines(value)) is 1
		isLast then trimmed else trimmed.StartsWith("return ") then trimmed.Substring(7) else ""
Issue(name Text, literals Texts, line Number) ValidationIssues
	Stopping.Issue("A", ("0", "1"), 2).Last to Text is "StatusNumberMustNotBeReturned: A returns 1" + Hint
	Stopping.Issue("A", List(Text), 2).Length is 0
	for literals
		ValidationIssue("StatusNumberMustNotBeReturned", name + " returns " + value + Hint, line)
Literals(result Text) Texts
	Stopping.Literals("0") is ("0") and Stopping.Literals("a then 2 else -1") is ("2", "-1")
	Stopping.Literals("a then b else Count(1)").Length is 0 and Stopping.Literals("1 + x").Length is 0
	Stopping.Literals("").Length is 0 and Stopping.Literals("0.5").Length is 0
	for result.Split(" else ")
		at = value.LastIndexOf(" then ")
		part = at < 0 then value else value.Substring(at + 6, value.Length - at - 6)
		if IsInteger(part)
			part
Booleans(at Number) ValidationIssues
	Flagged.Booleans(0).First to Text is "BooleanMustNotBeNumber: IsOn returns state > 0 then 1 else 0" + BooleanHint
	Flagged.Booleans(0).First.Line is 3 and Masked.Booleans(0).Length is 1 and Sized.Booleans(0).Length is 0
	Native.Booleans(0).First to Text is "BooleanMustNotBeNumber: IsDebug returns a Number" + BooleanHint
	Native.Booleans(1).Length is 0
	StatusCodes(("Counted Number", "	Counted is 1", "	state > 0 then 1 else 0")).Booleans(0).Length is 0
	name = Tokenizer(lines(at)).Tokens.First
	isQuestion = IsQuestion(name)
	unanswered = ValidationIssue("BooleanMustNotBeNumber", name + " returns a Number" + BooleanHint, at + 1)
	if isQuestion and End(at) is at + 1
		return List(ValidationIssue) + unanswered
	for Results(at)
		if isQuestion and IsBoolean(value)
			ValidationIssue("BooleanMustNotBeNumber", name + " returns " + value + BooleanHint, at + index + 2)
IsBoolean(result Text) Boolean
	Flagged.IsBoolean("a then 1 else 0") and Flagged.IsBoolean("a then 0 else 1")
	Flagged.IsBoolean("(a then 2 else 0) + (b then 4 else 0)") and Flagged.IsBoolean("a then 2 else 0") is false
	Flagged.IsBoolean("a then 1 else -1") is false and Flagged.IsBoolean("") is false
	Flagged.IsBoolean("count + (a then 1 else 0)") is false and Flagged.IsBoolean("a then 1 else b then 1 else 0")
	tokens = Tokenizer(result).Tokens
	tail = tokens.Length > 3 then tokens.Slice(tokens.Length - 4, 4) else ("", "", "", "")
	isTail = tail(0) is "then" and tail(2) is "else" and tail(1) + " " + tail(3) is in ("1 0", "0 1")
	mutable bits = 0
	for tokens
		pair = value is "then" and index + 3 < tokens.Length then tokens(index + 2) is "else" else false
		isBit = pair then tokens(index + 3) is "0" and IsInteger(tokens(index + 1)) else false
		bits = bits + (isBit then (MagicNumbers(List(Text)).IsPowerOfTwo(tokens(index + 1) to Number) then 1 else 0) else 0)
	isTail and IsPlain(tokens) or bits > 1
IsPlain(tokens Texts) Boolean
	Flagged.IsPlain(("a", "then", "1")) and Flagged.IsPlain(("c", "+", "(", "a", ")")) is false
	Flagged.IsPlain(("(", "a", "+", "b", ")", "then", "1")) and Flagged.IsPlain(("a", "-", "1")) is false
	mutable depth = 0
	for tokens
		depth = value is "(" then depth + 1 else value is ")" then depth - 1 else depth
		if depth is 0 and value is in ("+", "-", "*", "/", "%")
			return false
	true
IsQuestion(name Text) Boolean
	Flagged.IsQuestion("IsOn") and Flagged.IsQuestion("HasMask")
	Flagged.IsQuestion("CanRun") and Flagged.IsQuestion("ShouldGo")
	Flagged.IsQuestion("Issued") is false and Flagged.IsQuestion("Is") is false and Flagged.IsQuestion("Counted") is false
	for ("Is", "Has", "Can", "Should")
		if name.StartsWith(value) and name.Length > value.Length
			return name(value.Length).Lower is not name(value.Length)
	false
IsInteger(text Text) Boolean
	Stopping.IsInteger("12") and Stopping.IsInteger("-1")
	Stopping.IsInteger("x") is false and Stopping.IsInteger("1.5") is false and Stopping.IsInteger("") is false
	Stopping.IsInteger("-") is false
	digits = text.StartsWith("-") then text.Substring(1) else text
	if digits is ""
		return false
	for Range(0, digits.Length)
		if Tokenizer.IsDigit(digits(value)) is false
			return false
	true
