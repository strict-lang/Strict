has lines Texts
constant Short = SubstringLengths(("Run", "\tx.Substring(1, 1)", "\tx.Substring(1, count)", "\tx.Substring(1, 2)"))
Issues List(ValidationIssue)
	Short.Issues.Length is 1 and Short.Issues.First.Line is 2
	Short.Issues.First to Text is "SubstringLengthMustBeAtLeastTwo: Substring length 1, use index access or \"\""
	SubstringLengths(("\t\"Substring(0, 1)\"", "\tx.Substring(f(0), 0) + x.Substring(g(1, 0), 3)")).Issues.Length is 1
	SubstringLengths(("Substring(start Number, length Number) Text", "Substring", "x.Substring(0, -1)")).Issues.Length is 0
	mutable issues = List(Mutable(ValidationIssue))
	for lines
		issues = issues + Lengths(Tokenizer(value.Trim).Tokens, index + 1)
	issues
Lengths(tokens Texts, line Number) List(ValidationIssue)
	Short.Lengths(("Substring", "(", "0", ",", "0", ")"), 3).First.Line is 3
	Short.Lengths(("Substring", "(", "0", ",", "2", ")"), 3).Length is 0
	Short.Lengths(("f", "(", "0", ",", "1", ")"), 3).Length is 0
	Short.Lengths(("Substring", "(", "0", ",", "1"), 3).Length is 0
	mutable issues = List(Mutable(ValidationIssue))
	for tokens
		if value is "Substring"
			let close = Closing(tokens, index + 1)
			if (close < tokens.Length) and (tokens(close - 1) is in ("0", "1")) and (tokens(close - 2) is ",")
				let detail = "Substring length " + tokens(close - 1) + ", use index access or \"\""
				issues.Add(ValidationIssue("SubstringLengthMustBeAtLeastTwo", detail, line))
	issues
Closing(tokens Texts, open Number) Number
	Short.Closing(("f", "(", "g", "(", ")", ")", ")"), 1) is 5
	Short.Closing(("f", "x", ")"), 1) is 3 and Short.Closing(("f", "("), 1) is 2
	mutable depth = 0
	for Range(open, tokens.Length)
		depth = depth + (tokens(value) is "(" then 1 else (tokens(value) is ")" then -1 else 0))
		if depth < 1
			return value > open then value else tokens.Length
	tokens.Length
