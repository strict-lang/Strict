has own Text
has header HeaderTokens
has values Scope
has known KnownTypes
constant Operators = ("+", "-", "*", "/", "%", "and", "or", "xor", "is")
Candidates Texts
	mutable found = Calls(true)
	for values.names
		if values.types(index) is header.ReturnType
			found = found + value
	Unique(found + Binary + Calls(false) + Compared)
Binary Texts
	mutable found = List(Mutable(Text))
	for values.names
		found = found + Operations(value, values.types(index)) + Joined(value, values.types(index))
	found
Joined(left Text, type Text) Texts
	if type is not "Text" or header.ReturnType is not "Text"
		return List(Text)
	for values.names
		if values.types(index) is "Text"
			left + " + " + value
Compared Texts
	if header.ReturnType is not "Boolean"
		return List(Text)
	mutable found = List(Mutable(Text))
	for values.names
		if values.types(index) is "Number"
			found = found + (value + " % 2 is 0", value + " is 0", value + " > 0")
	found
Operations(left Text, type Text) Texts
	mutable found = List(Mutable(Text))
	methods = known.MethodsOf(type)
	for methods.names
		operator = value
		parameters = known.ParameterNames(known.ParameterScope(type).TypeOf(operator + " types"))
		if operator is in Operators and methods.TypeOf(operator) is header.ReturnType and parameters.Length is 1
			for values.names
				if values.types(index) is (parameters.First is "Other" then type else parameters.First)
					found = found + (left + " " + operator + " " + value)
	found
Receivers Texts
	mutable receivers = List(Mutable(Text))
	for Range(header.ParameterNames.Length, values.names.Length)
		receivers.Add(values.names(value))
	receivers + header.ParameterNames + own
Calls(sameName Boolean) Texts
	mutable calls = List(Mutable(Text))
	for Receivers
		declared = values.TypeOf(value)
		listed = declared is "Text" then Receiver(value, "List", sameName) else List(Text)
		calls = calls + Receiver(value, declared is "" then value else declared, sameName) + listed
	calls
Receiver(receiver Text, type Text, sameName Boolean) Texts
	mutable calls = List(Mutable(Text))
	for known.MethodsOf(type).names
		recursive = type is own and value is header.tokens.First
		if Named(value) and recursive is false and Stem(value) is Stem(header.tokens.First) is sameName
			if known.MemberType(type, value) is header.ReturnType and value is in known.ParameterScope(type).names
				call = Call(type is own then value else receiver + "." + value, type, value, receiver)
				if call is not ""
					calls.Add(call)
	calls
Named(name Text) Boolean
	first = name(0)
	named = Tokenizer.IsWordCharacter(first) and Tokenizer.IsDigit(first) is false
	named and name is not in DefaultCheck.Keywords and name is not "Run"
Call(prefix Text, type Text, name Text, receiver Text) Text
	scope = known.ParameterScope(type)
	parameters = known.ParameterNames(scope.TypeOf(name + " types"))
	required = scope.TypeOf(name + " required") to Number
	mutable arguments = List(Mutable(Text))
	for parameters
		matched = Argument(value, arguments + receiver)
		if matched is ""
			return index >= required then Called(prefix, arguments) else ""
		arguments.Add(matched)
	Called(prefix, arguments)
Argument(type Text, used Texts) Text
	for values.names
		if values.types(index) is type and value is not in used
			return value
	""
Called(prefix Text, arguments Texts) Text
	arguments.Length is 0 then prefix else prefix + "(" + Text.Combine(arguments, ", ") + ")"
Stem(name Text) Text
	lower = name.Lower
	lower.EndsWith("ed") then lower.Substring(0, lower.Length - 2) else lower
Unique(candidates Texts) Texts
	constant MaxSuggestions = 64
	mutable found = List(Mutable(Text))
	for candidates
		if value is not in found and found.Length < MaxSuggestions
			found.Add(value)
	found
