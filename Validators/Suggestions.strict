has path Text
has root Text
has lines Texts
has inference TypeInference
constant Doubling = Suggestions("A.strict", ".", ("has count Number", "Double(times Number) Number", "\tDouble(2) is 4", "\ttimes * 2", "Run", "\tlet a = 1", "\ta"), TypeInference.NoInference)
constant Doubled = HeaderTokens(Tokenizer(Doubling.lines(1)).Tokens)
constant Building = Suggestions("A.strict", ".", ("has count Number", "from(number Number)", "\tnumber", "Twice Number", "\tTwice is 2"), TypeInference.NoInference)
Run(name Text, files Texts) Number
	header = Header(name)
	if header < 0
		Logger.Log("MethodNotFound: " + name + " in " + path)
		return 2
	if Tests(header).Length is 0
		return 0
	method = HeaderTokens(Tokenizer(lines(header)).Tokens)
	source = FileCompiler.FullName(path, root)
	code = TypeCodegen(source, WithBody(header), inference, FileCompiler.FullNames(files, root))
	for SuggestionTests(code, method, root, path).Passing(Candidates(method))
		Logger.Log("Suggestion: " + value)
	0
Header(name Text) Number
	Doubling.Header("Double") is 1 and Doubling.Header("5") is 4 and Doubling.Header("Missing") is Number.NotFound
	for lines
		if TypeShape(lines).IsMethodHeader(value)
			if Tokenizer(value).Tokens.First is name or (index + 1) to Text is name
				return index
	Number.NotFound
Candidates(method HeaderTokens) Texts
	Doubling.Candidates(Doubled) is ("times", "count")
	Building.Candidates(HeaderTokens(Tokenizer(Building.lines(1)).Tokens)) is ("count = number")
	members = TypeShape(lines).MemberScope
	if method.tokens.First is not "from" or members.names.Length is not 1
		return Search(method).Candidates
	for Search(HeaderTokens(method.tokens + members.types.First)).Candidates
		members.names.First + " = " + value
Search(header HeaderTokens) SuggestionCalls
	Doubling.Search(Doubled).Candidates is ("times", "count")
	members = TypeShape(lines).MemberScope
	parameters = Scope(header.ParameterNames, header.ParameterTypes)
	values = header.tokens.First is "from" then parameters else parameters.WithAll(members.names, members.types)
	SuggestionCalls(Path(path).FileName.RemoveExtension.text, header, values, inference.types)
Tests(header Number) Texts
	code = TypeCodegen(FileCompiler.FullName(path, root), lines, inference, List(Text))
	extended = SyntaxNode("Body", "", BodyParser(lines).Method(header + 1).children + MethodCodegen.One)
	SyntaxNode("Body", "", TestLines(code.Generator).Tests(extended, CodeBlock.Empty)).Lines("\t")
WithBody(header Number) Texts
	Doubling.WithBody(1)(3) is "\t0" and Doubling.WithBody(1).Length is 7
	mutable changed = List(Mutable(Text))
	for lines
		if TypeShape(lines).IsMethodHeader(value)
			changed = changed + Method(index, header)
		else if value.StartsWith("\t") is false
			changed.Add(value)
	changed
Method(header Number, selected Number) Texts
	Doubling.Method(1, 1) is ("Double(times Number) Number", "\tDouble(2) is 4", "\t0")
	Doubling.Method(4, 1) is ("Run", "\tlet a = 1", "\ta") and Building.Method(3, 1).Length is 0
	if header is selected
		return (List(Text) + lines(header)) + Tests(header) + "\t0"
	first = header + Tests(header).Length + 1
	last = FileCheck.LastLine(lines, header)
	if first > last
		return List(Text)
	mutable kept = List(Text) + lines(header)
	for Range(first, last + 1)
		kept = kept + lines(value)
	kept
