has inference Expressions/TypeInference = TypeInference.NoInference
constant Operators = ("+", "-", "*", "/", "%", "^")
constant Randoms = ("Number.strict", "HashCode.strict", "PseudoRandom.strict")
constant Numbered = Scope(("low", "elements"), ("Number", "Numbers"))
constant Counts = KnownTypes(List(Text) + "Count", List(Scope) + KnownTypes.NoMembers, List(Scope) + Scope(("Limit", "Increment"), ("Number", "Count")), List(Scope) + KnownTypes.NoMembers)
constant Limited = SureMethods(TypeInference(Counts, List(Scope) + Scope(List(Text) + "Limit", List(Text) + "3")))
constant Fielded = SureMethods(TypeInference(KnownTypes(List(Text) + "Count", List(Scope) + Scope(("low"), ("Number")), List(Scope) + KnownTypes.NoMembers, List(Scope) + KnownTypes.NoMembers), List(Scope) + KnownTypes.NoMembers))
constant Ranged = SyntaxParser(Tokenizer("Range(0, 1)").Tokens).Parse
constant Lists = List(Text) + "List.strict"
constant Remainder = FileCheck.Parsed("low % Limit")
Named(paths Texts) Texts slow
	SureMethods.Named(List(Text)).Length is 0
	"PseudoRandom.Next" is in SureMethods(ResolveCheck(Logger).Inference(Randoms)).Named(Randoms)
	("List.First" is in SureMethods(ResolveCheck(Logger).Inference(Lists)).Named(Lists)) is false
	mutable records = List(Mutable(Text))
	for paths
		if IsBase(value)
			records = records + Records(Path(value).FileName.RemoveExtension.text, File(value).ReadLines)
	Settled(records)
Records(type Text, lines Texts) Texts
	let shape = TypeShape(lines)
	let statements = MethodBodies(type, shape, inference).Statements
	for lines
		if shape.IsMethodHeader(value) and Kept(lines, index)
			let name = Tokenizer(value).Tokens.First
			type + "." + name + "|" + Text.Combine(Used(type, statements, lines, index) - (type + "." + name), ",")
Used(type Text, statements ScopedStatements, lines Texts, header Number) Texts
	let last = FileCheck.LastLine(lines, header)
	mutable keys = List(Mutable(Text))
	for statements
		if (value.line > header) and (value.line <= last) and (Duplicates.IsTest(lines(value.line).Trim) is false)
			keys = keys + Calls(type, value.statement, value.scope)
	keys
Kept(lines Texts, header Number) Boolean
	SureMethods.Kept(("Next Number", "\tlow + 1"), 0)
	SureMethods.Kept(("Send(socket Number)", "\tSend(0) is 1"), 0) is false
	SureMethods.Kept(("Parsed Number", "\tname to Number"), 0) is false
	SureMethods.Kept(("Added(other Numbers) Numbers", "\t(1) + (\"Hi\") is Error", "\tother"), 0) is false
	let body = Duplicates.Implementation(lines, header)
	(Fails(body) is false) and HasBody(body) and (IsTestedFailing(lines, header) is false)
IsTestedFailing(lines Texts, header Number) Boolean
	SureMethods.IsTestedFailing(("A Number", "\tA is Error", "\t1", "B", "\tB is Error"), 0)
	SureMethods.IsTestedFailing(("A Number", "\tA is not Error", "\t1", "B", "\tB is Error"), 0) is false
	for Range(header + 1, FileCheck.LastLine(lines, header) + 1)
		if lines(value).IndexOf(" is Error") is not -1
			return true
	false
Fails(body Text) Boolean
	SureMethods.Fails("return Error(\"Bad\")")
	SureMethods.Fails("value to Number")
	SureMethods.Fails("low + high") is false
	let tokens = Tokenizer(body).Tokens
	("Error" is in tokens) or ("to" is in tokens)
Calls(type Text, node SyntaxNode, scope Scope) Texts
	SureMethods.Calls("Demo", FileCheck.Parsed("low * (low + 1)"), Numbered) is ("Number.*", "Number.+")
	SureMethods.Calls("Demo", FileCheck.Parsed("elements(0).Floor"), Numbered) is ("Number.Floor", "Index")
	mutable keys = Direct(type, node, scope)
	for node.children
		keys = keys + Calls(type, value, scope)
	keys
Direct(type Text, node SyntaxNode, scope Scope) Texts
	SureMethods.Direct("Demo", FileCheck.Parsed("low is 1"), Numbered).Length is 0
	SureMethods.Direct("Demo", SyntaxNode("Text", "+"), Numbered).Length is 0
	SureMethods.Direct("Demo", Ranged, Numbered).Length is 0
	Limited.Direct("Count", SyntaxNode("Identifier", "Increment"), Numbered) is ("Count.Increment")
	Limited.Direct("Count", Remainder, Numbered).Length is 0
	if IsSafeDivision(type, node)
		return List(Text)
	if (node.Kind is in ("Member", "MethodCall")) or ((node.Kind is "Binary") and (node.text is in Operators))
		return Keyed(node.children(0), node.text, scope, inference.types.MethodsOf(type))
	if (node.Kind is "Call") and (scope.TypeOf(node.text) is not "")
		return List(Text) + "Index"
	IsOwn(type, node, scope) then List(Text) + (type + "." + node.text) else List(Text)
IsSafeDivision(type Text, node SyntaxNode) Boolean
	Limited.IsSafeDivision("Count", Remainder) and Limited.IsSafeDivision("Count", FileCheck.Parsed("low / 2"))
	Limited.IsSafeDivision("Other", FileCheck.Parsed("low % Count.Limit"))
	Limited.IsSafeDivision("Count", FileCheck.Parsed("low / 0")) is false
	Limited.IsSafeDivision("Count", FileCheck.Parsed("low % high")) is false
	Limited.IsSafeDivision("Count", FileCheck.Parsed("low % Increment")) is false
	Limited.IsSafeDivision("A", FileCheck.Parsed("low + 2")) is false
	Limited.IsSafeDivision("A", SyntaxNode("Text", "/")) is false
	if (node.Kind is not "Binary") or (node.text is not in ("/", "%"))
		return false
	let divisor = node.children(1)
	let owner = divisor.Kind is "Member" then divisor.children(0).text else type
	divisor.Kind is "Number" then divisor.text is not "0" else inference.ConstantOf(owner, divisor.text) is not ""
IsOwn(type Text, node SyntaxNode, scope Scope) Boolean
	Limited.IsOwn("Count", SyntaxNode("Identifier", "Increment"), Numbered)
	Limited.IsOwn("Count", SyntaxNode("Identifier", "Increment"), Scope(("Increment"), ("Number"))) is false
	Limited.IsOwn("Count", SyntaxNode("Text", "Increment"), Numbered) is false
	(node.Kind is in ("Identifier", "Call")) and (scope.TypeOf(node.text) is "") and IsMethod(type, node.text)
IsMethod(type Text, name Text) Boolean
	Limited.IsMethod("Count", "Increment")
	(Limited.IsMethod("Count", "Limit") is false) and (Limited.IsMethod("Count", "Missing") is false)
	(inference.types.MethodsOf(type).TypeOf(name) is not "") and (inference.ConstantOf(type, name) is "")
Keyed(receiver SyntaxNode, name Text, scope Scope, methods Scope) Texts
	SureMethods.Keyed(SyntaxNode("Identifier", "elements"), "First", Numbered, Numbered) is ("List.First")
	Limited.Keyed(SyntaxNode("Type", "Count"), "Limit", Numbered, Numbered).Length is 0
	Limited.Keyed(SyntaxNode("Type", "Count"), "Increment", Numbered, Numbered) is ("Count.Increment")
	Fielded.Keyed(SyntaxNode("Type", "Count"), "low", Numbered, Numbered).Length is 0
	Fielded.Keyed(SyntaxNode("Type", "Count"), "ReadLines", Numbered, Numbered) is ("Count.ReadLines")
	let base = inference.types.BaseName(inference.TypeOf(receiver, scope, methods))
	let isField = (inference.types.MembersOf(base).TypeOf(name) is not "") or (inference.ConstantOf(base, name) is not "")
	isField then List(Text) else List(Text) + (base + "." + name)
Settled(records Texts) Texts
	SureMethods.Settled(("Number.Floor|", "PseudoRandom.Next|Number.Floor")) is ("Number.Floor", "PseudoRandom.Next")
	SureMethods.Settled(("Demo.Run|Index", "Demo.Twice|Demo.Twice")).Length is 0
	mutable sure = List(Mutable(Text))
	mutable added = 1
	for as long as added > 0
		added = 0
		for records
			if (Key(value) is not in sure) and Accepts(CallList(value), sure)
				sure = sure + Key(value)
				added = 1
	sure
Key(record Text) Text
	SureMethods.Key("PseudoRandom.Next|Floor") is "PseudoRandom.Next"
	record.Split("|").First
CallList(record Text) Texts
	SureMethods.CallList("PseudoRandom.Next|Number.Floor") is ("Number.Floor")
	SureMethods.CallList("Number.Floor|").Length is 0
	SureMethods.CallList("Demo.Run|Number.Floor,Demo.Next") is ("Number.Floor", "Demo.Next")
	let rest = record.Split("|").Last
	record.EndsWith("|") then List(Text) else rest.Split(",")
Accepts(calls Texts, sure Texts) Boolean
	SureMethods.Accepts(List(Text), ("Number.Floor"))
	SureMethods.Accepts(("Number.Floor"), ("Number.Floor"))
	SureMethods.Accepts(("Number.Floor", "Index"), ("Number.Floor")) is false
	for calls
		if value is not in sure
			return false
	true
HasBody(body Text) Boolean
	SureMethods.HasBody("low + high")
	SureMethods.HasBody("Next is 1") is false
	SureMethods.HasBody("") is false
	for body.Split("\n")
		if (value is not "") and (Duplicates.IsTest(value) is false)
			return true
	false
IsBase(path Text) Boolean
	SureMethods.IsBase("PseudoRandom.strict")
	SureMethods.IsBase("Strict/PseudoRandom.strict") and SureMethods.IsBase("./PseudoRandom.strict")
	SureMethods.IsBase("Networking/Socket.strict") is false
	SureMethods.IsBase("Networking\\Socket.strict") is false
	let parts = path.Replace("\\", "/").Split("/")
	(parts.Length is 1) or (parts(parts.Length - 2) is in ("Strict", "."))
