has shape Expressions/TypeShape
has mutations Texts
constant ReservedNames = ("value", "iterator", "elements", "generic")
Sample TypeValidator
	Sample.mutations.Length is 2
	TypeValidator(TypeShape("has unused Number", "has logger", "Run", "\tlogger.Log(1)"), ("Add", "Remove"))
Validate ValidationIssues
	Sample.Validate.Length is 1
	mutable issues = List(Mutable(ValidationIssue))
	for shape.lines
		if shape.IsMethodHeader(value)
			let header = HeaderTokens(Tokenizer(value).Tokens)
			let statements = BodyParser(shape.lines).Block(index + 1, 1).Statements
			issues = issues + UsageRules(header, statements, shape.MemberScope.names, mutations).Issues
	MemberIssues + ConstantIssues + issues
MemberIssues ValidationIssues
	Sample.MemberIssues.Length is 1
	mutable issues = List(Mutable(ValidationIssue))
	if IsExempt
		return issues
	for MemberNames
		if value is not in ReservedNames and (not IsPublic(value)) and UsageCount(value) < 2
			issues.Add(ValidationIssue("UnusedMemberMustBeRemoved", value, "Never used"))
	issues
MemberNames Texts
	Sample.MemberNames is ("unused", "logger")
	for shape.lines
		if shape.IsMemberLine(value)
			HeaderTokens(Tokenizer(value).Tokens).MemberName
IsPublic(name Text) Boolean
	Sample.IsPublic("Count") is true
	Sample.IsPublic("count") is false
	name.Substring(0, 1) is name.Substring(0, 1).Upper
UsageCount(name Text) Number
	Sample.UsageCount("logger") is 2
	mutable count = 0
	for shape.lines
		if IsUsedIn(value, name)
			count = count + 1
	count
IsUsedIn(line Text, name Text) Boolean
	Sample.IsUsedIn("\tlogger.Log(1)", "logger") is true
	line.IndexOf(" " + name) is not -1 or line.IndexOf("\t" + name) is not -1 or line.IndexOf("(" + name) is not -1
IsExempt Boolean
	Sample.IsExempt is false
	if (shape.MethodScope.names.Length is MemberNames.Length) or (not HasMethodBody)
		return true
	let usesValue = UsageCount("value") > 0 or ("from" is in shape.MethodScope.names)
	(shape.MemberScope.names.Length is 1) and usesValue
HasMethodBody Boolean
	Sample.HasMethodBody is true
	for shape.lines
		if value.StartsWith("\t")
			return true
	false
ConstantIssues ValidationIssues
	TypeValidator(TypeShape("has number = 17 + 4", "Run", "\tnumber"), ("Add", "Remove")).ConstantIssues.Length is 1
	mutable issues = List(Mutable(ValidationIssue))
	for shape.lines
		if IsComputedMember(value)
			issues.Add(ValidationIssue("UseConstantHere", HeaderTokens(Tokenizer(value).Tokens).MemberName, "Use constant"))
	issues
IsComputedMember(line Text) Boolean
	Sample.IsComputedMember("has number = 17 + 4") is true
	Sample.IsComputedMember("has scale = 1") is false
	let tokens = Tokenizer(line).Tokens
	let equals = tokens.Index("=")
	if (not shape.IsMemberLine(line)) or line.StartsWith("constant ") or (equals is -1)
		return false
	let initial = SyntaxParser(tokens).ParseRange(equals + 1, tokens.Length)
	(initial.Kind is "Binary") and IsConstantNode(initial)
IsConstantNode(node SyntaxNode) Boolean
	Sample.IsConstantNode(SyntaxNode("Number", "1")) is true
	if node.Kind is in ("Number", "Text", "Boolean")
		return true
	(node.Kind is "Binary") and IsConstantNode(node.children(0)) and IsConstantNode(node.children(1))