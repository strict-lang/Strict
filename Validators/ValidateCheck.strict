Run(folder Text, root Text) Number
	mutable issues = 0
	for Parts(folder)
		issues = issues + Checked(value, root)
	issues = issues + ProjectRules(root).Checked(folder)
	logger.Log("Validation issues: " + issues)
	issues + (issues is 0 then Folders.Tested(folder, root) else 0)
Parts(path Text) Texts slow
	ValidateCheck.Parts("Validators/MagicNumbers.strict") is ("Validators/MagicNumbers.strict")
	ValidateCheck.Parts("./Math") is ResolveCheck.Tree("./Math")
	path.EndsWith(".strict") then List(Text) + path else ResolveCheck.Tree(path)
Checked(folder Text, root Text) Number slow
	problems = FileCompiler.Problems(Files(folder))
	files = Parsed(Files(folder), problems)
	mutations = Mutations(files + ResolveCheck.AllFiles(root))
	isBase = folder.Replace("\\", "/").Replace("/.", "") is root
	duplicates = Duplicates.Of(files + Directory.Files(root, "*.strict"))
	reached = files.Length is 0 then files else SourceFiles(root).Of(files.First, files)
	inference = ResolveCheck.Inference(reached)
	sure = SureMethods(inference).Named(reached)
	reaching = InputOutputs(inference).Named(reached)
	Reported(problems - "") + Counts(files, mutations, isBase, duplicates, inference, (sure, reaching)).Sum
Parsed(files Texts, problems Texts) Texts
	ValidateCheck.Parsed(("A.strict", "B.strict"), ("EmptyLineIsNotAllowed", "")) is ("B.strict")
	for files
		if problems(index) is ""
			value
Files(folder Text) Texts slow
	ValidateCheck.Files("Validators/MagicNumbers.strict") is ("Validators/MagicNumbers.strict")
	ValidateCheck.Files("Validators").Length > 1
	folder.EndsWith(".strict") then List(Text) + folder else Directory.Files(folder, "*.strict")
Counts(files Texts, mutations Texts, isBase Boolean, duplicates Duplicates, inference Expressions/TypeInference, known List(Texts)) Numbers slow
	for files
		lines = File(value).ReadLines
		typeName = Path(value).FileName.RemoveExtension.text
		found = CheckFile(value, lines, typeName, mutations, isBase) + duplicates.Issues(value, lines)
		reached = SureChecks(lines, known(0), typeName, inference).Issues + InputOutputs.Issues(value, lines, known(1))
		tested = TestChecks(lines, known(1), typeName).Issues + ComposedMembers(lines, typeName, inference).Issues
		Logged(value, found + reached + tested + TestFiles(value, lines, known(1)).Issues) + Unresolved(value, inference)
Unresolved(path Text, inference Expressions/TypeInference) Number slow
	Reported(ResolveCheck.Unresolved(path, inference))
Reported(issues Texts) Number
	for issues
		logger.Log(value)
	issues.Length
CheckFile(path Text, lines Texts, typeName Text, mutations Texts, isBase Boolean) List(ValidationIssue)
	(CheckFile("A.strict", Assertions.Completing.lines, "A", List(Text), false) to Text).IndexOf(Assertions.Rule) >= 0
	limits = Limits(lines, isBase, Limits.Scale(path), typeName).Issues + SubstringLengths(lines).Issues
	rules = TypeValidator(TypeShape(lines), mutations, typeName).Validate + limits
	named = Names(lines).Issues + Recursions(lines, typeName).Issues + Assertions(lines, typeName).Issues
	names = named + Inlines(lines).Issues
	based = (isBase then List(ValidationIssue) else BaseCalls(lines).Issues) + NotFoundResults(lines).Issues
	shaped = names + Writes(lines, typeName).Issues + StatusCodes(lines).Issues + based + SingleLists(lines).Issues
	extra = LoopBodies(lines).Issues + MagicNumbers(lines).Issues + Branches(lines).Issues + ErrorDrops(lines).Issues
	rules + shaped + extra + Brackets(lines).Issues + GeometryTypes(lines, typeName).Issues + ErrorValues(lines).Issues
Logged(path Text, found List(ValidationIssue)) Number
	for found
		logger.Log(ResolveCheck.Located(path, value.Line, value to Text))
	found.Length
Mutations(files Texts) Texts slow
	mutable mutations = List(Mutable(Text))
	for files
		mutations = mutations + FileMutations(TypeShape(File(value).ReadLines), ResolveCheck.TypeName(value))
	mutations
FileMutations(shape Expressions/TypeShape, typeName Text = "") Texts
	FileMutations(TypeShape("Add(element Number) Mutable(List)", "\telement")) is ("Add")
	FileMutations(TypeShape("mutable count Number", "Next Number", "\tcount = count + 1")) is ("Next")
	FileMutations(TypeShape("mutable count Number", "Next Number", "\tcount = count + 1"), "Ticker") is ("Next", "Ticker")
	FileMutations(TypeShape("Add(element Number) Mutable(List)", "\telement"), "Ticker") is ("Add")
	FileMutations(TypeShape("has Mutable(List)", "Run", "\tAdd(element) Mutable(List)")).Length is 0
	mutable mutations = List(Mutable(Text))
	for shape.lines
		if shape.IsMethodHeader(value) and HeaderTokens(Tokenizer(value).Tokens).ReturnsMutable
			mutations.Add(Tokenizer(value).Tokens.First)
	changing = Changes(shape.lines).Methods
	mutations + changing + (changing.Length is 0 or typeName is "" then List(Text) else List(Text) + typeName)