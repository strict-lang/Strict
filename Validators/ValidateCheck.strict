has logger
Run(folder Text, root Text) Number
	mutable issues = 0
	for ResolveCheck.Tree(folder)
		issues = issues + Checked(value, root)
	logger.Log("Validation issues: " + issues)
	issues + (issues is 0 then Folders(logger).Tested(folder, root) else 0)
Checked(folder Text, root Text) Number
	let problems = FileCompiler.Problems(Files(folder))
	let files = Parsed(Files(folder), problems)
	let mutations = Mutations(files + ResolveCheck(logger).AllFiles(root))
	let isBase = folder.Replace("\\", "/").Replace("/.", "") is root
	let duplicates = Duplicates.Of(files + Directory.Files(root, "*.strict"))
	let shared = DroppedResults.Shared(duplicates, mutations)
	let reached = files.Length is 0 then files else SourceFiles(root).Of(files.First, files)
	let inference = ResolveCheck(logger).Inference(reached)
	let sure = SureMethods(inference).Named(reached)
	Reported(problems - "") + Counts(files, mutations, isBase, shared, duplicates, inference, sure).Sum
Parsed(files Texts, problems Texts) Texts
	ValidateCheck(Logger).Parsed(("A.strict", "B.strict"), ("EmptyLineIsNotAllowed", "")) is ("B.strict")
	for files
		if problems(index) is ""
			value
Files(folder Text) Texts
	ValidateCheck(Logger).Files("Validators/MagicNumbers.strict") is ("Validators/MagicNumbers.strict")
	ValidateCheck(Logger).Files("Validators").Length > 1
	folder.EndsWith(".strict") then List(Text) + folder else Directory.Files(folder, "*.strict")
Counts(files Texts, mutations Texts, isBase Boolean, shared Texts, duplicates Duplicates, inference Expressions/TypeInference, sure Texts) Numbers
	for files
		let lines = File(value).ReadLines
		let typeName = Path(value).FileName.RemoveExtension.text
		let found = CheckFile(value, lines, typeName, mutations, isBase, shared) + duplicates.Issues(value, lines)
		Logged(value, found + SureChecks(lines, sure, typeName, inference).Issues) + Unresolved(value, inference)
Unresolved(path Text, inference Expressions/TypeInference) Number
	Reported(ResolveCheck(logger).Unresolved(path, inference))
Reported(issues Texts) Number
	for issues
		logger.Log(value)
	issues.Length
CheckFile(path Text, lines Texts, typeName Text, mutations Texts, isBase Boolean, shared Texts) List(ValidationIssue)
	let limits = Limits(lines, isBase, Limits.Scale(path)).Issues + SubstringLengths(lines).Issues
	let rules = TypeValidator(TypeShape(lines), mutations, typeName).Validate + limits
	let names = Names(lines).Issues + Recursions(lines, typeName).Issues + Inlines(lines).Issues
	let shaped = names + TestChecks(lines).Issues + Writes(lines, typeName).Issues + StatusCodes(lines).Issues
	rules + shaped + (DroppedResults(lines, shared).Issues + LoopBodies(lines).Issues + MagicNumbers(lines).Issues)
Logged(path Text, found List(ValidationIssue)) Number
	for found
		logger.Log(path + ":line " + value.Line + ": " + value)
	found.Length
Mutations(files Texts) Texts
	mutable mutations = List(Mutable(Text))
	for files
		mutations = mutations + FileMutations(TypeShape(File(value).ReadLines), ResolveCheck.TypeName(value))
	mutations
FileMutations(shape Expressions/TypeShape, typeName Text = "") Texts
	FileMutations(TypeShape("Add(element Number) Mutable(List)", "\telement")) is ("Add")
	FileMutations(TypeShape("mutable count Number", "Next Number", "\tcount = count + 1")) is ("Next")
	FileMutations(TypeShape("mutable count Number", "Next Number", "\tcount = count + 1"), "Ticker") is ("Next", "Ticker")
	FileMutations(TypeShape("Add(element Number) Mutable(List)", "\telement"), "Ticker") is ("Add")
	FileMutations(TypeShape("has Mutable(List)", "Run", "\tAdd(element) Mutable(List)")).Length is 0
	mutable mutations = List(Mutable(Text))
	for shape.lines
		if shape.IsMethodHeader(value) and HeaderTokens(Tokenizer(value).Tokens).ReturnsMutable
			mutations.Add(Tokenizer(value).Tokens.First)
	let changing = Changes(shape.lines).Methods
	mutations + changing + ((changing.Length is 0) or (typeName is "") then List(Text) else List(Text) + typeName)