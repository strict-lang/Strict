constant Bogus = ("Doubled(number Number) Number", "	Doubled(3) is 6", "	Doubled(0) is 0", "	number + number")
constant Suggest = ("has number", "Doubled Number", "	Suggesting(3).Doubled is 6", "	Suggesting(0).Doubled is 0")
constant Temp = ("has celsius Number", "Clamped(minimum Number, maximum Number) Number", "	Temperature(30).Clamped(0, 20) is 20", "	Temperature(10).Clamped(0, 20) is 10")
constant Extra = ("Doubled Number", "	Temperature(2).Doubled is 5", "	celsius * 2", "Other Number", "	Temperature(2).Other is 2")
constant Wrapper = ("has dispatcher Dispatcher", "Clamped Number", "	Wrapper(Dispatcher(1)).Clamped is 1")
constant Dispatcher = ("has number", "Clamped Number", "	Wrapper(Dispatcher(number)).Clamped")
constant Dual = ("has number", "Pick(other Number) Number", "	Dual(2).Pick(3) is 5", "	number + other", "Pick Number", "	Dual(3).Pick is 6", "	Dual(0).Pick is 0")
constant Built = ("has number", "from(first Number, second Number)", "	Built(2, 3) is 5", "	Built(1, 6) is 7")
constant AppendingLines = ("has text", "from(first Text, second Text)", "	Appending(\"a\", \"b\") is \"ab\"", "	Appending(\"x\", \"yz\") is \"xyz\"")
constant EvenLines = ("has boolean", "from(input Number)", "	Even(2)", "	Even(3) is false", "	Even(10)")
constant MeasuredLines = ("has number", "from(input Text)", "	Measured(\"abc\") is 3", "	Measured(\"\") is 0")
constant LargerLines = ("has number", "from(first Number, second Number)", "	Larger(2, 5) is 5", "	Larger(7, 3) is 7")
constant Prefix = "Suggestion: "
constant ToolSeconds = 30
Run(arguments Texts) Number
	root = arguments.Length > 0 then arguments.First else "."
	folder = "Examples/SuggestCheck" + 1000000.Random.Floor
	result = Verify(folder, root)
	Directory.Delete(folder)
	result is Error then result else 0
Verify(folder Text, root Text) slow
	if Directory.Create(folder) is Error
		return Error("DirectoryNotCreated")
	File(folder + "/Bogus.strict").Write(Bogus)
	first = CheckedCase(folder, root, "Suggesting", "Doubled", Suggest, "number + number")
	if first is Error
		return first
	second = CheckedCase(folder, root, "Temperature", "Clamped", Temp, "celsius.Clamp(minimum, maximum)")
	if second is Error
		return second
	CheckedMore(folder, root)
CheckedMore(folder Text, root Text) slow
	failing = File(folder + "/Temperature.strict").ReadLines + Extra
	third = RanSuggest(folder, root, "Temperature.strict Clamped -", failing)
	if third is Error or "Suggestion: celsius.Clamp(minimum, maximum)" is not in third or IsOnlyPrefix(third) is false
		return Error("UnsavedOrFailingMethodsBroken: " + (third to Text))
	if File(folder + "/Temperature.strict").ReadLines is not Temp
		return Error("TemperatureFileModified")
	logger.Log("Unrelated failing/pending methods and unsaved source: passed")
	CheckedEdges(folder, root)
CheckedEdges(folder Text, root Text) slow
	File(folder + "/Wrapper.strict").Write(Wrapper)
	File(folder + "/Dispatcher.strict").Write(Dispatcher)
	looped = RanSuggest(folder, root, "Wrapper.strict Clamped", List(Text))
	if looped is Error or looped.Trim is not "" or HasBinary(folder)
		return Error("RecursiveDispatcherFailed: " + (looped to Text))
	logger.Log("Recursive dispatcher: no passing suggestions")
	File(folder + "/Dual.strict").Write(Dual)
	dual = RanSuggest(folder, root, "Dual.strict 5", List(Text))
	if dual is Error or "Suggestion: number + number" is not in dual
		return Error("OverloadSelectionFailed: " + (dual to Text))
	logger.Log("Overloaded method selected by header line: passed")
	CheckedMissing(folder, root)
CheckedMissing(folder Text, root Text) slow
	empty = RanSuggest(folder, root, "Suggesting.strict Doubled -", ("has number", "Doubled Number"))
	if empty is Error or empty.Trim is not ""
		return Error("NoTestsCaseFailed: " + (empty to Text))
	missing = RanResult(folder, root, "Suggesting.strict Missing", List(Text))
	if missing.exitCode is not 2 or "MethodNotFound" is not in missing.Output
		return Error("UnknownMethodCaseFailed: " + (missing.exitCode to Text) + " " + missing.Output)
	logger.Log("No tests and unknown method: passed")
	built = CheckedCase(folder, root, "Built", "from", Built, "number = first + second")
	if built is Error
		return built
	logger.Log("from of one member: passed")
	CheckedCalls(folder, root)
CheckedCalls(folder Text, root Text) slow
	appended = CheckedCase(folder, root, "Appending", "from", AppendingLines, "text = first + second")
	if appended is Error
		return appended
	even = CheckedCase(folder, root, "Even", "from", EvenLines, "boolean = input % 2 is 0")
	if even is Error
		return even
	measured = CheckedCase(folder, root, "Measured", "from", MeasuredLines, "number = input.Length")
	if measured is Error
		return measured
	larger = CheckedCase(folder, root, "Larger", "from", LargerLines, "number = first.Maximum(second)")
	if larger is Error
		return larger
	logger.Log("One-call from bodies: passed")
CheckedCase(folder Text, root Text, name Text, method Text, lines Texts, expected Text) slow
	path = folder + "/" + name + ".strict"
	File(path).Write(lines)
	started = Process.Elapsed
	output = RanSuggest(folder, root, name + ".strict " + method + " -", lines)
	if output is Error
		return output
	bodies = Bodies(output)
	bad = expected is not in bodies or HasBlocked(bodies) or IsOnlyPrefix(output) is false
	if bad or File(path).ReadLines is not lines or HasBinary(folder)
		return Error("CaseFailed " + name + "." + method + ": " + output)
	elapsed = ((Process.Elapsed - started) * 1000).Round
	logger.Log(name + "." + method + ": " + (bodies to Text) + " (" + elapsed + " ms)")
Bodies(output Text) Texts
	Bodies("Suggestion: a\nSuggestion: b") is ("a", "b")
	Bodies("x\nSuggestion: a") is ("a")
	for output.Lines
		if value.StartsWith(Prefix)
			value.Substring(Prefix.Length, value.Length - Prefix.Length)
HasBlocked(bodies Texts) Boolean
	HasBlocked(List(Text) + "number")
	HasBlocked(List(Text) + "Bogus.Pi")
	HasBlocked(List(Text) + "number + number") is false
	HasBlocked(List(Text) + "Number.Epsilon") and HasBlocked(List(Text) + "Number.Pi")
	HasBlocked(List(Text) + "Bogus.Zero")
	for bodies
		bad = ".Epsilon" is in value or ".Pi" is in value
		if value is in ("number", "celsius", "minimum", "maximum") or "Bogus." is in value or bad
			return true
	false
IsOnlyPrefix(output Text) Boolean
	IsOnlyPrefix("Suggestion: a\nSuggestion: b")
	IsOnlyPrefix("bad") is false
	IsOnlyPrefix("Suggestion: a\n\nSuggestion: b")
	for output.Lines
		if value is not "" and value.StartsWith("Suggestion: ") is false
			return false
	true
HasBinary(folder Text) Boolean slow
	Directory.Exists(folder + "/obj") and Directory.Files(folder + "/obj", "*.strictbinary").Length > 0
RanSuggest(folder Text, root Text, tail Text, input Texts) Text slow
	result = RanResult(folder, root, tail, input)
	result.exitCode is 0 then result.Output else Error(result.Output + result.error)
Command(root Text, tail Text) Text
	head = tail.Split(" ").First
	"\"" + Process.Current.executable + "\" suggest " + tail.Replace(head, head + " \"" + TypeSource.Absolute(root) + "\"")
RanResult(folder Text, root Text, tail Text, input Texts) ProcessResult slow
	home = Directory.Current
	command = Command(root, tail)
	if input.Length > 0
		File(folder + "/stdin.txt").Write(Text.Combine(input, "\n").Lines)
	Directory.Change(folder)
	isWindows = Process.OperatingSystem is "Windows"
	redirected = input.Length > 0 then command + " < stdin.txt" else command
	flag = isWindows then "/c \"" else "-c \""
	result = Process.RunTool(isWindows then "cmd" else "sh", flag + redirected + "\"", ToolSeconds)
	Directory.Change(home)
	result
